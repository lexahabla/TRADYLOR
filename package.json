{
  "name": "tradylor-web",
  "type": "module",
  "version": "1.0.0",
  "description": "Tradylor - Portal de recomendación, curación y comparativas de productos de alta conversión",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:inline && astro build",
    "check:inline": "node scripts/check-inline-scripts.mjs",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@google/genai": "^2.31.0",
    "astro": "^7.4.2",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/nodemailer": "^8.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true,
    "sharp@0.33.5": true,
    "@google/genai@2.31.0": true
  }
}
