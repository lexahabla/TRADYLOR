    "express": "^5.3.0",
    "nodemailer": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/tailwind": "^5.1.5",
    "@types/nodemailer": "^8.0.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
