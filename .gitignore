# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# copias locales / paquetes de despliegue
*.zip

# environment variables
.env
.env.production

# credenciales de redes de afiliación (panel admin)
src/data/credentials.json

# usuarios y avatares del backend (se generan en el volumen, nunca en el repo)
src/data/users.json
src/data/avatars/

# usuarios finales y datos de Mi Radar (se generan en el volumen, nunca en el repo)
src/data/radar-users.json
src/data/radar-data.json
src/data/radar-avatars/

# afiliados creados/eliminados desde el panel (se generan en local/volumen)
src/data/networks.json

# volumen de datos de producción (montado en /app/data dentro del contenedor).
# NUNCA debe subirse al repo desde el contenedor: contiene products.json,
# credentials.json (secretos) y las imágenes del volumen.
/data/

# credenciales que puedan existir en el volumen montado
/data/credentials.json

# semilla incluida en la imagen (artefacto del build, no del repo)
/seed/

# imágenes de producto generadas con IA
public/images/products/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# analitica real (eventos en bruto y agregados mensuales: viven en el volumen)
src/data/analytics.json
src/data/analytics-months.json
