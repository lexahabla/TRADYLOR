        "type": "object",
        "additionalProperties": false,
        "required": [
          "clave",
          "area",
          "codigo",
          "gravedadAnterior",
          "desde",
          "resueltaEn",
          "diasAbierta",
          "reapariciones"
        ],
        "properties": {
          "clave": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "codigo": {
            "type": "string"
          },
          "gravedadAnterior": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja",
              "info"
            ]
          },
          "desde": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "resueltaEn": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "diasAbierta": {
            "type": "integer",
            "minimum": 0
          },
          "reapariciones": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "noVerificadas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clave",
          "area",
          "codigo",
          "gravedadAnterior",
          "desde",
          "motivo",
          "sinVerificar"
        ],
        "properties": {
          "clave": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "codigo": {
            "type": "string"
          },
          "gravedadAnterior": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja",
              "info"
            ]
          },
          "desde": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          },
          "sinVerificar": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "reaparecidas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clave",
          "area",
          "codigo",
          "gravedad",
          "cantidad",
          "resueltaEn",
          "reapariciones"
        ],
        "properties": {
          "clave": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "codigo": {
            "type": "string"
          },
          "gravedad": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja",
              "info"
            ]
          },
          "cantidad": {
            "type": [
              "number",
              "null"
            ]
          },
          "resueltaEn": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "reapariciones": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "caducadas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clave",
          "area",
          "codigo",
          "gravedadAnterior",
          "desde",
          "motivo",
          "sinVerificar"
        ],
        "properties": {
          "clave": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "codigo": {
            "type": "string"
          },
          "gravedadAnterior": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja",
              "info"
            ]
          },
          "desde": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          },
          "sinVerificar": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "indeterminadas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clave",
          "area",
          "codigo",
          "gravedad",
          "cantidad",
          "motivo"
        ],
        "properties": {
          "clave": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "codigo": {
            "type": "string"
          },
          "gravedad": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja",
              "info"
            ]
          },
          "cantidad": {
            "type": [
              "number",
              "null"
            ]
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          }
        }
      }
