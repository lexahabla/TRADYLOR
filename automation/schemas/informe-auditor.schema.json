{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Informe del Auditor General (Treidilor AI)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agente",
    "version",
    "entorno",
    "modo",
    "generadoEn",
    "soloLectura",
    "resumen",
    "incidencias",
    "cobertura",
    "markdown",
    "avisosEntorno"
  ],
  "properties": {
    "agente": {
      "enum": [
        "auditor-general"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "entorno": {
      "type": "string",
      "minLength": 1
    },
    "modo": {
      "enum": [
        "completo",
        "publico"
      ]
    },
    "generadoEn": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "soloLectura": {
      "enum": [
        true
      ]
    },
    "resumen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estado",
        "incidencias",
        "peticiones",
        "rutasRevisadas",
        "enlacesRevisados",
        "fichasRevisadas",
        "paginasCatalogo",
        "avisosEntorno"
      ],
      "properties": {
        "estado": {
          "enum": [
            "ok",
            "atencion",
            "critico"
          ]
        },
        "incidencias": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critica",
            "alta",
            "media",
            "baja",
            "info"
          ],
          "properties": {
            "critica": {
              "type": "integer",
              "minimum": 0
            },
            "alta": {
              "type": "integer",
              "minimum": 0
            },
            "media": {
              "type": "integer",
              "minimum": 0
            },
            "baja": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "peticiones": {
          "type": "integer",
          "minimum": 0
        },
        "rutasRevisadas": {
          "type": "integer",
          "minimum": 0
        },
        "enlacesRevisados": {
          "type": "integer",
          "minimum": 0
        },
        "fichasRevisadas": {
          "type": "integer",
          "minimum": 0
        },
        "paginasCatalogo": {
          "type": "integer",
          "minimum": 0
        },
        "avisosEntorno": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "incidencias": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "gravedad",
          "area",
          "titulo",
          "detalle",
          "evidencia",
          "accionSugerida",
          "clase",
          "ambito"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "gravedad": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja",
              "info"
            ]
          },
          "area": {
            "enum": [
              "salud",
              "ruta",
              "enlace",
              "ficha",
              "catalogo"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "detalle": {
            "type": "string"
          },
          "evidencia": {
            "type": "object"
          },
          "accionSugerida": {
            "type": "string"
          },
          "clase": {
            "enum": [
              "disponibilidad",
              "integridad_datos",
              "calidad_datos",
              "honestidad_comercial",
              "seguridad",
              "configuracion",
              "operacion",
              "cobertura",
              "seo_contenido",
              "enlaces"
            ]
          },
          "ambito": {
            "enum": [
              "produccion",
              "datos",
              "entorno_local"
            ]
          }
        }
      }
    },
    "cobertura": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisado",
        "noRevisado"
      ],
      "properties": {
        "revisado": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noRevisado": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    },
    "avisosEntorno": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "gravedad",
          "area",
          "titulo",
          "detalle",
          "evidencia",
          "accionSugerida",
          "clase",
          "ambito"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "gravedad": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja",
              "info"
            ]
          },
          "area": {
            "enum": [
              "salud",
              "ruta",
              "enlace",
              "ficha",
              "catalogo"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "detalle": {
            "type": "string"
          },
          "evidencia": {
            "type": "object"
          },
          "accionSugerida": {
            "type": "string"
          },
          "clase": {
            "enum": [
              "disponibilidad",
              "integridad_datos",
              "calidad_datos",
              "honestidad_comercial",
              "seguridad",
              "configuracion",
              "operacion",
              "cobertura",
              "seo_contenido",
              "enlaces"
            ]
          },
          "ambito": {
            "enum": [
              "produccion",
              "datos",
              "entorno_local"
            ]
          }
        }
      }
    },
    "consumo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peticiones",
        "medido",
        "estimado",
        "presupuesto",
        "escenarios"
      ],
      "properties": {
        "peticiones": {
          "type": "integer",
          "minimum": 0
        },
        "medido": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytesRecibidos",
            "porTipo",
            "paginasMasPesadas",
            "nota"
          ],
          "properties": {
            "bytesRecibidos": {
              "type": "integer",
              "minimum": 0
            },
            "porTipo": {
              "type": "object"
            },
            "paginasMasPesadas": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tipo",
                  "destino",
                  "bytes",
                  "estado"
                ],
                "properties": {
                  "tipo": {
                    "type": "string"
                  },
                  "destino": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "estado": {}
                }
              }
            },
            "nota": {
              "type": "string"
            }
          }
        },
        "estimado": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "esEstimacion",
            "bytesHistorial",
            "metodo"
          ],
          "properties": {
            "esEstimacion": {
              "enum": [
                true
              ]
            },
            "bytesHistorial": {
              "type": "integer",
              "minimum": 0
            },
            "metodo": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "presupuesto": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxEnlaces",
            "enlacesDescubiertos",
            "enlacesPedidos",
            "enlacesOmitidosPorTope"
          ],
          "properties": {
            "maxEnlaces": {
              "type": "integer",
              "minimum": 0
            },
            "enlacesDescubiertos": {
              "type": "integer",
              "minimum": 0
            },
            "enlacesPedidos": {
              "type": "integer",
              "minimum": 0
            },
            "enlacesOmitidosPorTope": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "escenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maxEnlaces",
              "calculable",
              "enlaces"
            ],
            "properties": {
              "maxEnlaces": {
                "type": "integer",
                "minimum": 0
              },
              "calculable": {
                "enum": [
                  true,
                  false
                ]
              },
              "enlaces": {
                "type": "integer",
                "minimum": 0
              },
              "peticiones": {
                "type": "integer",
                "minimum": 0
              },
              "bytesRecibidos": {
                "type": "integer",
                "minimum": 0
              },
              "bytesHistorialEstimado": {
                "type": "integer",
                "minimum": 0
              },
              "familiasCubiertas": {
                "type": "integer",
                "minimum": 0
              },
              "familiasDescubiertas": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
