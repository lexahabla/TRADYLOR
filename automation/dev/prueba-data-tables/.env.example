# Plantilla del entorno de la PRUEBA AISLADA de Data Tables. NO rellenar aquí: copia este fichero FUERA del repositorio
# (p. ej. D:\treidilor-pruebas\prueba-dt\.env.prueba-dt) y rellénalo allí. Todo es SOLO de pruebas: nada de producción, nada real.
PRUEBA_DT_N8N_VERSION=2.38.6
# Contraseña de la base de datos de PRUEBAS (aleatoria, p. ej. 32 caracteres alfanuméricos). No reutilizar ninguna contraseña real.
PRUEBA_DT_PG_PASSWORD=
# Clave de cifrado de PRUEBAS (aleatoria, p. ej. 32 caracteres alfanuméricos). DISTINTA de la de producción y de la del n8n de pruebas de los agentes.
PRUEBA_DT_ENCRYPTION_KEY=
