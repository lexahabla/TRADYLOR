# Credenciales de administración
ADMIN_USERNAME=lexahabla
ADMIN_PASSWORD=cambia-esta-contraseña
# Token de la API pública v1 (n8n / automatizaciones)
# Header: Authorization: Bearer <token>
TRADYLOR_API_TOKEN=
# Webhook opcional de n8n: telemetría de clics de salida (/api/redirect)
# Recibe POST JSON con el contrato del producto + event=delegated_checkout_exit
# (opcional: el alta de productos ya no depende de n8n)
N8N_CLICK_WEBHOOK_URL=

# --- Mi Radar (panel de usuario final) ---
# Google OAuth (opcional): si no se configura, el botón aparece como "próximamente".
# En Google Cloud Console, autoriza el redirect: https://tradylor.com/api/radar/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Webhook de n8n para enviar el email de recuperación de contraseña
# (recibe POST JSON: { to, name, resetUrl, product })
N8N_RESET_WEBHOOK_URL=
# Webhook de n8n para enviar el email de bienvenida con el botón de activación
# (recibe POST JSON: { to, name, verifyUrl, product })
N8N_VERIFY_WEBHOOK_URL=
# Webhook de n8n para los avisos diferidos de Mi Radar (fallback si no hay SMTP)
# (recibe POST JSON: { to, name, subject, html, product })
N8N_REMINDER_WEBHOOK_URL=

# --- SMTP directo para emails (bienvenida/activación, reset) ---
# Si se configura, los emails salen por SMTP sin depender de n8n.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tradylor <no-reply@tradylor.com>

# --- IA para el alta automática de productos (/api/admin/add-product) ---
# Paso 1: texto (ficha técnica, pros/contras, veredicto)
TEXT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Groq: nivel gratuito (sólo email, sin créditos). Compatible con la API de OpenAI.
# Pon TEXT_AI_PROVIDER=groq y GROQ_API_KEY para usarlo como texto por defecto.
# Modelo por defecto openai/gpt-oss-120b (disponible en el plan free; llama-3.3-70b es Enterprise).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
IMAGE_AI_PROVIDER=openai
FLUX_API_KEY=
FLUX_ENDPOINT=https://api.bfl.ml/v1/flux-pro-1.1
# Amazon Associates / Product Advertising API
AMAZON_ASSOCIATE_TAG=
AMAZON_PA_API_KEY=
AMAZON_PA_SECRET=

# AliExpress Portals
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# eBay Partner Network
EBAY_CAMPAIGN_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Awin
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=

# CJ Affiliate
CJ_WEBSITE_ID=
CJ_API_TOKEN=

# Admitad
ADMITAD_WEBSITE_ID=
ADMITAD_API_TOKEN=

# Tradedoubler / Metapic
TRADEDOUBLER_PARTNER_ID=
TRADEDOUBLER_API_TOKEN=

# Kwanko / NetAffiliation
KWANKO_PUBLISHER_ID=
KWANKO_API_TOKEN=

# Etsy Affiliate Program
ETSY_API_KEY=
ETSY_AFFILIATE_ID=

# --- Marketing y analítica ---
# IPs de trabajo cuyas visitas NO se contabilizan (separadas por coma).
ANALYTICS_IGNORE_IPS=26.95.41.235
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MARKETING_WEBHOOK_URL=

# --- Desarrollo remoto en el contenedor (Terminal de Easy Panel + opencode) ---
# Push a GitHub desde dentro del contenedor (PAT: GitHub > Settings > Developer
# settings > Personal access tokens, scope repo). Opcional pero recomendado:
# sin él, los cambios hechos dentro NO salen del contenedor.
GITHUB_PAT=
# Identidad de commit (opcional)
GIT_USER_NAME=
GIT_USER_EMAIL=
