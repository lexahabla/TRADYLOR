    <script>
        // =====================================================================
        // TRADYLOR — RADAR BOOTSTRAP (global, páginas públicas)
        // =====================================================================
        // 1) Sincroniza estado de sesión + nube al cargar.
        // 2) Delegación de clics: [data-radar-toggle] alterna guardado.
        // 3) Marca visual (.is-saved) según LocalStorage.
        // 4) Registra salidas .exit-cta en el Return Flow.
        // 5) Cabecera: auth vs usuario logueado, drawer Mi Radar, menú, avatar.
        // =====================================================================
        import { getSession, getCachedSession, initAuth, logout, onAuthChange } from '../utils/auth';
        import {
          getRadarProducts,
          isSaved,
          onRadarChange,
          removeProduct,
          saveToRadar,
          trackExitClick,
        } from '../utils/radarStore';
        import type { SavedProduct, UserProfile } from '../types/radar';
        import { openSharePanel } from '../utils/shareUi';

        // ---------------------------------------------------------- helpers UI
        const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel);
        // true cuando initAuth() ya resolvió (evita falsos positivos del gate
        // de sesión mientras la petición de /session está en vuelo).
        let authReady = false;

        // ------------------- perfil de marketing (sync throttled ~1/día) ----
        // Envía al servidor las búsquedas y el quiz guardados en LocalStorage
        // para nutrir user_profiles.json / marketing_leads.json.
        const PROFILE_SYNC_KEY = 'tradylor-profile-sync-at';
        const PROFILE_SYNC_MIN_GAP_MS = 24 * 60 * 60 * 1000;

        async function syncMarketingProfile(force = false): Promise<void> {
          try {
            if (!force) {
              const last = Number(localStorage.getItem(PROFILE_SYNC_KEY) ?? 0);
              if (Number.isFinite(last) && Date.now() - last < PROFILE_SYNC_MIN_GAP_MS) return;
            }
            const rawTerms = localStorage.getItem('tradylor-search-terms');
            const rawQuiz = localStorage.getItem('tradylor-quiz-answers');
            const lastSearchTerms: string[] = rawTerms ? JSON.parse(rawTerms) : [];
            const quiz = rawQuiz ? JSON.parse(rawQuiz) : null;
            const payload: Record<string, unknown> = {
              lastSearchTerms: Array.isArray(lastSearchTerms) ? lastSearchTerms : [],
            };
            if (quiz && typeof quiz === 'object') {
              const { perfil, objetivo, presupuesto } = quiz as Record<string, unknown>;
              if (perfil || objetivo || presupuesto) {
                payload.quizAnswers = { perfil, objetivo, presupuesto };
              }
              if (typeof quiz.buyerProfile === 'string') payload.buyerProfile = quiz.buyerProfile;
              if (typeof presupuesto === 'string') payload.budgetRange = presupuesto;
            }
            const res = await fetch('/api/user-profile/sync', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify(payload),
            });
            if (res.ok) localStorage.setItem(PROFILE_SYNC_KEY, String(Date.now()));
          } catch { /* el sync de marketing nunca interrumpe la navegación. */ }
        }

        // ------------------------------------------------- cabecera: auth vs user
        const headerAnon = $('[data-header-anon]');
        const headerUserArea = $('[data-header-user]');
        const headerRadarBtn = $('[data-header-radar-btn]');
        const headerUsername = $('[data-header-username]');
        const headerEmail = $('[data-header-email]');
        const headerAvatarWrap = $('[data-header-avatar]');
        const headerAvatarMenu = $('[data-header-avatar-menu]');

        function renderHeaderAuth(user: UserProfile | null) {
          if (!headerAnon || !headerUserArea) return;
          if (user) {
            headerAnon.hidden = true;
            headerUserArea.hidden = false;
            if (headerRadarBtn) headerRadarBtn.hidden = false;
            const displayName = user.name || user.email.split('@')[0];
            if (headerUsername) headerUsername.textContent = displayName;
            if (headerEmail) headerEmail.textContent = user.email;
            const v = user.updatedAt ? `?v=${encodeURIComponent(user.updatedAt)}` : '';
            for (const wrap of [headerAvatarWrap, headerAvatarMenu]) {
              if (!wrap) continue;
              if (user.avatar) {
                wrap.innerHTML = `<img src="/api/radar/auth/avatar${v}" alt="" />`;
              } else {
                wrap.textContent = displayName.charAt(0).toUpperCase();
              }
            }
          } else {
            headerAnon.hidden = false;
            headerUserArea.hidden = true;
            // Botón radar del header (svg.radar-anim): sólo se muestra con
            // sesión iniciada; sin usuario registrado queda oculto.
            if (headerRadarBtn) headerRadarBtn.hidden = true;
            closeUserMenu();
            closeRadarDrawer();
          }
          if (radarDrawerLinkText) {
            radarDrawerLinkText.textContent = user
              ? 'Ver panel completo'
              : 'Guardar en la nube (Iniciar sesión)';
          }
        }

        // ------------------------------------------------------ drawer Carrito / Radar
        const radarDrawer = document.getElementById('radarDrawer');
        const radarDrawerItems = $('[data-radar-drawer-items]');
        const radarDrawerEmpty = $('[data-radar-drawer-empty]');
        const radarDrawerFooter = $('[data-radar-drawer-footer]');
        const radarDrawerTotal = $('[data-radar-drawer-total]');
        const radarDrawerHeaderCount = $('[data-radar-drawer-header-count]');
        const radarDrawerLinkText = $('[data-radar-drawer-link-text]');
        const radarDrawerToggle = $('[data-radar-drawer-toggle]');
        const radarDrawerClear = $('[data-radar-drawer-clear]');
        const radarDrawerFullLink = $('[data-radar-drawer-full-link]');

        function openRadarDrawer() {
          if (!radarDrawer) return;
          renderRadarDrawer();
          radarDrawer.classList.add('is-open');
          radarDrawer.setAttribute('aria-hidden', 'false');
          radarDrawerToggle?.setAttribute('aria-expanded', 'true');
          document.body.classList.add('radar-drawer-is-open');
        }

        function closeRadarDrawer() {
          if (!radarDrawer) return;
          radarDrawer.classList.remove('is-open');
          radarDrawer.setAttribute('aria-hidden', 'true');
          radarDrawerToggle?.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('radar-drawer-is-open');
        }

        function formatPrice(p: SavedProduct): string {
          if (p.price) return p.price;
          if (typeof p.priceValue === 'number' && !isNaN(p.priceValue)) return `${p.priceValue.toFixed(2)} €`;
          return 'Consultar';
        }

        function renderRadarDrawer() {
          if (!radarDrawerItems || !radarDrawerEmpty) return;
          const products = getRadarProducts();
          const hasProducts = products.length > 0;
          radarDrawerEmpty.hidden = hasProducts;
          if (radarDrawerFooter) radarDrawerFooter.hidden = !hasProducts;
          if (radarDrawerHeaderCount) radarDrawerHeaderCount.textContent = String(products.length);

          const session = getCachedSession();
          if (radarDrawerLinkText) {
            radarDrawerLinkText.textContent = session?.user
              ? 'Ver panel completo'
              : 'Guardar en la nube (Iniciar sesión)';
          }

          if (!hasProducts) {
            radarDrawerItems.innerHTML = '';
            return;
          }

          let totalNumeric = 0;
          let hasValidPrice = false;
          products.forEach((p) => {
            if (typeof p.priceValue === 'number' && !isNaN(p.priceValue)) {
              totalNumeric += p.priceValue;
              hasValidPrice = true;
            } else if (p.price) {
              const cleaned = p.price.replace(',', '.').replace(/[^\d.]/g, '');
              const val = parseFloat(cleaned);
              if (!isNaN(val)) {
                totalNumeric += val;
                hasValidPrice = true;
              }
            }
          });

          if (radarDrawerTotal) {
            radarDrawerTotal.textContent = hasValidPrice ? `${totalNumeric.toFixed(2)} €` : '—';
          }

          radarDrawerItems.innerHTML = products.map((p) => {
            const storeName = p.store ? (p.store === 'aliexpress' ? 'AliExpress' : p.store.charAt(0).toUpperCase() + p.store.slice(1)) : 'Tienda';
            const safeTitle = (p.title || 'Producto').replace(/"/g, '&quot;');
            const priceDisplay = formatPrice(p);
            const checkoutUrl = `/checkout/${encodeURIComponent(p.id)}`;
            const productUrl = `/producto/${encodeURIComponent(p.id)}`;

            return `
              <article class="radar-drawer-item">
                <a href="${productUrl}" class="radar-drawer-thumb" title="${safeTitle}">
                  ${p.image ? `<img src="${p.image}" alt="${safeTitle}" loading="lazy" />` : `
                    <div class="radar-drawer-no-img">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                  `}
                </a>
                <div class="radar-drawer-item-info">
                  <div class="radar-drawer-item-top">
                    <span class="radar-drawer-store-tag">${storeName}</span>
                    <button type="button" class="radar-drawer-item-remove" data-drawer-remove="${p.id}" aria-label="Eliminar producto" title="Quitar de mi carrito">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </div>
                  <a href="${productUrl}" class="radar-drawer-item-title" title="${safeTitle}">${safeTitle}</a>
                  <div class="radar-drawer-item-bottom">
                    <span class="radar-drawer-item-price">${priceDisplay}</span>
                    <span class="radar-drawer-item-actions">
                      <button type="button" class="radar-drawer-item-share" data-drawer-share="${p.id}" data-share-title="${safeTitle}" aria-label="Compartir producto" title="Compartir producto">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"></line><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"></line></svg>
                      </button>
                      <a href="${checkoutUrl}" class="radar-drawer-item-buy exit-cta" data-asin="${p.id}" data-title="${safeTitle}">
                        <span>Comprar</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                      </a>
                    </span>
                  </div>
                </div>
              </article>
            `;
          }).join('');
        }

        // Toggle drawer
        radarDrawerToggle?.addEventListener('click', (e) => {
          e.preventDefault();
          if (radarDrawer?.classList.contains('is-open')) {
            closeRadarDrawer();
          } else {
            openRadarDrawer();
          }
        });

        // Cerrar al pulsar backdrop o botón de cerrar
        document.addEventListener('click', (event) => {
          const t = event.target;
          if (!(t instanceof Element)) return;
          if (t.closest('[data-radar-drawer-close]')) {
            closeRadarDrawer();
          }
          const rm = t.closest<HTMLElement>('[data-drawer-remove]');
          if (rm?.dataset.drawerRemove) {
            removeProduct(rm.dataset.drawerRemove);
            syncButtons();
            renderRadarDrawer();
          }
          const sh = t.closest<HTMLElement>('[data-drawer-share]');
          if (sh?.dataset.drawerShare) {
            const product = getRadarProducts().find((p) => p.id === sh.dataset.drawerShare);
            openSharePanel({
              productId: sh.dataset.drawerShare,
              title: sh.dataset.shareTitle || product?.title || 'Este producto',
            });
          }
        });

        // Cerrar con Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && radarDrawer?.classList.contains('is-open')) {
            closeRadarDrawer();
          }
        });

        // Vaciar radar
        radarDrawerClear?.addEventListener('click', () => {
          const products = getRadarProducts();
          if (products.length === 0) return;
          if (confirm('¿Vaciar todos los productos del radar?')) {
            products.forEach((p) => removeProduct(p.id));
            syncButtons();
            renderRadarDrawer();
          }
        });

        // Enlace del pie del drawer: si no hay sesión, abre modal de login (contexto radar)
        radarDrawerFullLink?.addEventListener('click', (e) => {
          const session = getCachedSession();
          if (!session?.user) {
            e.preventDefault();
            closeRadarDrawer();
            const w = window as unknown as Record<string, { open?: (view?: string, context?: string) => void } | undefined>;
            w.TradylorAuth?.open?.('login', 'radar-add');
          }
        });

        // Contador del header
        const syncHeaderCount = () => {
          const el = document.getElementById('radarHeaderCount');
          if (!el) return;
          const count = getRadarProducts().length;
          el.textContent = String(count);
          el.hidden = count === 0;
        };

        // ---------------------------------------------------- menú de usuario
        const userMenuToggle = $('[data-user-menu-toggle]');
        const userMenu = $('[data-user-menu]');
        const userMenuWrap = $('[data-header-user-menu-wrap]');

        function setUserMenuOpen(open: boolean) {
          if (!userMenu || !userMenuToggle) return;
          userMenu.hidden = !open;
          userMenuToggle.setAttribute('aria-expanded', String(open));
          // Anillo activo en el avatar mientras el menú está desplegado.
          userMenuWrap?.classList.toggle('is-open', open);
        }

        function toggleUserMenu() {
          setUserMenuOpen(Boolean(userMenu?.hidden));
        }

        function closeUserMenu() {
          setUserMenuOpen(false);
        }

        userMenuToggle?.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleUserMenu();
        });
        userMenuToggle?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleUserMenu();
          }
        });
        document.addEventListener('click', (event) => {
          const t = event.target;
          if (!(t instanceof Element)) return;
          if (userMenu && !userMenu.hidden && !t.closest('[data-header-user-menu-wrap]')) {
            closeUserMenu();
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && userMenu && !userMenu.hidden) {
            closeUserMenu();
            userMenuToggle?.focus();
          }
        });

        // --------------------------------------------------------- logout
        $('[data-user-logout]')?.addEventListener('click', async () => {
          await logout();
          window.location.href = '/';
        });

        // ------------------------------------------------------- botones radar
        const syncButtons = () => {
          // Sin usuario registrado no hay radar: los botones nunca se marcan
          // como guardados (los productos anónimos de LocalStorage sólo se
          // muestran/migran tras iniciar sesión).
          const canUseRadar = !authReady || Boolean(getCachedSession()?.user);
          document.querySelectorAll<HTMLElement>('[data-radar-toggle]').forEach((btn) => {
            const id = btn.dataset.radarId ?? '';
            const saved = id && canUseRadar ? isSaved(id) : false;
            btn.classList.toggle('is-saved', saved);
            btn.setAttribute('aria-pressed', String(saved));
            btn.title = saved ? 'Quitar de Mi Radar' : 'Guardar en Mi Radar';
          });
          syncHeaderCount();
          if (radarDrawer?.classList.contains('is-open')) {
            renderRadarDrawer();
          }
        };

        // Delegación de clics en cualquier botón "Guardar" (tarjetas, etc.).
        // Gate duro de registro: sin usuario NO se guarda nada en el radar
        // (ni en LocalStorage); el clic abre el modal de registro contextual
        // "Activa tu Radar" y el producto queda pendiente para guardarse
        // en cuanto exista la cuenta.
        const RADAR_PENDING_KEY = 'tradylor-radar-pending';

        function stagePendingRadarSave(payload: SavedProduct): void {
          try {
            sessionStorage.setItem(RADAR_PENDING_KEY, JSON.stringify(payload));
          } catch { /* sin sessionStorage: el usuario volverá a pulsar el botón. */ }
        }

        function flushPendingRadarSave(): void {
          if (!getCachedSession()?.user) return;
          let raw: string | null = null;
          try {
            raw = sessionStorage.getItem(RADAR_PENDING_KEY);
            if (raw) sessionStorage.removeItem(RADAR_PENDING_KEY);
          } catch { return; }
          if (!raw) return;
          try {
            const payload = JSON.parse(raw) as SavedProduct;
            if (payload?.id && !isSaved(payload.id)) saveToRadar(payload);
          } catch { /* payload inválido: se descarta. */ }
        }

        document.addEventListener('click', async (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const btn = target.closest<HTMLElement>('[data-radar-toggle]');
          if (!btn) return;
          event.preventDefault();
          const { radarId, radarTitle, radarPrice, radarPriceValue, radarImage, radarUrl, radarStore } = btn.dataset;
          if (!radarId) return;
          // Si la sesión sigue en vuelo, se espera antes de decidir (evita
          // tratar como anónimo a un usuario que ya tiene cuenta).
          if (!authReady) {
            try { await getSession(); } catch { /* sin red: se asume anónimo */ }
          }
          const sessionUser = getCachedSession()?.user;
          if (!sessionUser) {
            stagePendingRadarSave({
              id: radarId,
              title: radarTitle ?? '',
              price: radarPrice ?? '',
              priceValue: radarPriceValue ? Number(radarPriceValue) : undefined,
              image: radarImage ?? '',
              buyUrl: radarUrl ?? '',
              store: radarStore === 'aliexpress' ? 'aliexpress' : 'amazon',
              dateAdded: new Date().toISOString(),
            });
            const w = window as unknown as Record<string, { open?: (view?: string, context?: string) => void } | undefined>;
            if (w.TradylorAuth?.open) {
              w.TradylorAuth.open('register', 'radar-add');
            } else {
              window.location.href = '/perfil';
            }
            return;
          }
          if (isSaved(radarId)) {
            removeProduct(radarId);
          } else {
            const payload: SavedProduct = {
              id: radarId,
              title: radarTitle ?? '',
              price: radarPrice ?? '',
              priceValue: radarPriceValue ? Number(radarPriceValue) : undefined,
              image: radarImage ?? '',
              buyUrl: radarUrl ?? '',
              store: radarStore === 'aliexpress' ? 'aliexpress' : 'amazon',
              dateAdded: new Date().toISOString(),
            };
            saveToRadar(payload);
          }
          syncButtons();
        });

        // Gate de conversión del CTA principal "Comprar Ya" (ficha de producto):
        // sin sesión se ofrece el modal de seguimiento de garantía; el enlace
        // pendiente se conserva en el botón "Continuar sin registrarme".
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const cta = target.closest<HTMLAnchorElement>('a.cta-primary-btn[href*="/checkout/"]');
          if (!cta) return;
          if (!authReady || getCachedSession()?.user) return; // logueado o sesión aún sin resolver: pasa
          event.preventDefault();
          const w = window as unknown as Record<string, { open?: (view?: string, context?: string, href?: string) => void } | undefined>;
          w.TradylorAuth?.open?.('login', 'buy-now', cta.getAttribute('href') ?? '');
        });

        // Return Flow: registra salidas directas (.exit-cta) en el radar.
        document.addEventListener(
          'click',
          (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const exitEl = target.closest('a.exit-cta, button.exit-cta');
            if (!exitEl) return;
            const productId = exitEl.getAttribute('data-asin')
              || exitEl.getAttribute('data-title')
              || exitEl.getAttribute('href')
              || '';
            const title = exitEl.getAttribute('data-title') || '';
            if (productId) trackExitClick(String(productId), title);
          },
          { capture: true },
        );

        onRadarChange(syncButtons);
        onAuthChange((user) => {
          // Con cuenta activa se completa el guardado que quedó pendiente
          // en el gate de registro (clic en «Guardar» de una tarjeta).
          if (user) flushPendingRadarSave();
          renderHeaderAuth(user);
          syncButtons();
          if (user) void syncMarketingProfile();
        });
        void initAuth().then((session) => {
          authReady = true;
          if (session.user) flushPendingRadarSave();
          renderHeaderAuth(session.user ?? null);
          syncButtons();
          if (session.user) void syncMarketingProfile();
        });
        // Si no hay sesión aún, muestra el bloque anónimo ya (evita flash).
        renderHeaderAuth(getCachedSession()?.user ?? null);
        syncButtons();
        // Re-sincroniza tras pintar tarjetas dinámicas (fetch del home, etc.).
        window.addEventListener('load', syncButtons);
    </script>

    <!-- Contenedor del widget de Google Translate (fuera de pantalla: sólo lo
         usamos para que aplique la traducción marcada por la cookie). -->
    <div id="google_translate_element" style="position:absolute;top:-9999px;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true"></div>

    <script>
      import { GOOGLE_TRANSLATE_LANGS, TRANSLATE_FLAG_CC } from '../utils/translate';

      /**
       * Botón del traductor del header: muestra un icono de traducción con las
       * siglas del idioma original ("ES") o, si la página está traducida, la
       * bandera del idioma elegido con sus siglas. Escribe la cookie `googtrans`
       * que lee el widget oficial de Google y recarga la página para aplicarla.
       */
      (function initHeaderTranslate(): void {
        const select = document.querySelector<HTMLSelectElement>('[data-translate-select]');
        if (!select) return;

        const targets = GOOGLE_TRANSLATE_LANGS.filter((lang) => lang.code !== 'es');
        const current = readTargetCookie();
        const active = targets.some((lang) => lang.code === current) ? current : '';
        select.value = active;
        renderIndicator(active);

        select.addEventListener('change', () => {
          const target = select.value;
          if (target) writeTargetCookie(`/es/${target}`, false);
          else writeTargetCookie('', true);
          window.location.reload();
        });

        /** Icono + siglas del botón: globe "ES" al original; bandera + siglas al traducir. */
        function renderIndicator(target: string): void {
          const codeEl = document.querySelector<HTMLElement>('[data-translate-code]');
          const globe = document.querySelector<SVGElement>('[data-translate-globe]');
          const flag = document.querySelector<HTMLImageElement>('[data-translate-flag]');
          if (codeEl) codeEl.textContent = target ? target.toUpperCase() : 'ES';

          const cc = target ? TRANSLATE_FLAG_CC[target] : undefined;
          if (!flag || !cc) {
            if (flag) {
              flag.hidden = true;
              flag.removeAttribute('src');
            }
            if (globe) globe.style.display = '';
            return;
          }
          flag.onerror = () => {
            flag.hidden = true;
            if (globe) globe.style.display = '';
          };
          flag.src = `https://flagcdn.com/w40/${cc}.png`;
          flag.hidden = false;
          if (globe) globe.style.display = 'none';
        }

        // Widget oficial de Google (fuera de pantalla): aplica la traducción
        // de la cookie en cada carga de página.
        (window as unknown as Record<string, unknown>).googleTranslateElementInit = () => {
          const google = (window as unknown as { google?: { translate?: { TranslateElement?: unknown } } }).google;
          const TranslateElement = google?.translate?.TranslateElement as
            | (new (options: object, elementId: string) => unknown)
            | undefined;
          if (!TranslateElement) return;
          new TranslateElement(
            {
              pageLanguage: 'es',
              includedLanguages: targets.map((lang) => lang.code).join(','),
              autoDisplay: false,
            },
            'google_translate_element',
          );
        };
        const script = document.createElement('script');
        script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
        script.async = true;
        document.body.appendChild(script);

        /** Último segmento de /es/<idioma> (vacío si no hay cookie). */
        function readTargetCookie(): string {
          const match = /(?:^|;\s*)googtrans=([^;]+)/.exec(document.cookie);
          if (!match) return '';
          const parts = decodeURIComponent(match[1] ?? '').split('/').filter(Boolean);
          return parts.length > 1 ? (parts[parts.length - 1] ?? '') : '';
        }

        /** Escribe (o borra) la cookie que usa el widget de Google Translate. */
        function writeTargetCookie(value: string, clear: boolean): void {
          const expires = clear ? ';expires=Thu, 01 Jan 1970 00:00:00 GMT' : '';
          const attrs = `;path=/${expires};SameSite=Lax`;
          if (window.location.hostname.endsWith('tradylor.com')) {
            document.cookie = `googtrans=${value}${attrs};domain=.tradylor.com`;
          } else {
            document.cookie = `googtrans=${value}${attrs}`;
          }
        }
      })();
    </script>
  )}

  {isBackend && (
    <script is:inline>
      // Seguridad del backend: al cerrar la pestaña/navegador se cierra la
      // sesión del panel (beacon de logout). Se omite si la salida es una
      // navegación interna (enlaces, forms de login/logout, bfcache) para no
      // cortar la sesión por error.
      (() => {
        let internalNav = false;
        document.addEventListener('click', (event) => {
          const anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
          if (!anchor) return;
          try {
            const url = new URL(anchor.getAttribute('href') || '', location.href);
            if (url.origin === location.origin) internalNav = true;
          } catch { /* href no parseable */ }
        }, true);
        document.addEventListener('submit', () => { internalNav = true; }, true);
        window.addEventListener('pagehide', (event) => {
          if (event.persisted || internalNav) return;
          try {
            navigator.sendBeacon(
              '/upayp1b4',
              new Blob(['action=logout'], { type: 'application/x-www-form-urlencoded' })
            );
          } catch { /* beacon no disponible */ }
        });
      })();
    </script>
  )}
  </body>
</html>
