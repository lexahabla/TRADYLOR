      /* Contenido Principal */
      #main-content {
        flex: 1;
      }

      /* Footer */
      .site-footer {
        margin-top: auto;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        background: linear-gradient(180deg, #0a0e17 0%, #0d1321 100%);
