---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalUrl?: string;
  type?: string;
  noindex?: boolean;
  /** Título corto para las tarjetas sociales (Open Graph / Twitter). */
  ogTitle?: string;
  /** Descripción corta para las tarjetas sociales (máx. ~160 caracteres). */
  ogDescription?: string;
}

import ReturnBanner from '../components/ReturnBanner.astro';
import AuthModal from '../components/AuthModal.astro';
import { GOOGLE_TRANSLATE_LANGS } from '../utils/translate';

const {
  title = "Tradylor | Portal de Curación, Recomendaciones y Comparativas de Productos",
  description = "Filtramos el ruido del mercado. Descubre análisis rigurosos, comparativas honestas y las mejores ofertas verificadas para tomar decisiones de compra inteligentes.",
  image = "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1200&auto=format&fit=crop",
  imageAlt,
  canonicalUrl,
  type = "website",
  noindex = false,
  ogTitle,
  ogDescription,
} = Astro.props;

const currentYear = new Date().getFullYear();
// En las páginas del backend se ocultan la navegación pública y las acciones de cabecera
const isBackend = Astro.url.pathname.startsWith('/upayp1b4');

// URLs absolutas para SEO/OG: el social scrapers exigen https:// completo,
// y el dominio canónico sale de `site` (no del host del proxy).
const siteOrigin = Astro.site ?? new URL('https://tradylor.com');
const toAbsolute = (value: string): string =>
  /^https?:\/\//i.test(value) ? value : new URL(value, siteOrigin).href;
const resolvedCanonical = canonicalUrl
  ? toAbsolute(canonicalUrl)
  : new URL(Astro.url.pathname + Astro.url.search, siteOrigin).href;
const resolvedImage = toAbsolute(image);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/favicon.svg?v=2" color="#3b82f6" />
    <meta name="theme-color" content="#0a0e17" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags Primarios -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow, noarchive" : "index, follow"} />

    <!-- Open Graph / Facebook / WhatsApp / Telegram -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:alt" content={imageAlt ?? title} />
    <meta property="og:site_name" content="Tradylor" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? title} />

    <!-- Tipografía Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Estilos Globales & Sistema de Diseño Tradylor -->
    <style is:global>
      :root {
        --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-heading: 'Outfit', 'Inter', sans-serif;
        
        /* Paleta de colores de alta conversión */
        --color-bg-body: #0a0e17;
        --color-bg-card: #111827;
        --color-bg-card-hover: #162032;
        --color-surface-subtle: #1a2234;
        
        --color-primary: #3b82f6;
        --color-primary-hover: #2563eb;
        --color-accent: #10b981;
        --color-accent-amber: #f59e0b;
        
        --color-border: #1f2937;
        --color-border-hover: #374151;
        
        --color-text-main: #f3f4f6;
        --color-text-muted: #9ca3af;
        --color-text-dim: #6b7280;
        
        --max-width: 1200px;
        --border-radius-sm: 8px;
        --border-radius-md: 14px;
        --border-radius-lg: 20px;
        --shadow-card: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        --shadow-glow: 0 0 25px rgba(59, 130, 246, 0.15);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      /* Tailwind preflight está desactivado: sin esta regla, cualquier <img>
         sin CSS propio puede desbordar su contenedor en móvil. */
      img {
        max-width: 100%;
      }

      /* Las reglas de autor (display:flex/absolute) pisan la regla UA
         [hidden]{display:none} y dejaban elementos "ocultos" visibles
         (p. ej. el contenedor de vídeo tapaba la imagen del producto). */
      [hidden] {
        display: none !important;
      }

      html {
        font-family: var(--font-body);
        background-color: var(--color-bg-body);
        color: var(--color-text-main);
        scroll-behavior: smooth;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        /* Evita que elementos fixed desplazados (p. ej. el drawer del carrito)
           ensanchen el área de scroll de la página */
        overflow-x: clip;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        line-height: 1.6;
        overflow-x: hidden;
      }

      .container {
        width: 100%;
        max-width: var(--max-width);
        margin-left: auto;
        margin-right: auto;
        padding-left: 1.5rem;
        padding-right: 1.5rem;
      }

      /* 1. Header */
      .site-header {
        position: sticky;
        top: var(--category-bar-offset, 0px);
        z-index: 100;
        background: rgba(10, 14, 23, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        transition: top 0.35s cubic-bezier(0.23, 1, 0.32, 1), transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
      }
      .site-header.is-hidden {
        transform: translateY(calc(-100% - var(--category-bar-offset, 0px)));
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }
      .brand-logo {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: #ffffff;
      }
      .logo-symbol {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, var(--color-primary) 0%, #60a5fa 100%);
        border-radius: 10px;
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
        flex-shrink: 0;
      }
      .brand-text {
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: 0.02em;
      }
      .brand-text span {
        color: var(--color-primary);
      }

      /* Navegación Principal */
      .main-nav {
        display: flex;
      }
      .nav-list {
        display: flex;
        align-items: center;
        gap: 2rem;
        list-style: none;
      }
      .nav-link {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        position: relative;
        transition: color 0.2s ease;
      }
      .nav-link:hover {
        color: #ffffff;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--color-primary);
        border-radius: 2px;
        transition: width 0.25s ease;
      }
      .nav-link:hover::after {
        width: 100%;
      }

      /* Acciones del Header (Carrito) */
      .header-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .header-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(59, 130, 246, 0.12);
        border: 1px solid rgba(59, 130, 246, 0.35);
        color: #93c5fd;
        font-size: 0.85rem;
        font-weight: 600;
        font-family: var(--font-body);
        padding: 0.55rem 1.1rem;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.25s ease;
      }
      .header-cta-btn:hover {
        background: var(--color-primary);
        color: #ffffff;
        border-color: transparent;
        box-shadow: var(--shadow-glow);
      }
      /* Icono de usuario: sólo en móvil (el texto se oculta en @media ≤640px) */
      .header-cta-icon {
        display: none;
        flex-shrink: 0;
      }

      /* Acciones de cabecera: auth anónimo vs usuario logueado */
      .header-auth-actions {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      .header-auth-actions[hidden],
      .header-user-area[hidden],
      .header-radar-btn[hidden] {
        display: none;
      }
      /* Acceso al Carrito / Radar: icono radar animado + badge */
      .header-radar-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        color: #93c5fd;
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.35);
        border-radius: 12px;
        cursor: pointer;
        padding: 0;
        transition: background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, transform 0.15s ease;
      }
      .header-radar-btn:hover {
        color: #ffffff;
        background: rgba(59, 130, 246, 0.28);
        box-shadow: var(--shadow-glow);
        transform: translateY(-1px);
      }
      .header-radar-btn:active {
        transform: scale(0.96);
      }
      .header-radar-count {
        position: absolute;
        top: -5px;
        right: -5px;
        min-width: 18px;
        height: 18px;
        padding: 0 4px;
        border-radius: 999px;
        background: #ef4444;
        color: #ffffff;
        font-size: 0.68rem;
        font-weight: 700;
        line-height: 18px;
        text-align: center;
        box-shadow: 0 2px 6px rgba(239, 68, 68, 0.55);
        border: 2px solid #0a0e17;
      }
      .header-radar-count[hidden] {
        display: none;
      }
      .radar-sweep {
        transform-origin: 12px 12px;
        animation: radar-sweep-spin 2.4s linear infinite;
      }
      @keyframes radar-sweep-spin {
        to {
          transform: rotate(360deg);
        }
      }
      /* Usuario: botón circular coloreado + menú desplegable */
      .header-user-area {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
        border: 1px solid rgba(96, 165, 250, 0.45);
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.45);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }
      .header-user-area:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.6);
        border-color: rgba(147, 197, 253, 0.75);
      }
      .header-user-area:active {
        transform: scale(0.96);
      }
      .header-user-area.is-open {
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.35), 0 6px 18px rgba(37, 99, 235, 0.6);
        border-color: #93c5fd;
      }
      /* Traductor de Google (a la derecha de todo): icono/bandera + siglas.
         El select nativo tapa el botón (opacity 0) y abre el desplegable. */
      .header-translate {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        height: 40px;
        padding: 0 0.7rem;
        background: rgba(59, 130, 246, 0.08);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 12px;
        transition: background 0.2s ease, border-color 0.2s ease;
      }
      .header-translate:hover {
        background: rgba(59, 130, 246, 0.18);
        border-color: rgba(96, 165, 250, 0.55);
      }
      .header-translate:focus-within {
        outline: 2px solid #60a5fa;
        outline-offset: 2px;
      }
      .header-translate-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 17px;
        height: 17px;
        flex: none;
      }
      .header-translate-globe {
        color: #60a5fa;
      }
      .header-translate-flag {
        width: 21px;
        height: 16px;
        object-fit: cover;
        border-radius: 3px;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25);
      }
      .header-translate-code {
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        line-height: 1;
        color: #e5e7eb;
      }
      .header-translate-native {
        position: absolute;
        inset: 0;
        z-index: 2;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        opacity: 0;
        appearance: none;
        -webkit-appearance: none;
        border: 0;
        background: transparent;
        cursor: pointer;
        font-size: 16px; /* evita el zoom automático al enfocar en iOS */
      }
      .header-user {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
      }
      .header-radar-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        line-height: 1;
        font-size: 1rem;
        font-weight: 800;
        color: #ffffff;
        background: transparent;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        user-select: none;
      }
      .header-radar-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
      }
      .header-radar-avatar:focus-visible {
        outline: 2px solid #bfdbfe;
        outline-offset: 2px;
      }

      /* ---------- Menú desplegable (mismo lenguaje que modales/drawer) ----- */
      .header-user-menu {
        position: absolute;
        top: calc(100% + 12px);
        right: -4px;
        min-width: 264px;
        background: linear-gradient(160deg, #131b2c, #0d1422);
        border: 1px solid rgba(96, 165, 250, 0.22);
        border-radius: 16px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55), 0 2px 0 0 rgba(255, 255, 255, 0.03) inset;
        padding: 0.6rem;
        z-index: 400;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        transform-origin: top right;
        animation: headerUserMenuIn 0.16s ease both;
      }
      /* Flecha hacia el avatar (misma superficie que el panel) */
      .header-user-menu::before {
        content: '';
        position: absolute;
        top: -5px;
        right: 16px;
        width: 11px;
        height: 11px;
        background: linear-gradient(160deg, #131b2c, #0d1422);
        border-left: 1px solid rgba(96, 165, 250, 0.22);
        border-top: 1px solid rgba(96, 165, 250, 0.22);
        border-radius: 3px 0 0 0;
        transform: rotate(45deg);
      }
      .header-user-menu[hidden] {
        display: none;
      }
      @keyframes headerUserMenuIn {
        from {
          opacity: 0;
          transform: translateY(-6px) scale(0.97);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      /* Perfil: mini avatar + nombre/email + estado de sesión */
      .header-user-menu-profile {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.6rem 0.6rem;
        min-width: 0;
        background: rgba(59, 130, 246, 0.07);
        border: 1px solid rgba(59, 130, 246, 0.18);
        border-radius: 12px;
      }
      .header-user-menu-avatar {
        flex: 0 0 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 800;
        line-height: 1;
        overflow: hidden;
      }
      .header-user-menu-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .header-user-menu-profile-text {
        min-width: 0;
      }
      .header-user-menu-profile .radar-profile-name {
        margin: 0;
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--color-text-main);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .header-user-menu-profile .radar-profile-email {
        margin: 0.1rem 0 0;
        font-size: 0.73rem;
        color: var(--color-text-dim);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .header-user-menu-status {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-top: 0.28rem;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #6ee7b7;
      }
      .header-user-menu-status i {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #34d399;
        box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.18);
      }

      /* Separador con degradado (como el resto de la web) */
      .header-user-menu-divider {
        height: 1px;
        margin: 0.5rem 0.15rem;
        background: linear-gradient(90deg, transparent, rgba(96, 165, 250, 0.35), transparent);
      }

      .header-user-menu .radar-sync-badge {
        padding: 0 0.15rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #6ee7b7;
      }

      /* Acciones del menú */
      .header-user-menu-list {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 0.15rem;
      }
      .header-user-menu-btn {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        width: 100%;
        padding: 0.45rem 0.5rem;
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-text-muted);
        text-align: left;
        text-decoration: none;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 12px;
        cursor: pointer;
        transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease,
          transform 0.12s ease;
      }
      .header-user-menu-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: rgba(59, 130, 246, 0.12);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #93c5fd;
        transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
      }
      .header-user-menu-label {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .header-user-menu-arrow {
        flex-shrink: 0;
        color: #64748b;
        transition: transform 0.18s ease, color 0.18s ease;
      }
      .header-user-menu-btn:hover {
        background: rgba(59, 130, 246, 0.14);
        border-color: rgba(59, 130, 246, 0.34);
        color: #ffffff;
        transform: translateX(1px);
      }
      .header-user-menu-btn:hover .header-user-menu-arrow {
        color: #93c5fd;
        transform: translateX(2px);
      }
      .header-user-menu-btn:active {
        transform: scale(0.99);
      }
      .header-user-menu-btn:focus-visible {
        outline: 2px solid #60a5fa;
        outline-offset: 1px;
      }
      .header-user-menu-logout {
        color: #fca5a5;
      }
      .header-user-menu-logout .header-user-menu-icon {
        background: rgba(239, 68, 68, 0.1);
        border-color: rgba(239, 68, 68, 0.3);
        color: #fca5a5;
      }
      .header-user-menu-logout:hover {
        background: rgba(239, 68, 68, 0.14);
        border-color: rgba(239, 68, 68, 0.42);
        color: #ffffff;
      }
      .header-user-menu-logout:hover .header-user-menu-icon {
        background: rgba(239, 68, 68, 0.26);
        border-color: rgba(239, 68, 68, 0.55);
        color: #fecaca;
      }

      /* =========================================================================
         DRAWER CARRITO / MI RADAR (Lateral deslizante)
         ========================================================================= */
      .radar-drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: min(420px, 94vw);
        height: 100vh;
        height: 100dvh;
        background: #0b121e;
        border-left: 1px solid rgba(59, 130, 246, 0.25);
        box-shadow: -20px 0 60px rgba(0, 0, 0, 0.65);
        transform: translateX(105%);
        transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 300;
        display: flex;
        flex-direction: column;
      }
      .radar-drawer.is-open {
        transform: translateX(0);
      }
      .radar-drawer-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(4, 8, 15, 0.7);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.28s ease;
        z-index: 250;
      }
      body.radar-drawer-is-open .radar-drawer-backdrop {
        opacity: 1;
        pointer-events: auto;
      }
      body.radar-drawer-is-open {
        overflow: hidden;
      }
      .radar-drawer-header {
        display: flex;
