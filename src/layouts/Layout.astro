    </style>

    <!-- Oculta el banner y el gadget del widget de Google Translate (sólo usamos
         el desplegable propio del header; la traducción la aplica la cookie). -->
    <style is:global>
      .goog-te-banner-frame,
      .goog-te-menu-frame,
      .goog-te-gadget {
        display: none !important;
      }
      body {
        top: 0 !important;
      }
      .goog-text-highlight {
        background: none !important;
        box-shadow: none !important;
      }
    </style>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Tradylor",
      "url": "https://tradylor.com",
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "Tradylor Media",
        "logo": {
          "@type": "ImageObject",
          "url": "https://tradylor.com/logo.png"
        }
      }
    })} />
  </head>

  <body>
    <!-- 1. Header de Navegación Global -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-logo" aria-label="Tradylor - Inicio">
          <span class="logo-symbol">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </span>
          <span class="brand-text">TRADY<span>LOR</span></span>
        </a>

        {!isBackend && (
          <>
            <button type="button" class="nav-toggle-btn" aria-label="Abrir menú" aria-controls="mainNav" aria-expanded="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="4" y1="7" x2="20" y2="7"></line>
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <line x1="4" y1="17" x2="20" y2="17"></line>
              </svg>
            </button>

            <nav id="mainNav" class="main-nav" aria-label="Navegación Principal">
              <ul class="nav-list">
                <li><a href="/#destacados" class="nav-link">Top Selecciones</a></li>
                <li><a href="/#metodologia" class="nav-link">Metodología</a></li>
                <li><a href="/#comparativas" class="nav-link">Comparativas</a></li>
                <li><a href="#aviso-legal" class="nav-link">Aviso de Afiliación</a></li>
              </ul>
            </nav>

            <div class="header-actions">
              <!-- Carrito / Mi Radar (icono radar animado + badge contador) -->
              <button
                type="button"
                class="header-radar-btn"
                data-header-radar-btn
                data-radar-drawer-toggle
                aria-label="Abrir carrito de productos guardados"
                aria-expanded="false"
                aria-controls="radarDrawer"
                hidden
              >
                <svg class="radar-anim" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" opacity="0.45"></circle>
                  <circle cx="12" cy="12" r="5" opacity="0.7"></circle>
                  <line class="radar-sweep" x1="12" y1="12" x2="12" y2="4"></line>
