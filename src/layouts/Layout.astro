        color: #ffffff;
      }
      .radar-drawer-actions {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .radar-drawer-panel-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.75rem 1rem;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 60%, #1e40af 100%);
        color: #ffffff;
        font-family: var(--font-heading);
        font-size: 0.9rem;
