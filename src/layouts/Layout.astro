    <script is:inline>
      (() => {
        const navToggleBtn = document.querySelector('.nav-toggle-btn');
        const mainNav = document.getElementById('mainNav');
        if (navToggleBtn && mainNav) {
          const closeNav = () => {
            mainNav.classList.remove('is-open');
            navToggleBtn.setAttribute('aria-expanded', 'false');
          };
          navToggleBtn.addEventListener('click', () => {
            const open = mainNav.classList.toggle('is-open');
            navToggleBtn.setAttribute('aria-expanded', String(open));
            navToggleBtn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
          });
          mainNav.addEventListener('click', (event) => {
            if (event.target.closest('a')) closeNav();
          });
          document.addEventListener('click', (event) => {
            const target = event.target;
            if (target.closest('.category-menu-btn')) closeNav();
            else if (!target.closest('.site-header') && !target.closest('#categoryBar')) closeNav();
          });
        }

        // --- Analítica: sesión, visitor id, duración y beacons ---------------
        const crearId = () =>
          (typeof crypto !== 'undefined' && 'randomUUID' in crypto)
            ? crypto.randomUUID()
            : `${Math.random().toString(36).slice(2)}${Date.now().toString(36)}`;
        const leerId = (storage, key) => {
          try { return storage.getItem(key) || null; } catch { return null; }
        };
        const guardarId = (storage, key, value) => {
          try { storage.setItem(key, value); } catch { /* modo privado */ }
        };
        let analyticsSessionId = leerId(sessionStorage, 'tradylor_sid');
        if (!analyticsSessionId) {
          analyticsSessionId = crearId();
          guardarId(sessionStorage, 'tradylor_sid', analyticsSessionId);
        }
        let analyticsVisitorId = leerId(localStorage, 'tradylor_vid');
        if (!analyticsVisitorId) {
          analyticsVisitorId = crearId();
          guardarId(localStorage, 'tradylor_vid', analyticsVisitorId);
        }
        const analyticsStartedAt = Date.now();
        const enviarEvento = (payload) => {
          fetch('/api/analytics/event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({
              sessionId: analyticsSessionId,
              visitorId: analyticsVisitorId,
              referrer: document.referrer || '',
              path: window.location.pathname,
              ...payload,
            }),
          }).catch(() => {});
        };
        enviarEvento({ type: 'page_view' });
        let duracionEnviada = false;
        const enviarDuracion = () => {
          if (duracionEnviada) return;
          const durationMs = Date.now() - analyticsStartedAt;
          if (durationMs < 1500) return;
          duracionEnviada = true;
          enviarEvento({ type: 'page_duration', durationMs });
        };
        window.addEventListener('pagehide', enviarDuracion);
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') enviarDuracion();
        });
        // Las salidas a tienda del flujo interno NO se envían desde aquí: las
        // registra /api/redirect (fuente única, sin doble conteo).
        // En cambio, los CTA de salida directa (.exit-cta) SÍ se registran aquí
        // porque navegan en target="_blank" sin pasar por el servidor.
        document.addEventListener('click', (event) => {
          const exitEl = event.target && event.target.closest
            ? event.target.closest('a.exit-cta, button.exit-cta')
            : null;
          if (!exitEl || typeof exitEl.href !== 'string' || !exitEl.href) return;
          const payload = {
            type: 'outbound_click',
            productId: exitEl.dataset.asin || exitEl.dataset.title || exitEl.getAttribute('href') || '',
            network: exitEl.dataset.network || 'amazon',
            path: window.location.pathname,
          };
          enviarEvento(payload);
          // Puente opcional con GTM/ga4 si el contenedor de datos existe.
          if (Array.isArray(window.dataLayer)) {
            window.dataLayer.push({ event: 'exit_cta_click', href: exitEl.href, ...payload });
          }
        }, true);

        const backToTop = document.querySelector('.back-to-top');
        if (backToTop) {
          const toggleBackToTop = () => backToTop.classList.toggle('is-visible', window.scrollY > 400);
          window.addEventListener('scroll', toggleBackToTop, { passive: true });
          toggleBackToTop();
          backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        }
      })();
    </script>
    {!isBackend && (
