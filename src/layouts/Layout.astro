        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .back-to-top {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 150;
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(12, 16, 26, 0.95);
        border: 1px solid rgba(59, 130, 246, 0.4);
        border-radius: 50%;
        color: #93c5fd;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(12px);
        transition:
          opacity 0.3s ease,
          transform 0.3s ease,
          visibility 0.3s ease,
          background 0.2s ease,
          color 0.2s ease,
          border-color 0.2s ease;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      }
      .back-to-top.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      .back-to-top:hover {
        background: var(--color-primary);
        border-color: transparent;
        color: #ffffff;
        box-shadow: var(--shadow-glow);
      }

      /* Responsive */
      @media (max-width: 960px) {
        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }
        .brand-col {
          grid-column: 1 / -1;
        }
        .main-nav {
          display: none;
        }
        .header-inner {
          display: grid;
          grid-template-columns: auto minmax(0, 1fr) auto;
          align-items: center;
        }
        .site-header .brand-logo {
          position: static;
          justify-self: center;
          transform: none;
          grid-column: 2;
          grid-row: 1;
        }
        .header-actions {
          grid-column: 3;
          grid-row: 1;
          justify-self: end;
        }
        .nav-toggle-btn {
          display: inline-flex;
          grid-column: 1;
          grid-row: 1;
          justify-self: start;
        }
        /* Login: icono de usuario en cuanto el menú se colapsa */
        .header-cta-btn {
          width: 44px;
          height: 44px;
          padding: 0;
          justify-content: center;
          border-radius: 12px;
        }
        .header-cta-icon {
          display: block;
        }
        .header-cta-text {
          display: none;
        }
        .main-nav.is-open {
          display: block;
