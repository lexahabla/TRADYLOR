---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: string;
  noindex?: boolean;
}

import ReturnBanner from '../components/ReturnBanner.astro';
import AuthModal from '../components/AuthModal.astro';

const {
  title = "Tradylor | Portal de Curación, Recomendaciones y Comparativas de Productos",
  description = "Filtramos el ruido del mercado. Descubre análisis rigurosos, comparativas honestas y las mejores ofertas verificadas para tomar decisiones de compra inteligentes.",
  image = "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1200&auto=format&fit=crop",
  canonicalUrl = Astro.url.href,
  type = "website",
  noindex = false,
} = Astro.props;

const currentYear = new Date().getFullYear();
// En las páginas del backend se ocultan la navegación pública y las acciones de cabecera
const isBackend = Astro.url.pathname.startsWith('/admin');
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/favicon.svg?v=2" color="#3b82f6" />
    <meta name="theme-color" content="#0a0e17" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags Primarios -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex, nofollow, noarchive" : "index, follow"} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Tradylor" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Tipografía Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Estilos Globales & Sistema de Diseño Tradylor -->
    <style is:global>
      :root {
        --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-heading: 'Outfit', 'Inter', sans-serif;
        
        /* Paleta de colores de alta conversión */
        --color-bg-body: #0a0e17;
        --color-bg-card: #111827;
        --color-bg-card-hover: #162032;
        --color-surface-subtle: #1a2234;
        
        --color-primary: #3b82f6;
        --color-primary-hover: #2563eb;
        --color-accent: #10b981;
        --color-accent-amber: #f59e0b;
        
        --color-border: #1f2937;
        --color-border-hover: #374151;
        
        --color-text-main: #f3f4f6;
        --color-text-muted: #9ca3af;
        --color-text-dim: #6b7280;
        
        --max-width: 1200px;
        --border-radius-sm: 8px;
        --border-radius-md: 14px;
        --border-radius-lg: 20px;
        --shadow-card: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        --shadow-glow: 0 0 25px rgba(59, 130, 246, 0.15);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      /* Tailwind preflight está desactivado: sin esta regla, cualquier <img>
         sin CSS propio puede desbordar su contenedor en móvil. */
      img {
        max-width: 100%;
      }

      /* Las reglas de autor (display:flex/absolute) pisan la regla UA
         [hidden]{display:none} y dejaban elementos "ocultos" visibles
         (p. ej. el contenedor de vídeo tapaba la imagen del producto). */
      [hidden] {
        display: none !important;
      }

      html {
        font-family: var(--font-body);
        background-color: var(--color-bg-body);
        color: var(--color-text-main);
        scroll-behavior: smooth;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        /* Evita que elementos fixed desplazados (p. ej. el drawer del carrito)
           ensanchen el área de scroll de la página */
        overflow-x: clip;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        line-height: 1.6;
        overflow-x: hidden;
      }

      .container {
        width: 100%;
        max-width: var(--max-width);
        margin-left: auto;
        margin-right: auto;
        padding-left: 1.5rem;
        padding-right: 1.5rem;
      }

      /* 1. Header */
      .site-header {
        position: sticky;
        top: var(--category-bar-offset, 0px);
        z-index: 100;
        background: rgba(10, 14, 23, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        transition: top 0.35s cubic-bezier(0.23, 1, 0.32, 1), transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
      }
      .site-header.is-hidden {
        transform: translateY(-100%);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }
      .brand-logo {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: #ffffff;
      }
      .logo-symbol {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, var(--color-primary) 0%, #60a5fa 100%);
        border-radius: 10px;
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
        flex-shrink: 0;
      }
      .brand-text {
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: 0.02em;
      }
      .brand-text span {
        color: var(--color-primary);
      }

      /* Navegación Principal */
      .main-nav {
        display: flex;
      }
      .nav-list {
        display: flex;
        align-items: center;
        gap: 2rem;
        list-style: none;
      }
      .nav-link {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        position: relative;
        transition: color 0.2s ease;
      }
      .nav-link:hover {
        color: #ffffff;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--color-primary);
        border-radius: 2px;
        transition: width 0.25s ease;
      }
      .nav-link:hover::after {
        width: 100%;
      }

      /* Acciones del Header (Carrito) */
      .header-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .header-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(59, 130, 246, 0.12);
        border: 1px solid rgba(59, 130, 246, 0.35);
        color: #93c5fd;
        font-size: 0.85rem;
        font-weight: 600;
        font-family: var(--font-body);
        padding: 0.55rem 1.1rem;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.25s ease;
      }
      .header-cta-btn:hover {
        background: var(--color-primary);
        color: #ffffff;
        border-color: transparent;
        box-shadow: var(--shadow-glow);
      }
      /* Icono de usuario: sólo en móvil (el texto se oculta en @media ≤640px) */
      .header-cta-icon {
        display: none;
        flex-shrink: 0;
      }

      /* Acciones de cabecera: auth anónimo vs usuario logueado */
      .header-auth-actions {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      .header-auth-actions[hidden],
      .header-user-area[hidden],
      .header-radar-btn[hidden] {
        display: none;
      }
      /* Acceso al Carrito / Radar: icono radar animado + badge */
      .header-radar-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        color: #93c5fd;
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.35);
        border-radius: 12px;
        cursor: pointer;
        padding: 0;
        transition: background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, transform 0.15s ease;
      }
      .header-radar-btn:hover {
        color: #ffffff;
        background: rgba(59, 130, 246, 0.28);
        box-shadow: var(--shadow-glow);
        transform: translateY(-1px);
      }
      .header-radar-btn:active {
        transform: scale(0.96);
      }
      .header-radar-count {
        position: absolute;
        top: -5px;
        right: -5px;
        min-width: 18px;
        height: 18px;
        padding: 0 4px;
        border-radius: 999px;
        background: #ef4444;
        color: #ffffff;
        font-size: 0.68rem;
        font-weight: 700;
        line-height: 18px;
        text-align: center;
        box-shadow: 0 2px 6px rgba(239, 68, 68, 0.55);
        border: 2px solid #0a0e17;
      }
      .header-radar-count[hidden] {
        display: none;
      }
      .radar-sweep {
        transform-origin: 12px 12px;
        animation: radar-sweep-spin 2.4s linear infinite;
      }
      @keyframes radar-sweep-spin {
        to {
          transform: rotate(360deg);
        }
      }
      /* Usuario: botón circular coloreado + menú desplegable */
      .header-user-area {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.45);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.2s ease;
      }
      .header-user-area:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.6);
      }
      .header-user-area:active {
        transform: scale(0.96);
      }
      .header-user {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
      }
      .header-radar-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        line-height: 1;
        font-size: 1rem;
        font-weight: 800;
        color: #ffffff;
        background: transparent;
        border: none;
        cursor: pointer;
        user-select: none;
      }
      .header-radar-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
      }
      .header-user-menu {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        min-width: 230px;
        background: #101827;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
        padding: 0.75rem;
        z-index: 400;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }
      .header-user-menu[hidden] {
        display: none;
      }
      .header-user-menu-profile {
        padding: 0 0.15rem;
        min-width: 0;
      }
      .header-user-menu-profile .radar-profile-name {
        margin: 0;
        font-weight: 700;
        font-size: 0.92rem;
        color: var(--color-text-main);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .header-user-menu-profile .radar-profile-email {
        margin: 0.15rem 0 0;
        font-size: 0.75rem;
        color: var(--color-text-dim);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .header-user-menu-divider {
        height: 1px;
        background: var(--color-border);
        margin: 0.35rem 0;
        opacity: 0.6;
      }
      .header-user-menu .radar-sync-badge {
        padding: 0 0.15rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #6ee7b7;
      }
      .header-user-menu-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.5rem 0.6rem;
        font-size: 0.82rem;
        text-align: left;
        text-decoration: none;
        border-radius: 8px;
        transition: background 0.15s ease;
      }
      .header-user-menu-btn:hover {
        background: rgba(255, 255, 255, 0.07);
      }
      .header-user-menu-logout {
        color: #f87171;
      }
      .header-user-menu-logout:hover {
        background: rgba(248, 113, 113, 0.1);
      }

      /* =========================================================================
         DRAWER CARRITO / MI RADAR (Lateral deslizante)
         ========================================================================= */
      .radar-drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: min(420px, 94vw);
        height: 100vh;
        height: 100dvh;
        background: #0b121e;
        border-left: 1px solid rgba(59, 130, 246, 0.25);
        box-shadow: -20px 0 60px rgba(0, 0, 0, 0.65);
        transform: translateX(105%);
        transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 300;
        display: flex;
        flex-direction: column;
      }
      .radar-drawer.is-open {
        transform: translateX(0);
      }
      .radar-drawer-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(4, 8, 15, 0.7);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.28s ease;
        z-index: 250;
      }
      body.radar-drawer-is-open .radar-drawer-backdrop {
        opacity: 1;
        pointer-events: auto;
      }
      body.radar-drawer-is-open {
        overflow: hidden;
      }
      .radar-drawer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.4rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 23, 42, 0.6);
      }
      .radar-drawer-kicker {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #93c5fd;
        font-weight: 600;
      }
      .radar-drawer-title {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0.15rem 0 0;
      }
      .radar-drawer-header-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.15rem 0.55rem;
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(59, 130, 246, 0.35);
        color: #93c5fd;
        font-size: 0.75rem;
        border-radius: 999px;
        font-weight: 700;
      }
      .radar-drawer-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #9ca3af;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .radar-drawer-close:hover {
        color: #ffffff;
        background: rgba(239, 68, 68, 0.2);
        border-color: rgba(239, 68, 68, 0.4);
      }
      .radar-drawer-items {
        flex: 1;
        overflow-y: auto;
        padding: 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
      }
      .radar-drawer-item {
        display: flex;
        gap: 0.85rem;
        background: rgba(17, 24, 39, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 0.85rem;
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      .radar-drawer-item:hover {
        border-color: rgba(59, 130, 246, 0.3);
        background: rgba(17, 24, 39, 0.95);
      }
      .radar-drawer-thumb {
        width: 60px;
        height: 60px;
        flex-shrink: 0;
        border-radius: 8px;
        background: #ffffff;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      .radar-drawer-thumb img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .radar-drawer-no-img {
        color: #6b7280;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .radar-drawer-item-info {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 0;
        flex: 1;
      }
      .radar-drawer-item-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }
      .radar-drawer-store-tag {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        background: rgba(59, 130, 246, 0.15);
        color: #93c5fd;
      }
      .radar-drawer-item-remove {
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        padding: 2px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: color 0.15s ease, background 0.15s ease;
      }
      .radar-drawer-item-remove:hover {
        color: #ef4444;
        background: rgba(239, 68, 68, 0.1);
      }
      .radar-drawer-item-title {
        color: #f3f4f6;
        font-size: 0.84rem;
        font-weight: 600;
        line-height: 1.35;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.15s ease;
      }
      .radar-drawer-item-title:hover {
        color: #60a5fa;
      }
      .radar-drawer-item-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-top: 0.15rem;
      }
      .radar-drawer-item-price {
        font-size: 0.92rem;
        font-weight: 700;
        color: #38bdf8;
      }
      .radar-drawer-item-buy {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        background: rgba(59, 130, 246, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.35);
        color: #93c5fd;
        font-size: 0.76rem;
        font-weight: 600;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
      }
      .radar-drawer-item-buy:hover {
        background: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
      }
      .radar-drawer-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        color: #9ca3af;
        text-align: center;
        padding: 2.5rem 1.5rem;
      }
      .radar-drawer-empty[hidden] {
        display: none;
      }
      .radar-drawer-empty-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.25);
        color: #60a5fa;
        margin-bottom: 0.25rem;
      }
      .radar-drawer-empty-title {
        color: #ffffff;
        font-weight: 700;
        font-size: 1.05rem;
        margin: 0;
      }
      .radar-drawer-empty-desc {
        font-size: 0.82rem;
        line-height: 1.55;
        color: #9ca3af;
        max-width: 260px;
      }
      .radar-drawer-footer {
        padding: 1.25rem 1.4rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 23, 42, 0.7);
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .radar-drawer-footer[hidden] {
        display: none;
      }
      .radar-drawer-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .radar-drawer-summary-label {
        font-size: 0.84rem;
        color: #9ca3af;
      }
      .radar-drawer-summary-total {
        font-size: 1.15rem;
        font-weight: 800;
        color: #ffffff;
      }
      .radar-drawer-actions {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .radar-drawer-panel-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.75rem 1rem;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 60%, #1e40af 100%);
        color: #ffffff;
        font-family: var(--font-heading);
        font-size: 0.9rem;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        border-radius: 10px;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
        transition: transform 0.15s ease, box-shadow 0.2s ease;
      }
      .radar-drawer-panel-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 22px rgba(37, 99, 235, 0.55);
      }
