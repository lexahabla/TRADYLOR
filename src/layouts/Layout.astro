          top: 100%;
          left: 0;
          right: 0;
          background: rgba(10, 14, 23, 0.97);
          border-bottom: 1px solid rgba(255, 255, 255, 0.08);
          box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
          backdrop-filter: blur(16px);
          -webkit-backdrop-filter: blur(16px);
          padding: 0.5rem 1.5rem 1rem;
        }
        .main-nav.is-open .nav-list {
          flex-direction: column;
          align-items: stretch;
          gap: 0;
        }
        .main-nav.is-open .nav-link {
          display: block;
          padding: 0.9rem 0;
          font-size: 0.95rem;
          border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }
        .main-nav.is-open .nav-list li:last-child .nav-link {
          border-bottom: none;
        }
        .main-nav.is-open .nav-link::after {
          display: none;
        }
      }
      @media (max-width: 640px) {
        /* Móvil: menos aire lateral para que el logo central quepa más grande
           sin chocar con los botones de los extremos. */
        .site-header .container {
          padding-left: 1.25rem;
          padding-right: 1.25rem;
        }
        .nav-toggle-btn {
          width: 44px;
          height: 44px;
          border-radius: 12px;
        }
        .nav-toggle-btn svg {
