---
/**
 * TRADYLOR — Layout del backend de Marketing (/admin/marketing/*).
 *
 * Proporciona la barra de navegación lateral con los 6 módulos + resumen, el
 * menú de usuario del backend (slot `header-end`) y la autenticación obligatoria
 * (sesión de backend + rol admin). Las páginas del módulo sólo aportan su
 * contenido en el slot por defecto.
 */
import Layout from './Layout.astro';
import AdminUserMenu from '../components/AdminUserMenu.astro';
import { getSessionUser } from '../lib/adminAuth';
import type { MarketingModuleId } from '../types/marketing';

export const prerender = false;

interface Props {
  title: string;
  description: string;
  /** Módulo activo (resalta la entrada de la navegación lateral). */
  active: MarketingModuleId;
}

const { title, description, active } = Astro.props;

const sessionUser = getSessionUser(Astro.request);
if (!sessionUser) return Astro.redirect('/admin');
if (sessionUser.role !== 'admin') return Astro.redirect('/admin/perfil');

Astro.response.headers.set('Cache-Control', 'no-store');

interface MarketingNavItem {
  id: MarketingModuleId;
  label: string;
  href: string;
  hint: string;
  icon: string;
}

const NAV_ITEMS: MarketingNavItem[] = [
  {
    id: 'overview',
    label: 'Resumen',
    href: '/admin/marketing',
    hint: 'Panel de control del módulo',
    icon: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  },
  {
    id: 'users',
    label: 'Audiencias',
    href: '/admin/marketing/users',
    hint: 'Perfiles 360°, lead score y email marketing',
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
  {
    id: 'map',
    label: 'Market Map',
    href: '/admin/marketing/map',
    hint: 'Tráfico, ventas y mercados emergentes',
    icon: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  },
  {
    id: 'calendar',
    label: 'Calendario',
    href: '/admin/marketing/calendar',
    hint: 'Fechas clave y alertas de campañas',
    icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  },
  {
    id: 'agency-ai',
    label: 'AI Agency',
    href: '/admin/marketing/agency-ai',
    hint: 'Agente LLM autónomo con skills',
    icon: '<rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 8V5"/><circle cx="12" cy="3.5" r="1.5"/><path d="M9 13.5v1"/><path d="M15 13.5v1"/><line x1="2" y1="13" x2="4" y2="13"/><line x1="20" y1="13" x2="22" y2="13"/>',
  },
  {
    id: 'actions',
    label: 'Playbooks & ROI',
    href: '/admin/marketing/actions',
    hint: 'Manuales de conversión y calculadora',
    icon: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  },
  {
    id: 'trends',
    label: 'Tendencias',
    href: '/admin/marketing/trends',
    hint: 'Escucha activa y matriz de canales',
    icon: '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>',
  },
];
---

<Layout title={title} description={description}>
  <Fragment slot="header-end">
    <AdminUserMenu user={sessionUser} active="marketing" />
  </Fragment>

  <div class="mx-auto flex w-full max-w-[1440px] gap-6 px-4 py-6 lg:px-8">
    <!-- Navegación lateral (escritorio) -->
    <aside class="hidden w-60 shrink-0 lg:block">
      <div class="sticky top-6 flex flex-col gap-4">
        <div class="px-1">
          <p class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-blue-400">
            TRADYLOR Marketing
          </p>
          <a
            href="/admin"
            class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-white/50 transition hover:text-white/80"
          >
            ← Panel de control
          </a>
        </div>

        <nav class="flex flex-col gap-1 rounded-2xl border border-white/10 bg-white/[0.03] p-2" aria-label="Módulos de marketing">
          {
            NAV_ITEMS.map((item) => (
              <a
                href={item.href}
                aria-current={active === item.id ? 'page' : undefined}
                class:list={[
                  'group flex items-start gap-2.5 rounded-xl px-3 py-2.5 transition',
                  active === item.id
                    ? 'bg-blue-500/15 text-blue-200 ring-1 ring-inset ring-blue-400/40'
                    : 'text-white/65 hover:bg-white/[0.05] hover:text-white',
                ]}
              >
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 shrink-0"
                  aria-hidden="true"
                  set:html={item.icon}
                />
                <span class="min-w-0">
                  <span class="block text-[13px] font-bold leading-tight">{item.label}</span>
                  <span class="mt-0.5 block text-[11px] leading-tight text-white/40">{item.hint}</span>
                </span>
              </a>
            ))
          }
        </nav>

        <p class="px-1 text-[11px] leading-relaxed text-white/35">
          Datos de ejemplo · API mock preparada para conectar la BD de la tienda.
        </p>
      </div>
    </aside>

    <!-- Navegación horizontal (móvil / tablet) -->
    <div class="flex min-w-0 flex-1 flex-col gap-5">
      <nav
        class="flex gap-2 overflow-x-auto pb-1 lg:hidden"
        aria-label="Módulos de marketing (móvil)"
      >
        {
          NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.id ? 'page' : undefined}
              class:list={[
                'flex shrink-0 items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-xs font-bold transition',
                active === item.id
                  ? 'border-blue-400/50 bg-blue-500/15 text-blue-200'
                  : 'border-white/10 bg-white/[0.03] text-white/60 hover:text-white',
              ]}
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={item.icon}
              />
              {item.label}
            </a>
          ))
        }
      </nav>

      <main class="min-w-0 flex-1">
        <slot />
      </main>
    </div>
  </div>
</Layout>
