<script>
  // Galería de imágenes/vídeos: miniaturas + flechas laterales (carrusel).
  // Un vídeo muestra su miniatura con botón play en la imagen principal;
  // al clicar se abre en el modal lightbox (videoModalBody).
  import { isVideoUrl, videoEmbedUrl, videoThumbUrl } from '../../lib/media';

  document.addEventListener('DOMContentLoaded', () => {
    const mainImg = document.getElementById('mainProductImg');
    const mainVideoWrap = document.getElementById('mainVideoWrap');
    const mainVideoPlay = document.getElementById('mainVideoPlay');
    const thumbs = document.getElementById('productThumbs');
    const prevBtn = document.getElementById('galleryPrev');
    const nextBtn = document.getElementById('galleryNext');
    const counter = document.getElementById('galleryCounter');
    const videoModal = document.getElementById('videoModal');
    const videoModalBody = document.getElementById('videoModalBody');
    if (!mainImg) return;

    const thumbBtns = thumbs ? Array.from(thumbs.querySelectorAll('.product-thumb')) : [];
    const gallery = thumbBtns.map((b) => b.getAttribute('data-full')).filter(Boolean);
    let index = 0;
    let lastImageIndex = 0;

    // ── Modal de vídeo (lightbox) ──
    function openVideoModal(url) {
      if (!videoModal || !videoModalBody || !url) return;
      videoModalBody.innerHTML = '';
      const embed = videoEmbedUrl(url, true);
      if (embed) {
        const iframe = document.createElement('iframe');
        iframe.src = embed;
        iframe.title = 'Vídeo del producto';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        videoModalBody.appendChild(iframe);
      } else {
        const video = document.createElement('video');
        video.src = url;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        videoModalBody.appendChild(video);
      }
      videoModal.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeVideoModal() {
      if (!videoModal) return;
      videoModal.hidden = true;
      if (videoModalBody) videoModalBody.innerHTML = '';
      document.body.style.overflow = '';
      // Al cerrar, si el carrusel quedó sobre un vídeo, restaura la última imagen.
      if (gallery[index] && isVideoUrl(gallery[index])) show(lastImageIndex);
    }

    if (videoModal) {
      videoModal.addEventListener('click', (e) => {
        if (e.target && e.target.closest && e.target.closest('[data-video-modal-close]')) closeVideoModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !videoModal.hidden) closeVideoModal();
      });
    }

    // ── Zona principal: miniatura del vídeo + overlay play ──
    function clearMainVideo() {
      if (mainVideoWrap) {
        mainVideoWrap.innerHTML = '';
        mainVideoWrap.hidden = true;
      }
      if (mainVideoPlay) mainVideoPlay.hidden = true;
    }

    function showMainVideo(item) {
      const still = videoThumbUrl(item);
      if (still) {
        // Plataforma (YouTube/Vimeo/DM): miniatura oficial en la imagen principal.
        if (mainVideoWrap) {
          mainVideoWrap.innerHTML = '';
          mainVideoWrap.hidden = true;
        }
        mainImg.hidden = false;
        mainImg.src = still;
      } else {
        // Archivo directo (mp4/webm): primer fotograma del propio vídeo.
        mainImg.hidden = true;
        if (mainVideoWrap) {
          mainVideoWrap.innerHTML = '';
          const v = document.createElement('video');
          v.src = item;
          v.muted = true;
          v.preload = 'metadata';
          v.playsInline = true;
          v.setAttribute('aria-hidden', 'true');
          mainVideoWrap.appendChild(v);
          mainVideoWrap.hidden = false;
        }
      }
      if (mainVideoPlay) mainVideoPlay.hidden = false;
    }

    function show(i) {
      if (!gallery.length) return;
      index = (i + gallery.length) % gallery.length;
      const item = gallery[index];
      if (isVideoUrl(item)) {
        // Vídeo: se muestra su miniatura con el botón play (el modal se abre al clicar).
        showMainVideo(item);
      } else {
        clearMainVideo();
        mainImg.hidden = false;
        lastImageIndex = index;
        mainImg.src = item;
      }
      thumbBtns.forEach((t, ti) => t.classList.toggle('is-active', ti === index));
      if (counter) counter.textContent = `${index + 1} / ${gallery.length}`;
    }

    // Clic en la zona principal (imagen del vídeo) → abrir modal.
    if (mainVideoPlay) {
      mainVideoPlay.addEventListener('click', () => {
        const item = gallery[index];
        if (item && isVideoUrl(item)) openVideoModal(item);
      });
    }

    if (thumbs) {
      thumbs.addEventListener('click', (e) => {
        const btn = e.target.closest('.product-thumb');
        if (!btn) return;
        const i = thumbBtns.indexOf(btn);
        if (i >= 0) show(i);
      });
    }
    if (prevBtn) prevBtn.addEventListener('click', () => show(index - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => show(index + 1));
  });
</script>

