    <div class="video-modal-dialog" role="dialog" aria-modal="true" aria-label="Reproductor de vídeo">
      <button type="button" class="video-modal-close" data-video-modal-close aria-label="Cerrar reproductor">×</button>
      <div id="videoModalBody" class="video-modal-body"></div>
    </div>
  </div>
