---
/**
 * ==============================================================================
 * TRADYLOR — FICHA DE PRODUCTO (ANÁLISIS TÉCNICO NEUTRAL)
 * ==============================================================================
 *
 * Ruta dinámica SSR: /producto/[slug]
 * (acepta también el id legado: /producto/sony-wh-1000xm5 sigue operativo)
 *
 * FLUJO DE COMPRA DELEGADA (Delegated Checkout):
 *  ProductCard → /producto/[slug] → /checkout/[id] → /api/redirect → 302 → Tienda
 *
 * El affiliateUrl real NUNCA aparece en esta página ni en la pantalla puente:
 * el CTA "Comprar ya" abre /checkout/[id] (resumen nativo con plazo de envío,
 * transportista y distribuidor) y sólo desde allí se sale con /api/redirect
 * (registro de clic + 302 con el enlace de afiliado o el buyNowUrl, si existe).
 * ==============================================================================
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { getCatalogProducts, findCatalogProduct, productKey } from '../../lib/catalog';
import { isVideoUrl, videoThumbUrl } from '../../lib/media';

const allProducts = getCatalogProducts();
const cleanMarketplaceSuffix = (text: string) => text.replace(/\s*[\-|:]\s*(Amazon(?:\.es)?|PcComponentes|El Corte Inglés|MediaMarkt|Fnac|AliExpress|Carrefour|Apple).*$/i, '').trim();

// ---------------------------------------------------------------------------
// Resolución del producto (slug canónico o id legado)
// ---------------------------------------------------------------------------
const product = findCatalogProduct(Astro.params.slug);
const displayTitle = product ? cleanMarketplaceSuffix(product.title) : '';
const displayDescription = product ? cleanMarketplaceSuffix(product.description) : '';

// Si no existe el producto, redirigir al inicio
if (!product) {
  return Astro.redirect('/', 302);
}

// Pantalla puente de Compra Delegada: resumen (envío, transportista, vendedor)
// antes de salir con /api/redirect al enlace de afiliado (o buyNowUrl si existe).
const checkoutUrl = `/checkout/${productKey(product)}`;
const specs = product.specs && Object.keys(product.specs).length > 0 ? product.specs : null;
const fulfillmentProvider = product.fulfillmentProvider ?? product.merchant;

// Galería completa del carrusel: imagen principal + vistas adicionales (sin duplicados).
const galleryImages = [
  ...new Set([product.image, ...(Array.isArray(product.gallery) ? product.gallery : [])]),
].filter(Boolean);
const hasGalleryCarousel = galleryImages.length > 1;

// Comparativa: productos de la misma categoría (incluye el actual)
const sameCategory = allProducts.filter((p) => p.category === product.category);
const alternativesCount = sameCategory.filter((p) => p.id !== product.id).length;

// ---------------------------------------------------------------------------
// Cómputos de la página
// ---------------------------------------------------------------------------
const discountPercent = product.originalPrice
  ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
  : null;

const formatCurrency = (amount: number) =>
  new Intl.NumberFormat('es-ES', {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: 2,
  }).format(amount);

// Structured fields (new schema)
const pricing = product.pricing;
const conversionHooks = product.conversionHooks;
const investigation = product.investigation;
const affiliate = product.affiliate;
const hasNewSchema = !!(pricing && conversionHooks && investigation && affiliate);

// ─── Alternatives / Cross-Selling Resolution ─────────────────────────────────
const alternatives = product.alternatives;
const cheaperProduct = alternatives?.cheaperOptionId
  ? allProducts.find((p) => p.id === alternatives.cheaperOptionId)
  : null;
const premiumProduct = alternatives?.premiumOptionId
  ? allProducts.find((p) => p.id === alternatives.premiumOptionId)
  : null;
const similarProduct = alternatives?.similarOptionId
  ? allProducts.find((p) => p.id === alternatives.similarOptionId)
  : null;
const hasAlternatives = !!(cheaperProduct || premiumProduct || similarProduct);

// SEO: Datos estructurados de producto (Schema.org Product)
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.description,
  image: product.image,
  brand: { '@type': 'Brand', name: product.merchant },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: product.price.toFixed(2),
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: product.merchant },
  },
  ...(product.rating && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: product.rating,
      reviewCount: product.reviewsCount ?? 1,
      bestRating: 5,
      worstRating: 1,
    },
  }),
};
---

<Layout
  title={`${product.title} — Análisis y Mejor Precio | Tradylor`}
  description={product.description}
  image={product.image}
  type="product"
>
  <!-- Schema.org Product estructurado -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <div class="product-detail-page">

    <!-- ======================================================
         BREADCRUMB
         ====================================================== -->
    <nav class="breadcrumb-nav container" aria-label="Ruta de navegación">
      <ol class="breadcrumb-list">
        <li><a href="/">Inicio</a></li>
        <li aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </li>
        <li><a href="/#destacados">{product.category}</a></li>
        <li aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </li>
        <li aria-current="page">{product.title}</li>
      </ol>
    </nav>

    <!-- ======================================================
         LAYOUT PRINCIPAL: Imagen + Panel CTA (pegajoso)
         ====================================================== -->
    <section class="product-main container">

      <!-- Columna izquierda: Imagen -->
      <div class="product-gallery">
        <div class="gallery-wrapper">
          {discountPercent && discountPercent > 0 && (
            <div class="discount-badge-lg" aria-label={`Descuento del ${discountPercent}%`}>
              -{discountPercent}%
            </div>
          )}
          {product.badge && (
            <div class="editorial-badge-img">{product.badge}</div>
          )}
          <img
            src={product.image}
            alt={`Análisis técnico de ${product.title}`}
            class="main-product-image"
            width="600"
            height="450"
            id="mainProductImg"
          />
          {/* Fotograma/mp4 cuando el elemento activo del carrusel es un vídeo */}
          <div id="mainVideoWrap" class="main-video-wrap" hidden></div>
          {/* Overlay play: al clicar se abre el vídeo en el modal */}
          <button type="button" id="mainVideoPlay" class="main-video-play" hidden aria-label="Reproducir vídeo del producto">
            <span class="main-play-icon" aria-hidden="true">▶</span>
            <span class="main-play-label">Ver vídeo</span>
          </button>
          {hasGalleryCarousel && (
            <>
              <button type="button" id="galleryPrev" class="gallery-nav gallery-nav-prev" aria-label="Imagen anterior">‹</button>
              <button type="button" id="galleryNext" class="gallery-nav gallery-nav-next" aria-label="Imagen siguiente">›</button>
              <span id="galleryCounter" class="gallery-counter">1 / {galleryImages.length}</span>
            </>
          )}
        </div>

        {/* Galería de imágenes/vídeos: miniaturas que cambian la imagen principal */}
        {hasGalleryCarousel && (
          <div class="product-thumbs" id="productThumbs">
            {galleryImages.map((img, i) => (
              <button
                type="button"
                class={`product-thumb${i === 0 ? ' is-active' : ''}${isVideoUrl(img) ? ' is-video' : ''}`}
                data-full={img}
                aria-label={`Ver ${isVideoUrl(img) ? 'vídeo' : 'imagen'} ${i + 1} de ${galleryImages.length}`}
              >
                {isVideoUrl(img) ? (
                  <>
                    {videoThumbUrl(img) ? (
                      <img src={videoThumbUrl(img)} alt="" loading="lazy" class="thumb-video-still" />
                    ) : (
                      <video src={img} preload="metadata" muted playsinline></video>
                    )}
                    <span class="thumb-play-badge" aria-hidden="true">▶</span>
                  </>
                ) : (
                  <img src={img} alt="" loading="lazy" />
                )}
              </button>
            ))}
          </div>
        )}

        <!-- Trust signals bajo la imagen -->
        <div class="trust-row">
          <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <span>Análisis independiente</span>
          </div>
          <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>Precio verificado hoy</span>
          </div>
          <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            <span>Compra oficial protegida</span>
          </div>
          {hasNewSchema && investigation!.hoursInvestigated > 0 && (
            <div class="trust-item trust-investigation">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
              <span>{investigation!.hoursInvestigated}h de análisis · {investigation!.modelsCompared} modelos comparados</span>
            </div>
          )}
        </div>
      </div>

      <!-- Columna derecha: Panel de información + CTA pegajoso -->
      <div class="product-info-panel">

        <!-- Cabecera: categoría + rating -->
        <div class="panel-meta-top">
          <span class="category-chip">{product.category}</span>
          {product.rating && (
            <div class="rating-inline" aria-label={`Puntuación: ${product.rating} sobre 5`}>
              <svg class="star-svg" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              <strong>{product.rating.toFixed(1)}</strong>
              {product.reviewsCount && (
                <span class="review-count">({product.reviewsCount.toLocaleString('es-ES')} valoraciones)</span>
              )}
            </div>
          )}
        </div>

        <!-- Título H1 del producto -->
        <h1 class="product-title-h1">{displayTitle}</h1>

        <!-- Descripción editorial -->
        <p class="product-desc-text">{displayDescription}</p>

        <!-- Bloque de precio -->
        <div class="price-block">
          <div class="price-row">
            <span class="price-main">{formatCurrency(product.price)}</span>
            {product.originalPrice && (
              <>
                <span class="price-original">{formatCurrency(product.originalPrice)}</span>
                {discountPercent && discountPercent > 0 && (
                  <span class="savings-tag">Ahorras {formatCurrency(product.originalPrice - product.price)}</span>
                )}
              </>
            )}
          </div>
          <p class="price-disclaimer">
            Puede variar en el momento de la compra.
          </p>
        </div>

        <!-- CTA principal: Comprar ya → pantalla puente nativa /checkout/[id] -->
        <a href={checkoutUrl} class="cta-primary-btn" id={`order-cta-${product.id}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M4 12h16" />
            <polyline points="13 5 20 12 13 19" />
          </svg>
          Comprar ya
          <svg class="arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <p class="cta-micro">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          Reserva tu opción sin compromiso: sólo se cobra en la pasarela oficial de {fulfillmentProvider}
        </p>

        <!-- Acciones secundarias: carrito Amazon-style y consulta técnica -->
        <div class="cta-support-row">
          <button
            type="button"
            class="detail-cart-btn add-to-cart-btn"
            aria-label={`Añadir ${product.title} al carrito`}
            data-product={JSON.stringify({ id: product.id, title: product.title, price: product.price, image: product.image })}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
              <path d="M3 6h18"></path>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            Añadir al carrito
          </button>
          <a href="#ficha-tecnica" class="detail-cart-btn cta-ghost-link" id={`specs-cta-${product.id}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
            Ver ficha técnica
          </a>
        </div>

        <!-- CTA terciario: análisis cruzado dentro de Tradylor -->
        {alternativesCount > 0 ? (
          <a href="#comparativa" class="cta-secondary-btn" id={`compare-cta-${product.id}`}>
            Comparar con alternativas ({alternativesCount}) →
          </a>
        ) : (
          <div class="cta-secondary-btn cta-compare-empty" role="note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            Mejor producto de su categoría: no hay alternativas que lo superen
          </div>
        )}
      </div>
    </section>

    <!-- ======================================================
         FICHA TÉCNICA OBJETIVA (specs del contrato n8n)
         ====================================================== -->
    <section class="specs-section container" id="ficha-tecnica">
      <div class="specs-header">
        <span class="specs-tag">Datos objetivos</span>
        <h2 class="specs-title">Ficha técnica</h2>
        <p class="specs-subtitle">
          Especificaciones verificadas del fabricante, sin valoraciones comerciales.
        </p>
      </div>

      {specs ? (
        <dl class="specs-grid">
          {Object.entries(specs).map(([label, value]) => (
            <div class="spec-row">
              <dt class="spec-label">{label}</dt>
              <dd class="spec-value">{value}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <div class="specs-empty" role="note">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="16" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12.01" y2="8" />
          </svg>
          La ficha técnica detallada está en proceso de verificación. Los puntos
          fuertes y el veredicto inferior reflejan el estado actual del análisis.
        </div>
      )}
    </section>

    <!-- ======================================================
         COMPRA DELEGADA: cómo se tramita el pedido
         ====================================================== -->
    <section class="delegated-section container" aria-labelledby="delegated-title">
      <div class="delegated-head">
        <span class="specs-tag delegated-tag">Compra delegada</span>
        <h2 class="specs-title" id="delegated-title">Tú eliges. El distribuidor oficial cobra y envía.</h2>
        <p class="specs-subtitle">
          Tradylor gestiona la selección y el análisis; el pago, la logística y la
          garantía los administrará {fulfillmentProvider}.
        </p>
      </div>

      <ol class="delegated-steps">
        <li class="delegated-step">
          <span class="step-index">1</span>
          <div class="step-body">
            <h3 class="step-title">Reservas tu opción</h3>
            <p class="step-text">
              Compruebas la ficha técnica, el veredicto y pulsas «Comprar ya».
              Sin registro y sin coste.
            </p>
          </div>
        </li>
        <li class="delegated-step">
          <span class="step-index">2</span>
          <div class="step-body">
            <h3 class="step-title">Confirmas el resumen</h3>
            <p class="step-text">
              Revisas artículo, precio, plazo estimado de entrega y quién figura
              como distribuidor oficial antes de salir.
            </p>
          </div>
        </li>
        <li class="delegated-step">
          <span class="step-index">3</span>
          <div class="step-body">
            <h3 class="step-title">Pagas en la pasarela oficial</h3>
            <p class="step-text">
              {fulfillmentProvider} procesa el pago de forma segura y te envía los
              correos de confirmación, seguimiento y garantía.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ======================================================
         ANÁLISIS EDITORIAL: Pros, Contras & Veredicto
         ====================================================== -->
    <section class="editorial-section container">
      <div class="editorial-grid">

        <!-- Pros -->
        <div class="pros-card">
          <h2 class="analysis-h2 pros-h2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            Puntos Fuertes
          </h2>
          {product.pros && product.pros.length > 0 ? (
            <ul class="analysis-list pros-list">
              {product.pros.map((pro) => (
                <li class="analysis-item">
                  <span class="item-bullet pro-bullet">✓</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="no-data">Análisis en proceso de actualización.</p>
          )}
        </div>

        <!-- Contras -->
        <div class="cons-card">
          <h2 class="analysis-h2 cons-h2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
            A Mejorar
          </h2>
          {product.cons && product.cons.length > 0 ? (
            <ul class="analysis-list cons-list">
              {product.cons.map((con) => (
                <li class="analysis-item">
                  <span class="item-bullet con-bullet">✕</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="no-data">Sin puntos negativos destacables detectados.</p>
          )}
        </div>

        <!-- Lo que la marca NO te cuenta (Hidden Drawbacks) -->
        {hasNewSchema && investigation!.hiddenDrawbacks.length > 0 && (
          <div class="drawbacks-card">
            <h2 class="analysis-h2 drawbacks-h2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
              </svg>
              Lo que la marca NO te cuenta
            </h2>
            <ul class="analysis-list drawbacks-list">
              {investigation!.hiddenDrawbacks.map((item) => (
                <li class="analysis-item">
                  <span class="item-bullet drawback-bullet">⚠</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Conversion Hooks: ¿Para quién es este producto? -->
        {hasNewSchema && (conversionHooks!.idealFor || conversionHooks!.notRecommendedFor) && (
          <div class="conversion-hooks-card">
            <h2 class="analysis-h2 hooks-h2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10" />
                <path d="M8 14s1.5 2 4 2 4-2 4-2" />
                <line x1="9" y1="9" x2="9.01" y2="9" />
                <line x1="15" y1="9" x2="15.01" y2="9" />
              </svg>
              ¿Para quién es este producto?
            </h2>
            {conversionHooks!.idealFor && (
              <div class="hook-row hook-ideal">
                <span class="hook-icon">✓</span>
                <div>
                  <span class="hook-label">Ideal para:</span>
                  <span class="hook-text">{conversionHooks!.idealFor}</span>
                </div>
              </div>
            )}
            {conversionHooks!.notRecommendedFor && (
              <div class="hook-row hook-not-ideal">
                <span class="hook-icon">✕</span>
                <div>
                  <span class="hook-label">No recomendado para:</span>
                  <span class="hook-text">{conversionHooks!.notRecommendedFor}</span>
                </div>
              </div>
            )}
          </div>
        )}

        <!-- Veredicto -->
        {product.verdict && (
          <div class="verdict-card">
            <h2 class="analysis-h2 verdict-h2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
              Veredicto Tradylor
            </h2>
            <p class="verdict-text">{product.verdict}</p>
            <!-- CTA secundario: lleva a la comparativa de la categoría -->
            {alternativesCount > 0 && (
              <a
                href="#comparativa"
                class="cta-secondary-btn"
                id={`verdict-cta-${product.id}`}
              >
                Ver comparativa con alternativas →
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- ======================================================
         COMPARATIVA DE LA CATEGORÍA (Tabla dinámica)
         ====================================================== -->
    <div class="container" id="comparativa">
      <ComparisonTable
        products={sameCategory}
        highlightId={product.id}
        title={`Comparativa: ${product.category}`}
      />
