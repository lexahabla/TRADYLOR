  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: #10b981;
    font-weight: 500;
  }

  /* ---- Panel Información ---- */
  .product-info-panel {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    position: sticky;
    top: 100px;
  }

  .panel-meta-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .category-chip {
    background: rgba(59, 130, 246, 0.12);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.25);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .rating-inline {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.88rem;
    color: #f3f4f6;
  }
  .star-svg {
    width: 18px;
    height: 18px;
    color: #f59e0b;
    fill: #f59e0b;
  }
  .review-count {
    color: var(--color-text-dim);
    font-size: 0.8rem;
  }

  .product-title-h1 {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    line-height: 1.3;
    color: #ffffff;
    font-weight: 800;
  }

  .product-desc-text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* ---- Bloque de Precio ---- */
  .price-block {
    background: rgba(13, 19, 31, 0.8);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.25rem 1.5rem;
  }
  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .price-main {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }
  .price-original {
    font-size: 1.1rem;
    color: var(--color-text-dim);
    text-decoration: line-through;
  }
  .savings-tag {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.25);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }
  .price-disclaimer {
    font-size: 0.75rem;
    color: var(--color-text-dim);
    margin: 0;
  }

  /* ---- Botón CTA Principal ---- */
  .cta-primary-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 60%, #1e40af 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45), 0 0 0 1px rgba(59, 130, 246, 0.2);
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .cta-primary-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .cta-primary-btn:hover {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 60%, #1d4ed8 100%);
    box-shadow: 0 10px 30px rgba(59, 130, 246, 0.55), 0 0 0 1px rgba(59, 130, 246, 0.4);
    transform: translateY(-2px);
  }
  .cta-primary-btn:hover::before {
    opacity: 1;
  }
  .cta-primary-btn:active {
    transform: translateY(0);
  }
  .arrow-icon {
    transition: transform 0.25s ease;
    margin-left: auto;
  }
  .cta-primary-btn:hover .arrow-icon {
    transform: translate(3px, -3px);
  }

  .detail-cart-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.85rem 1.25rem;
    color: #bfdbfe;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 10px;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }
  .detail-cart-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: #60a5fa;
    transform: translateY(-1px);
  }

  .detail-cart-btn.add-to-cart-btn {
    color: #ffffff;
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    border: 1px solid rgba(96, 165, 250, 0.5);
    box-shadow: 0 6px 18px rgba(96, 165, 250, 0.28);
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }
  .detail-cart-btn.add-to-cart-btn:hover {
    color: #ffffff;
    background: linear-gradient(135deg, #93c5fd 0%, #60a5fa 100%);
    border-color: #93c5fd;
    box-shadow: 0 10px 26px rgba(96, 165, 250, 0.42);
    transform: translateY(-1px);
  }

  .cta-micro {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--color-text-dim);
    text-align: center;
    justify-content: center;
    margin-top: -0.5rem;
  }

  /* Estado sin alternativas: mismo bloque visual que el CTA, desactivado */
  .cta-compare-empty {
    opacity: 0.55;
    cursor: default;
    pointer-events: none;
    font-size: 0.85rem;
    line-height: 1.45;
    text-align: center;
  }
  .cta-compare-empty::before {
    display: none;
  }

  /* Aviso bajo la zona de comparativa cuando no hay alternativas */
  .comparison-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 2rem auto 3rem;
    padding: 1.5rem 1.75rem;
    max-width: 640px;
    color: var(--color-text-muted);
    background: rgba(17, 24, 39, 0.55);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    font-size: 0.9rem;
    line-height: 1.55;
    text-align: center;
  }
  .comparison-empty svg {
    color: #60a5fa;
    flex-shrink: 0;
  }
  .comparison-empty strong {
    color: #e5e7eb;
  }

  .merchant-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }
  .vendor-label {
    color: var(--color-text-dim);
  }
  .vendor-name {
    font-weight: 700;
    color: #ffffff;
    background: var(--color-surface-subtle);
    padding: 0.2rem 0.65rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    font-size: 0.82rem;
  }
  .vendor-name[data-merchant="amazon"] { color: #f59e0b; }
  .vendor-name[data-merchant="pccomponentes"] { color: #f87171; }

  /* =====================================================
     SECCIÓN EDITORIAL: PROS, CONTRAS, VEREDICTO
     ===================================================== */
  .editorial-section {
    padding-bottom: 3rem;
  }
  .editorial-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .pros-card,
  .cons-card,
  .verdict-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.75rem;
  }
  .pros-card {
    border-color: rgba(16, 185, 129, 0.2);
    background: rgba(16, 185, 129, 0.03);
  }
  .cons-card {
    border-color: rgba(248, 113, 113, 0.2);
    background: rgba(248, 113, 113, 0.03);
  }
  .verdict-card {
    grid-column: 1 / -1;
    border-color: rgba(59, 130, 246, 0.25);
    background: rgba(59, 130, 246, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .analysis-h2 {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
  }
  .pros-h2 { color: #10b981; }
  .cons-h2 { color: #f87171; }
  .verdict-h2 { color: #60a5fa; }

  .analysis-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .analysis-item {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .item-bullet {
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .pro-bullet { color: #10b981; }
  .con-bullet { color: #f87171; }

  /* ---- Hidden Drawbacks Card ---- */
  .drawbacks-card {
    grid-column: 1 / -1;
    background: rgba(245, 158, 11, 0.03);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: var(--border-radius-md);
    padding: 1.75rem;
  }
  .drawbacks-h2 { color: #f59e0b; }
  .drawback-bullet { color: #f59e0b; }

  /* ---- Conversion Hooks Card ---- */
  .conversion-hooks-card {
    grid-column: 1 / -1;
    background: rgba(139, 92, 246, 0.03);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: var(--border-radius-md);
    padding: 1.75rem;
  }
  .hooks-h2 { color: #a78bfa; }
  .hook-row {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .hook-row:last-child { border-bottom: none; }
  .hook-icon {
    font-weight: 800;
    font-size: 0.9rem;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .hook-ideal .hook-icon { color: #10b981; }
  .hook-not-ideal .hook-icon { color: #f87171; }
  .hook-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 0.2rem;
  }
  .hook-ideal .hook-label { color: #10b981; }
  .hook-not-ideal .hook-label { color: #f87171; }
  .hook-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ---- Investigation Trust Badge ---- */
  .trust-investigation {
    color: #60a5fa !important;
  }

  .verdict-text {
    font-size: 1rem;
    line-height: 1.7;
    color: #d1d5db;
    font-style: italic;
  }

  .cta-secondary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(59, 130, 246, 0.1);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    width: fit-content;
  }
  .cta-secondary-btn:hover {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    box-shadow: var(--shadow-glow);
  }

  .no-data {
    font-size: 0.85rem;
    color: var(--color-text-dim);
    font-style: italic;
  }

  /* =====================================================
     AVISO DE AFILIACIÓN
     ===================================================== */
  .affiliate-notice {
    padding-bottom: 2rem;
  }
  .notice-inner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: rgba(245, 158, 11, 0.05);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: var(--border-radius-sm);
    padding: 1rem 1.25rem;
  }
  .notice-inner svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .notice-inner p {
    font-size: 0.8rem;
    color: var(--color-text-dim);
    line-height: 1.55;
    margin: 0;
  }
  .notice-inner strong {
    color: var(--color-accent-amber);
  }

  /* =====================================================
     CROSS-SELLING / ALTERNATIVAS
     ===================================================== */
  .cross-selling-section {
    padding-bottom: 3rem;
  }
  .cross-selling-header {
    margin-bottom: 1.75rem;
  }
  .cross-selling-tag {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #a78bfa;
    margin-bottom: 0.6rem;
  }
  .cross-selling-title {
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.5rem;
  }
  .cross-selling-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .alternatives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .alternative-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.5rem 1.25rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .alternative-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }
  .alt-cheaper:hover { border-color: rgba(16, 185, 129, 0.5); }
  .alt-premium:hover { border-color: rgba(245, 158, 11, 0.5); }
  .alt-similar:hover { border-color: rgba(96, 165, 250, 0.5); }

  .alt-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }
  .alt-badge-cheaper {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }
  .alt-badge-premium {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .alt-badge-similar {
    background: rgba(96, 165, 250, 0.12);
    color: #60a5fa;
    border: 1px solid rgba(96, 165, 250, 0.3);
  }

  .alt-image {
    width: 100px;
    height: 100px;
    object-fit: contain;
    border-radius: 12px;
    background: #fff;
    padding: 8px;
  }

  .alt-title {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    color: #e5e7eb;
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .alt-price {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .alt-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fbbf24;
  }

  .alt-cta {
    font-size: 0.82rem;
    font-weight: 700;
    color: #60a5fa;
    transition: color 0.2s;
  }
  .alternative-card:hover .alt-cta {
    color: #93bbfd;
  }

  /* =====================================================
     ACCIONES SECUNDARIAS DEL PANEL CTA
     ===================================================== */
  .cta-support-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cta-support-row > * {
    flex: none;
    width: 100%;
    min-width: 0;
    justify-content: center;
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.85rem 0.6rem;
  }
  .cta-ghost-link {
    color: #bfdbfe;
  }

  /* =====================================================
     FICHA TÉCNICA OBJETIVA
     ===================================================== */
  .specs-section {
    padding-bottom: 3rem;
    scroll-margin-top: 100px;
  }
  .specs-header {
    margin-bottom: 1.5rem;
  }
  .specs-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #60a5fa;
    background: rgba(96, 165, 250, 0.1);
    border: 1px solid rgba(96, 165, 250, 0.25);
    padding: 0.22rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.7rem;
  }
  .specs-title {
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.4rem;
    letter-spacing: -0.01em;
  }
  .specs-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }
  .specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.75rem;
    margin: 0;
  }
  .spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.9rem 1.15rem;
  }
  .spec-label {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-dim);
    margin: 0;
  }
  .spec-value {
    font-size: 0.92rem;
    font-weight: 600;
    color: #e5e7eb;
    text-align: right;
    margin: 0;
  }
  .specs-empty {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    background: rgba(17, 24, 39, 0.55);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: var(--border-radius-md);
    padding: 1.25rem 1.4rem;
    font-size: 0.87rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .specs-empty svg {
    color: #60a5fa;
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* =====================================================
     COMPRA DELEGADA (pasos del pedido)
     ===================================================== */
  .delegated-section {
    padding-bottom: 3rem;
  }
  .delegated-head {
    margin-bottom: 1.5rem;
  }
  .delegated-tag {
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.28);
  }
  .delegated-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    list-style: none;
    counter-reset: none;
  }
  .delegated-step {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: rgba(59, 130, 246, 0.04);
    border: 1px solid rgba(59, 130, 246, 0.18);
    border-radius: var(--border-radius-md);
    padding: 1.35rem;
  }
  .step-index {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.92rem;
  }
  .step-body {
    min-width: 0;
  }
  .step-title {
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.35rem;
  }
  .step-text {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* =====================================================
     RESPONSIVE
     ===================================================== */
  @media (max-width: 900px) {
    .product-main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .product-info-panel {
      position: static;
    }
    .editorial-grid {
      grid-template-columns: 1fr;
    }
    .verdict-card {
      grid-column: auto;
    }
    .drawbacks-card,
    .conversion-hooks-card {
      grid-column: auto;
    }
    .alternatives-grid {
      grid-template-columns: 1fr;
    }
    .delegated-steps {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    /* Móvil: menos padding para que la imagen del producto sea más grande */
    .gallery-wrapper {
      padding: 3%;
    }
    .main-product-image {
      padding: 0.75rem;
    }
    .product-thumb {
      width: 56px;
      height: 56px;
    }
    .trust-row {
      flex-direction: column;
      gap: 0.65rem;
    }
    .price-main {
      font-size: 1.8rem;
    }
    .cta-primary-btn {
      font-size: 0.95rem;
    }
    .cta-support-row {
      flex-direction: column;
