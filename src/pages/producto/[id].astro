---
/**
 * ==============================================================================
 * TRADYLOR — PÁGINA DE DETALLE DE PRODUCTO
 * ==============================================================================
 *
 * Ruta dinámica SSR: /producto/[id]
 *
 * FLUJO DE NAVEGACIÓN (Link Cloaking intacto):
 *  ProductCard  →  /producto/[id]  →  (CTA)  →  /out/[id]  →  302  →  Afiliado
 *
 * El affiliateUrl real NUNCA aparece en esta página. El botón CTA apunta a
 * la ruta interna /out/[id] que realiza la redirección en servidor.
 * ==============================================================================
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { getCatalogProducts } from '../../lib/catalog';

const allProducts = getCatalogProducts();
const cleanMarketplaceSuffix = (text: string) => text.replace(/\s*[\-|:]\s*(Amazon(?:\.es)?|PcComponentes|El Corte Inglés|MediaMarkt|Fnac|AliExpress|Carrefour|Apple).*$/i, '').trim();

// ---------------------------------------------------------------------------
// Resolución del producto
// ---------------------------------------------------------------------------
const { id } = Astro.params;
const product = allProducts.find((p) => p.id === id);
const displayTitle = product ? cleanMarketplaceSuffix(product.title) : '';
const displayDescription = product ? cleanMarketplaceSuffix(product.description) : '';

// Si no existe el producto, redirigir al inicio
if (!product) {
  return Astro.redirect('/', 302);
}

// Comparativa: productos de la misma categoría (incluye el actual)
const sameCategory = allProducts.filter((p) => p.category === product.category);
const alternativesCount = sameCategory.filter((p) => p.id !== product.id).length;

// ---------------------------------------------------------------------------
// Cómputos de la página
// ---------------------------------------------------------------------------
const discountPercent = product.originalPrice
  ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
  : null;

const formatCurrency = (amount: number) =>
  new Intl.NumberFormat('es-ES', {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: 2,
  }).format(amount);

// SEO: Datos estructurados de producto (Schema.org Product)
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.description,
  image: product.image,
  brand: { '@type': 'Brand', name: product.merchant },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: product.price.toFixed(2),
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: product.merchant },
  },
  ...(product.rating && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: product.rating,
      reviewCount: product.reviewsCount ?? 1,
      bestRating: 5,
      worstRating: 1,
    },
  }),
};
---

<Layout
  title={`${product.title} — Análisis y Mejor Precio | Tradylor`}
  description={product.description}
  image={product.image}
  type="product"
>
  <!-- Schema.org Product estructurado -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <div class="product-detail-page">

    <!-- ======================================================
         BREADCRUMB
         ====================================================== -->
    <nav class="breadcrumb-nav container" aria-label="Ruta de navegación">
      <ol class="breadcrumb-list">
        <li><a href="/">Inicio</a></li>
        <li aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </li>
        <li><a href="/#destacados">{product.category}</a></li>
        <li aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </li>
        <li aria-current="page">{product.title}</li>
      </ol>
    </nav>

    <!-- ======================================================
         LAYOUT PRINCIPAL: Imagen + Panel CTA (pegajoso)
         ====================================================== -->
    <section class="product-main container">

      <!-- Columna izquierda: Imagen -->
      <div class="product-gallery">
        <div class="gallery-wrapper">
          {discountPercent && discountPercent > 0 && (
            <div class="discount-badge-lg" aria-label={`Descuento del ${discountPercent}%`}>
              -{discountPercent}%
            </div>
          )}
          {product.badge && (
            <div class="editorial-badge-img">{product.badge}</div>
          )}
          <img
            src={product.image}
            alt={`Análisis técnico de ${product.title}`}
            class="main-product-image"
            width="600"
            height="450"
          />
        </div>

        <!-- Trust signals bajo la imagen -->
        <div class="trust-row">
          <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <span>Análisis independiente</span>
          </div>
          <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>Precio verificado hoy</span>
          </div>
          <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            <span>Compra oficial protegida</span>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Panel de información + CTA pegajoso -->
      <div class="product-info-panel">

        <!-- Cabecera: categoría + rating -->
        <div class="panel-meta-top">
          <span class="category-chip">{product.category}</span>
          {product.rating && (
            <div class="rating-inline" aria-label={`Puntuación: ${product.rating} sobre 5`}>
              <svg class="star-svg" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              <strong>{product.rating.toFixed(1)}</strong>
              {product.reviewsCount && (
                <span class="review-count">({product.reviewsCount.toLocaleString('es-ES')} valoraciones)</span>
              )}
            </div>
          )}
        </div>

        <!-- Título H1 del producto -->
        <h1 class="product-title-h1">{displayTitle}</h1>

        <!-- Descripción editorial -->
        <p class="product-desc-text">{displayDescription}</p>

        <!-- Bloque de precio -->
        <div class="price-block">
          <div class="price-row">
            <span class="price-main">{formatCurrency(product.price)}</span>
            {product.originalPrice && (
              <>
                <span class="price-original">{formatCurrency(product.originalPrice)}</span>
                {discountPercent && discountPercent > 0 && (
                  <span class="savings-tag">Ahorras {formatCurrency(product.originalPrice - product.price)}</span>
                )}
              </>
            )}
          </div>
          <p class="price-disclaimer">
            Puede variar en el momento de la compra.
          </p>
        </div>

        <!-- CTA principal: comparar con alternativas de la misma categoría -->
        {alternativesCount > 0 ? (
          <a href="#comparativa" class="cta-primary-btn" id={`compare-cta-${product.id}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            Comparar con alternativas ({alternativesCount})
            <svg class="arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </a>
        ) : (
          <div class="cta-primary-btn cta-compare-empty" role="note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            Mejor producto de su categoría: no hay alternativas que lo superen
          </div>
        )}

        <button
          type="button"
          class="detail-cart-btn add-to-cart-btn"
          aria-label={`Añadir ${product.title} al carrito`}
          data-product={JSON.stringify({ id: product.id, title: product.title, price: product.price, image: product.image })}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          Añadir al carrito
        </button>
      </div>
    </section>

    <!-- ======================================================
         ANÁLISIS EDITORIAL: Pros, Contras & Veredicto
         ====================================================== -->
    <section class="editorial-section container">
      <div class="editorial-grid">

        <!-- Pros -->
        <div class="pros-card">
          <h2 class="analysis-h2 pros-h2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            Puntos Fuertes
          </h2>
          {product.pros && product.pros.length > 0 ? (
            <ul class="analysis-list pros-list">
              {product.pros.map((pro) => (
                <li class="analysis-item">
                  <span class="item-bullet pro-bullet">✓</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="no-data">Análisis en proceso de actualización.</p>
          )}
        </div>

        <!-- Contras -->
        <div class="cons-card">
          <h2 class="analysis-h2 cons-h2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
            A Mejorar
          </h2>
          {product.cons && product.cons.length > 0 ? (
            <ul class="analysis-list cons-list">
              {product.cons.map((con) => (
                <li class="analysis-item">
                  <span class="item-bullet con-bullet">✕</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="no-data">Sin puntos negativos destacables detectados.</p>
          )}
        </div>

        <!-- Veredicto -->
        {product.verdict && (
          <div class="verdict-card">
            <h2 class="analysis-h2 verdict-h2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
              Veredicto Tradylor
            </h2>
            <p class="verdict-text">{product.verdict}</p>
            <!-- CTA secundario: lleva a la comparativa de la categoría -->
            {alternativesCount > 0 && (
              <a
                href="#comparativa"
                class="cta-secondary-btn"
                id={`verdict-cta-${product.id}`}
              >
                Ver comparativa con alternativas →
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- ======================================================
         COMPARATIVA DE LA CATEGORÍA (Tabla dinámica)
         ====================================================== -->
    <div class="container" id="comparativa">
      <ComparisonTable
        products={sameCategory}
        highlightId={product.id}
        title={`Comparativa: ${product.category}`}
      />
      {alternativesCount === 0 && (
        <div class="comparison-empty container">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <p>Este producto es actualmente <strong>la mejor opción analizada</strong> de la categoría <strong>{product.category}</strong>. No hay alternativas comparables que lo superen en nuestra selección editorial.</p>
        </div>
      )}
    </div>

    <!-- ======================================================
         AVISO DE AFILIACIÓN (Transparencia obligatoria)
         ====================================================== -->
    <section class="affiliate-notice container">
      <div class="notice-inner">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
        <p>
          <strong>Aviso de afiliación:</strong> Este análisis puede contener enlaces de afiliado a {product.merchant}.
          Si realizas una compra a través de nuestros enlaces, Tradylor puede recibir una pequeña comisión
          sin ningún coste adicional para ti. Nuestros análisis son siempre independientes e imparciales.
        </p>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* =====================================================
     BASE DE LA PÁGINA
     ===================================================== */
  .product-detail-page {
    padding-bottom: 5rem;
  }

  /* =====================================================
     BREADCRUMB
     ===================================================== */
  .breadcrumb-nav {
    padding-top: 1.5rem;
    padding-bottom: 1rem;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    flex-wrap: wrap;
    font-size: 0.82rem;
    color: var(--color-text-dim);
  }
  .breadcrumb-list a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb-list a:hover {
    color: var(--color-primary);
  }
  .breadcrumb-list li[aria-current="page"] {
    color: var(--color-text-main);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 260px;
  }

  /* =====================================================
     LAYOUT PRINCIPAL (Imagen | Panel)
     ===================================================== */
  .product-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
    padding-top: 1rem;
    padding-bottom: 3rem;
  }

  /* ---- Galería / Imagen ---- */
  .gallery-wrapper {
    position: relative;
    background: #0d131f;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .main-product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
    transition: transform 0.5s ease;
  }
  .gallery-wrapper:hover .main-product-image {
    transform: scale(1.03);
  }
  .discount-badge-lg {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #dc2626;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.5);
    z-index: 2;
  }
  .editorial-badge-img {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.4);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 2;
  }

  .trust-row {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: #10b981;
    font-weight: 500;
  }

  /* ---- Panel Información ---- */
  .product-info-panel {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    position: sticky;
    top: 100px;
  }

  .panel-meta-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .category-chip {
    background: rgba(59, 130, 246, 0.12);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.25);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .rating-inline {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.88rem;
    color: #f3f4f6;
  }
  .star-svg {
    width: 18px;
    height: 18px;
    color: #f59e0b;
    fill: #f59e0b;
  }
  .review-count {
    color: var(--color-text-dim);
    font-size: 0.8rem;
  }

  .product-title-h1 {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    line-height: 1.3;
    color: #ffffff;
    font-weight: 800;
  }

  .product-desc-text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* ---- Bloque de Precio ---- */
  .price-block {
    background: rgba(13, 19, 31, 0.8);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.25rem 1.5rem;
  }
  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .price-main {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }
  .price-original {
    font-size: 1.1rem;
    color: var(--color-text-dim);
    text-decoration: line-through;
  }
  .savings-tag {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.25);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }
  .price-disclaimer {
    font-size: 0.75rem;
    color: var(--color-text-dim);
    margin: 0;
  }

  /* ---- Botón CTA Principal ---- */
  .cta-primary-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 60%, #1e40af 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45), 0 0 0 1px rgba(59, 130, 246, 0.2);
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .cta-primary-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .cta-primary-btn:hover {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 60%, #1d4ed8 100%);
    box-shadow: 0 10px 30px rgba(59, 130, 246, 0.55), 0 0 0 1px rgba(59, 130, 246, 0.4);
    transform: translateY(-2px);
  }
  .cta-primary-btn:hover::before {
    opacity: 1;
  }
  .cta-primary-btn:active {
    transform: translateY(0);
  }
  .arrow-icon {
    transition: transform 0.25s ease;
    margin-left: auto;
  }
  .cta-primary-btn:hover .arrow-icon {
    transform: translate(3px, -3px);
  }

  .detail-cart-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.85rem 1.25rem;
    color: #bfdbfe;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 10px;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }
  .detail-cart-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: #60a5fa;
    transform: translateY(-1px);
  }

  .cta-micro {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--color-text-dim);
    text-align: center;
    justify-content: center;
    margin-top: -0.5rem;
  }

  /* Estado sin alternativas: mismo bloque visual que el CTA, desactivado */
  .cta-compare-empty {
    opacity: 0.55;
    cursor: default;
    pointer-events: none;
    font-size: 0.85rem;
    line-height: 1.45;
    text-align: center;
  }
  .cta-compare-empty::before {
    display: none;
  }

  /* Aviso bajo la zona de comparativa cuando no hay alternativas */
  .comparison-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 2rem auto 3rem;
    padding: 1.5rem 1.75rem;
    max-width: 640px;
    color: var(--color-text-muted);
    background: rgba(17, 24, 39, 0.55);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    font-size: 0.9rem;
    line-height: 1.55;
    text-align: center;
  }
  .comparison-empty svg {
    color: #60a5fa;
    flex-shrink: 0;
  }
  .comparison-empty strong {
