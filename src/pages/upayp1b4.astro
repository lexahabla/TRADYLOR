    createSubcategoryForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = document.getElementById('createSubcatStatus');
      const catSelect = document.getElementById('prodCatAssign');
      const categoryName = catSelect && 'value' in catSelect ? String(catSelect.value || '').trim() : '';
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const parent = allCats.find((c) => !c.parentId && c.name === categoryName);
      if (!parent) {
        if (status) { status.hidden = false; status.className = 'admin-modal-status is-error'; status.textContent = 'No se encontró la categoría padre. Recarga el panel.'; }
        return;
      }
      const name = String(document.getElementById('createSubcatName')?.value || '').trim();
      const icon = String(document.getElementById('createSubcatIcon')?.value || '').trim();
      const keywords = String(document.getElementById('createSubcatKeywords')?.value || '').trim();
      if (!name) {
        if (status) { status.hidden = false; status.className = 'admin-modal-status is-error'; status.textContent = 'El nombre es obligatorio.'; }
        return;
      }
      try {
        const res = await fetch('/api/categories', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, icon, keywords, parentId: parent.id }),
        });
        const data = await res.json();
        if (!data.success) {
          if (status) { status.hidden = false; status.className = 'admin-modal-status is-error'; status.textContent = data.message || 'No se pudo crear la subcategoría.'; }
          return;
        }
        // Invalida y refresca el estado global de categorías SIN recargar la
        // página (datalist, selects del panel y módulo de Categorías).
        await loadCategories();
        syncSubcatAssign();
        const subSelect = document.getElementById('prodSubcatDest');
