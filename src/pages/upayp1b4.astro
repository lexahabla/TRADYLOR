    function prodMatchesPreset(product, preset) {
      switch (preset) {
        case 'sin-categoria':
        case 'sin-subcategoria': {
          const cat = String(product.category || '').trim();
          const catId = String(product.category_id || '').trim();
          const hasCat = Boolean(
            (cat && cat !== '—' && cat.toLowerCase() !== 'sin categoría' && cat.toLowerCase() !== 'sin categoria') ||
            (catId && catId !== '—')
          );
          return !hasCat;
        }
        case 'segunda-mano': {
          const cond = String(
            (product.extra && (product.extra.Condition || product.extra.condition || product.extra.Estado)) ||
            product.condition ||
            (product.specs && (product.specs['Estado'] || product.specs['Condición'] || product.specs['Condition'])) ||
            product.badge ||
            ''
          ).toLowerCase();
          if (/used|pre-owned|refurbished|reacondicionado|segunda mano|para desguace|for parts|open box|devoluci[oó]n|usado/i.test(cond)) return true;
          const text = `${product.title || ''} ${product.description || ''}`.toLowerCase();
          return /\b(segunda\s+mano|reacondicionad[oa]s?|refurbished|pre-owned|usad[oa]s?|open\s*box|km\s*0|ex-demo|seminuev[oa]s?)\b/i.test(text);
        }
        case 'sin-ia':
          return (product.ia_status || ((product.description || '').trim().length >= 60 ? 'completed' : 'pending')) !== 'completed';
        case 'sin-tags': {
          const tags = Array.isArray(product.normalized_tags) ? product.normalized_tags : [];
          return tags.length === 0;
        }
        case 'duplicados':
          return product.is_duplicate === true;
        case 'alta-rentabilidad':
          return (Number(product.conversion_score) || 0) >= 75;
        case 'listos':
          return Boolean(product.category)
            && (product.ia_status || ((product.description || '').trim().length >= 60 ? 'completed' : 'pending')) === 'completed'
            && (product.link_status || ((product.affiliateUrl || '').trim() ? 'active' : 'pending')) === 'active';
        default:
          return true;
      }
    }

