        <button type="button" class="preset-chip" data-prod-preset="sin-ia" title="Productos cuya ficha no está completada con IA">⚠️ Sin Enriquecer IA</button>
        <button type="button" class="preset-chip" data-prod-preset="duplicados" title="Duplicados por sourceId, URL canónica o título limpio">♻️ Duplicados</button>
        <button type="button" class="preset-chip" data-prod-preset="alta-rentabilidad" title="conversion_score ≥ 75">🔥 Alta Rentabilidad</button>
        <button type="button" class="preset-chip" data-prod-preset="listos" title="Categoría + subcategoría + IA completada + enlace activo">⭐ Listos para Publicar</button>
        <button type="button" id="btnProdRecalcScores" class="preset-chip preset-chip-action" title="Recalcula y guarda el conversion_score de todo el catálogo">⇅ Recalcular scores</button>
        <button type="button" id="btnProdPresetClear" class="preset-chip preset-chip-clear" hidden>✕ Quitar preset</button>
      </div>

      <div class="product-sel-bar" id="productSelBar">
        <label class="product-sel-title">ADMINISTRAR PRODUCTOS</label>
        <span id="productSelCount">0 seleccionados</span>
        <button type="button" class="btn-secondary btn-sm" id="btnProdSelAll">Seleccionar todos los visibles</button>
        <button type="button" class="btn-secondary btn-sm" id="btnProdSelClear">Limpiar</button>
        <button type="button" class="btn-ai btn-sm" id="btnProdEnrich">Enriquecer con IA (texto + imagen)</button>
        <button type="button" class="btn-ai btn-sm" id="btnProdOpenCode" title="Asistente OpenCode: redacta prompts en lenguaje natural para curar el catálogo">🤖 Asistente IA</button>
        <select id="prodCatAssign" class="sel-cat-assign" aria-label="Categoría destino">
          <option value="">Categoría destino…</option>
        </select>
        <select id="prodSubcatDest" class="sel-cat-assign" aria-label="Subcategoría destino">
          <option value="">Subcategoría destino…</option>
        </select>
        <button type="button" class="btn-secondary btn-sm" id="btnProdCreateSubcat" title="Crear una subcategoría vinculada a la categoría destino">➕ Subcat</button>
        <button type="button" class="btn-secondary btn-sm" id="btnProdAssignCat">Asignar categoría</button>
        <select id="prodBadgeAssign" class="sel-cat-assign" aria-label="Etiqueta destacada destino">
          <option value="">Etiqueta destacada…</option>
        </select>
        <button type="button" class="btn-secondary btn-sm" id="btnProdBulkBadge" title="Aplica la etiqueta destacada (badge) a todos los productos seleccionados">🏷️ Asignar Badge</button>
        <button type="button" class="btn-ai btn-sm" id="btnProdNormalizeTags" title="Extraer tags técnicos normalizados (normalized_tags)">🏷️ Normalizar Tags</button>
        <button type="button" class="btn-success btn-sm" id="btnProdMakeSection">Crear sección con los seleccionados</button>
        <button type="button" class="btn-danger-ghost btn-sm" id="btnProdBulkDelete">🗑️ Eliminar Seleccionados</button>
        <button type="button" class="btn-danger btn-sm" id="btnProdDeleteAll" title="Elimina TODOS los productos del catálogo (purga completa). Úsalo para resincronizar desde cero.">🗑️ Vaciar Catálogo</button>
      </div>


      <div class="products-table-responsive">
        <table class="products-table" id="productsTable">
            <thead>
              <tr>
                <th><input type="checkbox" id="prodCheckAll" aria-label="Seleccionar todos los visibles" /></th>
                <th>Imagen</th>
                <th>Producto & Categoría</th>
                <th title="Red de afiliados a la que pertenece el producto (Amazon, eBay, AliExpress…)">Comercio</th>
                <th>Precio</th>
                <th title="Margen de conversión potencial (score 0-100)">Score</th>
                <th>Enlace Afiliado</th>
                <th class="text-right">Acciones</th>
              </tr>
            </thead>
<tbody id="productsTableBody">
               {initialPageProducts.length === 0 ? (
                <tr class="empty-row">
                  <td colspan="8">No hay productos registrados en el catálogo aún.</td>
                </tr>
              ) : (
                initialPageProducts.map((p) => (
                  <tr data-product-id={p.id} class="product-row">
                    <td class="col-check"><input type="checkbox" data-prod-check data-id={p.id} aria-label="Seleccionar producto" /></td>
                    <td class="col-thumb">
                    <img src={p.image} alt={p.title} class="thumb-img" loading="lazy" />
                  </td>
                  <td class="col-details">
                    <a href={`/producto/${p.slug ?? p.id}`} class="row-title" target="_blank" rel="noopener" title="Ver ficha pública del producto">{p.title}</a>
                    <div class="row-meta">
                      <span class="pill-category">{p.category}</span>
                      {p.badge && <span class="pill-badge">{p.badge}</span>}
                    </div>
                  </td>
                  <td class="col-merchant">
                    <span class="merchant-badge" title={`Red de afiliados${p.merchant ? ` · Comerciante: ${p.merchant}` : ''}`}>
                      {p.network_label || p.merchant || '—'}
                    </span>
                  </td>
                  <td class="col-price">
                    <span class="price-val">{p.price.toFixed(2)} €</span>
                    {p.originalPrice && <span class="price-old">{p.originalPrice.toFixed(2)} €</span>}
                  </td>
                  <td class="col-score">
                    {(() => {
                      const score = Number(p.conversion_score) || 0;
                      const level = score > 75 ? 'high' : score >= 40 ? 'mid' : 'low';
                      return (
                        <span class={`score-badge score-${level}`} title={`Score de conversión: ${score}/100`}>
                          <span class="score-badge-value">{level === 'high' ? '🔥' : level === 'mid' ? '⚡' : '❄️'} {score}</span>
                          <span class="score-bar"><span class="score-bar-fill" style={`width:${Math.max(0, Math.min(100, score))}%`} /></span>
                        </span>
                      );
                    })()}
                    {(p as any).is_duplicate && <span class="dup-pill" title={`Duplicado (${(p as any).duplicate_reason || 'detectado'})`}>♻️ Dup</span>}
                  </td>
                  <td class="col-link">
                    <a
                      href={p.affiliateUrl}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="test-link"
                      title="Probar enlace de afiliado"
                    >
                      Probar Enlace
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  </td>
                  <td class="col-actions text-right">
                    <button
                      type="button"
                      class="btn-icon-action btn-edit-row"
                      data-id={p.id}
                      title="Cargar y editar en formulario"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                      </svg>
                    </button>
                     <button
                       type="button"
                       class="btn-icon-action btn-delete-row"
                       data-id={p.id}
                       title="Eliminar producto"
                     >
                       <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                         <polyline points="3 6 5 6 21 6"></polyline>
                         <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                       </svg>
                     </button>
                      <button type="button" class="btn-icon-action btn-prod-detail" data-id={p.id} title="Ver todos los datos" data-idx="0" aria-expanded="false" aria-label="Ver todos los datos">
                        <svg class="prod-detail-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </button>
                   </td>
                 </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <!-- Paginación del Catálogo de Productos -->
      <div id="productsPagination" class="products-pagination" {initialTotalPages <= 1 ? 'hidden' : ''}>
        <div class="pagination-info">
          <span id="paginationTotal">{initialTotalProducts} producto{initialTotalProducts !== 1 ? 's' : ''} (página 1 de {initialTotalPages})</span>
        </div>
        <nav class="pagination-controls" aria-label="Paginación del catálogo">
          <button type="button" id="paginationPrev" class="btn-secondary btn-sm" disabled aria-label="Página anterior">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Anterior
          </button>
          <div class="pagination-pages" id="paginationPages" role="group" aria-label="Números de página">
            {Array.from({ length: Math.min(initialTotalPages, 5) }, (_, i) => i + 1).map((pageNum) => (
              <button type="button" class={`pagination-page${pageNum === 1 ? ' active' : ''}`} data-page={pageNum} aria-label={`Página ${pageNum}`} aria-current={pageNum === 1 ? 'page' : undefined}>{pageNum}</button>
            ))}
            {initialTotalPages > 5 && (
              <>
                <span class="pagination-ellipsis" aria-hidden="true">…</span>
                <button type="button" class="pagination-page" data-page={initialTotalPages} aria-label={`Página ${initialTotalPages}`}>{initialTotalPages}</button>
              </>
            )}
          </div>
          <button type="button" id="paginationNext" class="btn-secondary btn-sm" {initialTotalPages <= 1 ? 'disabled' : ''} aria-label="Página siguiente">
            Siguiente
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </nav>
      </div>

      <div class="sections-admin">
        <div class="list-header-row">
          <div>
            <h3 class="card-title">Secciones de la web</h3>
            <p class="card-desc">Crea secciones que se mostrarán en la portada con los productos que elijas (arrastra desde el catálogo con la selección).</p>
          </div>
        </div>
        <div id="sectionsListAdmin" class="sections-list-admin"></div>
      </div>
    </section>

    <section data-admin-view="affiliates" class:list={['admin-dashboard-view', 'hidden-section', { 'is-visible': initialSection === 'affiliates' }]}>
      <div class="view-heading">
        <span class="admin-tag-pill">Integraciones de monetización</span>
        <h2 class="admin-title">Afiliados y Multi-Catálogo</h2>
            <p class="admin-subtitle">Conecta redes de afiliación con sus credenciales y valida la conexión. El catálogo multi-red se sincroniza contra las APIs de todas las redes conectadas y se filtra con barras de rango calculadas sobre los datos reales (precio, descuento, comisión, ventas, valoración y envío).</p>
      </div>

      <div class="affiliates-layout">
        <!-- Columna 1: Gestor de credenciales multi-red -->
        <div id="networksCard">
          <div class="card-header">
            <div class="header-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <div>
              <h2 class="card-title">1. Redes conectadas</h2>
              <p class="card-desc">Guarda las credenciales de cada red y valida la conexión. Los valores secretos nunca se devuelven al navegador.</p>
            </div>
          </div>
          <div id="networkList" class="network-list">
            <div class="loading-panel">Cargando redes...</div>
          </div>
          <div id="searchStatus" class="status-alert" hidden>
            <div class="alert-icon">ℹ️</div>
            <div class="alert-content">
              <strong id="searchStatusTitle">Estado</strong>
              <p id="searchStatusText">Mensaje...</p>
            </div>
          </div>
          <div id="removedNetworks" class="removed-networks"></div>
        </div>

      </div>

      <!-- 3. Catálogo AliExpress desde la caché del volumen (sin llamadas API en cada carga) -->
      <div id="aliCatalogCard">
        <div class="card-header">
          <div class="header-icon icon-cyan">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3v18h18"></path>
              <path d="M7 14l4-4 4 4 5-6"></path>
            </svg>
          </div>
          <div class="card-header-main" style="flex: 1; min-width: 0;">
              <h2 class="card-title">2. Catálogo de Afiliados</h2>
            <p class="card-desc">Tabla amplia de todos los productos sincronizados con las redes conectadas (AliExpress, eBay…), guardados en el servidor. Usa «Sincronizar» para refrescarlo contra las APIs; se avisa si la caché supera las 6 horas.</p>
          </div>
          <button type="button" id="btnAliSyncHeader" class="btn-primary btn-sm" style="flex-shrink: 0; margin-left: 1rem;" title="Sincroniza el catálogo contra las APIs de las redes conectadas (AliExpress, eBay…)">
            <span class="btn-text">🔄 Sincronizar</span>
            <div class="btn-spinner" hidden></div>
          </button>
        </div>

        <div id="aliCatalogStatus" class="status-alert" hidden>
          <div class="alert-icon" id="aliCatalogStatusIcon">ℹ️</div>
          <div class="alert-content">
            <strong id="aliCatalogStatusTitle">Estado</strong>
            <p id="aliCatalogStatusText">Mensaje...</p>
          </div>
        </div>

        <!-- Filtros y ordenación del catálogo (3 capas; aplican ANTES de paginar)
             Lógica y estado: src/utils/aliCatalogFilters.ts (ProductFilterParams) -->
        <div id="aliFilters" class="ali-filters" hidden>
          <!-- CAPA 1 · Buscador + presets rápidos de 1 clic -->
          <div class="ali-f-top">
            <div class="filter-field ali-f-search">
              <label for="aliFQ">Buscar</label>
              <div class="ali-search">
                <svg class="ali-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="search" id="aliFQ" placeholder="Título o descripción..." autocomplete="off" />
                <span class="ali-f-count" id="aliFCount" title="Resultados que cumplen los filtros">0/0</span>
              </div>
            </div>
            <div class="ali-presets" role="group" aria-label="Vistas rápidas de filtros">
              <button type="button" class="ali-preset" data-ali-preset="top-ventas" aria-pressed="false"><span class="ali-preset-ico">🔥</span> Top Ventas</button>
              <button type="button" class="ali-preset" data-ali-preset="alto-margen" aria-pressed="false"><span class="ali-preset-ico">💰</span> Alto Margen</button>
              <button type="button" class="ali-preset" data-ali-preset="envio-express" aria-pressed="false"><span class="ali-preset-ico">⚡</span> Envío Exprés</button>
              <button type="button" class="ali-preset ali-preset-clear" data-ali-preset="clear" aria-pressed="false"><span class="ali-preset-ico">🗑️</span> Limpiar Filtros</button>
            </div>
          </div>

          <!-- CAPA 2 · Filtros principales + ordenación -->
          <div class="ali-filters-row">
            <div class="filter-field ali-f-cat">
              <label for="aliFCat1">Categoría</label>
              <select id="aliFCat1"><option value="">Todas</option></select>
            </div>
            <div class="filter-field ali-f-cat">
              <label for="aliFCat2">Subcategoría</label>
              <select id="aliFCat2" disabled><option value="">Todas</option></select>
            </div>
            <div class="filter-field ali-f-state">
              <label for="aliFState">En catálogo</label>
              <select id="aliFState" title="Filtra por si el producto ya está añadido al catálogo de Tradylor o no">
                <option value="ALL">Todos</option>
                <option value="PENDING">No añadidos</option>
                <option value="IMPORTED">Añadidos al catálogo</option>
                <option value="DISCARDED">Descartados</option>
              </select>
            </div>
            <div class="filter-field ali-f-network">
              <label for="aliFNetwork">Comerciante / Red</label>
              <select id="aliFNetwork" title="Filtra por la red de afiliación (comerciante) de origen"><option value="">Todas</option></select>
            </div>
            <div class="filter-field ali-f-pair">
              <label for="aliFPriceMin">Precio (€)</label>
              <div class="ali-pair">
                <input type="number" id="aliFPriceMin" min="0" step="0.01" placeholder="Mín." inputmode="decimal" />
                <span class="ali-pair-sep" aria-hidden="true">–</span>
                <input type="number" id="aliFPriceMax" min="0" step="0.01" placeholder="Máx." inputmode="decimal" />
              </div>
            </div>
            <div class="filter-field ali-f-pair">
              <label for="aliFCommMin">Comisión mín.</label>
              <div class="ali-pair">
                <input type="number" id="aliFCommMin" min="0" step="0.1" placeholder="0" inputmode="decimal" />
                <select id="aliFCommUnit" class="ali-pair-unit" aria-label="Unidad de comisión">
                  <option value="eur">€</option>
                  <option value="pct">%</option>
                </select>
              </div>
            </div>
            <div class="filter-field ali-f-short">
              <label for="aliFSalesMin">Ventas 30 d</label>
              <input type="number" id="aliFSalesMin" min="0" step="1" placeholder="Mín." inputmode="numeric" />
            </div>
            <div class="filter-field ali-f-short">
              <label for="aliFRatingMin">Valoración</label>
              <select id="aliFRatingMin">
                <option value="">Cualquiera</option>
                <option value="4">≥ 4,0 ★</option>
                <option value="4.5">≥ 4,5 ★</option>
                <option value="4.6">≥ 4,6 ★</option>
                <option value="4.8">≥ 4,8 ★</option>
              </select>
            </div>
            <div class="filter-field ali-sort-field">
              <label for="aliFSort">Ordenar por</label>
              <div class="ali-sort-group">
                <select id="aliFSort">
                  <option value="ventas" selected>Más ventas</option>
                  <option value="visitas">Visitas</option>
                  <option value="comision_eur">Mayor comisión €</option>
                  <option value="comision_pct">Mayor comisión %</option>
                  <option value="valoracion">Mejor valoración</option>
                  <option value="descuento">Mayor descuento</option>
                  <option value="precio">Precio</option>
                  <option value="nombre">Nombre</option>
                  <option value="fecha">Fecha de alta</option>
                </select>
                <button type="button" id="aliFSortDir" class="btn-secondary btn-sm ali-sort-dir" data-dir="desc" title="Orden actual: mayor a menor. Pulsa para invertir.">↓</button>
              </div>
            </div>
            <div class="ali-f-btns">
              <button type="button" id="aliFMoreBtn" class="btn-secondary btn-sm" aria-expanded="false" aria-controls="aliAdvanced" title="Filtros avanzados: envío, Choice, comisión Hot, imágenes, tienda...">
                ⚙ Más filtros <span class="ali-f-badge" id="aliFAdvBadge" hidden>0</span>
              </button>
            </div>
          </div>

          <!-- CAPA 3 · Panel desplegable de opciones avanzadas -->
          <div id="aliAdvanced" class="ali-advanced" hidden>
            <label class="ali-check"><input type="checkbox" id="aliFFreeShip" /> <span>Solo envío gratis</span></label>
            <label class="ali-check"><input type="checkbox" id="aliFChoice" /> <span>Solo AliExpress Choice / Almacén Local</span></label>
            <label class="ali-check"><input type="checkbox" id="aliFHot" /> <span>Solo con Comisión Hot (&gt; 0 %)</span></label>
            <div class="filter-field ali-f-mini">
              <label for="aliFImages">Mín. imágenes</label>
              <input type="number" id="aliFImages" min="0" step="1" placeholder="0" inputmode="numeric" />
            </div>
            <div class="filter-field ali-f-mini">
              <label for="aliFDiscMin">Descuento mín. (%)</label>
              <input type="number" id="aliFDiscMin" min="0" max="100" step="1" placeholder="0" inputmode="numeric" />
            </div>
            <div class="filter-field ali-f-mini">
              <label for="aliFShop">Tienda</label>
              <select id="aliFShop"><option value="">Todas</option></select>
            </div>
          </div>

          <!-- Chips: filtros activos, quítalos de uno en uno -->
          <div id="aliFChips" class="ali-chips" hidden></div>
        </div>

        <!-- Acciones del catálogo: alta directa en categorías/subcategorías
             existentes + sincronización (derecha). -->
        <div id="aliImportActions" class="ali-import-actions">
          <div id="aliImportTools" class="ali-import-tools" hidden>
            <span class="ali-import-title">Añadir al catálogo</span>
            <select id="aliCatAssign" class="sel-cat-assign" aria-label="Categoría destino">
              <option value="">Categoría destino…</option>
            </select>
            <select id="aliSubcatAssign" class="sel-cat-assign" aria-label="Subcategoría destino">
              <option value="">Subcategoría destino…</option>
            </select>
            <button type="button" id="btnAliImportCat" class="btn-success btn-sm" title="Importa los productos marcados en la tabla dentro de la categoría y subcategoría elegidas">📥 Añadir seleccionados a categoría</button>
            <button type="button" id="btnAliHideSel" class="btn-danger-ghost btn-sm" title="Oculta los productos marcados: no se verán en la tabla ni se añadirán al catálogo. Recupéralos con «En catálogo › Descartados»">🙈 Ocultar seleccionados</button>
          </div>
          <div class="ali-catalog-head-actions">
            <span id="aliCatalogMeta" class="ali-catalog-meta">Cargando…</span>
            <div class="ali-sync-controls" style="display: flex; align-items: center; gap: 0.5rem;">
              <select id="aliSyncNetwork" class="sel-cat-assign" aria-label="Red a sincronizar" title="Elige qué red de afiliados sincronizar. 'Todas' sincroniza todas las conectadas.">
                <option value="">Todas las conectadas</option>
              </select>
              <button type="button" id="btnAliSync" class="btn-primary btn-sm">
                <span class="btn-text">Sincronizar</span>
                <div class="btn-spinner" hidden></div>
