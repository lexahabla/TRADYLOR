  :global(.aff-row:hover) { background: rgba(96, 165, 250, .06); }
  :global(.aff-row.is-open) { background: rgba(96, 165, 250, .1); }
  :global(.aff-thumb) { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 2px; background: #fff; border-radius: 6px; }
  :global(.aff-thumb img) { max-width: 100%; max-height: 100%; object-fit: contain; }
  :global(.aff-name) { min-width: 200px; max-width: 300px; }
  :global(.aff-name strong) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-weight: 650; font-size: .65rem; line-height: 1.3; }
  :global(.aff-name span) { display: block; margin-top: .1rem; color: var(--color-text-dim); font-size: .55rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.aff-actions) { display: flex; align-items: center; justify-content: flex-end; gap: .3rem; white-space: nowrap; }
  :global(.aff-actions .btn-sm) { padding: .2rem .4rem; font-size: .6rem; }
  :global(.aff-caret) { width: 24px; height: 24px; color: #93c5fd; background: rgba(96, 165, 250, .1); border: 1px solid rgba(96, 165, 250, .25); border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-body); font-size: .7rem; font-weight: 700; transition: all .2s ease; }
  :global(.aff-row.is-open .aff-caret) { transform: rotate(90deg); }
  :global(.aff-detail td) { background: rgba(4, 10, 18, .55); }
  :global(.aff-detail-grid) { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: .5rem .8rem; margin: 0; }
  :global(.aff-detail-item dt) { color: var(--color-text-dim); font-size: .6rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  :global(.aff-detail-item dd) { margin: .1rem 0 0; color: var(--color-text-main); font-size: .7rem; word-break: break-word; }
  :global(.aff-detail-item a) { color: #93c5fd; }
  /* Miniaturas de imágenes: SIEMPRE el último aff-detail-item, a todo lo
     ancho del desplegable y en una sola fila horizontal (scroll si hay muchas). */
  :global(.aff-detail-item.is-images) { grid-column: 1 / -1; }
  :global(.aff-detail-thumbs) { display: flex; flex-wrap: nowrap; align-items: center; gap: 6px; overflow-x: auto; padding-bottom: 2px; }
  :global(.aff-detail-thumbs a) { flex: 0 0 auto; line-height: 0; }
  :global(.aff-detail-thumbs img) { width: 56px; height: 56px; object-fit: cover; border-radius: 6px; border: 1px solid var(--color-border); }
  /* Checkboxes de selección masiva de la tabla AliExpress */
  :global(.ac-th-check), :global(.ac-td-check) { width: 28px; padding-left: .5rem !important; padding-right: .2rem !important; }
  :global(.ac-th-check input), :global(.ac-td-check input) { accent-color: #38bdf8; cursor: pointer; width: 14px; height: 14px; margin: 0; }
  /* Barra de filtros de la tabla AliExpress */
  .ali-filters { display: flex; flex-direction: column; gap: .55rem; margin-bottom: .6rem; padding: .55rem .65rem; background: rgba(255, 255, 255, .02); border: 1px solid var(--color-border); border-radius: 10px; }
  .ali-filters[hidden] { display: none; }
  .ali-filters-row { display: flex; align-items: flex-end; gap: .5rem; flex-wrap: wrap; }
  /* El <br> entre el botón "Más filtros" y .ali-presets fuerza un salto de
     línea dentro de este flex-wrap (un <br> normal no hace nada dentro de
     flex): al ocupar el 100% del ancho, empuja los presets a su propia fila,
     igual que en el Catálogo de Productos Registrados (#prodPresets). */
  .ali-filters-row > br { flex-basis: 100%; width: 100%; height: 0; margin: 0; border: 0; padding: 0; }
  .ali-filters .filter-field { min-width: 90px; flex: 0 1 auto; }
  .ali-filters .filter-field.ali-f-search { flex: 1 1 180px; min-width: 150px; }
  .ali-filters .btn-secondary { flex-shrink: 0; padding: .5rem .8rem; font-size: .72rem; }
  .ali-sort-group { display: flex; gap: .3rem; align-items: center; }
  .ali-sort-group select { flex: 0 0 auto; min-width: 120px; max-width: 170px; }
  .ali-sort-dir { flex-shrink: 0; min-width: 34px; font-size: .9rem; font-weight: 800; line-height: 1; }
  /* Select de valoración mínima del catálogo: más estrecho para no solaparse con el botón de dirección de ordenación */
  #prodFRatingMin { min-width: 110px; width: 110px; max-width: 110px; padding: .2rem .35rem; font-size: .72rem; }

  /* ── Catálogo AliExpress: barra de filtros en 3 capas ─────────────────
     (clases nuevas; .ali-filters / .ali-filters-row / .ali-sort-group /
     .ali-range-* se comparten con la tabla de Productos Registrados) */
  .ali-f-top { display: flex; align-items: flex-end; gap: .6rem; flex-wrap: wrap; }
  .ali-filters .ali-f-top .ali-f-search { flex: 1 1 260px; min-width: 220px; }
  .ali-search { position: relative; display: flex; align-items: center; }
  .ali-search-icon { position: absolute; left: .6rem; color: var(--color-text-dim); pointer-events: none; }
  .ali-search input { padding-left: 1.8rem !important; padding-right: 3.4rem !important; }
  .ali-f-count { position: absolute; right: .45rem; padding: .1rem .5rem; border-radius: 999px; background: rgba(56, 189, 248, .14); color: #7dd3fc; font-size: .62rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .ali-f-count.is-filtered { background: rgba(56, 189, 248, .3); box-shadow: 0 0 0 1px rgba(56, 189, 248, .4) inset; }

  /* CAPA 1 · Presets rápidos. Ahora viven en su propia línea dentro de
     .ali-filters-row (tras el <br>), alineados a la izquierda igual que
     #prodPresets, con una línea separadora como el resto de filas. */
  .ali-presets { display: flex; align-items: center; gap: .35rem; flex-wrap: wrap; padding-top: .45rem; margin-top: .1rem; border-top: 1px dashed rgba(255, 255, 255, .07); }
  .ali-preset { display: inline-flex; align-items: center; gap: .3rem; padding: .45rem .7rem; font: inherit; font-size: .72rem; font-weight: 700; color: var(--color-text-muted); background: #0b1220; border: 1px solid var(--color-border); border-radius: 999px; cursor: pointer; transition: all .18s ease; white-space: nowrap; }
  .ali-preset:hover { color: #dbeafe; border-color: rgba(96, 165, 250, .5); transform: translateY(-1px); }
  .ali-preset.is-active { color: #04121f; background: linear-gradient(135deg, #38bdf8, #22d3ee); border-color: transparent; box-shadow: 0 4px 12px rgba(56, 189, 248, .28); }
  .ali-preset-clear:hover { color: #fca5a5; border-color: rgba(239, 68, 68, .45); }
  /* Preset aplicado sin alguna condición (la caché no trae esa columna): marca ⚠ + tooltip */
  .ali-preset[data-partial]::after { content: '⚠'; margin-left: .15rem; font-size: .72rem; color: #92400e; }
  .ali-preset-ico { font-size: .82rem; line-height: 1; }

  /* CAPA 2 · Controles principales + ordenación */
  .ali-filters .filter-field.ali-f-cat { flex: 1 1 85px; min-width: 80px; }
  .ali-filters .filter-field.ali-f-state { flex: 0 1 108px; min-width: 104px; }
  .ali-filters .filter-field.ali-f-network { flex: 1 1 150px; min-width: 130px; }
  .ali-filters .filter-field.ali-f-short { flex: 0 1 116px; min-width: 112px; }
  .ali-filters .filter-field.ali-sort-field { flex: 0 1 215px; }
  .ali-f-btns { display: flex; align-items: flex-end; gap: .35rem; }
  .ali-f-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 1.15rem; height: 1.15rem; padding: 0 .25rem; margin-left: .3rem; border-radius: 999px; background: #38bdf8; color: #04121f; font-size: .6rem; font-weight: 800; }
  .ali-f-badge[hidden] { display: none; }
  .ali-pair { display: flex; align-items: stretch; gap: .3rem; }
  .ali-pair input { width: 100%; min-width: 0; }
  .ali-pair-sep { align-self: center; color: var(--color-text-dim); font-size: .7rem; }
  /* El select de unidad hereda `.filter-field select` (width:100% + padding .7rem): con 40px sólo cabía la flecha.
     Selector más específico para fijar un ancho que deje ver «€» / «%». */
  .ali-filters .ali-pair .ali-pair-unit { flex: 0 0 62px; width: 62px; padding-left: .55rem; padding-right: .3rem; }
  /* Controles de rango del Catálogo de Productos Registrados (precio min/máx,
     descuento por rangos y valoración por umbral).
     Se inyectan por JS (innerHTML), así que las reglas van en :global (Astro
     sólo añade el atributo de scope a los elementos del template): sin esto
     estos controles salían como inputs/selects nativos, distintos del resto
     de la fila. Ahora heredan EXACTAMENTE el estilo de `.filter-field` (el
     input de búsqueda, Categoría, Subcategoría y Ordenar por). */
  .ali-filters .filter-field.ali-f-pair { flex: 0 1 170px; min-width: 152px; }
  /* Columna fija (minmax(0,1fr)): con la columna `auto` el grid se dimensionaba
     por el max-content de los inputs y el par Mín/Máx se salía del campo
     (404px dentro de 156px) =&gt; se solapaba con Descuento y con el botón. */
  .prod-filters :global(.filter-field.prod-range-field[data-range-field="rating"]) { flex: 0 1 150px; min-width: 140px; }
  .prod-filters :global(.filter-field.prod-range-field[data-range-field="rating"] select) { max-width: 145px; width: auto; }
  .prod-filters :global(.filter-field.prod-range-field) { display: grid; grid-template-columns: minmax(0, 1fr); gap: .3rem; flex: 0 1 156px; min-width: 138px; }
  /* Precio: cabida cómoda para 4 cifras por casilla (ampliado un 50% sobre
     el ajuste anterior, que quedaba demasiado justo). */
  .prod-filters :global(.filter-field.prod-range-field[data-range-field="price"]) { flex: 0 1 222px; min-width: 192px; }
  .prod-filters :global(.filter-field.prod-range-field label) { color: var(--color-text-dim); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .prod-filters :global(.filter-field.prod-range-field input),
  .prod-filters :global(.filter-field.prod-range-field select) { width: 100%; box-sizing: border-box; padding: .55rem .7rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; font-size: .8rem; outline: none; }
  .prod-filters :global(.filter-field.prod-range-field input:focus),
  .prod-filters :global(.filter-field.prod-range-field select:focus) { border-color: #38bdf8; }
  /* El par de precios: dos campos con la misma caja que el input de búsqueda. */
  .prod-filters :global(.filter-field.prod-range-field .ali-pair) { display: flex; align-items: stretch; gap: .35rem; min-width: 0; }
  .prod-filters :global(.filter-field.prod-range-field .ali-pair input),
  #prodFPriceMin,
  #prodFPriceMax,
  :global(#prodFPriceMin),
  :global(#prodFPriceMax) {
    flex: 1 1 0;
    width: auto;
    min-width: 0;
    background: var(--color-bg-main);
    color: var(--color-text-main);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: .45rem .6rem;
    outline: none;
  }
  .prod-filters :global(.filter-field.prod-range-field .ali-pair input::placeholder) { color: var(--color-text-dim); }
  .prod-filters :global(.filter-field.prod-range-field .ali-pair-sep) { display: flex; align-items: center; color: var(--color-text-dim); font-size: .7rem; }
  /* El botón de limpiar filtros se alinea con la altura de los controles. */
  .prod-filters .ali-f-reset { min-height: 2.15rem; }
  /* Contador de selección (span suelto, sin botón): mismo tono apagado que
     las etiquetas de los filtros. margin-left:auto empuja todo el grupo de
     selección (contador + Catálogo + Limpiar) al extremo derecho de la fila. */
  .prod-filters #productSelCount { align-self: none; margin-left: auto; color: var(--color-text-dim); font-size: .78rem; font-weight: 600; white-space: nowrap; }

  /* CAPA 3 · Panel desplegable «Más filtros» */
  .ali-advanced { display: flex; flex-wrap: wrap; align-items: flex-end; gap: .5rem .7rem; padding: .55rem .6rem; background: rgba(255, 255, 255, .025); border: 1px dashed rgba(148, 163, 184, .22); border-radius: 8px; }
  .ali-advanced[hidden] { display: none; }
  .ali-check { display: inline-flex; align-items: center; gap: .4rem; padding: .35rem .55rem; color: var(--color-text-muted); font-size: .72rem; font-weight: 600; cursor: pointer; border-radius: 6px; }
  .ali-check:hover { color: var(--color-text-main); }
  .ali-check input { accent-color: #38bdf8; }
  .ali-check[data-no-data] { opacity: .45; cursor: not-allowed; }
  .ali-check[data-no-data] input { cursor: not-allowed; }
  .ali-filters .filter-field.ali-f-mini { flex: 0 1 108px; min-width: 104px; }

  /* Chips: filtros activos, quítalos de uno en uno.
     Los crea el módulo TS con document.createElement (sin el atributo de scope
     de Astro), de ahí el :global; el contenedor #aliFChips sí es estático. */
  .ali-chips { display: flex; flex-wrap: wrap; gap: .3rem; }
  .ali-chips[hidden] { display: none; }
  :global(.ali-chip) { display: inline-flex; align-items: center; gap: .35rem; padding: .28rem .35rem .28rem .6rem; color: #bae6fd; font: inherit; font-size: .66rem; font-weight: 700; background: rgba(56, 189, 248, .1); border: 1px solid rgba(56, 189, 248, .28); border-radius: 999px; cursor: pointer; transition: all .15s ease; }
  :global(.ali-chip:hover) { border-color: rgba(248, 113, 113, .5); color: #fecaca; background: rgba(248, 113, 113, .08); }
  :global(.ali-chip-x) { font-size: .8rem; font-weight: 800; line-height: 1; }

  /* Estado de importación visible en cada fila */
  :global(.ac-state) { display: inline-block; margin-left: .35rem; padding: .05rem .3rem; border-radius: 999px; font-size: .56rem; font-weight: 800; vertical-align: 1px; white-space: nowrap; }
  :global(.ac-state.is-imported) { color: #6ee7b7; background: rgba(16, 185, 129, .12); border: 1px solid rgba(16, 185, 129, .28); }
  :global(.ac-state.is-discarded) { color: #fca5a5; background: rgba(239, 68, 68, .1); border: 1px solid rgba(239, 68, 68, .28); }

  /* Columna «Estado» (condición física: Nuevo/Usado/Reacondicionado...) de
     las tablas de Importar y Catálogo. Se destaca en ámbar los artículos de
     segunda mano para poder filtrarlos de un vistazo. */
  :global(.cond-pill) { display: inline-block; padding: .15rem .45rem; border-radius: 999px; font-size: .62rem; font-weight: 800; white-space: nowrap; }
  :global(.cond-pill.cond-new) { color: #93c5fd; background: rgba(59, 130, 246, .1); border: 1px solid rgba(59, 130, 246, .28); }
  :global(.cond-pill.cond-used) { color: #fcd34d; background: rgba(245, 158, 11, .12); border: 1px solid rgba(245, 158, 11, .32); }
  :global(.cond-pill.cond-unknown) { color: var(--color-text-dim); }

  /* Panel «Campos visibles en la ficha del producto» (sección 1b) */
  .field-visibility-panel { padding: 0 1.25rem 1.25rem; display: flex; flex-direction: column; gap: .6rem; }
  .field-visibility-panel[hidden] { display: none; }
  .field-visibility-subtitle { margin: .4rem 0 0; font-size: .82rem; font-weight: 800; color: var(--color-text-muted, #9ca3af); text-transform: uppercase; letter-spacing: .03em; }
  .field-toggle-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .5rem; }
  .field-toggle-item { display: flex; align-items: flex-start; gap: .55rem; padding: .55rem .7rem; background: var(--color-bg-card, #111827); border: 1px solid var(--color-border, #1f2937); border-radius: 10px; }
  .field-toggle-item input[type="checkbox"] { margin-top: .2rem; flex-shrink: 0; }
  .field-toggle-item-text { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
  .field-toggle-item-label { font-weight: 700; font-size: .84rem; color: var(--color-text-main, #f3f4f6); }
  .field-toggle-item-hint { font-size: .72rem; color: var(--color-text-dim, #6b7280); }
  .field-toggle-item-remove { margin-left: auto; flex-shrink: 0; background: none; border: 0; color: var(--color-text-dim, #6b7280); cursor: pointer; font-size: .9rem; line-height: 1; padding: .2rem; }
  .field-toggle-item-remove:hover { color: #f87171; }
  .custom-field-add-row { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; padding-top: .4rem; border-top: 1px dashed var(--color-border, #1f2937); }
  .custom-field-add-row input[type="text"] { flex: 1; min-width: 220px; }
  .field-visibility-status { margin: 0; font-size: .78rem; min-height: 1em; }
  .custom-fields-container { display: flex; flex-direction: column; gap: .65rem; }
  .custom-fields-container .form-group { margin: 0; }

  /* Letrero «Añadido al catálogo» anclado sobre el botón Añadir */
  :global(.aff-actions) { position: relative; }
  :global(.ac-added-flag) { position: absolute; right: 0; bottom: calc(100% + 5px); z-index: 20; padding: .3rem .55rem; border-radius: 6px; font: inherit; font-size: .62rem; font-weight: 800; white-space: nowrap; color: #06281c; background: #34d399; box-shadow: 0 6px 16px rgba(16, 185, 129, .35); animation: ac-flag-in .18s ease; }
  :global(.ac-added-flag.is-warn) { color: #2d1a04; background: #fbbf24; }
  :global(.ac-added-flag.is-error) { color: #ffffff; background: #ef4444; }
  @keyframes ac-flag-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  :global(.empty-dashboard) p { margin: 0 0 .7rem; }
  :global(.empty-dashboard) .btn-sm { padding: .45rem .9rem; }
  /* Barras de rango duales (precio, dto, comisiones, ventas, rating, envío)
     Versión compacta: rail fino de 3px y thumb de 11px. */
  .ali-range-fields { display: flex; flex-wrap: wrap; gap: .3rem .7rem; padding-top: .3rem; border-top: 1px dashed rgba(255, 255, 255, .07); }
  .ali-range-fields:empty { display: none; }
  /* En el Catálogo de Productos Registrados los rangos (Precio €, Descuento,
     Valoración) viven DENTRO de .ali-filters-row: display:contents los hace
     items de la MISMA FILA que el resto de filtros, con su misma estética. */
  .prod-filters .ali-range-fields { display: contents; }
  .ali-range { flex: 1 1 145px; min-width: 128px; max-width: 210px; display: grid; gap: .1rem; }
  .ali-range-head { display: flex; align-items: baseline; justify-content: space-between; gap: .4rem; }
  .ali-range-head label { color: var(--color-text-dim); font-size: .58rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .ali-range-values { color: #7dd3fc; font-size: .62rem; font-weight: 700; white-space: nowrap; }
  .ali-range-track { position: relative; height: 18px; }
  .ali-range-rail, .ali-range-fill { position: absolute; top: 50%; height: 3px; transform: translateY(-50%); border-radius: 999px; pointer-events: none; }
  .ali-range-rail { left: 0; right: 0; background: rgba(255, 255, 255, .12); }
  .ali-range-fill { background: linear-gradient(90deg, #38bdf8, #22d3ee); }
  .ali-range-track input[type="range"] { position: absolute; inset: 0; width: 100%; height: 18px; margin: 0; background: none; pointer-events: none; -webkit-appearance: none; appearance: none; outline: none; }
  .ali-range-track input[type="range"]::-webkit-slider-runnable-track { background: transparent; height: 3px; }
  .ali-range-track input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; pointer-events: auto; width: 11px; height: 11px; margin-top: -4px; border: 2px solid #0b1220; border-radius: 50%; background: #38bdf8; cursor: grab; box-shadow: 0 0 5px rgba(56, 189, 248, .5); }
  .ali-range-track input[type="range"]::-moz-range-track { background: transparent; height: 3px; }
  .ali-range-track input[type="range"]::-moz-range-thumb { pointer-events: auto; width: 11px; height: 11px; border: 2px solid #0b1220; border-radius: 50%; background: #38bdf8; cursor: grab; box-shadow: 0 0 5px rgba(56, 189, 248, .5); }
  /* Barra de filtros del Catálogo de Productos Registrados (misma estética) */
  .prod-filters { margin-top: 0; margin-bottom: .8rem; }
  .prod-filters .filter-field select { min-width: 180px; width: auto; max-width: 100%; }
  .prod-filters .ali-sort-group select { min-width: 120px; width: auto; max-width: 170px; }
  :global(.btn-danger-ghost.btn-sm) { padding: .3rem .55rem; font-size: .68rem; gap: .25rem; }
  /* Barra de selección masiva */
  .ali-selection { display: flex; align-items: center; gap: .55rem; flex-wrap: wrap; margin-bottom: .6rem; padding: .5rem .7rem; color: #7dd3fc; background: rgba(56, 189, 248, .08); border: 1px solid rgba(56, 189, 248, .3); border-radius: 10px; font-size: .74rem; font-weight: 700; }
  .ali-selection[hidden] { display: none; }
  .ali-selection .btn-sm { padding: .28rem .6rem; font-size: .68rem; }

  /* Barra de selección de la tabla «Catálogo de Productos Registrados» */
  .product-sel-bar {
    display: flex;
    flex-direction: column;
    gap: .65rem;
    margin-bottom: .8rem;
    padding: .65rem .85rem;
    background: none !important;
    border: 1px solid #1f2937 !important;
    border-radius: 10px;
    font-size: .74rem;
    color: var(--color-text-dim);
    overflow-x: hidden;
  }
  .product-sel-bar .btn-sm { padding: .3rem .6rem; font-size: .68rem; white-space: nowrap; flex-shrink: 0; }
  .product-sel-groups {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: .55rem;
    overflow-x: hidden;
    width: 100%;
  }
  .product-sel-group {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: .45rem;
    padding: .35rem .65rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    min-width: 0;
    max-width: 100%;
    overflow-x: hidden;
  }
  .product-sel-group > * {
    flex-shrink: 0;
  }
  .product-sel-group select {
    flex-shrink: 0;
    min-width: 170px;
    max-width: 100%;
    width: auto;
  }
  .product-sel-group-label {
    font-size: .68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #93c5fd;
    white-space: nowrap;
    margin-right: .2rem;
    flex-shrink: 0;
  }
  .product-sel-group[data-group="ai"] .product-sel-group-label {
    color: #c084fc;
  }
  .product-sel-group[data-group="deletion"] .product-sel-group-label {
    color: #fca5a5;
  }
  /* Botón flotante: volver al menú de secciones (alineado a la izquierda) */
  .admin-back-to-top {
    position: fixed;
    left: 1.1rem;
    bottom: 1.1rem;
    z-index: 70;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .65rem .95rem;
    color: #04121f;
    background: linear-gradient(135deg, #38bdf8, #22d3ee);
    border: 0;
    border-radius: 999px;
    box-shadow: 0 10px 26px rgba(56, 189, 248, .35);
    cursor: pointer;
    font: inherit;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .02em;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .admin-back-to-top:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(56, 189, 248, .5); }
  .admin-back-to-top svg { display: block; }

  /* Botón flotante de la consola de IA (encima del botón «Secciones») */
  .admin-ai-console-btn {
    position: fixed;
    left: 1.1rem;
    bottom: 4.3rem;
    z-index: 71;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .55rem .85rem;
    color: #0a1a12;
    background: linear-gradient(135deg, #34d399, #22d3ee);
    border: 0;
    border-radius: 999px;
    box-shadow: 0 10px 26px rgba(52, 211, 153, .32);
    cursor: pointer;
    font: inherit;
    font-size: .78rem;
    font-weight: 800;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .admin-ai-console-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(52, 211, 153, .45); }

  /* Consola interactiva de IA: modal grande a pantalla completa (antes un
     drawer pequeño en la esquina) con mensajes en formato legible (listas,
     negrita, bloques de código...) en vez de texto plano. */
  .admin-ai-console {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
  }
  .aic-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 8, 15, .78);
    backdrop-filter: blur(3px);
  }
  .aic-dialog {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(1000px, 100%);
    height: min(88vh, 900px);
    background: rgba(13, 19, 33, .98);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .6);
    overflow: hidden;
  }
  .aic-head { display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding: .85rem 1.1rem; background: rgba(59, 130, 246, .12); border-bottom: 1px solid var(--color-border); font-size: .95rem; }
  .aic-head-actions { display: flex; align-items: center; gap: .3rem; }
  .aic-icon-btn { background: transparent; border: 0; color: var(--color-text-muted); font-size: 1.15rem; line-height: 1; cursor: pointer; padding: .3rem .5rem; border-radius: 8px; transition: background .15s ease, color .15s ease; }
  .aic-icon-btn:hover { color: var(--color-text-main); background: rgba(255, 255, 255, .08); }
  .aic-close { font-size: 1.3rem; }
  .aic-controls { display: flex; gap: .5rem; padding: .7rem .9rem; border-bottom: 1px solid rgba(255, 255, 255, .06); }
  .aic-controls select, .aic-controls input { flex: 1; min-width: 0; padding: .4rem .6rem; background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: 8px; color: var(--color-text-main); font: inherit; font-size: .82rem; }
  .aic-messages { flex: 1; overflow-y: auto; padding: 1.1rem 1.25rem; display: flex; flex-direction: column; gap: .7rem; font-size: .9rem; }
  .aic-msg { max-width: 82%; padding: .65rem .85rem; border-radius: 12px; word-break: break-word; line-height: 1.6; }
  .aic-msg.is-user { align-self: flex-end; background: rgba(59, 130, 246, .22); color: #dbeafe; white-space: pre-wrap; }
  .aic-msg.is-assistant { align-self: flex-start; background: rgba(255, 255, 255, .06); color: var(--color-text-main); }
  .aic-msg.is-system { align-self: center; background: transparent; color: var(--color-text-dim); font-size: .78rem; text-align: center; max-width: 100%; }
  .aic-msg.is-error { align-self: flex-start; background: rgba(239, 68, 68, .15); color: #fecaca; white-space: pre-wrap; }
  /* Formato legible dentro de una respuesta de la IA (ver formatIaReply en el script) */
  .aic-msg.is-assistant p { margin: 0 0 .6rem; }
  .aic-msg.is-assistant p:last-child { margin-bottom: 0; }
  .aic-msg.is-assistant h3, .aic-msg.is-assistant h4 { margin: .2rem 0 .5rem; color: #93c5fd; font-family: var(--font-heading); }
  .aic-msg.is-assistant ul, .aic-msg.is-assistant ol { margin: 0 0 .6rem; padding-left: 1.3rem; display: flex; flex-direction: column; gap: .25rem; }
  .aic-msg.is-assistant li { line-height: 1.55; }
  .aic-msg.is-assistant strong { color: #ffffff; }
  .aic-msg.is-assistant code { background: rgba(0, 0, 0, .35); border: 1px solid rgba(255, 255, 255, .1); border-radius: 5px; padding: .1rem .35rem; font-size: .85em; }
  .aic-msg.is-assistant pre { margin: 0 0 .6rem; padding: .75rem .9rem; background: rgba(0, 0, 0, .4); border: 1px solid rgba(255, 255, 255, .1); border-radius: 10px; overflow-x: auto; }
  .aic-msg.is-assistant pre code { background: none; border: 0; padding: 0; }
  .aic-sources { margin-top: .5rem; padding-top: .5rem; border-top: 1px solid rgba(255, 255, 255, .12); font-size: .74rem; color: var(--color-text-dim, #6b7280); display: flex; flex-wrap: wrap; gap: .35rem .6rem; }
  .aic-sources a { color: #93c5fd; text-decoration: none; }
  .aic-sources a:hover { text-decoration: underline; }
  .aic-input-row { display: flex; gap: .5rem; padding: .85rem 1rem; border-top: 1px solid var(--color-border); }
  .aic-input-row input { flex: 1; min-width: 0; padding: .55rem .7rem; background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: 8px; color: var(--color-text-main); font: inherit; font-size: .88rem; }
  @media (max-width: 760px) {
    .admin-ai-console { padding: 0; }
    .aic-dialog { width: 100%; height: 100%; border-radius: 0; }
  }

  /* ── Desarrollo IA: personalidades + skills ───────────────────────────── */
  .dia-personas { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
  .dia-persona { padding: 1rem; background: rgba(255, 255, 255, .03); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); display: flex; flex-direction: column; gap: .45rem; }
  .dia-persona-badge { align-self: flex-start; font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; padding: .28rem .6rem; border-radius: 999px; border: 1px solid; }
  .dia-persona-badge.is-customer { color: #34d399; background: rgba(52, 211, 153, .1); border-color: rgba(52, 211, 153, .3); }
  .dia-persona-badge.is-admin { color: #93c5fd; background: rgba(59, 130, 246, .1); border-color: rgba(59, 130, 246, .3); }
  .dia-persona-name { margin: .15rem 0 0; font-size: 1rem; color: var(--color-text-main); }
  .dia-persona-desc { margin: 0; font-size: .8rem; color: var(--color-text-dim); line-height: 1.55; flex: 1; }
  .dia-persona-skill { display: block; margin-top: .5rem; padding: .45rem .6rem; background: rgba(0, 0, 0, .25); border: 1px solid var(--color-border); border-radius: 8px; font-size: .72rem; color: var(--color-text-muted); white-space: pre-wrap; word-break: break-word; }

  .skills-list { display: flex; flex-direction: column; gap: .5rem; }
  .skills-items { display: flex; flex-direction: column; gap: .4rem; }
  .skill-chip { display: flex; align-items: flex-start; justify-content: space-between; gap: .6rem; padding: .5rem .65rem; background: rgba(59, 130, 246, .08); border: 1px solid rgba(59, 130, 246, .22); border-radius: 9px; font-size: .78rem; color: var(--color-text-main); line-height: 1.45; }
  .skill-chip button { flex-shrink: 0; background: transparent; border: 0; color: var(--color-text-muted); font-size: .95rem; line-height: 1; cursor: pointer; padding: .1rem .35rem; border-radius: 6px; }
  .skill-chip button:hover { color: #f87171; background: rgba(239, 68, 68, .12); }
  .skills-empty { font-size: .76rem; color: var(--color-text-dim); font-style: italic; padding: .35rem .1rem; }

  /* Conectividad de IA (Desarrollo IA) */
  .tp-ai-connect { display: block; }
  .tp-ai-head { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-bottom: .55rem; }
  .tp-ai-providers { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .55rem; }
  .tp-ai-card { padding: .6rem .7rem; background: rgba(255, 255, 255, .03); border: 1px solid var(--color-border); border-radius: 10px; font-size: .74rem; }
  .tp-ai-card-head { display: flex; align-items: center; justify-content: space-between; gap: .4rem; margin-bottom: .3rem; font-weight: 800; cursor: pointer; }
  .tp-ai-card-head:hover { background: rgba(255, 255, 255, .04); border-radius: 8px; }
  .tp-ai-card-head[aria-expanded="true"] .tp-ai-chevron { transform: rotate(90deg); }
  .tp-ai-chevron { font-size: .65rem; display: inline-flex; align-items: center; justify-content: center; width: 14px; height: 14px; transition: transform .2s ease; flex-shrink: 0; }
  .tp-ai-card-body { padding: .5rem .7rem .7rem; border-top: 1px dashed rgba(148, 163, 184, .18); animation: tpAiSlideDown .22s ease; }
  @keyframes tpAiSlideDown { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
  .tp-ai-badge { padding: .1rem .45rem; border-radius: 999px; font-size: .64rem; font-weight: 800; letter-spacing: .03em; text-transform: uppercase; }
  .tp-ai-badge.is-ok { background: rgba(16, 185, 129, .18); color: #6ee7b7; }
  .tp-ai-badge.is-warn { background: rgba(245, 158, 11, .18); color: #fcd34d; }
  .tp-ai-badge.is-err { background: rgba(239, 68, 68, .18); color: #fca5a5; }
  .tp-ai-card-detail { color: var(--color-text-muted); margin-bottom: .25rem; }
  .tp-ai-free { color: var(--color-text-dim); font-size: .68rem; }
  .tp-ai-usage { margin-top: .25rem; padding-top: .25rem; border-top: 1px dashed rgba(148, 163, 184, .18); color: #93c5fd; font-size: .66rem; word-break: break-all; }
  .tp-ai-keys { display: flex; align-items: flex-end; gap: .55rem; flex-wrap: wrap; margin-top: .75rem; padding-top: .7rem; border-top: 1px dashed rgba(148, 163, 184, .18); }
  .tp-ai-key-field { flex: 1; min-width: 220px; }
  .tp-ai-key-status { font-size: .72rem; color: var(--color-text-muted); }

  /* Tooltip global del panel (mejora los `title` nativos) */
  .admin-tooltip { position: fixed; z-index: 120; max-width: 300px; padding: .45rem .6rem; background: #0b1220; border: 1px solid rgba(96, 165, 250, .35); border-radius: 8px; box-shadow: 0 12px 28px rgba(0, 0, 0, .45); color: #e5e7eb; font-size: .72rem; line-height: 1.4; pointer-events: none; white-space: pre-line; }
  /* El título ocupa una fila entera: actúa como cabecera del div y el resto
     de controles bajan a la línea siguiente. */
  .product-sel-title { flex: 1 0 100%; margin-right: 0; color: #93c5fd; font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .sel-cat-assign {
    padding: .32rem .55rem;
    font-size: .72rem;
    color: var(--color-text-main);
    background: #0b1220;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    min-width: 170px;
    max-width: 100%;
    width: auto;
  }
  .product-sel-bar select,
  .product-sel-group select {
    min-width: 170px;
    max-width: 100%;
    width: auto;
    font-size: .72rem;
    padding: .32rem .55rem;
  }
  :global(.unified-import) { flex-shrink: 0; white-space: nowrap; }
  :global(.unified-import.is-done) { background: rgba(16, 185, 129, .2); border-color: rgba(16, 185, 129, .4); pointer-events: none; }
  :global(.btn-danger-ghost) { display: inline-flex; align-items: center; gap: .35rem; padding: .5rem .8rem; color: #fca5a5; background: transparent; border: 1px solid rgba(239, 68, 68, .3); border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-size: .76rem; font-weight: 700; transition: all .2s ease; }
  :global(.btn-danger-ghost:hover) { background: rgba(239, 68, 68, .12); }

  /* ============ GESTIÓN DE CATEGORÍAS (Tabla Compacta) ============ */
  /* Formulario colapsable */
  .category-form-panel { overflow: hidden; transition: max-height 0.3s ease, opacity 0.2s ease, padding 0.2s ease; }
  .category-form-panel[hidden] { display: none; }
  #categoryFormToggle { transition: background-color 0.15s ease; }
  #categoryFormToggle:hover { background: rgba(255, 255, 255, 0.03); }
  #categoryFormChevron { transition: transform 0.2s ease; }
  .btn-ghost { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.7rem; color: var(--color-text-dim); background: transparent; border: 1px solid transparent; border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-size: 0.7rem; font-weight: 700; transition: all 0.15s ease; }
  .btn-ghost:hover { color: var(--color-text-main); background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1); }
  .btn-ghost.btn-sm { padding: 0.3rem 0.6rem; font-size: 0.68rem; }
  .btn-ghost.btn-xs { padding: 0.2rem 0.45rem; font-size: 0.62rem; }

  /* Tabla de categorías */
  .category-table-wrapper { overflow-x: auto; margin-top: 0.25rem; }
  .category-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
  .category-table thead th {
    padding: 0.6rem 0.75rem;
    text-align: left;
    font-weight: 700;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-dim);
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }
  .category-table tbody tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background-color 0.15s ease;
  }
  .category-table tbody tr:last-child { border-bottom: none; }
  .category-table tbody tr:hover { background: rgba(59, 130, 246, 0.04); }
  .category-table td { padding: 0.55rem 0.75rem; vertical-align: middle; }

  /* Celdas */
  .cat-icon-cell { width: 40px; text-align: center; font-size: 1.1rem; }
  .cat-name-cell { min-width: 200px; }
  .cat-name-wrap { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .cat-name-main { display: flex; align-items: center; gap: 0.4rem; color: var(--color-text-main); font-family: var(--font-heading); font-size: 0.82rem; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cat-hierarchy-indent { color: var(--color-text-muted); font-size: 0.7rem; flex-shrink: 0; }
  .cat-parent-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.08rem 0.4rem;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6ee7b7;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.25);
    border-radius: 999px;
    flex-shrink: 0;
  }
  .cat-slug { color: var(--color-text-dim); font-size: 0.62rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .cat-keywords-cell { max-width: 220px; }
  .cat-kw {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.4rem;
    margin: 0.1rem 0.2rem 0.1rem 0;
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--color-text-dim);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    white-space: nowrap;
  }
  .cat-kw-empty { color: var(--color-text-muted); font-size: 0.62rem; font-style: italic; }

  .cat-count-cell { font-family: var(--font-heading); font-size: 0.8rem; font-weight: 800; color: #93c5fd; }

  .cat-actions-cell { white-space: nowrap; }
  .cat-actions { display: inline-flex; align-items: center; gap: 0.25rem; }
  .cat-actions .btn-ghost { opacity: 0.7; }
  .cat-actions .btn-ghost:hover { opacity: 1; }
  .cat-row:hover .cat-actions .btn-ghost { opacity: 1; }

  /* Subcategorías: indentación visual sutil */
  .cat-row.is-subcategory { background: linear-gradient(90deg, rgba(52, 211, 153, 0.03) 0%, transparent 100%); }
  .cat-row.is-subcategory:hover { background: linear-gradient(90deg, rgba(52, 211, 153, 0.06) 0%, rgba(59, 130, 246, 0.04) 100%); }

  /* Loading / Empty states */
  .loading-row td, .empty-row td { padding: 2rem 1rem; text-align: center; color: var(--color-text-dim); }

  /* Responsive */
  @media (max-width: 900px) {
    .category-table { font-size: 0.72rem; }
    .category-table thead th { padding: 0.5rem 0.5rem; font-size: 0.6rem; }
    .category-table td { padding: 0.45rem 0.5rem; }
    .cat-keywords-cell { max-width: 150px; }
    .cat-kw { padding: 0.1rem 0.3rem; font-size: 0.56rem; }
    .cat-name-main { font-size: 0.76rem; }
    .cat-parent-badge { font-size: 0.54rem; padding: 0.06rem 0.3rem; }
  }

  /* ============ 2. CATÁLOGO ALIEXPRESS (CACHÉ EN VOLÚMEN) ============ */
  /* Barra de acciones bajo #aliFilters: alta en categorías + meta/sync/cargar más */
  .ali-import-actions { display: flex; align-items: center; justify-content: space-between; gap: .75rem; flex-wrap: wrap; margin-bottom: .6rem; padding: .5rem .7rem; background: rgba(16, 185, 129, .05); border: 1px solid rgba(52, 211, 153, .25); border-radius: 10px; }
  .ali-import-tools { display: flex; align-items: center; gap: .55rem; flex-wrap: wrap; }
  .ali-import-tools[hidden] { display: none; }
  .ali-import-title { color: #93c5fd; font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  /* Fila única con el meta del catálogo y los controles de sincronización */
  .ali-f-sync-row { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; padding-bottom: .65rem; margin-bottom: .35rem; border-bottom: 1px dashed rgba(148, 163, 184, .18); }
  .ali-f-sync-row .ali-catalog-meta { font-size: .74rem; color: var(--color-text-dim); }
  /* Acceso rápido (Probar Conexión + Sincronizar Redes + meta), justo debajo
     de #aliCatalogStatus: misma fila, alineados a la derecha. */
  .ali-quick-sync { display: flex; align-items: center; justify-content: flex-end; gap: .6rem; flex-wrap: wrap; margin: .6rem 0; }
  .ali-import-actions .btn-sm { padding: .32rem .6rem; font-size: .68rem; }
  .ali-catalog-head-actions { display: flex; align-items: center; justify-content: flex-end; gap: .75rem; margin-left: auto; flex-wrap: wrap; }
  .ali-catalog-meta { color: var(--color-text-dim); font-size: .72rem; white-space: nowrap; }
  .ali-catalog-meta:empty { display: none; }
  .ali-catalog-danger { display: flex; align-items: center; justify-content: flex-start; gap: .5rem; flex-wrap: wrap; padding-top: .4rem; border-top: 1px dashed rgba(239, 68, 68, .3); width: 100%; }
  .ali-catalog-danger[hidden] { display: none; }
  .ali-catalog-danger .btn-danger { background: #7f1d1d; border-color: #ef4444; color: #fca5a5; }
  .ali-catalog-danger .btn-danger:hover { background: #991b1b; border-color: #f87171; color: #fecaca; }
  :global(.ac-discount) { color: #6ee7b7; font-weight: 700; }
  :global(.ali-import) { flex-shrink: 0; }
  /* Estado «ya en el catálogo»: botón inactivo con texto y color propios */
  :global(.ali-import.is-added) { background: rgba(16, 185, 129, .14); color: #34d399; cursor: not-allowed; box-shadow: none; }
  :global(.ali-import.is-added):hover { background: rgba(16, 185, 129, .14); color: #34d399; transform: none; box-shadow: none; }
  /* ── Contenedor común: Catálogo de Productos Registrados ── */
  .catalog-products-wrap {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .catalog-products-wrap #productSelBar,
  .catalog-products-wrap #prodFilters,
  .catalog-products-wrap .aff-table-wrap,
  .catalog-products-wrap #productsPaginationTop,
  .catalog-products-wrap #productsPagination {
    width: 100%;
    box-sizing: border-box;
  }
  #productsPaginationTop,
  #productsPagination {
    border: none !important;
  }

  /* Paginación: izquierda «Mostrando X–Y de Z» · centro «Por página» + select · derecha botonera integrada */
  :global(.ac-pager) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .6rem;
    flex-wrap: nowrap;
    padding: .5rem .9rem;
    width: 100%;
    box-sizing: border-box;
    font-size: .76rem;
    color: var(--color-text-muted);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }
  :global(.ac-page-info) {
    color: var(--color-text-dim);
    font-size: .74rem;
    white-space: nowrap;
  }
  :global(.ac-page-nav) {
    display: flex;
    align-items: center;
    gap: .15rem;
    flex-wrap: nowrap;
  }
  :global(.ac-page-btn) {
    appearance: none;
    min-width: 1.7rem;
    height: 1.7rem;
    padding: 0 .35rem;
    background: #0b1220;
    border: 1px solid rgba(148, 163, 184, .32);
    border-radius: 6px;
    color: #e5e7eb;
    font: inherit;
    font-size: .7rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  :global(.ac-page-btn:hover:not(:disabled)) { border-color: #60a5fa; }
  :global(.ac-page-btn:disabled) { opacity: .4; cursor: not-allowed; }
  :global(.ac-page-btn.is-current) { background: rgba(96, 165, 250, .2); border-color: #60a5fa; color: #bfdbfe; }
  :global(.ac-page-gap) { align-self: center; padding: 0 .12rem; color: var(--color-text-dim); font-size: .7rem; }
  :global(.ac-per-page) {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    font-size: .76rem;
    color: var(--color-text-dim);
    white-space: nowrap;
  }
  #productsPaginationTop .ac-per-page select,
  #productsPagination .ac-per-page select,
  :global(.ac-per-page select) {
    padding: 0px !important;
    background: #0b1220;
    border: 1px solid rgba(148, 163, 184, .32);
    border-radius: 6px;
    color: #e5e7eb;
    font: inherit;
    font-size: .7rem;
    min-width: 40px;
    max-width: 55px;
    cursor: pointer;
  }
  /* Select «Por página» de las barras de paginación de productos */
  .pagination-per-page { display: inline-flex; align-items: center; gap: .35rem; font-size: .76rem; color: var(--color-text-muted); }
  .pagination-per-page select { padding: .3rem .45rem; background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: 8px; color: var(--color-text-main); font: inherit; font-size: .76rem; }
  .text-right { text-align: right; }

  /* ── Sección «Transparencia y Pipeline» ──────────────────────────────── */
  .tp-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: .6rem; margin-top: 1rem; }
  .tp-metric { display: flex; flex-direction: column; gap: .15rem; padding: .7rem .8rem; background: rgba(255, 255, 255, .03); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); }
  .tp-metric-value { color: var(--color-text-main); font-size: 1.5rem; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .tp-metric-value.is-small { font-size: .78rem; font-weight: 700; }
  .tp-metric-value.is-ok { color: #6ee7b7; }
  .tp-metric-value.is-warn { color: #fca5a5; }
  .tp-metric-label { color: var(--color-text-dim); font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .tp-reasons { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-top: .9rem; }
  .tp-reasons[hidden] { display: none; }
  .tp-reasons-title { color: var(--color-text-dim); font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .tp-reasons-list { display: flex; gap: .35rem; flex-wrap: wrap; }
  .tp-reason-chip { display: inline-flex; align-items: center; gap: .3rem; padding: .22rem .55rem; color: #bae6fd; background: rgba(56, 189, 248, .1); border: 1px solid rgba(56, 189, 248, .28); border-radius: 999px; font-size: .68rem; font-weight: 600; }
  .tp-reason-chip strong { color: #e0f2fe; font-weight: 800; }
  .tp-options { margin-top: .9rem; }
  .tp-run-options { display: flex; align-items: flex-end; gap: .8rem; flex-wrap: wrap; }
  .tp-provider { display: flex; flex-direction: column; gap: .25rem; }
  .tp-provider-label { color: var(--color-text-dim); font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .tp-provider select { width: auto; min-width: 230px; padding: .45rem .6rem; font-size: .78rem; }
  .tp-provider input { width: auto; min-width: 230px; padding: .45rem .6rem; font-size: .78rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font-family: inherit; outline: none; }
  .tp-progress { margin-top: .9rem; }
  .tp-progress[hidden] { display: none; }
  .tp-progress-bar { height: 6px; border-radius: 999px; background: rgba(255, 255, 255, .07); overflow: hidden; }
  .tp-progress-fill { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, #38bdf8, #6ee7b7); transition: width .3s ease; }
  .tp-progress-text { margin: .45rem 0 0; color: var(--color-text-dim); font-size: .72rem; }
  .tp-progress-text.is-error { color: #fca5a5; }
  .tp-progress-text.is-ok { color: #6ee7b7; }
  .tp-results { margin-top: .9rem; max-height: 22rem; overflow: auto; border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); }
  .tp-results[hidden] { display: none; }
  .tp-table { width: 100%; border-collapse: collapse; font-size: .72rem; }
  .tp-table th { position: sticky; top: 0; padding: .45rem .6rem; text-align: left; font-size: .6rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: var(--color-text-muted); background: #121826; border-bottom: 1px solid var(--color-border); }
  .tp-table td { padding: .4rem .6rem; color: var(--color-text-main); border-bottom: 1px solid rgba(255, 255, 255, .05); vertical-align: middle; }
  .tp-badge { display: inline-block; padding: .1rem .45rem; border-radius: 999px; font-size: .62rem; font-weight: 800; text-transform: lowercase; }
  .tp-badge.is-approved { color: #6ee7b7; background: rgba(16, 185, 129, .12); border: 1px solid rgba(16, 185, 129, .3); }
  .tp-badge.is-rejected { color: #fca5a5; background: rgba(239, 68, 68, .1); border: 1px solid rgba(239, 68, 68, .3); }
  .tp-badge.is-pending { color: #fcd34d; background: rgba(245, 158, 11, .1); border: 1px solid rgba(245, 158, 11, .3); }
  .tp-badge.is-duplicado { color: #c4b5fd; background: rgba(139, 92, 246, .12); border: 1px solid rgba(139, 92, 246, .3); }

  /* Visibilidad de secciones: el display base lo marca .is-visible únicamente, así las secciones ocultas nunca aparecen (el scoping de Astro sube la especificidad de las clases base con atributos) */
  .admin-grid-section,
  .admin-dashboard-view,
  .products-list-card { display: none !important; }
  .admin-grid-section.is-visible { display: grid !important; }
  .admin-dashboard-view.is-visible { display: flex !important; }
  .products-list-card.is-visible { display: flex !important; }

  /* Fallback explícito para la sección de afiliados por si el scoping falla */
  section[data-admin-view="affiliates"].is-visible { display: flex !important; }
  section[data-admin-view="categories"].is-visible { display: flex !important; }
  section[data-admin-view="analytics"].is-visible { display: flex !important; }
  section[data-admin-view="marketing"].is-visible { display: flex !important; }
  section[data-admin-view="transparency"].is-visible { display: flex !important; }
  section[data-admin-view="desarrollo-ia"].is-visible { display: flex !important; }

  @media (max-width: 900px) {
    .category-form { flex-direction: column; }
  }

  .admin-login-page { min-height: calc(100vh - 9rem); max-width: var(--max-width); margin: 0 auto; padding: 4rem 1.25rem 5rem; display: grid; grid-template-columns: minmax(0, 500px) minmax(240px, 1fr); align-items: center; gap: clamp(3rem, 10vw, 9rem); }
  .admin-login-panel { padding: clamp(2rem, 5vw, 3.5rem); background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); box-shadow: 0 24px 70px rgba(0, 0, 0, .24); }
  .admin-login-mark { display: inline-flex; align-items: center; gap: .6rem; color: #60a5fa; font-size: .72rem; font-weight: 800; letter-spacing: .12em; }
  .admin-login-kicker { margin: 15px 0 .75rem; color: var(--color-text-dim); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .admin-login-title { color: var(--color-text-main); font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.05; margin: 0; }
  .admin-login-description { max-width: 390px; margin: 1.25rem 0 2.25rem; color: var(--color-text-muted); line-height: 1.65; }
  .admin-login-form { display: grid; gap: 1.15rem; }
  .login-field { display: grid; gap: .5rem; color: var(--color-text-main); font-size: .8rem; font-weight: 700; }
  .login-field input { width: 100%; box-sizing: border-box; padding: .9rem 1rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; outline: none; }
  .login-field input:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, .14); }
  .admin-login-submit { display: inline-flex; align-items: center; justify-content: center; gap: .7rem; width: 100%; margin-top: .65rem; padding: .95rem 1.25rem; color: #07111f; background: #38bdf8; border: 0; border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-weight: 800; transition: background .15s ease, opacity .15s ease; }
  .admin-login-submit:hover { background: #7dd3fc; }
  .admin-login-submit.is-loading { opacity: .85; cursor: wait; pointer-events: none; }
  .login-btn-spinner { display: inline-block; width: 15px; height: 15px; border: 2.5px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: adminSpin .6s linear infinite; flex-shrink: 0; }
  @keyframes adminSpin { to { transform: rotate(360deg); } }
  .admin-login-error { margin: 0 0 1.25rem; padding: .8rem 1rem; color: #fecaca; background: rgba(239, 68, 68, .1); border: 1px solid rgba(239, 68, 68, .3); border-radius: var(--border-radius-sm); font-size: .85rem; }
  .admin-login-footer { display: flex; align-items: center; gap: .5rem; margin: 2rem 0 0; color: var(--color-text-dim); font-size: .75rem; }
  .admin-login-aside { display: flex; flex-direction: column; gap: 1.5rem; color: var(--color-text-main); }
  .aside-index { color: var(--color-text-dim); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .admin-login-aside strong { font-family: var(--font-heading); font-size: clamp(3rem, 7vw, 6.5rem); line-height: .92; letter-spacing: -.04em; }
  .aside-line { width: min(100%, 280px); height: 1px; background: linear-gradient(90deg, #38bdf8, transparent); }
  @media (max-width: 760px) { .admin-login-page { min-height: auto; padding-top: 2rem; grid-template-columns: 1fr; gap: 2.5rem; } .admin-login-aside { display: none; } }

  /* ==========================================================================
     ADMIN PANEL - ESTILOS PREMIUM (SISTEMA DE DISEÑO TRADYLOR)
