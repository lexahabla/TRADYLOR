    // ── Vinculación de alternativas (cross-matching bidireccional) ───────────
    const linkAlternativesModal = document.getElementById('linkAlternativesModal');
    const linkAltLinked = document.getElementById('linkAltLinked');
    const linkAltSuggestions = document.getElementById('linkAltSuggestions');
    const linkAltSearch = document.getElementById('linkAltSearch');
    const linkAltStatus = document.getElementById('linkAltStatus');
    let linkAltProductId = null;
    let linkAltLinkedIds = new Set();
    let linkAltCatalog = [];
    /**
     * Selección de los 3 roles. La económica y el competidor admiten VARIOS ids
     * (los selects son `multiple`); el campo premium sigue siendo único.
     * El servidor los rellena automáticamente si el producto no tenía nada.
     */
    const LINK_ALT_ROLES_EMPTY = { premiumOptionId: '', cheaperOptionIds: [], similarOptionIds: [] };
    let linkAltRoles = { ...LINK_ALT_ROLES_EMPTY };

    function linkAltRoleSelected(roleKey) {
      const value = linkAltRoles[roleKey];
      if (Array.isArray(value)) return value.filter(Boolean);
      return value ? [value] : [];
    }

    function linkAltRenderRoles() {
      const byId = new Map(linkAltCatalog.map((p) => [p.id, p]));
      // Cualquier id vinculado (aunque no esté en la muestra) debe poder elegirse.
      for (const id of linkAltLinkedIds) {
        if (!byId.has(id)) byId.set(id, { id, title: id, price: 0, image: '' });
      }
      const optionsFor = Array.from(linkAltLinkedIds)
        .map((id) => byId.get(id))
        .filter(Boolean);

      for (const [selectId, roleKey] of [
        ['linkAltRolePremium', 'premiumOptionId'],
        ['linkAltRoleCheap', 'cheaperOptionIds'],
        ['linkAltRoleSimilar', 'similarOptionIds'],
      ]) {
        const select = document.getElementById(selectId);
        if (!select) continue;
        // En los selects múltiples no hay «— Ninguna —»: sin selección = rol vacío.
        const placeholder = select.multiple ? '' : '<option value="">— Ninguna —</option>';
        select.innerHTML = placeholder + optionsFor
          .map((p) => `<option value="${escapeHtml(p.id)}">${escapeHtml(p.title).slice(0, 60)}</option>`)
          .join('');
        const selected = new Set(linkAltRoleSelected(roleKey));
        if (select.multiple) {
          for (const option of select.options) option.selected = selected.has(option.value);
        } else {
          const first = [...selected][0] || '';
          select.value = Array.from(select.options).some((o) => o.value === first) ? first : '';
        }
      }
    }

    function linkAltRenderList() {
      if (!linkAltLinked || !linkAltSuggestions) return;
      const q = String(linkAltSearch?.value || '').trim().toLowerCase();
      const matches = (p) => !q || `${p.title} ${p.category || ''} ${p.id}`.toLowerCase().includes(q);
      const byId = new Map(linkAltCatalog.map((p) => [p.id, p]));

      linkAltLinked.innerHTML = linkAltLinkedIds.size
        ? Array.from(linkAltLinkedIds).map((id) => byId.get(id)).filter(Boolean).map((p) => `
            <label class="link-alt-item is-linked">
              <input type="checkbox" checked data-link-alt-check="${escapeHtml(p.id)}" />
              <img src="${escapeHtml(p.image || '')}" alt="" loading="lazy" />
              <span class="link-alt-item-title">${escapeHtml(p.title).slice(0, 70)}</span>
              <span class="link-alt-item-price">${Number(p.price || 0).toFixed(2)} €</span>
            </label>`).join('')
        : '<p class="text-muted">Sin alternativas vinculadas todavía.</p>';

      const suggestions = linkAltCatalog.filter((p) => !linkAltLinkedIds.has(p.id) && matches(p));
      document.getElementById('linkAltCount').textContent = `(${suggestions.length})`;
      linkAltSuggestions.innerHTML = suggestions.length
        ? suggestions.map((p) => `
            <label class="link-alt-item">
              <input type="checkbox" data-link-alt-check="${escapeHtml(p.id)}" />
              <img src="${escapeHtml(p.image || '')}" alt="" loading="lazy" />
              <span class="link-alt-item-title">${escapeHtml(p.title).slice(0, 70)}</span>
              <span class="link-alt-item-price">${Number(p.price || 0).toFixed(2)} €</span>
            </label>`).join('')
        : '<p class="text-muted">Sin coincidencias.</p>';

      linkAltRenderRoles();
    }

    document.addEventListener('change', (event) => {
      const checkbox = event.target.closest?.('[data-link-alt-check]');
      if (!checkbox) return;
      const id = checkbox.getAttribute('data-link-alt-check');
      if (!id) return;
      if (checkbox.checked) linkAltLinkedIds.add(id);
      else {
        linkAltLinkedIds.delete(id);
        // Si se desvincula un producto ya no puede seguir en ningún rol.
        if (linkAltRoles.premiumOptionId === id) linkAltRoles.premiumOptionId = '';
        linkAltRoles.cheaperOptionIds = linkAltRoles.cheaperOptionIds.filter((v) => v !== id);
        linkAltRoles.similarOptionIds = linkAltRoles.similarOptionIds.filter((v) => v !== id);
      }
      linkAltRenderList();
    });

    // Cambio manual de un rol (único o múltiple): se guarda en el estado local.
    document.addEventListener('change', (event) => {
      const select = event.target.closest?.('.link-alt-role-select');
      if (!select) return;
      if (select.id === 'linkAltRolePremium') {
        linkAltRoles.premiumOptionId = select.value || '';
      } else if (select.id === 'linkAltRoleCheap') {
        linkAltRoles.cheaperOptionIds = Array.from(select.selectedOptions || []).map((o) => o.value).filter(Boolean);
      } else if (select.id === 'linkAltRoleSimilar') {
        linkAltRoles.similarOptionIds = Array.from(select.selectedOptions || []).map((o) => o.value).filter(Boolean);
      }
    });
    linkAltSearch?.addEventListener('input', linkAltRenderList);

    document.addEventListener('click', (event) => {
      const btn = event.target.closest?.('.btn-link-alternatives');
      if (!btn) return;
      event.preventDefault();
      event.stopPropagation();
      openLinkAlternativesModal(btn.getAttribute('data-id'));
    });

    async function openLinkAlternativesModal(id) {
      if (!id) return;
      linkAltProductId = id;
      linkAltLinkedIds = new Set();
      linkAltRoles = { ...LINK_ALT_ROLES_EMPTY };
      if (linkAltStatus) { linkAltStatus.hidden = true; }
      if (linkAltSearch) linkAltSearch.value = '';
      const nameEl = document.getElementById('linkAltProductName');
      if (nameEl) nameEl.textContent = '';
      openAdminModal(linkAlternativesModal);
      try {
        const res = await fetch(`/api/admin/alternatives?id=${encodeURIComponent(id)}`, { cache: 'no-store' });
        const data = await res.json();
        if (!data.success) {
          if (linkAltSuggestions) linkAltSuggestions.innerHTML = `<p class="text-muted">${escapeHtml(data.message || 'Error cargando alternativas.')}</p>`;
          return;
        }
        if (nameEl) nameEl.textContent = data.product?.title || id;
        linkAltLinkedIds = new Set([
          ...(data.product?.alternative_product_ids || []),
          ...(data.linked || []).map((p) => p.id),
        ]);
        // Catálogo para el modal: sugerencias primero, después el resto de productos.
        const suggestedIds = new Set((data.suggestions || []).map((s) => s.id));
        linkAltCatalog = [
          ...(data.suggestions || []),
          ...(currentProducts || []).filter((p) => !suggestedIds.has(p.id)).map((p) => ({
            id: p.id, title: p.title, price: p.price, image: p.image, category: p.category,
          })),
        ];
        // Selección de roles: primero la del servidor (con los arrays), después
        // la que traiga el producto (formato legado singular).
        const serverRoles = data.roles || {};
        const alts = data.product?.alternatives || {};
        // Prioridad: lo que devuelve el servidor (arrays) → arrays guardados en
        // el producto → valor legado singular (un único id).
        const listOf = (serverArray, arrayField, singularField) => {
          if (Array.isArray(serverArray) && serverArray.length) return serverArray.filter(Boolean);
          const stored = Array.isArray(alts[arrayField]) ? alts[arrayField].filter(Boolean) : [];
          if (stored.length) return stored;
          return alts[singularField] ? [alts[singularField]] : [];
        };
        linkAltRoles = {
          premiumOptionId: serverRoles.premiumOptionId || alts.premiumOptionId || '',
          cheaperOptionIds: listOf(serverRoles.cheaperOptionIds, 'cheaperOptionIds', 'cheaperOptionId'),
          similarOptionIds: listOf(serverRoles.similarOptionIds, 'similarOptionIds', 'similarOptionId'),
        };
        // Los roles se re-pintan en linkAltRenderList.
        linkAltRenderList();
        // El servidor rellena sólo cuando faltaba selección: se avisa para que
        // se revise antes de confirmar.
        if (serverRoles.auto && linkAltStatus) {
          linkAltStatus.hidden = false;
          linkAltStatus.className = 'admin-modal-status is-ok';
          linkAltStatus.textContent = 'Selección automática aplicada (vínculos y roles ya guardados): revisa, ajusta lo que quieras y pulsa «Guardar vínculos» para confirmar.';
        }
      } catch {
        if (linkAltSuggestions) linkAltSuggestions.innerHTML = '<p class="text-muted">Error de red cargando el catálogo.</p>';
      }
    }

    document.getElementById('btnLinkAltSave')?.addEventListener('click', async () => {
      if (!linkAltProductId) return;
      const ids = Array.from(linkAltLinkedIds);
      const roleSingle = (selectId) => document.getElementById(selectId)?.value || null;
      const roleMulti = (selectId) =>
        Array.from(document.getElementById(selectId)?.selectedOptions || [])
          .map((option) => option.value)
          .filter(Boolean);
      try {
        const res = await fetch('/api/admin/alternatives', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: linkAltProductId,
            alternativeProductIds: ids,
            premiumOptionId: roleSingle('linkAltRolePremium'),
            cheaperOptionIds: roleMulti('linkAltRoleCheap'),
            similarOptionIds: roleMulti('linkAltRoleSimilar'),
          }),
        });
        const data = await res.json();
        if (data.success) {
          if (linkAltStatus) { linkAltStatus.hidden = false; linkAltStatus.className = 'admin-modal-status is-ok'; linkAltStatus.textContent = data.message || 'Vínculos guardados.'; }
          await reloadProductsTable();
          setTimeout(() => closeAdminModal(linkAlternativesModal), 600);
        } else {
          if (linkAltStatus) { linkAltStatus.hidden = false; linkAltStatus.className = 'admin-modal-status is-error'; linkAltStatus.textContent = data.message || 'No se pudieron guardar los vínculos.'; }
        }
      } catch {
        if (linkAltStatus) { linkAltStatus.hidden = false; linkAltStatus.className = 'admin-modal-status is-error'; linkAltStatus.textContent = 'Error de red al guardar.'; }
      }
    });

    loadCategories();

    // =========================================================================
    // TRANSPARENCIA Y PIPELINE (métricas de auditoría + reproceso)
    // =========================================================================
    const tpApproved = document.getElementById('tpApproved');
    const tpRejected = document.getElementById('tpRejected');
    const tpPending = document.getElementById('tpPending');
    const tpScore = document.getElementById('tpScore');
    const tpDupes = document.getElementById('tpDupes');
    const tpLastRun = document.getElementById('tpLastRun');
    const tpReasons = document.getElementById('tpReasons');
    const tpReasonsList = document.getElementById('tpReasonsList');
    const tpResults = document.getElementById('tpResults');
    const tpResultsBody = document.getElementById('tpResultsBody');
    const tpStatus = document.getElementById('tpStatus');
    const tpStatusIcon = document.getElementById('tpStatusIcon');
    const tpStatusTitle = document.getElementById('tpStatusTitle');
    const tpStatusText = document.getElementById('tpStatusText');
    const tpEnrich = document.getElementById('tpEnrich');
    const tpProvider = document.getElementById('tpProvider');
    const tpModel = document.getElementById('tpModel');
    const tpAiEnriched = document.getElementById('tpAiEnriched');
    const tpAiFailed = document.getElementById('tpAiFailed');
    const tpProgress = document.getElementById('tpProgress');
    const tpProgressFill = document.getElementById('tpProgressFill');
    const tpProgressText = document.getElementById('tpProgressText');
    const btnPipelineRefresh = document.getElementById('btnPipelineRefresh');
    const btnPipelineDryRun = document.getElementById('btnPipelineDryRun');
    const btnPipelineRun = document.getElementById('btnPipelineRun');
    const btnPipelineStop = document.getElementById('btnPipelineStop');
    const btnDedupeScan = document.getElementById('btnDedupeScan');
    const btnDedupePurge = document.getElementById('btnDedupePurge');
    const tpDupGroups = document.getElementById('tpDupGroups');

    const TP_REASON_LABELS = {
      'rating-insuficiente': 'Valoración insuficiente',
      'pocas-resenas': 'Pocas reseñas',
      'sin-descuento-verificado': 'Sin descuento verificado',
      'precio-por-encima-del-historico': 'Precio por encima del histórico',
      'vendedor-no-verificado': 'Vendedor no verificado',
      'sin-datos-suficientes': 'Sin datos suficientes',
    };

    function tpShowStatus(kind, title, text) {
      if (!tpStatus) return;
      tpStatus.hidden = false;
      tpStatusIcon.textContent = kind === 'ok' ? '✅' : kind === 'error' ? '⚠️' : 'ℹ️';
      tpStatusTitle.textContent = title;
      tpStatusText.textContent = text;
    }

    function tpFormatDate(value) {
      if (!value) return 'Nunca';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value);
      return date.toLocaleString('es-ES', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
    }

    async function tpLoadMetrics() {
      try {
        const res = await fetch('/api/admin/pipeline', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'No se pudieron leer las métricas.');
        if (tpApproved) tpApproved.textContent = data.approved ?? 0;
        if (tpRejected) tpRejected.textContent = data.rejected ?? 0;
        if (tpPending) tpPending.textContent = data.pending ?? 0;
        if (tpScore) tpScore.textContent = data.avg_audit_score ?? 0;
        if (tpDupes) tpDupes.textContent = data.duplicates_discarded ?? 0;
        if (tpDupGroups) tpDupGroups.textContent = data.duplicate_products ?? 0;
        if (tpAiEnriched) tpAiEnriched.textContent = data.ai_enriched ?? 0;
        if (tpAiFailed) tpAiFailed.textContent = data.ai_failed ?? 0;
        if (tpLastRun) tpLastRun.textContent = tpFormatDate(data.last_run);
        tpRenderJob(data.job);
        if (data.job && data.job.status === 'running') tpSchedulePoll();
        const reasons = data.by_reason || {};
        const entries = Object.entries(reasons);
        if (tpReasons && tpReasonsList) {
          tpReasons.hidden = entries.length === 0;
          tpReasonsList.innerHTML = entries
            .sort((a, b) => b[1] - a[1])
            .map(([reason, count]) => `<span class="tp-reason-chip"><strong>${escapeHtml(count)}</strong> ${escapeHtml(TP_REASON_LABELS[reason] || reason)}</span>`)
            .join('');
        }
      } catch (err) {
        tpShowStatus('error', 'Error al leer las métricas', err?.message || 'Fallo de red.');
      }
    }

    async function tpRunPipeline(dryRun) {
      const btn = dryRun ? btnPipelineDryRun : btnPipelineRun;
      const spinner = btn ? btn.querySelector('.btn-spinner') : null;
      const text = btn ? btn.querySelector('.btn-text') : null;
      const original = text ? text.textContent : '';
      if (btn) btn.disabled = true;
      if (spinner) spinner.hidden = false;
      if (text) text.textContent = 'Lanzando…';
      try {
        // El reproceso va en SEGUNDO PLANO: reprocesar el catálogo entero con
        // IA tarda minutos y dentro de la petición HTTP el proxy la cortaba
        // a mitad (el trabajo se perdía). El avance se consulta con GET.
        const provider = tpProvider ? String(tpProvider.value || '').trim().toLowerCase() : '';
        const model = tpModel ? String(tpModel.value || '').trim() : '';
        const res = await fetch('/api/admin/pipeline', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: 'reprocess',
            scope: 'all',
            confirm: true,
            dryRun: dryRun === true,
            enrich: tpEnrich ? tpEnrich.checked : false,
            provider: provider || undefined,
            model: model || undefined,
            background: true,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'El pipeline no pudo ejecutarse.');
        tpShowStatus(
          'info',
          dryRun ? 'Simulación en marcha' : 'Reproceso en marcha',
          data.message || 'El proceso continúa en segundo plano; el avance se actualiza solo.'
        );
        tpRenderJob(data.job);
        tpSchedulePoll();
      } catch (err) {
        tpShowStatus('error', 'Error al ejecutar el pipeline', err?.message || 'Fallo de red.');
      } finally {
        if (btn) btn.disabled = false;
        if (spinner) spinner.hidden = true;
        if (text) text.textContent = original;
      }
    }

    // ── Tabla de resultados (síncrona o del job en segundo plano) ───────────
    function tpRenderRows(rows) {
      if (!tpResultsBody) return;
      tpResultsBody.innerHTML = rows
        .map((row) => {
          const status = row.audit_status || (row.duplicate ? 'duplicado' : '—');
          const reasons = Array.isArray(row.audit_reasons) ? row.audit_reasons : [];
          const reasonText = reasons.map((code) => TP_REASON_LABELS[code] || code).join(' · ');
          const aiError = row.ai_error ? String(row.ai_error).slice(0, 120) : '';
          const reason = row.duplicate_reason
            ? `Duplicado (${row.duplicate_reason})`
            : (aiError || reasonText || row.message || '');
          const aiBadge = row.ai_enriched === true
            ? '<span class="tp-badge is-approved">sí</span>'
            : (row.ai_enriched === false ? '<span class="tp-badge is-rejected">no</span>' : '—');
          return `<tr>
            <td>${escapeHtml(row.title || row.id || '—')}</td>
            <td><span class="tp-badge is-${escapeHtml(status)}">${escapeHtml(status)}</span></td>
            <td class="text-right">${row.audit_score != null ? escapeHtml(row.audit_score) : '—'}</td>
            <td class="text-center">${aiBadge}</td>
            <td>${escapeHtml(reason)}</td>
          </tr>`;
        })
        .join('');
      if (tpResults) tpResults.hidden = rows.length === 0;
    }

    // ── Avance del job en segundo plano ─────────────────────────────────────
    let tpPollTimer = null;

    function tpRenderJob(job) {
      if (btnPipelineStop) btnPipelineStop.hidden = !(job && job.status === 'running');
      if (!tpProgress) return;
      if (!job || !job.id) {
        tpProgress.hidden = true;
        return;
      }
      tpProgress.hidden = false;
      const total = Number(job.total) || 0;
      const processed = Number(job.processed) || 0;
      const pct = total ? Math.min(100, Math.round((processed / total) * 100)) : 0;
      if (tpProgressFill) tpProgressFill.style.width = pct + '%';
      if (tpProgressText) {
        const bits = [`${processed}/${total} (${pct}%)`];
        if (job.currentTitle) bits.push(`en curso: ${job.currentTitle}`);
        if (job.aiFailed) bits.push(`${job.aiFailed} sin IA`);
        if (job.failed) bits.push(`${job.failed} con error`);
        if (job.provider) bits.push(`proveedor: ${job.provider}`);
        if (job.model) bits.push(`modelo: ${job.model}`);
        tpProgressText.textContent = `${job.message || ''} ${bits.join(' · ')}`.trim();
        tpProgressText.className = 'tp-progress-text'
          + (job.status === 'error' ? ' is-error' : job.status === 'done' ? ' is-ok' : '');
      }
      const recent = Array.isArray(job.recent) ? job.recent : [];
      if (recent.length) tpRenderRows(recent);
    }

    function tpSchedulePoll() {
      if (tpPollTimer) return;
      tpPollTimer = setInterval(async () => {
        try {
          const res = await fetch('/api/admin/pipeline', { headers: { Accept: 'application/json' }, cache: 'no-store' });
          const data = await res.json();
          if (!res.ok || !data.success) return;
          const job = data.job || null;
          tpRenderJob(job);
          if (!job || job.status !== 'running') {
            clearInterval(tpPollTimer);
            tpPollTimer = null;
            await tpLoadMetrics();
            await reloadProductsTable();
            tpShowStatus('ok', 'Reproceso terminado', job && job.message ? job.message : 'El proceso ha terminado.');
          }
        } catch {
          // Fallo de red al consultar el avance: se reintenta en el siguiente tick.
        }
      }, 3000);
    }

    async function tpStopPipeline() {
      if (!btnPipelineStop) return;
      btnPipelineStop.disabled = true;
      try {
        const res = await fetch('/api/admin/pipeline', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: 'cancel' }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'No se pudo detener el reproceso.');
        tpShowStatus('info', 'Deteniendo', data.message || 'El reproceso se detendrá tras el producto en curso.');
        tpRenderJob(data.job);
      } catch (err) {
        tpShowStatus('error', 'Error al detener el reproceso', err?.message || 'Fallo de red.');
      } finally {
        btnPipelineStop.disabled = false;
      }
    }

    btnPipelineRefresh?.addEventListener('click', () => tpLoadMetrics());
    btnPipelineDryRun?.addEventListener('click', () => tpRunPipeline(true));
    btnPipelineStop?.addEventListener('click', () => tpStopPipeline());
    btnPipelineRun?.addEventListener('click', () => {
      const provider = tpProvider ? String(tpProvider.value || '').trim() : '';
      const model = tpModel ? String(tpModel.value || '').trim() : '';
      const enrich = !!(tpEnrich && tpEnrich.checked);
      const detalle = enrich
        ? ` (con enriquecimiento de IA; proveedor: ${provider || 'automático'}${model ? `, modelo: ${model}` : ''})`
        : ' (sin enriquecimiento de IA)';
      const ok = window.confirm(
        `Se reprocesará todo el catálogo (auditoría, tags y score)${detalle}. ` +
        'La tarea sigue en segundo plano aunque cierres esta pestaña. ¿Continuar?'
      );
      if (ok) tpRunPipeline(false);
    });

    // ── Purgado de duplicados ────────────────────────────────────────────────
    async function tpRunDedupe(purge) {
      const btn = purge ? btnDedupePurge : btnDedupeScan;
      const spinner = btn ? btn.querySelector('.btn-spinner') : null;
      const text = btn ? btn.querySelector('.btn-text') : null;
      const original = text ? text.textContent : '';
      if (btn) btn.disabled = true;
      if (spinner) spinner.hidden = false;
      if (text) text.textContent = purge ? 'Purgando…' : 'Buscando…';
      try {
        const res = await fetch('/api/admin/pipeline', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: 'dedupe', dryRun: !purge }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'No se pudo ejecutar la purga.');
        tpShowStatus(
          purge ? 'ok' : 'info',
          purge ? 'Duplicados purgados' : 'Duplicados detectados',
          `${data.removed ?? 0} producto(s) duplicado(s) en ${data.groups ?? 0} grupo(s). ${data.total ?? 0} productos en el catálogo, quedan ${data.remaining ?? 0}.`,
        );
        await tpLoadMetrics();
        if (purge) await reloadProductsTable();
      } catch (err) {
        tpShowStatus('error', 'Error en la purga de duplicados', err?.message || 'Fallo de red.');
      } finally {
        if (btn) btn.disabled = false;
        if (spinner) spinner.hidden = true;
        if (text) text.textContent = original;
      }
    }

    btnDedupeScan?.addEventListener('click', () => tpRunDedupe(false));
    btnDedupePurge?.addEventListener('click', () => {
      const ok = window.confirm('Se eliminarán del catálogo los productos duplicados (se conserva la ficha más completa de cada grupo y se deja tombstone para que no vuelvan). ¿Continuar?');
      if (ok) tpRunDedupe(true);
    });

    if (btnPipelineRefresh) tpLoadMetrics();

    // ── Transparencia › Conectividad de IA: estado, claves y consola ─────────
    const AI_PROVIDER_NAMES = {
      opencode: 'OpenCode (local)',
      openai: 'OpenAI',
      nvidia: 'NVIDIA (NIM)',
      openrouter: 'OpenRouter',
      anthropic: 'Anthropic',
      groq: 'Groq',
      gemini: 'Google Gemini',
    };

    const tpAiProviders = document.getElementById('tpAiProviders');
    const btnAiStatusRefresh = document.getElementById('btnAiStatusRefresh');

    function aiBadgeClass(status) {
      if (status === 'connected') return 'is-ok';
      if (status === 'no-key' || status === 'unavailable' || status === 'unknown') return 'is-warn';
      return 'is-err';
    }

    function aiBadgeLabel(status) {
      if (status === 'connected') return 'Conectado';
      if (status === 'no-key') return 'Sin clave';
      if (status === 'unknown') return 'Sin probar';
      if (status === 'unavailable') return 'No disponible';
      return 'Error';
    }

    function renderAiProviders(providers) {
      if (!tpAiProviders) return;
      if (!Array.isArray(providers) || !providers.length) {
        tpAiProviders.innerHTML = '<div class="loading-panel">Sin datos de proveedores.</div>';
        return;
      }
      tpAiProviders.innerHTML = providers.map((p) => {
        const free = (p.freeModels || []).length
          ? `<div class="tp-ai-free">Gratuitos: ${(p.freeModels || []).join(' · ')}</div>`
          : '<div class="tp-ai-free">Sin modelos gratuitos.</div>';
        const key = p.keyMasked
          ? `<div class="tp-ai-free">Clave: ${p.keyMasked} (${p.keySource === 'env' ? 'entorno' : 'panel'})</div>`
          : '';
        const usage = p.usage && Object.keys(p.usage).length
          ? `<div class="tp-ai-usage">Cuota / uso: ${Object.entries(p.usage).map((e) => `${e[0]}=${e[1]}`).join(' · ')}</div>`
          : '';
        const note = p.pricingNote ? `<div class="tp-ai-free">${p.pricingNote}</div>` : '';
        const docs = p.docsUrl ? `<div class="tp-ai-free"><a href="${p.docsUrl}" target="_blank" rel="noopener noreferrer">Documentación ↗</a></div>` : '';
        return `<div class="tp-ai-card">
          <div class="tp-ai-card-head" role="button" tabindex="0" aria-expanded="false" aria-controls="ai-detail-${p.id}" title="Desplegar detalles de ${p.name || p.id}">
            <span>${p.name || p.id}</span>
            <span class="tp-ai-badge ${aiBadgeClass(p.status)}">${aiBadgeLabel(p.status)}</span>
            <span class="tp-ai-chevron" aria-hidden="true">▸</span>
          </div>
          <div id="ai-detail-${p.id}" class="tp-ai-card-body" hidden>
            <div class="tp-ai-card-detail">${p.detail || ''}</div>
            ${key}${free}${note}${docs}${usage}
          </div>
        </div>`;
      }).join('');

      // Acordeón: desplegar/ocultar el cuerpo de cada tarjeta de proveedor de IA.
      tpAiProviders.querySelectorAll('.tp-ai-card-head').forEach((head) => {
        const targetId = head.getAttribute('aria-controls');
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;
        const chevron = head.querySelector('.tp-ai-chevron');
        const toggle = () => {
          const open = !target.hidden;
          target.hidden = open;
          head.setAttribute('aria-expanded', String(!open));
          if (chevron) chevron.textContent = open ? '▸' : '▾';
        };
        head.addEventListener('click', toggle);
        head.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
      });
    }

    async function tpLoadAiStatus(live) {
      if (!tpAiProviders) return;
      const btn = btnAiStatusRefresh;
      const spinner = btn ? btn.querySelector('.btn-spinner') : null;
      const text = btn ? btn.querySelector('.btn-text') : null;
      const original = text ? text.textContent : '';
      if (btn) btn.disabled = true;
      if (spinner) spinner.hidden = false;
      if (text) text.textContent = 'Comprobando…';
      if (live) tpAiProviders.innerHTML = '<div class="loading-panel">Comprobando la conexión real con cada proveedor…</div>';
      try {
        // live=false → estado local instantáneo (sin red); live=true → test real.
        const res = await fetch(live ? '/api/admin/ai-status' : '/api/admin/ai-keys', { cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'No se pudo obtener el estado de la IA.');
        renderAiProviders(data.providers);
      } catch (err) {
        tpAiProviders.innerHTML = `<div class="loading-panel">No se pudo cargar el estado: ${(err && err.message) || 'error de red'}.</div>`;
      } finally {
        if (btn) btn.disabled = false;
        if (spinner) spinner.hidden = true;
        if (text) text.textContent = original;
      }
    }

    btnAiStatusRefresh?.addEventListener('click', () => tpLoadAiStatus(true));

    // ── API keys del panel (probar / guardar / borrar) ───────────────────────
    const aiKeyProvider = document.getElementById('aiKeyProvider');
    const aiKeyValue = document.getElementById('aiKeyValue');
    const aiKeyStatus = document.getElementById('aiKeyStatus');

    function setAiKeyStatus(kind, message) {
      if (!aiKeyStatus) return;
      aiKeyStatus.textContent = message || '';
      aiKeyStatus.style.color = kind === 'ok' ? '#6ee7b7' : kind === 'error' ? '#fca5a5' : '';
    }

    async function aiKeyRequest(url, method, body) {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.success === false) throw new Error(data.message || `Error ${res.status}`);
      return data;
    }

    document.getElementById('btnAiKeyTest')?.addEventListener('click', async () => {
      const provider = aiKeyProvider ? aiKeyProvider.value : '';
      const key = aiKeyValue ? aiKeyValue.value.trim() : '';
      if (!provider) return;
      setAiKeyStatus('info', 'Probando conexión…');
      try {
        const data = await aiKeyRequest('/api/admin/ai-keys/test', 'POST', { provider, key });
        setAiKeyStatus('ok', data.message || 'Conectado.');
      } catch (err) {
        setAiKeyStatus('error', (err && err.message) || 'Sin conexión.');
      }
    });

    document.getElementById('btnAiKeySave')?.addEventListener('click', async () => {
      const provider = aiKeyProvider ? aiKeyProvider.value : '';
      const key = aiKeyValue ? aiKeyValue.value.trim() : '';
      if (!provider || !key) {
        setAiKeyStatus('error', 'Elige un proveedor y pega su API key.');
        return;
      }
      setAiKeyStatus('info', 'Guardando…');
      try {
        const data = await aiKeyRequest('/api/admin/ai-keys', 'POST', { provider, key });
        setAiKeyStatus('ok', data.message || 'Clave guardada.');
        if (aiKeyValue) aiKeyValue.value = '';
        await tpLoadAiStatus(true);
        await aiConsoleLoadProviders();
      } catch (err) {
        setAiKeyStatus('error', (err && err.message) || 'No se pudo guardar.');
      }
    });

    document.getElementById('btnAiKeyDelete')?.addEventListener('click', async () => {
      const provider = aiKeyProvider ? aiKeyProvider.value : '';
      if (!provider) return;
      if (!window.confirm(`¿Borrar la API key guardada de ${AI_PROVIDER_NAMES[provider] || provider}?`)) return;
      setAiKeyStatus('info', 'Borrando…');
      try {
        const data = await aiKeyRequest('/api/admin/ai-keys', 'DELETE', { provider });
        setAiKeyStatus('ok', data.message || 'Clave borrada.');
        await tpLoadAiStatus(true);
        await aiConsoleLoadProviders();
      } catch (err) {
        setAiKeyStatus('error', (err && err.message) || 'No se pudo borrar.');
      }
    });

    // ── Consola interactiva de IA (modal grande a pantalla completa) ───────
    const aicConsole = document.getElementById('adminAiConsole');
    const aicConsoleBtn = document.getElementById('adminAiConsoleBtn');
    const aicProvider = document.getElementById('aicProvider');
    const aicModel = document.getElementById('aicModel');
    const aicMessages = document.getElementById('aicMessages');
    const aicForm = document.getElementById('aicForm');
    const aicInput = document.getElementById('aicInput');
    const aicSend = document.getElementById('aicSend');
    const aicHistory = [];
    const AIC_WELCOME = 'Conversa con la IA del panel o pídele tareas de curación del catálogo. Con «opencode (local)» se ejecuta el asistente instalado en el servidor.';

    /**
     * Da formato legible a una respuesta de la IA (markdown ligero, sin
     * librerías): bloques ```código```, encabezados #/##/###, listas con
     * "- "/"1. ", **negrita**, `código en línea` y párrafos separados por
     * líneas en blanco. Todo el texto se escapa antes de insertarse.
     */
    function formatIaReply(raw) {
      const text = String(raw == null ? '' : raw);
      const codeBlocks = [];
      const withoutCode = text.replace(/```[a-zA-Z]*\n?([\s\S]*?)```/g, (_, code) => {
        codeBlocks.push(code.replace(/\n$/, ''));
        return '\u0000CB' + (codeBlocks.length - 1) + '\u0000';
      });
      const inline = (s) => escapeHtml(s)
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      const blocks = withoutCode.split(/\n{2,}/);
      const html = blocks.map((block) => {
        const trimmed = block.trim();
        if (!trimmed) return '';
        const cbMatch = trimmed.match(/^\u0000CB(\d+)\u0000$/);
        if (cbMatch) return '<pre><code>' + escapeHtml(codeBlocks[Number(cbMatch[1])]) + '</code></pre>';
        const lines = trimmed.split('\n');
        const headingMatch = lines.length === 1 ? lines[0].match(/^(#{1,4})\s+(.*)$/) : null;
        if (headingMatch) {
          const level = Math.min(headingMatch[1].length + 2, 4);
          return '<h' + level + '>' + inline(headingMatch[2]) + '</h' + level + '>';
        }
        if (lines.every((l) => /^\s*[-*]\s+/.test(l))) {
          return '<ul>' + lines.map((l) => '<li>' + inline(l.replace(/^\s*[-*]\s+/, '')) + '</li>').join('') + '</ul>';
        }
        if (lines.every((l) => /^\s*\d+[.)]\s+/.test(l))) {
          return '<ol>' + lines.map((l) => '<li>' + inline(l.replace(/^\s*\d+[.)]\s+/, '')) + '</li>').join('') + '</ol>';
        }
        return '<p>' + lines.map(inline).join('<br>') + '</p>';
      }).join('');
      return html || '<p></p>';
    }

    function aicAppend(role, text, citations) {
      if (!aicMessages) return;
      const div = document.createElement('div');
      div.className = 'aic-msg is-' + role;
      if (role === 'assistant') {
        div.innerHTML = formatIaReply(text);
        if (citations && citations.length) {
          const sources = document.createElement('div');
          sources.className = 'aic-sources';
          sources.innerHTML = '🔎 Fuentes: ' + citations
            .map((c) => `<a href="${escapeHtml(c.url)}" target="_blank" rel="noopener noreferrer nofollow">${escapeHtml(c.title || c.url)}</a>`)
            .join(' · ');
          div.appendChild(sources);
        }
      }
      else div.textContent = text;
      aicMessages.appendChild(div);
      aicMessages.scrollTop = aicMessages.scrollHeight;
    }

    function aicClear() {
      aicHistory.length = 0;
      if (aicMessages) aicMessages.innerHTML = '<div class="aic-msg is-system">' + escapeHtml(AIC_WELCOME) + '</div>';
    }
    document.getElementById('adminAiConsoleClear')?.addEventListener('click', aicClear);

    function aicSetOpen(open) {
      if (!aicConsole) return;
      aicConsole.hidden = !open;
      if (aicConsoleBtn) aicConsoleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        aicInput?.focus();
        aiConsoleLoadProviders();
        aicLoadFreeModels(aicProvider.value || undefined);
      }
    }

    aicConsoleBtn?.addEventListener('click', () => aicSetOpen(aicConsole ? aicConsole.hidden : false));
    document.getElementById('adminAiConsoleClose')?.addEventListener('click', () => aicSetOpen(false));
    document.querySelector('.aic-backdrop[data-aic-close]')?.addEventListener('click', () => aicSetOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && aicConsole && !aicConsole.hidden) aicSetOpen(false);
    });
    document.getElementById('btnAiConsoleOpen2')?.addEventListener('click', () => aicSetOpen(true));

    async function aiConsoleLoadProviders() {
      if (!aicProvider) return;
      try {
        const res = await fetch('/api/admin/ai-console', { cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'No se pudo cargar la consola.');
        const previous = aicProvider.value;
        let html = `<option value="">Automático (${AI_PROVIDER_NAMES[data.defaultProvider] || data.defaultProvider || 'proveedor configurado'})</option>`;
        (data.providers || []).forEach((p) => {
          if (!p.configured) return;
          html += `<option value="${p.id}">${AI_PROVIDER_NAMES[p.id] || p.id}</option>`;
        });
        if (data.opencode && data.opencode.available) html += '<option value="opencode">OpenCode (local, en el servidor)</option>';
        aicProvider.innerHTML = html;
        if (previous && aicProvider.querySelector('option[value="' + previous + '"]')) aicProvider.value = previous;
        // Poblar modelos del proveedor seleccionado (o todos si no hay selección).
        aicLoadFreeModels(aicProvider.value || undefined);
      } catch {
        /* el select queda como está; el envío mostrará el error */
      }
    }

    /** Pobla el <select> #aicModel con los modelos gratuitos del proveedor
     *  indicado (datos de Transparencia › Conectividad de IA). Si providerId
     *  se omite o está vacío, se muestran los modelos de todos los
     *  proveedores configurados. */
    async function aicLoadFreeModels(providerId) {
      if (!aicModel) return;
      try {
        const res = await fetch('/api/admin/ai-keys', { cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) return;
        const providers = Array.isArray(data.providers) ? data.providers : [];
        const current = aicModel.value;
        let html = '<option value="">auto (modelo del proveedor)</option>';
        providers.forEach((p) => {
          if (!p.configured) return;
          // Filtrar por proveedor cuando se ha seleccionado uno concreto.
          if (providerId && p.id !== providerId) return;
          (p.freeModels || []).forEach((model) => {
            html += `<option value="${escapeHtml(String(model))}">${AI_PROVIDER_NAMES[p.id] || p.id} · ${escapeHtml(String(model))}</option>`;
          });
        });
        aicModel.innerHTML = html;
        if (current && Array.from(aicModel.options).some((o) => o.value === current)) aicModel.value = current;
        else aicModel.value = '';
      } catch { /* el select queda con la opción "auto" por defecto */ }
    }

    // Cuando cambia el proveedor, se refrescan los modelos compatibles y se
    // resetea la selección de modelo.
    aicProvider?.addEventListener('change', () => {
      aicLoadFreeModels(aicProvider.value || undefined);
      if (aicModel) aicModel.value = '';
    });

    aicForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const prompt = aicInput ? aicInput.value.trim() : '';
      if (!prompt || (aicSend && aicSend.disabled)) return;
      const provider = aicProvider ? aicProvider.value : '';
      const model = aicModel ? aicModel.value.trim() : '';

      aicAppend('user', prompt);
      if (aicInput) aicInput.value = '';
      if (aicSend) aicSend.disabled = true;
      const spinner = aicSend ? aicSend.querySelector('.btn-spinner') : null;
      if (spinner) spinner.hidden = false;

      try {
        let res;
        if (provider === 'opencode') {
          // Ejecución del asistente local (CLI opencode del contenedor).
          res = await fetch('/api/admin/ai-console', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode: 'opencode', prompt, model }),
          });
          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.message || 'opencode devolvió un error.');
          aicAppend('assistant', data.output || '(sin salida)');
        } else {
          // Chat vía API con el proveedor seleccionado (o el automático).
          const messages = aicHistory.concat([{ role: 'user', content: prompt }]);
          res = await fetch('/api/admin/ai-console', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode: 'chat', messages, provider, model }),
          });
          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.message || 'El proveedor devolvió un error.');
          aicHistory.push({ role: 'user', content: prompt });
          aicHistory.push({ role: 'assistant', content: data.reply || '' });
          while (aicHistory.length > 20) aicHistory.shift();
          aicAppend('assistant', data.reply || '(sin respuesta)', data.grounded ? data.citations : null);
        }
      } catch (err) {
        aicAppend('error', (err && err.message) || 'Error de red al contactar con la consola.');
      } finally {
        if (aicSend) aicSend.disabled = false;
        if (spinner) spinner.hidden = true;
        aicInput?.focus();
      }
    });

    // Estado inicial: información local instantánea (el test de red real se
    // lanza con «↻ Probar conexión» o tras guardar una clave).
    tpLoadAiStatus(false);
    aiConsoleLoadProviders();

    // ── Desarrollo IA › Skills de entrenamiento ─────────────────────────────
    const skillPersona = document.getElementById('skillPersona');
    const skillText = document.getElementById('skillText');
    const skillStatus = document.getElementById('skillStatus');
    const btnSkillAdd = document.getElementById('btnSkillAdd');
    const btnToggleSkillsView = document.getElementById('btnToggleSkillsView');
    const skillsListWrap = document.getElementById('skillsListWrap');

    // Las skills guardadas quedan ocultas por defecto (el resumen de cada
    // personalidad ya se ve en la tarjeta de arriba); este botón las muestra
    // u oculta sin dejar de cargarlas en segundo plano.
    btnToggleSkillsView?.addEventListener('click', () => {
      if (!skillsListWrap) return;
      const nextOpen = skillsListWrap.hidden;
      skillsListWrap.hidden = !nextOpen;
      btnToggleSkillsView.setAttribute('aria-expanded', String(nextOpen));
      btnToggleSkillsView.textContent = nextOpen ? '🙈 Ocultar skills guardados' : '👁️ Ver skills guardados';
    });

    function skillSetStatus(msg, isError) {
      if (!skillStatus) return;
      skillStatus.textContent = msg || '';
      skillStatus.style.color = isError ? '#f87171' : '#34d399';
      if (msg) setTimeout(() => { skillStatus.textContent = ''; }, 4000);
    }

    function skillRenderPersona(persona, skills) {
      const box = document.querySelector('[data-skills-target="' + persona + '"]');
      const summary = document.querySelector('[data-skill-persona="' + persona + '"]');
      if (summary) {
        summary.textContent = skills.length
          ? skills.length + ' skill(s) · última: ' + skills[skills.length - 1].text.slice(0, 90)
          : 'Sin skills: usa el prompt base de la personalidad.';
      }
      if (!box) return;
      if (!skills.length) {
        box.innerHTML = '<div class="skills-empty">Aún no has añadido instrucciones a esta personalidad.</div>';
        return;
      }
      box.innerHTML = skills.map((s) =>
        '<div class="skill-chip"><span>' + s.text.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c])) + '</span>' +
        '<button type="button" data-skill-del="' + s.id + '" title="Eliminar esta instrucción" aria-label="Eliminar skill">×</button></div>'
      ).join('');
    }

    async function skillsLoad() {
      try {
        const res = await fetch('/api/admin/ai-skills', { cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'No se pudieron cargar los skills.');
        const all = Array.isArray(data.skills) ? data.skills : [];
        skillRenderPersona('dependiente', all.filter((s) => s.persona === 'dependiente'));
        skillRenderPersona('admin', all.filter((s) => s.persona === 'admin'));
      } catch (err) {
        skillSetStatus((err && err.message) || 'Error al cargar skills.', true);
      }
    }

    btnSkillAdd?.addEventListener('click', async () => {
      const persona = skillPersona ? skillPersona.value : 'dependiente';
      const text = skillText ? skillText.value.trim() : '';
      if (!text) { skillSetStatus('Escribe la instrucción primero.', true); return; }
      try {
        const res = await fetch('/api/admin/ai-skills', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ persona, text }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'No se pudo añadir.');
        if (skillText) skillText.value = '';
        skillSetStatus('✓ Skill añadida. Se aplica en la próxima conversación.');
        await skillsLoad();
      } catch (err) {
        skillSetStatus((err && err.message) || 'Error al añadir.', true);
      }
    });

    skillText?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); btnSkillAdd?.click(); }
    });

    document.addEventListener('click', async (event) => {
      const btn = event.target && event.target.closest ? event.target.closest('[data-skill-del]') : null;
      if (!btn) return;
      const id = btn.getAttribute('data-skill-del');
      if (!id) return;
      try {
        const res = await fetch('/api/admin/ai-skills?id=' + encodeURIComponent(id), { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'No se pudo eliminar.');
        skillSetStatus('✓ Skill eliminada.');
        await skillsLoad();
      } catch (err) {
        skillSetStatus((err && err.message) || 'Error al eliminar.', true);
      }
    });

    skillsLoad();

    // ── Tooltip global del panel (mejora visual de los `title` nativos) ─────
    const adminTooltipEl = document.createElement('div');
    adminTooltipEl.className = 'admin-tooltip';
    adminTooltipEl.hidden = true;
    document.body.appendChild(adminTooltipEl);
    let adminTooltipTarget = null;
    let adminTooltipTimer = null;

    document.addEventListener('mouseover', (event) => {
      const target = event.target && event.target.closest ? event.target.closest('[title]') : null;
      if (!target || target === adminTooltipTarget) return;
      const text = target.getAttribute('title');
      if (!text) return;
      adminTooltipTarget = target;
      target.setAttribute('data-tooltip-text', text);
      target.removeAttribute('title');
      clearTimeout(adminTooltipTimer);
      adminTooltipTimer = setTimeout(() => {
        const rect = target.getBoundingClientRect();
        adminTooltipEl.textContent = text;
        adminTooltipEl.hidden = false;
        const top = rect.top - adminTooltipEl.offsetHeight - 8;
        adminTooltipEl.style.top = (top >= 8 ? top : rect.bottom + 8) + 'px';
        adminTooltipEl.style.left = Math.min(Math.max(8, rect.left), window.innerWidth - adminTooltipEl.offsetWidth - 8) + 'px';
      }, 350);
    });

    document.addEventListener('mouseout', (event) => {
      const target = event.target && event.target.closest ? event.target.closest('[data-tooltip-text]') : null;
      if (!target) return;
      if (event.relatedTarget && target.contains(event.relatedTarget)) return;
      clearTimeout(adminTooltipTimer);
      adminTooltipEl.hidden = true;
      if (!target.getAttribute('title')) target.setAttribute('title', target.getAttribute('data-tooltip-text') || '');
      target.removeAttribute('data-tooltip-text');
      if (adminTooltipTarget === target) adminTooltipTarget = null;
    });

    // ── Tooltips automáticos para todos los botones del backend ─────────────
    // Cualquier botón que tenga aria-label o texto visible y no tenga title
    // recibirá un cartel emergente explicativo al situar el ratón encima.
    function initAdminTooltips() {
      document.querySelectorAll('button:not([title])').forEach((btn) => {
        const text = btn.getAttribute('aria-label') || btn.textContent?.trim() || '';
        if (text) btn.setAttribute('title', text);
      });
    }
    initAdminTooltips();
    // Re-aplicar tooltips cuando el DOM cambie (tablas renderizadas dinámicamente)
    new MutationObserver(initAdminTooltips).observe(document.body, { childList: true, subtree: true });
  });
</script>

<!--
  Panel «Campos visibles en la ficha del producto»: script aparte (mismo
  patrón que window.tradylorAliFilters) para no acoplarlo al script principal
  (9000+ líneas). Expone window.tradylorCustomFields para que el formulario
  de «1. Extracción & Alta de Producto» lea/escriba los campos personalizados
  sin que ambos scripts se conozcan entre sí.
-->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const fvToggle = document.getElementById('fieldVisibilityToggle');
    const fvToggleBtn = document.getElementById('btnToggleFieldVisibility');
    const fvToggleLabel = document.getElementById('fieldVisibilityToggleLabel');
    const fvPanel = document.getElementById('fieldVisibilityPanel');
    const baseFieldsList = document.getElementById('baseFieldsList');
    const customFieldsList = document.getElementById('customFieldsList');
    const newCustomFieldLabel = document.getElementById('newCustomFieldLabel');
    const newCustomFieldVisible = document.getElementById('newCustomFieldVisible');
    const btnAddCustomField = document.getElementById('btnAddCustomField');
    const fieldVisibilityStatus = document.getElementById('fieldVisibilityStatus');
    const customFieldsSection = document.getElementById('customFieldsSection');
    const customFieldsContainer = document.getElementById('customFieldsContainer');

    // El panel sólo existe para sesiones admin autenticadas; si falta, esta
    // sección entera no está en el DOM (usuario sin permisos) y no hay nada que hacer.
    if (!fvPanel) return;

    let customFieldsCache = [];

    function fvEscapeHtml(value) {
      const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return String(value == null ? '' : value).replace(/[&<>"']/g, (ch) => map[ch] || ch);
    }

    function fvSetStatus(msg, isError) {
      if (!fieldVisibilityStatus) return;
      fieldVisibilityStatus.textContent = msg || '';
      fieldVisibilityStatus.style.color = isError ? '#f87171' : '#34d399';
      if (msg) setTimeout(() => { fieldVisibilityStatus.textContent = ''; }, 4000);
    }

    function renderBaseFields(fields) {
      if (!baseFieldsList) return;
      if (!fields.length) {
        baseFieldsList.innerHTML = '<p class="card-desc">Sin campos configurables.</p>';
        return;
      }
      baseFieldsList.innerHTML = fields
        .map(
          (f) => `
        <label class="field-toggle-item">
          <input type="checkbox" data-base-field="${fvEscapeHtml(f.key)}"${f.visible ? ' checked' : ''} />
          <span class="field-toggle-item-text">
            <span class="field-toggle-item-label">${fvEscapeHtml(f.label)}</span>
            <span class="field-toggle-item-hint">${fvEscapeHtml(f.hint || '')}</span>
          </span>
        </label>`
        )
        .join('');
      baseFieldsList.querySelectorAll('[data-base-field]').forEach((box) => {
        box.addEventListener('change', async () => {
          const key = box.getAttribute('data-base-field');
          const previous = !box.checked;
          box.disabled = true;
          try {
            const res = await fetch('/api/admin/product-fields', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'set-base-visibility', key, visible: box.checked }),
            });
            const data = await res.json();
            if (!data.success) throw new Error('No se pudo guardar.');
            fvSetStatus('✓ Guardado: se aplica en la próxima visita a la ficha.');
          } catch (err) {
            box.checked = previous;
            fvSetStatus((err && err.message) || 'Error al guardar.', true);
          } finally {
            box.disabled = false;
          }
        });
      });
    }

    function renderCustomFieldsList(fields) {
      if (!customFieldsList) return;
      if (!fields.length) {
        customFieldsList.innerHTML = '<p class="card-desc">Todavía no has añadido ningún campo personalizado.</p>';
        return;
      }
      customFieldsList.innerHTML = fields
        .map(
          (f) => `
        <label class="field-toggle-item">
          <input type="checkbox" data-custom-field-visibility="${fvEscapeHtml(f.key)}"${f.visible ? ' checked' : ''} />
          <span class="field-toggle-item-text">
            <span class="field-toggle-item-label">${fvEscapeHtml(f.label)}</span>
            <span class="field-toggle-item-hint">product.extra.${fvEscapeHtml(f.key)}</span>
          </span>
          <button type="button" class="field-toggle-item-remove" data-custom-field-remove="${fvEscapeHtml(f.key)}" title="Eliminar campo (los valores ya guardados no se borran)" aria-label="Eliminar campo">✕</button>
        </label>`
        )
        .join('');
      customFieldsList.querySelectorAll('[data-custom-field-visibility]').forEach((box) => {
        box.addEventListener('change', async () => {
          const key = box.getAttribute('data-custom-field-visibility');
          const previous = !box.checked;
          box.disabled = true;
          try {
            const res = await fetch('/api/admin/product-fields', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'set-custom-visibility', key, visible: box.checked }),
            });
            const data = await res.json();
            if (!data.success) throw new Error('No se pudo guardar.');
            const field = customFieldsCache.find((f) => f.key === key);
            if (field) field.visible = box.checked;
            renderCustomFieldInputs(customFieldsCache, window.tradylorCustomFields.getFormValues());
            fvSetStatus('✓ Guardado');
          } catch (err) {
            box.checked = previous;
            fvSetStatus((err && err.message) || 'Error al guardar.', true);
          } finally {
            box.disabled = false;
          }
        });
      });
      customFieldsList.querySelectorAll('[data-custom-field-remove]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const key = btn.getAttribute('data-custom-field-remove');
          if (!confirm('¿Eliminar este campo personalizado? Los valores ya guardados en los productos no se borran, pero dejarán de verse en el formulario y en la ficha.')) return;
          btn.disabled = true;
          try {
            const res = await fetch('/api/admin/product-fields', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'remove-custom-field', key }),
            });
            const data = await res.json();
            if (!data.success) throw new Error('No se pudo eliminar.');
            fvSetStatus('✓ Campo eliminado');
            await loadFieldVisibilityConfig(true);
          } catch (err) {
            fvSetStatus((err && err.message) || 'Error al eliminar.', true);
            btn.disabled = false;
          }
        });
      });
    }

    function renderCustomFieldInputs(fields, values) {
      if (!customFieldsContainer || !customFieldsSection) return;
      customFieldsSection.hidden = fields.length === 0;
      const vals = values || {};
      customFieldsContainer.innerHTML = fields
        .map(
          (f) => `
        <div class="form-group full-width">
          <label for="cf_${fvEscapeHtml(f.key)}" class="field-label">
            <span>${fvEscapeHtml(f.label)}</span>
            ${f.visible ? '<span class="label-hint">Visible en la ficha pública</span>' : '<span class="label-hint">Oculto en la ficha (actívalo en «Campos visibles en la ficha»)</span>'}
          </label>
          <input type="text" id="cf_${fvEscapeHtml(f.key)}" data-custom-field-input="${fvEscapeHtml(f.key)}" value="${fvEscapeHtml(vals[f.key] != null ? vals[f.key] : '')}" />
        </div>`
        )
        .join('');
    }

    async function loadFieldVisibilityConfig(preserveFormValues) {
      try {
        const res = await fetch('/api/admin/product-fields', { cache: 'no-store' });
        const data = await res.json();
        if (!data.success) return;
        renderBaseFields(data.baseFields || []);
        customFieldsCache = data.customFields || [];
        renderCustomFieldsList(customFieldsCache);
        const currentValues = preserveFormValues ? window.tradylorCustomFields.getFormValues() : {};
        renderCustomFieldInputs(customFieldsCache, currentValues);
      } catch {
        if (baseFieldsList) baseFieldsList.innerHTML = '<p class="card-desc">No se pudo cargar (revisa tu conexión).</p>';
      }
    }

    function fvTogglePanel(forceOpen) {
      if (!fvPanel) return;
      const isOpen = typeof forceOpen === 'boolean' ? forceOpen : fvPanel.hidden;
      fvPanel.hidden = !isOpen;
      fvToggle?.setAttribute('aria-expanded', String(isOpen));
      if (fvToggleLabel) fvToggleLabel.textContent = isOpen ? 'Ocultar' : 'Mostrar';
      if (isOpen) loadFieldVisibilityConfig(true);
    }

    // Mismo patrón que #categoryFormToggle: el header entero es clicable,
    // pero si el clic viene del botón interno se cede el turno a su propio
    // listener (evita togglear dos veces).
    fvToggle?.addEventListener('click', (event) => {
      if (event.target.closest('button')) return;
      fvTogglePanel();
    });
    fvToggleBtn?.addEventListener('click', () => fvTogglePanel());

    btnAddCustomField?.addEventListener('click', async () => {
      const label = ((newCustomFieldLabel && newCustomFieldLabel.value) || '').trim();
      if (!label) {
        fvSetStatus('Escribe un nombre para el campo.', true);
        newCustomFieldLabel?.focus();
        return;
      }
      const visible = newCustomFieldVisible ? newCustomFieldVisible.checked : true;
      btnAddCustomField.disabled = true;
      try {
        const res = await fetch('/api/admin/product-fields', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'add-custom-field', label, visible }),
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.message || 'No se pudo crear el campo.');
        if (newCustomFieldLabel) newCustomFieldLabel.value = '';
        fvSetStatus(`✓ Campo «${label}» creado: ya aparece en «1. Extracción & Alta de Producto».`);
        await loadFieldVisibilityConfig(true);
      } catch (err) {
        fvSetStatus((err && err.message) || 'Error al crear el campo.', true);
      } finally {
        btnAddCustomField.disabled = false;
      }
    });

    // Puente para el formulario de producto (mismo patrón que
    // window.tradylorAliFilters): lee/escribe los valores de los campos
    // personalizados sin acoplar este script al principal.
    window.tradylorCustomFields = {
      getFormValues() {
        const out = {};
        document.querySelectorAll('[data-custom-field-input]').forEach((input) => {
          const key = input.getAttribute('data-custom-field-input');
          const value = input.value.trim();
          if (key && value) out[key] = value;
        });
        return out;
      },
      setFormValues(extra) {
        renderCustomFieldInputs(customFieldsCache, extra && typeof extra === 'object' ? extra : {});
      },
    };

    // Carga inicial silenciosa: deja listos los inputs del formulario desde
    // el primer momento, aunque el panel de visibilidad siga plegado.
    loadFieldVisibilityConfig(false);
  });
</script>
  </>
)}

<style>
