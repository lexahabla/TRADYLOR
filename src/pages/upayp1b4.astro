          <button type="button" id="btnMigratePreview" class="btn-secondary btn-sm" title="Simula la reclasificación y muestra el plan sin escribir nada">
            <span class="btn-text">👁 Ver vista previa</span>
            <div class="btn-spinner" hidden></div>
          </button>
          <button type="button" id="btnMigrateCategories" class="btn-danger btn-sm" title="Ejecuta la reclasificación de los productos">
            <span class="btn-text">🔄 Ejecutar</span>
            <div class="btn-spinner" hidden></div>
          </button>
        </div>
        <div id="migrateStatus" class="status-alert" hidden>
          <div class="alert-icon" id="migrateStatusIcon">ℹ️</div>
          <div class="alert-content">
            <strong id="migrateStatusTitle">Estado</strong>
            <p id="migrateStatusText">Mensaje...</p>
          </div>
        </div>

        <!-- 2.b. Reasignación manual de los productos que el matching no clasificó -->
        <div id="migrateManualBox" class="migrate-manual-box" hidden>
          <div class="migrate-manual-head">
            <div>
              <strong id="migrateManualTitle">Reasignación manual</strong>
              <p id="migrateManualDesc" class="migrate-manual-desc">
                Productos sin coincidencia automática. Elige la categoría raíz de cada uno y ejecuta
                la migración: la asignación manual tiene prioridad sobre el matching.
