  :global(.migrate-manual-box[hidden]) { display: none; }
  :global(.migrate-manual-head) { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; flex-wrap: wrap; }
  :global(.migrate-manual-head strong) { display: block; font-size: .82rem; color: #bfdbfe; }
  :global(.migrate-manual-desc) { margin: .2rem 0 0; font-size: .74rem; color: var(--color-text-dim); }
  :global(.migrate-manual-actions) { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  :global(.migrate-manual-count) { font-size: .72rem; color: var(--color-text-muted); }
  :global(.migrate-manual-list) { display: flex; flex-direction: column; gap: .4rem; margin-top: .75rem; max-height: 22rem; overflow: auto; }
  :global(.migrate-manual-row) { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .45rem .6rem; border: 1px solid rgba(148, 163, 184, .22); border-radius: 8px; background: #0b1220; }
  :global(.migrate-manual-info) { display: flex; flex-direction: column; min-width: 0; }
  :global(.migrate-manual-name) { font-size: .78rem; color: var(--color-text-main); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 40rem; }
  :global(.migrate-manual-meta) { font-size: .68rem; color: var(--color-text-dim); }
  :global(.migrate-manual-select) { padding: .3rem .5rem; font-size: .72rem; color: var(--color-text-main); background: #0b1220; border: 1px solid var(--color-border); border-radius: 6px; max-width: 16rem; }

  /* Formulario */
  .product-edit-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Columna izquierda del formulario (campos) dentro del grid con la preview */
  .form-fields {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .form-preview-col { min-width: 0; }

  .form-row {
    display: flex;
    gap: 1rem;
  }

  .form-row.two-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 640px) {
    .form-row.two-cols {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .full-width {
    width: 100%;
  }

  .field-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .required {
    color: #f87171;
  }

  .label-hint {
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--color-text-dim);
  }

  .gallery-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.3rem;
  }

  :global(.gallery-item) {
    position: relative;
    width: 72px;
    height: 72px;
  }

  :global(.gallery-item.is-dragging) {
    opacity: 0.35;
  }

  :global(.gallery-item.drag-before)::before,
  :global(.gallery-item.drag-after)::after {
    content: '';
    position: absolute;
    top: -4px;
    bottom: -4px;
    width: 3px;
    border-radius: 3px;
    background: var(--color-accent, #f59e0b);
    box-shadow: 0 0 6px rgba(245, 158, 11, 0.7);
    z-index: 3;
  }

  :global(.gallery-item.drag-before)::before {
    left: -6px;
  }

  :global(.gallery-item.drag-after)::after {
    right: -6px;
  }

  :global(.gallery-item.is-main .gallery-thumb) {
    border-color: var(--color-accent, #f59e0b);
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.3);
  }

  :global(.gallery-thumb) {
    width: 72px;
    height: 72px;
    padding: 0;
    border: 2px solid var(--color-border, #333);
    border-radius: 8px;
    overflow: hidden;
    cursor: grab;
    background: linear-gradient(160deg, #f8fafc, #eef2f7);
    transition: border-color 0.15s, transform 0.15s;
  }

  :global(.gallery-thumb:active) {
    cursor: grabbing;
  }

  :global(.gallery-thumb:hover) {
    transform: translateY(-2px);
    border-color: var(--color-accent, #f59e0b);
  }

  :global(.gallery-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 5px;
    display: block;
  }

  /* Miniatura de vídeo de plataforma (16:9): llenar el cuadrado sin letterbox. */
  :global(.gallery-thumb img.video-still) {
    object-fit: cover;
    padding: 0;
    background: #0f1626;
  }

  :global(.gallery-thumb video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #0f1626;
  }

  :global(.gallery-play-badge) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: #fff;
    font-size: 1.35rem;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7);
  }

  :global(.gallery-play-badge::before) {
    content: '';
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.65);
    border: 1.5px solid rgba(255, 255, 255, 0.85);
  }

  :global(.gallery-play-badge) {
    z-index: 1;
  }

  :global(.gallery-remove) {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 20px;
    height: 20px;
    border: none;
    border-radius: 50%;
    background: #ef4444;
    color: #fff;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  :global(.gallery-remove:hover) {
    background: #dc2626;
  }

  .gallery-add-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .gallery-editor {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.9rem;
    padding: 0.9rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--color-border);
    border-radius: var(--border-radius-sm);
  }

  label.btn-secondary.gallery-file-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    cursor: pointer;
    white-space: nowrap;
  }

  .gallery-url-add {
    display: flex;
    gap: 0.5rem;
  }

  .gallery-url-add input {
    flex: 1;
  }

  :global(.gallery-empty) {
    font-size: 0.78rem;
    color: var(--color-text-dim);
    font-style: italic;
  }

  .form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }


  /* 3. Live Preview Card */
  .preview-container {
    position: sticky;
    top: 2rem;
  }

  .preview-product-card {
    background: #0f1626;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
  }

  /* Los toggles de la vista previa (imagen, placeholder, flechas, contador)
     usan el atributo [hidden]; el display de los autoestilos debe respetarlo. */
  [hidden] {
    display: none !important;
  }

  .preview-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    box-sizing: border-box;
    /* Mismo fondo que la imagen de la ficha real y la ProductCard (#f8fafc) */
    background: #f8fafc;
    overflow: hidden;
    /* Sin display:flex: el <img> se coloca en absoluto y se centra solo. */
  }

  /* Imagen a absoluto dentro del wrapper: llena el contenedor (responsive)
     y object-fit:contain la centra y muestra COMPLETA sin recortes. */
  .preview-image-wrapper img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 6%;
    display: block;
    object-fit: contain;
    object-position: center;
    border-radius: 0.75rem;
    transition: transform 0.3s ease;
  }

  .preview-empty-image {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: #94a3b8;
    background: #f8fafc;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .preview-empty-image svg {
    color: #38bdf8;
    opacity: 0.85;
  }

  /* Overlay de vídeo en la vista previa: al pulsarlo se abre el modal.
     Fondo suave para no tapar la miniatura del vídeo que hay detrás. */
  .preview-video-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: none;
    cursor: pointer;
    background: rgba(15, 23, 42, 0.35);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
    transition: background 0.15s;
  }

  .preview-video-overlay:hover {
    background: rgba(15, 23, 42, 0.55);
  }

  /* Fotograma/mp4 mostrado como miniatura en la vista previa del carrusel.
     :global porque el <video> lo crea el JS dinámicamente (sin data-astro-cid). */
  :global(.preview-video-thumb) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 6%;
    display: block;
    object-fit: contain;
    object-position: center;
    border-radius: 0.75rem;
    background: #0f1626;
  }

  .preview-play-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.85);
    font-size: 1.5rem;
    padding-left: 4px;
    box-sizing: border-box;
  }

  /* ── Modal de vídeo (centrado en pantalla, cerrable) ── */
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .video-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 6, 16, 0.82);
    backdrop-filter: blur(4px);
    cursor: pointer;
  }

  .video-modal-dialog {
    position: relative;
    /* 16:9 responsive: se ajusta al ancho disponible y nunca desborda
       verticalmente (pantallas apaisadas / móviles). */
    width: min(920px, 100%);
    max-width: calc((100vh - 2rem) * 16 / 9);
    max-height: 90vh;
    z-index: 1;
  }

  .video-modal-body {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
  }

  /* Los hijos del modal los crea el JS (sin data-astro-cid): :global obliga.
     Sin esto el <video>/<iframe> salía a su tamaño nativo, más grande que la ventana. */
  :global(.video-modal-body video),
  :global(.video-modal-body iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    object-fit: contain;
    background: #000;
  }

  .video-modal-close {
    position: absolute;
    top: -44px;
    right: 0;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    z-index: 2;
  }

  .video-modal-close:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 600px) {
    /* En móvil el botón se colocó dentro del diálogo para no quedar fuera. */
    .video-modal-close {
      top: 8px;
      right: 8px;
      background: rgba(15, 23, 42, 0.85);
    }
  }

  .preview-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.55);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    transition: background 0.15s, opacity 0.15s;
    z-index: 2;
  }

  .preview-nav:hover {
    background: rgba(15, 23, 42, 0.8);
  }

  .preview-nav-prev { left: 8px; }
  .preview-nav-next { right: 8px; }

  .preview-counter {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.6);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9999px;
    z-index: 2;
    pointer-events: none;
  }

  .preview-badge-row {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    /* Por encima de #previewImg (z-index auto) y del placeholder vacío. */
    z-index: 3;
  }

  .cat-pill {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    font-size: 0.7rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    font-weight: 600;
  }

  .badge-pill {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    font-size: 0.7rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    font-weight: 700;
  }

  .preview-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .preview-merchant-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .merchant-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #60a5fa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .rating-stars {
    color: #f59e0b;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .rating-num {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .preview-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.35;
  }

  .preview-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .preview-pricing {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.5rem 0;
  }

  .price-current {
    font-size: 1.5rem;
    font-weight: 800;
    color: #10b981;
    font-family: var(--font-heading);
  }

  .price-original {
    font-size: 0.95rem;
    color: var(--color-text-dim);
    text-decoration: line-through;
  }

  .discount-pill {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .preview-bullets {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.75rem;
  }

  .bullet-col strong {
    display: block;
    font-size: 0.72rem;
    color: var(--color-text-dim);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .bullet-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .bullet-col li {
    font-size: 0.78rem;
    color: #cbd5e1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .bullet-col li::before {
    content: "✔";
    color: #10b981;
    font-size: 0.7rem;
  }

  .preview-buy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
    text-decoration: none;
    padding: 0.75rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    margin-top: 0.5rem;
    transition: all 0.2s ease;
  }

  .preview-buy-btn:hover {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
  }

  /* 4. Tabla de Productos Registrados
     Sin display base: la visibilidad la controlan las reglas .is-visible (más arriba) */
  .products-list-card {
    flex-direction: column;
    gap: 1.5rem;
  }

  .list-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1rem;
  }

  .list-search-wrapper {
    min-width: 260px;
  }

  /* ── Tabla de productos registrados (50 filas/página) ──────────────────────
     Fila compacta: ~84 px de alto. La tabla de afiliados mide ~80 px, así que
     aquí queda un pelín más grande que en aquella, pero cabe el doble de
     productos por página que antes (25 → 50). */
  :global(.products-table-responsive) {
    overflow-x: auto;
  }

  :global(.products-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    table-layout: fixed;
  }

  :global(.products-table th:nth-child(4)),   /* Estado */
  :global(.products-table th:nth-child(5)),   /* Precio */
  :global(.products-table th:nth-child(6)),   /* Precio orig. */
  :global(.products-table th:nth-child(7)),   /* Dto. */
  :global(.products-table th:nth-child(8)),   /* Comisión % */
  :global(.products-table th:nth-child(9)),   /* Comisión € */
  :global(.products-table th:nth-child(10)),  /* Ventas */
  :global(.products-table th:nth-child(11))   /* Valoración */
  {
    width: 75px;
    max-width: 75px;
  }

  :global(.products-table th:nth-child(3)),   /* Producto */
  {
    min-width: 220px;
    max-width: 260px;
  }

  :global(.products-table th:nth-child(12))   /* Acciones */
  {
    width: 60px;
    max-width: 60px;
  }

  :global(.products-table th) {
    white-space: normal;
    padding: .45rem .35rem;
  }

  :global(.products-table th) {
    text-align: center;
    padding: 0.4rem 0.5rem;
    color: var(--color-text-dim);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.products-table td) {
    text-align: center;
    padding: 0.6rem 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    vertical-align: middle;
  }

  :global(.product-row:hover) {
    background: rgba(255, 255, 255, 0.02);
  }

  :global(.thumb-img) {
    width: 42px;
    height: 42px;
    max-width: 42px;
    max-height: 42px;
    object-fit: cover;
    border-radius: 6px;
    background: #080c14;
    border: 1px solid var(--color-border);
    display: block;
  }

  :global(.row-title) {
    font-weight: 600;
    color: var(--color-text-main);
    line-height: 1.3;
    max-width: 320px;
  }

  :global(a.row-title) {
    display: inline-block;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  :global(a.row-title:hover) {
    color: #60a5fa;
    text-decoration: underline;
  }

  :global(.row-meta) {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.12rem;
  }

  :global(.pill-category) {
    font-size: 0.64rem;
    color: var(--color-text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.08rem 0.38rem;
    border-radius: 4px;
  }

  :global(.pill-badge) {
    font-size: 0.64rem;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.1);
    padding: 0.08rem 0.38rem;
    border-radius: 4px;
  }

  :global(.merchant-badge) {
    display: inline-block;
    padding: 0.12rem 0.42rem;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.25);
    color: #60a5fa;
    border-radius: 6px;
    font-size: 0.68rem;
    font-weight: 600;
  }

  :global(.price-val) {
    font-weight: 700;
    color: #10b981;
    font-size: 0.85rem;
  }

  :global(.price-old) {
    display: block;
    font-size: 0.68rem;
    color: var(--color-text-dim);
    text-decoration: line-through;
  }

