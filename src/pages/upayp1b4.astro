    // ── Edición rápida de categoría/subcategoría en la fila expandida ────────
    async function quickAssignCategory(id, categoryId, categoryName, subcategoryId) {
      try {
        const res = await fetch('/api/products/add', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'set-category',
            ids: [id],
            category: categoryName,
            category_id: categoryId,
            subcategory_id: subcategoryId || '',
          }),
        });
        const data = await res.json();
        if (data.success) {
          showAlert('success', 'Categoría actualizada', `«${categoryName}»${subcategoryId ? ` › subcategoría asignada` : ''} (${id}).`);
          await reloadProductsTable();
        } else {
          showAlert('error', 'Error al guardar', data.message || 'No se pudo actualizar la categoría.');
        }
      } catch {
        showAlert('error', 'Error de red', 'No se pudo contactar con el servidor.');
      }
    }
    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      const id = target.getAttribute('data-id');
      if (!id) return;
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      if (target.classList.contains('row-cat-select')) {
        const catObj = allCats.find((c) => c.id === target.value);
        if (catObj) quickAssignCategory(id, catObj.id, catObj.name, '');
      } else if (target.classList.contains('row-subcat-select')) {
        const row = target.closest('[data-product-id]');
        const catId = row?.querySelector('.row-cat-select')?.value || '';
        const catObj = allCats.find((c) => c.id === catId);
        if (catObj) quickAssignCategory(id, catObj.id, catObj.name, target.value);
      }
    });

    // ── Vinculación de alternativas (cross-matching bidireccional) ───────────
    const linkAlternativesModal = document.getElementById('linkAlternativesModal');
    const linkAltLinked = document.getElementById('linkAltLinked');
    const linkAltSuggestions = document.getElementById('linkAltSuggestions');
    const linkAltSearch = document.getElementById('linkAltSearch');
    const linkAltStatus = document.getElementById('linkAltStatus');
    let linkAltProductId = null;
    let linkAltLinkedIds = new Set();
    let linkAltCatalog = [];
    /**
     * Selección de los 3 roles. La económica y el competidor admiten VARIOS ids
     * (los selects son `multiple`); el campo premium sigue siendo único.
     * El servidor los rellena automáticamente si el producto no tenía nada.
     */
    const LINK_ALT_ROLES_EMPTY = { premiumOptionId: '', cheaperOptionIds: [], similarOptionIds: [] };
    let linkAltRoles = { ...LINK_ALT_ROLES_EMPTY };

    function linkAltRoleSelected(roleKey) {
      const value = linkAltRoles[roleKey];
      if (Array.isArray(value)) return value.filter(Boolean);
      return value ? [value] : [];
    }

    function linkAltRenderRoles() {
      const byId = new Map(linkAltCatalog.map((p) => [p.id, p]));
      // Cualquier id vinculado (aunque no esté en la muestra) debe poder elegirse.
      for (const id of linkAltLinkedIds) {
        if (!byId.has(id)) byId.set(id, { id, title: id, price: 0, image: '' });
      }
      const optionsFor = Array.from(linkAltLinkedIds)
        .map((id) => byId.get(id))
        .filter(Boolean);

      for (const [selectId, roleKey] of [
        ['linkAltRolePremium', 'premiumOptionId'],
        ['linkAltRoleCheap', 'cheaperOptionIds'],
        ['linkAltRoleSimilar', 'similarOptionIds'],
      ]) {
        const select = document.getElementById(selectId);
        if (!select) continue;
        // En los selects múltiples no hay «— Ninguna —»: sin selección = rol vacío.
        const placeholder = select.multiple ? '' : '<option value="">— Ninguna —</option>';
        select.innerHTML = placeholder + optionsFor
          .map((p) => `<option value="${escapeHtml(p.id)}">${escapeHtml(p.title).slice(0, 60)}</option>`)
          .join('');
        const selected = new Set(linkAltRoleSelected(roleKey));
        if (select.multiple) {
          for (const option of select.options) option.selected = selected.has(option.value);
        } else {
          const first = [...selected][0] || '';
          select.value = Array.from(select.options).some((o) => o.value === first) ? first : '';
        }
      }
    }

    function linkAltRenderList() {
      if (!linkAltLinked || !linkAltSuggestions) return;
      const q = String(linkAltSearch?.value || '').trim().toLowerCase();
      const matches = (p) => !q || `${p.title} ${p.category || ''} ${p.id}`.toLowerCase().includes(q);
      const byId = new Map(linkAltCatalog.map((p) => [p.id, p]));

      linkAltLinked.innerHTML = linkAltLinkedIds.size
        ? Array.from(linkAltLinkedIds).map((id) => byId.get(id)).filter(Boolean).map((p) => `
            <label class="link-alt-item is-linked">
              <input type="checkbox" checked data-link-alt-check="${escapeHtml(p.id)}" />
              <img src="${escapeHtml(p.image || '')}" alt="" loading="lazy" />
              <span class="link-alt-item-title">${escapeHtml(p.title).slice(0, 70)}</span>
              <span class="link-alt-item-price">${Number(p.price || 0).toFixed(2)} €</span>
            </label>`).join('')
        : '<p class="text-muted">Sin alternativas vinculadas todavía.</p>';

      const suggestions = linkAltCatalog.filter((p) => !linkAltLinkedIds.has(p.id) && matches(p));
      document.getElementById('linkAltCount').textContent = `(${suggestions.length})`;
      linkAltSuggestions.innerHTML = suggestions.length
        ? suggestions.map((p) => `
            <label class="link-alt-item">
              <input type="checkbox" data-link-alt-check="${escapeHtml(p.id)}" />
              <img src="${escapeHtml(p.image || '')}" alt="" loading="lazy" />
              <span class="link-alt-item-title">${escapeHtml(p.title).slice(0, 70)}</span>
              <span class="link-alt-item-price">${Number(p.price || 0).toFixed(2)} €</span>
            </label>`).join('')
        : '<p class="text-muted">Sin coincidencias.</p>';

      linkAltRenderRoles();
    }

    document.addEventListener('change', (event) => {
      const checkbox = event.target.closest?.('[data-link-alt-check]');
      if (!checkbox) return;
      const id = checkbox.getAttribute('data-link-alt-check');
      if (!id) return;
      if (checkbox.checked) linkAltLinkedIds.add(id);
      else {
        linkAltLinkedIds.delete(id);
        // Si se desvincula un producto ya no puede seguir en ningún rol.
        if (linkAltRoles.premiumOptionId === id) linkAltRoles.premiumOptionId = '';
        linkAltRoles.cheaperOptionIds = linkAltRoles.cheaperOptionIds.filter((v) => v !== id);
        linkAltRoles.similarOptionIds = linkAltRoles.similarOptionIds.filter((v) => v !== id);
      }
      linkAltRenderList();
    });

    // Cambio manual de un rol (único o múltiple): se guarda en el estado local.
    document.addEventListener('change', (event) => {
      const select = event.target.closest?.('.link-alt-role-select');
      if (!select) return;
      if (select.id === 'linkAltRolePremium') {
        linkAltRoles.premiumOptionId = select.value || '';
      } else if (select.id === 'linkAltRoleCheap') {
        linkAltRoles.cheaperOptionIds = Array.from(select.selectedOptions || []).map((o) => o.value).filter(Boolean);
      } else if (select.id === 'linkAltRoleSimilar') {
        linkAltRoles.similarOptionIds = Array.from(select.selectedOptions || []).map((o) => o.value).filter(Boolean);
      }
    });
    linkAltSearch?.addEventListener('input', linkAltRenderList);

    document.addEventListener('click', (event) => {
      const btn = event.target.closest?.('.btn-link-alternatives');
      if (!btn) return;
      event.preventDefault();
      event.stopPropagation();
      openLinkAlternativesModal(btn.getAttribute('data-id'));
    });

    async function openLinkAlternativesModal(id) {
      if (!id) return;
      linkAltProductId = id;
      linkAltLinkedIds = new Set();
      linkAltRoles = { ...LINK_ALT_ROLES_EMPTY };
      if (linkAltStatus) { linkAltStatus.hidden = true; }
      if (linkAltSearch) linkAltSearch.value = '';
      const nameEl = document.getElementById('linkAltProductName');
      if (nameEl) nameEl.textContent = '';
      openAdminModal(linkAlternativesModal);
      try {
        const res = await fetch(`/api/admin/alternatives?id=${encodeURIComponent(id)}`, { cache: 'no-store' });
        const data = await res.json();
        if (!data.success) {
          if (linkAltSuggestions) linkAltSuggestions.innerHTML = `<p class="text-muted">${escapeHtml(data.message || 'Error cargando alternativas.')}</p>`;
          return;
        }
        if (nameEl) nameEl.textContent = data.product?.title || id;
        linkAltLinkedIds = new Set([
          ...(data.product?.alternative_product_ids || []),
          ...(data.linked || []).map((p) => p.id),
        ]);
        // Catálogo para el modal: sugerencias primero, después el resto de productos.
        const suggestedIds = new Set((data.suggestions || []).map((s) => s.id));
        linkAltCatalog = [
          ...(data.suggestions || []),
          ...(currentProducts || []).filter((p) => !suggestedIds.has(p.id)).map((p) => ({
            id: p.id, title: p.title, price: p.price, image: p.image, category: p.category,
          })),
        ];
        // Selección de roles: primero la del servidor (con los arrays), después
        // la que traiga el producto (formato legado singular).
        const serverRoles = data.roles || {};
        const alts = data.product?.alternatives || {};
        // Prioridad: lo que devuelve el servidor (arrays) → arrays guardados en
        // el producto → valor legado singular (un único id).
        const listOf = (serverArray, arrayField, singularField) => {
          if (Array.isArray(serverArray) && serverArray.length) return serverArray.filter(Boolean);
          const stored = Array.isArray(alts[arrayField]) ? alts[arrayField].filter(Boolean) : [];
          if (stored.length) return stored;
          return alts[singularField] ? [alts[singularField]] : [];
        };
        linkAltRoles = {
          premiumOptionId: serverRoles.premiumOptionId || alts.premiumOptionId || '',
          cheaperOptionIds: listOf(serverRoles.cheaperOptionIds, 'cheaperOptionIds', 'cheaperOptionId'),
          similarOptionIds: listOf(serverRoles.similarOptionIds, 'similarOptionIds', 'similarOptionId'),
        };
        // Los roles se re-pintan en linkAltRenderList.
        linkAltRenderList();
        // El servidor rellena sólo cuando faltaba selección: se avisa para que
        // se revise antes de confirmar.
        if (serverRoles.auto && linkAltStatus) {
          linkAltStatus.hidden = false;
          linkAltStatus.className = 'admin-modal-status is-ok';
          linkAltStatus.textContent = 'Selección automática aplicada (vínculos y roles ya guardados): revisa, ajusta lo que quieras y pulsa «Guardar vínculos» para confirmar.';
        }
      } catch {
        if (linkAltSuggestions) linkAltSuggestions.innerHTML = '<p class="text-muted">Error de red cargando el catálogo.</p>';
      }
    }

    document.getElementById('btnLinkAltSave')?.addEventListener('click', async () => {
      if (!linkAltProductId) return;
      const ids = Array.from(linkAltLinkedIds);
      const roleSingle = (selectId) => document.getElementById(selectId)?.value || null;
      const roleMulti = (selectId) =>
        Array.from(document.getElementById(selectId)?.selectedOptions || [])
          .map((option) => option.value)
          .filter(Boolean);
      try {
        const res = await fetch('/api/admin/alternatives', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: linkAltProductId,
            alternativeProductIds: ids,
            premiumOptionId: roleSingle('linkAltRolePremium'),
            cheaperOptionIds: roleMulti('linkAltRoleCheap'),
            similarOptionIds: roleMulti('linkAltRoleSimilar'),
          }),
        });
        const data = await res.json();
        if (data.success) {
          if (linkAltStatus) { linkAltStatus.hidden = false; linkAltStatus.className = 'admin-modal-status is-ok'; linkAltStatus.textContent = data.message || 'Vínculos guardados.'; }
          await reloadProductsTable();
          setTimeout(() => closeAdminModal(linkAlternativesModal), 600);
        } else {
          if (linkAltStatus) { linkAltStatus.hidden = false; linkAltStatus.className = 'admin-modal-status is-error'; linkAltStatus.textContent = data.message || 'No se pudieron guardar los vínculos.'; }
        }
      } catch {
        if (linkAltStatus) { linkAltStatus.hidden = false; linkAltStatus.className = 'admin-modal-status is-error'; linkAltStatus.textContent = 'Error de red al guardar.'; }
      }
    });

    loadCategories();

    // =========================================================================
    // TRANSPARENCIA Y PIPELINE (métricas de auditoría + reproceso)
    // =========================================================================
    const tpApproved = document.getElementById('tpApproved');
    const tpRejected = document.getElementById('tpRejected');
    const tpPending = document.getElementById('tpPending');
    const tpScore = document.getElementById('tpScore');
    const tpDupes = document.getElementById('tpDupes');
    const tpLastRun = document.getElementById('tpLastRun');
    const tpReasons = document.getElementById('tpReasons');
    const tpReasonsList = document.getElementById('tpReasonsList');
    const tpResults = document.getElementById('tpResults');
    const tpResultsBody = document.getElementById('tpResultsBody');
    const tpStatus = document.getElementById('tpStatus');
    const tpStatusIcon = document.getElementById('tpStatusIcon');
    const tpStatusTitle = document.getElementById('tpStatusTitle');
    const tpStatusText = document.getElementById('tpStatusText');
    const tpEnrich = document.getElementById('tpEnrich');
    const btnPipelineRefresh = document.getElementById('btnPipelineRefresh');
    const btnPipelineDryRun = document.getElementById('btnPipelineDryRun');
    const btnPipelineRun = document.getElementById('btnPipelineRun');

    const TP_REASON_LABELS = {
      'rating-insuficiente': 'Valoración insuficiente',
      'pocas-resenas': 'Pocas reseñas',
      'sin-descuento-verificado': 'Sin descuento verificado',
      'vendedor-no-verificado': 'Vendedor no verificado',
      'sin-datos-suficientes': 'Sin datos suficientes',
    };

    function tpShowStatus(kind, title, text) {
      if (!tpStatus) return;
      tpStatus.hidden = false;
      tpStatusIcon.textContent = kind === 'ok' ? '✅' : kind === 'error' ? '⚠️' : 'ℹ️';
      tpStatusTitle.textContent = title;
      tpStatusText.textContent = text;
    }

    function tpFormatDate(value) {
      if (!value) return 'Nunca';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value);
      return date.toLocaleString('es-ES', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
    }

    async function tpLoadMetrics() {
      try {
        const res = await fetch('/api/admin/pipeline', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'No se pudieron leer las métricas.');
        if (tpApproved) tpApproved.textContent = data.approved ?? 0;
        if (tpRejected) tpRejected.textContent = data.rejected ?? 0;
        if (tpPending) tpPending.textContent = data.pending ?? 0;
        if (tpScore) tpScore.textContent = data.avg_audit_score ?? 0;
        if (tpDupes) tpDupes.textContent = data.duplicates_discarded ?? 0;
        if (tpLastRun) tpLastRun.textContent = tpFormatDate(data.last_run);
        const reasons = data.by_reason || {};
        const entries = Object.entries(reasons);
        if (tpReasons && tpReasonsList) {
          tpReasons.hidden = entries.length === 0;
          tpReasonsList.innerHTML = entries
            .sort((a, b) => b[1] - a[1])
            .map(([reason, count]) => `<span class="tp-reason-chip"><strong>${escapeHtml(count)}</strong> ${escapeHtml(TP_REASON_LABELS[reason] || reason)}</span>`)
            .join('');
        }
      } catch (err) {
        tpShowStatus('error', 'Error al leer las métricas', err?.message || 'Fallo de red.');
      }
    }

    async function tpRunPipeline(dryRun) {
      const btn = dryRun ? btnPipelineDryRun : btnPipelineRun;
      const spinner = btn ? btn.querySelector('.btn-spinner') : null;
      const text = btn ? btn.querySelector('.btn-text') : null;
      const original = text ? text.textContent : '';
      if (btn) btn.disabled = true;
      if (spinner) spinner.hidden = false;
      if (text) text.textContent = dryRun ? 'Simulando…' : 'Reprocesando…';
      try {
        const res = await fetch('/api/admin/pipeline', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: 'reprocess', dryRun: dryRun === true, enrich: tpEnrich ? tpEnrich.checked : false }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'El pipeline no pudo ejecutarse.');
        const rows = Array.isArray(data.results) ? data.results : [];
        if (tpResultsBody) {
          tpResultsBody.innerHTML = rows
            .map((row) => {
              const status = row.audit_status || (row.duplicate ? 'duplicado' : '—');
              const reason = row.duplicate_reason ? `Duplicado (${row.duplicate_reason})` : (row.message || '');
              return `<tr>
                <td>${escapeHtml(row.title || row.id || '—')}</td>
                <td><span class="tp-badge is-${escapeHtml(status)}">${escapeHtml(status)}</span></td>
                <td class="text-right">${row.audit_score != null ? escapeHtml(row.audit_score) : '—'}</td>
                <td>${escapeHtml(reason)}</td>
              </tr>`;
            })
            .join('');
        }
        if (tpResults) tpResults.hidden = rows.length === 0;
        tpShowStatus(
          'ok',
          dryRun ? 'Simulación terminada (no se ha escrito nada)' : 'Catálogo reprocesado',
          `${data.processed ?? 0} de ${data.total ?? 0} productos procesados${data.failed ? ` · ${data.failed} con error` : ''}.`
        );
        await tpLoadMetrics();
        if (!dryRun) await reloadProductsTable();
      } catch (err) {
        tpShowStatus('error', 'Error al ejecutar el pipeline', err?.message || 'Fallo de red.');
      } finally {
        if (btn) btn.disabled = false;
        if (spinner) spinner.hidden = true;
        if (text) text.textContent = original;
      }
    }

    btnPipelineRefresh?.addEventListener('click', () => tpLoadMetrics());
    btnPipelineDryRun?.addEventListener('click', () => tpRunPipeline(true));
    btnPipelineRun?.addEventListener('click', () => {
      const ok = window.confirm('Se reprocesará todo el catálogo (auditoría, tags y score). ¿Continuar?');
      if (ok) tpRunPipeline(false);
    });
    if (btnPipelineRefresh) tpLoadMetrics();
  });
</script>

<style>
