            <button type="button" id="btnAiConsoleOpen2" class="btn-ai btn-sm" title="Abre la consola de IA interactiva (chat con los proveedores conectados y ejecución del asistente local opencode)">🤖 Consola IA</button>
          </div>
          <div id="tpAiProviders" class="tp-ai-providers">
