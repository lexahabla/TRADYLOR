                <span class="label-hint">Se muestra en checkout (ej: «Envío en 15 días»)</span>
              </label>
              <input type="text" id="prodShippingInfo" placeholder="Envío en X días / Envío estándar" />
            </div>
            <div class="form-group">
              <label for="prodShippingDays" class="field-label">
