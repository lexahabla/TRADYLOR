    let aliVisible = [];
    /** Productos por página de la tabla de afiliados (25 / 50 / 75). */
    let aliPageSize = 50;
    let aliPage = 1;
    let aliSyncing = false;
    let aliImportingSelection = false;
    const aliSelected = new Set();

    // ✕ de la tabla: el producto se marca como DESCARTADO (estado `DISCARDED`)
    // en lugar de borrarse de la caché, así el filtro «Estado › Descartados»
    // permite revisarlo y recuperarlo. «Sincronizar» lo levanta. Vive en
    // localStorage para que el descarte sobreviva a recargas del panel.
    const AC_REMOVED_KEY = 'tradylor_ac_removed';
    function acRemovedGet() {
      try {
        return new Set(JSON.parse(localStorage.getItem(AC_REMOVED_KEY) || '[]'));
      } catch {
        return new Set();
      }
    }
    function acRemovedSave(set) {
      try {
        localStorage.setItem(AC_REMOVED_KEY, JSON.stringify([...set]));
      } catch { /* almacenamiento no disponible */ }
    }

    /**
     * Estado de importación de cada producto del catálogo AliExpress.
     *  - DISCARDED: ocultado con la ✕ de la tabla (se conserva en la caché para
     *    poder recuperarlo con el filtro «Descartados»).
     *  - IMPORTED: su URL de afiliado o su título ya está en el catálogo Tradylor.
     *  - PENDING:  el resto.
     */
    function aliNormKey(value) {
      return String(value || '')
        .trim()
        .toLowerCase()
        .replace(/^https?:\/\/(www\.)?/, '')
        .replace(/[?#].*$/, '')
        .replace(/\/+$/, '');
    }

    /** Título normalizado (minúsculas, sin acentos ni puntuación). */
    function aliNormTitle(value) {
      return String(value || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    /** Tokens significativos de un título (>2 caracteres). */
    function aliTitleTokens(value) {
      const t = aliNormTitle(value);
      return t ? t.split(' ').filter((tok) => tok.length > 2) : [];
    }

    /** ID del artículo (Item ID de AliExpress / ASIN) extraído de una URL. */
    function aliItemIdOf(value) {
      const raw = String(value || '');
      if (!raw) return '';
      const m =
        raw.match(/\/item\/(?:[^/?#]*\/)?(?:ae01_)?(\d{6,20})/i) ||
        raw.match(/\/i\/(\d{6,20})(?:[/?#]|$)/i) ||
        raw.match(/[?&](?:itemId|productId|productIdList)=(\d{6,20})/i) ||
        raw.match(/\/(?:dp|gp\/product|product)\/([A-Z0-9]{10})(?:[/?#]|$)/i) ||
        raw.match(/[?&]asin=([A-Z0-9]{10})/i);
      return m ? m[1] || '' : '';
    }

    /** Clave comparable de un ID externo (sin prefijo «AE-» ni espacios). */
    function aliIdKey(value) {
      return String(value || '')
        .trim()
        .toUpperCase()
        .replace(/^AE-?/, '');
    }

    /**
     * Estado de importación de cada producto del catálogo de afiliados.
     *  - DISCARDED: ocultado con la ✕ de la tabla (se conserva en la caché para
     *    poder recuperarlo con el filtro «Descartados»).
     *  - IMPORTED: ya existe en el catálogo Tradylor.
     *  - PENDING:  el resto.
     *
     * El «ya existe» NO depende sólo de la URL: las filas importadas antes de
     * persistir `sourceId` traen el enlace corto de afiliado (que cambia) o un
     * título reescrito por IA. Por eso se comparan varias claves en orden:
     *   1. sourceId / ID externo (ASIN · Item ID)
     *   2. URL canónica (host + ruta, sin parámetros de tracking)
     *   3. ID del artículo extraído de cualquier URL
     *   4. imagen única del producto (mismo CDN, sin placeholders)
     *   5. título normalizado (sin acentos ni puntuación)
     *   6. coincidencia difusa de títulos (≥3 tokens comunes y ≥60 % de solape)
     */
    function aliBuildEstadoIndex() {
      const index = new Map();
      const removed = acRemovedGet();

      // ── Índice del catálogo registrado (multi-clave) ──────────────────────
      const idKeys = new Set();
      const urlKeys = new Set();
      const itemIds = new Set();
      const imageKeys = new Set();
      const titleKeys = new Set();
      const catalogTokens = [];

      const imageCount = new Map();
      for (const item of currentProducts) {
        const img = aliNormKey(item.image || '');
        if (img && !img.includes('unsplash')) imageCount.set(img, (imageCount.get(img) || 0) + 1);
      }

      // Precomputación optimizada de tokens (Sets únicos sin allocs en el bucle interno)
      const catalogTokenSets = [];
      for (const item of currentProducts) {
        for (const rawId of [item.sourceId, item.asin]) {
          const key = aliIdKey(rawId);
          if (key) idKeys.add(key);
        }
        for (const url of [item.affiliateUrl, item.buyNowUrl, item.url]) {
          if (!url) continue;
          urlKeys.add(aliNormKey(url));
          const itemId = aliIdKey(aliItemIdOf(url));
          if (itemId) itemIds.add(itemId);
        }
        const img = aliNormKey(item.image || '');
        if (img && !img.includes('unsplash') && imageCount.get(img) === 1) imageKeys.add(img);
        const titleKey = aliNormTitle(item.title);
        if (titleKey) {
          titleKeys.add(`t:${titleKey}`);
          const toks = aliTitleTokens(titleKey);
          if (toks.length >= 3) {
            catalogTokenSets.push({ tokens: toks, set: new Set(toks), len: toks.length });
          }
        }
      }

      for (const product of aliProducts) {
        if (removed.has(product.externalId)) {
          index.set(product.externalId, 'DISCARDED');
          continue;
        }

        const urls = [
          product.productUrl,
          product.extra && product.extra['Enlace de afiliado'],
          product.extra && product.extra['URL del producto'],
        ]
          .filter(Boolean)
          .map(String);

        const externalKey = aliIdKey(product.externalId);
        let imported =
          Boolean(externalKey && idKeys.has(externalKey)) ||
          urls.some((url) => urlKeys.has(aliNormKey(url))) ||
          urls.some((url) => {
            const itemId = aliIdKey(aliItemIdOf(url));
            return Boolean(itemId && itemIds.has(itemId));
          }) ||
          Boolean(product.image && imageKeys.has(aliNormKey(product.image)));

        if (!imported) {
          const aliTitleKey = aliNormTitle(product.title);
          if (aliTitleKey && titleKeys.has(`t:${aliTitleKey}`)) {
            imported = true;
          } else if (aliTitleKey && catalogTokenSets.length && currentProducts.length <= 20000) {
            // Último recurso: el título de la ficha fue reescrito por la IA de
            // enriquecimiento y ya no coincide literalmente con el de la tabla.
            const aliTokens = aliTitleTokens(aliTitleKey);
            const aliLen = aliTokens.length;
            if (aliLen >= 3) {
              for (let i = 0; i < catalogTokenSets.length; i++) {
                const catItem = catalogTokenSets[i];
                if (Math.abs(catItem.len - aliLen) / Math.max(catItem.len, aliLen) > 0.4) continue;
                let common = 0;
                for (let j = 0; j < aliTokens.length; j++) {
                  if (catItem.set.has(aliTokens[j])) common++;
                }
                const minLen = Math.min(aliLen, catItem.len);
                if (common >= 3 && common / minLen >= 0.6) {
                  imported = true;
                  break;
                }
              }
            }
          }
        }

        index.set(product.externalId, imported ? 'IMPORTED' : 'PENDING');
      }
      return index;
    }

    /** Mapa externalId → estado (se recalcula sólo si cambió algo). */
    function aliEstadoIndex() {
      if (!aliEstadoCache) aliEstadoCache = aliBuildEstadoIndex();
      return aliEstadoCache;
    }

    function aliInvalidateEstado() {
      aliEstadoCache = null;
    }

    function showAliStatus(type, title, message) {
      if (!aliCatalogStatus) return;
      aliCatalogStatus.hidden = false;
      aliCatalogStatus.className = `status-alert alert-${type}`;
      if (aliCatalogStatusIcon) {
        aliCatalogStatusIcon.textContent = type === 'success' ? '✅' : type === 'error' ? '❌' : type === 'warning' ? '⚠️' : 'ℹ️';
      }
      if (aliCatalogStatusTitle) aliCatalogStatusTitle.textContent = title;
      if (aliCatalogStatusText) aliCatalogStatusText.textContent = message;
    }

    function aliRelTime(iso) {
      const then = new Date(iso).getTime();
      if (!Number.isFinite(then)) return 'sin fecha';
      const mins = Math.max(0, Math.round((Date.now() - then) / 60000));
      if (mins < 1) return 'ahora mismo';
      if (mins < 60) return `hace ${mins} min`;
      const hours = Math.round(mins / 60);
      if (hours < 24) return `hace ${hours} h`;
      return `hace ${Math.round(hours / 24)} d`;
    }

    /** «17/10/2026 02:10 · hace 3 h»; `null` si no hay fecha (la fila de detalle se omite). */
    function aliFmtDate(iso) {
      const time = iso ? new Date(iso).getTime() : NaN;
      if (!Number.isFinite(time)) return null;
      const label = new Date(time).toLocaleString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      return `${label} · ${aliRelTime(iso)}`;
    }

    function aliExtra(product, key) {
      const value = (product.extra || {})[key];
      return value == null || value === '' ? null : value;
    }

    /** Patrón de detección de segunda mano (mismo criterio que prodMatchesPreset). */
    const ALI_USED_CONDITION_RE = /used|pre-owned|refurbished|reacondicionad|segunda\s*mano|usad[oa]|open\s*box|seminuev/i;

    /** Pastilla de «Estado» (Nuevo/Usado/...) para la tabla de Importar. */
    function aliConditionBadge(product) {
      const raw = aliExtra(product, 'Estado') || aliExtra(product, 'Condición') || aliExtra(product, 'Condition');
      if (!raw) return '<span class="cond-pill cond-unknown">—</span>';
      const isUsed = ALI_USED_CONDITION_RE.test(String(raw));
      if (isUsed) return '<span class="cond-pill cond-used" title="Reacondicionado por el vendedor">RxV</span>';
      const text = escapeHtml(String(raw));
      return `<span class="cond-pill cond-new">${text}</span>`;
    }

    function aliDiscount(product) {
      const raw = aliExtra(product, 'Descuento');
      if (raw) return `${String(raw).replace('%', '')}%`;
      const price = Number(product.price);
      const original = Number(product.originalPrice);
      if (price > 0 && original > price) return `${Math.round(((original - price) / original) * 100)}%`;
      return null;
    }

    /**
     * Barra de filtros (#aliFilters): 3 capas (presets → controles → panel
     * avanzado). Toda la lógica y el contrato `ProductFilterParams` viven en
     * `src/utils/aliCatalogFilters.ts`; aquí sólo se le aportan los datos del
     * panel (catálogo, estado de importación) y el repintado de la tabla.
     */

    function mountAliFilterBar() {
      const bridge = window.tradylorAliFilters;
      if (!bridge || typeof bridge.mountAliFilters !== 'function') {
        console.warn('[AliFilters] Módulo de filtros no disponible: la tabla se mostrará sin filtrar.');
        return null;
      }
      return bridge.mountAliFilters({
        getProducts: () => aliProducts,
        getEstadoIndex: () => aliEstadoIndex(),
        onChange: onAliFilterChange,
        getNetworkLabel: (id) => {
          const match = (networksCache || []).find((n) => n.id === id);
          return match ? match.name : id;
        },
      });
    }

    /**
     * Filtra y ordena el catálogo completo con los filtros activos.
     * Se usa también para la selección masiva («todos los filtrados»).
     */
    function aliFilterApply() {
      if (aliFilterPanel) return aliFilterPanel.filter(aliProducts);
      return aliProducts.slice();
    }

    function aliUpdateSelectionUI(pageIds) {
      if (aliSelectionBar) aliSelectionBar.hidden = aliSelected.size === 0;
      if (aliSelCount) aliSelCount.textContent = `${aliSelected.size} seleccionado${aliSelected.size === 1 ? '' : 's'}`;
      const master = aliCatalogHost?.querySelector('[data-ac-checkall]');
      if (master && pageIds) {
        const checked = pageIds.filter((id) => aliSelected.has(id)).length;
        master.checked = checked > 0 && checked === pageIds.length;
        master.indeterminate = checked > 0 && checked < pageIds.length;
      }
    }

    function aliPagerHtml(page, pages, total, start, shown) {
      if (total === 0) return '';
      const info = `<span class="ac-page-info">Mostrando ${start + 1}–${start + shown} de ${total}</span>`;
      const perPage = `<label class="ac-per-page" title="Elige cuántos productos quieres ver por página">Por página
        <select data-ac-per-page aria-label="Productos por página" style="padding: 0px;">
          ${[25, 50, 75].map((n) => `<option value="${n}"${n === aliPageSize ? ' selected' : ''}>${n}</option>`).join('')}
        </select></label>`;
      if (pages <= 1) return `<div class="ac-pager">${info}${perPage}</div>`;
      const btn = (label, target, opts = {}) =>
        `<button type="button" class="ac-page-btn${opts.current ? ' is-current' : ''}" data-ac-page="${target}"${opts.disabled ? ' disabled' : ''}${opts.title ? ` title="${opts.title}"` : ''}>${label}</button>`;
      const wanted = [...new Set([1, pages, page - 1, page, page + 1])]
        .filter((n) => n >= 1 && n <= pages)
        .sort((a, b) => a - b);
      const nums = [];
      wanted.forEach((n, index) => {
        if (index > 0 && n - wanted[index - 1] > 1) nums.push('<span class="ac-page-gap">…</span>');
        nums.push(btn(String(n), n, { current: n === page }));
      });
      return `<div class="ac-pager">${info}${perPage}<div class="ac-page-nav">${btn('‹', page - 1, { disabled: page <= 1, title: 'Página anterior' })}${nums.join('')}${btn('›', page + 1, { disabled: page >= pages, title: 'Página siguiente' })}${btn('⏭', pages, { disabled: page >= pages, title: 'Ir al final de la tabla' })}</div></div>`;
    }

    function renderAliCatalog() {
      if (!aliCatalogHost) return;
      // #affiliateFilters nunca se oculta: su primera fila (meta + Sincronizar)
      // debe estar siempre accesible, también con la caché vacía, para poder
      // lanzar la primera sincronización.
      // La barra de acciones sólo oculta su bloque de alta: la derecha
      // (meta + Sincronizar) debe estar siempre accesible, también con
      // la caché vacía, para poder lanzar la primera sincronización.
      if (aliImportTools) aliImportTools.hidden = aliProducts.length === 0;
      if (btnAliMore) btnAliMore.hidden = aliProducts.length === 0;
      if (!aliProducts.length) {
        aliVisible = [];
        aliCatalogHost.innerHTML = '<div class="empty-dashboard">Sin productos en la caché. Pulsa «Sincronizar» para descargar el catálogo de las redes conectadas por primera vez.</div>';
        aliUpdateSelectionUI([]);
        return;
      }
      const filtered = aliFilterApply();
      if (!filtered.length) {
        aliVisible = [];
        aliCatalogHost.innerHTML = `
          <div class="empty-dashboard">
            <p>Ningún producto coincide con los filtros activos.</p>
            <button type="button" class="btn-secondary btn-sm" data-ac-clear-filters>Limpiar filtros</button>
          </div>`;
        aliUpdateSelectionUI([]);
        return;
      }
      const pages = Math.max(1, Math.ceil(filtered.length / aliPageSize));
      if (aliPage > pages) aliPage = pages;
      const start = (aliPage - 1) * aliPageSize;
      const slice = filtered.slice(start, start + aliPageSize);
      aliVisible = slice;
      const pageIds = slice.map((product) => product.externalId);
      aliCatalogHost.innerHTML = `
        ${aliPagerHtml(aliPage, pages, filtered.length, start, slice.length)}
        <div class="products-table-responsive">
          <table class="products-table">
            <thead>
              <tr>
                <th class="ac-th-check"><input type="checkbox" data-ac-checkall aria-label="Seleccionar la página actual" /></th>
                <th>Foto</th>
                <th>Producto</th>
                <th>Estado</th>
                <th class="aff-num">Precio</th>
                <th class="aff-num">Precio orig.</th>
                <th class="aff-num">Dto.</th>
                <th class="aff-num">Comisión %</th>
                <th class="aff-num">Comisión €</th>
                <th class="aff-num">Ventas</th>
                <th class="aff-num">Valoración</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              ${slice
                .map((product, offset) => {
                  const index = offset;
                  const discount = aliDiscount(product);
                  const shippingDays = aliExtra(product, 'Días de envío');
                  const sales = product.popularity != null ? product.popularity : aliExtra(product, 'Ventas (30 días)');
                  const checked = aliSelected.has(product.externalId) ? ' checked' : '';
                  const estado = aliEstadoIndex().get(product.externalId);
                  const yaAnadido = estado === 'IMPORTED';
                  const estadoPill = estado === 'IMPORTED'
                    ? '<span class="ac-state is-imported">✓ en catálogo</span>'
                    : estado === 'DISCARDED'
                      ? '<span class="ac-state is-discarded">descartado</span>'
                      : '';
                  const addBtnClass = `btn-success btn-sm unified-import ali-import${yaAnadido ? ' is-added' : ''}`;
                  return `
                <tr class="aff-row" data-ac-row="${index}" data-ac-id="${escapeHtml(product.externalId)}" tabindex="0" aria-expanded="false">
                  <td class="ac-td-check"><input type="checkbox" data-ac-check="${index}" aria-label="Seleccionar producto" ${checked} /></td>
                  <td><span class="aff-thumb">${product.image ? `<img src="${escapeHtml(product.image)}" alt="" loading="lazy" />` : ''}</span></td>
                  <td class="aff-name">
                    <strong>${escapeHtml(product.title)}</strong>
                    <span>${escapeHtml(product.network)}${product.category ? ` · ${escapeHtml(product.category)}` : ''}${estadoPill}</span>
                  </td>
                  <td>${aliConditionBadge(product)}</td>
                  <td class="aff-num">${money(product.price, product.currency)}</td>
                  <td class="aff-num">${product.originalPrice != null ? money(product.originalPrice, product.currency) : '—'}</td>
                  <td class="aff-num ac-discount">${discount ? escapeHtml(discount) : '—'}</td>
                  <td class="aff-num">${product.commissionRate != null ? `${product.commissionRate}%` : '—'}</td>
                  <td class="aff-num">${product.commissionAmount != null ? money(product.commissionAmount, product.currency) : '—'}</td>
                  <td class="aff-num">${sales != null ? sales : '—'}</td>
                  <td class="aff-num">${product.rating != null ? `${product.rating} / 5` : '—'}</td>
                    <td class="aff-actions">
                      <button type="button" class="${addBtnClass}" data-ac-import="${index}"${yaAnadido ? ' disabled title="Ya está en el catálogo"' : ''}>${yaAnadido ? 'Añadido' : 'Añadir'}</button>
                      <button type="button" class="btn-danger-ghost btn-sm" data-ac-remove="${index}" title="Quitar de la tabla">✕</button>
                      <button type="button" class="aff-caret" data-ac-toggle="${index}" aria-label="Ver todos los datos">▸</button>
                    </td>
                </tr>
                <tr class="aff-detail" data-ac-detail="${index}" hidden>
                  <td colspan="${ALI_COLS}"><dl class="aff-detail-grid">${productDetailRows(product)}</dl></td>
                </tr>`;
                })
                .join('')}
            </tbody>
          </table>
        </div>
        ${aliPagerHtml(aliPage, pages, filtered.length, start, slice.length)}`;
      aliUpdateSelectionUI(pageIds);
    }

    function setAliMeta(state) {
      if (!aliCatalogMeta) return;
      const text = (!state || !state.count)
        ? 'Sin sincronizar'
        : `${state.count} productos · ${aliRelTime(state.syncedAt)}${state.stale ? ' · obsoleto' : ''}`;
      aliCatalogMeta.textContent = text;
      if (aliCatalogMetaTop) aliCatalogMetaTop.textContent = text;
      if (aliCatalogDanger) aliCatalogDanger.hidden = !(state && state.count);
    }

    /**
     * Refresca `currentProducts` (el catálogo REAL de Tradylor) desde el
     * servidor antes de calcular qué productos de Importar ya están
     * "Añadido". Sin esto, si el catálogo se vació desde la pestaña
     * «Catálogo» (u otra pestaña/sesión) la comparación podía usar una copia
     * en memoria desactualizada y marcar como ya añadidos productos que en
     * realidad ya no existen en products.json.
     */
    async function refreshCurrentProductsQuiet() {
      try {
        const res = await fetch('/api/products/add');
        const data = await res.json();
        if (data && data.success && Array.isArray(data.products)) {
          currentProducts = data.products;
        }
      } catch (_) {
        // Fallo de red: se sigue trabajando con lo que ya hubiera en memoria.
      } finally {
        // Se invalida SIEMPRE (haya fallado o no la recarga): lo que cambió
        // de verdad (aliProducts, tras un sync) también obliga a recalcular.
        aliInvalidateEstado();
      }
    }

    /** GET de la caché: ultra-rápido con sesión local + ETag en servidor. */
    async function loadAliCatalog() {
      // El catálogo real (products.json) se refresca EN PARALELO: no bloquea
      // la hidratación instantánea de abajo (sigue pintando en 0 ms); antes
      // del render definitivo (tras resolver /api/admin/catalog) se espera a
      // que termine, para que el estado «Añadido»/«Añadir» de cada fila
      // refleje lo que de verdad hay en el catálogo en este mismo instante.
      const currentProductsRefresh = refreshCurrentProductsQuiet();

      // 1. Hidratación instantánea desde caché de sesión local (render en 0 ms)
      if (!aliProducts || aliProducts.length === 0) {
        try {
          const cachedRaw = sessionStorage.getItem('tradylor_aff_catalog_cache');
          if (cachedRaw) {
            const cachedData = JSON.parse(cachedRaw);
            if (cachedData && Array.isArray(cachedData.products)) {
              aliProducts = cachedData.products;
              aliPage = 1;
              aliInvalidateEstado();
              aliFilterPanel?.refresh();
              setAliMeta(cachedData);
              renderAliCatalog();
            }
          }
        } catch (_) {}
      }

      try {
        const res = await fetch('/api/admin/catalog', {
          headers: { Accept: 'application/json' },
          cache: 'default',
        });
        if (res.status === 304) {
          // El catálogo no ha cambiado en el servidor
          await currentProductsRefresh;
          return;
        }
        const data = await res.json();
        if (!res.ok || !data.success) {
          if (!aliProducts || aliProducts.length === 0) {
            if (aliCatalogHost) aliCatalogHost.innerHTML = '<div class="empty-dashboard">No se pudo leer la caché del catálogo.</div>';
          }
          await currentProductsRefresh;
          return data;
        }

        aliProducts = Array.isArray(data.products) ? data.products : [];
        try {
          sessionStorage.setItem('tradylor_aff_catalog_cache', JSON.stringify({
            count: data.count,
            syncedAt: data.syncedAt,
            stale: data.stale,
            networks: data.networks,
            products: aliProducts,
          }));
        } catch (_) {}

        aliPage = 1;
        // Para el render DEFINITIVO (no el instantáneo de arriba) sí se
        // espera a tener el catálogo real al día.
        await currentProductsRefresh;
        aliFilterPanel?.refresh();
        setAliMeta(data);
        renderAliCatalog();
        const connected = Array.isArray(data.networks) ? data.networks : [];
        // Poblar selector de red para sincronización individual
        if (aliSyncNetwork) {
          const currentValue = aliSyncNetwork.value;
          aliSyncNetwork.innerHTML = '<option value="">Todas las conectadas</option>' +
            connected.map((netId) => {
              const net = (networksCache || []).find((n) => n.id === netId);
              const label = net ? net.name : netId;
              return `<option value="${escapeHtml(netId)}">${escapeHtml(label)}</option>`;
            }).join('');
          if (currentValue && Array.from(aliSyncNetwork.options).some((o) => o.value === currentValue)) {
            aliSyncNetwork.value = currentValue;
          }
        }
        if (!connected.length) showAliStatus('warning', 'Sin redes conectadas', 'Guarda las credenciales de AliExpress, eBay u otras redes en «1. Redes conectadas» y pulsa «Validar» para poder sincronizar.');
        else if (!data.count) showAliStatus('warning', 'Caché vacía', 'Todavía no hay productos guardados. Pulsa «Sincronizar» para descargar el catálogo.');
        else if (data.stale) showAliStatus('warning', 'Caché obsoleta', `El catálogo guardado tiene más de 6 horas (${aliRelTime(data.syncedAt)}). Pulsa «Sincronizar» para refrescarlo.`);
        else showAliStatus('success', 'Caché al día', `${data.count} productos guardados, sincronizados ${aliRelTime(data.syncedAt)}.`);
        return data;
      } catch {
        if (!aliProducts || aliProducts.length === 0) {
          if (aliCatalogHost) aliCatalogHost.innerHTML = '<div class="empty-dashboard">Fallo de red al leer la caché del catálogo.</div>';
        }
        return null;
      }
    }

    /** POST de sincronización: valida si hace falta, consulta la TOP API y reescribe el JSON. */
    async function syncAliCatalogUI(networkId) {
      if (aliSyncing) return null;
      aliSyncing = true;
      // Ambos botones (el de la fila de filtros y la copia de acceso rápido
      // junto a #aliCatalogStatus) comparten el mismo estado de carga; cada
      // uno conserva su propia etiqueta inactiva ("Sincronizar" / "Sincronizar
      // Redes") para restaurarla al terminar.
      const syncBtnParts = aliSyncButtons.map((btn) => {
        const text = btn.querySelector('.btn-text');
        return { btn, spinner: btn.querySelector('.btn-spinner'), text, idleLabel: text ? text.textContent : '' };
      });
      syncBtnParts.forEach(({ btn, spinner, text }) => {
        btn.disabled = true;
        if (spinner) spinner.hidden = false;
        if (text) text.textContent = 'Sincronizando...';
      });
      try {
        // Auto-validación solo si NO se ha seleccionado una red específica (comportamiento legacy)
        // Si se elige una red concreta, solo validamos esa red.
        const targetNetwork = networkId ?? aliSyncNetwork?.value ?? '';
        if (!targetNetwork) {
          // Modo "Todas": validar AliExpress si está en la lista (comportamiento legacy)
          const aliNet = (networksCache || []).find((n) => n.id === 'aliexpress');
          if (aliNet && aliNet.status !== 'connected') {
            showAliStatus('loading', 'Validando credenciales', 'Comprobando la conexión con AliExpress antes de sincronizar...');
            const check = await validateNetwork('aliexpress');
            const now = (check?.networks || []).find((n) => n.id === 'aliexpress');
            if (!now || now.status !== 'connected') {
              showAliStatus('error', 'AliExpress sin conectar', check?.message || 'Guarda y valida sus credenciales en «1. Redes conectadas».');
              return null;
            }
          }
        } else if (targetNetwork === 'aliexpress') {
          // Si se elige explícitamente AliExpress, validar solo esa red
          const aliNet = (networksCache || []).find((n) => n.id === 'aliexpress');
          if (aliNet && aliNet.status !== 'connected') {
            showAliStatus('loading', 'Validando credenciales', 'Comprobando la conexión con AliExpress...');
            const check = await validateNetwork('aliexpress');
            const now = (check?.networks || []).find((n) => n.id === 'aliexpress');
            if (!now || now.status !== 'connected') {
              showAliStatus('error', 'AliExpress sin conectar', check?.message || 'Guarda y valida sus credenciales en «1. Redes conectadas».');
              return null;
            }
          }
        }
        showAliStatus('loading', 'Sincronizando catálogo', targetNetwork
          ? `Consultando la API de ${targetNetwork}...`
          : 'Consultando las redes conectadas en curso (puede tardar unos segundos)...');
        const res = await fetch('/api/admin/catalog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ networkId: targetNetwork || undefined })
        });
        const data = await res.json();
        // El sync re-trae el catálogo completo: se levantan los descartes locales.
        if (data.ok) acRemovedSave(new Set());
        aliProducts = Array.isArray(data.products) ? data.products : [];
        aliPage = 1;
        // Refresca el catálogo REAL antes de pintar: el estado «Añadido» de
        // cada fila tiene que reflejar lo que hay en products.json AHORA, no
        // una copia en memoria que pudo quedar desactualizada.
        await refreshCurrentProductsQuiet();
        aliFilterPanel?.refresh();
        setAliMeta(data);
        renderAliCatalog();
        if (data.ok) showAliStatus('success', 'Catálogo sincronizado', `${data.count} productos guardados en el servidor.`);
        else showAliStatus('error', 'No se pudo sincronizar', data.message || 'No se pudo sincronizar.');
        return data;
      } catch {
        showAliStatus('error', 'Fallo de red', 'No se pudo contactar con el servidor para sincronizar.');
        return null;
      } finally {
        aliSyncing = false;
        syncBtnParts.forEach(({ btn, spinner, text, idleLabel }) => {
          btn.disabled = false;
          if (spinner) spinner.hidden = true;
          if (text) text.textContent = idleLabel;
        });
      }
    }

    aliSyncButtons.forEach((btn) => btn.addEventListener('click', () => syncAliCatalogUI(aliSyncNetwork?.value || undefined)));

/** «Cargar más»: pide al servidor las páginas 2-3 de cada keyword y
