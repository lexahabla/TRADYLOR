            </div>
            <div class="form-group">
              <label for="prodReviews" class="field-label">
                <span>Nº de opiniones</span>
                <span class="label-hint">Total de reseñas del producto</span>
              </label>
              <input type="number" id="prodReviews" step="1" min="0" placeholder="Ej: 1234" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodAffiliateUrl" class="field-label">Enlace de Afiliado Final <span class="required">*</span></label>
              <input type="url" id="prodAffiliateUrl" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodBuyNowUrl" class="field-label">
                <span>Enlace de Compra Directa (Buy Now)</span>
                <span class="label-hint">Opcional: URL de pago inmediato (p. ej. checkout de Amazon). Tiene prioridad sobre el enlace de afiliado en «Comprar ya».</span>
              </label>
              <input type="url" id="prodBuyNowUrl" placeholder="https://www.amazon.es/checkout/... o https://www.amazon.es/dp/ASIN" />
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodShippingInfo" class="field-label">
