  /* Caja de Scraping */
  .scrape-box {
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .scrape-head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .scrape-head-row .field-label {
    flex: 1;
    min-width: 220px;
  }

  .scrape-head-row #btnNewProduct {
    flex-shrink: 0;
  }

