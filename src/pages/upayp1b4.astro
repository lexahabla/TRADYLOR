---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import AdminNav from '../components/AdminNav.astro';
import AdminUserMenu from '../components/AdminUserMenu.astro';
import TrafficSalesDashboard from '../components/admin/TrafficSalesDashboard.astro';
import fs from 'node:fs';
import { dataFile } from '../lib/paths';
import type { Product } from './api/products/add';
import { authenticateUser, clearAdminSession, createAdminSession, getSessionUser } from '../lib/adminAuth';
import { getAmazonAssociateTag } from '../utils/amazon';
import { enrichProductsForAdmin } from '../lib/curation';

const sessionUser = getSessionUser(Astro.request);
const isAuthenticated = sessionUser !== null;
let loginError = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = String(formData.get('action') ?? 'login');

  if (action === 'logout' && isAuthenticated) {
    return new Response(null, {
      status: 303,
      headers: { Location: '/upayp1b4', 'Set-Cookie': clearAdminSession() },
    });
  }

  const login = !isAuthenticated
    ? authenticateUser(String(formData.get('username') ?? '').trim(), String(formData.get('password') ?? ''))
    : null;

  if (login) {
    // Los usuarios sin rol admin sólo acceden a su perfil
    return new Response(null, {
      status: 303,
      headers: { Location: login.role === 'admin' ? '/upayp1b4' : '/upayp1b4/perfil', 'Set-Cookie': createAdminSession(login) },
    });
  }

  if (!isAuthenticated) loginError = 'El usuario o la contraseña no son correctos.';
}

// Un usuario sin rol admin no puede ver el catálogo: va a su perfil
if (sessionUser && sessionUser.role !== 'admin') {
  return new Response(null, { status: 303, headers: { Location: '/upayp1b4/perfil' } });
}

// El panel nunca se cachea: un deploy nuevo tiene que verse a la primera.
Astro.response.headers.set('Cache-Control', 'no-store');

// Leer productos almacenados para renderizar inicialmente en el servidor (SSR)
const DATA_FILE_PATH = dataFile('products.json');
// El enriquecimiento añade score, flags de duplicado y la RED de afiliados
// (`network` / `network_label`) que pinta la columna «Comercio».
type EnrichedProduct = ReturnType<typeof enrichProductsForAdmin>[number];
let initialProducts: EnrichedProduct[] = [];

try {
  if (fs.existsSync(DATA_FILE_PATH)) {
    const raw = fs.readFileSync(DATA_FILE_PATH, 'utf-8');
    initialProducts = JSON.parse(raw);
  }
} catch (error) {
  console.error('Error cargando products.json en admin:', error);
}
// Enriquecimiento SSR de curación (score de conversión + duplicados) para la
// primera pintura de la tabla; el cliente recalcula con cada recarga vía API.
initialProducts = enrichProductsForAdmin(initialProducts as Product[]);

// Paginación SSR: 50 productos por página
const PRODUCTS_PER_PAGE = 50;
const initialTotalProducts = initialProducts.length;
const initialTotalPages = Math.ceil(initialTotalProducts / PRODUCTS_PER_PAGE);
const initialPageProducts = initialProducts.slice(0, PRODUCTS_PER_PAGE);

const pageTitle = "Panel de Administración | Tradylor";
const pageDescription = "Gestión, scraping de metadatos y alta de productos con enlaces de afiliación en Tradylor.";

// El módulo "Tráfico y ventas" se muestra como una sección más del panel
const requestedSection = Astro.url.searchParams.get('section') || 'products';

const allowedSections = ['products', 'affiliates', 'categories', 'analytics', 'marketing', 'transparency'];
const initialSection = allowedSections.includes(requestedSection) ? requestedSection : 'products';
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="header-end">
    {isAuthenticated && sessionUser && <AdminUserMenu user={sessionUser} active={initialSection} />}
  </Fragment>
  {isAuthenticated && sessionUser ? (
  <div class="admin-wrapper">
    <!-- 1. HEADER DEL PANEL -->
    <header class="admin-header">
      <div class="admin-header-main">
        <div class="admin-tag-pill">Panel de control</div>
        <h1 class="admin-title">Panel de Administración de Productos</h1>
        <p class="admin-subtitle">
          Pega el enlace de cualquier comercio para autocompletar metadatos OpenGraph (título, imagen, precio). Edita y afina la ficha antes de guardarla de forma persistente.
        </p>
      </div>
    </header>

    <AdminNav context="catalogo" active={initialSection} user={sessionUser} />

    <!-- 2. SECCIÓN PRINCIPAL: FORMULARIO + LIVE PREVIEW -->
    <section data-admin-view="products" class:list={['admin-grid-section', 'hidden-section', { 'is-visible': initialSection === 'products' }]}>
      <!-- Columna 1: Formulario de Scraping y Edición -->
      <div class="admin-card form-card">
        <div class="card-header card-header-toggle">
          <div class="header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div>
            <h2 class="card-title">1. Extracción & Alta de Producto</h2>
            <p class="card-desc">Introduce la URL del producto para extraer metadatos automáticamente o rellenar de forma manual.</p>
          </div>
        </div>

        <!-- Barra de Scraping Rápido -->
        <div class="scrape-box form-toggle-body">
          <div class="scrape-head-row">
            <label for="inputScrapeUrl" class="field-label">
              <span>URL del Producto (Amazon, PcComponentes, etc.)</span>
              <span class="label-hint">Detección automática de OpenGraph</span>
            </label>
            <button
              type="button"
              id="btnNewProduct"
              class="btn-secondary btn-sm"
              title="Vacía todos los campos para dar de alta un producto individual"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              Nuevo Producto
            </button>
          </div>
          <div class="scrape-input-group">
            <div class="input-icon-wrapper">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </div>
            <input
              type="url"
              id="inputScrapeUrl"
              placeholder="Pega aquí la URL del producto"
              autocomplete="off"
            />
            <button type="button" id="btnScrape" class="btn-primary">
              <span class="btn-text">Analizar Enlace</span>
              <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <div class="btn-spinner" hidden></div>
            </button>
          </div>

          <!-- Mensaje de Feedback de Estado -->
          <div id="scrapeStatusAlert" class="status-alert" hidden>
            <div class="alert-icon" id="statusAlertIcon">ℹ️</div>
            <div class="alert-content">
              <strong id="statusAlertTitle">Estado</strong>
              <p id="statusAlertText">Mensaje...</p>
            </div>
          </div>
        </div>

        <!-- Formulario Editable del Producto -->
        <form id="productForm" class="product-edit-form form-toggle-body">
          <input type="hidden" id="prodId" value="" />

          <div class="form-basic-grid">
            <div class="form-fields">
          <!-- Zona de datos básicos + vista previa en 2 columnas -->
	          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodTitle" class="field-label">Título del Producto <span class="required">*</span></label>
              <input type="text" id="prodTitle" required />
            </div>
          </div>



<div class="form-row">
            <div class="form-group full-width">
              <label for="prodDescription" class="field-label">Descripción Técnica Concisa</label>
              <textarea id="prodDescription" rows="3"></textarea>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodVerdict" class="field-label">Veredicto Editorial de Tradylor</label>
              <textarea id="prodVerdict" rows="2"></textarea>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodTechSheet" class="field-label">
                <span>Ficha Técnica</span>
                <span class="label-hint">Se muestra en la página del producto (botón «Ver ficha técnica») · La IA puede generarlo</span>
              </label>
              <textarea
                id="prodTechSheet"
                rows="5"
                placeholder="Datos técnicos objetivos: materiales, medidas, peso, conectividad, compatibilidades, garantía, contenido de la caja..."
              ></textarea>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodSpecs" class="field-label">
                <span>Especificaciones (specs clave/valor)</span>
                <span class="label-hint">Una por línea como «Clave: Valor» · se muestran en la ficha pública</span>
              </label>
              <textarea
                id="prodSpecs"
                rows="4"
                placeholder="Marca: Samsung&#10;Pantalla: 6.7&quot; AMOLED&#10;Batería: 5000 mAh&#10;Garantía: 3 años"
              ></textarea>
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodPrice" class="field-label">Precio Oferta (€) <span class="required">*</span></label>
              <input type="number" step="0.01" min="0" id="prodPrice" required />
            </div>
            <div class="form-group">
              <label for="prodOriginalPrice" class="field-label">Precio Original (€) <span class="label-hint">(Tachado opcional)</span></label>
              <input type="number" step="0.01" min="0" id="prodOriginalPrice" />
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodCategory" class="field-label">
                <span>Categoría <span class="required">*</span></span>
                <span class="label-hint">Se cargan desde Categorías</span>
              </label>
              <input
                type="text"
                id="prodCategory"
                list="categoryList"
                placeholder="Selecciona o escribe una categoría"
                required
              />
              <datalist id="categoryList"></datalist>
            </div>
            <div class="form-group">
              <label for="prodSubcategory" class="field-label">
                <span>Subcategoría</span>
                <span class="label-hint">Opcional · depende de la categoría</span>
              </label>
              <select id="prodSubcategory">
                <option value="">Sin subcategoría</option>
              </select>
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodMerchant" class="field-label">Comercio / Tienda <span class="required">*</span></label>
              <select id="prodMerchant" required>
                <option value="" selected disabled>Selecciona un comercio</option>
                <option value="Amazon">Amazon</option>
                <option value="PcComponentes">PcComponentes</option>
                <option value="El Corte Inglés">El Corte Inglés</option>
                <option value="MediaMarkt">MediaMarkt</option>
                <option value="AliExpress">AliExpress</option>
                <option value="Fnac">Fnac</option>
                <option value="Otro">Otro Comercio</option>
              </select>
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodBrand" class="field-label">
                <span>Marca</span>
                <span class="label-hint">Se rellena al analizar el enlace</span>
              </label>
              <input type="text" id="prodBrand" placeholder="Ej: Samsung, Xiaomi, Anker..." />
            </div>
            <div class="form-group">
              <label for="prodFulfillment" class="field-label">
                <span>Distribuidor (envío y pago)</span>
                <span class="label-hint">Si está vacío se usa el comercio</span>
              </label>
              <input type="text" id="prodFulfillment" placeholder="Ej: Amazon, Marketplace del vendedor..." />
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodRating" class="field-label">
                <span>Valoración (0–5)</span>
                <span class="label-hint">Se muestra en la ficha y en las cards</span>
              </label>
              <input type="number" id="prodRating" step="0.1" min="0" max="5" placeholder="Ej: 4.7" />
            </div>
            <div class="form-group">
              <label for="prodReviews" class="field-label">
                <span>Nº de opiniones</span>
                <span class="label-hint">Total de reseñas del producto</span>
              </label>
              <input type="number" id="prodReviews" step="1" min="0" placeholder="Ej: 1234" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodAffiliateUrl" class="field-label">Enlace de Afiliado Final <span class="required">*</span></label>
              <input type="url" id="prodAffiliateUrl" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodBuyNowUrl" class="field-label">
                <span>Enlace de Compra Directa (Buy Now)</span>
                <span class="label-hint">Opcional: URL de pago inmediato (p. ej. checkout de Amazon). Tiene prioridad sobre el enlace de afiliado en «Comprar ya».</span>
              </label>
              <input type="url" id="prodBuyNowUrl" placeholder="https://www.amazon.es/checkout/... o https://www.amazon.es/dp/ASIN" />
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodShippingInfo" class="field-label">
                <span>Texto de envío</span>
                <span class="label-hint">Se muestra en checkout (ej: «Envío en 15 días»)</span>
              </label>
              <input type="text" id="prodShippingInfo" placeholder="Envío en X días / Envío estándar" />
            </div>
            <div class="form-group">
              <label for="prodShippingDays" class="field-label">
                <span>Días de envío</span>
                <span class="label-hint">Entero; alimenta el filtro de Afiliados</span>
              </label>
              <input type="number" step="1" min="0" id="prodShippingDays" placeholder="Ej: 15" />
            </div>
          </div>

          <div class="form-row">
            <label class="filter-check">
              <input type="checkbox" id="prodFreeShipping" />
              Envío gratis
            </label>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodImage" class="field-label">
                <span>Imagen del Producto</span>
                <span class="label-hint">URL o ruta local (opcional si la galería ya tiene imagen; la IA puede generarla)</span>
              </label>
              <input type="text" id="prodImage" placeholder="https://... o /images/products/..." />
            </div>
            <div class="form-group">
              <label for="prodBadge" class="field-label">Etiqueta Destacada (Badge)</label>
              <select id="prodBadge">
                <option value="">(ninguna)</option>
                <optgroup label="Atractivo de precio / Oferta">
                  <option value="Oferta -20%">Oferta -20%</option>
                  <option value="Chollo">Chollo</option>
                  <option value="Mínimo Histórico">Mínimo Histórico</option>
                </optgroup>
                <optgroup label="Prueba social / Popularidad">
                  <option value="Más Vendido">Más Vendido</option>
                  <option value="Recomendado">Recomendado</option>
                  <option value="Top Elección">Top Elección</option>
                </optgroup>
                <optgroup label="Novedad o Disponibilidad">
                  <option value="Nuevo">Nuevo</option>
                  <option value="Edición Limitada">Edición Limitada</option>
                  <option value="Últimas Unidades">Últimas Unidades</option>
                </optgroup>
                <optgroup label="Criterios técnicos o de valor">
                  <option value="Mejor Calidad/Precio">Mejor Calidad/Precio</option>
                  <option value="Calidad Premium">Calidad Premium</option>
                  <option value="Sostenible">Sostenible</option>
                </optgroup>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodPros" class="field-label">Puntos Fuertes (Pros) <span class="label-hint">(Uno por línea)</span></label>
              <textarea id="prodPros" rows="3"></textarea>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodCons" class="field-label">Puntos a Considerar (Contras) <span class="label-hint">(Uno por línea)</span></label>
              <textarea id="prodCons" rows="3"></textarea>
            </div>
          </div>

          <!-- Botones de Acción -->
          <div class="form-actions">
            <button type="button" id="btnAiEnrich" class="btn-ai">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z" />
                <path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z" />
              </svg>
              <span>Enriquecer con IA (título + ficha + imagen)</span>
            </button>
            <button type="submit" id="btnSaveProduct" class="btn-success">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
              </svg>
              <span id="btnSaveProductLabel">Guardar cambios</span>
            </button>
          </div>
            </div><!-- /.form-fields -->

            <!-- Columna derecha: vista previa en vivo (carrusel) + galería -->
            <div class="form-preview-col">
              <div class="preview-product-card">
                <div class="preview-image-wrapper">
                  <span class="preview-badge-row">
                    <span id="previewCategory" class="cat-pill" hidden></span>
                    <span id="previewBadge" class="badge-pill" hidden></span>
                  </span>
                  <span id="previewEmptyImage" class="preview-empty-image">
                    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <path d="M21 15l-5-5L5 21"></path>
                    </svg>
                    Vista previa del carrusel
                  </span>
                  <img id="previewImg" alt="Vista previa del producto" />
                  <button type="button" id="previewVideoOverlay" class="preview-video-overlay" hidden>
                    <span class="preview-play-icon">▶</span>
                    Ver vídeo
                  </button>
                  <button type="button" id="previewPrev" class="preview-nav preview-nav-prev" aria-label="Imagen anterior" hidden>‹</button>
                  <button type="button" id="previewNext" class="preview-nav preview-nav-next" aria-label="Imagen siguiente" hidden>›</button>
                  <span id="previewCounter" class="preview-counter" hidden>1 / 1</span>
                </div>
                <div class="preview-content">
                  <div class="preview-merchant-row">
                    <span id="previewMerchant" class="merchant-tag" hidden></span>
                    <span class="rating-stars" aria-hidden="true">★★★★★</span>
                  </div>
                  <h4 id="previewTitle" class="preview-title"></h4>
                  <div class="preview-pricing">
                    <span><span id="previewPrice" class="price-current"></span></span>
                    <s id="previewOriginalPrice" class="price-original" hidden></s>
                    <span id="previewDiscount" class="discount-pill" hidden></span>
                  </div>
                  <p id="previewDesc" class="preview-desc" hidden></p>
                  <div id="previewBulletsWrap" class="preview-bullets bullet-col" hidden>
                    <strong>Puntos fuertes</strong>
                    <ul id="previewProsList"></ul>
                  </div>
                  <a id="previewAffiliateBtn" class="preview-buy-btn" href="#" target="_blank" rel="nofollow noopener noreferrer" hidden>
                    Ir a la tienda <span id="previewBtnMerchant"></span>
                  </a>
                </div>
              </div>

              <!-- Galería de imágenes/vídeos del producto -->
              <div class="gallery-editor">
                <label class="field-label">
                  <span>Galería de Imágenes y Vídeos</span>
                  <span class="label-hint">Clic = imagen principal · Arrastra = reordenar · × = quitar</span>
                </label>
                <div class="gallery-thumbs" id="galleryThumbs"></div>
                <div class="gallery-add-row">
                  <div class="gallery-url-add">
                    <input type="text" id="galleryUrlInput" placeholder="Añadir por URL: imagen o vídeo (YouTube/Vimeo/mp4), separadas por comas" />
                    <button type="button" id="btnAddImageUrl" class="btn-secondary btn-sm">Añadir</button>
                  </div>
                  <label class="btn-secondary btn-sm gallery-file-label">
                    Subir archivo(s)
                    <input type="file" id="galleryFileInput" accept="image/*,video/*" multiple hidden />
                  </label>
                </div>
              </div>
            </div><!-- /.form-preview-col -->
          </div><!-- /.form-basic-grid -->
        </form>
      </div>
    </section>

    <!-- 3. LISTADO RÁPIDO DE PRODUCTOS EXISTENTES -->
    <section id="catalogProducts" data-admin-view="products" class:list={['admin-card', 'products-list-card', 'hidden-section', { 'is-visible': initialSection === 'products' }]}>
       <div class="list-header-row">
        <div>
          <h2 class="card-title">2. Catálogo de Productos Registrados</h2>
          <p class="card-desc">Consulta los productos activos en <code>src/data/products.json</code>, pruébalos, enríchelos con IA o elimínalos.</p>
        </div>
      </div>

      <!-- Filtros, ordenación y barras de rango de la tabla -->
      <div id="prodFilters" class="ali-filters prod-filters">
        <div class="ali-filters-row">
          <div class="filter-field ali-f-search">
            <label for="inputFilterList">Buscar por nombre</label>
            <input type="search" id="inputFilterList" placeholder="Filtrar por título, comerciante o red..." />
          </div>
          <div class="filter-field">
            <label for="prodFCat">Categoría</label>
            <select id="prodFCat"><option value="">Todas</option></select>
          </div>
          <div class="filter-field">
            <label for="prodSubcatAssign">Subcategoría</label>
            <select id="prodSubcatAssign"><option value="">Todas las subcategorías</option></select>
          </div>
          <div class="filter-field ali-sort-field">
            <label for="prodFSort">Ordenar por</label>
            <div class="ali-sort-group">
              <select id="prodFSort">
                <option value="default" selected>Por defecto</option>
                <option value="precio">Precio</option>
                <option value="nombre">Nombre</option>
                <option value="categoria">Categoría</option>
                <option value="comercio">Comerciante</option>
                <option value="descuento">Mayor descuento</option>
                <option value="valoracion">Mejor valoración</option>
                <option value="score">Conversión (score)</option>
              </select>
              <button type="button" id="prodFSortDir" class="btn-secondary btn-sm ali-sort-dir" title="Invertir el orden (mayor a menor / menor a mayor)">↓</button>
            </div>
          </div>
          <!-- Valoración, Precio (€), Descuento y "Limpiar filtros": MISMA FILA que el resto de filtros.
               El botón se recoloca desde JS detrás de Descuento (ver prodBuildRanges). -->
          <div id="prodRangeFields" class="ali-range-fields">
            <button type="button" id="prodFReset" class="btn-secondary btn-sm ali-f-reset">Limpiar filtros</button>
          </div>
        </div>
