            <div class="skills-items" data-skills-target="admin"><div class="loading-panel">Cargando skills…</div></div>
          </div>
        </div>
      </div>

      <!-- ── Conectividad de IA y tokens (migrada desde Transparencia) ── -->
      <div class="admin-card">
        <div class="card-header">
          <div class="header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
          </div>
          <div style="flex: 1;">
            <h2 class="card-title">Conectividad de IA y tokens</h2>
            <p class="card-desc">Estado de conexión, modelos gratuitos y claves de los proveedores. Las claves quedan conectadas para Enriquecer, Pipeline, Consola IA y los dos asistentes.</p>
          </div>
        </div>

        <div class="tp-options tp-ai-connect" id="tpAiConnect">
          <div class="tp-ai-head">
            <span class="tp-reasons-title">Proveedores</span>
            <button type="button" id="btnAiStatusRefresh" class="btn-secondary btn-sm" title="Comprueba la conexión REAL con cada proveedor (contra su endpoint de modelos) y refresca el estado">
              <span class="btn-text">↻ Probar conexión</span>
              <div class="btn-spinner" hidden></div>
