  /* Inputs Generales */
  input[type="text"],
  input[type="url"],
  input[type="number"],
  input[type="search"],
  select,
  textarea {
    width: 100%;
    background: #0d121f;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.75rem 1rem;
    color: var(--color-text-main);
    font-family: var(--font-body);
    font-size: 0.9rem;
    transition: all 0.2s ease;
    outline: none;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
  }

  /* Autorrelleno/restauración de Chrome al cargar o refrescar la página:
     el navegador pinta el input de blanco (y mantiene ese fondo hasta que el
     usuario escribe) aunque nuestro CSS ya le ponga fondo oscuro, porque lo
     hace con sus propios estilos internos de mayor prioridad. La prevención
     real es el atributo autocomplete="off" en los inputs de los filtros
     (evita que el navegador los marque como "restaurados" en primer lugar);
     esta regla es solo un cinturón de seguridad para cualquier campo donde
     aun así se active. Se neutraliza forzando el fondo oscuro vía box-shadow
     (el truco estándar para Chrome/Edge/Safari) y el texto del tema.
     `:global()` para que cubra también los inputs que se repintan por JS
     (innerHTML) en los filtros de Catálogo e Importar, que no llevan el
     atributo de scope de Astro. */
  :global(input:-webkit-autofill),
  :global(input:-webkit-autofill:hover),
  :global(input:-webkit-autofill:focus),
  :global(input:-webkit-autofill:active) {
    -webkit-text-fill-color: var(--color-text-main) !important;
    -webkit-box-shadow: 0 0 0 1000px var(--color-bg-main) inset !important;
    box-shadow: 0 0 0 1000px var(--color-bg-main) inset !important;
    caret-color: var(--color-text-main);
    transition: background-color 999999s ease-in-out 0s;
  }

  :global(input:autofill) {
    background-color: var(--color-bg-main) !important;
    color: var(--color-text-main) !important;
  }

  /* El placeholder no debe heredar el color de texto fuerte de arriba: debe
     verse igual de tenue que en cualquier otro input vacío del panel. */
  :global(input:-webkit-autofill::placeholder),
  :global(input:autofill::placeholder) {
    -webkit-text-fill-color: var(--color-text-dim) !important;
    color: var(--color-text-dim) !important;
    opacity: 1;
  }

  /* Botones: base scoped para los estáticos (HTML del template) + base global
     para los botones inyectados por JS (networkList, resultados, categorías…). */
  button {
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 600;
    border: none;
    border-radius: var(--border-radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  :global(.btn-primary),
  :global(.btn-secondary),
  :global(.btn-success) {
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 600;
    border: none;
    border-radius: var(--border-radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  :global(.btn-primary) {
    background: var(--color-primary);
    color: #fff;
    padding: 0.75rem 1.25rem;
    white-space: nowrap;
  }

  :global(.btn-primary):hover:not(:disabled) {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  :global(.btn-primary):disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global(.btn-success) {
    background: #10b981;
    color: #064e3b;
    font-weight: 700;
    padding: 0.85rem 1.75rem;
    color: #ffffff;
  }

  :global(.btn-success):hover {
    background: #059669;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  :global(.btn-secondary) {
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.85rem 1.5rem;
  }

  :global(.btn-secondary):hover {
    color: var(--color-text-main);
    background: #242f45;
  }

  /* Variante pequeña: va después de los anteriores para que su padding gane */
  :global(.btn-sm) { padding: .5rem .8rem; font-size: .76rem; }

  /* CTA de enriquecimiento con IA (texto + imagen) */
  .btn-ai {
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    color: #ffffff;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
  }

  .btn-ai:hover {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(139, 92, 246, 0.35);
  }

  .btn-ai:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .btn-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Alertas de Estado */
  .status-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: var(--border-radius-sm);
