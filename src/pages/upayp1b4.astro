        aliProducts = Array.isArray(data.products) ? data.products : [];
        aliPage = 1;
        aliInvalidateEstado();
        aliFilterPanel?.refresh();
        setAliMeta(data);
        renderAliCatalog();
        if (data.ok) showAliStatus('success', 'Catálogo ampliado', data.message || `${data.count} productos en total.`);
        else showAliStatus('error', 'No se pudo ampliar', data.message || 'No se pudo ampliar.');
