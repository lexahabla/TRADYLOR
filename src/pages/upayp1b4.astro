    // ── Modal: Asistente OpenCode ─────────────────────────────────────────────
    const opencodeModal = document.getElementById('opencodeAssistantModal');
    const opencodePrompt = document.getElementById('opencodePrompt');
    const opencodeContext = document.getElementById('opencodeContext');
    const opencodeStatus = document.getElementById('opencodeStatus');
    document.getElementById('btnProdOpenCode')?.addEventListener('click', () => {
      const selectedCount = selectedProductIds.size;
      const contextSelect = document.getElementById('opencodeContext');
      if (contextSelect) {
        contextSelect.querySelector('option[value="selected"]').textContent = `Solo productos seleccionados (${selectedCount} seleccionados)`;
      }
      if (opencodePrompt) opencodePrompt.value = '';
      if (opencodeStatus) { opencodeStatus.hidden = true; opencodeStatus.textContent = ''; opencodeStatus.className = 'admin-modal-status'; }
      openAdminModal(opencodeModal);
      opencodePrompt?.focus();
    });
    document.getElementById('btnOpenCodeExecute')?.addEventListener('click', async () => {
      const prompt = opencodePrompt?.value?.trim();
      if (!prompt) {
        if (opencodeStatus) { opencodeStatus.hidden = false; opencodeStatus.className = 'admin-modal-status is-error'; opencodeStatus.textContent = 'Escribe un prompt antes de enviar.'; }
        return;
      }
      const context = opencodeContext?.value || 'selected';
      if (opencodeStatus) { opencodeStatus.hidden = false; opencodeStatus.className = 'admin-modal-status'; opencodeStatus.textContent = 'Enviando a OpenCode...'; }
      try {
        let productIds = [];
        if (context === 'selected') {
          productIds = Array.from(selectedProductIds);
          if (!productIds.length) {
            if (opencodeStatus) { opencodeStatus.hidden = false; opencodeStatus.className = 'admin-modal-status is-error'; opencodeStatus.textContent = 'No hay productos seleccionados.'; }
            return;
          }
        } else if (context === 'all') {
          productIds = currentProducts.map((p) => p.id);
        } else if (context === 'full') {
          try {
            const res = await fetch('/api/v1/products?limit=10000', { cache: 'no-store' });
            const data = await res.json();
            if (data.products && Array.isArray(data.products)) productIds = data.products.map((p) => p.id);
          } catch {
            if (opencodeStatus) { opencodeStatus.hidden = false; opencodeStatus.className = 'admin-modal-status is-error'; opencodeStatus.textContent = 'No se pudo obtener el catálogo completo.'; }
            return;
          }
        }
        const res = await fetch('/api/v1/admin/opencode-command', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt, productIds, context }),
        });
        const data = await res.json();
        if (data.success) {
          if (opencodeStatus) { opencodeStatus.hidden = false; opencodeStatus.className = 'admin-modal-status is-ok'; opencodeStatus.textContent = data.message || 'Comando ejecutado correctamente.'; }
          if (data.reload) await reloadProductsTable();
          selectedProductIds.clear();
          updateProdSelCount();
        } else {
          if (opencodeStatus) { opencodeStatus.hidden = false; opencodeStatus.className = 'admin-modal-status is-error'; opencodeStatus.textContent = data.message || 'Error al ejecutar el comando.'; }
        }
      } catch {
        if (opencodeStatus) { opencodeStatus.hidden = false; opencodeStatus.className = 'admin-modal-status is-error'; opencodeStatus.textContent = 'Error de red al contactar con el servidor.'; }
      }
    });

