    // Asignar una categoría a todos los productos seleccionados de la tabla.
    btnProdAssignCat?.addEventListener('click', async () => {
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const category = prodCatAssign && 'value' in prodCatAssign ? String(prodCatAssign.value || '').trim() : '';
      const subcategoryName = (() => {
        const el = document.getElementById('prodSubcatDest');
        return el && 'value' in el ? String(el.value || '').trim() : '';
      })();
      const ids = [...selectedProductIds];
      if (!ids.length) {
        showAlert('warning', 'Sin selección', 'Marca primero los productos en la tabla que quieres mover.');
        return;
      }
      // Subcategoría elegida sin categoría: se deduce su categoría raíz.
      const subOwner = subcategoryName
        ? allCats.find((c) => c.parentId && c.name === subcategoryName)
        : undefined;
      const categoryName = category || (subOwner ? (allCats.find((c) => c.id === subOwner?.parentId)?.name ?? '') : '');
      if (!categoryName) {
        showAlert('warning', 'Falta la categoría', 'Elige la categoría destino en la barra de selección.');
        return;
      }
      // Categorización bidireccional: se envían también los IDs jerárquicos
      // (category_id / subcategory_id) resueltos desde el caché de categorías.
      const catObj = allCats.find((c) => !c.parentId && c.name === categoryName);
      if (!catObj) {
        showAlert('error', 'Categoría no encontrada', `«${categoryName}» no está en el catálogo. Recarga el panel.`);
        return;
      }
      const subObj = subcategoryName
        ? allCats.find((c) => c.name === subcategoryName && c.parentId === catObj.id)
        : undefined;
      const categoryId = catObj?.id || '';
      const subcategoryId = subObj?.id || '';
      showAlert('loading', 'Asignando categoría...', `${ids.length} producto(s) → «${categoryName}»${subcategoryName ? ` › «${subcategoryName}»` : ''}.`);
      try {
        const res = await fetch('/api/products/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'set-category', ids, category: categoryName, category_id: categoryId, subcategory_id: subcategoryId }),
        });
        const data = await res.json();
        if (data.success) {
          showAlert('success', 'Categoría asignada', `${ids.length} producto(s) en «${categoryName}» (${data.updated} cambiados).`);
          await reloadProductsTable();

          // Enriquecer los productos asignados con la misma lógica que el
          // botón «Enriquecer» (texto + ficha + imagen vía
          // /api/admin/enrich-bulk, en un único lote).
          let enrichedCount = 0;
          try {
            const res2 = await fetch('/api/admin/enrich-bulk', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ids, forceImage: false }),
            });
            const data2 = await res2.json();
            enrichedCount = Number(data2?.processed) || 0;
          } catch { /* enriquecimiento en lote: no invalida el alta de categoría */ }
          if (enrichedCount) {
            await reloadProductsTable();
            showAlert('success', 'Categoría + IA aplicada', `${ids.length} producto(s) categorizados y ${enrichedCount} enriquecido${enrichedCount === 1 ? '' : 's'} con IA.`);
          }
        } else {
          showAlert('error', 'Error al asignar', data.message || 'No se pudo actualizar la categoría.');
        }
      } catch (err) {
        console.error(err);
        showAlert('error', 'Error de red', 'No se pudo contactar con el servidor.');
      }
    });
    // Asignar una Etiqueta Destacada (Badge) a todos los productos seleccionados.
    const prodBadgeAssign = document.getElementById('prodBadgeAssign');
    if (prodBadgeAssign && prodBadge) {
      // Se clonan las opciones del desplegable del formulario (mismos valores).
      for (const option of Array.from(prodBadge.options)) {
        if (!option.value) continue;
        const clone = document.createElement('option');
        clone.value = option.value;
        clone.textContent = option.textContent;
        prodBadgeAssign.appendChild(clone);
      }
      const btnProdBulkBadge = document.getElementById('btnProdBulkBadge');
      btnProdBulkBadge?.addEventListener('click', async () => {
        const ids = Array.from(selectedProductIds);
        if (!ids.length) {
          showAlert('warning', 'Sin selección', 'Marca primero los productos en la tabla a los que quieres asignar la etiqueta.');
          return;
        }
        const badge = String(prodBadgeAssign.value || '').trim();
        if (!badge) {
          showAlert('warning', 'Falta la etiqueta', 'Elige la etiqueta destacada en el desplegable «Etiqueta destacada…».');
          prodBadgeAssign.focus();
          return;
        }
        showAlert('loading', 'Asignando etiqueta...', `Aplicando «${badge}» a ${ids.length} producto(s).`);
        try {
          const res = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'set-badge', ids, badge }),
          });
          const data = await res.json();
          if (data.success) {
            showAlert('success', 'Etiqueta asignada', `«${badge}» aplicada a ${data.updated} producto(s).`);
            await reloadProductsTable();
          } else {
            showAlert('error', 'Error al asignar', data.message || 'No se pudo actualizar la etiqueta.');
          }
        } catch (err) {
          console.error(err);
          showAlert('error', 'Error de red', 'No se pudo contactar con el servidor.');
        }
      });
    }

    prodCheckAll?.addEventListener('change', () => {
      const checked = prodCheckAll.checked;
      document.querySelectorAll('[data-prod-check]').forEach((box) => {
        box.checked = checked;
        const id = box.getAttribute('data-id');
        if (id) { if (checked) selectedProductIds.add(id); else selectedProductIds.delete(id); }
      });
      updateProdSelCount();
    });
    // ── Indicador de progreso del enriquecimiento masivo (inyectado en el DOM) ──
    let enrichProgressEl = null;
    let enrichProgressBar = null;
    let enrichProgressText = null;
    function ensureEnrichProgress() {
      if (enrichProgressEl) return;
      enrichProgressEl = document.createElement('div');
      enrichProgressEl.className = 'status-alert alert-loading';
      enrichProgressEl.style.padding = '1rem';
      enrichProgressEl.style.marginTop = '0.75rem';
      enrichProgressEl.style.borderRadius = '10px';
      enrichProgressEl.style.background = 'rgba(59, 130, 246, 0.12)';
      enrichProgressEl.style.border = '1px solid rgba(59, 130, 246, 0.35)';
      enrichProgressEl.style.color = '#ffffff';
      enrichProgressEl.innerHTML = `
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.5rem;">
          <span style="font-size:1.5rem;">⏳</span>
          <strong id="enrichProgressTitle">Enriqueciendo con IA…</strong>
        </div>
        <div id="enrichProgressBarWrap" style="width:100%;height:8px;background:rgba(255,255,255,0.15);border-radius:4px;overflow:hidden;margin-bottom:0.5rem;">
          <div id="enrichProgressBar" style="width:0%;height:100%;background:linear-gradient(90deg,#3b82f6,#60a5fa);transition:width 0.3s ease;"></div>
        </div>
        <div id="enrichProgressText" style="font-size:0.9rem;color:rgba(255,255,255,0.9);">0 / 0 productos procesados</div>
      `;
      const productSelBar = document.getElementById('productSelBar');
      if (productSelBar) productSelBar.parentNode.insertBefore(enrichProgressEl, productSelBar.nextSibling);
      enrichProgressBar = document.getElementById('enrichProgressBar');
      enrichProgressText = document.getElementById('enrichProgressText');
    }
    function removeEnrichProgress() {
      if (enrichProgressEl && enrichProgressEl.parentNode) {
        enrichProgressEl.parentNode.removeChild(enrichProgressEl);
      }
      enrichProgressEl = null; enrichProgressBar = null; enrichProgressText = null;
    }

    btnProdEnrich?.addEventListener('click', async () => {
      const sel = Array.from(selectedProductIds);
      // Si no hay selección, se aplica a TODOS los productos del catálogo visible.
      const ids = sel.length ? sel : (currentProducts || []).map((p) => p.id);
      if (!ids.length) {
        showAlert('warning', 'Sin productos', 'No hay productos en el catálogo para enriquecer.');
        return;
      }

      // Capacidad de IA en paralelo del proveedor activo (ver
      // TEXT_PROVIDER_CONCURRENCY en lib/ai.ts): si no se puede consultar, 2
      // a la vez es un valor conservador y seguro para cualquier proveedor.
      let concurrency = 2;
      try {
        const statusRes = await fetch('/api/admin/ai-status', { cache: 'no-store' });
        const statusData = await statusRes.json();
        const hinted = Number(statusData?.active?.enrichConcurrency);
        if (Number.isFinite(hinted) && hinted >= 1) concurrency = Math.min(hinted, ids.length);
      } catch { /* se usa el valor conservador por defecto */ }

      ensureEnrichProgress();
      enrichProgressEl.hidden = false;
      const progressTitleEl = document.getElementById('enrichProgressTitle');
      if (progressTitleEl) {
        progressTitleEl.textContent = concurrency > 1
          ? `Enriqueciendo con IA… (hasta ${concurrency} productos a la vez)`
          : 'Enriqueciendo con IA… (de uno en uno: el proveedor activo no admite más peticiones simultáneas)';
      }
      const total = ids.length;
      let done = 0;
      let okCount = 0;
      let failCount = 0;
      let aiTextCount = 0;
      let localTextCount = 0;
      let imageGeneratedCount = 0;
      const warnings = [];

      // Enriquece cada producto con /api/admin/enrich-bulk: la MISMA lógica de
      // IA que "Enriquecer con IA (título + ficha + imagen)" (base local +
      // overlay de IA vía `overlayEnrichedText`, sin borrar nunca datos con
      // campos vacíos) más filtrado de galería de baja calidad y vinculación
      // automática de alternativas. `forceImage: false` evita que un
      // enriquecimiento MASIVO sustituya en cadena fotos reales del comercio
      // por una genérica de IA (sólo rellena huecos).
      //
      // Concurrencia acotada («toda la capacidad de IA que tengamos» sin
      // saturar al proveedor): se procesan hasta `concurrency` productos a la
      // vez en vez de uno a uno; cada hueco que se libera coge el siguiente
      // id de la cola. El progreso (contador + barra) se actualiza con cada
      // producto que termina, venga del worker que venga.
      let nextIndex = 0;
      async function enrichOne(id) {
        const product = (currentProducts || []).find((p) => p.id === id);
        if (!product) return;
        try {
          const res = await fetch('/api/admin/enrich-bulk', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: [id], forceImage: false }),
          });
          const data = await res.json();
          const row = Array.isArray(data.results) ? data.results[0] : null;
          if (data.success && row?.ok) {
            okCount++;
            if (row.textStatus === 'ok') aiTextCount++;
            else if (row.textStatus === 'local') localTextCount++;
            if (row.imageStatus === 'ok') imageGeneratedCount++;
            if (Array.isArray(row.warnings)) warnings.push(...row.warnings);
          } else {
            failCount++;
            warnings.push(`${product.title || id}: ${row?.warnings?.[0] || data.message || 'error'}`);
          }
        } catch (err) {
          failCount++;
          warnings.push(`${product.title || id}: error de red`);
        }

        done++;
        if (enrichProgressBar) enrichProgressBar.style.width = `${Math.round((done / total) * 100)}%`;
        if (enrichProgressText) enrichProgressText.textContent = `${done} / ${total} productos procesados · ${aiTextCount} con IA · ${localTextCount} con plantilla local`;
      }
      async function worker() {
        while (nextIndex < ids.length) {
          const id = ids[nextIndex++];
          await enrichOne(id);
        }
      }
      try {
        await Promise.all(Array.from({ length: Math.max(1, concurrency) }, () => worker()));

        selectedProductIds.clear();
        updateProdSelCount();
        await reloadProductsTable();

        removeEnrichProgress();

        const summary = `${aiTextCount} con IA · ${localTextCount} con plantilla local · ${imageGeneratedCount} imagen${imageGeneratedCount === 1 ? '' : 'es'} nueva${imageGeneratedCount === 1 ? '' : 's'}`;
        if (failCount === 0) {
          showAlert('success', 'Enriquecimiento masivo finalizado', `${okCount} producto${okCount === 1 ? '' : 's'} procesado${okCount === 1 ? '' : 's'} (${summary}).`);
        } else {
          const warnText = warnings.length ? ` · Avisos: ${warnings.slice(0, 5).join(' | ')}` : '';
          showAlert('warning', 'Enriquecimiento masivo finalizado con errores', `${okCount} producto${okCount === 1 ? '' : 's'} OK (${summary}) · ${failCount} con error${warnText}.`);
        }
      } catch (err) {
        removeEnrichProgress();
        console.error(err);
        showAlert('error', 'Error de red', 'No se pudo completar el enriquecimiento masivo.');
      }
    });

    btnProdMakeSection?.addEventListener('click', () => {
      const ids = Array.from(selectedProductIds);
      if (!ids.length) { showAlert('warning', 'Sin selección', 'Selecciona al menos un producto del catálogo.'); return; }
      openCreateSectionModal(ids);
    });

    // Modal crear sección
    const createSectionModal = document.getElementById('createSectionModal');
    const createSectionTitle = document.getElementById('createSectionTitle');
    const createSectionDescription = document.getElementById('createSectionDescription');
    const createSectionPublished = document.getElementById('createSectionPublished');
    const createSectionPosition = document.getElementById('createSectionPosition');
    const createSectionSpeed = document.getElementById('createSectionSpeed');
    const createSectionConfirm = document.getElementById('createSectionConfirm');
    const createSectionStatus = document.getElementById('createSectionStatus');
    // OJO: este bloque es un <script is:inline>, es decir NO lo procesa Vite:
    // el navegador recibe JavaScript puro. Any TypeScript aquí (anotaciones
    // `: string[]`, `as any`, `interface`…) provoca un error de sintaxis que
    // mata TODO el script y deja el panel sin JS (filtros, paginación…).
    // Usa `npm run check:inline` para detectarlo antes de publicar.
    let createSectionProductIds = [];

    function openCreateSectionModal(productIds) {
      if (!createSectionModal) return;
      createSectionMode = 'create';
      createSectionId.value = '';
      createSectionProductIds = productIds;
      createSectionTitle.value = '';
      createSectionDescription.value = '';
      createSectionPublished.checked = true;
      if (createSectionPosition) createSectionPosition.value = 'below';
      if (createSectionSpeed) createSectionSpeed.value = 'normal';
      createSectionModalTitle.textContent = 'Crear nueva sección';
      createSectionModalDesc.textContent = 'Agrupa los productos seleccionados en una sección temática para mostrar en la web.';
      createSectionConfirm.textContent = 'Crear sección';
      createSectionStatus.hidden = true;
      createSectionStatus.textContent = '';
      createSectionStatus.className = 'admin-modal-status';
      createSectionModal.hidden = false;
      createSectionTitle.focus();
    }

    function openEditSectionModal(section) {
      if (!createSectionModal) return;
      createSectionMode = 'edit';
      createSectionId.value = section.id || '';
      createSectionProductIds = Array.isArray(section.productIds) ? section.productIds.slice() : [];
      createSectionTitle.value = section.title || '';
      createSectionDescription.value = section.description || '';
      createSectionPublished.checked = section.published !== false;
      if (createSectionPosition) createSectionPosition.value = section.position === 'above' ? 'above' : 'below';
      if (createSectionSpeed) createSectionSpeed.value = section.speed || 'normal';
      createSectionModalTitle.textContent = 'Editar sección';
      createSectionModalDesc.textContent = 'Modifica los datos de la sección y guarda los cambios.';
      createSectionConfirm.textContent = 'Guardar cambios';
      createSectionStatus.hidden = true;
      createSectionStatus.textContent = '';
      createSectionStatus.className = 'admin-modal-status';
      createSectionModal.hidden = false;
      createSectionTitle.focus();
    }

    function closeCreateSectionModal() {
      if (!createSectionModal) return;
      createSectionModal.hidden = true;
      createSectionProductIds = [];
    }

    createSectionModal?.querySelectorAll('[data-create-section-close]').forEach((el) => {
      el.addEventListener('click', closeCreateSectionModal);
    });

    createSectionConfirm?.addEventListener('click', async () => {
      const title = createSectionTitle.value.trim();
      if (!title) {
        createSectionStatus.textContent = 'El título es obligatorio';
        createSectionStatus.className = 'admin-modal-status is-error';
        createSectionStatus.hidden = false;
        createSectionTitle.focus();
        return;
      }
      const description = createSectionDescription.value.trim();
      const published = createSectionPublished.checked;
      const position = createSectionPosition ? createSectionPosition.value : 'below';
      const speed = createSectionSpeed ? createSectionSpeed.value : 'normal';
      const isEdit = createSectionMode === 'edit';
      const sectionId = createSectionId.value.trim();

      createSectionConfirm.disabled = true;
      createSectionConfirm.textContent = isEdit ? 'Guardando…' : 'Creando…';
      createSectionStatus.hidden = true;

      try {
        const res = await fetch('/api/admin/sections', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: isEdit ? 'update' : 'create',
            ...(isEdit ? { id: sectionId } : {}),
            title,
            description,
            productIds: isEdit ? createSectionProductIds : createSectionProductIds,
            published,
            position,
            speed,
          }),
        });
        const data = await res.json();
        if (data.success) {
          selectedProductIds.clear();
          updateProdSelCount();
          await loadSectionsAdmin();
          closeCreateSectionModal();
          showAlert('success', isEdit ? 'Sección actualizada' : 'Sección creada', `${title} ${isEdit ? 'actualizada' : 'añadida'} a las secciones de la web.`);
        } else {
          createSectionStatus.textContent = data.message || `No se pudo ${isEdit ? 'actualizar' : 'crear'} la sección.`;
          createSectionStatus.className = 'admin-modal-status is-error';
          createSectionStatus.hidden = false;
        }
      } catch {
        createSectionStatus.textContent = 'Error de red. No se pudo guardar la sección.';
        createSectionStatus.className = 'admin-modal-status is-error';
        createSectionStatus.hidden = false;
      } finally {
        createSectionConfirm.disabled = false;
        createSectionConfirm.textContent = isEdit ? 'Guardar cambios' : 'Crear sección';
      }
    });

    async function loadSectionsAdmin() {
      const host = document.getElementById('sectionsListAdmin');
      if (!host) return;
      try {
        const res = await fetch('/api/admin/sections', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) { host.innerHTML = '<p class="text-muted">No se pudieron cargar las secciones.</p>'; return; }
        const sections = Array.isArray(data.sections) ? data.sections : [];
        if (!sections.length) { host.innerHTML = '<p class="text-muted">Aún no hay secciones creadas.</p>'; return; }
        host.innerHTML = sections.map((s) => {
          const speedLabel = s.speed === 'slow' ? 'vel: lenta' : (s.speed === 'fast' ? 'vel: rápida' : (s.speed === 'none' ? 'vel: manual' : 'vel: normal'));
          return `
          <div class="section-admin-row">
            <strong>${escapeHtml ? escapeHtml(s.title) : s.title}</strong> <span class="admin-tag-pill">${s.published ? 'publicada' : 'oculta'}</span>
            <span class="admin-tag-pill">${s.position === 'above' ? 'encima catálogo' : 'debajo catálogo'}</span>
            <span class="admin-tag-pill">${speedLabel}</span>
            <span class="muted">${(s.productIds || []).length} producto(s)</span>
            <button type="button" class="btn-secondary btn-sm" data-section-edit="${s.id}" title="Editar sección">✏️ Editar</button>
            <button type="button" class="btn-secondary btn-sm" data-section-toggle="${s.id}" data-published="${!s.published}">${s.published ? 'Ocultar' : 'Publicar'}</button>
            <button type="button" class="btn-danger-ghost btn-sm" data-section-delete="${s.id}">Eliminar</button>
          </div>
        `;
        }).join('');
        host.querySelectorAll('[data-section-delete]').forEach((btn) => {
          btn.onclick = async () => {
            if (!confirm('¿Eliminar esta sección?')) return;
            await fetch('/api/admin/sections', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: btn.getAttribute('data-section-delete') }) });
            await loadSectionsAdmin();
          };
        });
        host.querySelectorAll('[data-section-toggle]').forEach((btn) => {
          btn.onclick = async () => {
            const id = btn.getAttribute('data-section-toggle');
            const published = btn.getAttribute('data-published') === 'true';
            await fetch('/api/admin/sections', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'update', id, published }) });
            await loadSectionsAdmin();
          };
        });

        // Editar sección existente: abre el modal con los datos cargados.
        host.querySelectorAll('[data-section-edit]').forEach((btn) => {
          btn.onclick = async () => {
            const id = btn.getAttribute('data-section-edit');
            const section = sections.find((s) => s.id === id);
            if (!section) return;
            openEditSectionModal(section);
          };
        });

        // Drag-and-drop para reordenar secciones (actualiza el campo `order`).
        initSectionDragAndDrop(host, sections);
      } catch {
        host.innerHTML = '<p class="text-muted">Error de red.</p>';
      }
    }

    // ─── Sugerencias inteligentes de secciones (calendario comercial) ─────────
    let sectionSuggestionsLoaded = false;
    const btnSectionSuggestions = document.getElementById('btnSectionSuggestions');
    const sectionSuggestionsPanel = document.getElementById('sectionSuggestionsPanel');
    const sectionSuggestionsList = document.getElementById('sectionSuggestionsList');
    const btnSectionSuggestionsClose = document.getElementById('btnSectionSuggestionsClose');

    async function loadSectionSuggestions() {
      if (!sectionSuggestionsList) return;
      sectionSuggestionsList.innerHTML = '<div class="loading-panel">Calculando sugerencias...</div>';
      try {
        const res = await fetch('/api/admin/sections/suggestions', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) { sectionSuggestionsList.innerHTML = '<p class="text-muted">No se pudieron calcular sugerencias.</p>'; return; }
        const suggestions = Array.isArray(data.suggestions) ? data.suggestions : [];
        if (!suggestions.length) { sectionSuggestionsList.innerHTML = '<p class="text-muted">El catálogo aún no tiene suficientes productos para proponer secciones.</p>'; return; }
        sectionSuggestionsList.innerHTML = suggestions.map((s) => `
          <div class="suggestion-card">
            <span class="suggestion-card-title">${escapeHtml ? escapeHtml(s.title) : s.title}</span>
            <span class="suggestion-card-desc">${escapeHtml ? escapeHtml(s.description) : s.description}</span>
            <span class="suggestion-card-meta">${s.productIds.length} producto(s) · ${escapeHtml ? escapeHtml(s.reason) : s.reason}</span>
            <div class="suggestion-card-actions">
              <button type="button" class="btn-success btn-sm" data-suggestion-create="${s.key}">${s.existingSectionId ? 'Actualizar' : '+ Crear'}</button>
            </div>
          </div>
        `).join('');
        sectionSuggestionsList.querySelectorAll('[data-suggestion-create]').forEach((btn) => {
          btn.onclick = async () => {
            const key = btn.getAttribute('data-suggestion-create');
            const suggestion = suggestions.find((s) => s.key === key);
            if (!suggestion) return;
            btn.disabled = true;
            try {
              const res = await fetch('/api/admin/sections', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  action: 'create',
                  id: suggestion.key,
                  title: suggestion.title,
                  description: suggestion.description,
                  productIds: suggestion.productIds,
                  published: true,
                  position: 'below',
                  speed: 'normal',
                }),
              });
              const data = await res.json();
              if (data.success) {
                showAlert('success', 'Sección creada', `${suggestion.title} ya está publicada en la portada.`);
                btn.textContent = 'Actualizar';
                await loadSectionsAdmin();
              } else {
                showAlert('error', 'Error', data.message || 'No se pudo crear la sección.');
              }
            } catch {
              showAlert('error', 'Error de red', 'No se pudo crear la sección.');
            } finally {
              btn.disabled = false;
            }
          };
        });
      } catch {
        sectionSuggestionsList.innerHTML = '<p class="text-muted">Error de red.</p>';
      }
    }

    btnSectionSuggestions?.addEventListener('click', async () => {
      if (!sectionSuggestionsPanel) return;
      sectionSuggestionsPanel.hidden = !sectionSuggestionsPanel.hidden;
      if (!sectionSuggestionsPanel.hidden && !sectionSuggestionsLoaded) {
        sectionSuggestionsLoaded = true;
        await loadSectionSuggestions();
      }
    });
    btnSectionSuggestionsClose?.addEventListener('click', () => {
      if (sectionSuggestionsPanel) sectionSuggestionsPanel.hidden = true;
    });

    /** Hace que las filas de sección se puedan arrastrar para reordenar. */
    function initSectionDragAndDrop(host, sections) {
      const rows = host.querySelectorAll('.section-admin-row');
      let draggedId = null;
      let targetId = null;

      rows.forEach((row) => {
        const id = row.getAttribute('data-section-id') || row.querySelector('[data-section-edit]')?.getAttribute('data-section-edit') || '';
        if (!id) return;
        row.setAttribute('data-section-id', id);
        row.setAttribute('draggable', 'true');
        row.style.cursor = 'grab';

        row.addEventListener('dragstart', (e) => {
          draggedId = id;
          row.classList.add('is-dragging');
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', id);
          }
        });

        row.addEventListener('dragend', () => {
          row.classList.remove('is-dragging');
          host.querySelectorAll('.section-admin-row').forEach((r) => {
            r.classList.remove('drag-over', 'drag-before', 'drag-after');
          });
          draggedId = null;
          targetId = null;
        });

        row.addEventListener('dragover', (e) => {
          e.preventDefault();
          if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
          host.querySelectorAll('.section-admin-row').forEach((r) => r.classList.remove('drag-over', 'drag-before', 'drag-after'));
          row.classList.add('drag-over');
          const rect = row.getBoundingClientRect();
          const after = e.clientY - rect.top >= rect.height / 2;
          row.classList.toggle('drag-after', after);
          row.classList.toggle('drag-before', !after);
          targetId = id;
        });

        row.addEventListener('dragleave', () => {
          row.classList.remove('drag-over', 'drag-before', 'drag-after');
        });

        row.addEventListener('drop', async (e) => {
          e.preventDefault();
          if (!draggedId || draggedId === targetId) return;
          host.querySelectorAll('.section-admin-row').forEach((r) => r.classList.remove('drag-over', 'drag-before', 'drag-after'));

          const dragged = sections.find((s) => s.id === draggedId);
          const target = sections.find((s) => s.id === targetId);
          if (!dragged || !target) return;

          // Intercambiar órdenes.
          const draggedOrder = dragged.order ?? 0;
          const targetOrder = target.order ?? 0;

          try {
            await Promise.all([
              fetch('/api/admin/sections', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'update', id: draggedId, order: targetOrder }),
              }),
              fetch('/api/admin/sections', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'update', id: targetId, order: draggedOrder }),
              }),
            ]);
            await loadSectionsAdmin();
          } catch {
            showAlert('error', 'Error al reordenar', 'No se pudo guardar el nuevo orden de la sección.');
          }
        });
      });
    }
    if (typeof loadSectionsAdmin === 'function') loadSectionsAdmin();
    attachRowActions();
    if (currentProducts.length > 0) {
      aliInvalidateEstado();
      prodBuildRanges();
      prodFilterApply();
      try {
        if (aliFilterPanel) aliFilterPanel.refresh();
      } catch (_) {}
    } else if (typeof reloadProductsTable === 'function') {
      reloadProductsTable();
    }

    // Handler para btnBuildCatalog (construcción automática del catálogo multi-comerciante)
    const btnBuildCatalog = document.getElementById('btnBuildCatalog');
    const btnBuildCatalogText = btnBuildCatalog?.querySelector('.btn-text') || btnBuildCatalog;
    const btnBuildCatalogSpinner = btnBuildCatalog?.querySelector('.btn-spinner');

    async function runBuildCatalog(dryRun = false) {
      const btn = dryRun ? document.getElementById('btnBuildCatalogDryRun') : btnBuildCatalog;
      const btnText = btn?.querySelector('.btn-text') || btn;
      const btnSpinner = btn?.querySelector('.btn-spinner');
      if (!btn) return;
      btn.disabled = true;
      btn.classList.add('loading');
      if (btnSpinner) btnSpinner.hidden = false;
      if (btnText) btnText.textContent = dryRun ? 'Probando…' : 'Lanzando…';

      showAliStatus('loading', dryRun ? 'Simulando construcción de catálogo…' : 'Construyendo catálogo multi-comerciante…',
        'Consultando APIs de todas las redes conectadas, normalizando, deduplicando cross-merchant, autoclasificando y detectando ofertas estrella. Esto puede tardar bastante más de 30-120 segundos si hay enriquecimiento con IA de por medio.');

      // ── DRY-RUN: síncrono y rápido (sin IA) ────────────────────────────────
      if (dryRun) {
        try {
          const apiToken = window.TRADYLOR_API_TOKEN;
          const res = await fetch(`/api/v1/products/build-catalog?dryRun=1`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              ...(apiToken ? { 'Authorization': `Bearer ${apiToken}` } : {})
            },
          });
          const data = await res.json();

          if (data.success) {
            const errorList = Array.isArray(data.errors) ? data.errors.filter(Boolean) : [];
            const lines = [
              `Redes consultadas: ${(data.networksQueried || []).join(', ') || 'ninguna'}`,
              `Productos brutos: ${data.rawTotal}`,
              `Tras filtro calidad: ${data.afterQualityFilter}`,
              `Grupos cross-merchant: ${data.crossMerchantGroups} (duplicados resueltos: ${data.duplicatesResolved})`,
              `Sin categoría: ${data.uncategorized ?? 0}`,
              `IA - Texto: ${data.aiEnrichedText ?? 0} · Imágenes: ${data.aiEnrichedImages ?? 0}`,
              `Se crearían: ${Number(data.wouldUpsert || 0)} · Se actualizarían: ${Number(data.wouldUpdate || 0)}`,
              `Duración: ${Math.round(data.durationMs / 1000)}s`,
            ];
            if (errorList.length) {
              lines.push(`Avisos de redes (${errorList.length}): ${errorList.slice(0, 5).join(' | ')}${errorList.length > 5 ? '…' : ''}`);
            }
            showAliStatus('success', '✅ Simulación completada', lines.join(' · '));
          } else {
            showAliStatus('error', 'Error en simulación', data.errors?.join('\n') || 'Error desconocido');
          }
        } catch (err) {
          console.error(err);
          showAliStatus('error', 'Error de red', 'No se pudo contactar con /api/v1/products/build-catalog');
        } finally {
          btn.disabled = false;
          btn.classList.remove('loading');
          if (btnSpinner) btnSpinner.hidden = true;
          if (btnText) btnText.textContent = '🔍 Probar Conexión';
        }
        return;
      }

      // ── BUILD REAL: segundo plano + polling ────────────────────────────────
      try {
        const apiToken = window.TRADYLOR_API_TOKEN;
        const res = await fetch('/api/v1/products/build-catalog', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(apiToken ? { 'Authorization': `Bearer ${apiToken}` } : {})
          },
          body: JSON.stringify({ background: true, concurrency: 2 }),
        });
        const data = await res.json();

        if (!data.success || !data.background || !data.job) {
          throw new Error(data.message || 'No se pudo lanzar la construcción en segundo plano.');
        }

        const jobId = data.job.id;
        let pollTimer = null;

        const stopPolling = () => {
          if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
          btn.disabled = false;
          btn.classList.remove('loading');
          if (btnSpinner) btnSpinner.hidden = true;
          if (btnText) btnText.textContent = '🏗️ Construir Catálogo';
        };

        const poll = async () => {
          try {
            const gres = await fetch('/api/v1/products/build-catalog', {
              headers: { ...(apiToken ? { 'Authorization': `Bearer ${apiToken}` } : {}) }
            });
            const gdata = await gres.json();
            const job = gdata.job;

            if (!job) {
              showAliStatus('warning', 'Sin job', 'No se encontró el estado de la construcción.');
              stopPolling();
              return;
            }

            // Actualiza mensaje de progreso
            if (job.status === 'running') {
              if (btnText) btnText.textContent = `Construyendo… (${job.processed}/${job.crossMerchantGroups})`;
              showAliStatus('loading', 'Construyendo catálogo multi-comerciante…',
                `${job.message}${job.current ? ` · Ahora: ${job.current}` : ''}`);
              // Sigue polling
              return;
            }

            // Terminado (done / error / cancelled / interrupted)
            stopPolling();

            if (job.status === 'done' && job.report) {
              await reloadProductsTable();
              const r = job.report;
              const errorList = Array.isArray(r.errors) ? r.errors.filter(Boolean) : [];
              const upserted = Number(r.upserted) || 0;
              const updated = Number(r.updated) || 0;
              const lines = [
                `Redes consultadas: ${(r.networksQueried || []).join(', ') || 'ninguna'}`,
                `Productos brutos: ${r.rawTotal}`,
                `Tras filtro calidad: ${r.afterQualityFilter}`,
                `Grupos cross-merchant: ${r.crossMerchantGroups}`,
                `Nuevos: ${upserted} · Actualizados: ${updated}`,
                `Duración: ${Math.round(r.durationMs / 1000)}s`,
              ];
              if (errorList.length) {
                lines.push(`Avisos de redes (${errorList.length}): ${errorList.slice(0, 5).join(' | ')}${errorList.length > 5 ? '…' : ''}`);
              }
              const detail = lines.join(' · ');
              if (upserted === 0 && updated === 0) {
                showAliStatus('warning', '⚠️ No se ha creado ni actualizado ningún producto',
                  `Las redes conectadas no han devuelto productos válidos (o ya estaban todos al día). ${detail}`);
              } else if (upserted === 0 && updated > 0) {
                showAliStatus('warning', '⚠️ Sin productos nuevos (sólo actualizados)',
                  `Los ${updated} producto(s) ya estaban en el catálogo: se ha refrescado precio/stock, no hay filas nuevas. ${detail}`);
              } else {
                showAliStatus('success', '✅ Catálogo construido con éxito', detail);
              }
            } else if (job.status === 'cancelled') {
              showAliStatus('warning', 'Construcción detenida', job.message || 'Se ha detenido la construcción del catálogo.');
            } else if (job.status === 'interrupted') {
              showAliStatus('warning', 'Servidor reiniciado', job.message || 'El servidor se reinició durante la ejecución.');
            } else {
              showAliStatus('error', 'Error construyendo catálogo', job.message || job.report?.errors?.join('\n') || 'Error desconocido');
            }
          } catch (err) {
            console.error(err);
            stopPolling();
            showAliStatus('error', 'Error de red', 'No se pudo consultar el avance de la construcción.');
          }
        };

        // Primera consulta inmediata + polling cada 3 segundos
        await poll();
        if (data.job && data.job.status === 'running') {
          pollTimer = setInterval(poll, 3000);
          // No se guarda pollTimer en cierre; el interval se detiene al terminar el job.
        }
      } catch (err) {
        console.error(err);
        btn.disabled = false;
        btn.classList.remove('loading');
        if (btnSpinner) btnSpinner.hidden = true;
        if (btnText) btnText.textContent = '🏗️ Construir Catálogo';
        showAliStatus('error', 'Error construyendo catálogo', err instanceof Error ? err.message : 'Error desconocido');
      }
    }

    btnBuildCatalog?.addEventListener('click', () => runBuildCatalog(false));
    document.getElementById('btnBuildCatalogDryRun')?.addEventListener('click', () => runBuildCatalog(true));

    // Botón flotante: sube al menú de secciones (admin-section-nav).
    const adminBackToTop = document.getElementById('adminBackToTop');
    if (adminBackToTop) {
      adminBackToTop.addEventListener('click', () => {
        const nav = document.querySelector('.admin-section-nav');
        if (nav) {
          nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
          // En pantallas estrechas, despliega también el menú de secciones.
          const links = document.getElementById('adminNavLinks');
          const toggle = document.getElementById('adminNavToggle');
          if (links && toggle && window.getComputedStyle(toggle).display !== 'none' && !links.classList.contains('is-open')) {
            links.classList.add('is-open');
            toggle.setAttribute('aria-expanded', 'true');
          }
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    // Chips de URL en los detalles: copiar al portapapeles y desplegar/ocultar.
    document.addEventListener('click', async (event) => {
      const copyBtn = event.target.closest?.('.url-chip-copy');
      if (copyBtn) {
        event.stopPropagation();
        const url = copyBtn.getAttribute('data-url') || '';
        try {
          await navigator.clipboard.writeText(url);
          copyBtn.classList.add('is-copied');
          copyBtn.setAttribute('title', '¡Copiado!');
          setTimeout(() => {
            copyBtn.classList.remove('is-copied');
            copyBtn.setAttribute('title', 'Copiar enlace');
          }, 1400);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch {}
          ta.remove();
        }
        return;
      }
      const toggleBtn = event.target.closest?.('.url-chip-toggle');
      if (toggleBtn) {
        event.stopPropagation();
        const chip = toggleBtn.closest('.url-chip');
        if (chip) {
          const open = chip.classList.toggle('is-open');
          toggleBtn.setAttribute('aria-expanded', String(open));
          toggleBtn.setAttribute('title', open ? 'Ocultar la URL completa' : 'Mostrar u ocultar la URL completa');
        }
      }
    });

    // =========================================================================
    // 5. MÓDULO DE AFILIADOS Y MULTI-CATÁLOGO
    // =========================================================================
    const networkList = document.getElementById('networkList');
    const networksCard = document.getElementById('networksCard');
    const removedNetworks = document.getElementById('removedNetworks');
    const searchStatus = document.getElementById('searchStatus');
    const searchStatusTitle = document.getElementById('searchStatusTitle');
    const searchStatusText = document.getElementById('searchStatusText');
    let networksCache = [];

    function showSearchStatus(type, title, message) {
      if (!searchStatus) return;
      searchStatus.hidden = false;
      searchStatus.className = `status-alert alert-${type}`;
      if (searchStatusTitle) searchStatusTitle.textContent = title;
      if (searchStatusText) searchStatusText.textContent = message;
    }

    async function postNetworks(payload) {
      const res = await fetch('/api/admin/networks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      return res.json();
    }

    function statusLabel(status) {
      return status === 'connected' ? 'Conectada' : status === 'error' ? 'Error' : 'Pendiente';
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function newFieldRowHtml(label = '', secret = true, required = true) {
      return `
        <div class="new-field-row">
          <input class="nf-label" type="text" maxlength="60" placeholder="Etiqueta (ej: API Token)" value="${escapeHtml(label)}" />
          <label class="nf-check"><input type="checkbox" class="nf-secret" ${secret ? 'checked' : ''} /> Secreto</label>
          <label class="nf-check"><input type="checkbox" class="nf-required" ${required ? 'checked' : ''} /> Obligatorio</label>
          <button type="button" class="nf-remove" data-remove-field title="Quitar campo">✕</button>
        </div>`;
    }

    function newNetworkPanelHtml() {
      return `
        <details class="network-item network-new" data-network-new>
          <summary>
            <span class="network-add-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
            <span class="network-main network-add-main">
              <span class="network-name">Añadir afiliado nuevo</span>
              <span class="network-region">Función aparte: crea una red propia con sus campos de credenciales</span>
            </span>
            <span class="network-add-chip">Crear</span>
          </summary>
          <div class="network-body">
            <form class="network-new-form">
              <label class="cred-field">
                <span>Nombre *</span>
                <input type="text" name="name" maxlength="80" required placeholder="Ej: Programa de afiliados de MiTienda" />
              </label>
              <label class="cred-field">
                <span>Región</span>
                <input type="text" name="region" maxlength="60" placeholder="Global / UE" />
              </label>
              <label class="cred-field">
                <span>Descripción</span>
                <input type="text" name="description" maxlength="300" placeholder="Qué ofrece esta red" />
              </label>
              <label class="cred-field">
                <span>URL de documentación</span>
                <input type="text" name="docUrl" maxlength="300" placeholder="https://..." />
              </label>
              <div class="cred-field">
                <span>Color identificativo</span>
                <input type="color" name="color" value="#38bdf8" class="nf-color" />
              </div>
              <div class="new-fields">
                <span class="new-fields-title">Campos de credenciales *</span>
                <div class="new-field-rows">${newFieldRowHtml()}</div>
                <button type="button" class="btn-secondary btn-sm" data-add-field>+ Añadir campo</button>
              </div>
              <div class="network-actions">
                <button type="submit" class="btn-primary btn-sm">Crear afiliado</button>
              </div>
              <p class="network-feedback" data-new-feedback></p>
            </form>
          </div>
        </details>`;
    }

    function renderNetworks(networks) {
      networksCache = networks;
      if (!networkList) return;
      networkList.innerHTML = networks.map((network) => `
        <details class="network-item" data-network-id="${escapeHtml(network.id)}">
          <summary>
            <span class="network-color" style="background:${escapeHtml(network.color)}"></span>
            <span class="network-main">
              <span class="network-name">${escapeHtml(network.name)}</span>
              <span class="network-region">${escapeHtml(network.region)}</span>
            </span>
            <span class="integration-status ${network.status === 'connected' ? 'is-configured' : ''} ${network.status === 'error' ? 'is-error' : ''}">${statusLabel(network.status)}</span>
          </summary>
          <div class="network-body">
            <p class="network-desc">${escapeHtml(network.description)}</p>
            <form class="network-cred-form" data-network-id="${escapeHtml(network.id)}">
              <!-- Honeypot invisible: evita que el gestor de contraseñas del
                   navegador rellene este formulario con el usuario del panel -->
              <input type="text" name="__hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
              ${network.fields.map((field) => `
                <label class="cred-field">
                  <span>${escapeHtml(field.label)}${field.required ? ' *' : ''}</span>
                  <span class="cred-input-wrap">
                    <input
                      type="${field.secret ? 'password' : 'text'}"
                      name="${escapeHtml(field.key)}"
                      placeholder="${escapeHtml(field.hasValue ? '•••••••• (guardado)' : (field.placeholder || 'Sin configurar'))}"
                      autocomplete="${field.secret ? 'new-password' : 'off'}"
                      data-1p-ignore="true"
                      data-lpignore="true"
                      data-form-type="other"
                    />
                    <button type="button" class="cred-eye ${field.secret ? '' : 'is-shown'}" data-cred-eye title="Mostrar u ocultar el valor" aria-label="Mostrar u ocultar el valor">
                      <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                      <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                  </span>
                </label>
              `).join('')}
              <div class="network-actions">
                <span class="network-actions-main">
                  <button type="submit" class="btn-primary btn-sm">Guardar y validar</button>
                  <button type="button" class="btn-secondary btn-sm" data-network-validate="${escapeHtml(network.id)}">Validar</button>
                  <button type="button" class="btn-secondary btn-sm" data-network-reveal="${escapeHtml(network.id)}" title="Muestra u oculta los valores guardados de esta red">Ver</button>
                </span>
                <button type="button" class="btn-danger-ghost btn-sm" data-network-delete="${escapeHtml(network.id)}">Desconectar</button>
                <button type="button" class="btn-danger-ghost btn-sm network-remove" data-network-remove="${escapeHtml(network.id)}" title="Eliminar este afiliado de la lista">Eliminar</button>
                ${network.docUrl ? `<a class="network-doc" href="${escapeHtml(network.docUrl)}" target="_blank" rel="noopener noreferrer">Documentación</a>` : ''}
              </div>
              <p class="network-feedback" data-network-feedback="${escapeHtml(network.id)}">${escapeHtml(network.statusDetail || '')}</p>
            </form>
          </div>
        </details>
      `).join('') + newNetworkPanelHtml();
    }

    /** Redibuja la lista activa y el aviso de redes predefinidas eliminadas. */
    function applyNetworks(data) {
      if (Array.isArray(data.networks)) renderNetworks(data.networks);
      renderRemoved(Array.isArray(data.removed) ? data.removed : []);
      populateAliNetworkFilter();
    }

    /**
     * Rellena el select «Comerciante / Red» de #aliFilters con TODAS las redes
     * del panel «Redes conectadas». Conectadas: texto negro subrayado con el
     * color de la red (como el span.network-color, un punto más opaco). No
     * conectadas: gris.
     */
    function populateAliNetworkFilter() {
      const select = document.getElementById('aliFNetwork');
      if (!select) return;
      const current = select.value;
      select.innerHTML = '<option value="">Todas</option>';
      for (const network of networksCache || []) {
        const option = document.createElement('option');
        option.value = network.id;
        option.textContent = network.name;
        if (network.status === 'connected') {
          option.style.color = '#0b1220';
          option.style.textDecoration = 'underline';
          option.style.textDecorationColor = network.color;
          option.style.fontWeight = '700';
        } else {
          option.style.color = '#9ca3af';
        }
        select.appendChild(option);
      }
      if (current && Array.from(select.options).some((o) => o.value === current)) select.value = current;
    }

    function renderRemoved(removed) {
      if (!removedNetworks) return;
      if (!removed.length) {
        removedNetworks.hidden = true;
        removedNetworks.innerHTML = '';
        return;
      }
      removedNetworks.hidden = false;
      removedNetworks.innerHTML = `
        <span>${removed.length} red${removed.length === 1 ? '' : 'es'} predefinida${removed.length === 1 ? '' : 's'} eliminada${removed.length === 1 ? '' : 's'}: ${removed.map((network) => escapeHtml(network.name)).join(', ')}.</span>
        <button type="button" class="btn-secondary btn-sm" data-restore-networks>Restaurar</button>`;
    }

    async function loadNetworks() {
      try {
        const res = await fetch('/api/admin/data', { credentials: 'include' });
        const data = await res.json();
        if (data.success && Array.isArray(data.networks)) applyNetworks(data);
      } catch {
        if (networkList) networkList.innerHTML = '<div class="empty-dashboard">No se pudieron cargar las redes.</div>';
      }
    }

    networksCard?.addEventListener('submit', async (event) => {
      const newForm = event.target.closest('.network-new-form');
      if (newForm) {
        event.preventDefault();
        const feedback = newForm.querySelector('[data-new-feedback]');
        const rows = [...newForm.querySelectorAll('.new-field-row')];
        const fields = rows
          .map((row) => ({
            label: row.querySelector('.nf-label')?.value.trim() || '',
            secret: Boolean(row.querySelector('.nf-secret')?.checked),
            required: Boolean(row.querySelector('.nf-required')?.checked),
          }))
          .filter((field) => field.label);
        if (!fields.length) {
          if (feedback) feedback.textContent = 'Añade al menos un campo de credencial con etiqueta.';
          return;
        }
        const values = Object.fromEntries(new FormData(newForm).entries());
        const submitBtn = newForm.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        const data = await postNetworks({ action: 'create', ...values, fields });
        if (submitBtn) submitBtn.disabled = false;
        if (data.success) {
          applyNetworks(data);
          const created = networkList.querySelector(`details[data-network-id="${data.network.id}"]`);
          if (created) created.open = true;
        } else if (feedback) {
          feedback.textContent = data.message || 'No se pudo crear el afiliado.';
        }
        return;
      }

      const form = event.target.closest('.network-cred-form');
      if (!form) return;
      event.preventDefault();
      const networkId = form.dataset.networkId;
      const values = Object.fromEntries(new FormData(form).entries());
      const data = await postNetworks({ action: 'save', networkId, values });
      if (data.success) {
        applyNetworks(data);
        const item = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (item) item.open = true;
        // Guardar valida en segundo plano: así la red queda "Conectada" sin
        // pasos extra y la sincronización del catálogo no necesita revalidar.
        await validateNetwork(networkId);
        // Tras validar (que vuelve a re-dibujar la lista) se repone en los
        // inputs exactamente lo que se escribió, para que el Tracking ID u
        // otros valores guardados se vean sin tener que pulsar «Ver».
        const savedForm = networkList.querySelector(`.network-cred-form[data-network-id="${networkId}"]`);
        if (savedForm) {
          savedForm.dataset.revealed = '1';
          for (const input of savedForm.querySelectorAll('input[name]')) {
            const written = values[input.name];
            if (written) input.value = written;
          }
        }
        const savedItem = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (savedItem) savedItem.open = true;
      } else {
        const feedback = networkList.querySelector(`[data-network-feedback="${networkId}"]`);
        if (feedback) feedback.textContent = data.message || 'No se pudieron guardar las credenciales.';
        const item = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (item) item.open = true;
      }
    });

    /** Valida una red desde el panel: estado + efectos según la red conectada. */
    async function validateNetwork(networkId) {
      const feedback = networkList?.querySelector(`[data-network-feedback="${networkId}"]`);
      if (feedback) feedback.textContent = 'Validando conexión...';
      const data = await postNetworks({ action: 'validate', networkId });
      applyNetworks(data);
      const item = networkList?.querySelector(`details[data-network-id="${networkId}"]`);
      if (item) item.open = true;
      const newFeedback = networkList?.querySelector(`[data-network-feedback="${networkId}"]`);
      if (newFeedback) newFeedback.textContent = data.message || '';

      // Al conectar una red, refrescamos lo que corresponda: AliExpress
      // recarga la caché de su tabla; el resto sólo confirma la conexión.
      const validated = (data.networks || []).find((n) => n.id === networkId);
      if (validated && validated.status === 'connected') {
        if (networkId === 'aliexpress') {
          await syncAliCatalogUI();
        } else {
          showSearchStatus('success', 'Red conectada', `${validated.name} se ha conectado correctamente.`);
        }
      }
      return data;
    }

    /** Muestra/oculta los valores reales guardados de una red en su formulario. */
    async function toggleRevealCredentials(networkId, button) {
      const form = networkList?.querySelector(`.network-cred-form[data-network-id="${networkId}"]`);
      if (!form) return;
      const revealed = form.dataset.revealed === '1';
      if (revealed) {
        for (const input of form.querySelectorAll('input[name]')) {
          input.value = '';
          const field = (networksCache || []).find((n) => n.id === networkId)?.fields?.find((f) => f.key === input.name);
          input.type = field?.secret ? 'password' : 'text';
          input.parentElement?.querySelector('[data-cred-eye]')?.classList.toggle('is-shown', !field?.secret);
        }
        form.dataset.revealed = '0';
        if (button) button.textContent = 'Ver';
        return;
      }
      if (button) {
        button.disabled = true;
        button.textContent = '...';
      }
      try {
        const data = await postNetworks({ action: 'reveal', networkId });
        if (!data.success) {
          const feedback = networkList.querySelector(`[data-network-feedback="${networkId}"]`);
          if (feedback) feedback.textContent = data.message || 'No hay credenciales guardadas para mostrar.';
          return;
        }
        for (const input of form.querySelectorAll('input[name]')) {
          const value = data.values?.[input.name];
          if (value != null) {
            input.value = value;
            input.type = 'text';
            input.parentElement?.querySelector('[data-cred-eye]')?.classList.add('is-shown');
          }
        }
        form.dataset.revealed = '1';
        if (button) button.textContent = 'Ocultar';
      } finally {
        if (button) button.disabled = false;
      }
    }

    networksCard?.addEventListener('click', async (event) => {
      const addFieldBtn = event.target.closest('[data-add-field]');
      if (addFieldBtn) {
        const rows = addFieldBtn.closest('.new-field-rows');
        if (rows) rows.insertAdjacentHTML('beforeend', newFieldRowHtml('', true, true));
        return;
      }

      const removeFieldBtn = event.target.closest('[data-remove-field]');
      if (removeFieldBtn) {
        const rows = networkList.querySelectorAll('.new-field-row');
        const row = removeFieldBtn.closest('.new-field-row');
        if (row && rows.length > 1) row.remove();
        else if (row) row.querySelector('.nf-label')?.focus();
        return;
      }

      // Ojo de cada campo: alterna password ↔ text en ese input
      const eyeBtn = event.target.closest('[data-cred-eye]');
      if (eyeBtn) {
        const input = eyeBtn.parentElement?.querySelector('input');
        if (input) {
          const show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          eyeBtn.classList.toggle('is-shown', show);
        }
        return;
      }

      const validateBtn = event.target.closest('[data-network-validate]');
      const revealBtn = event.target.closest('[data-network-reveal]');
      const deleteBtn = event.target.closest('[data-network-delete]');
      const removeBtn = event.target.closest('[data-network-remove]');

      if (validateBtn) {
        validateBtn.disabled = true;
        try {
          await validateNetwork(validateBtn.dataset.networkValidate);
        } finally {
          validateBtn.disabled = false;
        }
        return;
      }

      if (revealBtn) {
        await toggleRevealCredentials(revealBtn.dataset.networkReveal, revealBtn);
        return;
      }

      if (deleteBtn) {
        const networkId = deleteBtn.dataset.networkDelete;
        if (!window.confirm('¿Desconectar esta red? Se eliminarán sus credenciales almacenadas.')) return;
        const data = await postNetworks({ action: 'delete', networkId });
        if (data.success) applyNetworks(data);
      }

      if (removeBtn) {
        const networkId = removeBtn.dataset.networkRemove;
        const network = (networksCache || []).find((n) => n.id === networkId);
        const label = network ? ` "${network.name}"` : '';
        if (!window.confirm(`¿Eliminar el afiliado${label}? Se borrarán también sus credenciales de la lista.`)) return;
        const data = await postNetworks({ action: 'remove', networkId });
        if (data.success) applyNetworks(data);
        else showSearchStatus('error', 'No se pudo eliminar', data.message || 'Error desconocido.');
      }
    });

    removedNetworks?.addEventListener('click', async (event) => {
      if (!event.target.closest('[data-restore-networks]')) return;
      const data = await postNetworks({ action: 'restore' });
      if (data.success) applyNetworks(data);
    });

    /** Categoría asignada al importar ('' = automática por keywords). */
    function getImportCategory() {
      return '';
    }

    const money = (value, currency = 'EUR') => (value == null || value === '' ? '—' : `${Number(value).toFixed(2)} ${currency === 'EUR' ? '€' : currency}`);

    /** Chip compacto de URL: una sola línea con ellipsis + copiar + desplegar. */
    function renderUrlChip(raw) {
      const url = escapeHtml(raw);
      return `
        <span class="url-chip">
          <a href="${url}" target="_blank" rel="noopener noreferrer" class="url-chip-text" title="${url}">${url}</a>
          <button type="button" class="url-chip-btn url-chip-copy" data-url="${url}" title="Copiar enlace" aria-label="Copiar enlace">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
          <button type="button" class="url-chip-btn url-chip-toggle" title="Mostrar u ocultar la URL completa" aria-label="Desplegar URL">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </span>`;
    }

    /** URLs de imagen del detalle (extras «Imágenes», galería e imagen principal), sin repetir. */
    function detailImageUrls(product) {
      const urls = [];
      const push = (value) => {
        const url = String(value || '').trim();
        if (/^https?:\/\//i.test(url) && !urls.includes(url)) urls.push(url);
      };
      const rawImages = product.extra && product.extra['Imágenes'];
      if (rawImages) String(rawImages).split('|').forEach(push);
      if (Array.isArray(product.gallery)) product.gallery.forEach(push);
      push(product.image);
      return urls;
    }

    function productDetailRows(product) {
      const extraOf = (key) => {
        const raw = product.extra && product.extra[key];
        return raw == null || raw === '' ? null : raw;
      };
      const affiliateLink = extraOf('Enlace de afiliado') || extraOf('Enlace de afiliado final') || product.promotionUrl || product.productUrl || null;
      const buyNow = extraOf('Enlace de compra directa') || extraOf('Buy Now') || extraOf('Buy Now URL') || null;
      const specs = extraOf('Especificaciones') || extraOf('Specs') || null;
      const rows = [
        ['Red', product.network],
        ['ID externo', product.externalId],
        ['Categoría', product.category],
        ['Marca', product.brand || extraOf('Marca') || extraOf('Brand')],
        ['Distribuidor (envío y pago)', product.fulfillmentProvider || extraOf('Distribuidor') || extraOf('Fulfillment') || extraOf('Vendedor')],
        ['Descripción', product.description],
        ['Precio', money(product.price, product.currency)],
        ['Precio original', product.originalPrice != null ? money(product.originalPrice, product.currency) : null],
        ['Moneda', product.currency],
        ['Comisión (%)', product.commissionRate != null ? `${product.commissionRate}%` : null],
        ['Comisión estimada', product.commissionAmount != null ? money(product.commissionAmount, product.currency) : null],
        ['Valoración (0–5)', product.rating != null ? `${product.rating} / 5` : null],
        ['Nº de opiniones', product.reviewsCount],
        ['Ventas / alcance', product.popularity],
        ['Stock', product.inStock ? 'En stock' : 'Sin stock'],
        ['Enlace de Afiliado Final', affiliateLink],
        ['Enlace de Compra Directa (Buy Now)', buyNow],
        ['Texto de envío', product.shippingInfo || extraOf('Texto de envío') || extraOf('Envío')],
        ['Días de envío', product.shippingDays ?? extraOf('Días de envío')],
        ['Origen de datos', product.estimated ? 'Estimado (API no cableada)' : 'API oficial'],
        ['Alta en catálogo', aliFmtDate(product.firstSeenAt)],
        ['URL del producto', product.productUrl],
      ];
      if (specs) rows.push(['Especificaciones (specs clave/valor)', specs]);
      // Etiquetas ya cubiertas arriba: no se repiten desde los extras.
      const handled = new Set([
        'Red', 'ID externo', 'Categoría', 'Marca', 'Brand', 'Distribuidor', 'Fulfillment', 'Vendedor',
        'Descripción', 'Precio', 'Moneda', 'Valoración', 'Reseñas', 'Ventas / alcance', 'Stock',
        'Enlace de afiliado', 'Enlace de afiliado final', 'Enlace de compra directa', 'Buy Now', 'Buy Now URL',
        'Envío', 'Texto de envío', 'Días de envío', 'Origen de datos', 'Alta en catálogo', 'URL del producto',
        'Especificaciones', 'Specs',
      ]);
      for (const [label, value] of Object.entries(product.extra || {})) {
        if (value == null || value === '') continue;
        // Las imágenes NO se pintan en su posición natural del extra:
        // van en el ÚLTIMO aff-detail-item del desplegable.
        if (label === 'Imágenes') continue;
        if (handled.has(label)) continue;
        rows.push([label, value]);
      }
      const fields = rows
        .filter(([, value]) => value != null && value !== '')
        .map(([label, value]) => {
          const raw = String(value);
          const cell = /^https?:\/\//i.test(raw)
            ? renderUrlChip(raw)
            : escapeHtml(raw);
          return `<div class="aff-detail-item"><dt>${escapeHtml(label)}</dt><dd>${cell}</dd></div>`;
        })
        .join('');
      // Miniaturas SIEMPRE al final, en una única fila horizontal
      // (scroll horizontal si no caben todas a la vez).
      const images = detailImageUrls(product);
      if (!images.length) return fields;
      const cells = images
        .map((url) => `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer"><img src="${escapeHtml(url)}" alt="" loading="lazy" /></a>`)
        .join('');
      return `${fields}<div class="aff-detail-item is-images"><dt>Imágenes (${images.length})</dt><dd class="aff-detail-thumbs">${cells}</dd></div>`;
    }

    /** Construye el payload de guardado compartido por importación simple y masiva.
     *  `categoryOverride` (opcional) fuerza la categoría destino elegida en la
     *  barra de acciones; sin él se mantiene la automática por keywords. */
    function buildImportPayload(product, categoryOverride) {
      const assignedCategory =
        categoryOverride != null ? categoryOverride : getImportCategory();
      const affiliateLink =
        (product.extra && (product.extra['Enlace de afiliado'] || product.extra['Enlace de afiliado '] )) ||
        product.promotionUrl ||
        product.productUrl;
      const gallery =
        Array.isArray(product.gallery) && product.gallery.length
          ? product.gallery.slice(0, 10)
          : product.image
            ? [product.image]
            : [];
      // Datos de envío del catálogo del comerciante (AliExpress: "Días de envío").
      const rawDays = product.extra?.['Días de envío'] ?? product.shippingDays;
      const shippingDays = rawDays != null && rawDays !== '' && Number.isFinite(Number(rawDays))
        ? Math.max(0, Math.round(Number(rawDays)))
        : undefined;
      const shippingInfo =
        (product.shippingInfo && String(product.shippingInfo).trim()) ||
        (shippingDays != null ? `Envío en ${shippingDays} días` : undefined);
      const freeShipping =
        typeof product.freeShipping === 'boolean'
          ? product.freeShipping
          : shippingDays != null && shippingDays <= 3;
      // Campos que la ficha del producto (formulario) espera recibir: Marca,
      // Especificaciones, Distribuidor, Enlace de afiliado final y Buy Now.
      const extraOf = (key) => {
        const raw = product.extra && product.extra[key];
        return raw == null || raw === '' ? null : String(raw);
      };
      const brand = product.brand || extraOf('Marca') || extraOf('Brand')
        || (product.network === 'aliexpress' ? 'AliExpress' : product.network);
      const rawSpecs = extraOf('Especificaciones') || extraOf('Specs');
      const specs = (() => {
        if (!rawSpecs) return undefined;
        const parsed = {};
        rawSpecs.split(/\s*(?:·|;|\|)\s*/).map((part) => part.trim()).filter(Boolean).forEach((part) => {
          const idx = part.indexOf(':');
          if (idx > 0) {
            const k = part.slice(0, idx).trim();
            const v = part.slice(idx + 1).trim();
            if (k && v) parsed[k] = v;
          }
        });
        return Object.keys(parsed).length ? parsed : undefined;
      })();
      const fulfillmentProvider =
        product.fulfillmentProvider || extraOf('Distribuidor') || extraOf('Fulfillment') || extraOf('Vendedor') || undefined;
      const buyNowUrl = extraOf('Enlace de compra directa') || extraOf('Buy Now') || extraOf('Buy Now URL') || undefined;
      // Estado físico (Nuevo/Usado/Reacondicionado...): dato clave para poder
      // filtrar después los productos de segunda mano en el catálogo.
      const condition = extraOf('Estado') || extraOf('Condición') || extraOf('Condition') || undefined;
      // Ventas/alcance: `popularity` (campo propio de UnifiedProduct) o, en su
      // defecto, el extra textual del conector.
      const rawSales = product.popularity != null ? product.popularity : extraOf('Ventas (30 días)');
      const sales30d = rawSales != null && rawSales !== '' && Number.isFinite(Number(rawSales))
        ? Math.round(Number(rawSales))
        : undefined;
      return {
        action: 'save',
        product: {
          title: product.title,
          description: product.description,
          price: product.price,
          originalPrice: product.originalPrice,
          image: product.image,
          gallery,
          category: assignedCategory,
          merchant: product.network,
          affiliateUrl: affiliateLink,
          // ID externo del comerciante (Item ID de AliExpress / ASIN): se
          // persiste como `sourceId` para que el filtro «En catálogo »
          // reconozca la fila aunque el enlace corto de afiliado cambie.
          sourceId: String(product.sourceId || product.externalId || '').trim() || undefined,
          // URL de la ficha real (no el enlace corto de afiliado): el servidor
          // la lee para complementar marca, specs, opiniones, envío y Buy Now.
          url: product.productUrl || affiliateLink,
          rating: product.rating,
          reviewsCount: product.reviewsCount,
          // Badge asignado automáticamente por el servidor (computeBadge) a
          // partir de los datos técnicos e IA; no se fuerza desde la fila.
          brand,
          specs,
          fulfillmentProvider,
          buyNowUrl,
          condition,
          pros: [`Comisión estimada: ${product.commissionRate ?? 0}% en ${product.network}`],
          cons: [],
          shippingInfo,
          shippingDays,
          freeShipping,
          // Resto de datos crudos que la API de la red facilita: antes se
          // descartaban al pulsar «Importar»/«Añadir» (sólo sobrevivía el
          // subconjunto de arriba). Ahora viajan como campos propios
          // (tipados) o dentro de `extra` (todo lo específico del conector:
          // Tienda, Almacén Local, Comisión Hot, Choice...), igual que hace
          // «Construir Catálogo».
          network: product.network,
          currency: product.currency,
          commissionRate: typeof product.commissionRate === 'number' ? product.commissionRate : undefined,
          commissionEstimate: typeof product.commissionAmount === 'number' ? product.commissionAmount : undefined,
          sales30d,
          inStock: typeof product.inStock === 'boolean' ? product.inStock : undefined,
          visits: typeof product.visits === 'number' ? product.visits : undefined,
          extra: product.extra && typeof product.extra === 'object' ? product.extra : undefined,
        },
      };
    }

    async function importSingleProduct(product, btn, categoryOverride) {
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Importando...';
      }
      try {
        const res = await fetch('/api/products/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildImportPayload(product, categoryOverride)),
        });
        const data = await res.json();
        // El servidor detecta duplicados (misma URL/título): se contabiliza como
        // «ya estaba», nunca como error ni como alta nueva.
        if (data && data.duplicate) {
          if (btn) {
            btn.disabled = true;
            btn.textContent = 'Añadido';
            btn.classList.add('is-added');
          }
          return { ok: true, duplicate: true, message: data.message, product: data.product };
        }
        if (data.success) {
          if (btn) {
            btn.textContent = 'Importado ✓';
            btn.classList.add('is-done');
          }
          return { ok: true, message: data.message, product: data.product };
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Importar a Tradylor';
        }
        return { ok: false, message: data.message || 'No se pudo guardar el producto.' };
      } catch {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Importar a Tradylor';
        }
        return { ok: false, message: 'Fallo de red al importar.' };
      }
      }

    /**
     * Letrero de confirmación anclado ENCIMA del botón «Añadir», dentro de la
     * celda de acciones. Se autodestruye a los pocos segundos; la tabla sólo se
     * repinta si el filtro «Estado» hace que la fila deba desaparecer.
     */
    function showAliImportFlag(btn, text, tone) {
      if (!btn) return;
      const cell = btn.closest('.aff-actions');
      if (!cell) return;
      const previous = cell.querySelector('.ac-added-flag');
      if (previous) previous.remove();
      const flag = document.createElement('span');
      flag.className = `ac-added-flag is-${tone || 'ok'}`;
      flag.setAttribute('role', 'status');
      flag.textContent = text;
      cell.appendChild(flag);
      window.setTimeout(() => flag.remove(), 2800);
    }

    /**
     * Marca el botón «Añadir» de una fila como YA AÑADIDO: texto «Añadido»,
     * color propio y estado inactivo (imposible repetir la alta).
     */
    function markAliImported(btn) {
      if (!btn) return;
      btn.disabled = true;
      btn.textContent = 'Añadido';
      btn.title = 'Ya está en el catálogo';
      btn.classList.remove('is-done');
      btn.classList.add('is-added');
    }

    /**
     * Botón «Añadir» de la fila con ese ID externo, tal como está pintada AHORA.
     * Tras un repintado el botón original desaparece del DOM, así que los avisos
     * se anclan en la fila recién renderizada (`data-ac-id`).
     */
    function aliImportButtonFor(externalId) {
      const wanted = String(externalId || '');
      if (!wanted) return null;
      for (const row of document.querySelectorAll('[data-ac-id]')) {
        if (String(row.getAttribute('data-ac-id') || '') === wanted) {
          return row.querySelector('[data-ac-import]') || null;
        }
      }
      return null;
    }

    /**
     * Categoría + subcategoría elegidas en la barra de acciones (#aliImportActions).
     * Devuelve `null` si no se ha elegido categoría (alta automática por keywords).
     */
    function aliChosenCategory() {
      const name = String((aliCatAssign && 'value' in aliCatAssign ? aliCatAssign.value : '') || '').trim();
      if (!name) return null;
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const catObj = allCats.find((c) => !c.parentId && c.name === name);
      const subName = String((aliSubcatAssign && 'value' in aliSubcatAssign ? aliSubcatAssign.value : '') || '').trim();
      const subObj = catObj ? allCats.find((c) => c.name === subName && c.parentId === catObj.id) : undefined;
      return { name, categoryId: catObj?.id || '', subcategoryId: subObj?.id || '', subName };
    }

    /**
     * Fija los IDs jerárquicos (category_id / subcategory_id) de productos ya
     * guardados: los endpoints de alta sólo persisten el nombre de categoría.
     */
    async function assignAliCategory(ids, chosen) {
      if (!ids.length || !chosen || !chosen.categoryId) return false;
      try {
        const res = await fetch('/api/products/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'set-category',
            ids,
            category: chosen.name,
            category_id: chosen.categoryId,
            subcategory_id: chosen.subcategoryId || '',
          }),
        });
        const data = await res.json();
        return Boolean(data && data.success);
      } catch {
        return false;
      }
    }

    /**
     * Botón «Añadir» de la tabla de productos de afiliados.
     * Guarda directamente en el catálogo de Tradylor (IA de texto + persistencia)
     * y sólo muestra un letrero sobre el botón: NO cambia de sección ni carga
     * el formulario de edición. Si hay categoría elegida en la barra de
     * acciones, el producto aterriza directamente en ella.
     */
    async function importAliProductToCatalog(product, btn) {
      const alreadyImported = aliEstadoIndex().get(product.externalId) === 'IMPORTED';
      // Guardia local: el botón ya sale desactivado, pero la caché de estados
      // podría estar desactualizada; en ningún caso se da de alta un duplicado.
      if (alreadyImported) {
        markAliImported(btn);
        showAliImportFlag(btn, 'Ya estaba en el catálogo', 'warn');
        return { ok: true, duplicate: true, product: null };
      }
      const chosen = aliChosenCategory();
      const basic = buildImportPayload(product, chosen ? chosen.name : undefined).product;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Guardando…';
      }
      try {
        const res = await fetch('/api/admin/add-product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: basic.id,
            title: basic.title,
            description: product.description,
            category: basic.category,
            price: basic.price,
            originalPrice: basic.originalPrice,
            image: basic.image,
            gallery: basic.gallery,
            affiliateUrl: basic.affiliateUrl,
            sourceId: basic.sourceId,
            merchant: product.network,
            url: product.productUrl,
            brand: basic.brand || (product.network === 'aliexpress' ? 'AliExpress' : product.network),
            rating: product.rating,
            reviewsCount: product.reviewsCount,
            specs: basic.specs,
            fulfillmentProvider: basic.fulfillmentProvider,
            buyNowUrl: basic.buyNowUrl,
            pros: basic.pros,
            cons: basic.cons,
            techSheet: basic.techSheet,
            shippingInfo: basic.shippingInfo,
            shippingDays: basic.shippingDays,
            freeShipping: basic.freeShipping,
            options: { text: true, image: false, save: true },
          }),
        });
        const data = await res.json();
        if (data && data.success) {
          // El servidor contesta `duplicate: true` si el producto ya existía
          // (misma URL o mismo título): no se crea una segunda fila.
          const duplicate = Boolean(alreadyImported || data.duplicate);
          // Categoría/subcategoría elegidas en la barra de acciones: además del
          // nombre, se fijan los IDs jerárquicos sobre el producto recién dado
          // de alta (los duplicados conservan la categoría que ya tenían).
          // Se hace ANTES de recargar, porque escribe en el servidor.
          if (!duplicate && chosen && chosen.categoryId) {
            await assignAliCategory([data.product?.id || basic.id], chosen);
          }
          // Espera a recargar el catálogo registrado: además de la tabla de
          // productos, `reloadProductsTable()` repinta la de afiliados con el
          // índice de estados ya actualizado.
          await reloadProductsTable();
          // La API devuelve los avisos en `enrichment.warnings` (`warnings` suelto sólo existe en el 502).
          const warnings = Array.isArray(data.enrichment?.warnings) ? data.enrichment.warnings : [];
          if (warnings.length) showAliStatus('warning', 'Añadido con avisos', warnings.join(' | '));
          // El letrero va en el botón RECIENTEMENTE pintado: el original ya no
          // existe en el DOM tras el repintado de la tabla.
          const freshBtn = aliImportButtonFor(product.externalId);
          if (freshBtn) {
            markAliImported(freshBtn);
            showAliImportFlag(
              freshBtn,
              duplicate ? 'Ya estaba en el catálogo' : 'Añadido al catálogo',
              duplicate ? 'warn' : 'ok',
            );
          } else {
            // La fila ya no se ve (filtro «No añadidos»): aviso en la tarjeta.
            showAliStatus(
              duplicate ? 'warning' : 'success',
              duplicate ? 'Ya estaba en el catálogo' : 'Añadido al catálogo',
              `«${product.title}» ${duplicate ? 'ya figuraba' : 'se ha añadido'} en el catálogo registrado.`,
            );
          }
          return { ok: true, duplicate, product: data.product };
        }
        const message = (data && data.message) || 'No se pudo añadir al catálogo.';
        showAliImportFlag(btn, message, 'error');
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Añadir';
        }
        return { ok: false, message };
      } catch {
        showAliImportFlag(btn, 'Fallo de red al añadir', 'error');
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Añadir';
        }
        return { ok: false, message: 'Fallo de red al importar.' };
      }
    }

