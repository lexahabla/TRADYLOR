                  <option value="Oferta -20%">Oferta -20%</option>
                  <option value="Chollo">Chollo</option>
                  <option value="Mínimo Histórico">Mínimo Histórico</option>
                </optgroup>
                <optgroup label="Prueba social / Popularidad">
                  <option value="Más Vendido">Más Vendido</option>
                  <option value="Recomendado">Recomendado</option>
                  <option value="Top Elección">Top Elección</option>
                </optgroup>
                <optgroup label="Novedad o Disponibilidad">
                  <option value="Nuevo">Nuevo</option>
                  <option value="Edición Limitada">Edición Limitada</option>
                  <option value="Últimas Unidades">Últimas Unidades</option>
                </optgroup>
                <optgroup label="Criterios técnicos o de valor">
                  <option value="Mejor Calidad/Precio">Mejor Calidad/Precio</option>
                  <option value="Calidad Premium">Calidad Premium</option>
                  <option value="Sostenible">Sostenible</option>
                </optgroup>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodPros" class="field-label">Puntos Fuertes (Pros) <span class="label-hint">(Uno por línea)</span></label>
              <textarea id="prodPros" rows="3"></textarea>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodCons" class="field-label">Puntos a Considerar (Contras) <span class="label-hint">(Uno por línea)</span></label>
              <textarea id="prodCons" rows="3"></textarea>
            </div>
          </div>

          <!-- Campos adicionales (personalizados): se crean y se marcan
               visibles/ocultos desde «Catálogo › Campos visibles en la
               ficha». Cada uno vive en product.extra[clave] y aparece aquí
               automáticamente en cuanto se da de alta; vacío mientras no se
               haya creado ninguno. -->
          <div class="form-row" id="customFieldsSection" hidden>
            <div class="form-group full-width">
              <label class="field-label">
                <span>Campos adicionales</span>
                <span class="label-hint">Definidos desde «Catálogo › Campos visibles en la ficha»</span>
              </label>
              <div id="customFieldsContainer" class="custom-fields-container"></div>
            </div>
          </div>

          <!-- Botones de Acción -->
          <div class="form-actions">
            <button type="button" id="btnAiEnrich" class="btn-ai">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z" />
                <path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z" />
              </svg>
              <span>Enriquecer con IA (título + ficha + imagen)</span>
            </button>
            <button type="submit" id="btnSaveProduct" class="btn-success">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
              </svg>
              <span id="btnSaveProductLabel">Guardar cambios</span>
            </button>
          </div>
            </div><!-- /.form-fields -->

            <!-- Columna derecha: vista previa en vivo (carrusel) + galería -->
            <div class="form-preview-col">
              <div class="preview-product-card">
                <div class="preview-image-wrapper">
                  <span class="preview-badge-row">
                    <span id="previewCategory" class="cat-pill" hidden></span>
                    <span id="previewBadge" class="badge-pill" hidden></span>
                  </span>
                  <span id="previewEmptyImage" class="preview-empty-image">
                    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <path d="M21 15l-5-5L5 21"></path>
                    </svg>
                    Vista previa del carrusel
                  </span>
                  <img id="previewImg" alt="Vista previa del producto" />
                  <button type="button" id="previewVideoOverlay" class="preview-video-overlay" hidden>
                    <span class="preview-play-icon">▶</span>
                    Ver vídeo
                  </button>
                  <button type="button" id="previewPrev" class="preview-nav preview-nav-prev" aria-label="Imagen anterior" hidden>‹</button>
                  <button type="button" id="previewNext" class="preview-nav preview-nav-next" aria-label="Imagen siguiente" hidden>›</button>
                  <span id="previewCounter" class="preview-counter" hidden>1 / 1</span>
                </div>
                <div class="preview-content">
                  <div class="preview-merchant-row">
                    <span id="previewMerchant" class="merchant-tag" hidden></span>
                    <span class="rating-stars" aria-hidden="true">★★★★★</span>
                  </div>
