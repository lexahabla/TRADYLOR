        </div>

        <div class="tp-options">
          <label class="tp-provider" for="skillPersona">
            <span class="tp-provider-label">Personalidad</span>
            <select id="skillPersona" title="Personalidad a la que se añade la instrucción">
              <option value="dependiente">Dependiente IA (usuario)</option>
              <option value="admin">Consola IA (admin)</option>
