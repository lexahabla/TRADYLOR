              <span id="migrateManualCount" class="migrate-manual-count">0 seleccionados</span>
              <button type="button" id="btnMigrateManualClear" class="btn-secondary btn-sm" title="Quita todas las asignaciones manuales">
                <span class="btn-text">Limpiar</span>
              </button>
              <button type="button" id="btnMigrateManualRun" class="btn-danger btn-sm" title="Ejecuta la migración aplicando las asignaciones manuales">
                <span class="btn-text">🔄 Migrar con estas asignaciones</span>
                <div class="btn-spinner" hidden></div>
              </button>
            </div>
          </div>
          <div id="migrateManualList" class="migrate-manual-list"></div>
        </div>
      </div>

      <!-- 3. Tabla compacta de categorías existentes -->
      <div class="admin-card">
        <div class="card-header">
          <div class="header-icon icon-cyan">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1"></rect>
            </svg>
          </div>
          <div>
            <h2 class="card-title">2. Categorías y subcategorías</h2>
            <p class="card-desc">Lista jerárquica compacta: icono, nombre, palabras clave, conteo de productos y acciones (añadir subcategoría, editar, eliminar).</p>
