<!-- Client-side Script para interacción dinámica del panel -->
<script is:inline define:vars={{ associateTag: getAmazonAssociateTag(), apiToken: import.meta.env.TRADYLOR_API_TOKEN ?? process.env.TRADYLOR_API_TOKEN }}>
  window.TRADYLOR_ASSOCIATE_TAG = associateTag;
  window.TRADYLOR_API_TOKEN = apiToken;
</script>
<!--
  Módulo de filtros del catálogo AliExpress (TypeScript, bundled por Astro).
  Se publica en `window` porque el script principal del panel es `is:inline`
  (JS clásico, sin imports): los módulos se ejecutan SIEMPRE antes de
  DOMContentLoaded, así que el panel lo encuentra montado en su arranque.
-->
<script>
  import { filterAliCatalog, mountAliFilters, queryAliCatalog } from '../utils/aliCatalogFilters';
  window.tradylorAliFilters = { filterAliCatalog, mountAliFilters, queryAliCatalog };
</script>
<script is:inline>
  // Inicialización de estado y elementos DOM
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs
    const inputScrapeUrl = document.getElementById('inputScrapeUrl');
    const btnScrape = document.getElementById('btnScrape');
    const btnSpinner = btnScrape ? btnScrape.querySelector('.btn-spinner') : null;
    const btnText = btnScrape ? btnScrape.querySelector('.btn-text') : null;

    const scrapeStatusAlert = document.getElementById('scrapeStatusAlert');
    const statusAlertIcon = document.getElementById('statusAlertIcon');
    const statusAlertTitle = document.getElementById('statusAlertTitle');
    const statusAlertText = document.getElementById('statusAlertText');

    const productForm = document.getElementById('productForm');
    const prodId = document.getElementById('prodId');
    const prodTitle = document.getElementById('prodTitle');
    const prodPrice = document.getElementById('prodPrice');
    const prodOriginalPrice = document.getElementById('prodOriginalPrice');
    const prodCategory = document.getElementById('prodCategory');
    const prodMerchant = document.getElementById('prodMerchant');
    const prodAffiliateUrl = document.getElementById('prodAffiliateUrl');
    const prodBuyNowUrl = document.getElementById('prodBuyNowUrl');

    // Autodetección de ASIN: al pegar el enlace de afiliado o la URL del producto
    // se genera el enlace de Compra Directa (Buy Now) si el campo está vacío.
    const AMAZON_ASIN_IN_PATH_RE = /\/(?:dp|gp\/product|gp\/aw\/d|product)\/([A-Za-z0-9]{10})(?:[/?#]|$)/;
    const ASIN_QUERY_RE = /[?&]asin=([A-Za-z0-9]{10})(?:[&#]|$)/;
    function extractAsinFromUrl(url) {
      const raw = String(url || '').trim();
      if (!raw) return '';
      const pathAndQuery = (() => {
        try {
          const u = new URL(raw);
          return u.pathname + u.search;
        } catch {
          return raw;
        }
      })();
      const match = AMAZON_ASIN_IN_PATH_RE.exec(pathAndQuery) || ASIN_QUERY_RE.exec(pathAndQuery);
      return match ? match[1].toUpperCase() : '';
    }
    function buildAmazonCartUrl(asin) {
      const clean = String(asin || '').trim().toUpperCase();
      if (!/^[A-Z0-9]{10}$/.test(clean)) return '';
      const tag = window.TRADYLOR_ASSOCIATE_TAG || 'tradylor-21';
      const params = new URLSearchParams({ 'ASIN.1': clean, 'Quantity.1': '1', AssociateTag: tag });
      return `https://www.amazon.es/gp/aws/cart/add.html?${params.toString()}`;
    }
    function autoFillBuyNow(url) {
      const asin = extractAsinFromUrl(url);
      if (!asin || !prodBuyNowUrl) return;
      // Compra directa generada: cesta de Amazon con el tag → tramitación del pedido.
      if (!prodBuyNowUrl.value.trim()) {
        prodBuyNowUrl.value = buildAmazonCartUrl(asin);
      }
    }
    // Sincronización bidireccional entre "URL del Producto" y "Enlace de Afiliado Final".
    function syncUrlFields(source, target) {
      const value = String(source.value || '').trim();
      if (value && target && !String(target.value || '').trim()) target.value = value;
    }
    if (prodAffiliateUrl) {
      prodAffiliateUrl.addEventListener('input', () => {
        syncUrlFields(prodAffiliateUrl, inputScrapeUrl);
        autoFillBuyNow(prodAffiliateUrl.value);
      });
    }
    if (inputScrapeUrl) {
      inputScrapeUrl.addEventListener('input', () => {
        syncUrlFields(inputScrapeUrl, prodAffiliateUrl);
        autoFillBuyNow(prodAffiliateUrl.value);
      });
    }
    const prodImage = document.getElementById('prodImage');
    const prodBadge = document.getElementById('prodBadge');
    const prodShippingInfo = document.getElementById('prodShippingInfo');
    const prodShippingDays = document.getElementById('prodShippingDays');
    const prodFreeShipping = document.getElementById('prodFreeShipping');
    const prodDescription = document.getElementById('prodDescription');
    const prodVerdict = document.getElementById('prodVerdict');
    const prodTechSheet = document.getElementById('prodTechSheet');
    const prodPros = document.getElementById('prodPros');
    const prodCons = document.getElementById('prodCons');
    const prodBrand = document.getElementById('prodBrand');
    const prodFulfillment = document.getElementById('prodFulfillment');
    const prodRating = document.getElementById('prodRating');
    const prodReviews = document.getElementById('prodReviews');
    const prodSpecs = document.getElementById('prodSpecs');
    const btnSaveProduct = document.getElementById('btnSaveProduct');
    const btnAiEnrich = document.getElementById('btnAiEnrich');

    // Specs (clave/valor): conversión entre objeto y texto «Clave: Valor» por línea.
    function specsToText(specs) {
      if (!specs || typeof specs !== 'object' || Array.isArray(specs)) return '';
      return Object.entries(specs)
        .filter(([k, v]) => k && v != null && String(v).trim())
        .map(([k, v]) => `${k}: ${v}`)
        .join('\n');
    }
    function textToSpecs(text) {
      const specs = {};
      String(text || '')
        .split('\n')
        .map((l) => l.trim())
        .filter(Boolean)
        .forEach((line) => {
          const idx = line.indexOf(':');
          if (idx > 0) {
            const key = line.slice(0, idx).trim();
            const value = line.slice(idx + 1).trim();
            if (key && value) specs[key] = value;
          }
        });
      return Object.keys(specs).length ? specs : undefined;
    }

    // Plegar/desplegar el formulario de alta desde su card-header.
    const formCardHeader = document.querySelector('.form-card .card-header-toggle');
    let formExpanded = false;
    function setFormPanelExpanded(expanded) {
      formExpanded = Boolean(expanded);
      document.querySelectorAll('.form-card .form-toggle-body').forEach((body) => {
        body.style.display = formExpanded ? '' : 'none';
      });
      if (formCardHeader) formCardHeader.setAttribute('aria-expanded', String(formExpanded));
    }
    if (formCardHeader) {
      formCardHeader.style.cursor = 'pointer';
      formCardHeader.setAttribute('role', 'button');
      formCardHeader.setAttribute('tabindex', '0');
      setFormPanelExpanded(false);
      formCardHeader.addEventListener('click', () => setFormPanelExpanded(!formExpanded));
      formCardHeader.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setFormPanelExpanded(!formExpanded);
        }
      });
    }

    // Lleva el scroll al inicio del panel «Extracción & Alta de Producto».
    // Se calcula tras el repintado (rAF) porque desplegar el panel cambia el layout.
    function scrollToFormPanel() {
      const card = document.querySelector('.form-card');
      if (!card) return;
      requestAnimationFrame(() => {
        const top = window.scrollY + card.getBoundingClientRect().top - 80;
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      });
    }

    // Extras del último scrape (specs, marca, valoración, reseñas) para el enriquecimiento local.
    let scrapeExtras = { brand: '', rating: null, reviewsCount: null, specs: null };
    // Galería de imágenes del último scrape (la primera es la principal).
    let scrapedGallery = [];
    const galleryThumbs = document.getElementById('galleryThumbs');
    const galleryFileInput = document.getElementById('galleryFileInput');
    const galleryUrlInput = document.getElementById('galleryUrlInput');
    const btnAddImageUrl = document.getElementById('btnAddImageUrl');
    let galleryDragFrom = null;
    let galleryDragEndedAt = 0;

    // Preview
    const previewImg = document.getElementById('previewImg');
    const previewEmptyImage = document.getElementById('previewEmptyImage');
    const previewPrev = document.getElementById('previewPrev');
    const previewNext = document.getElementById('previewNext');
    const previewCounter = document.getElementById('previewCounter');
    let previewGallery = [];
    let previewIndex = 0;
    const previewCategory = document.getElementById('previewCategory');
    const previewBadge = document.getElementById('previewBadge');
    const previewMerchant = document.getElementById('previewMerchant');
    const previewTitle = document.getElementById('previewTitle');
    const previewDesc = document.getElementById('previewDesc');
    const previewPrice = document.getElementById('previewPrice');
    const previewOriginalPrice = document.getElementById('previewOriginalPrice');
    const previewDiscount = document.getElementById('previewDiscount');
    const previewProsList = document.getElementById('previewProsList');
    const previewBulletsWrap = document.getElementById('previewBulletsWrap');
    const previewAffiliateBtn = document.getElementById('previewAffiliateBtn');
    const previewBtnMerchant = document.getElementById('previewBtnMerchant');

    // Listado de productos
    const productsTableBody = document.getElementById('productsTableBody');
    const inputFilterList = document.getElementById('inputFilterList');
    const prodFCat = document.getElementById('prodFCat');
    const prodSubcatFilter = document.getElementById('prodSubcatAssign');
    const prodFSort = document.getElementById('prodFSort');
    const prodFSortDir = document.getElementById('prodFSortDir');
    const prodFReset = document.getElementById('prodFReset');
    const prodRangeFields = document.getElementById('prodRangeFields');
    const productSelBar = document.getElementById('productSelBar');
    const productSelCount = document.getElementById('productSelCount');
    const prodCheckAll = document.getElementById('prodCheckAll');
    const btnProdSelAll = document.getElementById('btnProdSelAll');
    const btnProdSelClear = document.getElementById('btnProdSelClear');
    const btnProdEnrich = document.getElementById('btnProdEnrich');
    const btnProdMakeSection = document.getElementById('btnProdMakeSection');
    const prodCatAssign = document.getElementById('prodCatAssign');
    const btnProdAssignCat = document.getElementById('btnProdAssignCat');
    let selectedProductIds = new Set();
    let currentProducts = [];
    // Paginación del catálogo de productos
    let currentPage = 1;
    const PRODUCTS_PER_PAGE = 50;
    let filteredProducts = [];
    /**
     * Caché de `externalId → estado de importación` del catálogo AliExpress
     * (PENDING / IMPORTED / DISCARDED). Se invalida con `aliInvalidateEstado()`
     * cada vez que cambia el catálogo registrado, la caché de Ali o los
     * descartes locales. Declarada aquí (y no en el bloque AliExpress) porque
     * `reloadProductsTable()` la toca antes de llegar a esa sección.
     */
    let aliEstadoCache = null;
    let categoriesCache = [];
    let activeProdPreset = '';
    let aliFilterPanel = null;

    // Helper para mostrar feedback de alerta
    function showAlert(type, title, message) {
      if (!scrapeStatusAlert) return;
      scrapeStatusAlert.hidden = false;
      scrapeStatusAlert.className = `status-alert alert-${type}`;
      
      if (type === 'success') {
        statusAlertIcon.textContent = '✅';
      } else if (type === 'warning') {
        statusAlertIcon.textContent = '⚠️';
      } else if (type === 'loading') {
        statusAlertIcon.textContent = '⏳';
      } else {
        statusAlertIcon.textContent = '❌';
      }

      statusAlertTitle.textContent = title;
      statusAlertText.textContent = message;
    }

    function hideAlert() {
      if (scrapeStatusAlert) scrapeStatusAlert.hidden = true;
    }

    function setProductField(field, value) {
      if (!field || value === undefined || value === null) return;
      field.value = String(value);
      field.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // Rellena un campo SOLO si está vacío: el scraper nunca pisa lo escrito a mano.
    function fillIfEmpty(field, value) {
      if (!field || value === undefined || value === null || value === '') return;
      if (String(field.value || '').trim() !== '') return;
      setProductField(field, value);
    }

    // ── Vídeos en la galería (helper + modal centrado) ──────────────────────
    function isVideoUrl(url) {
      const u = String(url || '').trim().toLowerCase();
      if (!u) return false;
      if (/\.(mp4|webm|mov|m4v|ogv)(\?|#|$)/.test(u)) return true;
      return /(youtube\.com|youtu\.be|vimeo\.com|dailymotion\.com)/.test(u);
    }

    function videoEmbedUrl(url, autoplay) {
      const u = String(url || '').trim();
      const yt = u.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/i);
      if (yt) return `https://www.youtube.com/embed/${yt[1]}${autoplay ? '?autoplay=1&mute=1' : ''}`;
      const vimeo = u.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
      if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}${autoplay ? '?autoplay=1&mute=1' : ''}`;
      const dailymotion = u.match(/dailymotion\.com\/(?:video|embed\/video)\/([\w]+)/i);
      if (dailymotion) return `https://www.dailymotion.com/embed/video/${dailymotion[1]}${autoplay ? '?autoplay=1' : ''}`;
      return null;
    }

    // Miniatura (fotograma) del vídeo: YouTube/Vimeo/Dailymotion dan URL de
    // imagen; los archivos directos (mp4/webm) se previsualizan con <video>.
    function videoThumbUrl(url) {
      const u = String(url || '').trim();
      const yt = u.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/i);
      if (yt) return `https://i.ytimg.com/vi/${yt[1]}/hqdefault.jpg`;
      const vimeo = u.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
      if (vimeo) return `https://vumbnail.com/${vimeo[1]}.jpg`;
      const dailymotion = u.match(/dailymotion\.com\/(?:video|embed\/video)\/([\w]+)/i);
      if (dailymotion) return `https://www.dailymotion.com/thumbnail/video/${dailymotion[1]}`;
      return null;
    }

    const videoModal = document.getElementById('videoModal');
    const videoModalBody = document.getElementById('videoModalBody');

    function openVideoModal(url) {
      if (!videoModal || !videoModalBody || !url) return;
      const embed = videoEmbedUrl(url, true);
      if (embed) {
        const iframe = document.createElement('iframe');
        iframe.src = embed;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        videoModalBody.appendChild(iframe);
      } else {
        const video = document.createElement('video');
        video.src = url;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        videoModalBody.appendChild(video);
      }
      videoModal.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeVideoModal() {
      if (!videoModal) return;
      videoModal.hidden = true;
      if (videoModalBody) videoModalBody.innerHTML = '';
      document.body.style.overflow = '';
    }

    if (videoModal) {
      videoModal.addEventListener('click', (e) => {
        if (e.target && e.target.closest && e.target.closest('[data-video-modal-close]')) closeVideoModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !videoModal.hidden) closeVideoModal();
      });
    }

    // Renderiza la galería de imágenes/vídeos como miniaturas seleccionables.
    // La imagen principal (prodImage) se marca con un borde destacado;
    // los vídeos se reproducen en el modal centrado. Arrastrable para reordenar.
    function moveGalleryItem(fromIndex, toIndex, insertAfter) {
      if (fromIndex == null || toIndex == null || fromIndex === toIndex) return;
      const list = scrapedGallery.slice();
      const [moved] = list.splice(fromIndex, 1);
      if (moved === undefined) return;
      let target = toIndex;
      if (fromIndex < toIndex) target -= 1;
      let insertAt = insertAfter ? target + 1 : target;
      if (insertAt < 0) insertAt = 0;
      if (insertAt > list.length) insertAt = list.length;
      list.splice(insertAt, 0, moved);
      scrapedGallery = list;
    }

    function clearGalleryDropMarks() {
      if (!galleryThumbs) return;
      galleryThumbs.querySelectorAll('.gallery-item').forEach((el) => {
        el.classList.remove('drag-before', 'drag-after');
      });
    }

    function renderGallery() {
      if (!galleryThumbs) return;
      galleryThumbs.innerHTML = '';
      const current = (prodImage.value || '').trim();
      if (!scrapedGallery.length) {
        galleryThumbs.innerHTML = '<span class="gallery-empty">Sin galería. Analiza un enlace o añade imágenes/vídeos.</span>';
        return;
      }
      scrapedGallery.forEach((url, index) => {
        const isVideo = isVideoUrl(url);
        const wrap = document.createElement('div');
        wrap.className = 'gallery-item' + (!isVideo && url === current ? ' is-main' : '');
        wrap.draggable = true;

        wrap.addEventListener('dragstart', (e) => {
          galleryDragFrom = index;
          wrap.classList.add('is-dragging');
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', url);
          }
        });

        wrap.addEventListener('dragover', (e) => {
          if (galleryDragFrom === null || galleryDragFrom === index) return;
          e.preventDefault();
          if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
          const rect = wrap.getBoundingClientRect();
          const after = e.clientX - rect.left >= rect.width / 2;
          galleryThumbs.querySelectorAll('.gallery-item').forEach((el) => {
            if (el !== wrap) el.classList.remove('drag-before', 'drag-after');
          });
          wrap.classList.toggle('drag-after', after);
          wrap.classList.toggle('drag-before', !after);
        });

        wrap.addEventListener('dragleave', (e) => {
          if (e.relatedTarget && wrap.contains(e.relatedTarget)) return;
          wrap.classList.remove('drag-before', 'drag-after');
        });

        wrap.addEventListener('drop', (e) => {
          e.preventDefault();
          clearGalleryDropMarks();
          const from = galleryDragFrom;
          galleryDragFrom = null;
          galleryDragEndedAt = Date.now();
          if (from === null || from === index) return;
          const rect = wrap.getBoundingClientRect();
          moveGalleryItem(from, index, e.clientX - rect.left >= rect.width / 2);
          const firstImage = scrapedGallery.find((u) => !isVideoUrl(u)) || '';
          setProductField(prodImage, firstImage);
          previewIndex = firstImage ? scrapedGallery.indexOf(firstImage) : 0;
          renderGallery();
          updatePreview();
          showAlert('success', 'Orden actualizado', 'La primera imagen de la galería pasa a ser la imagen principal.');
        });

        wrap.addEventListener('dragend', () => {
          wrap.classList.remove('is-dragging');
          clearGalleryDropMarks();
          galleryDragFrom = null;
          galleryDragEndedAt = Date.now();
        });

        const thumb = document.createElement('button');
        thumb.type = 'button';
        thumb.className = 'gallery-thumb';

        if (isVideo) {
          thumb.title = 'Reproducir vídeo';
          const still = videoThumbUrl(url);
          if (still) {
            // Plataforma (YouTube/Vimeo/DM): se muestra su miniatura oficial.
            const img = document.createElement('img');
            img.src = still;
            img.className = 'video-still';
            img.alt = 'Miniatura del vídeo';
            img.loading = 'lazy';
            thumb.appendChild(img);
          } else {
            // Archivo directo (mp4/webm): primer fotograma del propio vídeo.
            const vid = document.createElement('video');
            vid.src = url;
            vid.muted = true;
            vid.preload = 'metadata';
            vid.playsInline = true;
            thumb.appendChild(vid);
          }
          const badge = document.createElement('span');
          badge.className = 'gallery-play-badge';
          badge.textContent = '▶';
          wrap.appendChild(badge);
          thumb.addEventListener('click', () => {
            if (Date.now() - galleryDragEndedAt < 300) return;
            openVideoModal(url);
          });
        } else {
          thumb.title = 'Clic: imagen principal · Arrastra: reordenar';
          const img = document.createElement('img');
          img.src = url;
          img.alt = 'Imagen del producto';
          img.loading = 'lazy';
          thumb.appendChild(img);
          thumb.addEventListener('click', () => {
            if (Date.now() - galleryDragEndedAt < 300) return;
            setProductField(prodImage, url);
            previewIndex = scrapedGallery.indexOf(url);
            if (previewIndex < 0) previewIndex = 0;
            renderGallery();
            updatePreview();
          });
        }

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'gallery-remove';
        removeBtn.title = 'Quitar de la galería';
        removeBtn.textContent = '×';
        removeBtn.draggable = false;
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (Date.now() - galleryDragEndedAt < 300) return;
          scrapedGallery = scrapedGallery.filter((u) => u !== url);
          if ((prodImage.value || '').trim() === url) {
            const firstImage = scrapedGallery.find((u) => !isVideoUrl(u)) || '';
            setProductField(prodImage, firstImage);
          }
          renderGallery();
          updatePreview();
        });

        wrap.appendChild(thumb);
        wrap.appendChild(removeBtn);
        galleryThumbs.appendChild(wrap);
      });
    }

    // Añade imágenes/vídeos a la galería por URL (separadas por comas/espacios).
    // Acepta URLs de vídeo (YouTube, Vimeo, Dailymotion, mp4/webm) e imágenes.
    function addImagesByUrl() {
      const raw = (galleryUrlInput?.value || '').trim();
      if (!raw) return;
      const parts = raw.split(/[\s,]+/).map((s) => s.trim()).filter(Boolean);
      let addedImages = 0;
      let addedVideos = 0;
      for (let part of parts) {
        // Ruta local válida para la galería (p. ej. /images/products/x.jpg).
        if (part.startsWith('/') && !part.startsWith('//')) {
          if (!scrapedGallery.includes(part)) {
            scrapedGallery.push(part);
            addedImages++;
          }
          continue;
        }
        // Normaliza: acepta también URLs pegadas sin protocolo (youtu.be/..., youtube.com/...).
        if (part.startsWith('//')) part = `https:${part}`;
        else if (!/^https?:\/\//i.test(part)) part = `https://${part}`;
        if (!scrapedGallery.includes(part)) {
          scrapedGallery.push(part);
          if (isVideoUrl(part)) addedVideos++;
          else addedImages++;
        }
      }
      if (galleryUrlInput) galleryUrlInput.value = '';
      if (!addedImages && !addedVideos && parts.length) {
        showAlert('warning', 'URL no válida', 'Introduce una imagen o vídeo (p. ej. https://youtube.com/watch?v=...).');
        return;
      }
      if (addedImages && !(prodImage.value || '').trim()) {
        const firstImage = scrapedGallery.find((u) => !isVideoUrl(u));
        if (firstImage) setProductField(prodImage, firstImage);
      }
      renderGallery();
      updatePreview();
      const bits = [];
      if (addedImages) bits.push(`${addedImages} imagen(es)`);
      if (addedVideos) bits.push(`${addedVideos} vídeo(s)`);
      if (bits.length) showAlert('success', 'Añadido a la galería', bits.join(' y '));
    }

    // Sube archivos de imagen/vídeo al servidor y los añade a la galería.
    async function uploadGalleryFiles(fileList) {
      const files = Array.from(fileList || []).filter(
        (f) => f.type.startsWith('image/') || f.type.startsWith('video/')
      );
      if (!files.length) return;
      if (btnAddImageUrl) btnAddImageUrl.disabled = true;
      showAlert('loading', 'Subiendo archivos...', `${files.length} imagen(es)/vídeo(s) al servidor.`);
      try {
        const fd = new FormData();
        files.forEach((f) => fd.append('images', f));
        const response = await fetch('/api/admin/upload-image', { method: 'POST', body: fd });
        const result = await response.json();
        if (result.success && Array.isArray(result.urls)) {
          for (const url of result.urls) {
            if (!scrapedGallery.includes(url)) scrapedGallery.push(url);
          }
          if (!(prodImage.value || '').trim()) {
            const firstImage = result.urls.find((u) => !isVideoUrl(u));
            if (firstImage) setProductField(prodImage, firstImage);
          }
          renderGallery();
          updatePreview();
          showAlert('success', 'Archivos subidos', `${result.urls.length} archivo(s) añadido(s) a la galería.`);
        } else {
          showAlert('error', 'No se pudieron subir', result.message || 'Error al subir los archivos.');
        }
      } catch (err) {
        console.error(err);
        showAlert('error', 'Error de red', 'No se pudo contactar con /api/admin/upload-image.');
      } finally {
        if (btnAddImageUrl) btnAddImageUrl.disabled = false;
        if (galleryFileInput) galleryFileInput.value = '';
      }
    }

    if (btnAddImageUrl) btnAddImageUrl.addEventListener('click', addImagesByUrl);
    if (galleryUrlInput) galleryUrlInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); addImagesByUrl(); } });
    if (galleryFileInput) galleryFileInput.addEventListener('change', (e) => uploadGalleryFiles(e.target.files));

    // Actualiza la vista previa interactiva en tiempo real
    // Dibuja la imagen/vídeo actual del carrusel y controla flechas/contador.
    // Los vídeos se muestran con su miniatura (fotograma) y botón play encima.
    const previewVideoOverlay = document.getElementById('previewVideoOverlay');
    let previewVideoThumb = null;

    function clearPreviewVideoThumb() {
      if (previewVideoThumb && previewVideoThumb.parentNode) {
        previewVideoThumb.parentNode.removeChild(previewVideoThumb);
      }
      previewVideoThumb = null;
    }

    function renderPreviewImage() {
      if (!previewImg) return;
      const total = previewGallery.length;
      const hasMedia = total > 0;
      clearPreviewVideoThumb();
      previewImg.hidden = !hasMedia;
      if (previewEmptyImage) previewEmptyImage.hidden = hasMedia;

      if (hasMedia) {
        if (previewIndex >= total) previewIndex = 0;
        if (previewIndex < 0) previewIndex = total - 1;
        const current = previewGallery[previewIndex];
        if (isVideoUrl(current)) {
          const still = videoThumbUrl(current);
          if (still) {
            // Plataforma: se ve la miniatura oficial + overlay play.
            previewImg.hidden = false;
            previewImg.src = still;
          } else {
            // Archivo directo: <video> con el primer fotograma + overlay play.
            previewImg.hidden = true;
            const vid = document.createElement('video');
            vid.className = 'preview-video-thumb';
            vid.src = current;
            vid.muted = true;
            vid.preload = 'metadata';
            vid.playsInline = true;
            vid.setAttribute('aria-hidden', 'true');
            const wrapper = previewImg.parentElement;
            if (wrapper) wrapper.insertBefore(vid, previewImg);
            previewVideoThumb = vid;
          }
          if (previewVideoOverlay) previewVideoOverlay.hidden = false;
        } else {
          if (previewVideoOverlay) previewVideoOverlay.hidden = true;
          previewImg.src = current;
        }
      } else if (previewVideoOverlay) {
        previewVideoOverlay.hidden = true;
      }

      const showNav = total > 1;
      if (previewPrev) previewPrev.hidden = !showNav;
      if (previewNext) previewNext.hidden = !showNav;
      if (previewCounter) {
        previewCounter.hidden = !showNav;
        if (showNav) previewCounter.textContent = `${previewIndex + 1} / ${total}`;
      }
    }

    // Flechas del carrusel: navegar por la galería de la vista previa.
    if (previewPrev) previewPrev.addEventListener('click', () => { previewIndex--; renderPreviewImage(); });
    if (previewNext) previewNext.addEventListener('click', () => { previewIndex++; renderPreviewImage(); });
    // Overlay de vídeo de la vista previa: abre el modal centrado.
    if (previewVideoOverlay) {
      previewVideoOverlay.addEventListener('click', () => {
        const current = previewGallery[previewIndex];
        if (current && isVideoUrl(current)) openVideoModal(current);
      });
    }

    function updatePreview() {
      const title = prodTitle.value.trim();
      const price = parseFloat(prodPrice.value) || 0;
      const originalPrice = parseFloat(prodOriginalPrice.value) || 0;
      const category = prodCategory.value.trim();
      const merchant = prodMerchant.value;
      const image = prodImage.value.trim();
      const badge = prodBadge.value.trim();
      const desc = prodDescription.value.trim();
      const url = prodAffiliateUrl.value.trim() || '#';

      if (previewTitle) previewTitle.textContent = title;
      if (previewDesc) previewDesc.textContent = desc;
      if (previewPrice) previewPrice.textContent = `${price.toFixed(2)} €`;
      if (previewCategory) previewCategory.textContent = category;
      if (previewMerchant) previewMerchant.textContent = merchant;
      if (previewBtnMerchant) previewBtnMerchant.textContent = merchant;

      // Carrusel de la vista previa: usa la galería (scrapedGallery) o la imagen principal.
      previewGallery = Array.isArray(scrapedGallery) && scrapedGallery.length
        ? scrapedGallery.slice()
        : (image ? [image] : []);
      if (!previewGallery.length && image) previewGallery = [image];
      if (previewIndex >= previewGallery.length) previewIndex = 0;
      renderPreviewImage();

      if (previewAffiliateBtn) {
        previewAffiliateBtn.href = url;
        previewAffiliateBtn.hidden = !prodAffiliateUrl.value.trim();
      }
      if (previewCategory) previewCategory.hidden = !category;
      if (previewMerchant) previewMerchant.hidden = !merchant;
      if (previewDesc) previewDesc.hidden = !desc;
      if (previewPrice) previewPrice.parentElement.parentElement.hidden = price <= 0;

      if (previewBadge) {
        if (badge) {
          previewBadge.textContent = badge;
          previewBadge.hidden = false;
        } else {
          previewBadge.hidden = true;
        }
      }

      if (previewOriginalPrice && previewDiscount) {
        if (originalPrice > price && price > 0) {
          previewOriginalPrice.textContent = `${originalPrice.toFixed(2)} €`;
          previewOriginalPrice.hidden = false;
          const discountPct = Math.round(((originalPrice - price) / originalPrice) * 100);
          previewDiscount.textContent = `-${discountPct}%`;
          previewDiscount.hidden = false;
        } else {
          previewOriginalPrice.hidden = true;
          previewDiscount.hidden = true;
        }
      }

      if (previewProsList) {
        const pros = prodPros.value
          .split('\n')
          .map((s) => s.trim())
          .filter(Boolean);
        previewProsList.innerHTML = '';
        if (pros.length > 0) {
          if (previewBulletsWrap) previewBulletsWrap.hidden = false;
          pros.slice(0, 3).forEach((pro) => {
            const li = document.createElement('li');
            li.textContent = pro;
            previewProsList.appendChild(li);
          });
        } else {
          if (previewBulletsWrap) previewBulletsWrap.hidden = true;
        }
      }
    }

    // Escuchadores para actualización en vivo del preview
    [
      prodTitle,
      prodPrice,
      prodOriginalPrice,
      prodCategory,
      prodMerchant,
      prodAffiliateUrl,
      prodImage,
      prodBadge,
      prodDescription,
      prodPros,
    ].forEach((el) => {
      if (el) el.addEventListener('input', updatePreview);
    });

    // =========================================================================
    // 1. ANALIZAR URL (Scraping Híbrido con Endpoint API)
    // =========================================================================
    if (btnScrape && inputScrapeUrl) {
      btnScrape.addEventListener('click', async () => {
        const urlToScrape = inputScrapeUrl.value.trim();
        if (!urlToScrape) {
          showAlert('warning', 'URL requerida', 'Por favor, pega el enlace del producto antes de analizar.');
          inputScrapeUrl.focus();
          return;
        }

        // Estado visual de carga
        btnScrape.disabled = true;
        if (btnSpinner) btnSpinner.hidden = false;
        if (btnText) btnText.textContent = 'Extrayendo...';
        showAlert('loading', 'Analizando página externa...', 'Haciendo fetch con User-Agent legítimo y extrayendo OpenGraph/Schemas.');

        try {
          const response = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'scrape', url: urlToScrape }),
          });

          const result = await response.json();

          if (!result.success) {
            showAlert('error', 'Error en análisis', result.message || 'No se pudo procesar la solicitud.');
            return;
          }

          const data = result.data || {};

          // Rellenar campos del formulario SOLO si están vacíos (nunca pisa lo manual).
          fillIfEmpty(prodTitle, data.title || data.name || '');
          fillIfEmpty(prodImage, data.image || '');
          fillIfEmpty(prodDescription, data.description || '');
          fillIfEmpty(prodPrice, data.price ?? '');
          fillIfEmpty(prodOriginalPrice, data.originalPrice ?? '');
          fillIfEmpty(prodCategory, data.category || 'Tecnología');
          fillIfEmpty(prodMerchant, data.merchant || 'Amazon');
          fillIfEmpty(prodBadge, data.badge || '');
          fillIfEmpty(prodVerdict, data.verdict || '');
          fillIfEmpty(prodPros, Array.isArray(data.pros) ? data.pros.join('\n') : '');
          fillIfEmpty(prodCons, Array.isArray(data.cons) ? data.cons.join('\n') : '');
          fillIfEmpty(prodAffiliateUrl, data.affiliateUrl || urlToScrape);
          fillIfEmpty(prodBuyNowUrl, data.buyNowUrl || '');
          fillIfEmpty(prodBrand, data.brand || '');
          fillIfEmpty(prodFulfillment, data.fulfillmentProvider || '');
          fillIfEmpty(prodRating, data.rating ?? '');
          fillIfEmpty(prodReviews, data.reviewsCount ?? '');
          fillIfEmpty(prodShippingInfo, data.shippingInfo || '');
          if (data.shippingDays != null && data.shippingDays !== '' && prodShippingDays && !prodShippingDays.value) {
            prodShippingDays.value = String(data.shippingDays);
          }
          fillIfEmpty(prodSpecs, specsToText(data.specs));

          // Guardar extras del scrape (specs, marca, valoración, reseñas) para
          // que el enriquecimiento local use datos reales.
          scrapeExtras = {
            brand: data.brand || '',
            rating: data.rating ?? null,
            reviewsCount: data.reviewsCount ?? null,
            specs: data.specs && typeof data.specs === 'object' ? data.specs : null,
          };

          // Galería de imágenes: la principal encabeza, luego el resto de vistas.
          scrapedGallery = Array.isArray(data.gallery) && data.gallery.length
            ? data.gallery
            : (data.image ? [data.image] : []);
          renderGallery();

          updatePreview();

          if (result.scraped) {
            showAlert(
              'success',
              'Metadatos extraídos con éxito',
              'Título, imagen, comercio y precio detectados. La IA completa la ficha automáticamente...'
            );
            // Auto-enriquecer con IA: descripción, veredicto, pros/cons e imagen.
            if (typeof runAiEnrich === 'function') {
              window.setTimeout(() => {
                runAiEnrich({ auto: true }).catch(() => {});
              }, 400);
            }
          } else {
            showAlert(
              'warning',
              'Extracción bloqueada por el comercio (403/Anti-bot)',
              result.message || 'La tienda protegió el acceso automático. Por favor, rellena los campos restantes manualmente.'
            );
          }
        } catch (err) {
          console.error(err);
          showAlert(
            'warning',
            'Fallo de conexión',
            'No se pudo comunicar con el endpoint. Puedes rellenar los datos de forma manual.'
          );
        } finally {
          btnScrape.disabled = false;
          if (btnSpinner) btnSpinner.hidden = true;
          if (btnText) btnText.textContent = 'Analizar Enlace';
        }
      });

      // Permitir pulsar Enter en el input de URL para disparar el análisis
      inputScrapeUrl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          btnScrape.click();
        }
      });
    }

    // =========================================================================
    // 2. GUARDAR PRODUCTO (POST al Endpoint)
    //    - Si el formulario tiene un id (edición) se ACTUALIZA el producto y el
    //      formulario se conserva relleno para seguir ajustando.
    //    - Si no tiene id (alta nueva) se crea y el formulario se limpia.
    //    - Los campos opcionales vacíos se envían como `null` en modo edición
    //      para que el backend los limpie (no conserve el valor anterior).
    // =========================================================================
    const btnSaveProductLabel = document.getElementById('btnSaveProductLabel');
    let saveBtnFlashTimer = null;
    function flashSaveButton(text) {
      if (!btnSaveProductLabel) return;
      btnSaveProductLabel.textContent = text;
      if (saveBtnFlashTimer) clearTimeout(saveBtnFlashTimer);
      saveBtnFlashTimer = setTimeout(() => {
        btnSaveProductLabel.textContent = 'Guardar cambios';
      }, 2600);
    }
    function resetProductForm() {
      prodId.value = '';
      prodTitle.value = '';
      prodPrice.value = '';
      prodOriginalPrice.value = '';
      prodCategory.value = '';
      prodMerchant.value = '';
      prodAffiliateUrl.value = '';
      prodBuyNowUrl.value = '';
      prodImage.value = '';
      prodBadge.value = '';
      prodDescription.value = '';
      prodVerdict.value = '';
      prodTechSheet.value = '';
      prodPros.value = '';
      prodCons.value = '';
      if (prodBrand) prodBrand.value = '';
      if (prodFulfillment) prodFulfillment.value = '';
      if (prodRating) prodRating.value = '';
      if (prodReviews) prodReviews.value = '';
      if (prodSpecs) prodSpecs.value = '';
      if (prodShippingInfo) prodShippingInfo.value = '';
      if (prodShippingDays) prodShippingDays.value = '';
      if (prodFreeShipping) prodFreeShipping.checked = false;
      if (inputScrapeUrl) inputScrapeUrl.value = '';
      if (galleryUrlInput) galleryUrlInput.value = '';
      if (galleryFileInput) galleryFileInput.value = '';
      scrapedGallery = [];
      scrapeExtras = { brand: '', rating: null, reviewsCount: null, specs: null };
      previewIndex = 0;
      renderGallery();
      updatePreview();
    }

    // Botón «Nuevo Producto»: deja el formulario vacío (modo alta individual)
    // para que «Analizar Enlace» rellene todos los campos desde cero.
    const btnNewProduct = document.getElementById('btnNewProduct');
    if (btnNewProduct) {
      btnNewProduct.addEventListener('click', () => {
        resetProductForm();
        if (btnSaveProductLabel) btnSaveProductLabel.textContent = 'Guardar cambios';
        if (inputScrapeUrl) inputScrapeUrl.focus();
        showAlert(
          'success',
          'Alta de producto nueva',
          'Formulario vacío. Pega la URL del producto y pulsa «Analizar Enlace» para rellenar todos los campos.'
        );
      });
    }
    if (productForm) {
      productForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const editingId = prodId.value.trim();
        const isEditing = Boolean(editingId);
        // En edición, vaciar un campo opcional envía `null` (limpia el valor);
        // en alta se envía `undefined` para que el backend aplique sus defaults.
        const optional = (value) => (isEditing ? (value || null) : (value || undefined));

        // La imagen principal debe viajar siempre dentro de la galería.
        // Si no hay imagen principal, se toma la primera imagen de la galería
        // (nunca un vídeo); así se puede crear un producto sólo con vídeo.
        let mainImage = prodImage.value.trim();
        if (!mainImage) {
          const firstGalleryImage = scrapedGallery.find((u) => !isVideoUrl(u));
          if (firstGalleryImage) {
            mainImage = firstGalleryImage;
            setProductField(prodImage, firstGalleryImage);
          }
        }
        const galleryToSend = scrapedGallery.slice();
        if (mainImage && !galleryToSend.includes(mainImage)) galleryToSend.unshift(mainImage);

        const productPayload = {
          id: editingId || undefined,
          title: prodTitle.value.trim(),
          price: parseFloat(prodPrice.value) || 0,
          originalPrice: prodOriginalPrice.value ? parseFloat(prodOriginalPrice.value) : optional(''),
          category: prodCategory.value.trim() || 'Tecnología',
          subcategory: document.getElementById('prodSubcategory')?.value.trim() || '',
          merchant: prodMerchant.value || 'Amazon',
          affiliateUrl: prodAffiliateUrl.value.trim(),
          buyNowUrl: optional(prodBuyNowUrl.value.trim()),
          image: mainImage,
          gallery: galleryToSend.length ? galleryToSend : undefined,
          badge: prodBadge.value.trim() || optional(''),
          description: prodDescription.value.trim(),
          verdict: optional(prodVerdict.value.trim()),
          techSheet: optional(prodTechSheet.value.trim()),
          specs: optional(textToSpecs(prodSpecs?.value)),
          brand: optional(prodBrand?.value.trim()),
          fulfillmentProvider: optional(prodFulfillment?.value.trim()),
          rating: prodRating?.value !== '' && prodRating?.value != null
            ? Math.min(5, Math.max(0, Number(prodRating.value)))
            : optional(''),
          reviewsCount: prodReviews?.value !== '' && prodReviews?.value != null
            ? Math.max(0, Math.round(Number(prodReviews.value)))
            : optional(''),
          shippingInfo: optional(prodShippingInfo?.value.trim()),
          shippingDays: prodShippingDays?.value !== '' && prodShippingDays?.value != null
            ? Math.max(0, Math.round(Number(prodShippingDays.value)))
            : optional(''),
          freeShipping: prodFreeShipping ? prodFreeShipping.checked : optional(''),
          pros: prodPros.value
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
          cons: prodCons.value
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
        };

        if (btnSaveProduct) {
          btnSaveProduct.disabled = true;
          btnSaveProduct.classList.add('loading');
        }
        if (btnSaveProductLabel) btnSaveProductLabel.textContent = 'Guardando...';

        showAlert(
          'loading',
          isEditing ? 'Guardando cambios...' : 'Guardando producto...',
          'Escribiendo en src/data/products.json...'
        );

        try {
          const response = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save', product: productPayload }),
          });

          const result = await response.json();

          if (result.success) {
            // Recargar lista de productos inmediatamente
            await reloadProductsTable();

            if (isEditing) {
              // Modo edición: se conserva el id y el formulario relleno para
              // seguir ajustando; sólo se avisa del guardado en el botón.
              if (result.product && result.product.id) prodId.value = result.product.id;
              flashSaveButton('Cambios guardados ✓');
              showAlert(
                'success',
                'Cambios guardados',
                result.message || 'Los cambios del producto se han guardado en el catálogo.'
              );
            } else {
              document.getElementById('catalogProducts')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
              // Dejar el formulario preparado para un producto nuevo.
              resetProductForm();
              flashSaveButton('Guardado ✓');
              showAlert('success', '¡Producto guardado!', result.message || 'El producto ha sido añadido al catálogo.');
            }
          } else {
            if (btnSaveProductLabel) btnSaveProductLabel.textContent = 'Guardar cambios';
            showAlert('error', 'Error al guardar', result.message || 'No se pudo guardar el producto.');
          }
        } catch (err) {
          console.error(err);
          if (btnSaveProductLabel) btnSaveProductLabel.textContent = 'Guardar cambios';
          showAlert('error', 'Error de red', 'No se pudo enviar la solicitud al servidor.');
        } finally {
          if (btnSaveProduct) {
            btnSaveProduct.disabled = false;
            btnSaveProduct.classList.remove('loading');
          }
        }
      });
    }

    // =========================================================================
    // 2b. ENRIQUECIMIENTO CON IA (texto + imagen) — POST /api/admin/add-product
    //     1) Ficha técnica, pros/contras y veredicto neutral (OpenAI / Claude)
    //     2) Imagen de producto generada con el prompt comercial (OpenAI / Flux)
    //     Rellena el formulario en modo vista previa: quien decide guarda.
    // =========================================================================
    // Enriquecer con IA (usado por el botón y de forma automática tras analizar un enlace).
    const runAiEnrich = async ({ auto = false } = {}) => {
      const title = (prodTitle.value || '').trim();
      if (!title) {
        if (!auto) {
          showAlert('error', 'Falta el título', 'Escribe el título del producto antes de pedir el enriquecimiento con IA.');
          prodTitle.focus();
        }
        return;
      }

      btnAiEnrich.disabled = true;
      btnAiEnrich.classList.add('loading');
      showAlert(
        'loading',
        'Trabajando con IA...',
        auto
          ? 'Sintetizando título, precios y ficha técnica, pros/contras y veredicto...'
          : 'Paso 1: título, ficha y precios con descuento realista · Paso 2: imagen de producto mejorada.'
      );

      try {
        const response = await fetch('/api/admin/add-product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: (prodId.value || '').trim() || undefined,
            title,
            description: (prodDescription.value || '').trim(),
            category: (prodCategory.value || '').trim() || undefined,
            price: parseFloat(prodPrice.value) || undefined,
            originalPrice: prodOriginalPrice.value ? parseFloat(prodOriginalPrice.value) : undefined,
            image: (prodImage.value || '').trim() || undefined,
            affiliateUrl: (prodAffiliateUrl.value || '').trim() || undefined,
            merchant: prodMerchant.value || undefined,
            url: inputScrapeUrl && inputScrapeUrl.value ? inputScrapeUrl.value.trim() || undefined : undefined,
            brand: scrapeExtras.brand || undefined,
            rating: scrapeExtras.rating ?? undefined,
            reviewsCount: scrapeExtras.reviewsCount ?? undefined,
            specs: scrapeExtras.specs || undefined,
            pros: prodPros.value.split('\n').map((s) => s.trim()).filter(Boolean),
            cons: prodCons.value.split('\n').map((s) => s.trim()).filter(Boolean),
            techSheet: (prodTechSheet.value || '').trim() || undefined,
            // En auto solo texto (rápido): la imagen real del scraping se conserva.
            options: { text: true, image: !auto, save: false },
          }),
        });

        let result;
        try {
          result = await response.json();
        } catch {
          // Respuesta no-JSON (p. ej. 504 de proxy en HTML por timeout).
          if (response.ok) {
            showAlert('success', 'Contenido generado con IA', 'Revisa los campos y pulsa «Guardar cambios» para publicarlo.');
          } else {
            showAlert(
              'error',
              `El servidor devolvió ${response.status}`,
              response.status === 504 || response.status === 524
                ? 'La llamada a la IA tardó demasiado y un proxy la cortó. Pulsa «Generar con IA» para reintentar solo el texto.'
                : 'Respuesta inesperada del servidor. Revisa los logs o reintenta.'
            );
          }
          return;
        }

        if (result.success) {
          const enriched = result.product || {};
          const flags = result.enrichment || { text: 'skipped', image: 'skipped', warnings: [] };

          if (flags.text === 'ok' || flags.text === 'local') {
            // Título sintetizado: corto, solo la definición del producto.
            if (enriched.title) prodTitle.value = enriched.title;
            if (enriched.description) prodDescription.value = enriched.description;
            if (enriched.verdict) prodVerdict.value = enriched.verdict;
            if (enriched.techSheet) prodTechSheet.value = enriched.techSheet;
            if (Array.isArray(enriched.pros) && enriched.pros.length) prodPros.value = enriched.pros.join('\n');
            if (Array.isArray(enriched.cons) && enriched.cons.length) prodCons.value = enriched.cons.join('\n');
            if (enriched.category && !(prodCategory.value || '').trim()) prodCategory.value = enriched.category;
            // Precios: oferta + original tachado con descuento realista (15–35 %).
            if (Number(enriched.price) > 0) prodPrice.value = String(enriched.price);
            if (Number(enriched.originalPrice) > Number(enriched.price)) {
              prodOriginalPrice.value = String(enriched.originalPrice);
            }
          }
          if (flags.image === 'ok' && enriched.image) {
            // La imagen generada con IA lleva fondo de estudio opaco (#F8F9FA),
            // igual que la ficha y las cards: siempre encaja en el carrusel.
            if (!scrapedGallery.includes(enriched.image)) scrapedGallery.unshift(enriched.image);
            const currentMain = (prodImage.value || '').trim();
            const mainIsLocal = /^\/images\//.test(currentMain);
            // Se hace principal si no había imagen o si la actual es externa
            // (fondo desconocido); la original se conserva en la galería.
            if (!currentMain || !mainIsLocal) setProductField(prodImage, enriched.image);
            renderGallery();
          }

          updatePreview();

          const via = flags.text === 'ok' ? 'IA' : 'local (sin IA)';
          const summary = auto
            ? `Título + ficha + precios generados ${via} · Imagen: conservada (${flags.image === 'ok' ? 'IA añadida a la galería' : 'scraping'})`
            : `Título + ficha + precios: ${via} · Imagen: ${flags.image === 'ok' ? 'generada con fondo de estudio (IA)' : flags.image}`;
          const warnings =
            Array.isArray(flags.warnings) && flags.warnings.length
              ? ` Avisos: ${flags.warnings.join(' | ')}`
              : '';
          showAlert(
            'success',
            'Ficha de producto generada',
            `${summary}. Revisa los campos y pulsa «Guardar cambios» para publicarlo.${warnings}`
          );
        } else {
          showAlert('error', 'No se pudo generar la ficha', result.message || 'Revisa la configuración del servidor.');
        }
      } catch (err) {
        console.error(err);
        showAlert(
          'error',
          'No se pudo contactar con el servidor',
          'Fallo al llamar a /api/admin/add-product. Revisa tu conexión o reintenta.'
        );
      } finally {
        btnAiEnrich.disabled = false;
        btnAiEnrich.classList.remove('loading');
      }
    };

    if (btnAiEnrich) {
      btnAiEnrich.addEventListener('click', () => runAiEnrich());
    }

    // =========================================================================
    // 2c. SINTETIZAR TÍTULO AL PEGAR
    //     Al pegar un título largo (Amazon, AliExpress...) se reduce a la
    //     definición del producto para que quepa en las product-cards.
    //     Con IA si hay claves; si no, con la heurística local del servidor.
    // =========================================================================
    let titleSynthTimer = null;
    let titleSynthSeq = 0;
    async function synthesizeTitleField() {
      const snapshot = (prodTitle.value || '').trim();
      if (!snapshot || snapshot.length <= 40) return;
      const seq = ++titleSynthSeq;
      try {
        const response = await fetch('/api/admin/synthesize-title', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: snapshot,
            description: (prodDescription.value || '').trim() || undefined,
            brand: scrapeExtras.brand || undefined,
            category: (prodCategory.value || '').trim() || undefined,
          }),
        });
        const result = await response.json();
        if (seq !== titleSynthSeq) return;
        const shortTitle = String(result?.title || '').trim();
        // Solo aplica si el usuario no siguió escribiendo mientras tanto.
        if (shortTitle && shortTitle !== snapshot && (prodTitle.value || '').trim() === snapshot) {
          setProductField(prodTitle, shortTitle);
          updatePreview();
        }
      } catch (err) {
        console.warn('No se pudo sintetizar el título:', err);
      }
    }
    if (prodTitle) {
      prodTitle.addEventListener('paste', () => {
        window.clearTimeout(titleSynthTimer);
        titleSynthTimer = window.setTimeout(synthesizeTitleField, 500);
      });
    }

    // =========================================================================
    // 4. ELIMINAR Y EDITAR PRODUCTOS DE LA TABLA
    // =========================================================================
     async function reloadProductsTable() {
      try {
        const res = await fetch('/api/products/add');
        const data = await res.json();
        if (data.success && Array.isArray(data.products)) {
          currentProducts = data.products;
          aliInvalidateEstado();
          prodBuildRanges();
          prodFilterApply();
          // El filtro «Estado» de la tabla de afiliados se calcula con esta lista.
          try {
            if (aliFilterPanel) aliFilterPanel.refresh();
          } catch { /* el panel de filtros de afiliados aún no está montado */ }
          // Y su TABLA se repinta: al dar de alta/borrar productos cambia el
          // índice de estados (chips «✓ en catálogo», botón «Añadido» y contador).
          try {
            renderAliCatalog();
          } catch { /* la tabla de afiliados aún no está montada */ }
        }
      } catch (err) {
        console.error('Error al recargar productos:', err);
      }
    }

function renderTableRows(products) {
      if (!productsTableBody) return;

      // Guardar productos filtrados para paginación
      filteredProducts = products;

      // Resetear a la primera página al cambiar filtros
      currentPage = 1;

      // Actualizar controles de paginación
      updatePaginationControls();

      const totalProducts = products.length;
      const totalPages = Math.ceil(totalProducts / PRODUCTS_PER_PAGE);
      const startIndex = (currentPage - 1) * PRODUCTS_PER_PAGE;
      const endIndex = Math.min(startIndex + PRODUCTS_PER_PAGE, totalProducts);
      const pageProducts = products.slice(startIndex, endIndex);

      // Actualizar info de total
      const paginationTotal = document.getElementById('paginationTotal');
      if (paginationTotal) {
        paginationTotal.textContent = `${totalProducts} producto${totalProducts !== 1 ? 's' : ''} (página ${currentPage} de ${totalPages || 1})`;
      }

      if (pageProducts.length === 0) {
        productsTableBody.innerHTML = `
          <tr class="empty-row">
            <td colspan="8">No hay productos registrados en el catálogo aún.</td>
          </tr>
        `;
        return;
      }

      // Categorías para los selects en cascada de la fila expandida.
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const rootCats = allCats.filter((c) => !c.parentId);
      const subcatOptionsFor = (categoryId, categoryName, selectedSubId) => {
        const parent = allCats.find((c) => c.id === categoryId)
          || rootCats.find((c) => c.name === categoryName);
        const subs = parent ? allCats.filter((c) => c.parentId === parent.id) : [];
        return '<option value="">— Sin subcategoría —</option>' + subs.map((c) =>
          `<option value="${escapeHtml(c.id)}"${c.id === selectedSubId ? ' selected' : ''}>${escapeHtml(c.name)}</option>`
        ).join('');
      };
      const catSelectOptionsFor = (categoryId, categoryName) => 
        '<option value="">— Sin categoría —</option>' + rootCats.map((c) =>
        `<option value="${escapeHtml(c.id)}"${(categoryId ? c.id === categoryId : c.name === categoryName) ? ' selected' : ''}>${escapeHtml(c.name)}</option>`
      ).join('');

      productsTableBody.innerHTML = pageProducts
        .map(
          (p, index) => `
          <tr data-product-id="${p.id}" class="product-row" data-prod-row="${index}">
            <td class="col-check"><input type="checkbox" data-prod-check data-id="${p.id}" aria-label="Seleccionar producto" /></td>
            <td class="col-thumb">
              <img src="${p.image}" alt="${p.title}" class="thumb-img" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=800&auto=format&fit=crop'" />
            </td>
            <td class="col-details">
              <a href="/producto/${p.slug || p.id}" class="row-title" target="_blank" rel="noopener" title="Ver ficha pública del producto">${p.title}</a>
              <div class="row-meta">
                <span class="pill-category">${p.category || '—'}</span>
                ${p.subcategory_id ? `<span class="pill-subcategory">${escapeHtml((allCats.find((c) => c.id === p.subcategory_id) || {}).name || p.subcategory_id)}</span>` : ''}
                ${p.badge ? `<span class="pill-badge">${p.badge}</span>` : ''}
                ${p.is_duplicate ? `<span class="dup-pill" title="Duplicado ${p.duplicate_reason ? `(${p.duplicate_reason})` : ''}${p.duplicate_of ? ` de ${p.duplicate_of}` : ''}">${p.possible_duplicate ? '♻️ ¿Dup?' : '♻️ Dup'}</span>` : ''}
              </div>
            </td>
            <td class="col-merchant"><span class="merchant-badge" title="${p.merchant ? `Comerciante: ${escapeHtml(p.merchant)}` : 'Red de afiliados'}">${escapeHtml(p.network_label || p.merchant || '—')}</span></td>
            <td class="col-price">
              <span class="price-val">${Number(p.price).toFixed(2)} €</span>
              ${p.originalPrice ? `<span class="price-old">${Number(p.originalPrice).toFixed(2)} €</span>` : ''}
            </td>
            <td class="col-score">
              ${(() => {
                const score = Number(p.conversion_score) || 0;
                const level = score > 75 ? 'high' : score >= 40 ? 'mid' : 'low';
                const icon = level === 'high' ? '🔥' : level === 'mid' ? '⚡' : '❄️';
                const label = level === 'high' ? 'Alta rentabilidad' : level === 'mid' ? 'Rentabilidad media' : 'Bajo';
                return `<span class="score-badge score-${level}" title="${label} — score ${score}/100">
                  <span class="score-badge-value">${icon} ${score}</span>
                  <span class="score-bar"><span class="score-bar-fill" style="width:${Math.max(0, Math.min(100, score))}%"></span></span>
                </span>`;
              })()}
            </td>
            <td class="col-link">
              <a href="${p.affiliateUrl}" target="_blank" rel="nofollow noopener noreferrer" class="test-link">Probar Enlace</a>
            </td>
            <td class="col-actions text-right">
              <button type="button" class="btn-icon-action btn-preview-card" data-id="${p.id}" data-slug="${p.slug || ''}" title="👁️ Ver ficha del producto (abre en pestaña nueva)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </button>
              <button type="button" class="btn-icon-action btn-link-alternatives" data-id="${p.id}" title="🔗 Vincular Alternativas">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              </button>
              <button type="button" class="btn-icon-action btn-edit-row" data-id="${p.id}" title="Cargar en formulario">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              </button>
              <button type="button" class="btn-icon-action btn-delete-row" data-id="${p.id}" title="Eliminar producto">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
              <button type="button" class="btn-icon-action btn-prod-detail" data-id="${p.id}" title="Ver todos los datos" data-idx="${index}" aria-expanded="false" aria-label="Ver todos los datos">
                <svg class="prod-detail-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </td>
          </tr>
          <tr class="product-detail-row" data-prod-detail="${index}" hidden>
            <td colspan="10"><dl class="aff-detail-grid">
              <div class="aff-detail-item"><dt>Título</dt><dd>${escapeHtml ? escapeHtml(p.title) : p.title}</dd></div>
              <div class="aff-detail-item"><dt>Categoría</dt><dd>${p.category || '—'}</dd></div>
              <div class="aff-detail-item aff-detail-curate"><dt>Categorización (edición rápida)</dt><dd class="aff-curate-controls">
                <select class="row-cat-select" data-id="${p.id}" aria-label="Categoría del producto">${catSelectOptionsFor(p.category_id, p.category)}</select>
                <select class="row-subcat-select" data-id="${p.id}" aria-label="Subcategoría del producto">${subcatOptionsFor(p.category_id, p.category, p.subcategory_id)}</select>
              </dd></div>
              <div class="aff-detail-item"><dt>Red de afiliados</dt><dd>${escapeHtml(p.network_label || '—')}</dd></div>
              <div class="aff-detail-item"><dt>Comerciante</dt><dd>${escapeHtml(p.merchant || '—')}</dd></div>
              ${p.brand ? `<div class="aff-detail-item"><dt>Marca</dt><dd>${escapeHtml ? escapeHtml(p.brand) : p.brand}</dd></div>` : ''}
              ${p.fulfillmentProvider && p.fulfillmentProvider !== p.merchant ? `<div class="aff-detail-item"><dt>Distribuidor</dt><dd>${escapeHtml ? escapeHtml(p.fulfillmentProvider) : p.fulfillmentProvider}</dd></div>` : ''}
              <div class="aff-detail-item"><dt>Precio</dt><dd>${Number(p.price).toFixed(2)} €</dd></div>
              ${p.originalPrice ? `<div class="aff-detail-item"><dt>Precio original</dt><dd>${Number(p.originalPrice).toFixed(2)} €</dd></div>` : ''}
              <div class="aff-detail-item"><dt>Score de conversión</dt><dd>${Number(p.conversion_score) || 0}/100 ${p.commissionEstimate != null ? `· comisión est. ${Number(p.commissionEstimate).toFixed(2)} €` : ''}${p.sales30d != null ? ` · ${Number(p.sales30d)} ventas/30d` : ''}</dd></div>
              <div class="aff-detail-item"><dt>Estados editoriales</dt><dd>
                <span class="state-pill state-${escapeHtml ? escapeHtml(p.ia_status || 'pending') : (p.ia_status || 'pending')}">IA: ${p.ia_status || 'pending'}</span>
                <span class="state-pill state-${escapeHtml ? escapeHtml(p.link_status || 'pending') : (p.link_status || 'pending')}">Enlace: ${p.link_status || 'pending'}</span>
                ${p.is_duplicate ? `<span class="state-pill state-dup">♻️ ${p.possible_duplicate ? 'posible duplicado' : 'duplicado'}${p.duplicate_of ? ` de ${p.duplicate_of}` : ''}</span>` : ''}
              </dd></div>
              ${Array.isArray(p.normalized_tags) && p.normalized_tags.length ? `<div class="aff-detail-item"><dt>Tags normalizados (${p.normalized_tags.length})</dt><dd class="tag-chip-list">${p.normalized_tags.map((t) => `<span class="tag-chip">${escapeHtml ? escapeHtml(t) : t}</span>`).join('')}</dd></div>` : ''}
              <div class="aff-detail-item"><dt>Alternativas vinculadas</dt><dd>
                ${(() => {
                  const a = p.alternatives || {};
                  const links = Array.isArray(p.alternative_product_ids) ? p.alternative_product_ids.length : 0;
                  const premium = a.premiumOptionId ? 1 : 0;
                  const cheaper = (Array.isArray(a.cheaperOptionIds) ? a.cheaperOptionIds.length : 0) || (a.cheaperOptionId ? 1 : 0);
                  const similar = (Array.isArray(a.similarOptionIds) ? a.similarOptionIds.length : 0) || (a.similarOptionId ? 1 : 0);
                  if (!links && !premium && !cheaper && !similar) return 'Ninguna';
                  return `${links} vínculo(s) · ⭐ ${premium} principal · 💰 ${cheaper} económica(s) · 🎯 ${similar} competidor(es)`;
                })()}
                <button type="button" class="btn-secondary btn-sm btn-link-alternatives" data-id="${p.id}">🔗 Vincular Alternativas</button>
              </dd></div>
              ${p.rating != null ? `<div class="aff-detail-item"><dt>Valoración</dt><dd>${Number(p.rating).toFixed(1)} ★ ${p.reviewsCount != null ? `(${p.reviewsCount} opiniones)` : ''}</dd></div>` : ''}
              ${p.badge ? `<div class="aff-detail-item"><dt>Badge</dt><dd>${p.badge}</dd></div>` : ''}
              ${p.description ? `<div class="aff-detail-item"><dt>Descripción</dt><dd>${escapeHtml ? escapeHtml(p.description) : p.description}</dd></div>` : ''}
              ${p.verdict ? `<div class="aff-detail-item"><dt>Veredicto</dt><dd>${escapeHtml ? escapeHtml(p.verdict) : p.verdict}</dd></div>` : ''}
              ${p.techSheet ? `<div class="aff-detail-item"><dt>Ficha técnica</dt><dd>${escapeHtml ? escapeHtml(p.techSheet) : p.techSheet}</dd></div>` : ''}
              ${p.shippingInfo ? `<div class="aff-detail-item"><dt>Envío</dt><dd>${p.shippingInfo}${p.shippingDays != null ? ` (${p.shippingDays} d)` : ''}${p.freeShipping ? ' · gratis' : ''}</dd></div>` : ''}
              ${p.buyNowUrl ? `<div class="aff-detail-item"><dt>Compra directa</dt><dd><a href="${p.buyNowUrl}" target="_blank" rel="nofollow noopener" class="test-link">Abrir Buy Now</a></dd></div>` : ''}
              ${p.specs && Object.keys(p.specs).length ? `<div class="aff-detail-item"><dt>Especificaciones</dt><dd>${Object.entries(p.specs).map(([k, v]) => `${escapeHtml ? escapeHtml(k) : k}: ${escapeHtml ? escapeHtml(String(v)) : v}`).join(' · ')}</dd></div>` : ''}
              ${Array.isArray(p.pros) && p.pros.length ? `<div class="aff-detail-item"><dt>Pros</dt><dd>${p.pros.join(' · ')}</dd></div>` : ''}
              ${Array.isArray(p.cons) && p.cons.length ? `<div class="aff-detail-item"><dt>Contras</dt><dd>${p.cons.join(' · ')}</dd></div>` : ''}
              ${Array.isArray(p.gallery) && p.gallery.length ? `<div class="aff-detail-item is-images"><dt>Galería (${p.gallery.length})</dt><dd class="aff-detail-thumbs">${p.gallery.map((u)=>`<a href="${u}" target="_blank" rel="noopener noreferrer"><img src="${u}" alt="" loading="lazy" /></a>`).join('')}</dd></div>` : ''}
            </dl></td>
          </tr>
        `
        )
        .join('');

      attachRowActions();
    }

     function attachRowActions() {
      // Mostrar/ocultar la fila de detalle de un producto
      document.querySelectorAll('.btn-prod-detail').forEach((btn) => {
        const idx = btn.getAttribute('data-idx');
        const detail = document.querySelector(`[data-prod-detail="${idx}"]`);
        if (detail && !detail.hidden) {
          btn.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }

        btn.onclick = (e) => {
          e.stopPropagation();
          const idx = btn.getAttribute('data-idx');
          const detail = document.querySelector(`[data-prod-detail="${idx}"]`);
          if (detail) {
            const open = detail.hidden;
            detail.hidden = !open;
            btn.classList.toggle('is-open', open);
            btn.setAttribute('aria-expanded', String(open));
          }
        };
      });

      // Checkboxes
      document.querySelectorAll('[data-prod-check]').forEach((box) => {
        const id = box.getAttribute('data-id');
        box.checked = selectedProductIds.has(id);
        box.onchange = () => {
          if (box.checked) selectedProductIds.add(id); else selectedProductIds.delete(id);
          updateProdSelCount();
        };
      });

      // 1. Borrar producto
      document.querySelectorAll('.btn-delete-row').forEach((btn) => {
        btn.onclick = async () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;

          const confirmed = confirm(`¿Estás seguro de que deseas eliminar este producto del catálogo?`);
          if (!confirmed) return;

          showAlert('loading', 'Eliminando producto...', `Eliminando ID: ${id}`);

          try {
            const res = await fetch('/api/products/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ product_ids: [id] }),
            });
            const data = await res.json();

            if (data.success) {
              showAlert('success', 'Producto Eliminado', 'El producto ha sido retirado de products.json.');
              await reloadProductsTable();
            } else {
              showAlert('error', 'Error al eliminar', data.message || 'No se pudo eliminar el producto.');
            }
          } catch (err) {
            showAlert('error', 'Error de red', 'Fallo al comunicar con el servidor.');
          }
        };
      });

      // 2. Editar producto (cargar en formulario)
      document.querySelectorAll('.btn-edit-row').forEach((btn) => {
        btn.onclick = async () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;

          // Despliega el panel «Extracción & Alta de Producto» y sube a su
          // inicio para poder editar sin tener que abrirlo a mano.
          setFormPanelExpanded(true);
          scrollToFormPanel();

          try {
            const res = await fetch('/api/products/add');
            const data = await res.json();
            const product = (data.products || []).find((p) => p.id === id);

            if (product) {
              prodId.value = product.id || '';
              prodTitle.value = product.title || '';
              prodPrice.value = product.price !== undefined ? product.price : '';
              prodOriginalPrice.value = product.originalPrice !== undefined ? product.originalPrice : '';
              prodCategory.value = product.category || '';
              // Sincroniza el selector de subcategoría con la del producto.
              syncProductFormSubcategories();
              const prodSubcategory = document.getElementById('prodSubcategory');
              if (prodSubcategory) {
                const allCats = Array.isArray(categoriesCache) ? categoriesCache : [];
                const sub = product.subcategory_id
                  ? allCats.find((c) => c.id === product.subcategory_id)
                  : undefined;
                prodSubcategory.value = sub?.name || '';
              }
              prodMerchant.value = product.merchant || 'Amazon';
              prodAffiliateUrl.value = product.affiliateUrl || '';
              prodBuyNowUrl.value = product.buyNowUrl || '';
              prodImage.value = product.image || '';
              const badgeValue = product.badge || '';
              if (badgeValue && prodBadge && !Array.from(prodBadge.options).some((o) => o.value === badgeValue)) {
                const customOpt = document.createElement('option');
                customOpt.value = badgeValue;
                customOpt.textContent = badgeValue;
                prodBadge.appendChild(customOpt);
              }
              prodBadge.value = badgeValue;
              prodDescription.value = product.description || '';
              prodVerdict.value = product.verdict || '';
              prodTechSheet.value = product.techSheet || '';
              prodPros.value = Array.isArray(product.pros) ? product.pros.join('\n') : '';
              prodCons.value = Array.isArray(product.cons) ? product.cons.join('\n') : '';
              if (prodShippingInfo) prodShippingInfo.value = product.shippingInfo || '';
              if (prodShippingDays) prodShippingDays.value = product.shippingDays != null ? String(product.shippingDays) : '';
              if (prodFreeShipping) prodFreeShipping.checked = product.freeShipping === true;
              if (prodBrand) prodBrand.value = product.brand || '';
              if (prodFulfillment) prodFulfillment.value = product.fulfillmentProvider || '';
              if (prodRating) prodRating.value = product.rating != null ? String(product.rating) : '';
              if (prodReviews) prodReviews.value = product.reviewsCount != null ? String(product.reviewsCount) : '';
              if (prodSpecs) prodSpecs.value = specsToText(product.specs);
              scrapeExtras = {
                brand: product.brand || '',
                rating: product.rating ?? null,
                reviewsCount: product.reviewsCount ?? null,
                specs: product.specs && typeof product.specs === 'object' ? product.specs : null,
              };

              // Restaurar la galería guardada del producto (evita perderla al volver a guardar).
              scrapedGallery = Array.isArray(product.gallery) && product.gallery.length
                ? product.gallery.slice()
                : (product.image ? [product.image] : []);
              renderGallery();

              if (inputScrapeUrl) inputScrapeUrl.value = product.affiliateUrl || '';

              updatePreview();
              showAlert('success', 'Producto Cargado en Formulario', `Editando "${product.title}". Modifica los campos y pulsa "Guardar cambios".`);
              // Despliega el panel de edición y nos coloca en su inicio.
              setFormPanelExpanded(true);
              scrollToFormPanel();
            }
          } catch (err) {
            console.error(err);
          }
        };
      });
    }

    // Filtros de rango del «Catálogo de Productos Registrados» (mismo diseño
    // que la tabla de Afiliados): precio con par mínimo/máximo, descuento con
    // select de rangos y valoración con select de umbral.
    let prodSortDir = 'desc';
    const PROD_DISCOUNT_RANGES = [
      { value: '0-10', label: '0% – 10%', min: 0, max: 10 },
      { value: '10-20', label: '10% – 20%', min: 10, max: 20 },
      { value: '20-30', label: '20% – 30%', min: 20, max: 30 },
    ];
    const PROD_RATING_OPTIONS = [
      { value: '4', label: '≥ 4,0 ★' },
      { value: '4.5', label: '≥ 4,5 ★' },
      { value: '4.6', label: '≥ 4,6 ★' },
      { value: '4.8', label: '≥ 4,8 ★' },
    ];

    function prodDiscountPct(p) {
      const original = Number(p.originalPrice) || 0;
      const price = Number(p.price) || 0;
      return original > price && price > 0 ? Math.round(((original - price) / original) * 100) : 0;
    }

    /** Construye los controles de rango: precio min/máx, valoración y descuento. */
    function prodBuildRanges() {
      if (!prodRangeFields) return;
      // Conserva los valores ya escritos por el usuario al repintar la tabla.
      const keepPriceMin = document.getElementById('prodFPriceMin')?.value || '';
      const keepPriceMax = document.getElementById('prodFPriceMax')?.value || '';
      const keepDisc = document.getElementById('prodFDiscRange')?.value || '';
      const keepRating = document.getElementById('prodFRatingMin')?.value || '';
      // El botón "Limpiar filtros" vive dentro del contenedor: se guarda la
      // referencia antes de repintar (si no, el innerHTML lo destruiría).
      const resetBtn = document.getElementById('prodFReset');
      const prices = currentProducts.map((p) => Number(p.price)).filter((v) => Number.isFinite(v) && v > 0);
      const dataMin = prices.length ? Math.floor(Math.min(...prices)) : 0;
      const dataMax = prices.length ? Math.ceil(Math.max(...prices)) : 0;
      prodRangeFields.innerHTML = `
        <div class="filter-field prod-range-field" data-range-field="rating">
          <label for="prodFRatingMin">Valoración</label>
          <select id="prodFRatingMin">
            <option value="">Cualquiera</option>
            ${PROD_RATING_OPTIONS.map((r) => `<option value="${r.value}"${r.value === keepRating ? ' selected' : ''}>${escapeHtml(r.label)}</option>`).join('')}
          </select>
        </div>
        <div class="filter-field prod-range-field" data-range-field="price">
          <label for="prodFPriceMin">Precio (€)</label>
          <div class="ali-pair">
            <input type="number" id="prodFPriceMin" min="${dataMin}" step="0.01" placeholder="Mín." inputmode="decimal" value="${escapeHtml(keepPriceMin)}" />
            <span class="ali-pair-sep" aria-hidden="true">–</span>
            <input type="number" id="prodFPriceMax" max="${dataMax}" step="0.01" placeholder="Máx." inputmode="decimal" value="${escapeHtml(keepPriceMax)}" />
          </div>
        </div>
        <div class="filter-field prod-range-field" data-range-field="disc">
          <label for="prodFDiscRange">Descuento</label>
          <select id="prodFDiscRange">
            <option value="">Cualquiera</option>
            ${PROD_DISCOUNT_RANGES.map((r) => `<option value="${r.value}"${r.value === keepDisc ? ' selected' : ''}>${escapeHtml(r.label)}</option>`).join('')}
          </select>
        </div>`;
      // Orden pedido: Valoración, después Precio, después Descuento y, al final,
      // el botón "Limpiar filtros". El botón se mueve (no se recrea) para no
      // perder su listener.
      if (resetBtn) {
        const discField = prodRangeFields.querySelector('[data-range-field="disc"]');
        if (discField) prodRangeFields.insertBefore(resetBtn, discField.nextSibling);
      }
    }

    /** Lee los tres controles de rango tal y como están ahora en el DOM. */
    function prodReadRangeFilters() {
      const priceMin = parseFloat(document.getElementById('prodFPriceMin')?.value);
      const priceMax = parseFloat(document.getElementById('prodFPriceMax')?.value);
      const discValue = document.getElementById('prodFDiscRange')?.value || '';
      const rating = parseFloat(document.getElementById('prodFRatingMin')?.value);
      return {
        priceMin: Number.isFinite(priceMin) ? priceMin : null,
        priceMax: Number.isFinite(priceMax) ? priceMax : null,
        discRange: PROD_DISCOUNT_RANGES.find((r) => r.value === discValue) || null,
        ratingMin: Number.isFinite(rating) ? rating : null,
      };
    }

    function prodFilterApply() {
      const q = (inputFilterList?.value || '').trim().toLowerCase();
      const cat = prodFCat?.value || '';
      const subcatId = prodSubcatFilter?.value || '';
      const sortKey = prodFSort?.value || 'default';
      const dir = prodSortDir === 'asc' ? 1 : -1;
      const prodRange = prodReadRangeFilters();
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];

      const filtered = currentProducts.filter((product) => {
        if (cat) {
          // Filtro de categoría: casa el texto legado (product.category) o la
          // jerarquía real (category_id / subcategoría hija de la raíz elegida).
          const root = allCats.find((c) => !c.parentId && (c.name === cat || c.id === cat));
          const productCat = String(product.category || '');
          const productSub = product.subcategory_id ? allCats.find((c) => c.id === product.subcategory_id) : null;
          const matchCat = productCat === cat
            || Boolean(root && (product.category_id === root.id || (productSub && productSub.parentId === root.id)));
          if (!matchCat) return false;
        }
        if (subcatId) {
          // Filtro de subcategoría (id del categories.json, con fallback por nombre).
          const target = allCats.find((c) => c.id === subcatId);
          const pid = String(product.subcategory_id || '');
          let matchSub = pid === subcatId;
          if (!matchSub && target) {
            const psub = pid ? allCats.find((c) => c.id === pid) : null;
            const pname = String(psub ? psub.name : pid || '').toLowerCase();
            matchSub = Boolean(pname) && pname === target.name.toLowerCase();
          }
          if (!matchSub) return false;
        }
        // Preset editorial activo (1 clic): filtro complementario.
        if (typeof activeProdPreset !== 'undefined' && activeProdPreset && !prodMatchesPreset(product, activeProdPreset)) return false;
        const price = Number(product.price) || 0;
        if (prodRange.priceMin != null && price < prodRange.priceMin) return false;
        if (prodRange.priceMax != null && price > prodRange.priceMax) return false;
        if (prodRange.discRange) {
          const discount = prodDiscountPct(product);
          if (discount < prodRange.discRange.min || discount > prodRange.discRange.max) return false;
        }
        if (prodRange.ratingMin != null) {
          const rating = product.rating != null ? Number(product.rating) : null;
          if (rating == null || rating < prodRange.ratingMin) return false;
        }
        if (q) {
          // La búsqueda mira también la red de afiliados («amazon», «ebay»…).
          const haystack = `${product.title} ${product.merchant || ''} ${product.network_label || ''} ${product.category || ''} ${(product.brand || '')}`.toLowerCase();
          if (!haystack.includes(q)) return false;
        }
        return true;
      });

      if (sortKey !== 'default') {
        const sorters = {
          precio: (p) => Number(p.price) || 0,
          descuento: (p) => prodDiscountPct(p),
          valoracion: (p) => (p.rating != null ? Number(p.rating) : -1),
          categoria: (p) => String(p.category || ''),
          comercio: (p) => String(p.merchant || ''),
          score: (p) => Number(p.conversion_score) || 0,
        };
        filtered.sort((a, b) => {
          if (sortKey === 'nombre') return dir * String(a.title).localeCompare(String(b.title), 'es');
          const get = sorters[sortKey] || sorters.precio;
          const av = get(a);
          const bv = get(b);
          if (typeof av === 'string' || typeof bv === 'string') return dir * String(av).localeCompare(String(bv), 'es');
          return dir * (av - bv);
        });
      }
      renderTableRows(filtered);
    }

    // ─── Paginación del catálogo de productos ─────────────────────────────────
    function updatePaginationControls() {
      const paginationEl = document.getElementById('productsPagination');
      const paginationPages = document.getElementById('paginationPages');
      const paginationPrev = document.getElementById('paginationPrev');
      const paginationNext = document.getElementById('paginationNext');

      if (!paginationEl || !paginationPages || !paginationPrev || !paginationNext) return;

      const totalProducts = filteredProducts.length;
      const totalPages = Math.ceil(totalProducts / PRODUCTS_PER_PAGE);

      if (totalPages <= 1) {
        paginationEl.hidden = true;
        return;
      }

      paginationEl.hidden = false;

      // Botones prev/next
      paginationPrev.disabled = currentPage <= 1;
      paginationNext.disabled = currentPage >= totalPages;

      // Generar números de página
      let pagesHtml = '';
      const maxVisiblePages = 5;
      let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
      let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

      if (endPage - startPage + 1 < maxVisiblePages) {
        startPage = Math.max(1, endPage - maxVisiblePages + 1);
      }

      if (startPage > 1) {
        pagesHtml += `<button type="button" class="pagination-page" data-page="1" aria-label="Página 1">1</button>`;
        if (startPage > 2) {
          pagesHtml += `<span class="pagination-ellipsis" aria-hidden="true">…</span>`;
        }
      }

      for (let i = startPage; i <= endPage; i++) {
        pagesHtml += `<button type="button" class="pagination-page${i === currentPage ? ' active' : ''}" data-page="${i}" aria-label="Página ${i}"${i === currentPage ? ' aria-current="page"' : ''}>${i}</button>`;
      }

      if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
          pagesHtml += `<span class="pagination-ellipsis" aria-hidden="true">…</span>`;
        }
        pagesHtml += `<button type="button" class="pagination-page" data-page="${totalPages}" aria-label="Página ${totalPages}">${totalPages}</button>`;
      }

      paginationPages.innerHTML = pagesHtml;

      // Event listeners para botones de página
      paginationPages.querySelectorAll('.pagination-page').forEach((btn) => {
        btn.addEventListener('click', () => {
          const page = parseInt(btn.getAttribute('data-page'), 10);
          if (!Number.isNaN(page) && page !== currentPage) {
            goToPage(page);
          }
        });
      });
    }

    function goToPage(page) {
      const totalPages = Math.ceil(filteredProducts.length / PRODUCTS_PER_PAGE);
      if (page < 1 || page > totalPages) return;
      currentPage = page;
      renderTableRows(filteredProducts);
      // Scroll suave al inicio de la tabla
      const tableEl = document.getElementById('productsTable');
      if (tableEl) {
        tableEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Event listeners para botones prev/next
    const paginationPrev = document.getElementById('paginationPrev');
    const paginationNext = document.getElementById('paginationNext');
    paginationPrev?.addEventListener('click', () => goToPage(currentPage - 1));
    paginationNext?.addEventListener('click', () => goToPage(currentPage + 1));
    prodFCat?.addEventListener('change', () => {
      // El filtro de subcategoría se repliega sobre la categoría elegida.
      syncSubcatFilter();
      prodFilterApply();
    });
    prodSubcatFilter?.addEventListener('change', prodFilterApply);
    prodFSort?.addEventListener('change', prodFilterApply);
    prodFSortDir?.addEventListener('click', () => {
      prodSortDir = prodSortDir === 'desc' ? 'asc' : 'desc';
      prodFSortDir.textContent = prodSortDir === 'desc' ? '↓' : '↑';
      prodFilterApply();
    });
    prodFReset?.addEventListener('click', () => {
      if (inputFilterList) inputFilterList.value = '';
      if (prodFCat) prodFCat.value = '';
      syncSubcatFilter();
      if (prodFSort) prodFSort.value = 'default';
      prodSortDir = 'desc';
      if (prodFSortDir) prodFSortDir.textContent = '↓';
      const priceMin = document.getElementById('prodFPriceMin');
      const priceMax = document.getElementById('prodFPriceMax');
      const discRange = document.getElementById('prodFDiscRange');
      const ratingMin = document.getElementById('prodFRatingMin');
      if (priceMin) priceMin.value = '';
      if (priceMax) priceMax.value = '';
      if (discRange) discRange.value = '';
      if (ratingMin) ratingMin.value = '';
      prodFilterApply();
    });
    // Los controles de rango se reconstruyen en cada repintado (prodBuildRanges),
    // así que se escuchan de forma delegada sobre el contenedor.
    prodRangeFields?.addEventListener('input', prodFilterApply);
    prodRangeFields?.addEventListener('change', prodFilterApply);

     function updateProdSelCount() {
      if (productSelCount) productSelCount.textContent = `${selectedProductIds.size} seleccionado${selectedProductIds.size === 1 ? '' : 's'}`;
    }
    updateProdSelCount();

    btnProdSelAll?.addEventListener('click', () => {
      document.querySelectorAll('[data-prod-check]').forEach((box) => {
        box.checked = true;
        const id = box.getAttribute('data-id');
        if (id) selectedProductIds.add(id);
      });
      updateProdSelCount();
    });
    btnProdSelClear?.addEventListener('click', () => {
      selectedProductIds.clear();
      document.querySelectorAll('[data-prod-check]').forEach((box) => (box.checked = false));
      updateProdSelCount();
    });

    // Asignar una categoría a todos los productos seleccionados de la tabla.
    btnProdAssignCat?.addEventListener('click', async () => {
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const category = prodCatAssign && 'value' in prodCatAssign ? String(prodCatAssign.value || '').trim() : '';
      const subcategoryName = (() => {
        const el = document.getElementById('prodSubcatDest');
        return el && 'value' in el ? String(el.value || '').trim() : '';
      })();
      const ids = [...selectedProductIds];
      if (!ids.length) {
        showAlert('warning', 'Sin selección', 'Marca primero los productos en la tabla que quieres mover.');
        return;
      }
      // Subcategoría elegida sin categoría: se deduce su categoría raíz.
      const subOwner = subcategoryName
        ? allCats.find((c) => c.parentId && c.name === subcategoryName)
        : undefined;
      const categoryName = category || (subOwner ? (allCats.find((c) => c.id === subOwner?.parentId)?.name ?? '') : '');
      if (!categoryName) {
        showAlert('warning', 'Falta la categoría', 'Elige la categoría destino en la barra de selección.');
        return;
      }
      // Categorización bidireccional: se envían también los IDs jerárquicos
      // (category_id / subcategory_id) resueltos desde el caché de categorías.
      const catObj = allCats.find((c) => !c.parentId && c.name === categoryName);
      if (!catObj) {
        showAlert('error', 'Categoría no encontrada', `«${categoryName}» no está en el catálogo. Recarga el panel.`);
        return;
      }
      const subObj = subcategoryName
        ? allCats.find((c) => c.name === subcategoryName && c.parentId === catObj.id)
        : undefined;
      const categoryId = catObj?.id || '';
      const subcategoryId = subObj?.id || '';
      showAlert('loading', 'Asignando categoría...', `${ids.length} producto(s) → «${categoryName}»${subcategoryName ? ` › «${subcategoryName}»` : ''}.`);
      try {
        const res = await fetch('/api/products/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'set-category', ids, category: categoryName, category_id: categoryId, subcategory_id: subcategoryId }),
        });
        const data = await res.json();
        if (data.success) {
          showAlert('success', 'Categoría asignada', `${ids.length} producto(s) en «${categoryName}» (${data.updated} cambiados).`);
          await reloadProductsTable();
        } else {
          showAlert('error', 'Error al asignar', data.message || 'No se pudo actualizar la categoría.');
        }
      } catch (err) {
        console.error(err);
        showAlert('error', 'Error de red', 'No se pudo contactar con el servidor.');
      }
    });
    // Asignar una Etiqueta Destacada (Badge) a todos los productos seleccionados.
    const prodBadgeAssign = document.getElementById('prodBadgeAssign');
    if (prodBadgeAssign && prodBadge) {
      // Se clonan las opciones del desplegable del formulario (mismos valores).
      for (const option of Array.from(prodBadge.options)) {
        if (!option.value) continue;
        const clone = document.createElement('option');
        clone.value = option.value;
        clone.textContent = option.textContent;
        prodBadgeAssign.appendChild(clone);
      }
      const btnProdBulkBadge = document.getElementById('btnProdBulkBadge');
      btnProdBulkBadge?.addEventListener('click', async () => {
        const ids = Array.from(selectedProductIds);
        if (!ids.length) {
          showAlert('warning', 'Sin selección', 'Marca primero los productos en la tabla a los que quieres asignar la etiqueta.');
          return;
        }
        const badge = String(prodBadgeAssign.value || '').trim();
        if (!badge) {
          showAlert('warning', 'Falta la etiqueta', 'Elige la etiqueta destacada en el desplegable «Etiqueta destacada…».');
          prodBadgeAssign.focus();
          return;
        }
        showAlert('loading', 'Asignando etiqueta...', `Aplicando «${badge}» a ${ids.length} producto(s).`);
        try {
          const res = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'set-badge', ids, badge }),
          });
          const data = await res.json();
          if (data.success) {
            showAlert('success', 'Etiqueta asignada', `«${badge}» aplicada a ${data.updated} producto(s).`);
            await reloadProductsTable();
          } else {
            showAlert('error', 'Error al asignar', data.message || 'No se pudo actualizar la etiqueta.');
          }
        } catch (err) {
          console.error(err);
          showAlert('error', 'Error de red', 'No se pudo contactar con el servidor.');
        }
      });
    }

    prodCheckAll?.addEventListener('change', () => {
      const checked = prodCheckAll.checked;
      document.querySelectorAll('[data-prod-check]').forEach((box) => {
        box.checked = checked;
        const id = box.getAttribute('data-id');
        if (id) { if (checked) selectedProductIds.add(id); else selectedProductIds.delete(id); }
      });
      updateProdSelCount();
    });
    btnProdEnrich?.addEventListener('click', async () => {
      const ids = Array.from(selectedProductIds);
      if (!ids.length) return;
      showAlert('loading', 'Enriqueciendo con IA...', `Procesando ${ids.length} producto(s).`);
      let ok = 0, failed = 0;
      for (const id of ids) {
        const product = (currentProducts || []).find((p) => p.id === id);
        if (!product) { failed++; continue; }
        try {
          const res = await fetch('/api/admin/add-product', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: product.id,
              title: product.title,
              description: product.description,
              category: product.category,
              price: product.price,
              originalPrice: product.originalPrice,
              image: product.image,
              gallery: product.gallery,
              affiliateUrl: product.affiliateUrl,
              merchant: product.merchant,
              url: product.affiliateUrl,
              brand: product.merchant,
              rating: product.rating,
              reviewsCount: product.reviewsCount,
              pros: product.pros,
              cons: product.cons,
              techSheet: product.techSheet,
              badge: product.badge,
              options: { text: true, image: !product.image, save: true },
            }),
          });
          const data = await res.json();
          if (data && data.success) ok++; else failed++;
        } catch { failed++; }
      }
      selectedProductIds.clear();
      updateProdSelCount();
      await reloadProductsTable();
      showAlert(failed ? 'warning' : 'success', 'Enriquecimiento masivo finalizado', `${ok} actualizado${ok===1?'':'s'} · ${failed} con error.`);
    });

    btnProdMakeSection?.addEventListener('click', async () => {
      const ids = Array.from(selectedProductIds);
      if (!ids.length) { showAlert('warning', 'Sin selección', 'Selecciona al menos un producto del catálogo.'); return; }
      const title = window.prompt('Título de la nueva sección:');
      if (!title || !title.trim()) return;
      const description = window.prompt('Descripción opcional (vacío para omitir):') || '';
      const published = window.confirm('¿Publicar en la web ahora?');
      try {
        const res = await fetch('/api/admin/sections', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'create', title: title.trim(), description: description.trim(), productIds: ids, published }),
        });
        const data = await res.json();
        if (data.success) {
          selectedProductIds.clear();
          updateProdSelCount();
          await loadSectionsAdmin();
          showAlert('success', 'Sección creada', `${title.trim()} añadida a las secciones de la web.`);
        } else {
          showAlert('error', 'Error', data.message || 'No se pudo crear la sección.');
        }
      } catch {
        showAlert('error', 'Error de red', 'No se pudo crear la sección.');
      }
    });

    async function loadSectionsAdmin() {
      const host = document.getElementById('sectionsListAdmin');
      if (!host) return;
      try {
        const res = await fetch('/api/admin/sections', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) { host.innerHTML = '<p class="text-muted">No se pudieron cargar las secciones.</p>'; return; }
        const sections = Array.isArray(data.sections) ? data.sections : [];
        if (!sections.length) { host.innerHTML = '<p class="text-muted">Aún no hay secciones creadas.</p>'; return; }
        host.innerHTML = sections.map((s) => `
          <div class="section-admin-row">
            <strong>${escapeHtml ? escapeHtml(s.title) : s.title}</strong> <span class="admin-tag-pill">${s.published ? 'publicada' : 'oculta'}</span>
            <span class="muted">${(s.productIds || []).length} producto(s)</span>
            <button type="button" class="btn-secondary btn-sm" data-section-toggle="${s.id}" data-published="${!s.published}">${s.published ? 'Ocultar' : 'Publicar'}</button>
            <button type="button" class="btn-danger-ghost btn-sm" data-section-delete="${s.id}">Eliminar</button>
          </div>
        `).join('');
        host.querySelectorAll('[data-section-delete]').forEach((btn) => {
          btn.onclick = async () => {
            if (!confirm('¿Eliminar esta sección?')) return;
            await fetch('/api/admin/sections', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: btn.getAttribute('data-section-delete') }) });
            await loadSectionsAdmin();
          };
        });
        host.querySelectorAll('[data-section-toggle]').forEach((btn) => {
          btn.onclick = async () => {
            const id = btn.getAttribute('data-section-toggle');
            const published = btn.getAttribute('data-published') === 'true';
            await fetch('/api/admin/sections', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'update', id, published }) });
            await loadSectionsAdmin();
          };
        });
      } catch {
        host.innerHTML = '<p class="text-muted">Error de red.</p>';
      }
    }
    if (typeof loadSectionsAdmin === 'function') loadSectionsAdmin();
    attachRowActions();
    if (typeof reloadProductsTable === 'function') reloadProductsTable();

    // Handler para btnBuildCatalog (construcción automática del catálogo multi-comerciante)
    const btnBuildCatalog = document.getElementById('btnBuildCatalog');
    const btnBuildCatalogText = btnBuildCatalog?.querySelector('.btn-text') || btnBuildCatalog;
    const btnBuildCatalogSpinner = btnBuildCatalog?.querySelector('.btn-spinner');

    async function runBuildCatalog(dryRun = false) {
      const btn = dryRun ? document.getElementById('btnBuildCatalogDryRun') : btnBuildCatalog;
      const btnText = btn?.querySelector('.btn-text') || btn;
      const btnSpinner = btn?.querySelector('.btn-spinner');
      if (!btn) return;
      btn.disabled = true;
      btn.classList.add('loading');
      if (btnSpinner) btnSpinner.hidden = false;
      if (btnText) btnText.textContent = dryRun ? 'Simulando…' : 'Construyendo…';

      showAlert('loading', dryRun ? 'Simulando construcción de catálogo…' : 'Construyendo catálogo multi-comerciante…',
        'Consultando APIs de todas las redes conectadas, normalizando, deduplicando cross-merchant, autoclasificando y detectando ofertas estrella. Esto puede tardar 30-120 segundos.');

      try {
        const apiToken = window.TRADYLOR_API_TOKEN;
        const res = await fetch(`/api/v1/products/build-catalog${dryRun ? '?dryRun=1' : ''}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(apiToken ? { 'Authorization': `Bearer ${apiToken}` } : {})
          },
        });
        const data = await res.json();

        if (data.success) {
          if (!dryRun) {
            await reloadProductsTable();
          }
          const lines = [
            `Redes consultadas: ${(data.networksQueried || []).join(', ') || 'ninguna'}`,
            `Productos brutos: ${data.rawTotal}`,
            `Tras filtro calidad: ${data.afterQualityFilter}`,
            `Grupos cross-merchant: ${data.crossMerchantGroups} (duplicados resueltos: ${data.duplicatesResolved})`,
            `Sin categoría: ${data.uncategorized ?? 0}`,
            `Ofertas estrella (hsr): ${data.hsrDetected}`,
            `IA - Texto enriquecido: ${data.aiEnrichedText ?? 0} · Imágenes generadas: ${data.aiEnrichedImages ?? 0}`,
            dryRun ? `Se crearían: ${data.wouldUpsert ?? 0} · Se actualizarían: ${data.wouldUpdate ?? 0}`
              : `Nuevos: ${data.upserted} · Actualizados: ${data.updated}`,
            `Duración: ${Math.round(data.durationMs / 1000)}s`,
          ];
          showAlert('success', dryRun ? '✅ Simulación completada' : '✅ Catálogo construido con éxito', lines.join('\n'));
        } else {
          showAlert('error', dryRun ? 'Error en simulación' : 'Error construyendo catálogo', data.errors?.join('\n') || 'Error desconocido');
        }
      } catch (err) {
        console.error(err);
        showAlert('error', 'Error de red', 'No se pudo contactar con /api/v1/products/build-catalog');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('loading');
        }
        if (btnSpinner) btnSpinner.hidden = true;
        if (btnText) btnText.textContent = dryRun ? '🔍 Simular (Dry-run)' : '🏗️ Construir Catálogo';
      }
    }

    btnBuildCatalog?.addEventListener('click', () => runBuildCatalog(false));
    document.getElementById('btnBuildCatalogDryRun')?.addEventListener('click', () => runBuildCatalog(true));

    // Botón flotante: sube al menú de secciones (admin-section-nav).
    const adminBackToTop = document.getElementById('adminBackToTop');
    if (adminBackToTop) {
      adminBackToTop.addEventListener('click', () => {
        const nav = document.querySelector('.admin-section-nav');
        if (nav) {
          nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
          // En pantallas estrechas, despliega también el menú de secciones.
          const links = document.getElementById('adminNavLinks');
          const toggle = document.getElementById('adminNavToggle');
          if (links && toggle && window.getComputedStyle(toggle).display !== 'none' && !links.classList.contains('is-open')) {
            links.classList.add('is-open');
            toggle.setAttribute('aria-expanded', 'true');
          }
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    // Chips de URL en los detalles: copiar al portapapeles y desplegar/ocultar.
    document.addEventListener('click', async (event) => {
      const copyBtn = event.target.closest?.('.url-chip-copy');
      if (copyBtn) {
        event.stopPropagation();
        const url = copyBtn.getAttribute('data-url') || '';
        try {
          await navigator.clipboard.writeText(url);
          copyBtn.classList.add('is-copied');
          copyBtn.setAttribute('title', '¡Copiado!');
          setTimeout(() => {
            copyBtn.classList.remove('is-copied');
            copyBtn.setAttribute('title', 'Copiar enlace');
          }, 1400);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch {}
          ta.remove();
        }
        return;
      }
      const toggleBtn = event.target.closest?.('.url-chip-toggle');
      if (toggleBtn) {
        event.stopPropagation();
        const chip = toggleBtn.closest('.url-chip');
        if (chip) {
          const open = chip.classList.toggle('is-open');
          toggleBtn.setAttribute('aria-expanded', String(open));
          toggleBtn.setAttribute('title', open ? 'Ocultar la URL completa' : 'Mostrar u ocultar la URL completa');
        }
      }
    });

    // =========================================================================
    // 5. MÓDULO DE AFILIADOS Y MULTI-CATÁLOGO
    // =========================================================================
    const networkList = document.getElementById('networkList');
    const networksCard = document.getElementById('networksCard');
    const removedNetworks = document.getElementById('removedNetworks');
    const searchStatus = document.getElementById('searchStatus');
    const searchStatusTitle = document.getElementById('searchStatusTitle');
    const searchStatusText = document.getElementById('searchStatusText');
    let networksCache = [];

    function showSearchStatus(type, title, message) {
      if (!searchStatus) return;
      searchStatus.hidden = false;
      searchStatus.className = `status-alert alert-${type}`;
      if (searchStatusTitle) searchStatusTitle.textContent = title;
      if (searchStatusText) searchStatusText.textContent = message;
    }

    async function postNetworks(payload) {
      const res = await fetch('/api/admin/networks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      return res.json();
    }

    function statusLabel(status) {
      return status === 'connected' ? 'Conectada' : status === 'error' ? 'Error' : 'Pendiente';
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function newFieldRowHtml(label = '', secret = true, required = true) {
      return `
        <div class="new-field-row">
          <input class="nf-label" type="text" maxlength="60" placeholder="Etiqueta (ej: API Token)" value="${escapeHtml(label)}" />
          <label class="nf-check"><input type="checkbox" class="nf-secret" ${secret ? 'checked' : ''} /> Secreto</label>
          <label class="nf-check"><input type="checkbox" class="nf-required" ${required ? 'checked' : ''} /> Obligatorio</label>
          <button type="button" class="nf-remove" data-remove-field title="Quitar campo">✕</button>
        </div>`;
    }

    function newNetworkPanelHtml() {
      return `
        <details class="network-item network-new" data-network-new>
          <summary>
            <span class="network-add-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
            <span class="network-main network-add-main">
              <span class="network-name">Añadir afiliado nuevo</span>
              <span class="network-region">Función aparte: crea una red propia con sus campos de credenciales</span>
            </span>
            <span class="network-add-chip">Crear</span>
          </summary>
          <div class="network-body">
            <form class="network-new-form">
              <label class="cred-field">
                <span>Nombre *</span>
                <input type="text" name="name" maxlength="80" required placeholder="Ej: Programa de afiliados de MiTienda" />
              </label>
              <label class="cred-field">
                <span>Región</span>
                <input type="text" name="region" maxlength="60" placeholder="Global / UE" />
              </label>
              <label class="cred-field">
                <span>Descripción</span>
                <input type="text" name="description" maxlength="300" placeholder="Qué ofrece esta red" />
              </label>
              <label class="cred-field">
                <span>URL de documentación</span>
                <input type="text" name="docUrl" maxlength="300" placeholder="https://..." />
              </label>
              <div class="cred-field">
                <span>Color identificativo</span>
                <input type="color" name="color" value="#38bdf8" class="nf-color" />
              </div>
              <div class="new-fields">
                <span class="new-fields-title">Campos de credenciales *</span>
                <div class="new-field-rows">${newFieldRowHtml()}</div>
                <button type="button" class="btn-secondary btn-sm" data-add-field>+ Añadir campo</button>
              </div>
              <div class="network-actions">
                <button type="submit" class="btn-primary btn-sm">Crear afiliado</button>
              </div>
              <p class="network-feedback" data-new-feedback></p>
            </form>
          </div>
        </details>`;
    }

    function renderNetworks(networks) {
      networksCache = networks;
      if (!networkList) return;
      networkList.innerHTML = networks.map((network) => `
        <details class="network-item" data-network-id="${escapeHtml(network.id)}">
          <summary>
            <span class="network-color" style="background:${escapeHtml(network.color)}"></span>
            <span class="network-main">
              <span class="network-name">${escapeHtml(network.name)}</span>
              <span class="network-region">${escapeHtml(network.region)}</span>
            </span>
            <span class="integration-status ${network.status === 'connected' ? 'is-configured' : ''} ${network.status === 'error' ? 'is-error' : ''}">${statusLabel(network.status)}</span>
          </summary>
          <div class="network-body">
            <p class="network-desc">${escapeHtml(network.description)}</p>
            <form class="network-cred-form" data-network-id="${escapeHtml(network.id)}">
              <!-- Honeypot invisible: evita que el gestor de contraseñas del
                   navegador rellene este formulario con el usuario del panel -->
              <input type="text" name="__hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
              ${network.fields.map((field) => `
                <label class="cred-field">
                  <span>${escapeHtml(field.label)}${field.required ? ' *' : ''}</span>
                  <span class="cred-input-wrap">
                    <input
                      type="${field.secret ? 'password' : 'text'}"
                      name="${escapeHtml(field.key)}"
                      placeholder="${escapeHtml(field.hasValue ? '•••••••• (guardado)' : (field.placeholder || 'Sin configurar'))}"
                      autocomplete="${field.secret ? 'new-password' : 'off'}"
                      data-1p-ignore="true"
                      data-lpignore="true"
                      data-form-type="other"
                    />
                    <button type="button" class="cred-eye ${field.secret ? '' : 'is-shown'}" data-cred-eye title="Mostrar u ocultar el valor" aria-label="Mostrar u ocultar el valor">
                      <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                      <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                  </span>
                </label>
              `).join('')}
              <div class="network-actions">
                <span class="network-actions-main">
                  <button type="submit" class="btn-primary btn-sm">Guardar y validar</button>
                  <button type="button" class="btn-secondary btn-sm" data-network-validate="${escapeHtml(network.id)}">Validar</button>
                  <button type="button" class="btn-secondary btn-sm" data-network-reveal="${escapeHtml(network.id)}" title="Muestra u oculta los valores guardados de esta red">Ver</button>
                </span>
                <button type="button" class="btn-danger-ghost btn-sm" data-network-delete="${escapeHtml(network.id)}">Desconectar</button>
                <button type="button" class="btn-danger-ghost btn-sm network-remove" data-network-remove="${escapeHtml(network.id)}" title="Eliminar este afiliado de la lista">Eliminar</button>
                ${network.docUrl ? `<a class="network-doc" href="${escapeHtml(network.docUrl)}" target="_blank" rel="noopener noreferrer">Documentación</a>` : ''}
              </div>
              <p class="network-feedback" data-network-feedback="${escapeHtml(network.id)}">${escapeHtml(network.statusDetail || '')}</p>
            </form>
          </div>
        </details>
      `).join('') + newNetworkPanelHtml();
    }

    /** Redibuja la lista activa y el aviso de redes predefinidas eliminadas. */
    function applyNetworks(data) {
      if (Array.isArray(data.networks)) renderNetworks(data.networks);
      renderRemoved(Array.isArray(data.removed) ? data.removed : []);
      populateAliNetworkFilter();
    }

    /**
     * Rellena el select «Comerciante / Red» de #aliFilters con TODAS las redes
     * del panel «Redes conectadas». Conectadas: texto negro subrayado con el
     * color de la red (como el span.network-color, un punto más opaco). No
     * conectadas: gris.
     */
    function populateAliNetworkFilter() {
      const select = document.getElementById('aliFNetwork');
      if (!select) return;
      const current = select.value;
      select.innerHTML = '<option value="">Todas</option>';
      for (const network of networksCache || []) {
        const option = document.createElement('option');
        option.value = network.id;
        option.textContent = network.name;
        if (network.status === 'connected') {
          option.style.color = '#0b1220';
          option.style.textDecoration = 'underline';
          option.style.textDecorationColor = network.color;
          option.style.fontWeight = '700';
        } else {
          option.style.color = '#9ca3af';
        }
        select.appendChild(option);
      }
      if (current && Array.from(select.options).some((o) => o.value === current)) select.value = current;
    }

    function renderRemoved(removed) {
      if (!removedNetworks) return;
      if (!removed.length) {
        removedNetworks.hidden = true;
        removedNetworks.innerHTML = '';
        return;
      }
      removedNetworks.hidden = false;
      removedNetworks.innerHTML = `
        <span>${removed.length} red${removed.length === 1 ? '' : 'es'} predefinida${removed.length === 1 ? '' : 's'} eliminada${removed.length === 1 ? '' : 's'}: ${removed.map((network) => escapeHtml(network.name)).join(', ')}.</span>
        <button type="button" class="btn-secondary btn-sm" data-restore-networks>Restaurar</button>`;
    }

    async function loadNetworks() {
      try {
        const res = await fetch('/api/admin/data', { credentials: 'include' });
        const data = await res.json();
        if (data.success && Array.isArray(data.networks)) applyNetworks(data);
      } catch {
        if (networkList) networkList.innerHTML = '<div class="empty-dashboard">No se pudieron cargar las redes.</div>';
      }
    }

    networksCard?.addEventListener('submit', async (event) => {
      const newForm = event.target.closest('.network-new-form');
      if (newForm) {
        event.preventDefault();
        const feedback = newForm.querySelector('[data-new-feedback]');
        const rows = [...newForm.querySelectorAll('.new-field-row')];
        const fields = rows
          .map((row) => ({
            label: row.querySelector('.nf-label')?.value.trim() || '',
            secret: Boolean(row.querySelector('.nf-secret')?.checked),
            required: Boolean(row.querySelector('.nf-required')?.checked),
          }))
          .filter((field) => field.label);
        if (!fields.length) {
          if (feedback) feedback.textContent = 'Añade al menos un campo de credencial con etiqueta.';
          return;
        }
        const values = Object.fromEntries(new FormData(newForm).entries());
        const submitBtn = newForm.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        const data = await postNetworks({ action: 'create', ...values, fields });
        if (submitBtn) submitBtn.disabled = false;
        if (data.success) {
          applyNetworks(data);
          const created = networkList.querySelector(`details[data-network-id="${data.network.id}"]`);
          if (created) created.open = true;
        } else if (feedback) {
          feedback.textContent = data.message || 'No se pudo crear el afiliado.';
        }
        return;
      }

      const form = event.target.closest('.network-cred-form');
      if (!form) return;
      event.preventDefault();
      const networkId = form.dataset.networkId;
      const values = Object.fromEntries(new FormData(form).entries());
      const data = await postNetworks({ action: 'save', networkId, values });
      if (data.success) {
        applyNetworks(data);
        const item = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (item) item.open = true;
        // Guardar valida en segundo plano: así la red queda "Conectada" sin
        // pasos extra y la sincronización del catálogo no necesita revalidar.
        await validateNetwork(networkId);
        // Tras validar (que vuelve a re-dibujar la lista) se repone en los
        // inputs exactamente lo que se escribió, para que el Tracking ID u
        // otros valores guardados se vean sin tener que pulsar «Ver».
        const savedForm = networkList.querySelector(`.network-cred-form[data-network-id="${networkId}"]`);
        if (savedForm) {
          savedForm.dataset.revealed = '1';
          for (const input of savedForm.querySelectorAll('input[name]')) {
            const written = values[input.name];
            if (written) input.value = written;
          }
        }
        const savedItem = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (savedItem) savedItem.open = true;
      } else {
        const feedback = networkList.querySelector(`[data-network-feedback="${networkId}"]`);
        if (feedback) feedback.textContent = data.message || 'No se pudieron guardar las credenciales.';
        const item = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (item) item.open = true;
      }
    });

    /** Valida una red desde el panel: estado + efectos según la red conectada. */
    async function validateNetwork(networkId) {
      const feedback = networkList?.querySelector(`[data-network-feedback="${networkId}"]`);
      if (feedback) feedback.textContent = 'Validando conexión...';
      const data = await postNetworks({ action: 'validate', networkId });
      applyNetworks(data);
      const item = networkList?.querySelector(`details[data-network-id="${networkId}"]`);
      if (item) item.open = true;
      const newFeedback = networkList?.querySelector(`[data-network-feedback="${networkId}"]`);
      if (newFeedback) newFeedback.textContent = data.message || '';

      // Al conectar una red, refrescamos lo que corresponda: AliExpress
      // recarga la caché de su tabla; el resto sólo confirma la conexión.
      const validated = (data.networks || []).find((n) => n.id === networkId);
      if (validated && validated.status === 'connected') {
        if (networkId === 'aliexpress') {
          await syncAliCatalogUI();
        } else {
          showSearchStatus('success', 'Red conectada', `${validated.name} se ha conectado correctamente.`);
        }
      }
      return data;
    }

    /** Muestra/oculta los valores reales guardados de una red en su formulario. */
    async function toggleRevealCredentials(networkId, button) {
      const form = networkList?.querySelector(`.network-cred-form[data-network-id="${networkId}"]`);
      if (!form) return;
      const revealed = form.dataset.revealed === '1';
      if (revealed) {
        for (const input of form.querySelectorAll('input[name]')) {
          input.value = '';
          const field = (networksCache || []).find((n) => n.id === networkId)?.fields?.find((f) => f.key === input.name);
          input.type = field?.secret ? 'password' : 'text';
          input.parentElement?.querySelector('[data-cred-eye]')?.classList.toggle('is-shown', !field?.secret);
        }
        form.dataset.revealed = '0';
        if (button) button.textContent = 'Ver';
        return;
      }
      if (button) {
        button.disabled = true;
        button.textContent = '...';
      }
      try {
        const data = await postNetworks({ action: 'reveal', networkId });
        if (!data.success) {
          const feedback = networkList.querySelector(`[data-network-feedback="${networkId}"]`);
          if (feedback) feedback.textContent = data.message || 'No hay credenciales guardadas para mostrar.';
          return;
        }
        for (const input of form.querySelectorAll('input[name]')) {
          const value = data.values?.[input.name];
          if (value != null) {
            input.value = value;
            input.type = 'text';
            input.parentElement?.querySelector('[data-cred-eye]')?.classList.add('is-shown');
          }
        }
        form.dataset.revealed = '1';
        if (button) button.textContent = 'Ocultar';
      } finally {
        if (button) button.disabled = false;
      }
    }

    networksCard?.addEventListener('click', async (event) => {
      const addFieldBtn = event.target.closest('[data-add-field]');
      if (addFieldBtn) {
        const rows = addFieldBtn.closest('.new-field-rows');
        if (rows) rows.insertAdjacentHTML('beforeend', newFieldRowHtml('', true, true));
        return;
      }

      const removeFieldBtn = event.target.closest('[data-remove-field]');
      if (removeFieldBtn) {
        const rows = networkList.querySelectorAll('.new-field-row');
        const row = removeFieldBtn.closest('.new-field-row');
        if (row && rows.length > 1) row.remove();
        else if (row) row.querySelector('.nf-label')?.focus();
        return;
      }

      // Ojo de cada campo: alterna password ↔ text en ese input
      const eyeBtn = event.target.closest('[data-cred-eye]');
      if (eyeBtn) {
        const input = eyeBtn.parentElement?.querySelector('input');
        if (input) {
          const show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          eyeBtn.classList.toggle('is-shown', show);
        }
        return;
      }

      const validateBtn = event.target.closest('[data-network-validate]');
      const revealBtn = event.target.closest('[data-network-reveal]');
      const deleteBtn = event.target.closest('[data-network-delete]');
      const removeBtn = event.target.closest('[data-network-remove]');

      if (validateBtn) {
        validateBtn.disabled = true;
        try {
          await validateNetwork(validateBtn.dataset.networkValidate);
        } finally {
          validateBtn.disabled = false;
        }
        return;
      }

      if (revealBtn) {
        await toggleRevealCredentials(revealBtn.dataset.networkReveal, revealBtn);
        return;
      }

      if (deleteBtn) {
        const networkId = deleteBtn.dataset.networkDelete;
        if (!window.confirm('¿Desconectar esta red? Se eliminarán sus credenciales almacenadas.')) return;
        const data = await postNetworks({ action: 'delete', networkId });
        if (data.success) applyNetworks(data);
      }

      if (removeBtn) {
        const networkId = removeBtn.dataset.networkRemove;
        const network = (networksCache || []).find((n) => n.id === networkId);
        const label = network ? ` "${network.name}"` : '';
        if (!window.confirm(`¿Eliminar el afiliado${label}? Se borrarán también sus credenciales de la lista.`)) return;
        const data = await postNetworks({ action: 'remove', networkId });
        if (data.success) applyNetworks(data);
        else showSearchStatus('error', 'No se pudo eliminar', data.message || 'Error desconocido.');
      }
    });

    removedNetworks?.addEventListener('click', async (event) => {
      if (!event.target.closest('[data-restore-networks]')) return;
      const data = await postNetworks({ action: 'restore' });
      if (data.success) applyNetworks(data);
    });

    /** Categoría asignada al importar ('' = automática por keywords). */
    function getImportCategory() {
      return '';
    }

    const money = (value, currency = 'EUR') => (value == null || value === '' ? '—' : `${Number(value).toFixed(2)} ${currency === 'EUR' ? '€' : currency}`);

    /** Chip compacto de URL: una sola línea con ellipsis + copiar + desplegar. */
    function renderUrlChip(raw) {
      const url = escapeHtml(raw);
      return `
        <span class="url-chip">
          <a href="${url}" target="_blank" rel="noopener noreferrer" class="url-chip-text" title="${url}">${url}</a>
          <button type="button" class="url-chip-btn url-chip-copy" data-url="${url}" title="Copiar enlace" aria-label="Copiar enlace">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
          <button type="button" class="url-chip-btn url-chip-toggle" title="Mostrar u ocultar la URL completa" aria-label="Desplegar URL">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </span>`;
    }

    /** URLs de imagen del detalle (extras «Imágenes», galería e imagen principal), sin repetir. */
    function detailImageUrls(product) {
      const urls = [];
      const push = (value) => {
        const url = String(value || '').trim();
        if (/^https?:\/\//i.test(url) && !urls.includes(url)) urls.push(url);
      };
      const rawImages = product.extra && product.extra['Imágenes'];
      if (rawImages) String(rawImages).split('|').forEach(push);
      if (Array.isArray(product.gallery)) product.gallery.forEach(push);
      push(product.image);
      return urls;
    }

    function productDetailRows(product) {
      const extraOf = (key) => {
        const raw = product.extra && product.extra[key];
        return raw == null || raw === '' ? null : raw;
      };
      const affiliateLink = extraOf('Enlace de afiliado') || extraOf('Enlace de afiliado final') || product.promotionUrl || product.productUrl || null;
      const buyNow = extraOf('Enlace de compra directa') || extraOf('Buy Now') || extraOf('Buy Now URL') || null;
      const specs = extraOf('Especificaciones') || extraOf('Specs') || null;
      const rows = [
        ['Red', product.network],
        ['ID externo', product.externalId],
        ['Categoría', product.category],
        ['Marca', product.brand || extraOf('Marca') || extraOf('Brand')],
        ['Distribuidor (envío y pago)', product.fulfillmentProvider || extraOf('Distribuidor') || extraOf('Fulfillment') || extraOf('Vendedor')],
        ['Descripción', product.description],
        ['Precio', money(product.price, product.currency)],
        ['Precio original', product.originalPrice != null ? money(product.originalPrice, product.currency) : null],
        ['Moneda', product.currency],
        ['Comisión (%)', product.commissionRate != null ? `${product.commissionRate}%` : null],
        ['Comisión estimada', product.commissionAmount != null ? money(product.commissionAmount, product.currency) : null],
        ['Valoración (0–5)', product.rating != null ? `${product.rating} / 5` : null],
        ['Nº de opiniones', product.reviewsCount],
        ['Ventas / alcance', product.popularity],
        ['Stock', product.inStock ? 'En stock' : 'Sin stock'],
        ['Enlace de Afiliado Final', affiliateLink],
        ['Enlace de Compra Directa (Buy Now)', buyNow],
        ['Texto de envío', product.shippingInfo || extraOf('Texto de envío') || extraOf('Envío')],
        ['Días de envío', product.shippingDays ?? extraOf('Días de envío')],
        ['Origen de datos', product.estimated ? 'Estimado (API no cableada)' : 'API oficial'],
        ['Alta en catálogo', aliFmtDate(product.firstSeenAt)],
        ['URL del producto', product.productUrl],
      ];
      if (specs) rows.push(['Especificaciones (specs clave/valor)', specs]);
      // Etiquetas ya cubiertas arriba: no se repiten desde los extras.
      const handled = new Set([
        'Red', 'ID externo', 'Categoría', 'Marca', 'Brand', 'Distribuidor', 'Fulfillment', 'Vendedor',
        'Descripción', 'Precio', 'Moneda', 'Valoración', 'Reseñas', 'Ventas / alcance', 'Stock',
        'Enlace de afiliado', 'Enlace de afiliado final', 'Enlace de compra directa', 'Buy Now', 'Buy Now URL',
        'Envío', 'Texto de envío', 'Días de envío', 'Origen de datos', 'Alta en catálogo', 'URL del producto',
        'Especificaciones', 'Specs',
      ]);
      for (const [label, value] of Object.entries(product.extra || {})) {
        if (value == null || value === '') continue;
        // Las imágenes NO se pintan en su posición natural del extra:
        // van en el ÚLTIMO aff-detail-item del desplegable.
        if (label === 'Imágenes') continue;
        if (handled.has(label)) continue;
        rows.push([label, value]);
      }
      const fields = rows
        .filter(([, value]) => value != null && value !== '')
        .map(([label, value]) => {
          const raw = String(value);
          const cell = /^https?:\/\//i.test(raw)
            ? renderUrlChip(raw)
            : escapeHtml(raw);
          return `<div class="aff-detail-item"><dt>${escapeHtml(label)}</dt><dd>${cell}</dd></div>`;
        })
        .join('');
      // Miniaturas SIEMPRE al final, en una única fila horizontal
      // (scroll horizontal si no caben todas a la vez).
      const images = detailImageUrls(product);
      if (!images.length) return fields;
      const cells = images
        .map((url) => `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer"><img src="${escapeHtml(url)}" alt="" loading="lazy" /></a>`)
        .join('');
      return `${fields}<div class="aff-detail-item is-images"><dt>Imágenes (${images.length})</dt><dd class="aff-detail-thumbs">${cells}</dd></div>`;
    }

    /** Construye el payload de guardado compartido por importación simple y masiva.
     *  `categoryOverride` (opcional) fuerza la categoría destino elegida en la
     *  barra de acciones; sin él se mantiene la automática por keywords. */
    function buildImportPayload(product, categoryOverride) {
      const assignedCategory =
        categoryOverride != null ? categoryOverride : getImportCategory();
      const affiliateLink =
        (product.extra && (product.extra['Enlace de afiliado'] || product.extra['Enlace de afiliado '] )) ||
        product.promotionUrl ||
        product.productUrl;
      const gallery =
        Array.isArray(product.gallery) && product.gallery.length
          ? product.gallery.slice(0, 10)
          : product.image
            ? [product.image]
            : [];
      // Datos de envío del catálogo del comerciante (AliExpress: "Días de envío").
      const rawDays = product.extra?.['Días de envío'] ?? product.shippingDays;
      const shippingDays = rawDays != null && rawDays !== '' && Number.isFinite(Number(rawDays))
        ? Math.max(0, Math.round(Number(rawDays)))
        : undefined;
      const shippingInfo =
        (product.shippingInfo && String(product.shippingInfo).trim()) ||
        (shippingDays != null ? `Envío en ${shippingDays} días` : undefined);
      const freeShipping =
        typeof product.freeShipping === 'boolean'
          ? product.freeShipping
          : shippingDays != null && shippingDays <= 3;
      // Campos que la ficha del producto (formulario) espera recibir: Marca,
      // Especificaciones, Distribuidor, Enlace de afiliado final y Buy Now.
      const extraOf = (key) => {
        const raw = product.extra && product.extra[key];
        return raw == null || raw === '' ? null : String(raw);
      };
      const brand = product.brand || extraOf('Marca') || extraOf('Brand')
        || (product.network === 'aliexpress' ? 'AliExpress' : product.network);
      const rawSpecs = extraOf('Especificaciones') || extraOf('Specs');
      const specs = (() => {
        if (!rawSpecs) return undefined;
        const parsed = {};
        rawSpecs.split(/\s*(?:·|;|\|)\s*/).map((part) => part.trim()).filter(Boolean).forEach((part) => {
          const idx = part.indexOf(':');
          if (idx > 0) {
            const k = part.slice(0, idx).trim();
            const v = part.slice(idx + 1).trim();
            if (k && v) parsed[k] = v;
          }
        });
        return Object.keys(parsed).length ? parsed : undefined;
      })();
      const fulfillmentProvider =
        product.fulfillmentProvider || extraOf('Distribuidor') || extraOf('Fulfillment') || extraOf('Vendedor') || undefined;
      const buyNowUrl = extraOf('Enlace de compra directa') || extraOf('Buy Now') || extraOf('Buy Now URL') || undefined;
      return {
        action: 'save',
        product: {
          title: product.title,
          description: product.description,
          price: product.price,
          originalPrice: product.originalPrice,
          image: product.image,
          gallery,
          category: assignedCategory,
          merchant: product.network,
          affiliateUrl: affiliateLink,
          // ID externo del comerciante (Item ID de AliExpress / ASIN): se
          // persiste como `sourceId` para que el filtro «En catálogo »
          // reconozca la fila aunque el enlace corto de afiliado cambie.
          sourceId: String(product.sourceId || product.externalId || '').trim() || undefined,
          // URL de la ficha real (no el enlace corto de afiliado): el servidor
          // la lee para complementar marca, specs, opiniones, envío y Buy Now.
          url: product.productUrl || affiliateLink,
          rating: product.rating,
          reviewsCount: product.reviewsCount,
          badge: product.network,
          brand,
          specs,
          fulfillmentProvider,
          buyNowUrl,
          pros: [`Comisión estimada: ${product.commissionRate ?? 0}% en ${product.network}`],
          cons: [],
          shippingInfo,
          shippingDays,
          freeShipping,
        },
      };
    }

    async function importSingleProduct(product, btn, categoryOverride) {
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Importando...';
      }
      try {
        const res = await fetch('/api/products/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildImportPayload(product, categoryOverride)),
        });
        const data = await res.json();
        // El servidor detecta duplicados (misma URL/título): se contabiliza como
        // «ya estaba», nunca como error ni como alta nueva.
        if (data && data.duplicate) {
          if (btn) {
            btn.disabled = true;
            btn.textContent = 'Añadido';
            btn.classList.add('is-added');
          }
          return { ok: true, duplicate: true, message: data.message, product: data.product };
        }
        if (data.success) {
          if (btn) {
            btn.textContent = 'Importado ✓';
            btn.classList.add('is-done');
          }
          return { ok: true, message: data.message, product: data.product };
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Importar a Tradylor';
        }
        return { ok: false, message: data.message || 'No se pudo guardar el producto.' };
      } catch {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Importar a Tradylor';
        }
        return { ok: false, message: 'Fallo de red al importar.' };
      }
      }

    /**
     * Letrero de confirmación anclado ENCIMA del botón «Añadir», dentro de la
     * celda de acciones. Se autodestruye a los pocos segundos; la tabla sólo se
     * repinta si el filtro «Estado» hace que la fila deba desaparecer.
     */
    function showAliImportFlag(btn, text, tone) {
      if (!btn) return;
      const cell = btn.closest('.aff-actions');
      if (!cell) return;
      const previous = cell.querySelector('.ac-added-flag');
      if (previous) previous.remove();
      const flag = document.createElement('span');
      flag.className = `ac-added-flag is-${tone || 'ok'}`;
      flag.setAttribute('role', 'status');
      flag.textContent = text;
      cell.appendChild(flag);
      window.setTimeout(() => flag.remove(), 2800);
    }

    /**
     * Marca el botón «Añadir» de una fila como YA AÑADIDO: texto «Añadido»,
     * color propio y estado inactivo (imposible repetir la alta).
     */
    function markAliImported(btn) {
      if (!btn) return;
      btn.disabled = true;
      btn.textContent = 'Añadido';
      btn.title = 'Ya está en el catálogo';
      btn.classList.remove('is-done');
      btn.classList.add('is-added');
    }

    /**
     * Botón «Añadir» de la fila con ese ID externo, tal como está pintada AHORA.
     * Tras un repintado el botón original desaparece del DOM, así que los avisos
     * se anclan en la fila recién renderizada (`data-ac-id`).
     */
    function aliImportButtonFor(externalId) {
      const wanted = String(externalId || '');
      if (!wanted) return null;
      for (const row of document.querySelectorAll('[data-ac-id]')) {
        if (String(row.getAttribute('data-ac-id') || '') === wanted) {
          return row.querySelector('[data-ac-import]') || null;
        }
      }
      return null;
    }

    /**
     * Categoría + subcategoría elegidas en la barra de acciones (#aliImportActions).
     * Devuelve `null` si no se ha elegido categoría (alta automática por keywords).
     */
    function aliChosenCategory() {
      const name = String((aliCatAssign && 'value' in aliCatAssign ? aliCatAssign.value : '') || '').trim();
      if (!name) return null;
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const catObj = allCats.find((c) => !c.parentId && c.name === name);
      const subName = String((aliSubcatAssign && 'value' in aliSubcatAssign ? aliSubcatAssign.value : '') || '').trim();
      const subObj = catObj ? allCats.find((c) => c.name === subName && c.parentId === catObj.id) : undefined;
      return { name, categoryId: catObj?.id || '', subcategoryId: subObj?.id || '', subName };
    }

    /**
     * Fija los IDs jerárquicos (category_id / subcategory_id) de productos ya
     * guardados: los endpoints de alta sólo persisten el nombre de categoría.
     */
    async function assignAliCategory(ids, chosen) {
      if (!ids.length || !chosen || !chosen.categoryId) return false;
      try {
        const res = await fetch('/api/products/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'set-category',
            ids,
            category: chosen.name,
            category_id: chosen.categoryId,
            subcategory_id: chosen.subcategoryId || '',
          }),
        });
        const data = await res.json();
        return Boolean(data && data.success);
      } catch {
        return false;
      }
    }

    /**
     * Botón «Añadir» de la tabla de productos de afiliados.
     * Guarda directamente en el catálogo de Tradylor (IA de texto + persistencia)
     * y sólo muestra un letrero sobre el botón: NO cambia de sección ni carga
     * el formulario de edición. Si hay categoría elegida en la barra de
     * acciones, el producto aterriza directamente en ella.
     */
    async function importAliProductToCatalog(product, btn) {
      const alreadyImported = aliEstadoIndex().get(product.externalId) === 'IMPORTED';
      // Guardia local: el botón ya sale desactivado, pero la caché de estados
      // podría estar desactualizada; en ningún caso se da de alta un duplicado.
      if (alreadyImported) {
        markAliImported(btn);
        showAliImportFlag(btn, 'Ya estaba en el catálogo', 'warn');
        return { ok: true, duplicate: true, product: null };
      }
      const chosen = aliChosenCategory();
      const basic = buildImportPayload(product, chosen ? chosen.name : undefined).product;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Guardando…';
      }
      try {
        const res = await fetch('/api/admin/add-product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: basic.id,
            title: basic.title,
            description: product.description,
            category: basic.category,
            price: basic.price,
            originalPrice: basic.originalPrice,
            image: basic.image,
            gallery: basic.gallery,
            affiliateUrl: basic.affiliateUrl,
            sourceId: basic.sourceId,
            merchant: product.network,
            url: product.productUrl,
            brand: basic.brand || (product.network === 'aliexpress' ? 'AliExpress' : product.network),
            rating: product.rating,
            reviewsCount: product.reviewsCount,
            specs: basic.specs,
            fulfillmentProvider: basic.fulfillmentProvider,
            buyNowUrl: basic.buyNowUrl,
            pros: basic.pros,
            cons: basic.cons,
            techSheet: basic.techSheet,
            badge: basic.badge,
            shippingInfo: basic.shippingInfo,
            shippingDays: basic.shippingDays,
            freeShipping: basic.freeShipping,
            options: { text: true, image: false, save: true },
          }),
        });
        const data = await res.json();
        if (data && data.success) {
          // El servidor contesta `duplicate: true` si el producto ya existía
          // (misma URL o mismo título): no se crea una segunda fila.
          const duplicate = Boolean(alreadyImported || data.duplicate);
          // Categoría/subcategoría elegidas en la barra de acciones: además del
          // nombre, se fijan los IDs jerárquicos sobre el producto recién dado
          // de alta (los duplicados conservan la categoría que ya tenían).
          // Se hace ANTES de recargar, porque escribe en el servidor.
          if (!duplicate && chosen && chosen.categoryId) {
            await assignAliCategory([data.product?.id || basic.id], chosen);
          }
          // Espera a recargar el catálogo registrado: además de la tabla de
          // productos, `reloadProductsTable()` repinta la de afiliados con el
          // índice de estados ya actualizado.
          await reloadProductsTable();
          // La API devuelve los avisos en `enrichment.warnings` (`warnings` suelto sólo existe en el 502).
          const warnings = Array.isArray(data.enrichment?.warnings) ? data.enrichment.warnings : [];
          if (warnings.length) showAliStatus('warning', 'Añadido con avisos', warnings.join(' | '));
          // El letrero va en el botón RECIENTEMENTE pintado: el original ya no
          // existe en el DOM tras el repintado de la tabla.
          const freshBtn = aliImportButtonFor(product.externalId);
          if (freshBtn) {
            markAliImported(freshBtn);
            showAliImportFlag(
              freshBtn,
              duplicate ? 'Ya estaba en el catálogo' : 'Añadido al catálogo',
              duplicate ? 'warn' : 'ok',
            );
          } else {
            // La fila ya no se ve (filtro «No añadidos»): aviso en la tarjeta.
            showAliStatus(
              duplicate ? 'warning' : 'success',
              duplicate ? 'Ya estaba en el catálogo' : 'Añadido al catálogo',
              `«${product.title}» ${duplicate ? 'ya figuraba' : 'se ha añadido'} en el catálogo registrado.`,
            );
          }
          return { ok: true, duplicate, product: data.product };
        }
        const message = (data && data.message) || 'No se pudo añadir al catálogo.';
        showAliImportFlag(btn, message, 'error');
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Añadir';
        }
        return { ok: false, message };
      } catch {
        showAliImportFlag(btn, 'Fallo de red al añadir', 'error');
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Añadir';
        }
        return { ok: false, message: 'Fallo de red al importar.' };
      }
    }

    if (networkList) loadNetworks();

    // =========================================================================
    // 5b. CATÁLOGO ALIEXPRESS EN CACHÉ (/api/admin/aliexpress/catalog)
    //    - GET: sólo lee el JSON del volumen. NUNCA consulta la TOP API en
    //      cada carga del panel (evita rate limits y pantallas lentas).
    //    - POST: botón «Sincronizar» (y al validar la conexión) → consulta la
    //      API keyword a keyword y reescribe la caché.
    //    - Si la caché supera las 6 horas se muestra un aviso, sin auto-sync.
    // =========================================================================
    const aliCatalogHost = document.getElementById('aliCatalogHost');
    const aliCatalogMeta = document.getElementById('aliCatalogMeta');
    const aliCatalogStatus = document.getElementById('aliCatalogStatus');
    const aliCatalogStatusIcon = document.getElementById('aliCatalogStatusIcon');
    const aliCatalogStatusTitle = document.getElementById('aliCatalogStatusTitle');
    const aliCatalogStatusText = document.getElementById('aliCatalogStatusText');
    const btnAliSync = document.getElementById('btnAliSync');
    const btnAliSyncHeader = document.getElementById('btnAliSyncHeader');
    const btnAliMore = document.getElementById('btnAliMore');
    const aliFilters = document.getElementById('aliFilters');
    const aliSelectionBar = document.getElementById('aliSelectionBar');
    const aliSelCount = document.getElementById('aliSelCount');
    const btnAliSelAllFiltered = document.getElementById('aliSelAllFiltered');
    const btnAliSelClear = document.getElementById('aliSelClear');
    const btnAliSelImport = document.getElementById('aliSelImport');
    const aliSyncNetwork = document.getElementById('aliSyncNetwork');
    // Barra de acciones (#aliImportActions): alta directa en categorías
    // existentes, ocultado masivo y sincronización del caché.
    const aliImportTools = document.getElementById('aliImportTools');
    const aliCatAssign = document.getElementById('aliCatAssign');
    const aliSubcatAssign = document.getElementById('aliSubcatAssign');
    const btnAliImportCat = document.getElementById('btnAliImportCat');
    const btnAliHideSel = document.getElementById('btnAliHideSel');
    // Botones de peligro: borrar seleccionados / borrar todo el catálogo de AliExpress
    const aliCatalogDanger = document.getElementById('aliCatalogDanger');
    const btnAliDeleteSelected = document.getElementById('btnAliDeleteSelected');
    const btnAliDeleteAll = document.getElementById('btnAliDeleteAll');

    /**
     * Rellena un select de subcategoría destino en cascada (#prodSubcatDest y
     * #aliSubcatAssign). Compartido por ambos selectores:
     *  - Con categoría padre elegida: sólo sus subcategorías.
     *  - Sin categoría elegida: TODAS las subcategorías del catálogo, con la
     *    etiqueta «Padre › Hija», para que las creadas en el apartado
     *    Categorías siempre se vean reflejadas en el desplegable.
     * El `value` de cada opción es el nombre de la subcategoría (así lo
     * consumen aliChosenCategory() y la asignación masiva de productos).
     */
    function fillSubcatDestOptions(subSelect, categoryName) {
      if (!subSelect) return;
      const current = String(subSelect.value || '');
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const parent = categoryName
        ? allCats.find((c) => !c.parentId && c.name === categoryName) || null
        : null;
      const subs = allCats.filter((c) => c.parentId && (!parent || c.parentId === parent.id));
      const optionLabel = (c) => {
        if (parent) return `${c.icon ? `${c.icon} ` : ''}${c.name}`;
        const owner = allCats.find((candidate) => candidate.id === c.parentId);
        return owner ? `${owner.name} › ${c.name}` : c.name;
      };
      subSelect.innerHTML = '<option value="">Subcategoría destino…</option>' + subs.map((c) =>
        `<option value="${escapeHtml(c.name)}">${escapeHtml(optionLabel(c))}</option>`
      ).join('');
      if (current && Array.from(subSelect.options).some((o) => o.value === current)) subSelect.value = current;
    }

    /**
     * Si se elige una subcategoría que no pertenece a la categoría padre
     * marcada (o no hay ninguna marcada), se selecciona automáticamente su
     * categoría raíz: la cascada se repinta y categoría + subcategoría
     * quedan coherentes para guardar los IDs jerárquicos del producto.
     */
    function bindSubcatDestCascade(catSelect, subSelect) {
      if (!catSelect || !subSelect) return;
      subSelect.addEventListener('change', () => {
        const subName = String(('value' in subSelect ? subSelect.value : '') || '').trim();
        if (!subName) return;
        const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
        const parentName = String(('value' in catSelect ? catSelect.value : '') || '').trim();
        const parent = parentName ? allCats.find((c) => !c.parentId && c.name === parentName) : null;
        if (parent && allCats.some((c) => c.parentId === parent.id && c.name === subName)) return;
        const owner = allCats.find((c) => c.parentId && c.name === subName);
        const root = owner ? allCats.find((c) => c.id === owner.parentId) : null;
        if (!root || !('value' in catSelect)) return;
        catSelect.value = root.name;
        catSelect.dispatchEvent(new Event('change'));
      });
    }

    /** Cascada subcategoría → categoría en la barra de acciones de Afiliados. */
    function syncAliSubcatAssign() {
      if (!aliCatAssign || !aliSubcatAssign) return;
      fillSubcatDestOptions(aliSubcatAssign, String(('value' in aliCatAssign ? aliCatAssign.value : '') || '').trim());
    }
    aliCatAssign?.addEventListener('change', syncAliSubcatAssign);
    bindSubcatDestCascade(aliCatAssign, aliSubcatAssign);

    const ALI_PAGE_SIZE = 50;
    const ALI_COLS = 14;
    let aliProducts = [];
    let aliVisible = [];
    let aliPage = 1;
    let aliSyncing = false;
    let aliImportingSelection = false;
    const aliSelected = new Set();

    // ✕ de la tabla: el producto se marca como DESCARTADO (estado `DISCARDED`)
    // en lugar de borrarse de la caché, así el filtro «Estado › Descartados»
    // permite revisarlo y recuperarlo. «Sincronizar» lo levanta. Vive en
    // localStorage para que el descarte sobreviva a recargas del panel.
    const AC_REMOVED_KEY = 'tradylor_ac_removed';
    function acRemovedGet() {
      try {
        return new Set(JSON.parse(localStorage.getItem(AC_REMOVED_KEY) || '[]'));
      } catch {
        return new Set();
      }
    }
    function acRemovedSave(set) {
      try {
        localStorage.setItem(AC_REMOVED_KEY, JSON.stringify([...set]));
      } catch { /* almacenamiento no disponible */ }
    }

    /**
     * Estado de importación de cada producto del catálogo AliExpress.
     *  - DISCARDED: ocultado con la ✕ de la tabla (se conserva en la caché para
     *    poder recuperarlo con el filtro «Descartados»).
     *  - IMPORTED: su URL de afiliado o su título ya está en el catálogo Tradylor.
     *  - PENDING:  el resto.
     */
    function aliNormKey(value) {
      return String(value || '')
        .trim()
        .toLowerCase()
        .replace(/^https?:\/\/(www\.)?/, '')
        .replace(/[?#].*$/, '')
        .replace(/\/+$/, '');
    }

    /** Título normalizado (minúsculas, sin acentos ni puntuación). */
    function aliNormTitle(value) {
      return String(value || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    /** Tokens significativos de un título (>2 caracteres). */
    function aliTitleTokens(value) {
      const t = aliNormTitle(value);
      return t ? t.split(' ').filter((tok) => tok.length > 2) : [];
    }

    /** ID del artículo (Item ID de AliExpress / ASIN) extraído de una URL. */
    function aliItemIdOf(value) {
      const raw = String(value || '');
      if (!raw) return '';
      const m =
        raw.match(/\/item\/(?:[^/?#]*\/)?(?:ae01_)?(\d{6,20})/i) ||
        raw.match(/\/i\/(\d{6,20})(?:[/?#]|$)/i) ||
        raw.match(/[?&](?:itemId|productId|productIdList)=(\d{6,20})/i) ||
        raw.match(/\/(?:dp|gp\/product|product)\/([A-Z0-9]{10})(?:[/?#]|$)/i) ||
        raw.match(/[?&]asin=([A-Z0-9]{10})/i);
      return m ? m[1] || '' : '';
    }

    /** Clave comparable de un ID externo (sin prefijo «AE-» ni espacios). */
    function aliIdKey(value) {
      return String(value || '')
        .trim()
        .toUpperCase()
        .replace(/^AE-?/, '');
    }

    /**
     * Estado de importación de cada producto del catálogo de afiliados.
     *  - DISCARDED: ocultado con la ✕ de la tabla (se conserva en la caché para
     *    poder recuperarlo con el filtro «Descartados»).
     *  - IMPORTED: ya existe en el catálogo Tradylor.
     *  - PENDING:  el resto.
     *
     * El «ya existe» NO depende sólo de la URL: las filas importadas antes de
     * persistir `sourceId` traen el enlace corto de afiliado (que cambia) o un
     * título reescrito por IA. Por eso se comparan varias claves en orden:
     *   1. sourceId / ID externo (ASIN · Item ID)
     *   2. URL canónica (host + ruta, sin parámetros de tracking)
     *   3. ID del artículo extraído de cualquier URL
     *   4. imagen única del producto (mismo CDN, sin placeholders)
     *   5. título normalizado (sin acentos ni puntuación)
     *   6. coincidencia difusa de títulos (≥3 tokens comunes y ≥60 % de solape)
     */
    function aliBuildEstadoIndex() {
      const index = new Map();
      const removed = acRemovedGet();

      // ── Índice del catálogo registrado (multi-clave) ──────────────────────
      const idKeys = new Set();
      const urlKeys = new Set();
      const itemIds = new Set();
      const imageKeys = new Set();
      const titleKeys = new Set();
      const catalogTokens = [];

      const imageCount = new Map();
      for (const item of currentProducts) {
        const img = aliNormKey(item.image || '');
        if (img && !img.includes('unsplash')) imageCount.set(img, (imageCount.get(img) || 0) + 1);
      }

      for (const item of currentProducts) {
        for (const rawId of [item.sourceId, item.asin]) {
          const key = aliIdKey(rawId);
          if (key) idKeys.add(key);
        }
        for (const url of [item.affiliateUrl, item.buyNowUrl, item.url]) {
          if (!url) continue;
          urlKeys.add(aliNormKey(url));
          const itemId = aliIdKey(aliItemIdOf(url));
          if (itemId) itemIds.add(itemId);
        }
        const img = aliNormKey(item.image || '');
        if (img && !img.includes('unsplash') && imageCount.get(img) === 1) imageKeys.add(img);
        const titleKey = aliNormTitle(item.title);
        if (titleKey) {
          titleKeys.add(`t:${titleKey}`);
          catalogTokens.push(aliTitleTokens(titleKey));
        }
      }

      for (const product of aliProducts) {
        if (removed.has(product.externalId)) {
          index.set(product.externalId, 'DISCARDED');
          continue;
        }

        const urls = [
          product.productUrl,
          product.extra && product.extra['Enlace de afiliado'],
          product.extra && product.extra['URL del producto'],
        ]
          .filter(Boolean)
          .map(String);

        const externalKey = aliIdKey(product.externalId);
        let imported =
          Boolean(externalKey && idKeys.has(externalKey)) ||
          urls.some((url) => urlKeys.has(aliNormKey(url))) ||
          urls.some((url) => {
            const itemId = aliIdKey(aliItemIdOf(url));
            return Boolean(itemId && itemIds.has(itemId));
          }) ||
          Boolean(product.image && imageKeys.has(aliNormKey(product.image)));

        if (!imported) {
          const aliTitleKey = aliNormTitle(product.title);
          if (aliTitleKey && titleKeys.has(`t:${aliTitleKey}`)) {
            imported = true;
          } else if (aliTitleKey && catalogTokens.length && currentProducts.length <= 20000) {
            // Último recurso: el título de la ficha fue reescrito por la IA de
            // enriquecimiento y ya no coincide literalmente con el de la tabla.
            const aliTokens = aliTitleTokens(aliTitleKey);
            const aliLen = aliTokens.length;
            if (aliLen >= 3) {
              const aliSet = new Set(aliTokens);
              for (const tokens of catalogTokens) {
                // Filtro barato: si las longitudes no pueden solaparse ≥60 %, no sigue.
                if (Math.abs(tokens.length - aliLen) / Math.max(tokens.length, aliLen) > 0.4) continue;
                let common = 0;
                const small = tokens.length <= aliTokens.length ? tokens : aliTokens;
                const big = tokens.length <= aliTokens.length ? aliTokens : tokens;
                const bigSet = big === aliTokens ? aliSet : new Set(big);
                for (const tok of small) if (bigSet.has(tok)) common++;
                if (common >= 3 && common / small.length >= 0.6) {
                  imported = true;
                  break;
                }
              }
            }
          }
        }

        index.set(product.externalId, imported ? 'IMPORTED' : 'PENDING');
      }
      return index;
    }

    /** Mapa externalId → estado (se recalcula sólo si cambió algo). */
    function aliEstadoIndex() {
      if (!aliEstadoCache) aliEstadoCache = aliBuildEstadoIndex();
      return aliEstadoCache;
    }

    function aliInvalidateEstado() {
      aliEstadoCache = null;
    }

    function showAliStatus(type, title, message) {
      if (!aliCatalogStatus) return;
      aliCatalogStatus.hidden = false;
      aliCatalogStatus.className = `status-alert alert-${type}`;
      if (aliCatalogStatusIcon) {
        aliCatalogStatusIcon.textContent = type === 'success' ? '✅' : type === 'error' ? '❌' : type === 'warning' ? '⚠️' : 'ℹ️';
      }
      if (aliCatalogStatusTitle) aliCatalogStatusTitle.textContent = title;
      if (aliCatalogStatusText) aliCatalogStatusText.textContent = message;
    }

    function aliRelTime(iso) {
      const then = new Date(iso).getTime();
      if (!Number.isFinite(then)) return 'sin fecha';
      const mins = Math.max(0, Math.round((Date.now() - then) / 60000));
      if (mins < 1) return 'ahora mismo';
      if (mins < 60) return `hace ${mins} min`;
      const hours = Math.round(mins / 60);
      if (hours < 24) return `hace ${hours} h`;
      return `hace ${Math.round(hours / 24)} d`;
    }

    /** «17/10/2026 02:10 · hace 3 h»; `null` si no hay fecha (la fila de detalle se omite). */
    function aliFmtDate(iso) {
      const time = iso ? new Date(iso).getTime() : NaN;
      if (!Number.isFinite(time)) return null;
      const label = new Date(time).toLocaleString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      return `${label} · ${aliRelTime(iso)}`;
    }

    function aliExtra(product, key) {
      const value = (product.extra || {})[key];
      return value == null || value === '' ? null : value;
    }

    function aliDiscount(product) {
      const raw = aliExtra(product, 'Descuento');
      if (raw) return `${String(raw).replace('%', '')}%`;
      const price = Number(product.price);
      const original = Number(product.originalPrice);
      if (price > 0 && original > price) return `${Math.round(((original - price) / original) * 100)}%`;
      return null;
    }

    /**
     * Barra de filtros (#aliFilters): 3 capas (presets → controles → panel
     * avanzado). Toda la lógica y el contrato `ProductFilterParams` viven en
     * `src/utils/aliCatalogFilters.ts`; aquí sólo se le aportan los datos del
     * panel (catálogo, estado de importación) y el repintado de la tabla.
     */

    function mountAliFilterBar() {
      const bridge = window.tradylorAliFilters;
      if (!bridge || typeof bridge.mountAliFilters !== 'function') {
        console.warn('[AliFilters] Módulo de filtros no disponible: la tabla se mostrará sin filtrar.');
        return null;
      }
      return bridge.mountAliFilters({
        getProducts: () => aliProducts,
        getEstadoIndex: () => aliEstadoIndex(),
        onChange: onAliFilterChange,
      });
    }

    /**
     * Filtra y ordena el catálogo completo con los filtros activos.
     * Se usa también para la selección masiva («todos los filtrados»).
     */
    function aliFilterApply() {
      if (aliFilterPanel) return aliFilterPanel.filter(aliProducts);
      return aliProducts.slice();
    }

    function aliUpdateSelectionUI(pageIds) {
      if (aliSelectionBar) aliSelectionBar.hidden = aliSelected.size === 0;
      if (aliSelCount) aliSelCount.textContent = `${aliSelected.size} seleccionado${aliSelected.size === 1 ? '' : 's'}`;
      const master = aliCatalogHost?.querySelector('[data-ac-checkall]');
      if (master && pageIds) {
        const checked = pageIds.filter((id) => aliSelected.has(id)).length;
        master.checked = checked > 0 && checked === pageIds.length;
        master.indeterminate = checked > 0 && checked < pageIds.length;
      }
    }

    function aliPagerHtml(page, pages, total, start, shown) {
      if (total === 0) return '';
      const info = `<span class="ac-page-info">Mostrando ${start + 1}–${start + shown} de ${total}</span>`;
      if (pages <= 1) return `<div class="ac-pager">${info}</div>`;
      const btn = (label, target, opts = {}) =>
        `<button type="button" class="ac-page-btn${opts.current ? ' is-current' : ''}" data-ac-page="${target}"${opts.disabled ? ' disabled' : ''}>${label}</button>`;
      const wanted = [...new Set([1, pages, page - 1, page, page + 1])]
        .filter((n) => n >= 1 && n <= pages)
        .sort((a, b) => a - b);
      const nums = [];
      wanted.forEach((n, index) => {
        if (index > 0 && n - wanted[index - 1] > 1) nums.push('<span class="ac-page-gap">…</span>');
        nums.push(btn(String(n), n, { current: n === page }));
      });
      return `<div class="ac-pager">${info}<div class="ac-page-nav">${btn('‹', page - 1, { disabled: page <= 1 })}${nums.join('')}${btn('›', page + 1, { disabled: page >= pages })}</div></div>`;
    }

    function renderAliCatalog() {
      if (!aliCatalogHost) return;
      if (aliFilters) aliFilters.hidden = aliProducts.length === 0;
      // La barra de acciones sólo oculta su bloque de alta: la derecha
      // (meta + Sincronizar) debe estar siempre accesible, también con
      // la caché vacía, para poder lanzar la primera sincronización.
      if (aliImportTools) aliImportTools.hidden = aliProducts.length === 0;
      if (btnAliMore) btnAliMore.hidden = aliProducts.length === 0;
      if (!aliProducts.length) {
        aliVisible = [];
        aliCatalogHost.innerHTML = '<div class="empty-dashboard">Sin productos en la caché. Pulsa «Sincronizar» para descargar el catálogo de las redes conectadas por primera vez.</div>';
        aliUpdateSelectionUI([]);
        return;
      }
      const filtered = aliFilterApply();
      if (!filtered.length) {
        aliVisible = [];
        aliCatalogHost.innerHTML = `
          <div class="empty-dashboard">
            <p>Ningún producto coincide con los filtros activos.</p>
            <button type="button" class="btn-secondary btn-sm" data-ac-clear-filters>Limpiar filtros</button>
          </div>`;
        aliUpdateSelectionUI([]);
        return;
      }
      const pages = Math.max(1, Math.ceil(filtered.length / ALI_PAGE_SIZE));
      if (aliPage > pages) aliPage = pages;
      const start = (aliPage - 1) * ALI_PAGE_SIZE;
      const slice = filtered.slice(start, start + ALI_PAGE_SIZE);
      aliVisible = slice;
      const pageIds = slice.map((product) => product.externalId);
      aliCatalogHost.innerHTML = `
        <div class="aff-table-wrap">
          <table class="aff-table">
            <thead>
              <tr>
                <th class="ac-th-check"><input type="checkbox" data-ac-checkall aria-label="Seleccionar la página actual" /></th>
                <th>Foto</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th class="aff-num">Precio</th>
                <th class="aff-num">Precio orig.</th>
                <th class="aff-num">Dto.</th>
                <th class="aff-num">Comisión %</th>
                <th class="aff-num">Comisión €</th>
                <th class="aff-num">Ventas</th>
                <th class="aff-num">Valoración</th>
                <th>Tienda</th>
                <th>Envío</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              ${slice
                .map((product, offset) => {
                  const index = offset;
                  const discount = aliDiscount(product);
                  const shop = aliExtra(product, 'Tienda') || aliExtra(product, 'Distribuidor');
                  const shippingDays = aliExtra(product, 'Días de envío');
                  const sales = product.popularity != null ? product.popularity : aliExtra(product, 'Ventas (30 días)');
                  const checked = aliSelected.has(product.externalId) ? ' checked' : '';
                  const estado = aliEstadoIndex().get(product.externalId);
                  const yaAnadido = estado === 'IMPORTED';
                  const estadoPill = estado === 'IMPORTED'
                    ? '<span class="ac-state is-imported">✓ en catálogo</span>'
                    : estado === 'DISCARDED'
                      ? '<span class="ac-state is-discarded">descartado</span>'
                      : '';
                  const addBtnClass = `btn-success btn-sm unified-import ali-import${yaAnadido ? ' is-added' : ''}`;
                  return `
                <tr class="aff-row" data-ac-row="${index}" data-ac-id="${escapeHtml(product.externalId)}" tabindex="0" aria-expanded="false">
                  <td class="ac-td-check"><input type="checkbox" data-ac-check="${index}" aria-label="Seleccionar producto" ${checked} /></td>
                  <td><span class="aff-thumb">${product.image ? `<img src="${escapeHtml(product.image)}" alt="" loading="lazy" />` : ''}</span></td>
                  <td class="aff-name">
                    <strong>${escapeHtml(product.title)}</strong>
                    <span>${escapeHtml(product.network)}${product.category ? ` · ${escapeHtml(product.category)}` : ''}${estadoPill}</span>
                  </td>
                  <td>${escapeHtml(product.category || '—')}</td>
                  <td class="aff-num">${money(product.price, product.currency)}</td>
                  <td class="aff-num">${product.originalPrice != null ? money(product.originalPrice, product.currency) : '—'}</td>
                  <td class="aff-num ac-discount">${discount ? escapeHtml(discount) : '—'}</td>
                  <td class="aff-num">${product.commissionRate != null ? `${product.commissionRate}%` : '—'}</td>
                  <td class="aff-num">${product.commissionAmount != null ? money(product.commissionAmount, product.currency) : '—'}</td>
                  <td class="aff-num">${sales != null ? sales : '—'}</td>
                  <td class="aff-num">${product.rating != null ? `${product.rating} / 5` : '—'}</td>
                  <td>${shop ? escapeHtml(shop) : '—'}</td>
                  <td>${shippingDays != null ? `${escapeHtml(shippingDays)} d` : product.shippingInfo ? escapeHtml(product.shippingInfo) : '—'}</td>
                    <td class="aff-actions">
                      <button type="button" class="${addBtnClass}" data-ac-import="${index}"${yaAnadido ? ' disabled title="Ya está en el catálogo"' : ''}>${yaAnadido ? 'Añadido' : 'Añadir'}</button>
                      <button type="button" class="btn-danger-ghost btn-sm" data-ac-remove="${index}" title="Quitar de la tabla">✕</button>
                      <button type="button" class="aff-caret" data-ac-toggle="${index}" aria-label="Ver todos los datos">▸</button>
                    </td>
                </tr>
                <tr class="aff-detail" data-ac-detail="${index}" hidden>
                  <td colspan="${ALI_COLS}"><dl class="aff-detail-grid">${productDetailRows(product)}</dl></td>
                </tr>`;
                })
                .join('')}
            </tbody>
          </table>
        </div>
        ${aliPagerHtml(aliPage, pages, filtered.length, start, slice.length)}`;
      aliUpdateSelectionUI(pageIds);
    }

    function setAliMeta(state) {
      if (!aliCatalogMeta) return;
      if (!state || !state.count) {
        aliCatalogMeta.textContent = 'Sin sincronizar';
        if (aliCatalogDanger) aliCatalogDanger.hidden = true;
        return;
      }
      aliCatalogMeta.textContent = `${state.count} productos · ${aliRelTime(state.syncedAt)}${state.stale ? ' · obsoleto' : ''}`;
      if (aliCatalogDanger) aliCatalogDanger.hidden = false;
    }

    /** GET de la caché: sólo lectura de disco en el servidor. */
    async function loadAliCatalog() {
      try {
        const res = await fetch('/api/admin/catalog', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) {
          if (aliCatalogHost) aliCatalogHost.innerHTML = '<div class="empty-dashboard">No se pudo leer la caché del catálogo.</div>';
          return data;
        }
        aliProducts = Array.isArray(data.products) ? data.products : [];
        aliPage = 1;
        aliInvalidateEstado();
        aliFilterPanel?.refresh();
        setAliMeta(data);
        renderAliCatalog();
        const connected = Array.isArray(data.networks) ? data.networks : [];
        // Poblar selector de red para sincronización individual
        if (aliSyncNetwork) {
          const currentValue = aliSyncNetwork.value;
          aliSyncNetwork.innerHTML = '<option value="">Todas las conectadas</option>' +
            connected.map((netId) => {
              const net = (networksCache || []).find((n) => n.id === netId);
              const label = net ? net.name : netId;
              return `<option value="${escapeHtml(netId)}">${escapeHtml(label)}</option>`;
            }).join('');
          if (currentValue && Array.from(aliSyncNetwork.options).some((o) => o.value === currentValue)) {
            aliSyncNetwork.value = currentValue;
          }
        }
        if (!connected.length) showAliStatus('warning', 'Sin redes conectadas', 'Guarda las credenciales de AliExpress, eBay u otras redes en «1. Redes conectadas» y pulsa «Validar» para poder sincronizar.');
        else if (!data.count) showAliStatus('warning', 'Caché vacía', 'Todavía no hay productos guardados. Pulsa «Sincronizar» para descargar el catálogo.');
        else if (data.stale) showAliStatus('warning', 'Caché obsoleta', `El catálogo guardado tiene más de 6 horas (${aliRelTime(data.syncedAt)}). Pulsa «Sincronizar» para refrescarlo.`);
        else showAliStatus('success', 'Caché al día', `${data.count} productos guardados, sincronizados ${aliRelTime(data.syncedAt)}.`);
        return data;
      } catch {
        if (aliCatalogHost) aliCatalogHost.innerHTML = '<div class="empty-dashboard">Fallo de red al leer la caché del catálogo.</div>';
        return null;
      }
    }

    /** POST de sincronización: valida si hace falta, consulta la TOP API y reescribe el JSON. */
    async function syncAliCatalogUI(networkId) {
      if (aliSyncing) return null;
      aliSyncing = true;
      const spinner = btnAliSync ? btnAliSync.querySelector('.btn-spinner') : null;
      const text = btnAliSync ? btnAliSync.querySelector('.btn-text') : null;
      const spinnerHeader = btnAliSyncHeader ? btnAliSyncHeader.querySelector('.btn-spinner') : null;
      const textHeader = btnAliSyncHeader ? btnAliSyncHeader.querySelector('.btn-text') : null;
      if (btnAliSync) btnAliSync.disabled = true;
      if (btnAliSyncHeader) btnAliSyncHeader.disabled = true;
      if (spinner) spinner.hidden = false;
      if (spinnerHeader) spinnerHeader.hidden = false;
      if (text) text.textContent = 'Sincronizando...';
      if (textHeader) textHeader.textContent = 'Sincronizando...';
      try {
        // Auto-validación solo si NO se ha seleccionado una red específica (comportamiento legacy)
        // Si se elige una red concreta, solo validamos esa red.
        const targetNetwork = networkId ?? aliSyncNetwork?.value ?? '';
        if (!targetNetwork) {
          // Modo "Todas": validar AliExpress si está en la lista (comportamiento legacy)
          const aliNet = (networksCache || []).find((n) => n.id === 'aliexpress');
          if (aliNet && aliNet.status !== 'connected') {
            showAliStatus('loading', 'Validando credenciales', 'Comprobando la conexión con AliExpress antes de sincronizar...');
            const check = await validateNetwork('aliexpress');
            const now = (check?.networks || []).find((n) => n.id === 'aliexpress');
            if (!now || now.status !== 'connected') {
              showAliStatus('error', 'AliExpress sin conectar', check?.message || 'Guarda y valida sus credenciales en «1. Redes conectadas».');
              return null;
            }
          }
        } else if (targetNetwork === 'aliexpress') {
          // Si se elige explícitamente AliExpress, validar solo esa red
          const aliNet = (networksCache || []).find((n) => n.id === 'aliexpress');
          if (aliNet && aliNet.status !== 'connected') {
            showAliStatus('loading', 'Validando credenciales', 'Comprobando la conexión con AliExpress...');
            const check = await validateNetwork('aliexpress');
            const now = (check?.networks || []).find((n) => n.id === 'aliexpress');
            if (!now || now.status !== 'connected') {
              showAliStatus('error', 'AliExpress sin conectar', check?.message || 'Guarda y valida sus credenciales en «1. Redes conectadas».');
              return null;
            }
          }
        }
        showAliStatus('loading', 'Sincronizando catálogo', targetNetwork
          ? `Consultando la API de ${targetNetwork}...`
          : 'Consultando las redes conectadas en curso (puede tardar unos segundos)...');
        const res = await fetch('/api/admin/catalog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ networkId: targetNetwork || undefined })
        });
        const data = await res.json();
        // El sync re-trae el catálogo completo: se levantan los descartes locales.
        if (data.ok) acRemovedSave(new Set());
        aliProducts = Array.isArray(data.products) ? data.products : [];
        aliPage = 1;
        aliInvalidateEstado();
        aliFilterPanel?.refresh();
        setAliMeta(data);
        renderAliCatalog();
        if (data.ok) showAliStatus('success', 'Catálogo sincronizado', `${data.count} productos guardados en el servidor.`);
        else showAliStatus('error', 'No se pudo sincronizar', data.message || 'No se pudo sincronizar.');
        return data;
      } catch {
        showAliStatus('error', 'Fallo de red', 'No se pudo contactar con el servidor para sincronizar.');
        return null;
      } finally {
        aliSyncing = false;
        if (btnAliSync) btnAliSync.disabled = false;
        if (btnAliSyncHeader) btnAliSyncHeader.disabled = false;
        if (spinner) spinner.hidden = true;
        if (spinnerHeader) spinnerHeader.hidden = true;
        if (text) text.textContent = 'Sincronizar';
        if (textHeader) textHeader.textContent = '🔄 Sincronizar';
      }
    }

    btnAliSync?.addEventListener('click', () => syncAliCatalogUI(aliSyncNetwork?.value || undefined));
    btnAliSyncHeader?.addEventListener('click', () => syncAliCatalogUI(aliSyncNetwork?.value || undefined));

/** «Cargar más»: pide al servidor las páginas 2-3 de cada keyword y
     *  amplía la caché (POST { append: true }); los rangos se recalculan. */
    btnAliMore?.addEventListener('click', async () => {
      if (aliSyncing) return;
      aliSyncing = true;
      if (btnAliMore) btnAliMore.disabled = true;
      if (btnAliSync) btnAliSync.disabled = true;
      if (btnAliSyncHeader) btnAliSyncHeader.disabled = true;
        showAliStatus('loading', 'Ampliando catálogo', 'Descargando más páginas de las redes conectadas (puede tardar)...');
        try {
          const targetNetwork = aliSyncNetwork?.value || '';
          const res = await fetch('/api/admin/catalog', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ append: true, networkId: targetNetwork || undefined }),
          });
        const data = await res.json();
        aliProducts = Array.isArray(data.products) ? data.products : [];
        aliPage = 1;
        aliInvalidateEstado();
        aliFilterPanel?.refresh();
        setAliMeta(data);
        renderAliCatalog();
        if (data.ok) showAliStatus('success', 'Catálogo ampliado', data.message || `${data.count} productos en total.`);
        else showAliStatus('error', 'No se pudo ampliar', data.message || 'No se pudo ampliar.');
      } catch {
        showAliStatus('error', 'Fallo de red', 'No se pudo contactar con el servidor para ampliar el catálogo.');
      } finally {
        aliSyncing = false;
        if (btnAliMore) btnAliMore.disabled = false;
        if (btnAliSync) btnAliSync.disabled = false;
        if (btnAliSyncHeader) btnAliSyncHeader.disabled = false;
      }
    });

    // Interacción de la tabla 3: paginación, selección, desplegable,
    // importación y fila
    aliCatalogHost?.addEventListener('click', async (event) => {
      const pageBtn = event.target.closest('[data-ac-page]');
      if (pageBtn) {
        const target = Number(pageBtn.dataset.acPage);
        if (Number.isFinite(target) && target >= 1) {
          aliPage = target;
          renderAliCatalog();
        }
        return;
      }

      const checkAll = event.target.closest('[data-ac-checkall]');
      if (checkAll) {
        const pageIds = aliVisible.map((product) => product.externalId);
        if (checkAll.checked) pageIds.forEach((id) => aliSelected.add(id));
        else pageIds.forEach((id) => aliSelected.delete(id));
        aliUpdateSelectionUI(pageIds);
        for (const box of aliCatalogHost.querySelectorAll('[data-ac-check]')) box.checked = checkAll.checked;
        return;
      }

      const rowCheck = event.target.closest('[data-ac-check]');
      if (rowCheck) {
        const product = aliVisible[Number(rowCheck.dataset.acCheck)];
        if (product) {
          if (rowCheck.checked) aliSelected.add(product.externalId);
          else aliSelected.delete(product.externalId);
        }
        const pageIds = aliVisible.map((p) => p.externalId);
        const master = aliCatalogHost.querySelector('[data-ac-checkall]');
        if (master) {
          const checked = pageIds.filter((id) => aliSelected.has(id)).length;
          master.checked = checked > 0 && checked === pageIds.length;
          master.indeterminate = checked > 0 && checked < pageIds.length;
        }
        aliUpdateSelectionUI();
        return;
      }

      const toggle = event.target.closest('[data-ac-toggle]');
      if (toggle) {
        const index = Number(toggle.dataset.acToggle);
        const row = aliCatalogHost.querySelector(`[data-ac-row="${index}"]`);
        const detail = aliCatalogHost.querySelector(`[data-ac-detail="${index}"]`);
        if (row && detail) {
          const open = detail.hidden;
          detail.hidden = !open;
          row.classList.toggle('is-open', open);
          row.setAttribute('aria-expanded', String(open));
        }
        return;
      }

      const clearFiltersBtn = event.target.closest('[data-ac-clear-filters]');
      if (clearFiltersBtn) {
        aliFilterPanel?.reset();
        return;
      }

      const removeBtn = event.target.closest('[data-ac-remove]');
      if (removeBtn) {
        const index = Number(removeBtn.dataset.acRemove);
        const product = aliVisible[index];
        if (!product) return;
        const removed = acRemovedGet();
        removed.add(product.externalId);
        acRemovedSave(removed);
        aliSelected.delete(product.externalId);
        // No se borra de la caché: pasa a estado DESCARTADO y desaparece de la
        // vista actual («Todos»), pero sigue siendo recuperable desde el filtro
        // «Estado › Descartados».
        aliInvalidateEstado();
        aliFilterPanel?.refresh(); // contador «n/total» y chips al día
        renderAliCatalog();
        return;
      }

      const importBtn = event.target.closest('[data-ac-import]');
      if (importBtn) {
        const product = aliVisible[Number(importBtn.dataset.acImport)];
        if (!product) return;
        // Sin navegación: sólo se guarda en el catálogo y se muestra un letrero
        // encima del botón.
        await importAliProductToCatalog(product, importBtn);
        return;
      }

      const row = event.target.closest('[data-ac-row]');
      if (row && !event.target.closest('a, button, input')) {
        const index = Number(row.dataset.acRow);
        const detail = aliCatalogHost.querySelector(`[data-ac-detail="${index}"]`);
        if (detail) {
          const open = detail.hidden;
          detail.hidden = !open;
          row.classList.toggle('is-open', open);
          row.setAttribute('aria-expanded', String(open));
        }
      }
    });

    // Filtros de la tabla 3: cualquier cambio reordena/refiltra y reinicia la página
    function onAliFilterChange() {
      aliPage = 1;
      renderAliCatalog();
    }
    // Montaje de la barra de filtros (#aliFilters). Los presets, el desplegable
    // «Más filtros», los chips y el botón de orden ya no se cablean aquí: viven
    // en src/utils/aliCatalogFilters.ts y sólo notifican vía `onChange`.
    aliFilterPanel = mountAliFilterBar();

    // Selección masiva: todos los filtrados, limpiar e importar en bloque
    btnAliSelAllFiltered?.addEventListener('click', () => {
      for (const product of aliFilterApply()) aliSelected.add(product.externalId);
      renderAliCatalog();
    });
    btnAliSelClear?.addEventListener('click', () => {
      aliSelected.clear();
      renderAliCatalog();
    });
    /**
     * Importación masiva compartida por «Importar seleccionados» (barra de
     * selección) y «Añadir seleccionados a categoría» (barra de acciones).
     * Cada alta lleva el nombre de la categoría elegida y, al terminar, los
     * IDs jerárquicos de los productos creados se fijan en una sola llamada.
     */
    async function aliImportProductsList(products, chosen) {
      let ok = 0;
      let failed = 0;
      let duplicates = 0;
      const createdIds = [];
      for (let i = 0; i < products.length; i++) {
        const product = products[i];
        showAliStatus('loading', 'Importando selección', `${i + 1}/${products.length}: ${String(product.title).slice(0, 70)}...`);
        const result = await importSingleProduct(product, null, chosen ? chosen.name : undefined);
        if (result.ok) {
          if (result.duplicate) duplicates++;
          else {
            ok++;
            const id = result.product && result.product.id;
            if (id) createdIds.push(id);
          }
        } else failed++;
      }
      let categorized = 0;
      if (chosen && chosen.categoryId && createdIds.length) {
        categorized = (await assignAliCategory(createdIds, chosen)) ? createdIds.length : 0;
      }
      return { ok, failed, duplicates, categorized };
    }

    /** Resultado de una importación masiva en el panel de estado. */
    function reportAliImport(result, title, notes = []) {
      const parts = [];
      if (result.ok) parts.push(`${result.ok} producto${result.ok === 1 ? '' : 's'} añadido${result.ok === 1 ? '' : 's'}`);
      if (result.duplicates) parts.push(`${result.duplicates} ya estaba${result.duplicates === 1 ? '' : 'n'} en el catálogo`);
      if (result.failed) parts.push(`${result.failed} con error`);
      const all = [...parts, ...notes.filter(Boolean)];
      showAliStatus(
        result.failed || result.duplicates ? 'warning' : 'success',
        title,
        `${all.join(' · ')}.`,
      );
    }

    btnAliSelImport?.addEventListener('click', async () => {
      if (aliImportingSelection) return;
      const selected = aliFilterApply().filter((product) => aliSelected.has(product.externalId));
      if (!selected.length) return;
      // Los que ya están en el catálogo se saltan: nunca se repiten altas.
      const states = aliEstadoIndex();
      const products = selected.filter((product) => states.get(product.externalId) !== 'IMPORTED');
      const skipped = selected.length - products.length;
      if (!products.length) {
        showAliStatus(
          'warning',
          'Ya están en el catálogo',
          `${skipped} producto${skipped === 1 ? '' : 's'} seleccionado${skipped === 1 ? '' : 's'} ya estaba${skipped === 1 ? '' : 'n'} añadido${skipped === 1 ? '' : 's'} al catálogo.`,
        );
        return;
      }
      const chosen = aliChosenCategory();
      aliImportingSelection = true;
      if (btnAliSelImport) btnAliSelImport.disabled = true;
      const result = await aliImportProductsList(products, chosen);
      aliImportingSelection = false;
      if (btnAliSelImport) btnAliSelImport.disabled = false;
      // El estado «IMPORTED» sale del catálogo registrado: se recarga y se
      // repinta la tabla para que las filas nuevas muestren «✓ en catálogo»
      // y su botón quede en «Añadido» (inactivo).
      if (result.ok || result.duplicates) {
        await reloadProductsTable();
        aliInvalidateEstado();
        renderAliCatalog();
      }
      reportAliImport(result, 'Importación de selección finalizada', [
        skipped ? `${skipped} omitido${skipped === 1 ? '' : 's'} por ya estar añadido${skipped === 1 ? '' : 's'}` : '',
        result.categorized && chosen ? `en «${chosen.name}»` : '',
      ]);
    });

    // ── Barra de acciones: alta directa en categorías/subcategorías existentes ─
    btnAliImportCat?.addEventListener('click', async () => {
      if (aliImportingSelection) return;
      const selected = aliFilterApply().filter((product) => aliSelected.has(product.externalId));
      if (!selected.length) {
        showAliStatus('warning', 'Sin selección', 'Marca en la tabla los productos que quieres añadir al catálogo.');
        return;
      }
      const chosen = aliChosenCategory();
      if (!chosen || !chosen.name) {
        showAliStatus('warning', 'Falta la categoría', 'Elige la categoría destino donde se añadirán los productos seleccionados.');
        if (aliCatAssign) aliCatAssign.focus();
        return;
      }
      if (!chosen.categoryId) {
        showAliStatus('warning', 'Categoría no encontrada', `No se encontró «${chosen.name}» en el catálogo: recarga el panel e inténtalo de nuevo.`);
        return;
      }
      // Los que ya están en el catálogo se saltan: nunca se repiten altas.
      const states = aliEstadoIndex();
      const products = selected.filter((product) => states.get(product.externalId) !== 'IMPORTED');
      const skipped = selected.length - products.length;
      if (!products.length) {
        showAliStatus(
          'warning',
          'Ya están en el catálogo',
          `${skipped} producto${skipped === 1 ? '' : 's'} seleccionado${skipped === 1 ? '' : 's'} ya estaba${skipped === 1 ? '' : 'n'} añadido${skipped === 1 ? '' : 's'} al catálogo.`,
        );
        return;
      }
      aliImportingSelection = true;
      if (btnAliImportCat) btnAliImportCat.disabled = true;
      if (btnAliSelImport) btnAliSelImport.disabled = true;
      const result = await aliImportProductsList(products, chosen);
      aliImportingSelection = false;
      if (btnAliImportCat) btnAliImportCat.disabled = false;
      if (btnAliSelImport) btnAliSelImport.disabled = false;
      if (result.ok || result.duplicates) {
        await reloadProductsTable();
        aliInvalidateEstado();
        aliSelected.clear();
        renderAliCatalog();
      }
      reportAliImport(result, 'Añadidos al catálogo', [
        `«${chosen.name}»${chosen.subName ? ` › «${chosen.subName}»` : ''}`,
        result.categorized ? `${result.categorized} con categoría asignada` : '',
        skipped ? `${skipped} omitido${skipped === 1 ? '' : 's'} por ya estar añadido${skipped === 1 ? '' : 's'}` : '',
      ]);
    });

    // ── Ocultar masivo: pasa a DESCARTADO (conservado en la caché) ────────────
    // No se borra nada: se recuperan con «En catálogo › Descartados» o con un
    // «Sincronizar», que levanta los descartos locales.
    btnAliHideSel?.addEventListener('click', () => {
      const ids = [...aliSelected];
      if (!ids.length) {
        showAliStatus('warning', 'Sin selección', 'Marca en la tabla los productos que quieres ocultar.');
        return;
      }
      const removed = acRemovedGet();
      for (const id of ids) removed.add(id);
      acRemovedSave(removed);
      aliSelected.clear();
      aliInvalidateEstado();
      aliFilterPanel?.refresh();
      renderAliCatalog();
      showAliStatus(
        'success',
        'Productos ocultos',
        `${ids.length} producto${ids.length === 1 ? '' : 's'} oculto${ids.length === 1 ? '' : 's'}: no se verán en la tabla ni se añadirán al catálogo. Recupéralos con «En catálogo › Descartados».`,
      );
    });

    // ── Borrar seleccionados del catálogo de AliExpress (peligro) ──────────────
    btnAliDeleteSelected?.addEventListener('click', async () => {
      const ids = [...aliSelected];
      if (!ids.length) {
        showAliStatus('warning', 'Sin selección', 'Marca en la tabla los productos que quieres borrar del catálogo.');
        return;
      }
      if (!confirm(`¿Borrar ${ids.length} producto(s) seleccionado(s) del catálogo de AliExpress? Esta acción NO se puede deshacer (salvo volviendo a sincronizar).`)) return;
      if (btnAliDeleteSelected) btnAliDeleteSelected.disabled = true;
      try {
        const res = await fetch('/api/admin/aliexpress/catalog', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ externalIds: ids }),
        });
        const data = await res.json();
        if (data.success) {
          showAliStatus('success', 'Productos borrados', data.message);
          aliSelected.clear();
          await loadAliCatalog();
        } else {
          showAliStatus('error', 'No se pudo borrar', data.message);
        }
      } catch (err) {
        console.error('Error borrando seleccionados:', err);
        showAliStatus('error', 'Error de red', 'No se pudo contactar con el servidor.');
      } finally {
        if (btnAliDeleteSelected) btnAliDeleteSelected.disabled = false;
      }
    });

    // ── Borrar TODO el catálogo de afiliados (TODAS las redes) ───────────────────────
    btnAliDeleteAll?.addEventListener('click', async () => {
      if (!confirm('¿Estás seguro de que quieres vaciar COMPLETAMENTE el catálogo de afiliados? Se eliminarán TODOS los productos de TODAS las redes y no se podrán recuperar (salvo volviendo a sincronizar).')) return;
      if (btnAliDeleteAll) btnAliDeleteAll.disabled = true;
      try {
        const res = await fetch('/api/admin/catalog', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (data.success) {
          showAliStatus('success', 'Catálogo vaciado', data.message);
          aliProducts = [];
          aliPage = 1;
          aliSelected.clear();
          aliInvalidateEstado();
          if (aliCatalogHost) {
            aliCatalogHost.innerHTML = '<div class="empty-dashboard">Catálogo vaciado. Pulsa «Sincronizar» para descargar el catálogo de las redes conectadas.</div>';
          }
          if (aliFilters) aliFilters.hidden = false;
          if (aliImportTools) aliImportTools.hidden = false;
          if (btnAliMore) btnAliMore.hidden = true;
          if (aliCatalogMeta) aliCatalogMeta.textContent = 'Sin sincronizar';
          if (aliCatalogDanger) aliCatalogDanger.hidden = true;
          aliUpdateSelectionUI([]);
        } else {
          showAliStatus('error', 'No se pudo vaciar', data.message);
        }
      } catch (err) {
        console.error('Error vaciando catálogo de afiliados:', err);
        showAliStatus('error', 'Error de red', 'No se pudo contactar con el servidor.');
      } finally {
        if (btnAliDeleteAll) btnAliDeleteAll.disabled = false;
      }
    });

    // Primera carga: sólo lectura de la caché (sin llamadas a la API)
    loadAliCatalog();

// =========================================================================
    // 6. GESTIÓN DE CATEGORÍAS — tabla jerárquica
    //    - Categorías raíz y subcategorías creadas/editadas por el admin
    //    - Formulario con padre opcional (vacío = categoría raíz)
    //    - Tabla jerárquica con acciones: añadir subcategoría, editar, eliminar
    //    - Botón de reclasificación para reasignar productos a la taxonomía
    // =========================================================================
    const categoryForm = document.getElementById('categoryForm');
    const catEditingSlug = document.getElementById('catEditingSlug');
    const catName = document.getElementById('catName');
    const catIcon = document.getElementById('catIcon');
    const catKeywords = document.getElementById('catKeywords');
    const catParent = document.getElementById('catParent');
    const btnSaveCategory = document.getElementById('btnSaveCategory');
    const btnSaveCategoryLabel = document.getElementById('btnSaveCategoryLabel');
    const btnCancelCategory = document.getElementById('btnCancelCategory');
    const categoryFormTitle = document.getElementById('categoryFormTitle');
    const categoryStatus = document.getElementById('categoryStatus');
    const categoryStatusIcon = document.getElementById('categoryStatusIcon');
    const categoryStatusTitle = document.getElementById('categoryStatusTitle');
    const categoryStatusText = document.getElementById('categoryStatusText');
    const categoryTableBody = document.getElementById('categoryTableBody');
    const btnMigrateCategories = document.getElementById('btnMigrateCategories');
    const btnMigratePreview = document.getElementById('btnMigratePreview');
    const migrateStatus = document.getElementById('migrateStatus');
    const migrateStatusIcon = document.getElementById('migrateStatusIcon');
    const migrateStatusTitle = document.getElementById('migrateStatusTitle');
    const migrateStatusText = document.getElementById('migrateStatusText');
    const migrateManualBox = document.getElementById('migrateManualBox');
    const migrateManualTitle = document.getElementById('migrateManualTitle');
    const migrateManualDesc = document.getElementById('migrateManualDesc');
    const migrateManualList = document.getElementById('migrateManualList');
    const migrateManualCount = document.getElementById('migrateManualCount');
    const btnMigrateManualClear = document.getElementById('btnMigrateManualClear');
    const btnMigrateManualRun = document.getElementById('btnMigrateManualRun');

    function showCategoryStatus(type, title, message) {
      if (!categoryStatus) return;
      categoryStatus.hidden = false;
      categoryStatus.className = `status-alert alert-${type}`;
      if (categoryStatusIcon) {
        categoryStatusIcon.textContent = type === 'success' ? '✅' : type === 'error' ? '❌' : type === 'warning' ? '⚠️' : 'ℹ️';
      }
      if (categoryStatusTitle) categoryStatusTitle.textContent = title;
      if (categoryStatusText) categoryStatusText.textContent = message;
    }

    function showMigrateStatus(type, title, message) {
      if (!migrateStatus) return;
      migrateStatus.hidden = false;
      migrateStatus.className = `status-alert alert-${type}`;
      if (migrateStatusIcon) {
        migrateStatusIcon.textContent = type === 'success' ? '✅' : type === 'error' ? '❌' : type === 'warning' ? '⚠️' : 'ℹ️';
      }
      if (migrateStatusTitle) migrateStatusTitle.textContent = title;
      if (migrateStatusText) migrateStatusText.textContent = message;
    }

    /**
     * Rellena el filtro de subcategoría de la tabla de productos con las
     * subcategorías de la raíz elegida en el filtro de categoría.
     * El value de cada opción es el id de categories.json (el filtro compara
     * por id con fallback por nombre).
     */
    function syncSubcatFilter() {
      const sel = document.getElementById('prodSubcatAssign');
      if (!sel) return;
      const current = sel.value;
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const catFilter = document.getElementById('prodFCat');
      const parentName = catFilter && 'value' in catFilter ? String(catFilter.value || '').trim() : '';
      const parent = parentName
        ? allCats.find((category) => !category.parentId && (category.name === parentName || category.id === parentName))
        : null;
      const subs = allCats.filter((category) => category.parentId && (!parent || category.parentId === parent.id));
      const optionLabel = (category) => {
        if (parent) return `${category.icon ? `${category.icon} ` : ''}${category.name}`;
        const owner = allCats.find((candidate) => candidate.id === category.parentId);
        return owner ? `${owner.name} › ${category.name}` : category.name;
      };
      sel.innerHTML =
        '<option value="">Todas las subcategorías</option>' +
        subs.map((category) => `<option value="${escapeHtml(category.id)}">${escapeHtml(optionLabel(category))}</option>`).join('');
      if (current && Array.from(sel.options).some((option) => option.value === current)) sel.value = current;
    }

    /** Vuelca las categorías raíz en datalist + selects de Afiliados y formulario. */
    function syncCategorySelects(categories) {
      const roots = categories.filter((category) => !category.parentId);

      const listDatalist = document.getElementById('categoryList');
      if (listDatalist) {
        listDatalist.innerHTML = categories
          .map((category) => `<option value="${escapeHtml(category.name)}"></option>`)
          .join('');
      }

      // Select de la barra de selección de la tabla: asignar categoría en masa.
      const catAssign = document.getElementById('prodCatAssign');
      if (catAssign) {
        const current = catAssign.value;
        catAssign.innerHTML =
          '<option value="">Categoría destino…</option>' +
          roots.map((category) => `<option value="${escapeHtml(category.name)}">${escapeHtml(category.icon || '')} ${escapeHtml(category.name)}</option>`).join('');
        if (current) catAssign.value = current;
      }

      // Filtro de categoría de la tabla del catálogo.
      const prodFCatSel = document.getElementById('prodFCat');
      if (prodFCatSel) {
        const current = prodFCatSel.value;
        prodFCatSel.innerHTML =
          '<option value="">Todas</option>' +
          roots.map((category) => `<option value="${escapeHtml(category.name)}">${escapeHtml(category.name)}</option>`).join('');
        if (current) prodFCatSel.value = current;
      }

      // Selector de categoría padre del formulario de Categorías: vacío = raíz.
      const catParentSel = document.getElementById('catParent');
      if (catParentSel) {
        const current = catParentSel.value;
        const editingSlug = catEditingSlug ? catEditingSlug.value.trim() : '';
        const editingId = editingSlug ? (categories.find((category) => category.slug === editingSlug)?.id || '') : '';
        catParentSel.innerHTML =
          '<option value="">Ninguna (categoría raíz)</option>' +
          roots
            .filter((category) => category.id !== editingId)
            .map((category) => `<option value="${escapeHtml(category.id)}">${escapeHtml(category.icon || '')} ${escapeHtml(category.name)}</option>`)
            .join('');
        if (current) catParentSel.value = current;
      }

      // Categoría destino del bloque de acciones de Afiliados.
      const aliCatSel = document.getElementById('aliCatAssign');
      if (aliCatSel) {
        const current = aliCatSel.value;
        aliCatSel.innerHTML =
          '<option value="">Categoría destino…</option>' +
          roots.map((category) => `<option value="${escapeHtml(category.name)}">${escapeHtml(category.icon || '')} ${escapeHtml(category.name)}</option>`).join('');
        if (current) aliCatSel.value = current;
      }

      syncSubcatFilter();
      syncSubcatAssign();
      syncAliSubcatAssign();
      syncProductFormSubcategories();
      if (currentProducts.length) prodFilterApply();
    }

    /**
     * Rellena el selector de subcategoría del formulario «Añadir producto»
     * en cascada con la categoría elegida (si no hay categoría, muestra todas).
     */
    function syncProductFormSubcategories() {
      const sel = document.getElementById('prodSubcategory');
      if (!sel) return;
      const current = String(sel.value || '');
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const rootName = String(prodCategory?.value || '').trim();
      const root = rootName ? allCats.find((c) => !c.parentId && c.name === rootName) : null;
      const subs = allCats.filter((c) => c.parentId && (!root || c.parentId === root.id));
      sel.innerHTML =
        '<option value="">Sin subcategoría</option>' +
        subs
          .map((c) => `<option value="${escapeHtml(c.name)}">${escapeHtml(c.icon ? c.icon + ' ' : '')}${escapeHtml(c.name)}</option>`)
          .join('');
      if (current && Array.from(sel.options).some((o) => o.value === current)) sel.value = current;
    }
    prodCategory?.addEventListener('input', syncProductFormSubcategories);
    prodCategory?.addEventListener('change', syncProductFormSubcategories);

    /** Renderiza la tabla jerárquica: raíces y sus subcategorías. */
    function renderCategoryList(categories) {
      const tbody = categoryTableBody;
      if (!tbody) return;

      if (!categories.length) {
        tbody.innerHTML = '<tr class="empty-row"><td colspan="5" style="text-align: center; padding: 2rem; color: var(--color-text-dim);">No hay categorías creadas aún.</td></tr>';
        return;
      }

      const roots = categories.filter((category) => !category.parentId);
      const subcategoriesOf = (parentId) => categories.filter((category) => category.parentId === parentId);

      const buildRow = (category, isSub, parentName) => {
        const keywords = (category.keywords || []).slice(0, 5);
        const productCount = category.productCount ?? 0;
        const icon = escapeHtml(category.icon || '📦');
        const name = escapeHtml(category.name);
        const slug = escapeHtml(category.slug);

        const keywordsHtml = keywords.length === 0
          ? '<span class="cat-kw-empty">(sin palabras clave)</span>'
          : keywords.map((kw) => `<span class="cat-kw">${escapeHtml(kw)}</span>`).join('');

        const hierarchyIcon = isSub
          ? '<span class="cat-hierarchy-indent" aria-hidden="true">├─</span>'
          : '';

        const hierarchyLabel = isSub && parentName
          ? `<span class="cat-parent-badge">${escapeHtml(parentName)}</span>`
          : '';

        const actionsHtml = `
          <div class="cat-actions">
            ${!isSub ? `<button type="button" class="btn-ghost btn-xs cat-add-sub" data-slug="${slug}" title="Añadir subcategoría" aria-label="Añadir subcategoría a ${name}">➕</button>` : ''}
            <button type="button" class="btn-ghost btn-xs cat-edit" data-slug="${slug}" title="Editar" aria-label="Editar ${name}">✏️</button>
            <button type="button" class="btn-ghost btn-xs btn-danger-ghost cat-delete" data-slug="${slug}" data-name="${name}" title="Eliminar" aria-label="Eliminar ${name}">🗑️</button>
          </div>
        `;

        return `
          <tr class="cat-row${isSub ? ' is-subcategory' : ''}" data-slug="${slug}">
            <td class="cat-icon-cell" aria-hidden="true">${icon}</td>
            <td class="cat-name-cell">
              <div class="cat-name-wrap">
                <span class="cat-name-main">${hierarchyIcon}${hierarchyLabel}${name}</span>
                <span class="cat-slug">${slug}</span>
              </div>
            </td>
            <td class="cat-keywords-cell">${keywordsHtml}</td>
            <td class="cat-count-cell" style="text-align: center;">${productCount}</td>
            <td class="cat-actions-cell">${actionsHtml}</td>
          </tr>
        `;
      };

      const rows = [];
      for (const root of roots) {
        rows.push(buildRow(root, false, ''));
        for (const sub of subcategoriesOf(root.id)) rows.push(buildRow(sub, true, root.name));
      }
      // Subcategorías huérfanas (padre eliminado fuera del panel): al final.
      for (const sub of categories.filter((category) => category.parentId && !roots.some((root) => root.id === category.parentId))) {
        rows.push(buildRow(sub, true, ''));
      }

      tbody.innerHTML = rows.join('');
    }

    async function loadCategories() {
      try {
        const res = await fetch('/api/categories', { cache: 'no-store' });
        const data = await res.json();
        if (data.success && Array.isArray(data.categories)) {
          categoriesCache = data.categories;
          // La tabla se repinta SIEMPRE: si la sincronización de los selectores
          // falla, la lista de categorías sigue siendo visible.
          renderCategoryList(categoriesCache);
          try {
            syncCategorySelects(categoriesCache);
          } catch (err) {
            console.error('[Admin Categorías] Error al sincronizar los selectores:', err);
          }
        } else if (categoryTableBody) {
          categoryTableBody.innerHTML = '<tr class="empty-row"><td colspan="5" style="text-align: center; padding: 2rem; color: var(--color-text-dim);">No se pudieron cargar las categorías.</td></tr>';
        }
      } catch {
        if (categoryTableBody) {
          categoryTableBody.innerHTML = '<tr class="empty-row"><td colspan="5" style="text-align: center; padding: 2rem; color: var(--color-text-dim);">No se pudieron cargar las categorías.</td></tr>';
        }
      }
    }

    function resetCategoryForm() {
      if (catEditingSlug) catEditingSlug.value = '';
      if (catName) catName.value = '';
      if (catIcon) catIcon.value = '';
      if (catKeywords) catKeywords.value = '';
      if (catParent) catParent.value = '';
      if (btnSaveCategoryLabel) btnSaveCategoryLabel.textContent = 'Crear categoría';
      if (categoryFormTitle) categoryFormTitle.textContent = '1. Nueva categoría';
      if (btnCancelCategory) btnCancelCategory.hidden = true;
    }

    // Toggle del formulario colapsable
    const formToggle = document.getElementById('categoryFormToggle');
    const formPanel = document.getElementById('categoryFormPanel');
    const toggleBtn = document.getElementById('btnToggleCategoryForm');
    const chevron = document.getElementById('categoryFormChevron');
    const toggleLabel = document.getElementById('categoryFormToggleLabel');

    function toggleCategoryForm(open) {
      if (!formPanel) return;
      const isOpen = typeof open === 'boolean' ? open : formPanel.hidden;
      formPanel.hidden = !isOpen;
      if (chevron) chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
      if (toggleLabel) toggleLabel.textContent = isOpen ? 'Ocultar' : 'Mostrar';
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (formToggle) formToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }

    formToggle?.addEventListener('click', (event) => {
      if (event.target.closest('button')) return;
      toggleCategoryForm();
    });
    toggleBtn?.addEventListener('click', () => toggleCategoryForm());

    categoryForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = catName ? catName.value.trim() : '';
      if (!name) {
        showCategoryStatus('warning', 'Nombre requerido', 'Escribe un nombre para la categoría.');
        return;
      }

      const editingSlug = catEditingSlug ? catEditingSlug.value.trim() : '';
      // Categoría padre seleccionada → la categoría se guarda como SUBCATEGORÍA.
      // Sin padre → se crea (o se mantiene) como categoría RAÍZ.
      const parentId = catParent && 'value' in catParent ? String(catParent.value || '').trim() : '';
      if (editingSlug && parentId) {
        const self = Array.isArray(categoriesCache) ? categoriesCache.find((category) => category.slug === editingSlug) : undefined;
        if (self && self.id === parentId) {
          showCategoryStatus('warning', 'Padre no válido', 'Una categoría no puede ser padre de sí misma.');
          return;
        }
      }
      const payload = {
        name,
        icon: catIcon ? catIcon.value.trim() : '',
        keywords: catKeywords
          ? catKeywords.value.split(',').map((k) => k.trim()).filter(Boolean)
          : [],
        parentId: parentId || null,
      };

      if (btnSaveCategory) btnSaveCategory.disabled = true;
      showCategoryStatus('loading', editingSlug ? 'Actualizando...' : 'Creando...', 'Escribiendo en src/data/categories.json...');

      try {
        const isEdit = Boolean(editingSlug);
        const res = await fetch(isEdit ? `/api/categories/${encodeURIComponent(editingSlug)}` : '/api/categories', {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (data.success) {
          const successTitle = isEdit ? 'Categoría actualizada' : parentId ? 'Subcategoría creada' : 'Categoría creada';
          showCategoryStatus('success', successTitle, data.message);
          resetCategoryForm();
          await loadCategories();
        } else {
          showCategoryStatus('error', isEdit ? 'Error al actualizar' : 'Error al crear', data.message || 'No se pudo guardar la categoría.');
        }
      } catch {
        showCategoryStatus('error', 'Error de red', 'No se pudo enviar la solicitud al servidor.');
      } finally {
        if (btnSaveCategory) btnSaveCategory.disabled = false;
      }
    });

    btnCancelCategory?.addEventListener('click', () => {
      resetCategoryForm();
      if (categoryStatus) categoryStatus.hidden = true;
    });

    // Al elegir categoría padre en el formulario, el modo pasa a subcategoría.
    catParent?.addEventListener('change', () => {
      if (catEditingSlug && catEditingSlug.value) return;
      const parentId = catParent && 'value' in catParent ? String(catParent.value || '').trim() : '';
      const parent = parentId && Array.isArray(categoriesCache)
        ? categoriesCache.find((category) => category.id === parentId)
        : undefined;
      if (parent) {
        if (categoryFormTitle) categoryFormTitle.textContent = `1. Nueva subcategoría de «${parent.name}»`;
        if (btnSaveCategoryLabel) btnSaveCategoryLabel.textContent = 'Crear subcategoría';
        if (btnCancelCategory) btnCancelCategory.hidden = false;
      } else {
        if (categoryFormTitle) categoryFormTitle.textContent = '1. Nueva categoría';
        if (btnSaveCategoryLabel) btnSaveCategoryLabel.textContent = 'Crear categoría';
        if (btnCancelCategory) btnCancelCategory.hidden = true;
      }
    });

    // Delegación de eventos en la tabla de categorías
    categoryTableBody?.addEventListener('click', async (event) => {
      const target = event.target;

      // «➕»: prepara el formulario en modo subcategoría de la raíz.
      const addSubBtn = target.closest('.cat-add-sub');
      if (addSubBtn) {
        const slug = addSubBtn.dataset.slug;
        const root = Array.isArray(categoriesCache) ? categoriesCache.find((category) => category.slug === slug) : undefined;
        if (!root) return;
        if (catEditingSlug) catEditingSlug.value = '';
        if (catName) catName.value = '';
        if (catIcon) catIcon.value = '';
        if (catKeywords) catKeywords.value = '';
        if (catParent) catParent.value = root.id;
        if (btnSaveCategoryLabel) btnSaveCategoryLabel.textContent = 'Crear subcategoría';
        if (categoryFormTitle) categoryFormTitle.textContent = `1. Nueva subcategoría de «${root.name}»`;
        if (btnCancelCategory) btnCancelCategory.hidden = false;
        if (formPanel && formPanel.hidden) {
          toggleCategoryForm(true);
        }
        showCategoryStatus('loading', 'Modo subcategoría', `Se guardará vinculada a «${root.name}» en categories.json.`);
        categoryForm?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        catName?.focus();
        return;
      }

      // «✏️»: editar la categoría (raíz o subcategoría).
      const editBtn = target.closest('.cat-edit');
      if (editBtn) {
        const slug = editBtn.dataset.slug;
        const category = categoriesCache.find((c) => c.slug === slug);
        if (!category) return;
        if (catEditingSlug) catEditingSlug.value = category.slug;
        if (catName) catName.value = category.name;
        if (catIcon) catIcon.value = category.icon || '';
        if (catKeywords) catKeywords.value = (category.keywords || []).join(', ');
        if (catParent) catParent.value = category.parentId || '';
        if (btnSaveCategoryLabel) btnSaveCategoryLabel.textContent = 'Guardar cambios';
        if (categoryFormTitle) categoryFormTitle.textContent = `1. Editando "${category.name}"${category.parentId ? ' (subcategoría)' : ''}`;
        if (btnCancelCategory) btnCancelCategory.hidden = false;
        if (formPanel && formPanel.hidden) {
          toggleCategoryForm(true);
        }
        showCategoryStatus('loading', 'Modo edición', 'Ajusta los campos y pulsa "Guardar cambios".');
        categoryForm?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        catName?.focus();
        return;
      }

      // «🗑️»: eliminar la categoría (en cascada sus subcategorías).
      const deleteBtn = target.closest('.cat-delete');
      if (deleteBtn) {
        const slug = deleteBtn.dataset.slug;
        const name = deleteBtn.dataset.name;
        if (!slug) return;
        const targetCat = Array.isArray(categoriesCache) ? categoriesCache.find((c) => c.slug === slug) : undefined;
        const childCount = targetCat && !targetCat.parentId
          ? categoriesCache.filter((c) => c.parentId === targetCat.id).length
          : 0;
        const confirmed = window.confirm(
          `¿Eliminar la categoría "${name}"?${childCount ? ` Se eliminarán también sus ${childCount} subcategoría(s).` : ''} Los productos existentes conservan su texto de categoría.`
        );
        if (!confirmed) return;

        deleteBtn.disabled = true;
        try {
          const res = await fetch(`/api/categories/${encodeURIComponent(slug)}`, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            showCategoryStatus('success', 'Categoría eliminada', data.message);
            if (catEditingSlug && catEditingSlug.value === slug) resetCategoryForm();
            await loadCategories();
          } else {
            showCategoryStatus('error', 'Error al eliminar', data.message || 'No se pudo eliminar la categoría.');
            deleteBtn.disabled = false;
          }
        } catch {
          showCategoryStatus('error', 'Error de red', 'No se pudo enviar la solicitud al servidor.');
          deleteBtn.disabled = false;
        }
        return;
      }
    });

    // Migración de categorías: vista previa (dry-run) + ejecución real.

    /**
     * Dibuja la lista de productos que el matching automático no supo
     * clasificar, con un selector de categoría raíz por producto. La
     * asignación manual tiene prioridad sobre el matching (body.manual).
     */
    function renderMigrateManualList(report) {
      if (!migrateManualBox || !migrateManualList) return;
      const roots = Array.isArray(report?.roots) ? report.roots : [];
      const items = Array.isArray(report?.productsWithoutMatchList) ? report.productsWithoutMatchList : [];
      const total = Number(report?.productsWithoutMatch ?? items.length) || 0;

      if (!items.length) {
        migrateManualBox.hidden = true;
        migrateManualList.innerHTML = '';
        updateMigrateManualCount();
        return;
      }

      const options = roots
        .map(
          (r) =>
            `<option value="${escapeHtml(r.id)}">${escapeHtml(r.icon ? r.icon + ' ' : '')}${escapeHtml(r.name)}</option>`
        )
        .join('');

      migrateManualList.innerHTML = items
        .map(
          (p) => `
          <div class="migrate-manual-row" data-manual-id="${escapeHtml(p.id)}">
            <div class="migrate-manual-info">
              <span class="migrate-manual-name" title="${escapeHtml(p.title)}">${escapeHtml(p.title)}</span>
              <span class="migrate-manual-meta">ID: ${escapeHtml(p.id)}${p.currentCategory ? ' · Actual: ' + escapeHtml(p.currentCategory) : ''}</span>
            </div>
            <select class="migrate-manual-select" data-manual-id="${escapeHtml(p.id)}" aria-label="Categoría raíz del producto">
              <option value="">— Sin cambio (automático) —</option>
              ${options}
            </select>
          </div>`
        )
        .join('');

      if (migrateManualTitle) migrateManualTitle.textContent = `Reasignación manual (${items.length})`;
      if (migrateManualDesc) {
        migrateManualDesc.textContent =
          total > items.length
            ? `El matching automático no classificó ${total} productos (se muestran los primeros ${items.length}). Elige la categoría raíz de cada uno: la asignación manual tiene prioridad sobre el matching.`
            : 'Productos sin coincidencia automática. Elige la categoría raíz de cada uno: la asignación manual tiene prioridad sobre el matching.';
      }
      migrateManualBox.hidden = false;
      updateMigrateManualCount();
    }

    /** Recoge el mapa { idProducto → idRaíz } de los selects con valor. */
    function collectMigrateManualMap() {
      const map = {};
      if (!migrateManualList) return map;
      migrateManualList.querySelectorAll('select.migrate-manual-select').forEach((sel) => {
        const id = String(sel.getAttribute('data-manual-id') || '').trim();
        const rootId = String(sel.value || '').trim();
        if (id && rootId) map[id] = rootId;
      });
      return map;
    }

    /** Actualiza el contador de asignaciones manuales seleccionadas. */
    function updateMigrateManualCount() {
      if (!migrateManualCount) return;
      const count = Object.keys(collectMigrateManualMap()).length;
      migrateManualCount.textContent = `${count} seleccionado${count === 1 ? '' : 's'}`;
    }

    migrateManualList?.addEventListener('change', (event) => {
      if (event.target && event.target.closest('.migrate-manual-select')) updateMigrateManualCount();
    });

    btnMigrateManualClear?.addEventListener('click', () => {
      migrateManualList?.querySelectorAll('select.migrate-manual-select').forEach((sel) => {
        sel.value = '';
      });
      updateMigrateManualCount();
    });

    // Migración de categorías: vista previa (dry-run) + ejecución real.
    async function runCategoryMigration(dryRun, manual, triggerButton) {
      const button = triggerButton || (dryRun ? btnMigratePreview : btnMigrateCategories);
      const spinner = button?.querySelector('.btn-spinner');
      const text = button?.querySelector('.btn-text');
      const originalText = text ? text.textContent : '';
      if (button) button.disabled = true;
      if (spinner) spinner.hidden = false;
      if (text) text.textContent = dryRun ? 'Simulando…' : 'Migrando…';

      showMigrateStatus(
        'loading',
        dryRun ? 'Simulando migración…' : 'Ejecutando migración…',
        dryRun
          ? 'Calculando el plan (sin escribir nada en el servidor).'
          : 'Reasignando productos, limpiando categorías huérfanas y actualizando contadores. Se guarda una copia de seguridad antes de escribir.'
      );

      try {
        const res = await fetch('/api/admin/migrate-categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            dryRun,
            ...(manual && Object.keys(manual).length ? { manual } : {}),
          }),
        });
        const data = await res.json();

        if (data.success) {
          const manualCount = Object.keys(manual || {}).length;
          const lines = [
            `Productos reasignados: ${data.productsReassigned}`,
            `Productos sin cambios: ${data.productsUnchanged}`,
            `Productos sin coincidencia (van a la categoría por defecto): ${data.productsWithoutMatch ?? 0}${data.productsWithoutMatchSample?.length ? ' (' + data.productsWithoutMatchSample.slice(0, 5).join(', ') + ')' : ''}`,
            ...(manualCount ? [`Asignaciones manuales aplicadas: ${manualCount}${data.manualApplied?.length ? ' (' + data.manualApplied.slice(0, 5).join(', ') + ')' : ''}`] : []),
            `Categorías eliminadas: ${(data.rootCategoriesRemoved?.length ?? 0) + (data.subcategoriesRemoved?.length ?? 0)} (la reclasificación no borra ninguna)`,
            `Copia de seguridad: ${data.backupDir ?? '(no se creó: simulación)'}`,
            `Duración: ${Math.round(data.durationMs / 1000)}s`,
          ];
          showMigrateStatus(
            'success',
            dryRun ? '👁 Vista previa de la reclasificación' : '✅ Reclasificación completada',
            lines.join('\n')
          );
          if (dryRun) {
            // La vista previa deja preparada la reasignación manual de los
            // productos que el matching no supo clasificar.
            renderMigrateManualList(data);
          } else {
            migrateManualBox.hidden = true;
            migrateManualList.innerHTML = '';
            updateMigrateManualCount();
            await loadCategories();
            await reloadProductsTable();
          }
        } else {
          showMigrateStatus('error', 'Error en migración', data.errors?.join('\n') || 'Error desconocido');
        }
      } catch (err) {
        console.error('[MigrateCategories] Error:', err);
        showMigrateStatus('error', 'Error de red', 'No se pudo contactar con /api/admin/migrate-categories');
      } finally {
        if (button) button.disabled = false;
        if (spinner) spinner.hidden = true;
        if (text) text.textContent = originalText;
      }
    }

    /** Confirmación común de la reclasificación (indica cuántas asignaciones manuales van). */
    function confirmMigrate(manualCount) {
      const manualLine = manualCount
        ? `\n4. Aplicar ${manualCount} asignación(es) manual(es) de categoría\n`
        : '';
      return window.confirm(
        '⚠️ RECLASIFICACIÓN DE PRODUCTOS\n\nEsto va a:\n1. Reasignar los productos a las categorías actuales del catálogo (matching por palabras clave)\n2. Actualizar los contadores de productos\n3. NO eliminar ninguna categoría ni subcategoría' +
        manualLine +
        '\nAntes de escribir se guarda una copia de seguridad en /app/data/backups/.\n\n¿Continuar?'
      );
    }

    // Botón de vista previa (no escribe nada)
    btnMigratePreview?.addEventListener('click', () => {
      runCategoryMigration(true);
    });

    // Botón de migración de categorías
    btnMigrateCategories?.addEventListener('click', async () => {
      const manual = collectMigrateManualMap();
      if (!confirmMigrate(Object.keys(manual).length)) return;

      await runCategoryMigration(false, manual);
    });

    // Botón «Migrar con estas asignaciones» (dentro de la caja de reasignación manual)
    btnMigrateManualRun?.addEventListener('click', async () => {
      const manual = collectMigrateManualMap();
      const manualCount = Object.keys(manual).length;
      if (!manualCount) {
        showMigrateStatus('warning', 'Sin asignaciones manuales', 'Elige al menos una categoría raíz antes de migrar.');
        return;
      }
      if (!confirmMigrate(manualCount)) return;

      await runCategoryMigration(false, manual, btnMigrateManualRun);
    });

    // Carga inicial
    loadCategories();

    // =========================================================================
    // CURACIÓN AVANZADA — presets, bulk delete, subcategorías, score,
    // normalización de tags, vinculación de alternativas y preview card.
    // (Bloque aditivo: no toca los handlers existentes de productSelBar.)
    // =========================================================================

    function prodMatchesPreset(product, preset) {
      switch (preset) {
        case 'sin-subcategoria':
          return !product.subcategory_id;
        case 'sin-ia':
          return (product.ia_status || ((product.description || '').trim().length >= 60 ? 'completed' : 'pending')) !== 'completed';
        case 'duplicados':
          return product.is_duplicate === true;
        case 'alta-rentabilidad':
          return (Number(product.conversion_score) || 0) >= 75;
        case 'listos':
          return Boolean(product.category)
            && Boolean(product.subcategory_id)
            && (product.ia_status || ((product.description || '').trim().length >= 60 ? 'completed' : 'pending')) === 'completed'
            && (product.link_status || ((product.affiliateUrl || '').trim() ? 'active' : 'pending')) === 'active';
        default:
          return true;
      }
    }

    function setProdPreset(preset) {
      activeProdPreset = preset || '';
      document.querySelectorAll('.preset-chip[data-prod-preset]').forEach((chip) => {
        chip.classList.toggle('is-active', Boolean(activeProdPreset) && chip.getAttribute('data-prod-preset') === activeProdPreset);
      });
      const clearBtn = document.getElementById('btnProdPresetClear');
      if (clearBtn) clearBtn.hidden = !activeProdPreset;
      prodFilterApply();
    }

    document.querySelectorAll('.preset-chip[data-prod-preset]').forEach((chip) => {
      chip.addEventListener('click', () => {
        const preset = chip.getAttribute('data-prod-preset') || '';
        setProdPreset(activeProdPreset === preset ? '' : preset);
      });
    });
    document.getElementById('btnProdPresetClear')?.addEventListener('click', () => setProdPreset(''));

    // Recalcular y persistir conversion_score de todo el catálogo.
    document.getElementById('btnProdRecalcScores')?.addEventListener('click', async () => {
      showAlert('loading', 'Recalculando scores', 'Aplicando la fórmula de rentabilidad a todo el catálogo...');
      try {
        const res = await fetch('/api/products/curation', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'recalc' }),
        });
        const data = await res.json();
        if (data.success) {
          await reloadProductsTable();
          showAlert('success', 'Scores actualizados', data.message || `${data.updated} producto(s) recalculados.`);
        } else {
          showAlert('error', 'Error al recalcular', data.message || 'No se pudo recalcular el score.');
        }
      } catch {
        showAlert('error', 'Error de red', 'No se pudo contactar con el servidor.');
      }
    });

    // ── Helpers de modales (patrón video-modal: backdrop + Escape) ───────────
    function openAdminModal(modal) {
      if (!modal) return;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function closeAdminModal(modal) {
      if (!modal) return;
      modal.hidden = true;
      if (!document.querySelector('.admin-modal:not([hidden]), .video-modal:not([hidden])')) {
        document.body.style.overflow = '';
      }
    }
    document.addEventListener('click', (event) => {
      const closer = event.target.closest?.('[data-admin-modal-close]');
      if (closer) {
        event.stopPropagation();
        closeAdminModal(closer.closest('.admin-modal'));
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      document.querySelectorAll('.admin-modal:not([hidden])').forEach((modal) => closeAdminModal(modal));
    });

    // ── Selector en cascada: subcategoría destino en productSelBar ───────────
    function syncSubcatAssign() {
      const catSelect = document.getElementById('prodCatAssign');
      const subSelect = document.getElementById('prodSubcatDest');
      if (!catSelect || !subSelect) return;
      fillSubcatDestOptions(subSelect, String(catSelect.value || '').trim());
