    document.getElementById('prodCatAssign')?.addEventListener('change', syncSubcatAssign);
    bindSubcatDestCascade(document.getElementById('prodCatAssign'), document.getElementById('prodSubcatDest'));

    // ── Modal: creación on-the-fly de subcategorías ──────────────────────────
    const createSubcategoryModal = document.getElementById('createSubcategoryModal');
    const createSubcategoryForm = document.getElementById('createSubcategoryForm');
    document.getElementById('btnProdCreateSubcat')?.addEventListener('click', () => {
      const catSelect = document.getElementById('prodCatAssign');
      const categoryName = catSelect && 'value' in catSelect ? String(catSelect.value || '').trim() : '';
      if (!categoryName) {
        showAlert('warning', 'Elige primero la categoría', 'La subcategoría se creará vinculada a la «Categoría destino…» seleccionada.');
