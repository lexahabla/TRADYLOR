    <script is:inline>
      (() => {
        const form = document.getElementById('adminLoginForm');
        const btn = document.getElementById('adminLoginBtn');
        if (!form || !btn) return;

        form.addEventListener('submit', async (e) => {
          btn.disabled = true;
          btn.classList.add('is-loading');
          const spinner = btn.querySelector('.login-btn-spinner');
          const textEl = btn.querySelector('.login-btn-text');
          const arrowEl = btn.querySelector('.login-btn-arrow');
          if (spinner) spinner.hidden = false;
          if (arrowEl) arrowEl.hidden = true;
          if (textEl) textEl.textContent = 'Accediendo al panel…';

          try {
            e.preventDefault();
            const fd = new FormData(form);
            const res = await fetch('/upayp1b4', {
              method: 'POST',
              body: fd,
              headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
              },
            });
            const data = await res.json().catch(() => null);
            if (res.ok && data && data.success && data.redirect) {
              window.location.replace(data.redirect);
              return;
            }
            let errEl = document.querySelector('.admin-login-error');
            if (!errEl) {
              errEl = document.createElement('p');
              errEl.className = 'admin-login-error';
              errEl.setAttribute('role', 'alert');
              form.insertAdjacentElement('beforebegin', errEl);
            }
            errEl.textContent = (data && data.message) || 'El usuario o la contraseña no son correctos.';
            btn.disabled = false;
            btn.classList.remove('is-loading');
            if (spinner) spinner.hidden = true;
            if (arrowEl) arrowEl.hidden = false;
            if (textEl) textEl.textContent = 'Entrar al panel';
          } catch (err) {
            form.submit();
          }
        });
      })();
    </script>
  )}
