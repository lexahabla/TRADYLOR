        aliInvalidateEstado();
        renderAliCatalog();
      }
      reportAliImport(result, 'Importación de selección finalizada', [
        skipped ? `${skipped} omitido${skipped === 1 ? '' : 's'} por ya estar añadido${skipped === 1 ? '' : 's'}` : '',
        result.categorized && chosen ? `en «${chosen.name}»` : '',
