      const context = opencodeContext?.value || 'selected';
      if (opencodeStatus) { opencodeStatus.hidden = false; opencodeStatus.className = 'admin-modal-status'; opencodeStatus.textContent = 'Enviando a OpenCode...'; }
      try {
        let productIds = [];
