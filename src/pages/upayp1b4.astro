<script is:inline>
  // Inicialización de estado y elementos DOM
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs
    const inputScrapeUrl = document.getElementById('inputScrapeUrl');
    const btnScrape = document.getElementById('btnScrape');
    const btnSpinner = btnScrape ? btnScrape.querySelector('.btn-spinner') : null;
    const btnText = btnScrape ? btnScrape.querySelector('.btn-text') : null;

    const scrapeStatusAlert = document.getElementById('scrapeStatusAlert');
    const statusAlertIcon = document.getElementById('statusAlertIcon');
    const statusAlertTitle = document.getElementById('statusAlertTitle');
    const statusAlertText = document.getElementById('statusAlertText');

    const productForm = document.getElementById('productForm');
    const prodId = document.getElementById('prodId');
    const prodTitle = document.getElementById('prodTitle');
    const prodPrice = document.getElementById('prodPrice');
    const prodOriginalPrice = document.getElementById('prodOriginalPrice');
    const prodCategory = document.getElementById('prodCategory');
    const prodMerchant = document.getElementById('prodMerchant');
    const prodAffiliateUrl = document.getElementById('prodAffiliateUrl');
    const prodBuyNowUrl = document.getElementById('prodBuyNowUrl');

    // Autodetección de ASIN: al pegar el enlace de afiliado o la URL del producto
    // se genera el enlace de Compra Directa (Buy Now) si el campo está vacío.
    const AMAZON_ASIN_IN_PATH_RE = /\/(?:dp|gp\/product|gp\/aw\/d|product)\/([A-Za-z0-9]{10})(?:[/?#]|$)/;
    const ASIN_QUERY_RE = /[?&]asin=([A-Za-z0-9]{10})(?:[&#]|$)/;
    function extractAsinFromUrl(url) {
      const raw = String(url || '').trim();
      if (!raw) return '';
      const pathAndQuery = (() => {
        try {
          const u = new URL(raw);
          return u.pathname + u.search;
        } catch {
          return raw;
        }
      })();
      const match = AMAZON_ASIN_IN_PATH_RE.exec(pathAndQuery) || ASIN_QUERY_RE.exec(pathAndQuery);
      return match ? match[1].toUpperCase() : '';
    }
    function buildAmazonCartUrl(asin) {
      const clean = String(asin || '').trim().toUpperCase();
      if (!/^[A-Z0-9]{10}$/.test(clean)) return '';
      const tag = window.TRADYLOR_ASSOCIATE_TAG || 'tradylor-21';
      const params = new URLSearchParams({ 'ASIN.1': clean, 'Quantity.1': '1', AssociateTag: tag });
      return `https://www.amazon.es/gp/aws/cart/add.html?${params.toString()}`;
    }
    function autoFillBuyNow(url) {
      const asin = extractAsinFromUrl(url);
      if (!asin || !prodBuyNowUrl) return;
      // Compra directa generada: cesta de Amazon con el tag → tramitación del pedido.
      if (!prodBuyNowUrl.value.trim()) {
        prodBuyNowUrl.value = buildAmazonCartUrl(asin);
      }
    }
    // Sincronización bidireccional entre "URL del Producto" y "Enlace de Afiliado Final".
    function syncUrlFields(source, target) {
      const value = String(source.value || '').trim();
      if (value && target && !String(target.value || '').trim()) target.value = value;
    }
    if (prodAffiliateUrl) {
      prodAffiliateUrl.addEventListener('input', () => {
        syncUrlFields(prodAffiliateUrl, inputScrapeUrl);
        autoFillBuyNow(prodAffiliateUrl.value);
      });
    }
    if (inputScrapeUrl) {
      inputScrapeUrl.addEventListener('input', () => {
        syncUrlFields(inputScrapeUrl, prodAffiliateUrl);
        autoFillBuyNow(prodAffiliateUrl.value);
      });
    }
    const prodImage = document.getElementById('prodImage');
    const prodBadge = document.getElementById('prodBadge');
    const prodShippingInfo = document.getElementById('prodShippingInfo');
    const prodShippingDays = document.getElementById('prodShippingDays');
    const prodFreeShipping = document.getElementById('prodFreeShipping');
    const prodDescription = document.getElementById('prodDescription');
    const prodVerdict = document.getElementById('prodVerdict');
    const prodTechSheet = document.getElementById('prodTechSheet');
    const prodPros = document.getElementById('prodPros');
    const prodCons = document.getElementById('prodCons');
    const prodBrand = document.getElementById('prodBrand');
    const prodFulfillment = document.getElementById('prodFulfillment');
    const prodCondition = document.getElementById('prodCondition');
    const prodRating = document.getElementById('prodRating');
    const prodReviews = document.getElementById('prodReviews');
    const prodSpecs = document.getElementById('prodSpecs');
    const btnSaveProduct = document.getElementById('btnSaveProduct');
    const btnAiEnrich = document.getElementById('btnAiEnrich');

    // Specs (clave/valor): conversión entre objeto y texto «Clave: Valor» por línea.
    function specsToText(specs) {
      if (!specs || typeof specs !== 'object' || Array.isArray(specs)) return '';
      return Object.entries(specs)
        .filter(([k, v]) => k && v != null && String(v).trim())
        .map(([k, v]) => `${k}: ${v}`)
        .join('\n');
    }
    function textToSpecs(text) {
      const specs = {};
      String(text || '')
        .split('\n')
        .map((l) => l.trim())
        .filter(Boolean)
        .forEach((line) => {
          const idx = line.indexOf(':');
          if (idx > 0) {
            const key = line.slice(0, idx).trim();
            const value = line.slice(idx + 1).trim();
            if (key && value) specs[key] = value;
          }
        });
      return Object.keys(specs).length ? specs : undefined;
    }

    // Plegar/desplegar el formulario de alta desde su card-header.
    const formCardHeader = document.querySelector('.form-card .card-header-toggle');
    let formExpanded = false;
    function setFormPanelExpanded(expanded) {
      formExpanded = Boolean(expanded);
      document.querySelectorAll('.form-card .form-toggle-body').forEach((body) => {
        body.style.display = formExpanded ? '' : 'none';
      });
      if (formCardHeader) formCardHeader.setAttribute('aria-expanded', String(formExpanded));
    }
    if (formCardHeader) {
      formCardHeader.style.cursor = 'pointer';
      formCardHeader.setAttribute('role', 'button');
      formCardHeader.setAttribute('tabindex', '0');
      setFormPanelExpanded(false);
      formCardHeader.addEventListener('click', () => setFormPanelExpanded(!formExpanded));
      formCardHeader.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setFormPanelExpanded(!formExpanded);
        }
      });
    }

    // Lleva el scroll al inicio del panel «Extracción & Alta de Producto».
    // Se calcula tras el repintado (rAF) porque desplegar el panel cambia el layout.
    function scrollToFormPanel() {
      const card = document.querySelector('.form-card');
      if (!card) return;
      requestAnimationFrame(() => {
        const top = window.scrollY + card.getBoundingClientRect().top - 80;
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      });
    }

    // Extras del último scrape (specs, marca, valoración, reseñas) para el enriquecimiento local.
    let scrapeExtras = { brand: '', rating: null, reviewsCount: null, specs: null };
    // Galería de imágenes del último scrape (la primera es la principal).
    let scrapedGallery = [];
    const galleryThumbs = document.getElementById('galleryThumbs');
    const galleryFileInput = document.getElementById('galleryFileInput');
    const galleryUrlInput = document.getElementById('galleryUrlInput');
    const btnAddImageUrl = document.getElementById('btnAddImageUrl');
    let galleryDragFrom = null;
    let galleryDragEndedAt = 0;

    // Preview
    const previewImg = document.getElementById('previewImg');
    const previewEmptyImage = document.getElementById('previewEmptyImage');
    const previewPrev = document.getElementById('previewPrev');
    const previewNext = document.getElementById('previewNext');
    const previewCounter = document.getElementById('previewCounter');
    let previewGallery = [];
    let previewIndex = 0;
    const previewCategory = document.getElementById('previewCategory');
    const previewBadge = document.getElementById('previewBadge');
    const previewMerchant = document.getElementById('previewMerchant');
    const previewTitle = document.getElementById('previewTitle');
    const previewDesc = document.getElementById('previewDesc');
    const previewPrice = document.getElementById('previewPrice');
    const previewOriginalPrice = document.getElementById('previewOriginalPrice');
    const previewDiscount = document.getElementById('previewDiscount');
    const previewProsList = document.getElementById('previewProsList');
    const previewBulletsWrap = document.getElementById('previewBulletsWrap');
    const previewAffiliateBtn = document.getElementById('previewAffiliateBtn');
    const previewBtnMerchant = document.getElementById('previewBtnMerchant');

    // Listado de productos
    const productsTableBody = document.getElementById('productsTableBody');
    const inputFilterList = document.getElementById('inputFilterList');
    const prodFCat = document.getElementById('prodFCat');
    const prodSubcatFilter = document.getElementById('prodSubcatAssign');
    const prodFCatNetwork = document.getElementById('prodFCatNetwork');
    const prodFSubcatNetwork = document.getElementById('prodFSubcatNetwork');
    const prodFPhotos = document.getElementById('prodFPhotos');
    const prodFSort = document.getElementById('prodFSort');
    const prodFSortDir = document.getElementById('prodFSortDir');
    const prodFReset = document.getElementById('prodFReset');
    const prodRangeFields = document.getElementById('prodRangeFields');
    const productSelBar = document.getElementById('productSelBar');
    const productSelCount = document.getElementById('productSelCount');
    const prodCheckAll = document.getElementById('prodCheckAll');
    const btnProdSelAll = document.getElementById('btnProdSelAll');
    const btnProdSelClear = document.getElementById('btnProdSelClear');
    const btnProdEnrich = document.getElementById('btnProdEnrich');
    const btnProdMakeSection = document.getElementById('btnProdMakeSection');
    const prodCatAssign = document.getElementById('prodCatAssign');
    const btnProdAssignCat = document.getElementById('btnProdAssignCat');
    let selectedProductIds = new Set();
    let currentProducts = (typeof window !== 'undefined' && Array.isArray(window.__INITIAL_PRODUCTS__) && window.__INITIAL_PRODUCTS__.length > 0)
      ? window.__INITIAL_PRODUCTS__
      : [];
    // Paginación del catálogo de productos
    let currentPage = 1;
    // Productos por página: ajustable con el select de las barras de
    // paginación (25 / 50 / 75).
    let PRODUCTS_PER_PAGE = 50;
    let filteredProducts = [];
    /**
     * Caché de `externalId → estado de importación` del catálogo AliExpress
     * (PENDING / IMPORTED / DISCARDED). Se invalida con `aliInvalidateEstado()`
     * cada vez que cambia el catálogo registrado, la caché de Ali o los
     * descartes locales. Declarada aquí (y no en el bloque AliExpress) porque
     * `reloadProductsTable()` la toca antes de llegar a esa sección.
     */
    let aliEstadoCache = null;
    let categoriesCache = [];
    let activeProdPreset = '';
    let aliFilterPanel = null;

    // Helper para mostrar feedback de alerta
    function showAlert(type, title, message) {
      if (!scrapeStatusAlert) return;
      scrapeStatusAlert.hidden = false;
      scrapeStatusAlert.className = `status-alert alert-${type}`;
      
      if (type === 'success') {
        statusAlertIcon.textContent = '✅';
      } else if (type === 'warning') {
        statusAlertIcon.textContent = '⚠️';
      } else if (type === 'loading') {
        statusAlertIcon.textContent = '⏳';
      } else {
        statusAlertIcon.textContent = '❌';
      }

      statusAlertTitle.textContent = title;
      statusAlertText.textContent = message;
    }

    function hideAlert() {
      if (scrapeStatusAlert) scrapeStatusAlert.hidden = true;
    }

    function setProductField(field, value) {
      if (!field || value === undefined || value === null) return;
      field.value = String(value);
      field.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // Rellena un campo SOLO si está vacío: el scraper nunca pisa lo escrito a mano.
    function fillIfEmpty(field, value) {
      if (!field || value === undefined || value === null || value === '') return;
      if (String(field.value || '').trim() !== '') return;
      setProductField(field, value);
    }

    // ── Vídeos en la galería (helper + modal centrado) ──────────────────────
    function isVideoUrl(url) {
      const u = String(url || '').trim().toLowerCase();
      if (!u) return false;
      if (/\.(mp4|webm|mov|m4v|ogv)(\?|#|$)/.test(u)) return true;
      return /(youtube\.com|youtu\.be|vimeo\.com|dailymotion\.com)/.test(u);
    }

    function videoEmbedUrl(url, autoplay) {
      const u = String(url || '').trim();
      const yt = u.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/i);
      if (yt) return `https://www.youtube.com/embed/${yt[1]}${autoplay ? '?autoplay=1&mute=1' : ''}`;
      const vimeo = u.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
      if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}${autoplay ? '?autoplay=1&mute=1' : ''}`;
      const dailymotion = u.match(/dailymotion\.com\/(?:video|embed\/video)\/([\w]+)/i);
      if (dailymotion) return `https://www.dailymotion.com/embed/video/${dailymotion[1]}${autoplay ? '?autoplay=1' : ''}`;
      return null;
    }

    // Miniatura (fotograma) del vídeo: YouTube/Vimeo/Dailymotion dan URL de
    // imagen; los archivos directos (mp4/webm) se previsualizan con <video>.
    function videoThumbUrl(url) {
      const u = String(url || '').trim();
      const yt = u.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/i);
      if (yt) return `https://i.ytimg.com/vi/${yt[1]}/hqdefault.jpg`;
      const vimeo = u.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
      if (vimeo) return `https://vumbnail.com/${vimeo[1]}.jpg`;
      const dailymotion = u.match(/dailymotion\.com\/(?:video|embed\/video)\/([\w]+)/i);
      if (dailymotion) return `https://www.dailymotion.com/thumbnail/video/${dailymotion[1]}`;
      return null;
    }

    const videoModal = document.getElementById('videoModal');
    const videoModalBody = document.getElementById('videoModalBody');

    function openVideoModal(url) {
      if (!videoModal || !videoModalBody || !url) return;
      const embed = videoEmbedUrl(url, true);
      if (embed) {
        const iframe = document.createElement('iframe');
        iframe.src = embed;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        videoModalBody.appendChild(iframe);
      } else {
        const video = document.createElement('video');
        video.src = url;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        videoModalBody.appendChild(video);
      }
      videoModal.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeVideoModal() {
      if (!videoModal) return;
      videoModal.hidden = true;
      if (videoModalBody) videoModalBody.innerHTML = '';
      document.body.style.overflow = '';
    }

    if (videoModal) {
      videoModal.addEventListener('click', (e) => {
        if (e.target && e.target.closest && e.target.closest('[data-video-modal-close]')) closeVideoModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !videoModal.hidden) closeVideoModal();
      });
    }

    // Renderiza la galería de imágenes/vídeos como miniaturas seleccionables.
    // La imagen principal (prodImage) se marca con un borde destacado;
    // los vídeos se reproducen en el modal centrado. Arrastrable para reordenar.
    function moveGalleryItem(fromIndex, toIndex, insertAfter) {
      if (fromIndex == null || toIndex == null || fromIndex === toIndex) return;
      const list = scrapedGallery.slice();
      const [moved] = list.splice(fromIndex, 1);
      if (moved === undefined) return;
      let target = toIndex;
      if (fromIndex < toIndex) target -= 1;
      let insertAt = insertAfter ? target + 1 : target;
      if (insertAt < 0) insertAt = 0;
      if (insertAt > list.length) insertAt = list.length;
      list.splice(insertAt, 0, moved);
      scrapedGallery = list;
    }

    function clearGalleryDropMarks() {
      if (!galleryThumbs) return;
      galleryThumbs.querySelectorAll('.gallery-item').forEach((el) => {
        el.classList.remove('drag-before', 'drag-after');
      });
    }

    function renderGallery() {
      if (!galleryThumbs) return;
      galleryThumbs.innerHTML = '';
      const current = (prodImage.value || '').trim();
      if (!scrapedGallery.length) {
        galleryThumbs.innerHTML = '<span class="gallery-empty">Sin galería. Analiza un enlace o añade imágenes/vídeos.</span>';
        return;
      }
      scrapedGallery.forEach((url, index) => {
        const isVideo = isVideoUrl(url);
        const wrap = document.createElement('div');
        wrap.className = 'gallery-item' + (!isVideo && url === current ? ' is-main' : '');
        wrap.draggable = true;

        wrap.addEventListener('dragstart', (e) => {
          galleryDragFrom = index;
          wrap.classList.add('is-dragging');
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', url);
          }
        });

        wrap.addEventListener('dragover', (e) => {
          if (galleryDragFrom === null || galleryDragFrom === index) return;
          e.preventDefault();
          if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
          const rect = wrap.getBoundingClientRect();
          const after = e.clientX - rect.left >= rect.width / 2;
          galleryThumbs.querySelectorAll('.gallery-item').forEach((el) => {
            if (el !== wrap) el.classList.remove('drag-before', 'drag-after');
          });
          wrap.classList.toggle('drag-after', after);
          wrap.classList.toggle('drag-before', !after);
        });

        wrap.addEventListener('dragleave', (e) => {
          if (e.relatedTarget && wrap.contains(e.relatedTarget)) return;
          wrap.classList.remove('drag-before', 'drag-after');
        });

        wrap.addEventListener('drop', (e) => {
          e.preventDefault();
          clearGalleryDropMarks();
          const from = galleryDragFrom;
          galleryDragFrom = null;
          galleryDragEndedAt = Date.now();
          if (from === null || from === index) return;
          const rect = wrap.getBoundingClientRect();
          moveGalleryItem(from, index, e.clientX - rect.left >= rect.width / 2);
          const firstImage = scrapedGallery.find((u) => !isVideoUrl(u)) || '';
          setProductField(prodImage, firstImage);
          previewIndex = firstImage ? scrapedGallery.indexOf(firstImage) : 0;
          renderGallery();
          updatePreview();
          showAlert('success', 'Orden actualizado', 'La primera imagen de la galería pasa a ser la imagen principal.');
        });

        wrap.addEventListener('dragend', () => {
          wrap.classList.remove('is-dragging');
          clearGalleryDropMarks();
          galleryDragFrom = null;
          galleryDragEndedAt = Date.now();
        });

        const thumb = document.createElement('button');
        thumb.type = 'button';
        thumb.className = 'gallery-thumb';

        if (isVideo) {
          thumb.title = 'Reproducir vídeo';
          const still = videoThumbUrl(url);
          if (still) {
            // Plataforma (YouTube/Vimeo/DM): se muestra su miniatura oficial.
            const img = document.createElement('img');
            img.src = still;
            img.className = 'video-still';
            img.alt = 'Miniatura del vídeo';
            img.loading = 'lazy';
            thumb.appendChild(img);
          } else {
            // Archivo directo (mp4/webm): primer fotograma del propio vídeo.
            const vid = document.createElement('video');
            vid.src = url;
            vid.muted = true;
            vid.preload = 'metadata';
            vid.playsInline = true;
            thumb.appendChild(vid);
          }
          const badge = document.createElement('span');
          badge.className = 'gallery-play-badge';
          badge.textContent = '▶';
          wrap.appendChild(badge);
          thumb.addEventListener('click', () => {
            if (Date.now() - galleryDragEndedAt < 300) return;
            openVideoModal(url);
          });
        } else {
          thumb.title = 'Clic: imagen principal · Arrastra: reordenar';
          const img = document.createElement('img');
          img.src = url;
          img.alt = 'Imagen del producto';
          img.loading = 'lazy';
          thumb.appendChild(img);
          thumb.addEventListener('click', () => {
            if (Date.now() - galleryDragEndedAt < 300) return;
            setProductField(prodImage, url);
            previewIndex = scrapedGallery.indexOf(url);
            if (previewIndex < 0) previewIndex = 0;
            renderGallery();
            updatePreview();
          });
        }

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'gallery-remove';
        removeBtn.title = 'Quitar de la galería';
        removeBtn.textContent = '×';
        removeBtn.draggable = false;
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (Date.now() - galleryDragEndedAt < 300) return;
          scrapedGallery = scrapedGallery.filter((u) => u !== url);
          if ((prodImage.value || '').trim() === url) {
            const firstImage = scrapedGallery.find((u) => !isVideoUrl(u)) || '';
            setProductField(prodImage, firstImage);
          }
          renderGallery();
          updatePreview();
        });

        wrap.appendChild(thumb);
        wrap.appendChild(removeBtn);
        galleryThumbs.appendChild(wrap);
      });
    }

    // Añade imágenes/vídeos a la galería por URL (separadas por comas/espacios).
    // Acepta URLs de vídeo (YouTube, Vimeo, Dailymotion, mp4/webm) e imágenes.
    function addImagesByUrl() {
      const raw = (galleryUrlInput?.value || '').trim();
      if (!raw) return;
      const parts = raw.split(/[\s,]+/).map((s) => s.trim()).filter(Boolean);
      let addedImages = 0;
      let addedVideos = 0;
      for (let part of parts) {
        // Ruta local válida para la galería (p. ej. /images/products/x.jpg).
        if (part.startsWith('/') && !part.startsWith('//')) {
          if (!scrapedGallery.includes(part)) {
            scrapedGallery.push(part);
            addedImages++;
          }
          continue;
        }
        // Normaliza: acepta también URLs pegadas sin protocolo (youtu.be/..., youtube.com/...).
        if (part.startsWith('//')) part = `https:${part}`;
        else if (!/^https?:\/\//i.test(part)) part = `https://${part}`;
        if (!scrapedGallery.includes(part)) {
          scrapedGallery.push(part);
          if (isVideoUrl(part)) addedVideos++;
          else addedImages++;
        }
      }
      if (galleryUrlInput) galleryUrlInput.value = '';
      if (!addedImages && !addedVideos && parts.length) {
        showAlert('warning', 'URL no válida', 'Introduce una imagen o vídeo (p. ej. https://youtube.com/watch?v=...).');
        return;
      }
      if (addedImages && !(prodImage.value || '').trim()) {
        const firstImage = scrapedGallery.find((u) => !isVideoUrl(u));
        if (firstImage) setProductField(prodImage, firstImage);
      }
      renderGallery();
      updatePreview();
      const bits = [];
      if (addedImages) bits.push(`${addedImages} imagen(es)`);
      if (addedVideos) bits.push(`${addedVideos} vídeo(s)`);
      if (bits.length) showAlert('success', 'Añadido a la galería', bits.join(' y '));
    }

    // Sube archivos de imagen/vídeo al servidor y los añade a la galería.
    async function uploadGalleryFiles(fileList) {
      const files = Array.from(fileList || []).filter(
        (f) => f.type.startsWith('image/') || f.type.startsWith('video/')
      );
      if (!files.length) return;
      if (btnAddImageUrl) btnAddImageUrl.disabled = true;
      showAlert('loading', 'Subiendo archivos...', `${files.length} imagen(es)/vídeo(s) al servidor.`);
      try {
        const fd = new FormData();
        files.forEach((f) => fd.append('images', f));
        const response = await fetch('/api/admin/upload-image', { method: 'POST', body: fd });
        const result = await response.json();
        if (result.success && Array.isArray(result.urls)) {
          for (const url of result.urls) {
            if (!scrapedGallery.includes(url)) scrapedGallery.push(url);
          }
          if (!(prodImage.value || '').trim()) {
            const firstImage = result.urls.find((u) => !isVideoUrl(u));
            if (firstImage) setProductField(prodImage, firstImage);
          }
          renderGallery();
          updatePreview();
          showAlert('success', 'Archivos subidos', `${result.urls.length} archivo(s) añadido(s) a la galería.`);
        } else {
          showAlert('error', 'No se pudieron subir', result.message || 'Error al subir los archivos.');
        }
      } catch (err) {
        console.error(err);
        showAlert('error', 'Error de red', 'No se pudo contactar con /api/admin/upload-image.');
      } finally {
        if (btnAddImageUrl) btnAddImageUrl.disabled = false;
        if (galleryFileInput) galleryFileInput.value = '';
      }
    }

    if (btnAddImageUrl) btnAddImageUrl.addEventListener('click', addImagesByUrl);
    if (galleryUrlInput) galleryUrlInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); addImagesByUrl(); } });
    if (galleryFileInput) galleryFileInput.addEventListener('change', (e) => uploadGalleryFiles(e.target.files));

    // Actualiza la vista previa interactiva en tiempo real
    // Dibuja la imagen/vídeo actual del carrusel y controla flechas/contador.
    // Los vídeos se muestran con su miniatura (fotograma) y botón play encima.
    const previewVideoOverlay = document.getElementById('previewVideoOverlay');
    let previewVideoThumb = null;

    function clearPreviewVideoThumb() {
      if (previewVideoThumb && previewVideoThumb.parentNode) {
        previewVideoThumb.parentNode.removeChild(previewVideoThumb);
      }
      previewVideoThumb = null;
    }

    function renderPreviewImage() {
      if (!previewImg) return;
      const total = previewGallery.length;
      const hasMedia = total > 0;
      clearPreviewVideoThumb();
      previewImg.hidden = !hasMedia;
      if (previewEmptyImage) previewEmptyImage.hidden = hasMedia;

      if (hasMedia) {
        if (previewIndex >= total) previewIndex = 0;
        if (previewIndex < 0) previewIndex = total - 1;
        const current = previewGallery[previewIndex];
        if (isVideoUrl(current)) {
          const still = videoThumbUrl(current);
          if (still) {
            // Plataforma: se ve la miniatura oficial + overlay play.
            previewImg.hidden = false;
            previewImg.src = still;
          } else {
            // Archivo directo: <video> con el primer fotograma + overlay play.
            previewImg.hidden = true;
            const vid = document.createElement('video');
            vid.className = 'preview-video-thumb';
            vid.src = current;
            vid.muted = true;
            vid.preload = 'metadata';
            vid.playsInline = true;
            vid.setAttribute('aria-hidden', 'true');
            const wrapper = previewImg.parentElement;
            if (wrapper) wrapper.insertBefore(vid, previewImg);
            previewVideoThumb = vid;
          }
          if (previewVideoOverlay) previewVideoOverlay.hidden = false;
        } else {
          if (previewVideoOverlay) previewVideoOverlay.hidden = true;
          previewImg.src = current;
        }
      } else if (previewVideoOverlay) {
        previewVideoOverlay.hidden = true;
      }

      const showNav = total > 1;
      if (previewPrev) previewPrev.hidden = !showNav;
      if (previewNext) previewNext.hidden = !showNav;
      if (previewCounter) {
        previewCounter.hidden = !showNav;
        if (showNav) previewCounter.textContent = `${previewIndex + 1} / ${total}`;
      }
    }

    // Flechas del carrusel: navegar por la galería de la vista previa.
    if (previewPrev) previewPrev.addEventListener('click', () => { previewIndex--; renderPreviewImage(); });
    if (previewNext) previewNext.addEventListener('click', () => { previewIndex++; renderPreviewImage(); });
    // Overlay de vídeo de la vista previa: abre el modal centrado.
    if (previewVideoOverlay) {
      previewVideoOverlay.addEventListener('click', () => {
        const current = previewGallery[previewIndex];
        if (current && isVideoUrl(current)) openVideoModal(current);
      });
    }

    function updatePreview() {
      const title = prodTitle.value.trim();
      const price = parseFloat(prodPrice.value) || 0;
      const originalPrice = parseFloat(prodOriginalPrice.value) || 0;
      const category = prodCategory.value.trim();
      const merchant = prodMerchant.value;
      const image = prodImage.value.trim();
      const badge = prodBadge.value.trim();
      const desc = prodDescription.value.trim();
      const url = prodAffiliateUrl.value.trim() || '#';

      if (previewTitle) previewTitle.textContent = title;
      if (previewDesc) previewDesc.textContent = desc;
      if (previewPrice) previewPrice.textContent = `${price.toFixed(2)} €`;
      if (previewCategory) previewCategory.textContent = category;
      if (previewMerchant) previewMerchant.textContent = merchant;
      if (previewBtnMerchant) previewBtnMerchant.textContent = merchant;

      // Carrusel de la vista previa: usa la galería (scrapedGallery) o la imagen principal.
      previewGallery = Array.isArray(scrapedGallery) && scrapedGallery.length
        ? scrapedGallery.slice()
        : (image ? [image] : []);
      if (!previewGallery.length && image) previewGallery = [image];
      if (previewIndex >= previewGallery.length) previewIndex = 0;
      renderPreviewImage();

      if (previewAffiliateBtn) {
        previewAffiliateBtn.href = url;
        previewAffiliateBtn.hidden = !prodAffiliateUrl.value.trim();
      }
      if (previewCategory) previewCategory.hidden = !category;
      if (previewMerchant) previewMerchant.hidden = !merchant;
      if (previewDesc) previewDesc.hidden = !desc;
      if (previewPrice) previewPrice.parentElement.parentElement.hidden = price <= 0;

      if (previewBadge) {
        if (badge) {
          previewBadge.textContent = badge;
          previewBadge.hidden = false;
        } else {
          previewBadge.hidden = true;
        }
      }

      if (previewOriginalPrice && previewDiscount) {
        if (originalPrice > price && price > 0) {
          previewOriginalPrice.textContent = `${originalPrice.toFixed(2)} €`;
          previewOriginalPrice.hidden = false;
          const discountPct = Math.round(((originalPrice - price) / originalPrice) * 100);
          previewDiscount.textContent = `-${discountPct}%`;
          previewDiscount.hidden = false;
        } else {
          previewOriginalPrice.hidden = true;
          previewDiscount.hidden = true;
        }
      }

      if (previewProsList) {
        const pros = prodPros.value
          .split('\n')
          .map((s) => s.trim())
          .filter(Boolean);
        previewProsList.innerHTML = '';
        if (pros.length > 0) {
          if (previewBulletsWrap) previewBulletsWrap.hidden = false;
          pros.slice(0, 3).forEach((pro) => {
            const li = document.createElement('li');
            li.textContent = pro;
            previewProsList.appendChild(li);
          });
        } else {
          if (previewBulletsWrap) previewBulletsWrap.hidden = true;
        }
      }
    }

    // Escuchadores para actualización en vivo del preview
    [
      prodTitle,
      prodPrice,
      prodOriginalPrice,
      prodCategory,
      prodMerchant,
      prodAffiliateUrl,
      prodImage,
      prodBadge,
      prodDescription,
      prodPros,
    ].forEach((el) => {
      if (el) el.addEventListener('input', updatePreview);
    });

    // =========================================================================
    // 1. ANALIZAR URL (Scraping Híbrido con Endpoint API)
    // =========================================================================
    if (btnScrape && inputScrapeUrl) {
      btnScrape.addEventListener('click', async () => {
        const urlToScrape = inputScrapeUrl.value.trim();
        if (!urlToScrape) {
          showAlert('warning', 'URL requerida', 'Por favor, pega el enlace del producto antes de analizar.');
          inputScrapeUrl.focus();
          return;
        }

        // Estado visual de carga
        btnScrape.disabled = true;
        if (btnSpinner) btnSpinner.hidden = false;
        if (btnText) btnText.textContent = 'Extrayendo...';
        showAlert('loading', 'Analizando página externa...', 'Haciendo fetch con User-Agent legítimo y extrayendo OpenGraph/Schemas.');

        try {
          const response = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'scrape', url: urlToScrape }),
          });

          const result = await response.json();

          if (!result.success) {
            showAlert('error', 'Error en análisis', result.message || 'No se pudo procesar la solicitud.');
            return;
          }

          const data = result.data || {};

          // Rellenar campos del formulario SOLO si están vacíos (nunca pisa lo manual).
          fillIfEmpty(prodTitle, data.title || data.name || '');
          fillIfEmpty(prodImage, data.image || '');
          fillIfEmpty(prodDescription, data.description || '');
          fillIfEmpty(prodPrice, data.price ?? '');
          fillIfEmpty(prodOriginalPrice, data.originalPrice ?? '');
          fillIfEmpty(prodCategory, data.category || 'Tecnología');
          fillIfEmpty(prodMerchant, data.merchant || 'Amazon');
          fillIfEmpty(prodBadge, data.badge || '');
          fillIfEmpty(prodVerdict, data.verdict || '');
          fillIfEmpty(prodPros, Array.isArray(data.pros) ? data.pros.join('\n') : '');
          fillIfEmpty(prodCons, Array.isArray(data.cons) ? data.cons.join('\n') : '');
          fillIfEmpty(prodAffiliateUrl, data.affiliateUrl || urlToScrape);
          fillIfEmpty(prodBuyNowUrl, data.buyNowUrl || '');
          fillIfEmpty(prodBrand, data.brand || '');
          fillIfEmpty(prodFulfillment, data.fulfillmentProvider || '');
          if (prodCondition && !prodCondition.value && data.condition) {
            const hasOption = Array.from(prodCondition.options).some((o) => o.value === data.condition);
            prodCondition.value = hasOption ? data.condition : '';
          }
          fillIfEmpty(prodRating, data.rating ?? '');
          fillIfEmpty(prodReviews, data.reviewsCount ?? '');
          fillIfEmpty(prodShippingInfo, data.shippingInfo || '');
          if (data.shippingDays != null && data.shippingDays !== '' && prodShippingDays && !prodShippingDays.value) {
            prodShippingDays.value = String(data.shippingDays);
          }
          fillIfEmpty(prodSpecs, specsToText(data.specs));

          // Guardar extras del scrape (specs, marca, valoración, reseñas) para
          // que el enriquecimiento local use datos reales.
          scrapeExtras = {
            brand: data.brand || '',
            rating: data.rating ?? null,
            reviewsCount: data.reviewsCount ?? null,
            specs: data.specs && typeof data.specs === 'object' ? data.specs : null,
          };

          // Galería de imágenes: la principal encabeza, luego el resto de vistas.
          scrapedGallery = Array.isArray(data.gallery) && data.gallery.length
            ? data.gallery
            : (data.image ? [data.image] : []);
          renderGallery();

          updatePreview();

          if (result.scraped) {
            showAlert(
              'success',
              'Metadatos extraídos con éxito',
              'Título, imagen, comercio y precio detectados. La IA completa la ficha automáticamente...'
            );
            // Auto-enriquecer con IA: descripción, veredicto, pros/cons e imagen.
            if (typeof runAiEnrich === 'function') {
              window.setTimeout(() => {
                runAiEnrich({ auto: true }).catch(() => {});
              }, 400);
            }
          } else {
            showAlert(
              'warning',
              'Extracción bloqueada por el comercio (403/Anti-bot)',
              result.message || 'La tienda protegió el acceso automático. Por favor, rellena los campos restantes manualmente.'
            );
          }
        } catch (err) {
          console.error(err);
          showAlert(
            'warning',
            'Fallo de conexión',
            'No se pudo comunicar con el endpoint. Puedes rellenar los datos de forma manual.'
          );
        } finally {
          btnScrape.disabled = false;
          if (btnSpinner) btnSpinner.hidden = true;
          if (btnText) btnText.textContent = 'Analizar Enlace';
        }
      });

      // Permitir pulsar Enter en el input de URL para disparar el análisis
      inputScrapeUrl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          btnScrape.click();
        }
      });
    }

    // =========================================================================
    // 2. GUARDAR PRODUCTO (POST al Endpoint)
    //    - Si el formulario tiene un id (edición) se ACTUALIZA el producto y el
    //      formulario se conserva relleno para seguir ajustando.
    //    - Si no tiene id (alta nueva) se crea y el formulario se limpia.
    //    - Los campos opcionales vacíos se envían como `null` en modo edición
    //      para que el backend los limpie (no conserve el valor anterior).
    // =========================================================================
    const btnSaveProductLabel = document.getElementById('btnSaveProductLabel');
    let saveBtnFlashTimer = null;
    function flashSaveButton(text) {
      if (!btnSaveProductLabel) return;
      btnSaveProductLabel.textContent = text;
      if (saveBtnFlashTimer) clearTimeout(saveBtnFlashTimer);
      saveBtnFlashTimer = setTimeout(() => {
        btnSaveProductLabel.textContent = 'Guardar cambios';
      }, 2600);
    }
    function resetProductForm() {
      prodId.value = '';
      prodTitle.value = '';
      prodPrice.value = '';
      prodOriginalPrice.value = '';
      prodCategory.value = '';
      prodMerchant.value = '';
      prodAffiliateUrl.value = '';
      prodBuyNowUrl.value = '';
      prodImage.value = '';
      prodBadge.value = '';
      prodDescription.value = '';
      prodVerdict.value = '';
      prodTechSheet.value = '';
      prodPros.value = '';
      prodCons.value = '';
      if (prodBrand) prodBrand.value = '';
      if (prodFulfillment) prodFulfillment.value = '';
      if (prodCondition) prodCondition.value = '';
      if (prodRating) prodRating.value = '';
      if (prodReviews) prodReviews.value = '';
      if (prodSpecs) prodSpecs.value = '';
      if (prodShippingInfo) prodShippingInfo.value = '';
      if (prodShippingDays) prodShippingDays.value = '';
      if (prodFreeShipping) prodFreeShipping.checked = false;
      if (inputScrapeUrl) inputScrapeUrl.value = '';
      if (galleryUrlInput) galleryUrlInput.value = '';
      if (galleryFileInput) galleryFileInput.value = '';
      scrapedGallery = [];
      scrapeExtras = { brand: '', rating: null, reviewsCount: null, specs: null };
      if (window.tradylorCustomFields) window.tradylorCustomFields.setFormValues({});
      previewIndex = 0;
      renderGallery();
      updatePreview();
    }

    // Botón «Nuevo Producto»: deja el formulario vacío (modo alta individual)
    // para que «Analizar Enlace» rellene todos los campos desde cero.
    const btnNewProduct = document.getElementById('btnNewProduct');
    if (btnNewProduct) {
      btnNewProduct.addEventListener('click', () => {
        resetProductForm();
        if (btnSaveProductLabel) btnSaveProductLabel.textContent = 'Guardar cambios';
        if (inputScrapeUrl) inputScrapeUrl.focus();
        showAlert(
          'success',
          'Alta de producto nueva',
          'Formulario vacío. Pega la URL del producto y pulsa «Analizar Enlace» para rellenar todos los campos.'
        );
      });
    }
    if (productForm) {
      productForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const editingId = prodId.value.trim();
        const isEditing = Boolean(editingId);
        // En edición, vaciar un campo opcional envía `null` (limpia el valor);
        // en alta se envía `undefined` para que el backend aplique sus defaults.
        const optional = (value) => (isEditing ? (value || null) : (value || undefined));

        // La imagen principal debe viajar siempre dentro de la galería.
        // Si no hay imagen principal, se toma la primera imagen de la galería
        // (nunca un vídeo); así se puede crear un producto sólo con vídeo.
        let mainImage = prodImage.value.trim();
        if (!mainImage) {
          const firstGalleryImage = scrapedGallery.find((u) => !isVideoUrl(u));
          if (firstGalleryImage) {
            mainImage = firstGalleryImage;
            setProductField(prodImage, firstGalleryImage);
          }
        }
        const galleryToSend = scrapedGallery.slice();
        if (mainImage && !galleryToSend.includes(mainImage)) galleryToSend.unshift(mainImage);

        const productPayload = {
          id: editingId || undefined,
          title: prodTitle.value.trim(),
          price: parseFloat(prodPrice.value) || 0,
          originalPrice: prodOriginalPrice.value ? parseFloat(prodOriginalPrice.value) : optional(''),
          category: prodCategory.value.trim() || 'Tecnología',
          subcategory: document.getElementById('prodSubcategory')?.value.trim() || '',
          merchant: prodMerchant.value || 'Amazon',
          affiliateUrl: prodAffiliateUrl.value.trim(),
          buyNowUrl: optional(prodBuyNowUrl.value.trim()),
          image: mainImage,
          gallery: galleryToSend.length ? galleryToSend : undefined,
          badge: prodBadge.value.trim() || optional(''),
          description: prodDescription.value.trim(),
          verdict: optional(prodVerdict.value.trim()),
          techSheet: optional(prodTechSheet.value.trim()),
          specs: optional(textToSpecs(prodSpecs?.value)),
          brand: optional(prodBrand?.value.trim()),
          fulfillmentProvider: optional(prodFulfillment?.value.trim()),
          condition: optional(prodCondition?.value.trim()),
          rating: prodRating?.value !== '' && prodRating?.value != null
            ? Math.min(5, Math.max(0, Number(prodRating.value)))
            : optional(''),
          reviewsCount: prodReviews?.value !== '' && prodReviews?.value != null
            ? Math.max(0, Math.round(Number(prodReviews.value)))
            : optional(''),
          shippingInfo: optional(prodShippingInfo?.value.trim()),
          shippingDays: prodShippingDays?.value !== '' && prodShippingDays?.value != null
            ? Math.max(0, Math.round(Number(prodShippingDays.value)))
            : optional(''),
          freeShipping: prodFreeShipping ? prodFreeShipping.checked : optional(''),
          pros: prodPros.value
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
          cons: prodCons.value
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
          extra: window.tradylorCustomFields ? window.tradylorCustomFields.getFormValues() : undefined,
        };

        if (btnSaveProduct) {
          btnSaveProduct.disabled = true;
          btnSaveProduct.classList.add('loading');
        }
        if (btnSaveProductLabel) btnSaveProductLabel.textContent = 'Guardando...';

        showAlert(
          'loading',
          isEditing ? 'Guardando cambios...' : 'Guardando producto...',
          'Escribiendo en src/data/products.json...'
        );

        try {
          const response = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save', product: productPayload }),
          });

          const result = await response.json();

          if (result.success) {
            // Recargar lista de productos inmediatamente
            await reloadProductsTable();
            // El botón de enriquecer IA debe seguir funcionando tras guardar
            // y al pasar a editar el siguiente producto sin recargar la página.
            reinitAiEnrichButton();

            if (isEditing) {
              // Modo edición: se conserva el id y el formulario relleno para
              // seguir ajustando; sólo se avisa del guardado en el botón.
              if (result.product && result.product.id) prodId.value = result.product.id;
              flashSaveButton('Cambios guardados ✓');
              showAlert(
                'success',
                'Cambios guardados',
                result.message || 'Los cambios del producto se han guardado en el catálogo.'
              );
            } else {
              document.querySelector('section[data-admin-view="products"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
              // Dejar el formulario preparado para un producto nuevo.
              resetProductForm();
              flashSaveButton('Guardado ✓');
              showAlert('success', '¡Producto guardado!', result.message || 'El producto ha sido añadido al catálogo.');
            }
          } else {
            if (btnSaveProductLabel) btnSaveProductLabel.textContent = 'Guardar cambios';
            showAlert('error', 'Error al guardar', result.message || 'No se pudo guardar el producto.');
          }
        } catch (err) {
          console.error(err);
          if (btnSaveProductLabel) btnSaveProductLabel.textContent = 'Guardar cambios';
          showAlert('error', 'Error de red', 'No se pudo enviar la solicitud al servidor.');
        } finally {
          if (btnSaveProduct) {
            btnSaveProduct.disabled = false;
            btnSaveProduct.classList.remove('loading');
          }
        }
      });
    }

    // =========================================================================
    // 2b. ENRIQUECIMIENTO CON IA (texto + imagen) — POST /api/admin/add-product
    //     1) Ficha técnica, pros/contras y veredicto neutral (OpenAI / Claude)
    //     2) Imagen de producto generada con el prompt comercial (OpenAI / Flux)
    //     Rellena el formulario en modo vista previa: quien decide guarda.
    // =========================================================================
    // Enriquecer con IA (usado por el botón y de forma automática tras analizar un enlace).
    const runAiEnrich = async ({ auto = false } = {}) => {
      const title = (prodTitle.value || '').trim();
      if (!title) {
        if (!auto) {
          showAlert('error', 'Falta el título', 'Escribe el título del producto antes de pedir el enriquecimiento con IA.');
          prodTitle.focus();
        }
        return;
      }

      btnAiEnrich.disabled = true;
      btnAiEnrich.classList.add('loading');
      showAlert(
        'loading',
        'Trabajando con IA...',
        auto
          ? 'Sintetizando título, precios y ficha técnica, pros/contras y veredicto...'
          : 'Paso 1: título, ficha y precios con descuento realista · Paso 2: imagen de producto mejorada.'
      );

      try {
        const response = await fetch('/api/admin/add-product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: (prodId.value || '').trim() || undefined,
            title,
            description: (prodDescription.value || '').trim(),
            category: (prodCategory.value || '').trim() || undefined,
            price: parseFloat(prodPrice.value) || undefined,
            originalPrice: prodOriginalPrice.value ? parseFloat(prodOriginalPrice.value) : undefined,
            image: (prodImage.value || '').trim() || undefined,
            affiliateUrl: (prodAffiliateUrl.value || '').trim() || undefined,
            merchant: prodMerchant.value || undefined,
            url: inputScrapeUrl && inputScrapeUrl.value ? inputScrapeUrl.value.trim() || undefined : undefined,
            brand: scrapeExtras.brand || undefined,
            rating: scrapeExtras.rating ?? undefined,
            reviewsCount: scrapeExtras.reviewsCount ?? undefined,
            specs: scrapeExtras.specs || undefined,
            pros: prodPros.value.split('\n').map((s) => s.trim()).filter(Boolean),
            cons: prodCons.value.split('\n').map((s) => s.trim()).filter(Boolean),
            techSheet: (prodTechSheet.value || '').trim() || undefined,
            // En auto solo texto (rápido): la imagen real del scraping se conserva.
            options: { text: true, image: !auto, save: false },
          }),
        });

        let result;
        try {
          result = await response.json();
        } catch {
          // Respuesta no-JSON (p. ej. 504 de proxy en HTML por timeout).
          if (response.ok) {
            showAlert('success', 'Contenido generado con IA', 'Revisa los campos y pulsa «Guardar cambios» para publicarlo.');
          } else {
            showAlert(
              'error',
              `El servidor devolvió ${response.status}`,
              response.status === 504 || response.status === 524
                ? 'La llamada a la IA tardó demasiado y un proxy la cortó. Pulsa «Generar con IA» para reintentar solo el texto.'
                : 'Respuesta inesperada del servidor. Revisa los logs o reintenta.'
            );
          }
          return;
        }

        if (result.success) {
          const enriched = result.product || {};
          const flags = result.enrichment || { text: 'skipped', image: 'skipped', warnings: [] };

          if (flags.text === 'ok' || flags.text === 'local') {
            // Título sintetizado: corto, solo la definición del producto.
            if (enriched.title) prodTitle.value = enriched.title;
            if (enriched.description) prodDescription.value = enriched.description;
            if (enriched.verdict) prodVerdict.value = enriched.verdict;
            if (enriched.techSheet) prodTechSheet.value = enriched.techSheet;
            if (Array.isArray(enriched.pros) && enriched.pros.length) prodPros.value = enriched.pros.join('\n');
            if (Array.isArray(enriched.cons) && enriched.cons.length) prodCons.value = enriched.cons.join('\n');
            if (enriched.category && !(prodCategory.value || '').trim()) prodCategory.value = enriched.category;
            // Precios: oferta + original tachado con descuento realista (15–35 %).
            if (Number(enriched.price) > 0) prodPrice.value = String(enriched.price);
            if (Number(enriched.originalPrice) > Number(enriched.price)) {
              prodOriginalPrice.value = String(enriched.originalPrice);
            }
          }
          if (flags.image === 'ok' && enriched.image) {
            // La imagen generada con IA lleva fondo de estudio opaco (#F8F9FA),
            // igual que la ficha y las cards: siempre encaja en el carrusel.
            if (!scrapedGallery.includes(enriched.image)) scrapedGallery.unshift(enriched.image);
            const currentMain = (prodImage.value || '').trim();
            const mainIsLocal = /^\/images\//.test(currentMain);
            // Se hace principal si no había imagen o si la actual es externa
            // (fondo desconocido); la original se conserva en la galería.
            if (!currentMain || !mainIsLocal) setProductField(prodImage, enriched.image);
            renderGallery();
          }

          updatePreview();

          const via = flags.text === 'ok' ? 'IA' : 'local (sin IA)';
          const summary = auto
            ? `Título + ficha + precios generados ${via} · Imagen: conservada (${flags.image === 'ok' ? 'IA añadida a la galería' : 'scraping'})`
            : `Título + ficha + precios: ${via} · Imagen: ${flags.image === 'ok' ? 'generada con fondo de estudio (IA)' : flags.image}`;
          const warnings =
            Array.isArray(flags.warnings) && flags.warnings.length
              ? ` Avisos: ${flags.warnings.join(' | ')}`
              : '';
          showAlert(
            'success',
            'Ficha de producto generada',
            `${summary}. Revisa los campos y pulsa «Guardar cambios» para publicarlo.${warnings}`
          );
        } else {
          showAlert('error', 'No se pudo generar la ficha', result.message || 'Revisa la configuración del servidor.');
        }
      } catch (err) {
        console.error(err);
        showAlert(
          'error',
          'No se pudo contactar con el servidor',
          'Fallo al llamar a /api/admin/add-product. Revisa tu conexión o reintenta.'
        );
      } finally {
        btnAiEnrich.disabled = false;
        btnAiEnrich.classList.remove('loading');
      }
    };

    // Se usa onclick (no addEventListener) para que el listener se reemplace
    // en cada inicialización y el botón "Enriquecer con IA" siga funcionando
    // al editar un segundo producto sin tener que recargar la página.
    if (btnAiEnrich) {
      btnAiEnrich.onclick = () => runAiEnrich();
    }

    // Re-inicializa el botón de enriquecer IA tras guardar o editar un producto,
    // para que nunca quede "atascado" entre ediciones sucesivas.
    function reinitAiEnrichButton() {
      if (btnAiEnrich) btnAiEnrich.onclick = () => runAiEnrich();
    }

    // =========================================================================
    // 2c. SINTETIZAR TÍTULO AL PEGAR
    //     Al pegar un título largo (Amazon, AliExpress...) se reduce a la
    //     definición del producto para que quepa en las product-cards.
    //     Con IA si hay claves; si no, con la heurística local del servidor.
    // =========================================================================
    let titleSynthTimer = null;
    let titleSynthSeq = 0;
    async function synthesizeTitleField() {
      const snapshot = (prodTitle.value || '').trim();
      if (!snapshot || snapshot.length <= 40) return;
      const seq = ++titleSynthSeq;
      try {
        const response = await fetch('/api/admin/synthesize-title', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: snapshot,
            description: (prodDescription.value || '').trim() || undefined,
            brand: scrapeExtras.brand || undefined,
            category: (prodCategory.value || '').trim() || undefined,
          }),
        });
        const result = await response.json();
        if (seq !== titleSynthSeq) return;
        const shortTitle = String(result?.title || '').trim();
        // Solo aplica si el usuario no siguió escribiendo mientras tanto.
        if (shortTitle && shortTitle !== snapshot && (prodTitle.value || '').trim() === snapshot) {
          setProductField(prodTitle, shortTitle);
          updatePreview();
        }
      } catch (err) {
        console.warn('No se pudo sintetizar el título:', err);
      }
    }
    if (prodTitle) {
      prodTitle.addEventListener('paste', () => {
        window.clearTimeout(titleSynthTimer);
        titleSynthTimer = window.setTimeout(synthesizeTitleField, 500);
      });
    }

    // =========================================================================
    // 4. ELIMINAR Y EDITAR PRODUCTOS DE LA TABLA
    // =========================================================================
     async function reloadProductsTable() {
      try {
        const res = await fetch('/api/products/add');
        const data = await res.json();
        if (data.success && Array.isArray(data.products)) {
          currentProducts = data.products;
          aliInvalidateEstado();
          prodBuildRanges();
          syncNetworkFilter();
          syncCatNetworkFilter();
          syncSubcatNetworkFilter();
          prodFilterApply();
          // El filtro «Estado» de la tabla de afiliados se calcula con esta lista.
          try {
            if (aliFilterPanel) aliFilterPanel.refresh();
          } catch { /* el panel de filtros de afiliados aún no está montado */ }
          // Y su TABLA se repinta: al dar de alta/borrar productos cambia el
          // índice de estados (chips «✓ en catálogo», botón «Añadido» y contador).
          try {
            renderAliCatalog();
          } catch { /* la tabla de afiliados aún no está montada */ }
        }
      } catch (err) {
        console.error('Error al recargar productos:', err);
      }
    }

const USED_CONDITION_RE = /used|pre-owned|refurbished|reacondicionad|segunda\s*mano|usad[oa]|open\s*box|seminuev/i;

/** Pastilla de «Estado» para el Catálogo de Productos Registrados (producto ya guardado: campo `condition` o, en su defecto, `specs`). */
function prodConditionBadge(p) {
  const raw = p.condition || (p.specs && (p.specs['Estado'] || p.specs['Condición'] || p.specs['Condition']));
  if (!raw) return '<span class="cond-pill cond-unknown">—</span>';
  const isUsed = USED_CONDITION_RE.test(String(raw));
  if (isUsed) return '<span class="cond-pill cond-used" title="Reacondicionado por el vendedor">RxV</span>';
  const text = escapeHtml(String(raw));
  return `<span class="cond-pill cond-new">${text}</span>`;
}

function renderTableRows(products, resetPage = true) {
      if (!productsTableBody) return;

      // Guardar productos filtrados para paginación
      filteredProducts = products;

      // Resetear a la primera página al cambiar filtros (salvo en paginación)
      if (resetPage) currentPage = 1;

      // Actualizar controles de paginación
      updatePaginationControls();

      const totalProducts = products.length;
      const totalPages = Math.ceil(totalProducts / PRODUCTS_PER_PAGE);
      const startIndex = (currentPage - 1) * PRODUCTS_PER_PAGE;
      const endIndex = Math.min(startIndex + PRODUCTS_PER_PAGE, totalProducts);
      const pageProducts = products.slice(startIndex, endIndex);

      // Actualizar info de total
      const paginationTotal = document.getElementById('paginationTotal');
      const paginationTotalTop = document.getElementById('paginationTotalTop');
      const startShown = startIndex + 1;
      const endShown = endIndex;
      const infoText = `Mostrando ${startShown}–${endShown} de ${totalProducts}`;
      if (paginationTotal) paginationTotal.textContent = infoText;
      if (paginationTotalTop) paginationTotalTop.textContent = infoText;

      if (pageProducts.length === 0) {
        productsTableBody.innerHTML = `
          <tr class="empty-row">
            <td colspan="9">No hay productos registrados en el catálogo aún.</td>
          </tr>
        `;
        return;
      }

      // Categorías para los selects en cascada de la fila expandida.
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
      const rootCats = allCats.filter((c) => !c.parentId);
      const subcatOptionsFor = (categoryId, categoryName, selectedSubId) => {
        const parent = allCats.find((c) => c.id === categoryId)
          || rootCats.find((c) => c.name === categoryName);
        const subs = parent ? allCats.filter((c) => c.parentId === parent.id) : [];
        return '<option value="">— Sin subcategoría —</option>' + subs.map((c) =>
          `<option value="${escapeHtml(c.id)}"${c.id === selectedSubId ? ' selected' : ''}>${escapeHtml(c.name)}</option>`
        ).join('');
      };
      const catSelectOptionsFor = (categoryId, categoryName) => 
        '<option value="">— Sin categoría —</option>' + rootCats.map((c) =>
        `<option value="${escapeHtml(c.id)}"${(categoryId ? c.id === categoryId : c.name === categoryName) ? ' selected' : ''}>${escapeHtml(c.name)}</option>`
      ).join('');

      productsTableBody.innerHTML = pageProducts
        .map(
          (p, index) => `
          <tr data-product-id="${p.id}" class="product-row" data-prod-row="${index}">
            <td class="col-check"><input type="checkbox" data-prod-check data-id="${p.id}" aria-label="Seleccionar producto" /></td>
            <td class="col-thumb">
              <img src="${p.image}" alt="${p.title}" class="thumb-img" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=800&auto=format&fit=crop'" />
            </td>
            <td class="col-details">
              ${(() => {
                const targetSlug = (p.slug && p.slug.trim() && p.slug !== 'undefined' && p.slug !== 'null') ? p.slug.trim() : p.id;
                const displayTitle = p.title_short || p.title;
                return `<a href="/producto/${encodeURIComponent(targetSlug)}" class="row-title" data-id="${p.id}" data-slug="${p.slug || ''}" target="_blank" rel="noopener" title="Ver ficha pública del producto">${escapeHtml ? escapeHtml(displayTitle) : displayTitle}</a>`;
              })()}
              <div class="row-meta">
                <span class="pill-category">${p.category || '—'}</span>
                ${p.subcategory_id ? `<span class="pill-subcategory">${escapeHtml((allCats.find((c) => c.id === p.subcategory_id) || {}).name || p.subcategory_id)}</span>` : ''}
                ${p.badge ? `<span class="pill-badge">${p.badge}</span>` : ''}
                ${p.is_duplicate ? `<span class="dup-pill" title="Duplicado ${p.duplicate_reason ? `(${p.duplicate_reason})` : ''}${p.duplicate_of ? ` de ${p.duplicate_of}` : ''}">${p.possible_duplicate ? '♻️ ¿Dup?' : '♻️ Dup'}</span>` : ''}
              </div>
            </td>
            <td class="col-merchant"><span class="merchant-badge" title="${p.merchant ? `Comerciante: ${escapeHtml(p.merchant)}` : 'Red de afiliados'}">${escapeHtml(p.network_label || p.merchant || '—')}</span></td>
            <td class="col-condition">${prodConditionBadge(p)}</td>
            <td class="col-price">
              <span class="price-val">${Number(p.price).toFixed(2)} €</span>
              ${p.originalPrice ? `<span class="price-old">${Number(p.originalPrice).toFixed(2)} €</span>` : ''}
            </td>
            <td class="col-score">
              ${(() => {
                const score = Number(p.conversion_score) || 0;
                const level = score > 75 ? 'high' : score >= 40 ? 'mid' : 'low';
                const icon = level === 'high' ? '🔥' : level === 'mid' ? '⚡' : '❄️';
                const label = level === 'high' ? 'Alta rentabilidad' : level === 'mid' ? 'Rentabilidad media' : 'Bajo';
                return `<span class="score-badge score-${level}" title="${label} — score ${score}/100">
                  <span class="score-badge-value">${icon} ${score}</span>
                  <span class="score-bar"><span class="score-bar-fill" style="width:${Math.max(0, Math.min(100, score))}%"></span></span>
                </span>`;
              })()}
            </td>
            <td class="col-link">
              <a href="${p.affiliateUrl}" target="_blank" rel="nofollow noopener noreferrer" class="test-link">Probar Enlace</a>
            </td>
            <td class="col-actions text-right">
              ${(() => {
                const targetSlug = (p.slug && p.slug.trim() && p.slug !== 'undefined' && p.slug !== 'null') ? p.slug.trim() : p.id;
                return `<a href="/producto/${encodeURIComponent(targetSlug)}" class="btn-icon-action btn-preview-card" data-id="${p.id}" data-slug="${p.slug || ''}" target="_blank" rel="noopener" title="👁️ Ver ficha del producto" aria-label="Ver ficha del producto">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </a>`;
              })()}
              <button type="button" class="btn-icon-action btn-link-alternatives" data-id="${p.id}" title="🔗 Vincular Alternativas">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              </button>
              <button type="button" class="btn-icon-action btn-edit-row" data-id="${p.id}" title="Cargar en formulario">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              </button>
              <button type="button" class="btn-icon-action btn-delete-row" data-id="${p.id}" title="Eliminar producto">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
              <button type="button" class="btn-icon-action btn-prod-detail" data-id="${p.id}" title="Ver todos los datos" data-idx="${index}" aria-expanded="false" aria-label="Ver todos los datos">
                <svg class="prod-detail-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </td>
          </tr>
          <tr class="product-detail-row" data-prod-detail="${index}" hidden>
            <td colspan="11"><dl class="aff-detail-grid">
              <div class="aff-detail-item"><dt>Título</dt><dd>${escapeHtml ? escapeHtml(p.title) : p.title}</dd></div>
              <div class="aff-detail-item"><dt>Categoría</dt><dd>${p.category || '—'}</dd></div>
              <div class="aff-detail-item aff-detail-curate"><dt>Categorización (edición rápida)</dt><dd class="aff-curate-controls">
                <select class="row-cat-select" data-id="${p.id}" aria-label="Categoría del producto">${catSelectOptionsFor(p.category_id, p.category)}</select>
                <select class="row-subcat-select" data-id="${p.id}" aria-label="Subcategoría del producto">${subcatOptionsFor(p.category_id, p.category, p.subcategory_id)}</select>
              </dd></div>
              <div class="aff-detail-item"><dt>Red de afiliados</dt><dd>${escapeHtml(p.network_label || '—')}</dd></div>
              <div class="aff-detail-item"><dt>Comerciante</dt><dd>${escapeHtml(p.merchant || '—')}</dd></div>
              ${p.brand ? `<div class="aff-detail-item"><dt>Marca</dt><dd>${escapeHtml ? escapeHtml(p.brand) : p.brand}</dd></div>` : ''}
              ${p.fulfillmentProvider && p.fulfillmentProvider !== p.merchant ? `<div class="aff-detail-item"><dt>Distribuidor</dt><dd>${escapeHtml ? escapeHtml(p.fulfillmentProvider) : p.fulfillmentProvider}</dd></div>` : ''}
              <div class="aff-detail-item"><dt>Precio</dt><dd>${Number(p.price).toFixed(2)} €</dd></div>
              ${p.originalPrice ? `<div class="aff-detail-item"><dt>Precio original</dt><dd>${Number(p.originalPrice).toFixed(2)} €</dd></div>` : ''}
              <div class="aff-detail-item"><dt>Score de conversión</dt><dd>${Number(p.conversion_score) || 0}/100 ${p.commissionEstimate != null ? `· comisión est. ${Number(p.commissionEstimate).toFixed(2)} €` : ''}${p.sales30d != null ? ` · ${Number(p.sales30d)} ventas/30d` : ''}</dd></div>
              <div class="aff-detail-item"><dt>Estados editoriales</dt><dd>
                <span class="state-pill state-${escapeHtml ? escapeHtml(p.ia_status || 'pending') : (p.ia_status || 'pending')}">IA: ${p.ia_status || 'pending'}</span>
                <span class="state-pill state-${escapeHtml ? escapeHtml(p.link_status || 'pending') : (p.link_status || 'pending')}">Enlace: ${p.link_status || 'pending'}</span>
                ${p.is_duplicate ? `<span class="state-pill state-dup">♻️ ${p.possible_duplicate ? 'posible duplicado' : 'duplicado'}${p.duplicate_of ? ` de ${p.duplicate_of}` : ''}</span>` : ''}
              </dd></div>
              ${Array.isArray(p.normalized_tags) && p.normalized_tags.length ? `<div class="aff-detail-item"><dt>Tags normalizados (${p.normalized_tags.length})</dt><dd class="tag-chip-list">${p.normalized_tags.map((t) => `<span class="tag-chip">${escapeHtml ? escapeHtml(t) : t}</span>`).join('')}</dd></div>` : ''}
              <div class="aff-detail-item"><dt>Alternativas vinculadas</dt><dd>
                ${(() => {
                  const a = p.alternatives || {};
                  const links = Array.isArray(p.alternative_product_ids) ? p.alternative_product_ids.length : 0;
                  const premium = a.premiumOptionId ? 1 : 0;
                  const cheaper = (Array.isArray(a.cheaperOptionIds) ? a.cheaperOptionIds.length : 0) || (a.cheaperOptionId ? 1 : 0);
                  const similar = (Array.isArray(a.similarOptionIds) ? a.similarOptionIds.length : 0) || (a.similarOptionId ? 1 : 0);
                  if (!links && !premium && !cheaper && !similar) return 'Ninguna';
                  return `${links} vínculo(s) · ⭐ ${premium} principal · 💰 ${cheaper} económica(s) · 🎯 ${similar} competidor(es)`;
                })()}
                <button type="button" class="btn-secondary btn-sm btn-link-alternatives" data-id="${p.id}">🔗 Vincular Alternativas</button>
              </dd></div>
              ${p.rating != null ? `<div class="aff-detail-item"><dt>Valoración</dt><dd>${Number(p.rating).toFixed(1)} ★ ${p.reviewsCount != null ? `(${p.reviewsCount} opiniones)` : ''}</dd></div>` : ''}
              ${p.badge ? `<div class="aff-detail-item"><dt>Badge</dt><dd>${p.badge}</dd></div>` : ''}
              ${p.description ? `<div class="aff-detail-item"><dt>Descripción</dt><dd>${escapeHtml ? escapeHtml(p.description) : p.description}</dd></div>` : ''}
              ${p.verdict ? `<div class="aff-detail-item"><dt>Veredicto</dt><dd>${escapeHtml ? escapeHtml(p.verdict) : p.verdict}</dd></div>` : ''}
              ${p.techSheet ? `<div class="aff-detail-item"><dt>Ficha técnica</dt><dd>${escapeHtml ? escapeHtml(p.techSheet) : p.techSheet}</dd></div>` : ''}
              ${p.shippingInfo ? `<div class="aff-detail-item"><dt>Envío</dt><dd>${p.shippingInfo}${p.shippingDays != null ? ` (${p.shippingDays} d)` : ''}${p.freeShipping ? ' · gratis' : ''}</dd></div>` : ''}
              ${p.buyNowUrl ? `<div class="aff-detail-item"><dt>Compra directa</dt><dd><a href="${p.buyNowUrl}" target="_blank" rel="nofollow noopener" class="test-link">Abrir Buy Now</a></dd></div>` : ''}
              <div class="aff-detail-item aff-detail-url"><dt>Enlace Afiliado</dt><dd><span class="url-chip"><a href="${p.affiliateUrl || '#'}" target="_blank" rel="nofollow noopener noreferrer" class="url-chip-text" title="${p.affiliateUrl || ''}" style="word-break:break-all;">${p.affiliateUrl ? (escapeHtml ? escapeHtml(p.affiliateUrl) : p.affiliateUrl) : '— Sin enlace de afiliado —'}</a><button type="button" class="url-chip-btn url-chip-copy" data-url="${p.affiliateUrl || ''}" title="Copiar enlace" aria-label="Copiar enlace"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button><button type="button" class="url-chip-btn url-chip-toggle" title="Mostrar u ocultar la URL completa" aria-label="Desplegar URL"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></span></dd></div>
              ${p.specs && Object.keys(p.specs).length ? `<div class="aff-detail-item"><dt>Especificaciones</dt><dd>${Object.entries(p.specs).map(([k, v]) => `${escapeHtml ? escapeHtml(k) : k}: ${escapeHtml ? escapeHtml(String(v)) : v}`).join(' · ')}</dd></div>` : ''}
              ${Array.isArray(p.pros) && p.pros.length ? `<div class="aff-detail-item"><dt>Pros</dt><dd>${p.pros.join(' · ')}</dd></div>` : ''}
              ${Array.isArray(p.cons) && p.cons.length ? `<div class="aff-detail-item"><dt>Contras</dt><dd>${p.cons.join(' · ')}</dd></div>` : ''}
              ${p.condition ? `<div class="aff-detail-item"><dt>Estado físico</dt><dd>${escapeHtml ? escapeHtml(p.condition) : p.condition}</dd></div>` : ''}
              ${(() => {
                // Datos crudos de la red de origen capturados en «Importar»/«Construir
                // Catálogo»: igual que la tabla de Importar, se listan aquí para que
                // «coincidan los datos de la tabla catálogo con los de Importar».
                const raw = [
                  ['Red', p.network],
                  ['Divisa', p.currency],
                  ['Comisión (%)', p.commissionRate != null ? `${p.commissionRate}%` : null],
                  ['Stock', typeof p.inStock === 'boolean' ? (p.inStock ? 'En stock' : 'Sin stock') : null],
                  ['Visitas', p.visits],
                ].filter(([, v]) => v != null && v !== '');
                return raw.map(([k, v]) => `<div class="aff-detail-item"><dt>${k}</dt><dd>${escapeHtml ? escapeHtml(String(v)) : v}</dd></div>`).join('');
              })()}
              ${(() => {
                // Resto de `extra` específico del conector (Tienda, Almacén Local,
                // Comisión Hot, Choice...), excluyendo el bloque interno `crossMerchant`.
                if (!p.extra || typeof p.extra !== 'object') return '';
                return Object.entries(p.extra)
                  .filter(([k, v]) => k !== 'crossMerchant' && v != null && v !== '' && typeof v !== 'object')
                  .map(([k, v]) => `<div class="aff-detail-item"><dt>${escapeHtml ? escapeHtml(k) : k}</dt><dd>${escapeHtml ? escapeHtml(String(v)) : v}</dd></div>`)
                  .join('');
              })()}
              ${Array.isArray(p.gallery) && p.gallery.length ? `<div class="aff-detail-item is-images"><dt>Galería (${p.gallery.length})</dt><dd class="aff-detail-thumbs">${p.gallery.map((u)=>`<a href="${u}" target="_blank" rel="noopener noreferrer"><img src="${u}" alt="" loading="lazy" /></a>`).join('')}</dd></div>` : ''}
            </dl></td>
          </tr>
        `
        )
        .join('');

      attachRowActions();
    }

     function attachRowActions() {
      // Mostrar/ocultar la fila de detalle de un producto
      document.querySelectorAll('.btn-prod-detail').forEach((btn) => {
        const idx = btn.getAttribute('data-idx');
        const detail = document.querySelector(`[data-prod-detail="${idx}"]`);
        if (detail && !detail.hidden) {
          btn.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }

        btn.onclick = (e) => {
          e.stopPropagation();
          const idx = btn.getAttribute('data-idx');
          const detail = document.querySelector(`[data-prod-detail="${idx}"]`);
          if (detail) {
            const open = detail.hidden;
            detail.hidden = !open;
            btn.classList.toggle('is-open', open);
            btn.setAttribute('aria-expanded', String(open));
          }
        };
      });

      // Checkboxes
      document.querySelectorAll('[data-prod-check]').forEach((box) => {
        const id = box.getAttribute('data-id');
        box.checked = selectedProductIds.has(id);
        box.onchange = () => {
          if (box.checked) selectedProductIds.add(id); else selectedProductIds.delete(id);
          updateProdSelCount();
        };
      });

      // 1. Borrar producto
      document.querySelectorAll('.btn-delete-row').forEach((btn) => {
        btn.onclick = async () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;

          const confirmed = confirm(`¿Estás seguro de que deseas eliminar este producto del catálogo?`);
          if (!confirmed) return;

          showAlert('loading', 'Eliminando producto...', `Eliminando ID: ${id}`);

          try {
            const res = await fetch('/api/products/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ product_ids: [id] }),
            });
            const data = await res.json();

            if (data.success) {
              showAlert('success', 'Producto Eliminado', 'El producto ha sido retirado de products.json.');
              await reloadProductsTable();
            } else {
              showAlert('error', 'Error al eliminar', data.message || 'No se pudo eliminar el producto.');
            }
          } catch (err) {
            showAlert('error', 'Error de red', 'Fallo al comunicar con el servidor.');
          }
        };
      });

      // 2. Editar producto (cargar en formulario)
      document.querySelectorAll('.btn-edit-row').forEach((btn) => {
        btn.onclick = async () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;

          // Despliega el panel «Extracción & Alta de Producto» y sube a su
          // inicio para poder editar sin tener que abrirlo a mano.
          setFormPanelExpanded(true);
          scrollToFormPanel();

          try {
            const res = await fetch('/api/products/add');
            const data = await res.json();
            const product = (data.products || []).find((p) => p.id === id);

            if (product) {
              prodId.value = product.id || '';
              prodTitle.value = product.title || '';
              prodPrice.value = product.price !== undefined ? product.price : '';
              prodOriginalPrice.value = product.originalPrice !== undefined ? product.originalPrice : '';
              prodCategory.value = product.category || '';
              // Sincroniza el selector de subcategoría con la del producto.
              syncProductFormSubcategories();
              const prodSubcategory = document.getElementById('prodSubcategory');
              if (prodSubcategory) {
                const allCats = Array.isArray(categoriesCache) ? categoriesCache : [];
                const sub = product.subcategory_id
                  ? allCats.find((c) => c.id === product.subcategory_id)
                  : undefined;
                prodSubcategory.value = sub?.name || '';
              }
              // Auto-selecciona el comerciante del producto en el select del formulario.
              // Si el comerciante no está entre las opciones fijas, se añade como opción personalizada.
              const merchantValue = product.merchant || 'Amazon';
              if (prodMerchant) {
                let found = false;
                for (const opt of prodMerchant.options) {
                  if (opt.value === merchantValue) { found = true; break; }
                }
                if (!found && merchantValue) {
                  const customOpt = document.createElement('option');
                  customOpt.value = merchantValue;
                  customOpt.textContent = merchantValue;
                  prodMerchant.appendChild(customOpt);
                }
                prodMerchant.value = merchantValue;
              }
              prodAffiliateUrl.value = product.affiliateUrl || '';
              prodBuyNowUrl.value = product.buyNowUrl || '';
              prodImage.value = product.image || '';
              const badgeValue = product.badge || '';
              if (badgeValue && prodBadge && !Array.from(prodBadge.options).some((o) => o.value === badgeValue)) {
                const customOpt = document.createElement('option');
                customOpt.value = badgeValue;
                customOpt.textContent = badgeValue;
                prodBadge.appendChild(customOpt);
              }
              prodBadge.value = badgeValue;
              prodDescription.value = product.description || '';
              prodVerdict.value = product.verdict || '';
              prodTechSheet.value = product.techSheet || '';
              prodPros.value = Array.isArray(product.pros) ? product.pros.join('\n') : '';
              prodCons.value = Array.isArray(product.cons) ? product.cons.join('\n') : '';
              if (prodShippingInfo) prodShippingInfo.value = product.shippingInfo || '';
              if (prodShippingDays) prodShippingDays.value = product.shippingDays != null ? String(product.shippingDays) : '';
              if (prodFreeShipping) prodFreeShipping.checked = product.freeShipping === true;
              if (prodBrand) prodBrand.value = product.brand || '';
              if (prodFulfillment) prodFulfillment.value = product.fulfillmentProvider || '';
              if (prodCondition) prodCondition.value = product.condition || '';
              if (prodRating) prodRating.value = product.rating != null ? String(product.rating) : '';
              if (prodReviews) prodReviews.value = product.reviewsCount != null ? String(product.reviewsCount) : '';
              if (prodSpecs) prodSpecs.value = specsToText(product.specs);
              if (window.tradylorCustomFields) window.tradylorCustomFields.setFormValues(product.extra);
              scrapeExtras = {
                brand: product.brand || '',
                rating: product.rating ?? null,
                reviewsCount: product.reviewsCount ?? null,
                specs: product.specs && typeof product.specs === 'object' ? product.specs : null,
              };

              // Restaurar la galería guardada del producto (evita perderla al volver a guardar).
              scrapedGallery = Array.isArray(product.gallery) && product.gallery.length
                ? product.gallery.slice()
                : (product.image ? [product.image] : []);
              renderGallery();

              if (inputScrapeUrl) inputScrapeUrl.value = product.affiliateUrl || '';

              updatePreview();
              // El botón de enriquecer IA debe estar operativo al editar este producto.
              reinitAiEnrichButton();
              showAlert('success', 'Producto Cargado en Formulario', `Editando "${product.title}". Modifica los campos y pulsa "Guardar cambios".`);
              // Despliega el panel de edición y nos coloca en su inicio.
              setFormPanelExpanded(true);
              scrollToFormPanel();
            }
          } catch (err) {
            console.error(err);
          }
        };
      });
    }

    // Filtros de rango del «Catálogo de Productos Registrados» (mismo diseño
    // que la tabla de Afiliados): precio con par mínimo/máximo, descuento con
    // select de rangos y valoración con select de umbral.
    let prodSortDir = 'desc';
    const PROD_DISCOUNT_RANGES = [
      { value: '0-10', label: '0% – 10%', min: 0, max: 10 },
      { value: '10-20', label: '10% – 20%', min: 10, max: 20 },
      { value: '20-30', label: '20% – 30%', min: 20, max: 30 },
    ];
    const PROD_RATING_OPTIONS = [
      { value: '4', label: '≥ 4,0 ★' },
      { value: '4.5', label: '≥ 4,5 ★' },
      { value: '4.6', label: '≥ 4,6 ★' },
      { value: '4.8', label: '≥ 4,8 ★' },
    ];

    function prodDiscountPct(p) {
      const original = Number(p.originalPrice) || 0;
      const price = Number(p.price) || 0;
      return original > price && price > 0 ? Math.round(((original - price) / original) * 100) : 0;
    }

    /** Construye los controles de rango: precio min/máx, valoración y descuento. */
    function prodBuildRanges() {
      if (!prodRangeFields) return;
      // Conserva los valores ya escritos por el usuario al repintar la tabla.
      const keepPriceMin = document.getElementById('prodFPriceMin')?.value || '';
      const keepPriceMax = document.getElementById('prodFPriceMax')?.value || '';
      const keepDisc = document.getElementById('prodFDiscRange')?.value || '';
      const keepRating = document.getElementById('prodFRatingMin')?.value || '';
      // El botón "Limpiar filtros" y los controles de selección (contador +
      // Catálogo + Limpiar) viven dentro del contenedor: se guardan las
      // referencias antes de repintar (si no, el innerHTML las destruiría).
      const resetBtn = document.getElementById('prodFReset');
      const selCount = document.getElementById('productSelCount');
      const selAllBtn = document.getElementById('btnProdSelAll');
      const selClearBtn = document.getElementById('btnProdSelClear');
      const prices = currentProducts.map((p) => Number(p.price)).filter((v) => Number.isFinite(v) && v > 0);
      const dataMin = prices.length ? Math.floor(Math.min(...prices)) : 0;
      const dataMax = prices.length ? Math.ceil(Math.max(...prices)) : 0;
      prodRangeFields.innerHTML = `
        <div class="filter-field prod-range-field" data-range-field="rating">
          <label for="prodFRatingMin">Valoración</label>
          <select id="prodFRatingMin">
            <option value="">Cualquiera</option>
            ${PROD_RATING_OPTIONS.map((r) => `<option value="${r.value}"${r.value === keepRating ? ' selected' : ''}>${escapeHtml(r.label)}</option>`).join('')}
          </select>
        </div>
        <div class="filter-field prod-range-field" data-range-field="price">
          <label for="prodFPriceMin">Precio (€)</label>
          <div class="ali-pair">
            <input type="number" id="prodFPriceMin" min="${dataMin}" step="0.01" placeholder="Mín." inputmode="decimal" autocomplete="off" value="${escapeHtml(keepPriceMin)}" style="background:var(--color-bg-main);color:var(--color-text-main);border:1px solid var(--color-border);border-radius:var(--border-radius-sm);padding:.45rem .6rem;outline:none;" />
            <span class="ali-pair-sep" aria-hidden="true">–</span>
            <input type="number" id="prodFPriceMax" max="${dataMax}" step="0.01" placeholder="Máx." inputmode="decimal" autocomplete="off" value="${escapeHtml(keepPriceMax)}" style="background:var(--color-bg-main);color:var(--color-text-main);border:1px solid var(--color-border);border-radius:var(--border-radius-sm);padding:.45rem .6rem;outline:none;" />
          </div>
        </div>
        <div class="filter-field prod-range-field" data-range-field="disc">
          <label for="prodFDiscRange">Descuento</label>
          <select id="prodFDiscRange">
            <option value="">Cualquiera</option>
            ${PROD_DISCOUNT_RANGES.map((r) => `<option value="${r.value}"${r.value === keepDisc ? ' selected' : ''}>${escapeHtml(r.label)}</option>`).join('')}
          </select>
        </div>`;
      // Orden pedido: Valoración, después Precio, después Descuento y, al final,
      // el botón "Limpiar filtros" seguido de Selección (contador + Catálogo +
      // Limpiar). Se mueven (no se recrean) para no perder sus listeners.
      if (resetBtn) {
        const discField = prodRangeFields.querySelector('[data-range-field="disc"]');
        if (discField) prodRangeFields.insertBefore(resetBtn, discField.nextSibling);
        resetBtn.after(...[selCount, selAllBtn, selClearBtn].filter(Boolean));
      }
    }

    /** Lee los tres controles de rango tal y como están ahora en el DOM. */
    function prodReadRangeFilters() {
      const priceMin = parseFloat(document.getElementById('prodFPriceMin')?.value);
      const priceMax = parseFloat(document.getElementById('prodFPriceMax')?.value);
      const discValue = document.getElementById('prodFDiscRange')?.value || '';
      const rating = parseFloat(document.getElementById('prodFRatingMin')?.value);
      return {
        priceMin: Number.isFinite(priceMin) ? priceMin : null,
        priceMax: Number.isFinite(priceMax) ? priceMax : null,
        discRange: PROD_DISCOUNT_RANGES.find((r) => r.value === discValue) || null,
        ratingMin: Number.isFinite(rating) ? rating : null,
      };
    }

    function getProdModelKey(p) {
      if (!p) return '';
      if (p.duplicate_group) return 'dg:' + p.duplicate_group;
      if (p.sourceId) return 'src:' + String(p.sourceId).trim().toLowerCase();
      if (p.asin) return 'asin:' + String(p.asin).trim().toLowerCase();
      const norm = String(p.title_short || p.title || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
      const tokens = norm.split(/\s+/).filter(Boolean).slice(0, 5).join(' ');
      return tokens ? 'tok:' + tokens : 'id:' + String(p.id || '');
    }

    function getProdTypeKey(p) {
      if (!p) return 'otros';
      return String(p.subcategory_id || p.category || p.category_id || 'otros').trim().toLowerCase();
    }

    function applyCatalogDiversity(products) {
      if (!Array.isArray(products) || products.length <= 1) return products;

      const pool = products.slice();
      const result = [];
      const rowSize = 4;
      const pageSize = typeof PRODUCTS_PER_PAGE === 'number' ? PRODUCTS_PER_PAGE : 50;
      let currentPageModels = new Set();

      while (pool.length > 0) {
        const nextIdx = result.length;
        if (nextIdx > 0 && nextIdx % pageSize === 0) {
          currentPageModels.clear();
        }

        const prev = result[result.length - 1];
        const prevModel = prev ? getProdModelKey(prev) : null;
        const prevType = prev ? getProdTypeKey(prev) : null;

        const currentPosInRow = nextIdx % rowSize;
        const recentWindowSize = currentPosInRow > 0 ? currentPosInRow : 0;
        const recentRowModels = new Set();
        if (recentWindowSize > 0) {
          for (let k = result.length - recentWindowSize; k < result.length; k++) {
            if (k >= 0) recentRowModels.add(getProdModelKey(result[k]));
          }
        }

        let bestIndex = -1;

        // Prioridad 1: No en la misma fila + modelo no repetido en esta página + tipo alternado
        for (let i = 0; i < pool.length; i++) {
          const item = pool[i];
          const mKey = getProdModelKey(item);
          const tKey = getProdTypeKey(item);
          if (!recentRowModels.has(mKey) && mKey !== prevModel && !currentPageModels.has(mKey) && tKey !== prevType) {
            bestIndex = i;
            break;
          }
        }

        // Prioridad 2: No en la misma fila + modelo no repetido en esta página
        if (bestIndex === -1) {
          for (let i = 0; i < pool.length; i++) {
            const item = pool[i];
            const mKey = getProdModelKey(item);
            if (!recentRowModels.has(mKey) && mKey !== prevModel && !currentPageModels.has(mKey)) {
              bestIndex = i;
              break;
            }
          }
        }

        // Prioridad 3: No en la misma fila + tipo alternado respecto a la posición anterior
        if (bestIndex === -1) {
          for (let i = 0; i < pool.length; i++) {
            const item = pool[i];
            const mKey = getProdModelKey(item);
            const tKey = getProdTypeKey(item);
            if (!recentRowModels.has(mKey) && mKey !== prevModel && tKey !== prevType) {
              bestIndex = i;
              break;
            }
          }
        }

        // Prioridad 4: No en la misma fila (estricto: no repetir en la misma línea/fila)
        if (bestIndex === -1) {
          for (let i = 0; i < pool.length; i++) {
            const item = pool[i];
            const mKey = getProdModelKey(item);
            if (!recentRowModels.has(mKey) && mKey !== prevModel) {
              bestIndex = i;
              break;
            }
          }
        }

        // Prioridad 5: Modelo distinto al anterior
        if (bestIndex === -1) {
          for (let i = 0; i < pool.length; i++) {
            const item = pool[i];
            const mKey = getProdModelKey(item);
            if (mKey !== prevModel) {
              bestIndex = i;
              break;
            }
          }
        }

        // Fallback: siguiente disponible en el pool
        if (bestIndex === -1) {
          bestIndex = 0;
        }

        const chosen = pool.splice(bestIndex, 1)[0];
        result.push(chosen);
        currentPageModels.add(getProdModelKey(chosen));
      }

      return result;
    }

    /**
     * Nº de fotos de un producto: el tamaño de su galería (incluida la
     * principal) si existe, o 1 si sólo tiene `image`, o 0 si no tiene nada.
     * Mismo criterio que usa la columna "Galería (N)" del detalle de Importar.
     */
    function prodPhotoCount(product) {
      if (Array.isArray(product.gallery) && product.gallery.length) return product.gallery.length;
      return product.image ? 1 : 0;
    }

    function prodFilterApply() {
      const q = (inputFilterList?.value || '').trim().toLowerCase();
      const cat = prodFCat?.value || '';
      const subcatId = prodSubcatFilter?.value || '';
      const network = (document.getElementById('prodFNetwork')?.value || '').trim().toLowerCase();
      const photosFilter = prodFPhotos?.value || '';
      const sortKey = prodFSort?.value || 'publicados';
      const dir = prodSortDir === 'asc' ? 1 : -1;
      const prodRange = prodReadRangeFilters();
      const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];

      const filtered = currentProducts.filter((product) => {
        // Filtro de categoría (taxonomía propia de Tradylor: categoriesCache).
        if (cat) {
          const root = allCats.find((c) => !c.parentId && (c.name === cat || c.id === cat));
          const productCat = String(product.category || '');
          const productSub = product.subcategory_id ? allCats.find((c) => c.id === product.subcategory_id) : null;
          const matchCat = productCat === cat
            || Boolean(root && (product.category_id === root.id || (productSub && productSub.parentId === root.id)));
          if (!matchCat) return false;
        }
        // Filtro de subcategoría (idem).
        if (subcatId) {
          const target = allCats.find((c) => c.id === subcatId);
          const pid = String(product.subcategory_id || '');
          let matchSub = pid === subcatId;
          if (!matchSub && target) {
            const psub = pid ? allCats.find((c) => c.id === pid) : null;
            const pname = String(psub ? psub.name : pid || '').toLowerCase();
            matchSub = Boolean(pname) && pname === target.name.toLowerCase();
          }
          if (!matchSub) return false;
        }
        // Filtro de red de afiliación (prodFNetwork: product.network, id normalizado
        // por getProductNetwork/enrichProductsForAdmin: 'aliexpress', 'ebay', 'amazon'…).
        if (network) {
          const n = String(product.network || '').trim().toLowerCase();
          if (n !== network) return false;
        }
        // Filtro por nº de fotos: "1"/"2"/"3"/"4" = exactamente esa cantidad;
        // "4-" = 4 fotos o menos (para detectar fichas pobres en imágenes).
        if (photosFilter) {
          const count = prodPhotoCount(product);
          if (photosFilter === '4-') {
            if (count > 4) return false;
          } else if (count !== Number(photosFilter)) {
            return false;
          }
        }
        // Preset editorial activo (1 clic): filtro complementario.
        if (typeof activeProdPreset !== 'undefined' && activeProdPreset && !prodMatchesPreset(product, activeProdPreset)) return false;
        const price = Number(product.price) || 0;
        if (prodRange.priceMin != null && price < prodRange.priceMin) return false;
        if (prodRange.priceMax != null && price > prodRange.priceMax) return false;
        if (prodRange.discRange) {
          const discount = prodDiscountPct(product);
          if (discount < prodRange.discRange.min || discount > prodRange.discRange.max) return false;
        }
        if (prodRange.ratingMin != null) {
          const rating = product.rating != null ? Number(product.rating) : null;
          if (rating == null || rating < prodRange.ratingMin) return false;
        }
        if (q) {
          // La búsqueda mira también la red de afiliados («amazon», «ebay»…).
          const haystack = `${product.title} ${product.merchant || ''} ${product.network_label || ''} ${product.category || ''} ${(product.brand || '')}`.toLowerCase();
          if (!haystack.includes(q)) return false;
        }
        return true;
      });

      if (sortKey === 'precio_desc') {
        filtered.sort((a, b) => (Number(b.price) || 0) - (Number(a.price) || 0));
      } else if (sortKey === 'precio_asc') {
        filtered.sort((a, b) => (Number(a.price) || 0) - (Number(b.price) || 0));
      } else if (sortKey === 'valoracion') {
        filtered.sort((a, b) => ((b.rating != null ? Number(b.rating) : -1) - (a.rating != null ? Number(a.rating) : -1)) || ((b.reviewsCount || 0) - (a.reviewsCount || 0)));
      } else if (sortKey === 'ventas') {
        const getSales = (p) => Number(p.sales30d != null ? p.sales30d : (p.popularity != null ? p.popularity : (p.extra && p.extra['Ventas (30 días)'] != null ? p.extra['Ventas (30 días)'] : (p.reviewsCount || 0))));
        filtered.sort((a, b) => getSales(b) - getSales(a));
      } else if (sortKey === 'publicados') {
        // Prioriza los productos «publicados» (listos para la web): categoría
        // + IA completada + enlace activo; a igualdad, mejor score primero.
        const rank = (p) => ((p.ia_status === 'completed' && p.link_status === 'active' && (p.category_id || p.category)) ? 1 : 0);
        filtered.sort((a, b) => (rank(b) - rank(a))
          || ((Number(b.conversion_score) || 0) - (Number(a.conversion_score) || 0))
          || String(a.title).localeCompare(String(b.title), 'es'));
      } else if (sortKey !== 'default') {
        const sorters = {
          precio: (p) => Number(p.price) || 0,
          descuento: (p) => prodDiscountPct(p),
          valoracion: (p) => (p.rating != null ? Number(p.rating) : -1),
          categoria: (p) => String(p.category || ''),
          comercio: (p) => String(p.merchant || p.network_label || ''),
          score: (p) => Number(p.conversion_score) || 0,
          ventas: (p) => Number(p.sales30d != null ? p.sales30d : (p.popularity != null ? p.popularity : (p.extra && p.extra['Ventas (30 días)'] != null ? p.extra['Ventas (30 días)'] : (p.reviewsCount || 0)))),
        };
        filtered.sort((a, b) => {
          if (sortKey === 'nombre') return (prodSortDir === 'desc' ? 1 : -1) * String(a.title).localeCompare(String(b.title), 'es');
          const get = sorters[sortKey] || sorters.precio;
          const av = get(a);
          const bv = get(b);
          if (typeof av === 'string' || typeof bv === 'string') {
            return (prodSortDir === 'desc' ? 1 : -1) * String(av).localeCompare(String(bv), 'es');
          }
          return dir * (av - bv);
        });
      }
      // Para precio, publicados o criterios de agrupación/orden exacto, mantener
      // orden estricto (sin mezcla). Mantener en sync con DIVERSITY_EXEMPT_SORTS
      // de src/lib/catalogSort.ts (este script is:inline no puede importarla).
      const diversified = ['precio_desc', 'precio_asc', 'publicados', 'nombre', 'categoria', 'comercio', 'default'].includes(sortKey) ? filtered : applyCatalogDiversity(filtered);
      renderTableRows(diversified);
    }

    // ─── Paginación del catálogo de productos ─────────────────────────────────
    function updatePaginationControls() {
      // Controles de paginación inferior (existentes)
      const paginationEl = document.getElementById('productsPagination');
      const paginationPages = document.getElementById('paginationPages');
      const paginationPrev = document.getElementById('paginationPrev');
      const paginationNext = document.getElementById('paginationNext');

      // Controles de paginación superior (nuevos)
      const paginationElTop = document.getElementById('productsPaginationTop');
      const paginationPagesTop = document.getElementById('paginationPagesTop');
      const paginationPrevTop = document.getElementById('paginationPrevTop');
      const paginationNextTop = document.getElementById('paginationNextTop');
      const paginationEndTop = document.getElementById('paginationEndTop');
      const paginationEnd = document.getElementById('paginationEnd');

      const totalProducts = filteredProducts.length;
      const totalPages = Math.ceil(totalProducts / PRODUCTS_PER_PAGE);

      if (totalPages <= 1) {
        if (paginationEl) paginationEl.hidden = true;
        if (paginationElTop) paginationElTop.hidden = true;
        return;
      }

      // Mostrar ambos
      if (paginationEl) paginationEl.hidden = false;
      if (paginationElTop) paginationElTop.hidden = false;

      // Función para actualizar un conjunto de controles
      const updateControls = (pagesEl, prevEl, nextEl, totalElId, endEl) => {
        if (!pagesEl || !prevEl || !nextEl) return;

        prevEl.disabled = currentPage <= 1;
        nextEl.disabled = currentPage >= totalPages;
        if (endEl) endEl.disabled = currentPage >= totalPages;

        let pagesHtml = '';

        if (totalPages <= 7) {
          for (let i = 1; i <= totalPages; i++) {
            pagesHtml += `<button type="button" class="ac-page-btn${i === currentPage ? ' is-current' : ''}" data-ac-page="${i}" aria-label="Página ${i}"${i === currentPage ? ' aria-current="page"' : ''}>${i}</button>`;
          }
        } else {
          const wanted = [...new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1])]
            .filter((n) => n >= 1 && n <= totalPages)
            .sort((a, b) => a - b);

          wanted.forEach((n, index) => {
            if (index > 0 && n - wanted[index - 1] > 1) {
              pagesHtml += '<span class="ac-page-gap" aria-hidden="true">...</span>';
            }
            pagesHtml += `<button type="button" class="ac-page-btn${n === currentPage ? ' is-current' : ''}" data-ac-page="${n}" aria-label="Página ${n}"${n === currentPage ? ' aria-current="page"' : ''}>${n}</button>`;
          });
        }

        pagesEl.innerHTML = pagesHtml;

        pagesEl.querySelectorAll('.ac-page-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const page = parseInt(btn.getAttribute('data-ac-page'), 10);
            if (!Number.isNaN(page) && page !== currentPage) {
              goToPage(page);
            }
          });
        });

        // Actualizar texto informativo (formato unificado: "Mostrando X–Y de Z")
        const totalEl = document.getElementById(totalElId);
        if (totalEl) {
          if (totalProducts === 0) {
            totalEl.textContent = 'Mostrando 0–0 de 0';
          } else {
            const startShown = (currentPage - 1) * PRODUCTS_PER_PAGE + 1;
            const endShown = Math.min(startShown + PRODUCTS_PER_PAGE - 1, totalProducts);
            totalEl.textContent = `Mostrando ${startShown}–${endShown} de ${totalProducts}`;
          }
        }
      };

      updateControls(paginationPages, paginationPrev, paginationNext, 'paginationTotal', paginationEnd);
      updateControls(paginationPagesTop, paginationPrevTop, paginationNextTop, 'paginationTotalTop', paginationEndTop);
    }

    function goToPage(page) {
      const totalPages = Math.ceil(filteredProducts.length / PRODUCTS_PER_PAGE);
      if (page < 1 || page > totalPages) return;
      currentPage = page;
      updatePaginationControls();
      renderTableRows(filteredProducts, false);
      // Scroll suave al inicio de la tabla
      const tableEl = document.getElementById('productsTable');
      if (tableEl) {
        tableEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Event listeners para botones prev/next (ambos conjuntos)
    const paginationPrev = document.getElementById('paginationPrev');
    const paginationNext = document.getElementById('paginationNext');
    const paginationPrevTop = document.getElementById('paginationPrevTop');
    const paginationNextTop = document.getElementById('paginationNextTop');

    paginationPrev?.addEventListener('click', () => goToPage(currentPage - 1));
    paginationNext?.addEventListener('click', () => goToPage(currentPage + 1));
    paginationPrevTop?.addEventListener('click', () => goToPage(currentPage - 1));
    paginationNextTop?.addEventListener('click', () => goToPage(currentPage + 1));

    // Select «Por página» (25 / 50 / 75) de ambas barras de paginación:
    // cambiarlo repinta la tabla con el nuevo tamaño y sincroniza los selects.
    document.querySelectorAll('[data-ac-per-page]').forEach((sel) => {
      sel.value = String(PRODUCTS_PER_PAGE);
      sel.addEventListener('change', () => {
        const value = Number(sel.value);
        if (![25, 50, 75].includes(value)) return;
        PRODUCTS_PER_PAGE = value;
        document.querySelectorAll('[data-ac-per-page]').forEach((other) => { other.value = String(value); });
        currentPage = 1;
        prodFilterApply();
      });
    });

    // Botón «Final»: salto directo a la última página de la tabla.
    document.querySelectorAll('[data-ac-last]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const totalPages = Math.max(1, Math.ceil(filteredProducts.length / PRODUCTS_PER_PAGE));
        goToPage(totalPages);
      });
    });
    inputFilterList?.addEventListener('input', prodFilterApply);
    inputFilterList?.addEventListener('search', prodFilterApply);
    inputFilterList?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        prodFilterApply();
      }
    });
    prodFCat?.addEventListener('change', () => {
      // El filtro de subcategoría se repliega sobre la categoría elegida.
      syncSubcatFilter();
      // La categoría ya no coincide necesariamente con la opción elegida en
      // «Cat/Redes» (que vincula categoría + red): se limpia para no mostrar
      // una combinación que ya no es la aplicada.
      if (prodFCatNetwork) prodFCatNetwork.value = '';
      syncSubcatNetworkFilter();
      prodFilterApply();
    });
    prodSubcatFilter?.addEventListener('change', prodFilterApply);

    const prodFNetwork = document.getElementById('prodFNetwork');

    function syncNetworkFilter() {
      const select = document.getElementById('prodFNetwork');
      if (!select) return;
      const current = select.value;
      const networks = new Map();
      (currentProducts || []).forEach((p) => {
        const id = String(p.network || '').trim().toLowerCase();
        if (!id) return;
        const label = String(p.network_label || '').trim() || (id.charAt(0).toUpperCase() + id.slice(1));
        if (!networks.has(id)) networks.set(id, label);
      });
      const sorted = Array.from(networks.entries()).sort((a, b) => a[1].localeCompare(b[1], 'es'));
      let html = '<option value="">Todas las redes</option>';
      sorted.forEach(([id, label]) => {
        html += `<option value="${escapeHtml ? escapeHtml(id) : id}"${id === current ? ' selected' : ''}>${escapeHtml ? escapeHtml(label) : label}</option>`;
      });
      select.innerHTML = html;
      if (current && networks.has(current)) {
        select.value = current;
      }
    }

    /**
     * «Cat/Redes»: categoría agrupada por red de afiliación (mismo criterio que
     * aliFCat1 en Importar). Si «Red» está en "Todas", las opciones se agrupan
     * en <optgroup> por red; si ya hay una red fija elegida, se listan sin
     * agrupar (una sola red). Al elegir una opción se fijan a la vez los
     * filtros «Red» y «Categoría» ya existentes (prodFNetwork/prodFCat): no
     * duplica lógica de filtrado, sólo ayuda a elegir los dos a la vez.
     */
    function syncCatNetworkFilter() {
      if (!prodFCatNetwork) return;
      // Función defensiva: un fallo aquí NUNCA debe cortar la recarga de la
      // tabla. reloadProductsTable la llama ANTES de prodFilterApply, así que
      // si lanzara sin capturarlo, el catch exterior de reloadProductsTable
      // detendría la ejecución justo ahí y la tabla se quedaría con los datos
      // viejos aunque el catálogo sí se hubiera actualizado en el servidor
      // (mismo motivo por el que el resto de sync* de esta función ya se
      // envuelven en try/catch más abajo).
      try {
        const current = prodFCatNetwork.value;
        const fixedNetwork = (prodFNetwork && prodFNetwork.value) || '';
        const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];

        // id de red -> { label, categorías: Map<clave, {id, name, count}> }
        const byNetwork = new Map();
        (currentProducts || []).forEach((p) => {
          const netId = String(p.network || '').trim().toLowerCase();
          if (!netId) return;
          if (fixedNetwork && netId !== fixedNetwork) return;
          const netLabel = String(p.network_label || '').trim() || (netId.charAt(0).toUpperCase() + netId.slice(1));
          if (!byNetwork.has(netId)) byNetwork.set(netId, { label: netLabel, cats: new Map() });
          const root = p.category_id
            ? allCats.find((c) => c.id === p.category_id)
            : (p.category ? allCats.find((c) => !c.parentId && c.name === p.category) : null);
          const catName = root ? root.name : String(p.category || '').trim();
          if (!catName) return;
          const entry = byNetwork.get(netId);
          const key = root ? root.id : `n:${catName.toLowerCase()}`;
          if (!entry.cats.has(key)) entry.cats.set(key, { id: root ? root.id : '', name: catName, count: 0 });
          entry.cats.get(key).count++;
        });

        const networksSorted = Array.from(byNetwork.entries()).sort((a, b) => a[1].label.localeCompare(b[1].label, 'es'));
        let html = '<option value="">Todas</option>';
        networksSorted.forEach(([netId, info]) => {
          const cats = Array.from(info.cats.values()).sort((a, b) => a.name.localeCompare(b.name, 'es'));
          if (!cats.length) return;
          const optionsHtml = cats
            .map((cat) => `<option value="${escapeHtml(netId)}::${escapeHtml(cat.id || cat.name)}">${escapeHtml(cat.name)} (${cat.count})</option>`)
            .join('');
          html += fixedNetwork ? optionsHtml : `<optgroup label="${escapeHtml(info.label)}">${optionsHtml}</optgroup>`;
        });
        prodFCatNetwork.innerHTML = html;
        if (current && Array.from(prodFCatNetwork.options).some((option) => option.value === current)) {
          prodFCatNetwork.value = current;
        } else {
          prodFCatNetwork.value = '';
        }
      } catch (err) {
        console.error('[Catálogo] Error al sincronizar «Cat/Redes» (se ignora, no bloquea el resto del catálogo):', err);
      }
    }

    /** «SubCat/Redes»: subcategorías de la opción elegida en «Cat/Redes», acotadas a los productos de esa red. */
    function syncSubcatNetworkFilter() {
      if (!prodFSubcatNetwork) return;
      // Misma protección que syncCatNetworkFilter: nunca debe poder romper
      // reloadProductsTable ni ningún otro flujo que la llame.
      try {
        const raw = prodFCatNetwork ? prodFCatNetwork.value : '';
        if (!raw) {
          prodFSubcatNetwork.innerHTML = '<option value="">Todas</option>';
          prodFSubcatNetwork.disabled = true;
          return;
        }
        const sepIdx = raw.indexOf('::');
        const netId = sepIdx >= 0 ? raw.slice(0, sepIdx) : '';
        const catRef = sepIdx >= 0 ? raw.slice(sepIdx + 2) : raw;
        const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
        const root = allCats.find((c) => !c.parentId && (c.id === catRef || c.name === catRef));
        const subsOfRoot = root ? allCats.filter((c) => c.parentId === root.id) : [];
        const present = new Set();
        (currentProducts || []).forEach((p) => {
          const pNet = String(p.network || '').trim().toLowerCase();
          if (netId && pNet !== netId) return;
          if (p.subcategory_id) present.add(p.subcategory_id);
        });
        const subs = subsOfRoot.filter((s) => present.has(s.id));
        prodFSubcatNetwork.disabled = subs.length === 0;
        prodFSubcatNetwork.innerHTML =
          '<option value="">Todas</option>' +
          subs.map((s) => `<option value="${escapeHtml(s.id)}">${escapeHtml(s.name)}</option>`).join('');
      } catch (err) {
        console.error('[Catálogo] Error al sincronizar «SubCat/Redes» (se ignora, no bloquea el resto del catálogo):', err);
        prodFSubcatNetwork.disabled = true;
      }
    }

    prodFCatNetwork?.addEventListener('change', () => {
      try {
        const raw = prodFCatNetwork.value;
        if (raw) {
          const sepIdx = raw.indexOf('::');
          const netId = sepIdx >= 0 ? raw.slice(0, sepIdx) : '';
          const catRef = sepIdx >= 0 ? raw.slice(sepIdx + 2) : raw;
          const allCats = (typeof categoriesCache !== 'undefined' && Array.isArray(categoriesCache)) ? categoriesCache : [];
          const root = allCats.find((c) => !c.parentId && (c.id === catRef || c.name === catRef));
          // Fija a la vez los filtros «Red» y «Categoría» ya existentes (reutiliza
          // el motor de filtrado de prodFilterApply: no se duplica lógica).
          if (prodFNetwork && netId) prodFNetwork.value = netId;
          if (prodFCat) prodFCat.value = root ? root.name : catRef;
          if (prodSubcatFilter) prodSubcatFilter.value = '';
        }
      } catch (err) {
        console.error('[Catálogo] Error al aplicar «Cat/Redes» (se ignora):', err);
      }
      syncSubcatFilter();
      syncCatNetworkFilter();
      syncSubcatNetworkFilter();
      prodFilterApply();
    });

