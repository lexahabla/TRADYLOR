  .buyer-profile-btn--delete:hover:not(:disabled) {
    background: #dc2626; color: #fff; border-color: #dc2626;
    box-shadow: 0 6px 16px -6px rgba(239, 68, 68, .55);
  }
  .buyer-profiles-empty {
    padding: 1.5rem; text-align: center; color: var(--color-text-dim);
    background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.12); border-radius: var(--border-radius-md);
