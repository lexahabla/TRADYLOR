    box-shadow: 0 6px 16px -6px rgba(255, 255, 255, 0.18);
  }

  /* Eliminar: rojo, acción destructiva. */
  .buyer-profile-btn--delete {
    background: rgba(239, 68, 68, 0.14); color: #fca5a5;
    border-color: rgba(239, 68, 68, 0.45);
