</style>

<script>
  import { getBuyerProfiles, setActiveBuyerProfile, deleteBuyerProfile } from '../utils/buyerProfileStore';
  import { buyerProfileColor, buyerProfileGroupsLine, buyerProfileSubtitlesLine, contrastTextColor, hslString } from '../types/buyerProfile';

  (function () {
    const list = document.getElementById('buyerProfilesList');
    if (!list) return;

    function renderProfiles() {
      if (!list) return;
      const profiles = getBuyerProfiles();
      const activeId = (() => {
        try {
          const raw = localStorage.getItem('tradylor-radar-v1');
          if (!raw) return null;
          const data = JSON.parse(raw);
          return data.activeBuyerProfileId ?? null;
        } catch { return null; }
      })();

      if (!profiles || profiles.length === 0) {
        list.innerHTML = `<div class="buyer-profiles-empty">Aún no tienes perfiles guardados. Completa el Perfilador para crear tu primero.</div>`;
        return;
      }

      list.innerHTML = profiles.map((p) => {
        const isActive = p.id === activeId;
        const colorHsl = buyerProfileColor(p);
        const color = hslString(colorHsl);
        const textColor = contrastTextColor(colorHsl);
        return `
          <div class="buyer-profile-item" data-bp-id="${p.id}">
            <div class="buyer-profile-info">
              <span class="tool-kicker buyer-profile-name" style="background:${color};color:${textColor};border-color:${color}">${p.name}</span>
              <div class="buyer-profile-meta">${buyerProfileGroupsLine(p)}</div>
              <div class="buyer-profile-subtitles">${buyerProfileSubtitlesLine(p)}</div>
            </div>
            <div class="buyer-profile-actions">
              ${isActive
                ? `<span class="buyer-profile-status">
                     <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
                     Activo
                   </span>
                   <button type="button" class="buyer-profile-btn buyer-profile-btn--clear" data-bp-clear="${p.id}" title="Desactivar perfil">
                     <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                     Desactivar perfil
                   </button>`
                : `<button type="button" class="buyer-profile-btn buyer-profile-btn--primary" data-bp-set="${p.id}">
                     <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>
                     Usar este perfil
                   </button>`}
              <button type="button" class="buyer-profile-btn buyer-profile-btn--delete" data-bp-delete="${p.id}" title="Eliminar perfil" aria-label="Eliminar perfil ${p.name}">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                Eliminar
              </button>
            </div>
          </div>
        `;
      }).join('');

      // Event listeners
      list.querySelectorAll<HTMLButtonElement>('[data-bp-set]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-bp-set');
          if (!id || btn.disabled) return;
          try {
            setActiveBuyerProfile(id);
            renderProfiles();
          } catch {
            /* silencioso */
          }
        });
      });

      list.querySelectorAll<HTMLButtonElement>('[data-bp-delete]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-bp-delete');
          if (!id) return;
          if (!confirm('¿Eliminar este perfil de comprador?')) return;
          try {
            deleteBuyerProfile(id);
            renderProfiles();
          } catch {
            /* silencioso */
          }
        });
      });

      // Desactivar el perfil activo desde "Tus perfiles de comprador".
      list.querySelectorAll<HTMLButtonElement>('[data-bp-clear]').forEach((btn) => {
        btn.addEventListener('click', () => {
          try {
            setActiveBuyerProfile(null);
            renderProfiles();
          } catch {
            /* silencioso */
          }
        });
      });
    }

    renderProfiles();
  })();
</script>
