      .cmp-cat-panel:not([hidden]) { display: block !important; animation: cmp-panel-in 0.18s ease; }
      .cmp-cat-panel-head {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        padding: 0.1rem 0.25rem 0.6rem; margin-bottom: 0.6rem; border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      }
      .cmp-cat-panel-title {
        font-size: 0.7rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45);
      }
      .cmp-cat-panel-all {
        font-family: var(--font-body, inherit); font-size: 0.74rem; font-weight: 700; color: #93c5fd;
