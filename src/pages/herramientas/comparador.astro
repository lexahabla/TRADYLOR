      .comparator-verdict-title {
        font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; color: #ffffff; margin: 0 0 1rem;
      }
      .comparator-verdict-card {
        display: flex; align-items: center; gap: 1rem; padding: 1rem; background: rgba(10, 14, 23, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; text-decoration: none;
        transition: border-color 0.2s ease, transform 0.2s ease;
