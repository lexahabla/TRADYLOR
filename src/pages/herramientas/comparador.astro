        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
      }
      .cmp-cat-btn-icon { font-size: 1rem; line-height: 1; flex-shrink: 0; }
      .cmp-cat-btn-label { max-width: 11rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

