    <!-- Estilos globales (sin scoping) para el panel de categorías y el dropdown
         de sugerencias: ambos se inyectan como HTML crudo (set:html en servidor
         y innerHTML en cliente), por lo que nunca reciben el atributo de scoping
         de Astro y las reglas del <style> normal de arriba no les aplicarían. -->
    <style is:global>
