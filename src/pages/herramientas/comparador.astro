      .comparator-cross-item .cm-view-link:hover { text-decoration: underline; }

      @media (max-width: 640px) {
        .nav-search { max-width: 100%; height: 44px; }
        .comparator-search-wrap { max-width: 100%; padding: 0 1rem; }
        .comparator-picked { flex-direction: column; align-items: flex-start; }
        .comparator-verdict-card { flex-wrap: wrap; }
        .comparator-verdict-cta { width: 100%; text-align: right; }
