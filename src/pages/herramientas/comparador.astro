      }
      .cmp-cat-panel-grid {
        display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.55rem;
        max-height: min(66vh, 30rem); overflow-y: auto; overscroll-behavior: contain; padding-right: 0.2rem;
      }
      .cmp-cat-card {
        display: flex; align-items: center; gap: 0.6rem; width: 100%; padding: 0.55rem 0.6rem; border-radius: 14px;
        text-decoration: none; color: #e5e7eb; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);
        font-family: inherit; text-align: left; cursor: pointer;
        transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
      }
      .cmp-cat-card:hover, .cmp-cat-card.is-active {
        transform: translateY(-2px); background: rgba(59, 130, 246, 0.14); border-color: rgba(96, 165, 250, 0.45);
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      }
      .cmp-cat-card-icon {
        display: inline-flex; align-items: center; justify-content: center; width: 2.4rem; height: 2.4rem; flex-shrink: 0;
        border-radius: 12px; font-size: 1.2rem; line-height: 1;
        background: linear-gradient(135deg, hsl(var(--h, 215) 80% 60% / 0.28), hsl(var(--h, 215) 80% 55% / 0.08));
        border: 1px solid hsl(var(--h, 215) 80% 60% / 0.32);
