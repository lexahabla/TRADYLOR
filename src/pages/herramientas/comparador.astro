      .ns-clear:hover { color: #ffffff; background: rgba(255, 255, 255, 0.12); }

      .comparator-hint { text-align: center; color: var(--color-text-dim); font-size: 0.82rem; margin-top: 0.5rem; }

      .tools-empty-note { padding: 2rem; text-align: center; color: var(--color-text-dim); background: rgba(255, 255, 255, 0.02);
        border: 1px dashed rgba(255, 255, 255, 0.12); border-radius: 16px; }

      /* Reutiliza los mismos estilos del comparador de herramientas.astro */
      .comparator-result { display: flex; flex-direction: column; gap: 2rem; }
      .comparator-picked {
