      .cmp-drop-discount {
        padding: 0.15rem 0.55rem; font-size: 0.68rem; font-weight: 800; color: #34d399; background: rgba(16, 185, 129, 0.16);
        border: 1px solid rgba(52, 211, 153, 0.35); border-radius: 999px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);
      }

      @keyframes cmp-panel-in {
        from { opacity: 0; transform: translateY(-8px) scale(0.985); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
      @keyframes cmp-drop-in {
        from { opacity: 0; transform: translateY(-4px) scale(0.985); }
        to { opacity: 1; transform: none; }
      }

      @media (max-width: 640px) {
        .cmp-cat-btn {
          padding: 0 0.55rem; gap: 0; border-radius: 9px 0 0 9px;
