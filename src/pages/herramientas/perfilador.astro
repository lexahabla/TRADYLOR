---
/**
 * TRADYLOR — PERFILADOR (Página dedicada)
 * Herramienta Paso 3 de El Método. Enlazada desde el mainNav (dropdown
 * "Herramientas") y desde el menú de usuario del header.
 */
import Layout from '../../layouts/Layout.astro';
import ToolPageHeader from '../../components/herramientas/ToolPageHeader.astro';
import SmartMatcherWizard from '../../components/SmartMatcherWizard.astro';

export const prerender = false;

const pageTitle = 'Perfilador | Tradylor';
const pageDescription = 'Crea tu Perfil de Comprador: responde 3 preguntas sobre uso, presupuesto y prioridad para que Tradylor te marque qué productos encajan contigo en todo el catálogo.';
---

<Layout title={pageTitle} description={pageDescription} noindex={false}>
  <ToolPageHeader
    icon="👤"
    title="Perfilador"
    subtitle="Responde 3 preguntas rápidas sobre uso, presupuesto y prioridad. Guardamos el resultado como un perfil con nombre que aplicamos en toda la web para marcar qué productos encajan contigo."
  />
  <div class="tool-container tool-body">
    <SmartMatcherWizard />
  </div>
</Layout>
