---
/**
 * TRADYLOR — PERFILADOR DE COMPRA (Página dedicada)
 * Herramienta Paso 3 de El Método. Enlazada desde el mainNav (dropdown
 * "Herramientas") y desde el menú de usuario del header.
 */
import Layout from '../../layouts/Layout.astro';
import SmartMatcherWizard from '../../components/SmartMatcherWizard.astro';

export const prerender = false;

const pageTitle = 'Perfilador de Compra | Tradylor';
const pageDescription = 'Crea tu Perfil de Comprador: responde 3 preguntas sobre uso, presupuesto y prioridad para que Tradylor te marque qué productos encajan contigo en todo el catálogo.';
---

<Layout title={pageTitle} description={pageDescription} noindex={false}>
  <a href="/herramientas" class="tools-back-link" style="display:inline-flex;align-items:center;gap:.5rem;margin:1rem auto;max-width:fit-content;padding:.75rem 1.2rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:10px;color:#e5e7eb;font-weight:700;text-decoration:none;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
    Volver al Centro de Herramientas
  </a>

  <section class="tools-page">
    <SmartMatcherWizard />
  </section>

  <style>
    .tools-back-link:hover {
      background: rgba(59, 130, 246, 0.14);
      border-color: rgba(96, 165, 250, 0.4);
      color: #ffffff;
    }
  </style>
</Layout>
