---
/**
 * TRADYLOR — ASESOR IA (Página dedicada, ruta /herramientas/dependiente-ia)
 * Chat de asistencia para decidir productos. Enlazada desde el mainNav
 * (dropdown "Herramientas"). La ruta se mantiene por compatibilidad de
 * enlaces ya compartidos; el nombre visible en toda la web es "Asesor IA".
 */
import Layout from '../../layouts/Layout.astro';
import ToolPageHeader from '../../components/herramientas/ToolPageHeader.astro';
import DependienteIA from '../../components/DependienteIA.astro';

export const prerender = false;

const pageTitle = 'Asesor IA | Tradylor';
const pageDescription = 'Pregunta en lenguaje natural qué producto necesitas y el Asesor IA te recomendará opciones reales de nuestro catálogo.';
---

<Layout title={pageTitle} description={pageDescription} noindex={false}>
  <ToolPageHeader
    icon="🤖"
    title="Asesor IA"
    subtitle="Cuéntale qué buscas (uso, presupuesto, prioridades) y te recomendará productos reales de nuestro catálogo, nunca artículos inventados."
  />
  <div class="tool-container tool-body">
    <DependienteIA />
  </div>
</Layout>
