---
/**
 * TRADYLOR — Dashboard "Tráfico y Ventas" (ruta propia)
 * El módulo también es una sección del panel (/upayp1b4?section=analytics);
 * aquí se mantiene la URL directa con la misma cabecera del backend.
 */
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/AdminNav.astro';
import AdminUserMenu from '../../../components/AdminUserMenu.astro';
import TrafficSalesDashboard from '../../../components/admin/TrafficSalesDashboard.astro';
import DateRangeFilter from '../../../components/admin/DateRangeFilter.astro';
import FinancialHeaderCards from '../../../components/admin/FinancialHeaderCards.astro';
import RevenueChart from '../../../components/admin/RevenueChart.astro';
import SalesHistoryTable from '../../../components/admin/SalesHistoryTable.astro';
import SalesAITips from '../../../components/admin/SalesAITips.astro';
import { getSessionUser } from '../../../lib/adminAuth';
import { registrosVentas, serieIngresos } from '../../../data/mockVentas';

const sessionUser = getSessionUser(Astro.request);
if (!sessionUser) return Astro.redirect('/upayp1b4');
if (sessionUser.role !== 'admin') return Astro.redirect('/upayp1b4/perfil');

// El panel nunca se cachea: un deploy nuevo tiene que verse a la primera.
Astro.response.headers.set('Cache-Control', 'no-store');

// Rango por defecto del bloque financiero: últimos 30 días.
const hoyISO = new Date().toISOString().slice(0, 10);
const desdeISO = new Date(Date.now() - 29 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
const registrosIniciales = registrosVentas.filter((v) => v.fecha >= desdeISO && v.fecha <= hoyISO);
---

<Layout
  title="Tráfico y ventas | Admin Tradylor"
  description="Dashboard de tráfico y ventas de Tradylor: métricas globales, rendimiento por producto, gráficos y recomendaciones de IA."
>
  <Fragment slot="header-end">
    <AdminUserMenu user={sessionUser} active="analytics" />
  </Fragment>
  <div class="admin-module-wrapper">
    <!-- Cabecera del módulo (patrón admin-header del backend) -->
    <header class="admin-header">
      <div class="admin-header-main">
        <div class="admin-tag-row">
          <a class="admin-tag-link" href="/upayp1b4">Panel de administración</a>
          <span class="admin-tag-sep" aria-hidden="true">/</span>
          <div class="admin-tag-pill">Actividad de la tienda</div>
        </div>
        <h1 class="admin-title">Tráfico y Ventas</h1>
        <p class="admin-subtitle">
          Resumen global, ranking por producto y recomendaciones de IA. Pasa el cursor sobre el
          <strong>?</strong> de cada métrica para ver su definición.
        </p>
        <div class="module-heading-actions">
          <span class="data-example-pill">Datos de ejemplo</span>
          <a class="guide-link" href="/upayp1b4/trafico-ventas/guia">
            Guía y Glosario
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <AdminNav context="catalogo" active="analytics" user={sessionUser} />

    <TrafficSalesDashboard />

    <!-- ======================================================================
         BLOQUE 2 — CONTROL DE VENTAS, COMISIONES E INGRESOS
         ====================================================================== -->
    <section class="sales-block" aria-labelledby="ventas-titulo">
      <div class="sales-separator">
        <h2 id="ventas-titulo" class="sales-separator-title">💰 Control de Ventas, Comisiones e Ingresos</h2>
        <p class="sales-separator-sub">
          Facturación bruta, comisión neta real, historial de transacciones y consejos de IA para
          mejorar tu margen. Usa el filtro de periodo para ajustar todo el bloque.
        </p>
      </div>

      <DateRangeFilter desde={desdeISO} hasta={hoyISO} />

      <FinancialHeaderCards registros={registrosIniciales} />

      <div class="sales-grid">
        <RevenueChart serie={serieIngresos} />
        <SalesAITips />
      </div>

      <SalesHistoryTable registros={registrosIniciales} />
    </section>

    <!-- Datos embebidos para que los componentes del bloque recalculen en cliente. -->
    <script type="application/json" id="ventas-registros-json" set:html={JSON.stringify(registrosVentas)} />
    <script type="application/json" id="ventas-serie-json" set:html={JSON.stringify(serieIngresos)} />
  </div>

  <!-- Botón flotante: volver al menú de secciones del backend -->
  <button type="button" id="adminBackToTop" class="admin-back-to-top" title="Volver al menú de secciones" aria-label="Volver al menú de secciones">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
    <span>Secciones</span>
  </button>

  <script is:inline>
    const adminBackToTop = document.getElementById('adminBackToTop');
    if (adminBackToTop) {
      adminBackToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</Layout>

<style>
  .admin-module-wrapper { display: flex; flex-direction: column; gap: 2rem; max-width: var(--max-width); margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
  .admin-header { display: flex; flex-direction: column; gap: 1.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-border); }
  .admin-tag-pill { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 0 0.4rem; padding: 0; background: none; border: 0; border-radius: 0; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #60a5fa; width: fit-content; }
  .admin-tag-row { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
  .admin-tag-row .admin-tag-pill { margin: 0; }
  .admin-tag-link { font-size: 0.74rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #60a5fa; text-decoration: none; transition: color 0.16s ease; }
  .admin-tag-link:hover { color: #93c5fd; }
  .admin-tag-sep { font-size: 0.74rem; font-weight: 800; color: #60a5fa; opacity: 0.5; }
  .admin-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 800; color: var(--color-text-main); line-height: 1.2; margin-top: 0.5rem; }
  .admin-subtitle { color: var(--color-text-muted); font-size: 0.95rem; max-width: 800px; line-height: 1.6; margin-top: 0.5rem; }
  /* Botón flotante: volver al menú de secciones (alineado a la izquierda) */
  .admin-back-to-top {
    position: fixed;
    left: 1.1rem;
    bottom: 1.1rem;
    z-index: 70;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .65rem .95rem;
    color: #04121f;
    background: linear-gradient(135deg, #38bdf8, #22d3ee);
    border: 0;
    border-radius: 999px;
    box-shadow: 0 10px 26px rgba(56, 189, 248, .35);
    cursor: pointer;
    font: inherit;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .02em;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .admin-back-to-top:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(56, 189, 248, .5); }
  .admin-back-to-top svg { display: block; }
  .module-heading-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 0.6rem; margin-top: 0.9rem; }
  .data-example-pill { padding: 0.35rem 0.85rem; color: #fbbf24; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 9999px; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
  .guide-link { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1rem; color: #06121f; background: #38bdf8; border-radius: 9999px; font-size: 0.78rem; font-weight: 800; text-decoration: none; transition: background 0.2s ease; }
  .guide-link:hover { background: #7dd3fc; }

  /* Bloque 2 — Control de Ventas, Comisiones e Ingresos */
  .sales-block { display: flex; flex-direction: column; gap: 1.5rem; }
  .sales-separator { display: flex; flex-direction: column; gap: 0.75rem; padding: 2rem 0 1rem; border-top: 1px solid var(--color-border); }
  .sales-separator-title { font-family: var(--font-heading); font-size: clamp(1.4rem, 2.8vw, 1.9rem); font-weight: 800; color: var(--color-text-main); line-height: 1.25; }
  .sales-separator-sub { color: var(--color-text-muted); font-size: 0.92rem; max-width: 820px; line-height: 1.6; }
  .sales-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }

  @media (max-width: 900px) {
    .sales-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
