---
/**
 * TRADYLOR — /upayp1b4/marketing (menú del módulo de Marketing)
 * Resumen del módulo: acceso a las cinco secciones con una foto rápida de la
 * situación actual (audiencia, catálogo, campaña próxima y embudo).
 */
export const prerender = false;

import MarketingShell from '../../../components/admin/MarketingShell.astro';
import { getSessionUser } from '../../../lib/adminAuth';
import { getMarketMap } from '../../../lib/marketingInsights';
import { getMarketActions } from '../../../lib/marketingInsights';
import { getResumenCatalogo } from '../../../lib/marketingInsights';

const sessionUser = getSessionUser(Astro.request);
if (!sessionUser) return Astro.redirect('/upayp1b4');
if (sessionUser.role !== 'admin') return Astro.redirect('/upayp1b4/perfil');

Astro.response.headers.set('Cache-Control', 'no-store');

const mapa = getMarketMap();
const acciones = getMarketActions();
const resumen = getResumenCatalogo();

const secciones = [
  {
    href: '/upayp1b4/marketing/usuarios',
    icono: '👥',
    titulo: 'Usuarios',
    texto: 'Ficha 360 de cada usuario de Mi Radar, segmentador de audiencias e integración de email.',
    dato: `${acciones.totalUsuarios} usuarios en la audiencia`,
  },
  {
    href: '/upayp1b4/marketing/market-map',
    icono: '🗺️',
    titulo: 'Market Map',
    texto: 'Audiencia por mercado, cobertura de redes de afiliados y ventana comercial de cada país.',
    dato: `${mapa.mercados.filter((m) => m.usuarios > 0).length} mercados con audiencia`,
  },
  {
    href: '/upayp1b4/marketing/calendario',
    icono: '📅',
    titulo: 'Calendario',
    texto: 'Fechas clave del año con alerta de 3-4 semanas, mix de canales, ángulos de copy y preparación.',
    dato: mapa.proximo ? `Próxima: ${mapa.proximo.nombre}` : 'Sin campañas activas',
  },
  {
    href: '/upayp1b4/marketing/market-action',
    icono: '🎯',
    titulo: 'Market Action',
    texto: 'Embudo real de los últimos 30 días y acciones de conversión priorizadas por segmento.',
    dato: `${acciones.acciones.filter((a) => a.usuarios > 0).length} acciones con audiencia afectada`,
  },
  {
    href: '/upayp1b4/marketing/tendencias',
    icono: '📈',
    titulo: 'Tendencias',
    texto: 'Momentum por categoría, movimientos de precio del histórico, señales y estacionalidad.',
    dato: `${resumen.productos} productos vigilados`,
  },
];
---

<MarketingShell
  user={sessionUser}
  seccion="usuarios"
  breadcrumb="Marketing"
  titulo="Marketing"
  documentTitle="Marketing | Admin Tradylor"
  descripcion="Backend de Marketing de Tradylor: usuarios, Market Map, calendario, Market Action y tendencias."
  sub="Módulo central para maximizar ventas globales: audiencias, inteligencia geográfica, planificación comercial, acciones de conversión y escucha activa. Elige una sección del menú."
>
  <section class="mkh-summary">
    <article class="mkh-card">
      <span class="mkh-label">Audiencia</span>
      <strong class="mkh-valor">{acciones.totalUsuarios}</strong>
      <span class="mkh-nota">usuarios de Mi Radar segmentables</span>
    </article>
    <article class="mkh-card">
      <span class="mkh-label">LTV</span>
      <strong class="mkh-valor">{mapa.totalLtv.toFixed(0)} €</strong>
      <span class="mkh-nota">valor acumulado de compras confirmadas</span>
    </article>
    <article class="mkh-card">
      <span class="mkh-label">Catálogo</span>
      <strong class="mkh-valor">{resumen.productos}</strong>
      <span class="mkh-nota">
        {resumen.categorias} categorías · {resumen.redes.length} redes
      </span>
    </article>
    <article class="mkh-card mkh-card--destacada">
      <span class="mkh-label">Campaña activa</span>
      <strong class="mkh-valor">{mapa.proximo ? mapa.proximo.nombre : '—'}</strong>
      <span class="mkh-nota">
        {mapa.proximo ? `desde el ${mapa.proximo.fecha.slice(8, 10)}/${mapa.proximo.fecha.slice(5, 7)}` : 'Sin campañas'}
      </span>
    </article>
  </section>

  <nav class="mkh-grid" aria-label="Secciones del módulo de Marketing">
    {
      secciones.map((seccion) => (
        <a class="mkh-card-link" href={seccion.href}>
          <span class="mkh-card-icon" aria-hidden="true">{seccion.icono}</span>
          <strong class="mkh-card-title">{seccion.titulo}</strong>
          <span class="mkh-card-text">{seccion.texto}</span>
          <span class="mkh-card-dato">{seccion.dato}</span>
        </a>
      ))
    }
  </nav>
</MarketingShell>

<style is:global>
  .mkh-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.9rem; }
  .mkh-card { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.1rem 1.15rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--color-border); border-radius: 14px; }
  .mkh-card--destacada { border-color: rgba(96, 165, 250, 0.45); background: rgba(59, 130, 246, 0.08); }
  .mkh-label { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; color: var(--color-text-dim); }
  .mkh-valor { font-size: 1.35rem; font-weight: 800; color: var(--color-text-main); line-height: 1.2; }
  .mkh-nota { font-size: 0.76rem; color: var(--color-text-muted); }

  .mkh-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.9rem; }
  .mkh-card-link { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.15rem 1.2rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--color-border); border-radius: 14px; text-decoration: none; transition: border-color .16s ease, background .16s ease, transform .16s ease; }
  .mkh-card-link:hover { border-color: rgba(96, 165, 250, .5); background: rgba(59, 130, 246, .07); transform: translateY(-1px); }
  .mkh-card-icon { font-size: 1.5rem; }
  .mkh-card-title { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 800; color: var(--color-text-main); }
  .mkh-card-text { font-size: 0.82rem; line-height: 1.55; color: var(--color-text-muted); }
  .mkh-card-dato { margin-top: 0.35rem; font-size: 0.72rem; font-weight: 700; color: #93c5fd; }
</style>
