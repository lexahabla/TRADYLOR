---
/**
 * TREIDILOR — /upayp1b4/portada (etapa 3: editor visual del BORRADOR)
 *
 * Apartado «Portada» del backend. Reutiliza la cabecera, el menú de usuario, la miga de pan y la navegación del backend (mismo patrón que
 * Marketing). Etapa 3: editor visual del BORRADOR (src/scripts/homeLayoutEditor.ts). Al cargar la página NO se escribe nada (no se crea
 * `home-layout.json`): el borrador sólo se guarda cuando el administrador pulsa «Guardar borrador». No publica ni activa la portada nueva;
 * la portada pública actual sigue activa y sin cambios.
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminSectionHeader from '../../components/admin/AdminSectionHeader.astro';
import AdminUserMenu from '../../components/AdminUserMenu.astro';
import { getSessionUser } from '../../lib/adminAuth';
import { readHomeLayout, resolveHomeMode } from '../../lib/homeLayout/store';
import { FORMATS, MODALITIES, WIDTHS } from '../../lib/homeLayout/types';
import { FORMAT_REGISTRY, MODALITY_REGISTRY } from '../../lib/homeLayout/validate';
import { loadSources } from '../../lib/homeLayout/sources';
import { resolveBlocks } from '../../lib/homeLayout/resolve';
import { buildSectionsProposal } from '../../lib/homeLayout/sectionsProposal';

const sessionUser = getSessionUser(Astro.request);
if (!sessionUser) return Astro.redirect('/upayp1b4');
// Igual que Marketing: sólo administradores; el resto va a su perfil.
if (sessionUser.role !== 'admin') return Astro.redirect('/upayp1b4/perfil');

Astro.response.headers.set('Cache-Control', 'no-store');

const read = readHomeLayout();
const mode = resolveHomeMode();
const statusText: Record<string, string> = {
  missing: 'Sin datos todavía (aún no se ha guardado ninguna portada)',
  ok: 'Correcto',
  corrupt: 'Archivo dañado: se conserva sin tocar para diagnóstico',
  invalid: 'Datos no válidos: se conserva sin tocar para diagnóstico',
  newer: 'Esquema más nuevo que esta versión: se conserva sin tocar',
};
const WIDTH_LABEL: Record<number, string> = { 3: '¼', 4: '⅓', 6: '½', 8: '⅔', 9: '¾', 12: 'completo' };

// Etapa 2 (SOLO LECTURA): conexión con los datos reales y propuesta en memoria a partir de «Crear sección». No se guarda nada.
const sources = loadSources();
const proposal = buildSectionsProposal(sources);
const proposalResolved = resolveBlocks(proposal.proposed.map((p) => p.block), sources);
const draftResolved = resolveBlocks(read.doc.draft.blocks, sources);
const resolvedById = new Map(proposalResolved.blocks.map((b) => [b.id, b]));
const srcText: Record<string, string> = { ok: 'Correcto', missing: 'No existe el archivo', corrupt: 'Archivo no utilizable', error: 'Error de lectura' };
const SKIP_TEXT: Record<string, string> = { no_publicada: 'no publicada', sin_productos: 'sin productos existentes', id_no_valido: 'id no válido', bloque_no_valido: 'bloque no válido' };
const POS_TEXT: Record<string, string> = { above: 'Encima del catálogo', below: 'Debajo del catálogo' };
const SPEED_TEXT: Record<string, string> = { slow: 'lenta', normal: 'normal', fast: 'rápida', none: 'sin desplazamiento' };
---

<Layout title="Portada | Admin Treidilor" description="Portada editable de Treidilor: bloques, versiones e historias.">
  <Fragment slot="header-end">
    <AdminUserMenu user={sessionUser} active="portada" />
  </Fragment>
  <div class="portada-wrapper">
    <AdminSectionHeader
      crumbs={[{ label: 'Panel de administración', href: '/upayp1b4' }, { label: 'Portada' }]}
      headingLevel={1}
      title="Portada"
      subtitle="Diseña la portada pública con bloques, gestiona sus versiones y las historias. Nada se publica hasta que lo confirmes."
    />

    <AdminNav context="catalogo" active="portada" user={sessionUser} />

    <section class="portada-card" id="homeLayoutEditor" aria-labelledby="portadaEditor">
      <h2 id="portadaEditor" class="portada-card-title">Editor de portada <span class="portada-pill is-prov">Borrador · sin publicar</span></h2>
      <noscript><p class="portada-note">El editor necesita JavaScript.</p></noscript>
    </section>

    <section class="portada-card" aria-labelledby="portadaEstado">
      <h2 id="portadaEstado" class="portada-card-title">Estado de la portada</h2>
      <dl class="portada-grid">
        <div>
          <dt>Portada pública</dt>
          <dd><span class="portada-pill is-ok">✓ Actual (sin cambios)</span></dd>
        </div>
        <div>
          <dt>Portada nueva</dt>
          <dd><span class="portada-pill is-off">● Desactivada</span></dd>
        </div>
        <div>
          <dt>Modo servido</dt>
          <dd>{mode === 'legacy' ? 'Portada actual' : 'Portada nueva'}</dd>
        </div>
        <div>
          <dt>Almacenamiento</dt>
          <dd>{statusText[read.status] ?? read.status}</dd>
        </div>
        <div>
          <dt>Borrador (al cargar la página)</dt>
          <dd>{read.doc.draft.blocks.length} bloques</dd>
        </div>
        <div>
          <dt>Publicada / versiones</dt>
          <dd>{read.doc.published ? `v${read.doc.published.version}` : 'Ninguna'} · {read.doc.versions.length} archivadas</dd>
        </div>
      </dl>
      <p class="portada-note">
        Editor del borrador, publicación con historial de versiones, historias, selección automática y activación. La portada nueva solo se muestra a los visitantes cuando están abiertos los tres candados (código, variable HOME_LAYOUT_ENABLED del servidor y activación del administrador con una versión fijada); si no, se ve la portada de siempre.
      </p>
    </section>

    <section class="portada-card" aria-labelledby="portadaDatos">
      <h2 id="portadaDatos" class="portada-card-title">Conexión con el catálogo <span class="portada-pill is-off">Solo lectura</span></h2>
      <dl class="portada-grid">
        <div>
          <dt>Productos</dt>
          <dd>{sources.status.products.count} · {srcText[sources.status.products.status]}</dd>
        </div>
        <div>
          <dt>Categorías</dt>
          <dd>{sources.status.categories.count} · {srcText[sources.status.categories.status]}{sources.status.categories.origin === 'defaults' ? ' (se usan las categorías base)' : ''}</dd>
        </div>
        <div>
          <dt>Secciones de «Crear sección»</dt>
          <dd>{sources.status.sections.count} · {srcText[sources.status.sections.status]}</dd>
        </div>
        <div>
          <dt>Comercios con productos</dt>
          <dd>{[...sources.networks.entries()].filter(([, n]) => n > 0).map(([id, n]) => `${id} (${n})`).join(', ') || 'Ninguno'}</dd>
        </div>
        <div>
          <dt>Borrador: referencias</dt>
          <dd>{draftResolved.totals.errors} errores · {draftResolved.totals.warnings} avisos</dd>
        </div>
        <div>
          <dt>Propuesta desde secciones</dt>
          <dd>{proposal.proposed.length} bloques · {proposal.skipped.length} secciones no incluidas</dd>
        </div>
      </dl>
      {proposal.proposed.length > 0 ? (
        <div class="portada-table-wrap">
          <table class="portada-table">
            <caption>Propuesta en memoria: así se verían hoy las secciones publicadas como bloques «Sección» (no se guarda nada)</caption>
            <thead>
              <tr><th scope="col">Sección</th><th scope="col">Posición</th><th scope="col">Velocidad</th><th scope="col">Productos</th><th scope="col">Estado</th></tr>
            </thead>
            <tbody>
              {proposal.proposed.map((p) => {
                const rb = resolvedById.get(p.block.id);
                return (
                  <tr>
                    <th scope="row">{p.section.title || p.section.id}</th>
                    <td>{POS_TEXT[p.section.position]}</td>
                    <td>{SPEED_TEXT[p.section.speed]}</td>
                    <td>{p.validProductIds.length} válidos{p.invalidProductIds.length ? ` · ${p.invalidProductIds.length} inexistentes` : ''}</td>
                    <td>{rb?.visible === true ? '✓ Se mostraría' : '● No se mostraría'}{rb && rb.issues.some((i) => i.severity !== 'info') ? ' · con avisos' : ''}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="portada-note">No hay secciones publicadas con productos: la portada actual no muestra bloques de sección.</p>
      )}
      {proposal.skipped.length > 0 && (
        <p class="portada-note">
          No incluidas: {proposal.skipped.map((s) => `${s.sectionId} (${SKIP_TEXT[s.reason] ?? s.reason})`).join(', ')}.
        </p>
      )}
    </section>

    <section class="portada-card" aria-labelledby="portadaModelo">
      <h2 id="portadaModelo" class="portada-card-title">Modelo de bloques <span class="portada-pill is-prov">Provisional</span></h2>
      <p class="portada-note">
        Cada bloque combina una <b>modalidad</b> (cómo se obtiene el contenido), un <b>formato</b> (cómo se presenta), un <b>ancho</b> y una <b>tarjeta</b> reutilizable. La clasificación de modalidades es una propuesta funcional pendiente de confirmación definitiva.
      </p>
      <div class="portada-lists">
        <div>
          <h3>Modalidades</h3>
          <ul>{MODALITIES.map((m) => <li>{MODALITY_REGISTRY[m].label}</li>)}</ul>
        </div>
        <div>
          <h3>Formatos</h3>
          <ul>{FORMATS.map((f) => <li>{FORMAT_REGISTRY[f].label}</li>)}</ul>
        </div>
        <div>
          <h3>Anchos</h3>
          <ul>{WIDTHS.map((w) => <li>{WIDTH_LABEL[w]}</li>)}</ul>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { initHomeLayoutEditor } from '../../scripts/homeLayoutEditor';
  const root = document.getElementById('homeLayoutEditor');
  if (root) initHomeLayoutEditor(root);
</script>

<style is:global>
  .portada-wrapper { display: flex; flex-direction: column; gap: 30px; max-width: var(--max-width); margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
  .portada-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-lg); box-shadow: var(--shadow-card); padding: 1.6rem 2rem; }
  .portada-card-title { font-family: var(--font-heading); font-size: 1.15rem; color: var(--color-text-main); margin-bottom: 1rem; display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .portada-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 1.5rem; }
  .portada-grid dt { font-size: .75rem; color: var(--color-text-muted); font-weight: 600; margin-bottom: .2rem; }
  .portada-grid dd { color: var(--color-text-main); font-size: .92rem; }
  .portada-note { margin-top: 1rem; font-size: .85rem; color: var(--color-text-muted); line-height: 1.55; }
  .portada-pill { display: inline-flex; align-items: center; gap: .35rem; padding: .15rem .65rem; border-radius: 999px; font-size: .75rem; font-weight: 700; border: 1px solid transparent; }
  .portada-pill.is-ok { background: rgba(16, 185, 129, .14); color: #6ee7b7; border-color: rgba(16, 185, 129, .4); }
  .portada-pill.is-off { background: rgba(148, 163, 184, .12); color: #cbd5e1; border-color: rgba(148, 163, 184, .3); }
  .portada-pill.is-prov { background: rgba(245, 158, 11, .14); color: #fcd34d; border-color: rgba(245, 158, 11, .4); }
  .portada-lists { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1rem; }
  .portada-lists h3 { font-size: .8rem; color: var(--color-text-muted); margin-bottom: .4rem; }
  .portada-lists ul { list-style: none; display: flex; flex-wrap: wrap; gap: .4rem; }
  .portada-lists li { padding: .2rem .7rem; border-radius: var(--border-radius-sm); border: 1px solid var(--color-border); background: rgba(255, 255, 255, .03); font-size: .85rem; }
  /* Editor (etapa 3): elementos creados por JavaScript */
  .pe-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; padding-bottom: .8rem; border-bottom: 1px solid var(--color-border); margin-bottom: .8rem; }
  .pe-grow { flex: 1; }
  .pe-chip { display: inline-flex; padding: .2rem .7rem; border-radius: 999px; font-size: .78rem; font-weight: 700; border: 1px solid var(--color-border-hover); }
  .pe-chip.is-draft { background: rgba(245,158,11,.14); color: #fcd34d; border-color: rgba(245,158,11,.4); }
  .pe-chip.is-err { background: rgba(239,68,68,.14); color: #fca5a5; border-color: rgba(239,68,68,.45); }
  .pe-msg { font-size: .82rem; font-weight: 600; } .pe-msg.is-ok { color: #6ee7b7; } .pe-msg.is-error { color: #fca5a5; } .pe-msg.is-info { color: var(--color-text-muted); }
  .pe-note { font-size: .78rem; color: var(--color-text-muted); } .pe-warn { color: #fcd34d; }
  .pe-banner { display: flex; gap: .8rem; align-items: center; flex-wrap: wrap; padding: .7rem .9rem; border: 1px solid rgba(239,68,68,.5); background: rgba(239,68,68,.1); border-radius: var(--border-radius-sm); margin-bottom: .8rem; font-size: .85rem; }
  .pe-banner[hidden], .pe-modal[hidden] { display: none; }
  .pe-btn { min-height: 38px; padding: 0 14px; border-radius: var(--border-radius-sm); border: 1px solid var(--color-border-hover); background: rgba(255,255,255,.05); color: var(--color-text-main); font-weight: 700; cursor: pointer; }
  .pe-btn:hover:not(:disabled) { border-color: var(--color-primary); }
  .pe-btn:disabled { opacity: .45; cursor: not-allowed; }
  .pe-btn.pe-primary { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .pe-btn.pe-danger { background: #b91c1c; border-color: #b91c1c; color: #fff; }
  .pe-btn.pe-sm { min-height: 32px; padding: 0 10px; font-size: .78rem; }
  .pe-seg { display: inline-flex; border: 1px solid var(--color-border-hover); border-radius: var(--border-radius-sm); overflow: hidden; }
  .pe-seg button { min-height: 38px; padding: 0 12px; background: transparent; border: 0; color: var(--color-text-muted); font-weight: 700; cursor: pointer; }
  .pe-seg button[aria-pressed="true"] { background: var(--color-primary); color: #fff; }
  .pe-addbar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .7rem; padding: .7rem .9rem; border: 1px solid var(--color-border); border-radius: var(--border-radius-md); background: rgba(255,255,255,.02); }
  .pe-addbar label { font-size: .78rem; color: var(--color-text-muted); }
  #homeLayoutEditor select, #homeLayoutEditor input[type="text"], #homeLayoutEditor input[type="search"], #homeLayoutEditor input[type="number"], #homeLayoutEditor textarea { min-height: 38px; padding: 0 10px; border-radius: var(--border-radius-sm); border: 1px solid var(--color-border-hover); background: var(--color-bg-body); color: var(--color-text-main); font: inherit; max-width: 100%; }
  #homeLayoutEditor textarea { padding: 8px 10px; min-height: 70px; width: 100%; }
  #homeLayoutEditor :focus-visible { outline: 2px solid var(--color-accent-amber); outline-offset: 2px; }
  .pe-main { display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 14px; align-items: start; margin-top: 12px; }
  .pe-frame { margin: 0 auto; border: 1px dashed var(--color-border-hover); border-radius: var(--border-radius-md); padding: 10px; background: rgba(0,0,0,.2); }
  .pe-frame.is-mobile { width: min(390px, 100%); }
  .pe-canvas { display: grid; grid-template-columns: repeat(12, 1fr); gap: 10px; }
  .pe-empty { grid-column: 1 / -1; text-align: center; padding: 30px; color: var(--color-text-muted); }
  .pe-block { background: var(--color-surface-subtle); border: 1px solid var(--color-border-hover); border-radius: var(--border-radius-md); padding: 8px; display: flex; flex-direction: column; gap: 6px; min-width: 0; overflow: hidden; }
  .pe-block.is-sel { border-color: var(--color-primary); box-shadow: 0 0 0 2px rgba(59,130,246,.35); }
  .pe-block.is-bad { border-color: rgba(239,68,68,.6); } .pe-block.is-off { opacity: .6; }
  .pe-block.is-drag { opacity: .4; } .pe-block.is-over { outline: 2px dashed var(--color-accent-amber); }
  .pe-bh { display: flex; align-items: center; gap: 4px; } .pe-handle { cursor: grab; color: var(--color-text-muted); padding: 0 4px; user-select: none; }
  .pe-bt { flex: 1; min-width: 0; text-align: left; background: none; border: 0; color: inherit; font-weight: 700; font-size: .85rem; cursor: pointer; padding: 4px 2px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pe-ba { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .pe-chip-s { display: inline-block; font-size: .7rem; font-weight: 700; padding: 1px 8px; border-radius: 999px; background: rgba(59,130,246,.16); color: #93c5fd; } .pe-chip-s.is-alt { background: rgba(148,163,184,.14); color: #cbd5e1; }
  .pe-ib { width: 34px; height: 34px; border-radius: 8px; background: rgba(255,255,255,.05); border: 1px solid var(--color-border); color: var(--color-text-main); cursor: pointer; display: grid; place-items: center; font-size: .8rem; }
  .pe-ib:disabled { opacity: .35; cursor: not-allowed; }
  .pe-thumbs { display: flex; gap: 6px; overflow: hidden; } .pe-thumbs span { flex: 1; min-width: 40px; max-width: 80px; aspect-ratio: 1; background: #fff; color: #111; border-radius: 8px; font-size: .62rem; display: grid; place-items: center; padding: 3px; text-align: center; overflow: hidden; }
  .pe-thumbs .pe-banner-th { max-width: none; aspect-ratio: auto; height: 52px; background: linear-gradient(120deg,#3b1d6e,#0b1730); color: #ddd6fe; font-size: .72rem; font-weight: 700; } .pe-thumbs .is-empty { background: rgba(239,68,68,.12); color: #fca5a5; border: 1px dashed rgba(239,68,68,.5); }
  .pe-bad { font-size: .74rem; color: #fca5a5; } .pe-badge { font-size: .72rem; color: var(--color-text-muted); } .pe-badge.is-ok { color: #6ee7b7; } .pe-badge.is-warn { color: #fcd34d; } .pe-badge.is-err { color: #fca5a5; }
  .pe-widths { display: flex; gap: 3px; flex-wrap: wrap; } .pe-widths button { height: 30px; min-width: 30px; flex: 1; border-radius: 6px; background: rgba(0,0,0,.25); border: 1px solid var(--color-border-hover); color: var(--color-text-muted); font-weight: 700; font-size: .75rem; cursor: pointer; } .pe-widths button[aria-pressed="true"] { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .pe-props { border: 1px solid var(--color-border); border-radius: var(--border-radius-md); padding: 14px; background: rgba(255,255,255,.02); position: sticky; top: 12px; max-height: calc(100vh - 24px); overflow-y: auto; }
  .pe-props h3, .pe-pvbox h3 { font-family: var(--font-heading); font-size: 1rem; margin-bottom: 8px; display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .pe-field { margin-top: 10px; display: grid; gap: 4px; } .pe-field label { font-size: .75rem; color: var(--color-text-muted); font-weight: 600; } .pe-field small { font-size: .72rem; color: var(--color-text-muted); }
  .pe-field select, .pe-field input { width: 100%; } .pe-static { font-size: .85rem; } .pe-sub { font-size: .8rem; font-weight: 700; margin-top: 12px; } .pe-check { display: flex; gap: .4rem; align-items: center; font-size: .82rem; margin-top: 10px; cursor: pointer; }
  .pe-refs, .pe-results { list-style: none; display: grid; gap: 6px; margin: 6px 0; } .pe-refs li, .pe-results li { display: flex; align-items: center; gap: 4px; background: var(--color-bg-body); border: 1px solid var(--color-border); border-radius: 9px; padding: 4px 8px; font-size: .8rem; }
  .pe-ref-l { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .pe-results { max-height: 220px; overflow-y: auto; }
  .pe-previews { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 14px; margin-top: 16px; align-items: start; }
  .pe-pvbox { border: 1px solid var(--color-border); border-radius: var(--border-radius-md); padding: 12px; background: rgba(255,255,255,.02); }
  .pe-pvwin { position: relative; background: #0a0e17; border: 1px solid var(--color-border-hover); border-radius: 10px; overflow: hidden; } .pe-pvwin.is-phone { border-radius: 26px; border: 3px solid #2b3447; }
  .pv { position: absolute; top: 0; left: 0; color: #f3f4f6; font-family: var(--font-body); font-size: 15px; } .pv * { box-sizing: border-box; }
  .pv-hd { display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-bottom: 1px solid #1f2937; } .pv-hd span { flex: 1; border: 1px solid #374151; border-radius: 10px; padding: 8px 12px; color: #9ca3af; }
  .pv-grid12 { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; padding: 14px 18px 24px; } .pv.is-m .pv-grid12 { gap: 10px; padding: 10px 12px 20px; }
  .pv-bk { min-width: 0; } .pv-bk.is-off { opacity: .55; } .pv-bt { font-family: var(--font-heading); font-size: 19px; font-weight: 700; margin-bottom: 8px; }
  .pv-rail { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 36px) / 4); gap: 12px; overflow: hidden; } .pv.is-m .pv-rail { grid-auto-columns: 62%; }
  .pv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pv-card { background: #111827; border: 1px solid #1f2937; border-radius: 14px; padding: 9px; display: grid; gap: 6px; min-width: 0; } .pv-im { height: 110px; background: #fff; color: #9ca3af; border-radius: 10px; display: grid; place-items: center; font-size: 28px; }
  .pv-tt { font-size: 13px; color: #e5e7eb; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 36px; } .pv.is-m .pv-tt { font-size: 15px; } .pv-pr { font-weight: 800; font-size: 17px; }
  .pv-ban { border-radius: 16px; min-height: 150px; padding: 18px; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; background: linear-gradient(120deg,#3b1d6e,#0b1730 70%); border: 1px solid #374151; } .pv-ban h4 { font-family: var(--font-heading); font-size: 22px; line-height: 1.1; } .pv-ban p { color: #cbd5e1; font-size: 13px; }
  .pv-btn { width: fit-content; padding: 6px 14px; border-radius: 9px; background: #3b82f6; font-weight: 700; font-size: 13px; }
