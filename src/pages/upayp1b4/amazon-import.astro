---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminUserMenu from '../../components/AdminUserMenu.astro';
import { requireAdminAuth, getSessionUser } from '../../lib/adminAuth';
import { toPublicUser } from '../../lib/userStore';

const unauthorizedResponse = requireAdminAuth(Astro.request);
if (unauthorizedResponse) return unauthorizedResponse;

const sessionUser = getSessionUser(Astro.request);
const user = sessionUser ? toPublicUser(sessionUser) : null;
---

<Layout title="Amazon (JSON) · Catálogo · Tradylor Admin" description="Importa productos de Amazon desde un JSON crudo de ScraperAPI al catálogo.">
  <Fragment slot="header-end">
    {user && <AdminUserMenu user={user} active="amazon-import" />}
  </Fragment>

  <div class="admin-wrapper">
    <AdminNav context="catalogo" active="amazon-import" user={user} />

    <section data-admin-view="amazon-import" class:list={['admin-card', 'hidden-section', { 'is-visible': true }]} style="margin-top: 75px; display: inline-block; width: 100%; max-width: 900px; text-align: left;">
      <div class="card-header card-header-toggle">
        <div class="header-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <div>
          <h2 class="card-title">Amazon (JSON)</h2>
          <p class="card-desc">Pega el JSON crudo de ScraperAPI y el ASIN para importar el producto al catálogo sin pasar por el servidor de ScraperAPI.</p>
        </div>
      </div>

      <form id="amazonImportForm" style="display: grid; gap: 1rem; max-width: 700px; margin: 0 auto;">
        <div>
          <label class="field-label">ASIN de Amazon (10 caracteres)</label>
          <input type="text" id="asinInput" placeholder="Ej: B01EXDG2MO" maxlength="20" />
          <p class="label-hint">Puedes pegar el ASIN o una URL completa de Amazon.</p>
        </div>

        <div>
          <label class="field-label">JSON crudo de ScraperAPI</label>
          <textarea id="jsonInput" placeholder='Pega aquí el objeto JSON completo...' style="width:100%; min-height: 260px; font-family: ui-monospace; background:#0b1220; border:1px solid #374151; color:#e5e7eb; border-radius:8px; padding:.6rem .8rem;"></textarea>
          <p class="label-hint">Obtén el JSON desde otro sitio donde ScraperAPI funcione y pégalo aquí.</p>
        </div>

        <div class="checkbox-row">
          <input type="checkbox" id="saveCheckbox" checked />
          <label for="saveCheckbox">Guardar en el catálogo (desmarca para solo vista previa)</label>
        </div>

        <button type="button" id="importBtn" class="btn-primary">Importar producto</button>
      </form>

      <div id="resultBox" style="margin-top:1rem; padding:1rem; border-radius:8px; display:none;"></div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var asinInput = document.getElementById('asinInput');
      var jsonInput = document.getElementById('jsonInput');
      var saveCheckbox = document.getElementById('saveCheckbox');
      var importBtn = document.getElementById('importBtn');
      var resultBox = document.getElementById('resultBox');

      importBtn.addEventListener('click', function () {
        var asin = asinInput.value.trim();
        var rawText = jsonInput.value.trim();
        var save = saveCheckbox.checked;

        if (!asin) { showResult('error', 'Debes proporcionar un ASIN.'); return; }
        if (!rawText) { showResult('error', 'Debes pegar el JSON crudo de ScraperAPI.'); return; }

        var raw;
        try { raw = JSON.parse(rawText); } catch (e) { showResult('error', 'JSON inválido: ' + e.message); return; }

        importBtn.disabled = true;
        importBtn.textContent = 'Importando...';
        resultBox.style.display = 'none';

        fetch('/api/admin/amazon/import-json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ asin: asin, raw: raw, options: { save: save, imageOnlyIfMissing: true } })
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.success) {
            var msg = 'Éxito: ' + data.message + '\nASIN: ' + data.asin;
            if (data.warnings && data.warnings.length) msg += '\n\nAvisos:\n• ' + data.warnings.join('\n• ');
            showResult('ok', msg);
          } else {
            showResult('error', 'Error: ' + (data.message || 'Error desconocido'));
          }
        })
        .catch(function (err) { showResult('error', 'Error de red: ' + err.message); })
        .finally(function () {
          importBtn.disabled = false;
          importBtn.textContent = 'Importar producto';
        });
      });

      function showResult(type, text) {
        resultBox.className = 'ai-result ' + type;
        resultBox.textContent = text;
        resultBox.style.display = 'block';
      }
    })();
  </script>

  <style>
    .admin-wrapper { max-width: var(--max-width, 1200px); margin: 0 auto 0; padding: 2rem 1.25rem 5rem; text-align: center; }
    .admin-card { background: var(--color-bg-card, #111827); border: 1px solid var(--color-border, #1f2937); border-radius: var(--border-radius-lg, 12px); padding: 2rem; }
    .card-header { display: flex; align-items: center; gap: .75rem; margin-bottom: 1rem; }
    .header-icon { width: 32px; height: 32px; color: #60a5fa; }
    .card-title { margin: 0; font-size: 1.1rem; color: var(--color-text-main, #f3f4f6); }
    .card-desc { margin: .25rem 0 0; color: var(--color-text-muted, #9ca3af); font-size: .85rem; }
    .field-label { display: block; font-size: .85rem; color: var(--color-text-muted); font-weight: 600; margin-bottom: .4rem; }
    .label-hint { font-size: .78rem; color: #6b7280; margin-top: .25rem; }
    input[type="text"], textarea { width: 100%; background: #0b1220; border: 1px solid #374151; border-radius: 8px; color: #e5e7eb; padding: .6rem .8rem; font-size: .9rem; box-sizing: border-box; }
    textarea { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; resize: vertical; }
    .checkbox-row { display: flex; align-items: center; gap: .5rem; margin-top: .5rem; }
    .checkbox-row input { width: auto; margin: 0; }
    .btn-primary { background: #38bdf8; color: #07111f; border: none; border-radius: 8px; padding: .6rem 1.25rem; font-weight: 800; cursor: pointer; font-size: .95rem; margin-top: .5rem; }
    .btn-primary:disabled { opacity: .6; cursor: not-allowed; }
    .btn-primary:hover:not(:disabled) { background: #7dd3fc; }
    .ai-result { margin-top: 1rem; padding: 1rem; border-radius: 8px; display: none; }
    .ai-result.ok { background: rgba(16, 185, 129, .12); border: 1px solid rgba(16, 185, 129, .3); color: #a7f3d0; }
    .ai-result.error { background: rgba(239, 68, 68, .1); border: 1px solid rgba(239, 68, 68, .3); color: #fecaca; }
  </style>
</Layout>