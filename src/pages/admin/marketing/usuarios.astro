---
/**
 * TRADYLOR — /admin/marketing/usuarios
 * Módulo de Usuarios del Marketing: Ficha de Usuario 360, Segmentador de
 * Audiencias e Integración de Email Marketing (Mailchimp / Brevo / Resend).
 *
 * Nota de estilos: la lista de usuarios y las fichas se pintan desde JavaScript
 * (innerHTML). El CSS con scope de Astro ([data-astro-cid-*]) NO alcanza a esos
 * nodos, por eso todas las reglas `.mu-*` viven en el bloque `<style is:global>`
 * del final (el prefijo `mu-` es exclusivo de esta página).
 */
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/AdminNav.astro';
import AdminUserMenu from '../../../components/AdminUserMenu.astro';
import MarketingMenu from '../../../components/admin/MarketingMenu.astro';
import { getSessionUser } from '../../../lib/adminAuth';
import { RADAR_HOBBIES, RADAR_PROFILE_TYPES } from '../../../lib/radarAuth';
import { getAudience360, profileTypeLabel } from '../../../lib/marketingAudience';
import { emailPlatformStatus, getMarketingEmailConfig, hasEmailChannel } from '../../../lib/marketingEmail';
import { getSmtpConfig } from '../../../lib/mailer';
import { getCategories } from '../../../lib/categories';

const sessionUser = getSessionUser(Astro.request);
if (!sessionUser) return Astro.redirect('/admin');
if (sessionUser.role !== 'admin') return Astro.redirect('/admin/perfil');

Astro.response.headers.set('Cache-Control', 'no-store');

const HOBBY_LABELS: Record<string, string> = {
  'fotografia-video': 'Fotografía & Vídeo',
  'rutas-aventura': 'Rutas & Aventura',
  'musica-audio': 'Música & Audio',
  'bricolaje-diy': 'Bricolaje & DIY',
  decoracion: 'Decoración',
  otros: 'Otros',
};

const users = getAudience360();
const hobbySlugs = Array.from(
  new Set<string>([...RADAR_HOBBIES, ...users.flatMap((user) => user.declared.hobbies)]),
);
const hobbyOptions = hobbySlugs.map((slug) => ({ slug, label: HOBBY_LABELS[slug] ?? slug }));
const profileOptions = RADAR_PROFILE_TYPES.map((value) => ({
  value,
  label: profileTypeLabel(value),
}));
const categoryLabels: Record<string, string> = {};
for (const category of getCategories()) categoryLabels[category.slug] = category.name;
const platformStates = (['mailchimp', 'brevo', 'resend'] as const).map((id) => ({
  id,
  ...emailPlatformStatus(id),
}));

const payload = {
  users,
  config: getMarketingEmailConfig(),
  channels: { smtp: Boolean(getSmtpConfig()), email: hasEmailChannel() },
  platformStates,
  hobbyOptions,
  profileOptions,
  categoryLabels,
};
// `</` evita cerrar el <script> accidentalmente si un título lo contiene.
const payloadJson = JSON.stringify(payload).replace(/</g, '\\u003c');
---

<Layout
  title="Usuarios | Marketing | Admin Tradylor"
  description="Audiencias y perfiles 360° del módulo de Marketing."
>
  <Fragment slot="header-end">
    <AdminUserMenu user={sessionUser} active="marketing" />
  </Fragment>
  <div class="admin-module-wrapper">
    <header class="admin-header">
      <div class="admin-tag-row">
        <a class="admin-tag-link" href="/admin">Panel de administración</a>
        <span class="admin-tag-sep" aria-hidden="true">/</span>
        <a class="admin-tag-link" href="/admin/marketing">Marketing</a>
        <span class="admin-tag-sep" aria-hidden="true">/</span>
        <div class="admin-tag-pill">Usuarios</div>
      </div>
      <h1 class="admin-title">Usuarios</h1>
      <p class="admin-subtitle">
        Perfiles 360° de la audiencia: hobbies declarados, LTV, favoritos, carrito, lead score
        0–100 y segmentos listos para email marketing.
      </p>
    </header>

    <AdminNav context="catalogo" active="marketing" user={sessionUser} />

    <MarketingMenu active="usuarios" />

    <nav class="mu-tabs" aria-label="Apartados de Usuarios">
      <button type="button" class="mu-tab is-active" data-mu-tab="ficha">Ficha de Usuario 360</button>
      <button type="button" class="mu-tab" data-mu-tab="segmentador">Segmentador de Audiencias</button>
      <button type="button" class="mu-tab" data-mu-tab="integracion">Integración Email Marketing</button>
    </nav>

    <!-- ============ Ficha de Usuario 360 ============ -->
    <section class="mu-panel is-active" data-mu-panel="ficha">
      <div class="mu-listbar">
        <input type="search" class="mu-input mu-search" placeholder="Buscar por correo o nombre…" data-mu-search />
        <select class="mu-input" data-mu-filter-country aria-label="Filtrar por país">
          <option value="">Todos los países</option>
        </select>
        <select class="mu-input" data-mu-filter-hobby aria-label="Filtrar por hobby">
          <option value="">Todos los hobbies</option>
          {hobbyOptions.map((hobby) => <option value={hobby.slug}>{hobby.label}</option>)}
        </select>
        <select class="mu-input" data-mu-sort aria-label="Ordenar la lista">
          <option value="visitas">Más visitas</option>
          <option value="compras">Más compras</option>
          <option value="gastado">Más dinero gastado</option>
          <option value="radar">Más productos en el radar</option>
          <option value="compartidos" disabled>Más compartidos (sin datos aún)</option>
          <option value="cumpleanos">Cumpleaños más próximo</option>
          <option value="score">Lead score más alto</option>
          <option value="nombre">Nombre (A-Z)</option>
        </select>
        <span class="mu-count" data-mu-count></span>
        <button type="button" class="mu-btn mu-btn-ghost" data-mu-refresh>Actualizar</button>
      </div>
      <div class="mu-table-host" data-mu-table="ficha"></div>
    </section>

    <!-- ============ Segmentador de Audiencias ============ -->
    <section class="mu-panel" data-mu-panel="segmentador">
      <form class="mu-filters" data-mu-filters>
        <label class="mu-field">
          <span class="mu-k">Hobby</span>
          <select class="mu-input" name="hobby">
            <option value="">Todos</option>
            {hobbyOptions.map((hobby) => <option value={hobby.slug}>{hobby.label}</option>)}
          </select>
        </label>
        <label class="mu-field">
          <span class="mu-k">Tipo de perfil</span>
          <select class="mu-input" name="profile">
            <option value="">Todos</option>
            {profileOptions.map((profile) => <option value={profile.value}>{profile.label}</option>)}
          </select>
        </label>
        <label class="mu-field">
          <span class="mu-k">Lead score mínimo</span>
          <select class="mu-input" name="minScore">
            <option value="">Cualquiera</option>
            <option value="40">40+ (tibio o caliente)</option>
            <option value="70">70+ (caliente)</option>
          </select>
        </label>
        <label class="mu-field">
          <span class="mu-k">Carrito</span>
          <select class="mu-input" name="hasCart">
            <option value="">Cualquiera</option>
            <option value="1">Con producto pendiente</option>
            <option value="0">Sin producto pendiente</option>
          </select>
        </label>
        <label class="mu-field">
          <span class="mu-k">Compró en los últimos</span>
          <select class="mu-input" name="boughtDays">
            <option value="">Cualquiera</option>
            <option value="7">7 días</option>
            <option value="30">30 días</option>
            <option value="90">90 días</option>
          </select>
        </label>
        <label class="mu-field">
          <span class="mu-k">Sin comprar desde hace</span>
          <select class="mu-input" name="notBoughtDays">
            <option value="">Cualquiera</option>
            <option value="30">30 días (o nunca)</option>
            <option value="90">90 días (o nunca)</option>
          </select>
        </label>
        <div class="mu-filter-actions">
          <button type="submit" class="mu-btn">Aplicar filtros</button>
          <button type="button" class="mu-btn mu-btn-ghost" data-mu-reset>Limpiar</button>
        </div>
      </form>
      <div class="mu-toolbar">
        <span class="mu-count" data-mu-segment-count></span>
        <button type="button" class="mu-btn mu-btn-ghost" data-mu-copy-emails>Copiar emails</button>
      </div>
      <div class="mu-table-host" data-mu-table="segmento"></div>
    </section>

    <!-- ============ Integración Email Marketing ============ -->
    <section class="mu-panel" data-mu-panel="integracion">
      <div class="mu-integrations">
        <div class="mu-int-card">
          <h2 class="mu-int-title">Plataforma de email</h2>
          <p class="mu-int-desc">
            Elige la herramienta con la que sincronizarás los segmentos. La API key se
            configura en el entorno (nunca en el panel).
          </p>
          <div class="mu-platforms" data-mu-platforms>
            {platformStates.map((platform) => (
              <label class="mu-platform">
                <input type="radio" name="platform" value={platform.id} data-mu-platform-radio />
                <span class="mu-platform-body">
                  <span class="mu-platform-name">
                    {platform.id === 'mailchimp' ? 'Mailchimp' : platform.id === 'brevo' ? 'Brevo' : 'Resend'}
                  </span>
                  <span class="mu-platform-env" data-env-key={platform.envKey}>
                    {platform.envConfigured ? 'API key detectada en el entorno' : `Pendiente: definir ${platform.envKey}`}
                  </span>
                </span>
              </label>
            ))}
            <label class="mu-platform">
              <input type="radio" name="platform" value="" data-mu-platform-radio />
              <span class="mu-platform-body">
                <span class="mu-platform-name">Sin plataforma</span>
                <span class="mu-platform-env">Sólo envíos directos (SMTP / n8n)</span>
              </span>
            </label>
          </div>

          <h2 class="mu-int-title mu-int-title-spaced">Triggers automáticos</h2>
          <div class="mu-triggers">
            <label class="mu-trigger">
              <input type="checkbox" name="welcome" data-mu-trigger />
              <span>
                <strong>Bienvenida</strong>
                <em>Email de verificación de cuenta al registrarse (activo por el sistema).</em>
              </span>
            </label>
            <label class="mu-trigger">
              <input type="checkbox" name="cartRecovery" data-mu-trigger />
              <span>
                <strong>Carrito abandonado · cada 24 h</strong>
                <em>Aviso automático mientras el producto siga pendiente (máx. 3 por carrito).</em>
              </span>
            </label>
            <label class="mu-trigger">
              <input type="checkbox" name="birthday" data-mu-trigger />
              <span>
                <strong>Cumpleaños</strong>
                <em>Felicitación una vez al año si el perfil tiene fecha de nacimiento.</em>
              </span>
            </label>
          </div>

          <div class="mu-channels" data-mu-channels></div>

          <div class="mu-int-actions">
            <button type="button" class="mu-btn" data-mu-save-integrations>Guardar configuración</button>
            <span class="mu-int-saved" data-mu-int-saved hidden></span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="mu-toast" data-mu-toast hidden></div>

  <script type="application/json" id="mu-data" set:html={payloadJson} />
</Layout>

<script>
  interface CartItem { productId: string; title: string; atISO: string; value: number }
  interface Purchase { productId: string; title: string; atISO: string; value: number }
  interface Viewed { id: string; title: string; atISO: string }
  interface User360 {
    id: string; email: string; name?: string; provider: string; createdAtISO: string;
    declared: {
      hobbies: string[]; hobbiesOther?: string; profileType?: string;
      preferredCategories: string[]; city?: string; country?: string; birthDate?: string;
    };
    behavior: {
      lastCategoryId?: string; lastCategoryLabel?: string; lastVisitAtISO?: string;
      visits: number;
      ltv: number; purchaseCount: number; lastPurchaseAtISO?: string;
      affiliateClicks: number; dismissedCount: number;
      cartItems: CartItem[]; cartTotal: number; cartAbandonRatePct: number | null;
      cartReminder?: { sentAtISO: string; count: number };
      purchases: Purchase[]; viewedNotBought: Viewed[]; savedCount: number;
    };
    leadScore: { value: number; band: 'caliente' | 'tibio' | 'frio'; factors: { label: string; points: number }[] };
  }
  interface Payload {
    users: User360[];
    config: { platform: string | null; triggers: { welcome: boolean; cartRecovery: boolean; birthday: boolean }; updatedAt?: string };
    channels: { smtp: boolean; email: boolean };
    platformStates: { id: string; envConfigured: boolean; envKey: string }[];
    hobbyOptions: { slug: string; label: string }[];
    profileOptions: { value: string; label: string }[];
    categoryLabels: Record<string, string>;
  }
  interface Filters {
    q?: string; hobby?: string; profile?: string; minScore?: number;
    hasCart?: boolean; boughtDays?: number; notBoughtDays?: number;
  }
  type SortKey = 'visitas' | 'compras' | 'gastado' | 'radar' | 'cumpleanos' | 'score' | 'nombre';

  const DAY_MS = 86_400_000;
  const PAGE_SIZE = 50;
  const COLS = 11;

  function must<T extends Element>(selector: string): T {
    const el = document.querySelector<T>(selector);
    if (!el) throw new Error(`[usuarios] falta el elemento ${selector}`);
    return el;
  }

  const data = JSON.parse(document.getElementById('mu-data')?.textContent ?? '{}') as Payload;
  let users: User360[] = Array.isArray(data.users) ? data.users : [];
  let usersById = new Map<string, User360>();
  const reindex = (): void => {
    usersById = new Map(users.map((user) => [user.id, user] as const));
  };

  // ---------------------------------------------------------------- formato
  const esc = (value: string): string =>
    value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  const moneyFmt = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });
  const money = (value: number): string => moneyFmt.format(value);

  const shortFmt = new Intl.DateTimeFormat('es-ES', { dateStyle: 'short', timeZone: 'Europe/Madrid' });
  const longFmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' });
  const dayMonthFmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short' });
  const dayMonthLongFmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long' });

  const fmtDate = (fmt: Intl.DateTimeFormat, iso?: string): string => {
    if (!iso) return '—';
    const time = Date.parse(iso);
    return Number.isNaN(time) ? '—' : fmt.format(new Date(time));
  };

  interface Birth { month: number; day: number; year?: number }

  function parseBirth(value?: string): Birth | null {
    const match = /^(?:(\d{4})-)?(\d{2})-(\d{2})$/.exec((value ?? '').trim());
    if (!match) return null;
    const month = Number(match[2]);
    const day = Number(match[3]);
    if (month < 1 || month > 12 || day < 1 || day > 31) return null;
    return { month, day, year: match[1] ? Number(match[1]) : undefined };
  }

  /** Días que faltan hasta el próximo cumpleaños (0 = hoy). null si no hay fecha válida. */
  function daysToBirthday(value?: string): number | null {
    const birth = parseBirth(value);
    if (!birth) return null;
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    let next = new Date(today.getFullYear(), birth.month - 1, birth.day);
    if (next.getTime() < today.getTime()) next = new Date(today.getFullYear() + 1, birth.month - 1, birth.day);
    return Math.round((next.getTime() - today.getTime()) / DAY_MS);
  }

  function birthdayCell(value?: string): string {
    const birth = parseBirth(value);
    if (!birth) return '<span class="mu-soon">—</span>';
    const label = dayMonthFmt.format(new Date(2000, birth.month - 1, birth.day));
    const days = daysToBirthday(value);
    if (days === 0) return `${esc(label)} <span class="mu-bday is-today">hoy</span>`;
    if (days !== null && days <= 30) return `${esc(label)} <span class="mu-bday">en ${days} d</span>`;
    return esc(label);
  }

  function birthdayDetail(value?: string): string {
    const birth = parseBirth(value);
    if (!birth) return 'Sin declarar';
    const parts = [dayMonthLongFmt.format(new Date(2000, birth.month - 1, birth.day))];
    if (birth.year) {
      const now = new Date();
      const hadBirthday =
        now.getMonth() + 1 > birth.month || (now.getMonth() + 1 === birth.month && now.getDate() >= birth.day);
      parts.push(`${now.getFullYear() - birth.year - (hadBirthday ? 0 : 1)} años`);
    }
    const days = daysToBirthday(value);
    if (days !== null) parts.push(days === 0 ? 'es hoy' : `faltan ${days} día${days === 1 ? '' : 's'}`);
    return esc(parts.join(' · '));
  }

  const hobbyLabel = (slug: string): string => data.hobbyOptions.find((hobby) => hobby.slug === slug)?.label ?? slug;
  const categoryLabel = (slug: string): string => data.categoryLabels[slug] ?? slug;
  const providerLabel = (provider: string): string =>
    provider === 'google' ? 'Google' : provider === 'email' ? 'Email y contraseña' : provider;
  const bandLabel: Record<string, string> = { caliente: 'Caliente', tibio: 'Tibio', frio: 'Frío' };

  const chips = (values: string[], label: (value: string) => string): string =>
    values.length
      ? values.map((value) => `<span class="mu-chip">${esc(label(value))}</span>`).join('')
      : '<span class="mu-empty-inline">Sin declarar</span>';

  function hobbyChips(declared: User360['declared']): string {
    if (!declared.hobbies.length) return '<span class="mu-empty-inline">Sin declarar</span>';
    return declared.hobbies
      .map((slug) => {
        const label = slug === 'otros' && declared.hobbiesOther ? `Otros: ${declared.hobbiesOther}` : hobbyLabel(slug);
        return `<span class="mu-chip">${esc(label)}</span>`;
      })
      .join('');
  }

  const listItems = (items: { title: string; atISO?: string }[]): string =>
    items.length
      ? items
          .slice(0, 5)
          .map((item) => `<li><span>${esc(item.title)}</span><time>${fmtDate(shortFmt, item.atISO)}</time></li>`)
          .join('') + (items.length > 5 ? `<li class="mu-empty-inline">… y ${items.length - 5} más</li>` : '')
      : '<li class="mu-empty-inline">Ninguno</li>';

  // ----------------------------------------------------------------- toast
  const toastEl = must<HTMLElement>('[data-mu-toast]');
  let toastTimer: number | undefined;
  const toast = (message: string, isError = false): void => {
    toastEl.textContent = message;
    toastEl.classList.toggle('is-error', isError);
    toastEl.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toastEl.hidden = true;
    }, 3800);
  };

  // ----------------------------------------------- ficha desplegable (detalle)
  function detailHtml(user: User360): string {
    const b = user.behavior;
    const d = user.declared;
    const reminder = b.cartReminder
      ? `${fmtDate(shortFmt, b.cartReminder.sentAtISO)} · ${b.cartReminder.count} envío${b.cartReminder.count === 1 ? '' : 's'}`
      : 'Ninguno';
    const remindDisabled = b.cartItems.length === 0 || !data.channels.email;
    const remindHint =
      b.cartItems.length === 0
        ? 'No tiene productos pendientes en el carrito'
        : !data.channels.email
          ? 'Sin canal de email configurado (SMTP o N8N_CART_WEBHOOK_URL)'
          : 'Envía ahora el aviso de carrito';
    const factors = user.leadScore.factors
      .map((factor) => `<li><span>${esc(factor.label)}</span><strong>+${factor.points}</strong></li>`)
      .join('');
    return `
      <div class="mu-detail" data-user-id="${esc(user.id)}">
        <section class="mu-dcol">
          <h3 class="mu-dtitle">Perfil declarado</h3>
          <dl class="mu-dl">
            <dt>Nombre</dt><dd>${esc(user.name || 'Sin nombre')}</dd>
            <dt>Correo</dt><dd>${esc(user.email)}</dd>
            <dt>Alta</dt><dd>${esc(providerLabel(user.provider))} · ${fmtDate(longFmt, user.createdAtISO)}</dd>
            <dt>Tipo de perfil</dt><dd>${esc(d.profileType ?? 'Sin definir')}</dd>
            <dt>Ubicación</dt><dd>${esc([d.city, d.country].filter(Boolean).join(', ') || 'Sin declarar')}</dd>
            <dt>Cumpleaños</dt><dd>${birthdayDetail(d.birthDate)}</dd>
          </dl>
          <div><span class="mu-k">Hobbies</span><div class="mu-chips">${hobbyChips(d)}</div></div>
          <div><span class="mu-k">Categorías de interés</span><div class="mu-chips">${chips(d.preferredCategories, categoryLabel)}</div></div>
        </section>
        <section class="mu-dcol">
          <h3 class="mu-dtitle">Actividad</h3>
          <dl class="mu-dl">
            <dt>Visitas a fichas</dt><dd>${b.visits}</dd>
            <dt>Última visita</dt><dd>${fmtDate(longFmt, b.lastVisitAtISO)}</dd>
            <dt>Última categoría</dt><dd>${esc(b.lastCategoryLabel ?? '—')}</dd>
            <dt>Productos en su radar</dt><dd>${b.savedCount}</dd>
            <dt>Clics en «Comprar»</dt><dd>${b.affiliateClicks}</dd>
            <dt>Descartados</dt><dd>${b.dismissedCount}</dd>
            <dt>Compartidos</dt><dd class="mu-soon">Sin captura aún</dd>
          </dl>
          <div><span class="mu-k">Vistos, no comprados</span><ul class="mu-mini-list">${listItems(b.viewedNotBought)}</ul></div>
        </section>
        <section class="mu-dcol">
          <h3 class="mu-dtitle">Compras y carrito</h3>
          <dl class="mu-dl">
            <dt title="Compras que el usuario confirmó en Mi Radar («¿Compraste este producto?»)">Compras confirmadas</dt><dd>${b.purchaseCount}</dd>
            <dt>Dinero gastado (LTV)</dt><dd>${money(b.ltv)}</dd>
            <dt>Última compra</dt><dd>${fmtDate(longFmt, b.lastPurchaseAtISO)}</dd>
            <dt>En el carrito</dt><dd>${b.cartItems.length} · ${money(b.cartTotal)}</dd>
            <dt>Tasa de abandono</dt><dd>${b.cartAbandonRatePct === null ? '—' : `${b.cartAbandonRatePct}%`}</dd>
            <dt>Avisos de carrito</dt><dd>${esc(reminder)}</dd>
          </dl>
          <div><span class="mu-k">Comprados</span><ul class="mu-mini-list">${listItems(b.purchases)}</ul></div>
          <div><span class="mu-k">Carrito pendiente</span><ul class="mu-mini-list">${listItems(b.cartItems)}</ul></div>
          <button type="button" class="mu-btn mu-btn-small" data-remind title="${esc(remindHint)}"${remindDisabled ? ' disabled' : ''}>Enviar aviso de carrito</button>
        </section>
        <section class="mu-dcol">
          <h3 class="mu-dtitle">Lead score</h3>
          <div class="mu-score" data-band="${esc(user.leadScore.band)}">
            <span class="mu-score-value">${user.leadScore.value}</span>
            <span class="mu-score-band">${esc(bandLabel[user.leadScore.band] ?? user.leadScore.band)}</span>
          </div>
          <ul class="mu-factors-list">${factors || '<li class="mu-empty-inline">Sin factores: perfil frío sin actividad.</li>'}</ul>
        </section>
      </div>`;
  }

  // ------------------------------------------------------------- tabla de usuarios
  function rowHtml(user: User360, isOpen: boolean): string {
    const b = user.behavior;
    const id = esc(user.id);
    return `
      <tr class="mu-row${isOpen ? ' is-open' : ''}" data-row-id="${id}" tabindex="0" aria-expanded="${isOpen}">
        <td class="mu-cell-email">${esc(user.email)}</td>
        <td class="mu-cell-name">${esc(user.name || '—')}</td>
        <td class="mu-hide-md">${esc(user.declared.country || '—')}</td>
        <td class="mu-num">${b.visits}</td>
        <td class="mu-num">${b.purchaseCount}</td>
        <td class="mu-num">${b.ltv > 0 ? money(b.ltv) : '—'}</td>
        <td class="mu-num">${b.savedCount}</td>
        <td class="mu-num mu-hide-md mu-soon" title="Métrica aún sin captura">—</td>
        <td class="mu-num"><span class="mu-score-pill" data-band="${esc(user.leadScore.band)}" title="${esc(bandLabel[user.leadScore.band] ?? '')}">${user.leadScore.value}</span></td>
        <td class="mu-hide-sm">${birthdayCell(user.declared.birthDate)}</td>
        <td class="mu-num mu-caret-cell"><button type="button" class="mu-caret" aria-label="Ver ficha completa de ${id}">▸</button></td>
      </tr>
      <tr class="mu-detail-row" data-detail-id="${id}"${isOpen ? '' : ' hidden'}>
        <td colspan="${COLS}">${isOpen ? detailHtml(user) : ''}</td>
      </tr>`;
  }

  function pageWindow(page: number, pages: number): Array<number | '…'> {
    const wanted = new Set<number>([1, pages, page - 1, page, page + 1]);
    const nums = [...wanted].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
    const out: Array<number | '…'> = [];
    nums.forEach((n, index) => {
      if (index > 0 && n - nums[index - 1] > 1) out.push('…');
      out.push(n);
    });
    return out;
  }

  function pagerHtml(page: number, pages: number, total: number, start: number, shown: number): string {
    if (total === 0) return '';
    const info = `<span class="mu-page-info">Mostrando ${start + 1}–${start + shown} de ${total}</span>`;
    if (pages <= 1) return info;
    const btn = (label: string, target: number, opts: { disabled?: boolean; current?: boolean; aria?: string } = {}): string =>
      `<button type="button" class="mu-page-btn${opts.current ? ' is-current' : ''}" data-page="${target}"${opts.disabled ? ' disabled' : ''}${opts.current ? ' aria-current="page"' : ''}${opts.aria ? ` aria-label="${opts.aria}"` : ''}>${label}</button>`;
    const nums = pageWindow(page, pages)
      .map((n) => (n === '…' ? '<span class="mu-page-gap">…</span>' : btn(String(n), n, { current: n === page })))
      .join('');
    return `${info}<div class="mu-pager-nav">${btn('‹', page - 1, { disabled: page <= 1, aria: 'Página anterior' })}${nums}${btn('›', page + 1, { disabled: page >= pages, aria: 'Página siguiente' })}</div>`;
  }

  interface RenderOptions { emptyHtml?: string; keepPage?: boolean }
  interface UserTable { render(list: User360[], options?: RenderOptions): void }

  function createTable(root: HTMLElement): UserTable {
    root.innerHTML = `
      <table class="mu-table">
        <thead>
          <tr>
            <th>Correo electrónico</th>
            <th>Nombre</th>
            <th class="mu-hide-md">País</th>
            <th class="mu-num">Visitas</th>
            <th class="mu-num">Compras</th>
            <th class="mu-num">Gastado</th>
            <th class="mu-num">En radar</th>
            <th class="mu-num mu-hide-md" title="Métrica aún sin captura">Compartidos</th>
            <th class="mu-num">Score</th>
            <th class="mu-hide-sm">Cumpleaños</th>
            <th class="mu-num mu-caret-cell"><span class="mu-sr">Detalles</span></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
      <div class="mu-pager"></div>`;
    const tbody = root.querySelector('tbody') as HTMLElement;
    const pager = root.querySelector('.mu-pager') as HTMLElement;

    let list: User360[] = [];
    let page = 1;
    let emptyHtml = '';
    const openIds = new Set<string>();

    function draw(): void {
      const pages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
      page = Math.min(Math.max(1, page), pages);
      const start = (page - 1) * PAGE_SIZE;
      const slice = list.slice(start, start + PAGE_SIZE);
      tbody.innerHTML = slice.length
        ? slice.map((user) => rowHtml(user, openIds.has(user.id))).join('')
        : `<tr><td colspan="${COLS}" class="mu-empty-cell">${emptyHtml}</td></tr>`;
      pager.innerHTML = pagerHtml(page, pages, list.length, start, slice.length);
    }

    function toggleRow(row: HTMLElement): void {
      const id = row.dataset.rowId;
      const detail = row.nextElementSibling as HTMLElement | null;
      if (!id || !detail || !detail.classList.contains('mu-detail-row')) return;
      const willOpen = detail.hidden;
      if (willOpen) {
        const user = usersById.get(id);
        const cell = detail.firstElementChild as HTMLElement | null;
        if (user && cell) cell.innerHTML = detailHtml(user);
        openIds.add(id);
      } else {
        openIds.delete(id);
      }
      detail.hidden = !willOpen;
      row.classList.toggle('is-open', willOpen);
      row.setAttribute('aria-expanded', String(willOpen));
    }

    tbody.addEventListener('click', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>('tr.mu-row');
      if (row) toggleRow(row);
    });
    tbody.addEventListener('keydown', (event) => {
      const row = event.target as HTMLElement;
      if ((event.key === 'Enter' || event.key === ' ') && row.classList.contains('mu-row')) {
        event.preventDefault();
        toggleRow(row);
      }
    });
    pager.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-page]');
      if (!button || button.disabled) return;
      page = Number(button.dataset.page) || 1;
      draw();
      root.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });

    return {
      render(next, options = {}) {
        list = next;
        if (!options.keepPage) page = 1;
        emptyHtml = options.emptyHtml ?? 'Sin resultados.';
        draw();
      },
    };
  }

  // ----------------------------------------------------- ficha: filtros y orden
  const searchInput = must<HTMLInputElement>('[data-mu-search]');
  const countrySelect = must<HTMLSelectElement>('[data-mu-filter-country]');
  const hobbySelect = must<HTMLSelectElement>('[data-mu-filter-hobby]');
  const sortSelect = must<HTMLSelectElement>('[data-mu-sort]');
  const countEl = must<HTMLElement>('[data-mu-count]');
  const fichaTable = createTable(must<HTMLElement>('[data-mu-table="ficha"]'));

  const sortFns: Record<SortKey, (a: User360, b: User360) => number> = {
    visitas: (a, b) => b.behavior.visits - a.behavior.visits,
    compras: (a, b) => b.behavior.purchaseCount - a.behavior.purchaseCount,
    gastado: (a, b) => b.behavior.ltv - a.behavior.ltv,
    radar: (a, b) => b.behavior.savedCount - a.behavior.savedCount,
    cumpleanos: (a, b) =>
      (daysToBirthday(a.declared.birthDate) ?? Number.MAX_SAFE_INTEGER) -
      (daysToBirthday(b.declared.birthDate) ?? Number.MAX_SAFE_INTEGER),
    score: (a, b) => b.leadScore.value - a.leadScore.value,
    nombre: (a, b) => (a.name || a.email).localeCompare(b.name || b.email, 'es'),
  };

  /** Clave para agrupar países escritos distinto ("España", "españa"). */
  const countryKey = (value?: string): string =>
    (value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase();

  function fillCountries(): void {
    const keep = countrySelect.value;
    // Se agrupan grafías distintas ("España", "españa") y se muestra la más frecuente.
    const groups = new Map<string, { spellings: Map<string, number>; count: number }>();
    for (const user of users) {
      const label = (user.declared.country ?? '').trim();
      if (!label) continue;
      const key = countryKey(label);
      const group = groups.get(key) ?? { spellings: new Map<string, number>(), count: 0 };
      group.count += 1;
      group.spellings.set(label, (group.spellings.get(label) ?? 0) + 1);
      groups.set(key, group);
    }
    const bestLabel = (group: { spellings: Map<string, number> }): string =>
      [...group.spellings.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'es'))[0][0];
    const options = [...groups.entries()]
      .map(([key, group]) => ({ key, label: bestLabel(group), count: group.count }))
      .sort((a, b) => a.label.localeCompare(b.label, 'es'));
    countrySelect.innerHTML =
      '<option value="">Todos los países</option>' +
      options.map((o) => `<option value="${esc(o.key)}">${esc(o.label)} (${o.count})</option>`).join('');
    countrySelect.value = groups.has(keep) ? keep : '';
  }

  function applyFicha(keepPage = false): void {
    const query = searchInput.value.trim().toLowerCase();
    const country = countrySelect.value;
    const hobby = hobbySelect.value;
    const sortKey = (sortSelect.value in sortFns ? sortSelect.value : 'visitas') as SortKey;
    const list = users
      .filter((user) => {
        if (query && !`${user.email} ${user.name ?? ''}`.toLowerCase().includes(query)) return false;
        if (country && countryKey(user.declared.country) !== country) return false;
        if (hobby && !user.declared.hobbies.includes(hobby)) return false;
        return true;
      })
      .sort((a, b) => sortFns[sortKey](a, b) || a.email.localeCompare(b.email));
    countEl.textContent = `${list.length} de ${users.length} usuario${users.length === 1 ? '' : 's'}`;
    fichaTable.render(list, {
      keepPage,
      emptyHtml: users.length
        ? 'Ningún usuario coincide con los filtros.'
        : 'Todavía no hay usuarios registrados en Mi Radar.',
    });
  }

  searchInput.addEventListener('input', () => applyFicha());
  countrySelect.addEventListener('change', () => applyFicha());
  hobbySelect.addEventListener('change', () => applyFicha());
  sortSelect.addEventListener('change', () => applyFicha());

  // ------------------------------------------------------------- segmentador
  const segmentCount = must<HTMLElement>('[data-mu-segment-count]');
  const segmentTable = createTable(must<HTMLElement>('[data-mu-table="segmento"]'));
  const SEGMENT_HINT = 'Elige filtros y pulsa «Aplicar filtros» para ver el segmento.';
  let segment: User360[] = [];
  let lastFilters: Filters | null = null;

  function filterUsers(filters: Filters): User360[] {
    const now = Date.now();
    return users.filter((user) => {
      const q = filters.q?.trim().toLowerCase();
      if (q && !`${user.email} ${user.name ?? ''}`.toLowerCase().includes(q)) return false;
      if (filters.hobby && !user.declared.hobbies.includes(filters.hobby)) return false;
      if (filters.profile) {
        const label = data.profileOptions.find((option) => option.value === filters.profile)?.label;
        if (user.declared.profileType !== label) return false;
      }
      if (typeof filters.minScore === 'number' && user.leadScore.value < filters.minScore) return false;
      if (filters.hasCart !== undefined && (user.behavior.cartItems.length > 0) !== filters.hasCart) return false;
      const last = user.behavior.lastPurchaseAtISO ? Date.parse(user.behavior.lastPurchaseAtISO) : null;
      if (typeof filters.boughtDays === 'number' && (last === null || now - last > filters.boughtDays * DAY_MS)) return false;
      if (typeof filters.notBoughtDays === 'number' && last !== null && now - last <= filters.notBoughtDays * DAY_MS) return false;
      return true;
    });
  }

  function applySegment(keepPage = false): void {
    if (!lastFilters) return;
    segment = filterUsers(lastFilters).sort((a, b) => b.leadScore.value - a.leadScore.value || a.email.localeCompare(b.email));
    segmentCount.textContent = `${segment.length} usuario${segment.length === 1 ? '' : 's'} en el segmento`;
    segmentTable.render(segment, {
      keepPage,
      emptyHtml: 'Ningún usuario cumple esos filtros. Prueba a ampliar el segmento.',
    });
  }

  function readFilters(form: HTMLFormElement): Filters {
    const formData = new FormData(form);
    const value = (name: string): string => (formData.get(name) ?? '').toString();
    const num = (name: string): number | undefined => {
      const raw = value(name);
      return raw ? Number.parseInt(raw, 10) : undefined;
    };
    const hasCart = value('hasCart');
    return {
      q: value('q') || undefined,
      hobby: value('hobby') || undefined,
      profile: value('profile') || undefined,
      minScore: num('minScore'),
      hasCart: hasCart === '1' ? true : hasCart === '0' ? false : undefined,
      boughtDays: num('boughtDays'),
      notBoughtDays: num('notBoughtDays'),
    };
  }

  const filtersForm = must<HTMLFormElement>('[data-mu-filters]');
  filtersForm.addEventListener('submit', (event) => {
    event.preventDefault();
    lastFilters = readFilters(filtersForm);
    applySegment();
  });
  must<HTMLButtonElement>('[data-mu-reset]').addEventListener('click', () => {
    filtersForm.reset();
    lastFilters = null;
    segment = [];
    segmentCount.textContent = '';
    segmentTable.render([], { emptyHtml: SEGMENT_HINT });
  });
  must<HTMLButtonElement>('[data-mu-copy-emails]').addEventListener('click', async () => {
    if (!segment.length) {
      toast('Aplica primero un filtro: el segmento está vacío.', true);
      return;
    }
    try {
      await navigator.clipboard.writeText(segment.map((user) => user.email).join('\n'));
      toast(`${segment.length} email${segment.length === 1 ? '' : 's'} copiado${segment.length === 1 ? '' : 's'} al portapapeles.`);
    } catch {
      toast('El navegador ha bloqueado el portapapeles.', true);
    }
  });

  // ------------------------------------------------------ refresco y avisos
  async function refreshUsers(): Promise<void> {
    try {
      const response = await fetch('/api/admin/marketing/usuarios', { credentials: 'same-origin' });
      const body = await response.json();
      if (body?.success && Array.isArray(body.users)) {
        users = body.users as User360[];
        reindex();
        fillCountries();
        applyFicha(true);
        applySegment(true);
      }
    } catch {
      toast('No se pudo actualizar la lista de usuarios.', true);
    }
  }
  must<HTMLButtonElement>('[data-mu-refresh]').addEventListener('click', () => {
    void refreshUsers();
  });

  async function sendRemind(userId: string, button: HTMLButtonElement): Promise<void> {
    button.disabled = true;
    button.textContent = 'Enviando…';
    try {
      const response = await fetch(`/api/admin/marketing/usuarios/${encodeURIComponent(userId)}/remind`, {
        method: 'POST',
        credentials: 'same-origin',
      });
      const body = await response.json();
      if (body?.success) {
        toast(`Aviso de carrito enviado (${body.pendingCount} producto/s).`);
        await refreshUsers();
      } else {
        toast(body?.message ?? 'No se pudo enviar el aviso.', true);
        button.disabled = false;
        button.textContent = 'Enviar aviso de carrito';
      }
    } catch {
      toast('Error de red al enviar el aviso.', true);
      button.disabled = false;
      button.textContent = 'Enviar aviso de carrito';
    }
  }

  // Delegación: las fichas se re-renderizan al paginar, filtrar o refrescar.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remind]');
    if (!button || button.disabled) return;
    const userId = button.closest<HTMLElement>('[data-user-id]')?.dataset.userId;
    if (userId) void sendRemind(userId, button);
  });

  // ------------------------------------------------------------ integraciones
  function renderChannels(): void {
    const el = must<HTMLElement>('[data-mu-channels]');
    const lines: string[] = [];
    lines.push(
      data.channels.smtp
        ? '<span class="mu-chip mu-chip-ok">SMTP configurado</span>'
        : '<span class="mu-chip mu-chip-warn">Sin SMTP</span>',
    );
    lines.push(
      '<span class="mu-k">Avisos de carrito:</span> SMTP con fallback a N8N_CART_WEBHOOK_URL; sin ninguno, el envío se bloquea con aviso en el panel.',
    );
    el.innerHTML = lines.join(' ');
  }

  function syncIntegrationsForm(): void {
    document.querySelectorAll<HTMLInputElement>('[data-mu-platform-radio]').forEach((radio) => {
      radio.checked = (radio.value || '') === (data.config.platform ?? '');
    });
    const triggers = data.config.triggers;
    must<HTMLInputElement>('[data-mu-trigger][name="welcome"]').checked = Boolean(triggers.welcome);
    must<HTMLInputElement>('[data-mu-trigger][name="cartRecovery"]').checked = Boolean(triggers.cartRecovery);
    must<HTMLInputElement>('[data-mu-trigger][name="birthday"]').checked = Boolean(triggers.birthday);
    renderChannels();
  }

  async function saveIntegrations(): Promise<void> {
    const platform = document.querySelector<HTMLInputElement>('[data-mu-platform-radio]:checked')?.value ?? '';
    const triggers = {
      welcome: must<HTMLInputElement>('[data-mu-trigger][name="welcome"]').checked,
      cartRecovery: must<HTMLInputElement>('[data-mu-trigger][name="cartRecovery"]').checked,
      birthday: must<HTMLInputElement>('[data-mu-trigger][name="birthday"]').checked,
    };
    try {
      const response = await fetch('/api/admin/marketing/usuarios/integrations', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ platform: platform || null, triggers }),
      });
      const body = await response.json();
      if (body?.success) {
        data.config = body.config;
        const saved = must<HTMLElement>('[data-mu-int-saved]');
        saved.textContent = 'Configuración guardada.';
        saved.hidden = false;
        window.setTimeout(() => {
          saved.hidden = true;
        }, 2500);
      } else {
        toast(body?.message ?? 'No se pudo guardar la configuración.', true);
      }
    } catch {
      toast('Error de red al guardar la configuración.', true);
    }
  }
  must<HTMLButtonElement>('[data-mu-save-integrations]').addEventListener('click', () => {
    void saveIntegrations();
  });

  // ----------------------------------------------------------------- pestañas
  document.querySelectorAll<HTMLButtonElement>('[data-mu-tab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('[data-mu-tab]').forEach((other) => other.classList.toggle('is-active', other === tab));
      document.querySelectorAll<HTMLElement>('[data-mu-panel]').forEach((panel) => {
        panel.classList.toggle('is-active', panel.dataset.muPanel === tab.dataset.muTab);
      });
    });
  });

  // --------------------------------------------------------------------- init
  reindex();
  fillCountries();
  applyFicha();
  segmentTable.render([], { emptyHtml: SEGMENT_HINT });
  syncIntegrationsForm();
</script>

