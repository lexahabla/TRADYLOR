  /* Barra de filtros de la ficha */
  .mu-listbar { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .mu-search { flex: 1 1 240px; max-width: 360px; }
  .mu-count { margin-left: auto; color: var(--color-text-muted); font-size: 0.78rem; }
  .mu-toolbar { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
  .mu-toolbar .mu-count { margin-left: 0; margin-right: auto; }

  /* Tabla de usuarios (a todo el ancho, letra compacta) */
