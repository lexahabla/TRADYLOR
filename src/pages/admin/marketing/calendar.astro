---
/**
 * /admin/marketing/calendar — Calendario Comercial Global (placeholder de UI).
 */
export const prerender = false;

import MarketingAdminLayout from '../../../layouts/MarketingAdminLayout.astro';
import ModuleHeader from '../../../components/admin/marketing/ModuleHeader.astro';
import MockEndpointCard from '../../../components/admin/marketing/MockEndpointCard.astro';
---

<MarketingAdminLayout
  title="Calendario Comercial Global | Marketing"
  description="Fechas clave comerciales con alertas anticipadas y mix de canales sugerido."
  active="calendar"
>
  <ModuleHeader
    kicker="Calendario"
    title="Calendario Comercial Global"
    description="Todo el año en una línea de tiempo: hitos internacionales y estacionales locales con alerta de 3–4 semanas de antelación, mix de canales sugerido y ángulos de copy listos para cada campaña."
  />

  <MockEndpointCard
    endpoint="/api/admin/marketing/calendar"
    spec={[
      'Timeline anual: Black Friday, Cyber Monday, Singles\u2019 Day, Navidad, Prime Day, San Valentín, rebajas y vuelta al cole.',
      'Alerta automática (alertAt) calculada según las semanas de antelación de cada campaña.',
      'Por campaña: mix de canales con peso y rol (email, paid, SEO, social) más ángulos de copy con CTA.',
      'Vista por mes/semana y alta de campañas propias persistidas (siguiente iteración).',
    ]}
  />
</MarketingAdminLayout>
