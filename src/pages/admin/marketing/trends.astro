---
/**
 * /admin/marketing/trends — Escucha Activa & Tendencias (placeholder de UI).
 */
export const prerender = false;

import MarketingAdminLayout from '../../../layouts/MarketingAdminLayout.astro';
import ModuleHeader from '../../../components/admin/marketing/ModuleHeader.astro';
import MockEndpointCard from '../../../components/admin/marketing/MockEndpointCard.astro';
---

<MarketingAdminLayout
  title="Escucha Activa & Tendencias | Marketing"
  description="Tendencias de búsqueda por categoría y matriz de canales sociales por tipo de producto."
  active="trends"
>
  <ModuleHeader
    kicker="Tendencias"
    title="Escucha Activa & Tendencias"
    description="Qué se busca y dónde publicarlo: tendencias de keyword por categoría del catálogo con volumen y variación, más la matriz que recomienda canal, formato y gancho según el tipo de producto."
  />

  <MockEndpointCard
    endpoint="/api/admin/marketing/trends"
    spec={[
      'Tabla de tendencias por categoría: keyword, fuente (Google Trends / social listening), índice de volumen y cambio %.',
      'Matriz de canales: tipo de producto → canal ideal con fit alto/medio/bajo, mejor formato y razón.',
      'Alertas de subidas y caídas relevantes por categoría para reaccionar con contenido (siguiente iteración).',
      'Conectores futuros: API de Google Trends y social listening de TikTok / Instagram.',
    ]}
  />
</MarketingAdminLayout>
