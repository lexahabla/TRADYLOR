---
/**
 * /admin/marketing/actions — Playbooks & Calculadora ROI/ROAS (placeholder de UI).
 */
export const prerender = false;

import MarketingAdminLayout from '../../../layouts/MarketingAdminLayout.astro';
import ModuleHeader from '../../../components/admin/marketing/ModuleHeader.astro';
import MockEndpointCard from '../../../components/admin/marketing/MockEndpointCard.astro';
---

<MarketingAdminLayout
  title="Playbooks & ROI/ROAS | Marketing"
  description="Biblioteca de manuales de conversión y calculadora de rentabilidad de campañas."
  active="actions"
>
  <ModuleHeader
    kicker="Acciones"
    title="Playbooks & Calculadora ROI/ROAS"
    description="Operativa de conversión estructurada: manuales con pasos, KPIs y lift estimado para up-selling, cross-selling, fidelización y bundles — más la calculadora para validar la rentabilidad antes de ejecutar presupuesto."
  />

  <MockEndpointCard
    endpoint="/api/admin/marketing/actions"
    spec={[
      'Biblioteca de playbooks: up-selling en ficha, cross-selling post-compra, fidelización vía Mi Radar y bundles de temporada.',
      'Ficha de playbook con pasos numerados, KPIs a medir y lift estimado (%).',
      'Calculadora ROI/ROAS interactiva: inversión, margen, CPC y conversión → ROAS, ROI y punto de equilibrio.',
      'Exportación de cada playbook a checklist ejecutable por canal (siguiente iteración).',
    ]}
  />
</MarketingAdminLayout>
