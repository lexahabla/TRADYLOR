  }

  .comparator-picked-img {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 12px;
    background: #1a1a2e;
    flex-shrink: 0;
  }

  .comparator-picked-body {
    min-width: 0;
  }

  .comparator-picked-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fbbf24;
    margin-bottom: 0.35rem;
  }

  .comparator-picked-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.45rem;
  }

  .comparator-picked-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 0.5rem;
  }

  .comparator-picked-meta strong {
    color: #fbbf24;
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }

  .comparator-picked-old {
    text-decoration: line-through;
    color: rgba(255, 255, 255, 0.35);
  }

  .comparator-picked-link {
    font-size: 0.82rem;
    font-weight: 700;
    color: #60a5fa;
    text-decoration: none;
  }

  .comparator-picked-link:hover {
    text-decoration: underline;
  }

  /* Veredicto de la alternativa recomendada */
  .comparator-verdict {
    padding: 1.5rem;
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.28);
    border-radius: 18px;
  }

  .comparator-verdict[data-role='premium'] {
    background: rgba(59, 130, 246, 0.05);
    border-color: rgba(59, 130, 246, 0.28);
  }

  .comparator-verdict-tag {
