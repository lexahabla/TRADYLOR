---
/**
 * TRADYLOR — CENTRO DE HERRAMIENTAS (Landing)
 * Página de entrada que reúne las 3 herramientas de "El Método" (Paso 3):
 * Perfilador de Compra, Comparador de Productos y Dependiente IA.
 * Cada herramienta vive en su propia página (enlazadas desde aquí y desde el
 * dropdown "Herramientas" del mainNav).
 */
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const pageTitle = 'Centro de Herramientas | Tradylor';
const pageDescription = 'Perfilador de Compra, Comparador de Productos y Dependiente IA: las 3 herramientas del Método Tradylor para decidir qué comprar con confianza.';
---

<Layout title={pageTitle} description={pageDescription} noindex={false}>
  <main class="tools-page">
    <!-- HERO -->
    <section class="tools-hero">
      <div class="container tools-hero-inner">
        <span class="tools-kicker">Paso 3 de El Método</span>
        <h1 class="tools-title">Centro de Herramientas</h1>
        <p class="tools-subtitle">
          Tecnología de asistencia para decidir sin dudas: define tu perfil de comprador,
          compara productos frente a sus alternativas y pregunta al Dependiente IA.
        </p>

        <nav class="tools-switcher" aria-label="Ir a una herramienta">
          <a href="/herramientas/perfilador" class="tools-switch-btn tools-switch-btn--blue">
            <span class="tools-switch-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21v-1a8 8 0 0 1 16 0v1" /></svg>
            </span>
            <span>Perfilador de Compra</span>
            <span class="tools-switch-arrow">›</span>
          </a>
          <a href="/herramientas/comparador" class="tools-switch-btn tools-switch-btn--amber">
            <span class="tools-switch-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="18" rx="1"/></svg>
            </span>
            <span>Comparador de Productos</span>
            <span class="tools-switch-arrow">›</span>
          </a>
          <a href="/herramientas/dependiente-ia" class="tools-switch-btn tools-switch-btn--green">
            <span class="tools-switch-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
            </span>
            <span>Dependiente IA</span>
            <span class="tools-switch-arrow">›</span>
          </a>
        </nav>

        <p class="tools-auth-note">
          Puedes probar las 3 herramientas sin cuenta. Para guardar tu perfil o tu comparativa en
          tu panel, sólo hace falta <button type="button" class="tools-auth-link" data-open-auth="register">crear una cuenta gratis</button>.
        </p>
      </div>
    </section>

    <!-- Tarjetas de las 3 herramientas -->
    <section class="tools-cards" aria-label="Herramientas disponibles">
      <div class="container">
        <article class="tools-card tools-card--blue">
          <div class="tools-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21v-1a8 8 0 0 1 16 0v1" /></svg>
          </div>
          <h3 class="tools-card-title">Perfilador de Compra</h3>
          <p class="tools-card-desc">
            Responde 3 preguntas sobre uso, presupuesto y prioridad. Obtén tu Perfil de
            Comprador con nombre y color, y marca visualmente qué productos encajan contigo
            en todo el catálogo.
          </p>
          <a href="/herramientas/perfilador" class="tools-card-link">Ir al Perfilador →</a>
        </article>

        <article class="tools-card tools-card--amber">
          <div class="tools-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="18" rx="1"/></svg>
          </div>
          <h3 class="tools-card-title">Comparador de Productos</h3>
          <p class="tools-card-desc">
            Elige un producto del catálogo y ve su análisis cruzado frente a alternativas
            reales (más barato, premium, similar) y rivales de categoría, con la alternativa
            recomendada.
          </p>
          <a href="/herramientas/comparador" class="tools-card-link">Ir al Comparador →</a>
        </article>

        <article class="tools-card tools-card--green">
          <div class="tools-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
          </div>
          <h3 class="tools-card-title">Dependiente IA</h3>
          <p class="tools-card-desc">
            Cuéntale qué buscas (uso, presupuesto, prioridades) y te recomendará productos
            reales de nuestro catálogo, nunca artículos inventados.
          </p>
          <a href="/herramientas/dependiente-ia" class="tools-card-link">Ir al Dependiente IA →</a>
        </article>
      </div>
    </section>

    <style>
      .tools-page { padding-bottom: 2rem; }
      .tools-hero {
        padding: 3.5rem 0 2.5rem;
        background: radial-gradient(ellipse at top, rgba(59, 130, 246, 0.12) 0%, transparent 65%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }
      .tools-hero-inner { text-align: center; max-width: 760px; }
      .tools-kicker {
        display: inline-block; font-size: 0.74rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em;
        color: #60a5fa; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.28);
        padding: 0.35rem 0.9rem; border-radius: 999px; margin-bottom: 1rem;
      }
      .tools-title {
        font-family: var(--font-heading); font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; color: #ffffff;
        margin: 0 0 0.85rem; letter-spacing: -0.02em;
      }
      .tools-subtitle {
        font-size: 1rem; color: rgba(255, 255, 255, 0.65); line-height: 1.7; margin: 0 auto 2rem; max-width: 620px;
      }
      .tools-switcher {
        display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-bottom: 1.5rem;
      }
      .tools-switch-btn {
        display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.75rem 1.25rem;
        background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px; color: #e5e7eb; font-weight: 700; font-size: 0.88rem; text-decoration: none;
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }
      .tools-switch-btn:hover { transform: translateY(-2px); border-color: rgba(96, 165, 250, 0.5); background: rgba(59, 130, 246, 0.1); }
      .tools-switch-icon {
        display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px;
        border-radius: 9px;
      }
      .tools-switch-btn--blue .tools-switch-icon { background: rgba(59, 130, 246, 0.18); color: #60a5fa; }
      .tools-switch-btn--amber .tools-switch-icon { background: rgba(245, 158, 11, 0.18); color: #fbbf24; }
      .tools-switch-btn--green .tools-switch-icon { background: rgba(16, 185, 129, 0.18); color: #34d399; }
      .tools-switch-arrow { font-size: 0.7rem; opacity: 0.6; }
      .tools-auth-note {
        font-size: 0.82rem; color: var(--color-text-dim); margin: 0;
      }
      .tools-auth-link {
        padding: 0; background: none; border: 0; color: #60a5fa; font: inherit; font-size: inherit;
        font-weight: 700; cursor: pointer; text-decoration: underline;
      }

      .tools-cards { padding: 2rem 0 3rem; }
      .tools-cards .container { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
      .tools-card {
        display: flex; flex-direction: column; gap: 0.85rem; padding: 1.75rem; background: var(--color-bg-card);
        border: 1px solid var(--color-border); border-radius: var(--border-radius-lg); text-decoration: none;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .tools-card:hover { transform: translateY(-4px); border-color: rgba(59, 130, 246, 0.3); box-shadow: var(--shadow-card); }
      .tools-card-icon {
        width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
      }
      .tools-card--blue .tools-card-icon { background: rgba(59, 130, 246, 0.18); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
      .tools-card--amber .tools-card-icon { background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
      .tools-card--green .tools-card-icon { background: rgba(16, 185, 129, 0.18); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
      .tools-card-title {
        font-family: var(--font-heading); font-size: 1.15rem; font-weight: 800; color: #ffffff; margin: 0;
      }
      .tools-card-desc {
        font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6; margin: 0; flex: 1;
      }
      .tools-card-link {
        display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; font-weight: 700;
        color: #60a5fa; text-decoration: none; margin-top: auto;
      }
      .tools-card-link:hover { color: #93c5fd; text-decoration: underline; }
    </style>
  </main>
</Layout>
