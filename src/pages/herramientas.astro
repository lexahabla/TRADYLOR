---
/**
 * ==============================================================================
 * TRADYLOR — CENTRO DE HERRAMIENTAS
 * ==============================================================================
 * Página dedicada que reúne las 3 herramientas de "El Método" (Paso 3):
 * Perfilador de Compra, Comparador de Productos y Dependiente IA. Enlazada
 * desde el mainNav ("Herramientas") y desde la sección #el-metodo de la home.
 * ==============================================================================
 */
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import SmartMatcherWizard from '../components/SmartMatcherWizard.astro';
import ProductComparator from '../components/comparativa/ProductComparator.astro';
import DependienteIA from '../components/DependienteIA.astro';
import { getCatalogProducts } from '../lib/catalog';
import { getCategories, getCategoryById } from '../lib/categories';

const allProducts = getCatalogProducts();
const approvedProducts = allProducts.filter((p) => p.audit_status !== 'rejected');

// Selector de categoría del Comparador: sólo raíces con al menos 2 productos (si no, no hay nada que comparar).
const rootCategories = getCategories().filter((cat) => !cat.parentId);
const categoryCounts = new Map<string, number>();
for (const product of approvedProducts) {
  const cat = getCategoryById(String(product.category_id ?? product.category ?? ''));
  const rootId = cat?.parentId ?? cat?.id;
  if (!rootId) continue;
  categoryCounts.set(rootId, (categoryCounts.get(rootId) ?? 0) + 1);
}
const comparableCategories = rootCategories.filter((cat) => (categoryCounts.get(cat.id) ?? 0) >= 2);

const compareSlug = (Astro.url.searchParams.get('categoria') ?? '').trim();
const compareCategory = compareSlug ? comparableCategories.find((c) => c.slug === compareSlug) : comparableCategories[0];

const compareProducts = compareCategory
  ? approvedProducts
      .filter((p) => {
        const cat = getCategoryById(String(p.category_id ?? p.category ?? ''));
        const rootId = cat?.parentId ?? cat?.id;
        return rootId === compareCategory.id;
      })
      .slice(0, 12)
  : [];

const pageTitle = 'Centro de Herramientas | Tradylor';
const pageDescription = 'Perfilador de Compra, Comparador de Productos y Dependiente IA: las 3 herramientas del Método Tradylor en un mismo sitio.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="tools-page">
    <!-- ============================================================
         HERO
         ============================================================ -->
    <section class="tools-hero">
      <div class="container tools-hero-inner">
        <span class="tools-kicker">Paso 3 de El Método</span>
        <h1 class="tools-title">Centro de Herramientas</h1>
        <p class="tools-subtitle">
          Tecnología de asistencia para decidir sin dudas: define tu perfil, compara cada producto
          frente a sus alternativas y pregunta en lenguaje natural a nuestro Dependiente IA.
        </p>

        <nav class="tools-switcher" aria-label="Ir a una herramienta">
          <a href="#perfilador" class="tools-switch-btn">
            <span class="tools-switch-icon tools-switch-icon--blue" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21v-1a8 8 0 0 1 16 0v1" /></svg>
            </span>
            Perfilador de Compra
          </a>
          <a href="#comparador" class="tools-switch-btn">
            <span class="tools-switch-icon tools-switch-icon--amber" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="18" rx="1"/></svg>
            </span>
            Comparador de Productos
          </a>
          <a href="#dependiente-ia" class="tools-switch-btn">
            <span class="tools-switch-icon tools-switch-icon--green" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
            </span>
            Dependiente IA
          </a>
        </nav>

        <p class="tools-auth-note">
          Puedes probar las 3 herramientas sin cuenta. Para ver el resultado final y guardarlo en tu
          panel, sólo hace falta <button type="button" class="tools-auth-link" data-open-auth="register">crear una cuenta gratis</button>.
        </p>
      </div>
    </section>

    <!-- ============================================================
         1. PERFILADOR DE COMPRA
         ============================================================ -->
    <div class="container" id="perfilador">
      <SmartMatcherWizard products={allProducts} />
    </div>

    <!-- ============================================================
         2. COMPARADOR DE PRODUCTOS
         ============================================================ -->
    <section class="tools-comparator-wrap" id="comparador">
      <div class="container">
        {comparableCategories.length > 0 ? (
          <>
            <form class="comparator-category-form" method="get">
              <label for="compareCategorySelect" class="comparator-category-label">Comparar categoría:</label>
              <select id="compareCategorySelect" name="categoria" class="comparator-category-select">
                {comparableCategories.map((cat) => (
                  <option value={cat.slug} selected={compareCategory?.slug === cat.slug}>
                    {cat.icon} {cat.name} ({categoryCounts.get(cat.id) ?? 0})
                  </option>
                ))}
              </select>
            </form>
            {compareProducts.length > 1 ? (
              <ProductComparator products={compareProducts} categoryName={compareCategory?.name} />
            ) : (
              <p class="tools-empty-note">Elige una categoría con al menos 2 productos para comparar.</p>
            )}
          </>
        ) : (
          <p class="tools-empty-note">Aún no hay suficientes productos publicados para activar el comparador. Vuelve pronto.</p>
        )}
      </div>
    </section>

    <!-- ============================================================
         3. DEPENDIENTE IA
         ============================================================ -->
    <div class="container">
      <DependienteIA />
    </div>
  </main>
</Layout>

<script is:inline>
  (() => {
    const select = document.getElementById('compareCategorySelect');
    select?.addEventListener('change', () => {
      const url = new URL(window.location.href);
      url.searchParams.set('categoria', select.value);
      url.hash = 'comparador';
      window.location.href = url.toString();
    });
  })();
</script>

<style>
  .tools-page {
    padding-bottom: 2rem;
  }

  .tools-hero {
    padding: 3.5rem 0 2.5rem;
    background: radial-gradient(ellipse at top, rgba(59, 130, 246, 0.12) 0%, transparent 65%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .tools-hero-inner {
    text-align: center;
    max-width: 760px;
  }

  .tools-kicker {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #60a5fa;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.28);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .tools-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.85rem;
    letter-spacing: -0.02em;
  }

  .tools-subtitle {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
    margin: 0 auto 2rem;
    max-width: 620px;
  }

  .tools-switcher {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .tools-switch-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1.25rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    color: #e5e7eb;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .tools-switch-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(96, 165, 250, 0.5);
    background: rgba(59, 130, 246, 0.1);
  }

  .tools-switch-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 9px;
  }

  .tools-switch-icon--blue { background: rgba(59, 130, 246, 0.18); color: #60a5fa; }
  .tools-switch-icon--amber { background: rgba(245, 158, 11, 0.18); color: #fbbf24; }
  .tools-switch-icon--green { background: rgba(16, 185, 129, 0.18); color: #34d399; }

  .tools-auth-note {
    font-size: 0.82rem;
    color: var(--color-text-dim);
    margin: 0;
  }

  .tools-auth-link {
    padding: 0;
    background: none;
    border: 0;
    color: #60a5fa;
    font: inherit;
    font-size: inherit;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
  }

  .tools-comparator-wrap {
    padding: 1rem 0 3rem;
  }

  .comparator-category-form {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }

  .comparator-category-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .comparator-category-select {
    padding: 0.5rem 0.9rem;
    background: #0b1220;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 10px;
    color: #e5e7eb;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .tools-empty-note {
    padding: 2rem;
    text-align: center;
    color: var(--color-text-dim);
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 16px;
  }
</style>
