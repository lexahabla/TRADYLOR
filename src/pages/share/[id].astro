---
/**
 * ==============================================================================
 * TRADYLOR — "A MI CORREO": TARJETA DEL PRODUCTO PARA ENVIARTE POR EMAIL
 * ==============================================================================
 *
 * Ruta dinámica SSR: /share/[id]?lang=xx
 *
 * Se llega desde la opción "A mi correo" del panel de compartir. Muestra la tarjeta del
 * producto (mensaje, título, imagen y botón "Ver la ficha del producto" que lleva a
 * https://tradylor.com/producto/<slug>), el selector de idioma y dos botones de envío:
 * "Enviar a {tu correo}" y "Enviar a otra dirección" (una dirección que el usuario escribe).
 *
 * El mensaje es editable (botón "Editar texto") y traducible con el traductor de Google
 * (desplegable de idiomas): lo que se ve en la vista previa es exactamente lo que llega
 * al correo, ya sea el texto original, el editado o el traducido.
 *
 * Sin sesión no se sabe a qué correo enviarla: se pide iniciar sesión (y la página se
 * recarga sola al terminar). El destinatario de "Enviar a {tu correo}" lo decide el
 * servidor a partir de la sesión; el de "Enviar a otra dirección" va en el body con
 * tope de envíos propios.
 *
 * El idioma se pasa como query param (?lang=ca) porque la página es SSR y no puede leer
 * localStorage en el servidor. El selector se completa en el cliente con los idiomas
 * cooficiales de la región (navegador + IP, /api/share/region).
 * ==============================================================================
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { findCatalogProduct, productKey } from '../../lib/catalog';
import { getRadarSessionUser } from '../../lib/radarAuth';
import {
  buildProductPageUrl,
  buildShareText,
  SHARE_LANG_CODES,
  type ShareLangCode,
} from '../../utils/share';
import { buildShareEmailHtml, cleanShareTitle } from '../../utils/shareEmail';
import { GOOGLE_TRANSLATE_LANGS } from '../../utils/translate';

const product = findCatalogProduct(Astro.params.id);
if (!product) return Astro.redirect('/', 302);

// La página depende de la sesión (muestra el correo del usuario): nunca se cachea.
Astro.response.headers.set('Cache-Control', 'no-store');
const user = getRadarSessionUser(Astro.request);

const key = productKey(product);

// Idioma desde query param (lo pasa el panel de compartir al abrir la página).
// Se valida contra SHARE_LANG_CODES (lista fija).
const langParam = (Astro.url.searchParams.get('lang') ?? '').trim().toLowerCase() as ShareLangCode;
const lang: ShareLangCode = SHARE_LANG_CODES.includes(langParam) ? langParam : 'es';

// Enlace a la ficha individual del producto en tradylor.com.
const productUrl = buildProductPageUrl(key);
const rawMessage = buildShareText(
  'email',
  { productId: key, title: product.title, category: product.category },
  productUrl,
  lang,
);
// El enlace va en el botón "Ver la ficha del producto", no repetido dentro del mensaje.
const message = rawMessage.replace(productUrl, '').replace(/\s+/g, ' ').trim();
const absoluteImage = /^https?:\/\//i.test(product.image)
  ? product.image
  : new URL(product.image, Astro.site ?? 'https://tradylor.com').href;

const cleanTitle = cleanShareTitle(product.title);

// Tarjeta del correo: se pinta tal cual en la vista previa y es la que recibe el usuario.
const emailHtml = buildShareEmailHtml({
  message,
  title: cleanTitle,
  category: product.category,
  imageUrl: absoluteImage,
  ctaUrl: productUrl,
  lang,
});

interface ShareUiStrings {
  hint: string;
  sendTo: string;
  sending: string;
  /** {email} se sustituye por el correo de la cuenta. */
  sent: string;
  loginTitle: string;
  loginText: string;
  login: string;
  errAuth: string;
  errRate: string;
  errSmtp: string;
  errGeneric: string;
  /** Toolbar: edición y traducción del mensaje de la tarjeta. */
