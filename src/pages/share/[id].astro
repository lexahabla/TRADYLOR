const ui = UI[lang] ?? UI.es;

// Datos para el script del cliente (JSON inerte: no se ejecuta, sólo se lee).
const clientData = {
  lang,
  productId: key,
  email: user?.email ?? '',
  ui: {
    sendTo: ui.sendTo,
    sending: ui.sending,
    sent: ui.sent,
    errAuth: ui.errAuth,
    errRate: ui.errRate,
    errSmtp: ui.errSmtp,
    errGeneric: ui.errGeneric,
    editText: ui.editText,
    editTextDone: ui.editTextDone,
    translateLabel: ui.translateLabel,
    translating: ui.translating,
    translateFailed: ui.translateFailed,
    otherPlaceholder: ui.otherPlaceholder,
    sendOther: ui.sendOther,
    invalidEmail: ui.invalidEmail,
  },
};
const clientJson = JSON.stringify(clientData).replace(/</g, '\\u003c');
---

<Layout
  title={`A mi correo: ${cleanTitle} | Tradylor`}
  description="Recibe en tu correo la tarjeta de este producto para reenviarla a quien quieras."
  noindex={true}
>
  <div class="share-preview-page">
    <div class="share-preview-container">
      <header class="share-header">
        <div class="share-logo">
          <span class="logo-mark">T</span>
          <span class="logo-text">Tradylor</span>
        </div>
        <p class="share-hint">{ui.hint}</p>
      </header>

      <!-- Toolbar: el mensaje es editable y se puede traducir con el traductor de Google -->
      <div class="preview-toolbar">
        <button type="button" class="tool-btn" id="editTextBtn" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
          </svg>
          <span id="editTextLabel">{ui.editText}</span>
        </button>
        <label class="tool-select" for="translateSelect">
          <span class="tool-select-globe" aria-hidden="true">🌐</span>
          <select id="translateSelect" aria-label={ui.translateLabel}>
            <option value="">{ui.translateOriginal}</option>
            {GOOGLE_TRANSLATE_LANGS.map((item) => (
              <option value={item.code}>{item.label}</option>
            ))}
          </select>
        </label>
      </div>

      <!-- Tarjeta del correo: es exactamente la que llegará a tu bandeja -->
      <div class="email-preview" id="emailCard" set:html={emailHtml} />

      {user ? (
        <div class="share-actions">
          <!-- Botón 1: envía la tarjeta al correo de la cuenta -->
          <button type="button" class="share-btn share-btn-mail" id="sendToMeBtn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5.5" width="18" height="13" rx="2.5"/>
              <path d="m4.5 8 7.5 5 7.5-5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="share-btn-label">{ui.sendTo} <strong class="share-email">{user.email}</strong></span>
          </button>
          <!-- Botón 2: envía la tarjeta a otra dirección de correo que el usuario escribe -->
          <div class="share-other">
            <input
              id="otherEmail"
              type="email"
              maxlength="120"
              autocomplete="email"
              placeholder={ui.otherPlaceholder}
              aria-label={ui.otherPlaceholder}
            />
            <button type="button" class="share-btn share-btn-alt" id="sendOtherBtn">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="5.5" width="18" height="13" rx="2.5"/>
                <path d="m4.5 8 7.5 5 7.5-5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="share-btn-label" id="sendOtherLabel">{ui.sendOther}</span>
            </button>
          </div>
        </div>
      ) : (
        <section class="share-login" data-share-login>
          <p class="share-login-title">{ui.loginTitle}</p>
          <p class="share-login-text">{ui.loginText}</p>
          <button type="button" class="share-btn share-btn-mail" data-open-auth="login">{ui.login}</button>
        </section>
      )}

      <div class="share-toast" id="shareToast" role="status" aria-live="polite"></div>
    </div>
  </div>

  <style>
    .share-preview-page {
      min-height: 100vh;
      background: linear-gradient(135deg, #0a0e17 0%, #111827 50%, #0a0e17 100%);
      padding: 2rem 1rem;
    }
    /* 600 px = ancho de la tarjeta del correo: vista previa y botón alineados */
    .share-preview-container { max-width: 600px; margin: 0 auto; }
    .share-header { text-align: center; margin-bottom: 2rem; }
    .share-logo { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: .75rem; }
    .logo-mark {
      display: inline-flex; align-items: center; justify-content: center;
      width: 36px; height: 36px; border-radius: 10px;
      background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
      color: #0d1422; font-weight: 800; font-size: 1.1rem; font-family: 'Outfit', sans-serif;
    }
    .logo-text { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.25rem; color: #f3f4f6; }
    .share-hint { font-size: .82rem; color: #9ca3af; max-width: 440px; margin: 0 auto; line-height: 1.5; }

    /* Vista previa: el diseño de la tarjeta va inline en el propio HTML del correo */
    .email-preview {
      margin-bottom: 1.5rem; border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.06);
    }
    /* Botón "Ver la ficha del producto": manita + efecto al pasar el ratón (sólo en la
       vista previa; en el correo el cursor y el clic los gestiona el cliente de correo). */
    .email-preview :global(.tz-cta) { cursor: pointer; transition: filter .15s ease, transform .15s ease, box-shadow .15s ease; }
    .email-preview :global(.tz-cta:hover) { filter: brightness(1.08); transform: translateY(-1px); box-shadow: 0 6px 18px rgba(59,130,246,.45); }
    .email-preview :global(.tz-cta:active) { transform: translateY(0); box-shadow: none; }
    .email-preview :global(.tz-cta:focus-visible) { outline: 2px solid #1d4ed8; outline-offset: 2px; }

    /* Toolbar de la vista previa: editar el mensaje + traductor de Google */
    .preview-toolbar {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
      gap: .55rem; margin-bottom: 1.1rem;
    }
    .tool-btn {
      display: inline-flex; align-items: center; gap: .45rem;
      padding: .5rem .95rem; border-radius: 999px; cursor: pointer;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12);
      color: #e5e7eb; font-family: 'Inter', sans-serif; font-size: .78rem; font-weight: 700; transition: .16s;
    }
    .tool-btn:hover { background: rgba(255,255,255,.1); border-color: rgba(96,165,250,.45); }
    .tool-btn.is-on {
      color: #0d1422; background: linear-gradient(135deg,#60a5fa 0%,#3b82f6 100%);
      border-color: rgba(96,165,250,.6); box-shadow: 0 3px 10px rgba(59,130,246,.35);
    }
    .tool-btn:focus-visible { outline: 2px solid #60a5fa; outline-offset: 2px; }
    .tool-select { position: relative; display: inline-flex; align-items: center; }
    .tool-select-globe { position: absolute; left: .7rem; font-size: .85rem; pointer-events: none; }
    .tool-select select {
      appearance: none; -webkit-appearance: none; cursor: pointer;
      padding: .5rem 2rem .5rem 2rem; border-radius: 999px;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12);
      color: #e5e7eb; font-family: 'Inter', sans-serif; font-size: .78rem; font-weight: 700; transition: .16s;
    }
    .tool-select select:hover { background: rgba(255,255,255,.1); border-color: rgba(96,165,250,.45); }
    .tool-select select:focus-visible { outline: 2px solid #60a5fa; outline-offset: 2px; }
    .tool-select select:disabled { opacity: .6; cursor: progress; }
    .tool-select::after {
      content: '▾'; position: absolute; right: .75rem; top: 50%; transform: translateY(-50%);
      color: #9ca3af; font-size: .7rem; pointer-events: none;
    }
    .tool-select select option { background: #0d1422; color: #f3f4f6; }

    /* Mensaje editable: sólo en la vista previa (el correo conserva su diseño) */
    .email-preview :global(.tz-msg.is-editing) {
      cursor: text; border-radius: 6px;
      background: rgba(59,130,246,.07);
      outline: 2px dashed #60a5fa; outline-offset: 6px;
    }
    .email-preview :global(.tz-msg.is-editing:focus) { outline-style: solid; }

    .share-actions { display: flex; flex-direction: column; gap: .7rem; }
    .share-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .6rem; width: 100%;
      padding: .9rem 1.25rem; border-radius: 10px; font-weight: 700; font-size: .95rem; line-height: 1.35;
      font-family: 'Inter', sans-serif; cursor: pointer; border: none; text-decoration: none; transition: .18s;
    }
    .share-btn svg { flex-shrink: 0; }
    .share-btn:disabled { opacity: .7; cursor: progress; }
    .share-btn-mail {
      background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
      color: #ffffff; box-shadow: 0 4px 16px rgba(124,58,237,.35);
    }
    .share-btn-mail:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(124,58,237,.55); }
    .share-btn-mail:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 3px; }
    /* El correo puede ser largo: se parte en vez de desbordar el botón */
    .share-btn-label { min-width: 0; text-align: left; }
    .share-email { font-weight: 800; overflow-wrap: anywhere; }

    /* Envío a otra dirección: campo escribible + botón en la misma línea */
    .share-other { display: flex; flex-direction: row; align-items: stretch; gap: .55rem; }
    .share-other input {
      flex: 1 1 auto; min-width: 0; box-sizing: border-box; padding: .8rem 1rem; border-radius: 10px;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.14);
      color: #f3f4f6; font-family: 'Inter', sans-serif; font-size: .9rem; outline: none; transition: .16s;
    }
    .share-other input::placeholder { color: #6b7280; }
    .share-other input:focus { border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(59,130,246,.25); }
    .share-btn-alt {
      flex: 0 0 auto; width: auto; white-space: nowrap;
      background: rgba(255,255,255,.06); color: #e5e7eb; border: 1px solid rgba(255,255,255,.16);
    }
    .share-btn-alt:hover:not(:disabled) { background: rgba(255,255,255,.12); transform: translateY(-2px); }
    .share-btn-alt:focus-visible { outline: 2px solid #93c5fd; outline-offset: 3px; }

    /* Sin sesión: no se sabe a qué correo enviarla */
    .share-login {
      padding: 1.25rem 1.4rem 1.4rem; text-align: center;
      background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: 14px;
    }
    .share-login-title { margin: 0 0 .35rem; font-size: 1rem; font-weight: 800; color: #f3f4f6; }
    .share-login-text { margin: 0 0 1rem; font-size: .82rem; line-height: 1.55; color: #9ca3af; }
    .share-login .share-btn { width: auto; min-width: 200px; }

    .share-toast {
      position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%) translateY(20px);
      width: max-content; max-width: min(92vw, 520px); text-align: center; line-height: 1.45;
      background: rgba(13,20,34,.97); color: #f3f4f6; border: 1px solid rgba(255,255,255,.14);
      padding: .7rem 1.2rem; border-radius: 16px; font-size: .82rem; font-weight: 600;
      opacity: 0; pointer-events: none; transition: .25s; z-index: 999;
    }
    .share-toast.is-on { opacity: 1; transform: translateX(-50%) translateY(0); }
    .share-toast.is-error { border-color: rgba(248,113,113,.6); color: #fca5a5; }

    @media (max-width: 520px) {
      .share-login .share-btn { width: 100%; }

      /* En móvil el bloque de producto de la vista previa se apila: imagen arriba y
         texto centrado debajo (ganchos tz-* de utils/shareEmail.ts). */
      .email-preview :global(.tz-prod),
      .email-preview :global(.tz-prod tbody),
      .email-preview :global(.tz-prod tr),
      .email-preview :global(.tz-prod td) { display: block !important; width: auto !important; }
      .email-preview :global(.tz-gap) { display: none !important; }
      .email-preview :global(.tz-img) { padding-bottom: 16px; }
      .email-preview :global(.tz-img > div) { margin: 0 auto; }
      .email-preview :global(.tz-txt) { text-align: center; }
    }
  </style>

  <script type="application/json" id="share-data" set:html={clientJson}></script>

  <script>
    import { setShareLang } from '../../utils/share';
    import type { ShareLangCode } from '../../utils/share';
    import { googleTranslateText } from '../../utils/translate';

    interface ShareData {
      lang: ShareLangCode;
      productId: string;
      /** Correo de la cuenta (vacío si no hay sesión). */
      email: string;
      ui: {
        sendTo: string;
        sending: string;
        sent: string;
        errAuth: string;
        errRate: string;
        errSmtp: string;
        errGeneric: string;
        editText: string;
        editTextDone: string;
        translateLabel: string;
        translating: string;
        translateFailed: string;
        otherPlaceholder: string;
        sendOther: string;
        invalidEmail: string;
      };
    }

    const data = JSON.parse(document.getElementById('share-data')?.textContent || '{}') as ShareData;

    // La página recuerda el idioma que se está viendo (el panel de compartir lo reutiliza).
    setShareLang(data.lang);

    // ---- Toast ----
    let toastTimer: number | undefined;
    function showToast(message: string, isError = false, ms = 6000): void {
      const toast = document.getElementById('shareToast');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.toggle('is-error', isError);
      toast.classList.add('is-on');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), ms);
    }

    // ---- Editar el texto del mensaje de la tarjeta ---------------------------------
    const msgEl = document.querySelector<HTMLElement>('.email-preview .tz-msg');
    const MESSAGE_MAX = 1500;
    /** Texto original de la plantilla (el que se restaura al volver al idioma original). */
    const originalMessage = (msgEl?.textContent ?? '').replace(/\s+/g, ' ').trim();
    /** Último texto escrito por el usuario (siempre sin traducir: las traducciones parten de él). */
    let baseMessage = originalMessage;
    /** Texto que se ve ahora mismo en la tarjeta (y por tanto el que se envía). */
    let currentMessage = originalMessage;
    let editing = false;

    const editBtn = document.getElementById('editTextBtn') as HTMLButtonElement | null;
    const editLabel = document.getElementById('editTextLabel');

    function setEditing(on: boolean): void {
      if (!msgEl || !editBtn) return;
      editing = on;
      msgEl.contentEditable = on ? 'true' : 'false';
      msgEl.classList.toggle('is-editing', on);
      editBtn.classList.toggle('is-on', on);
      editBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      if (editLabel) editLabel.textContent = on ? data.ui.editTextDone : data.ui.editText;
      if (on) {
        msgEl.focus();
        const range = document.createRange();
        range.selectNodeContents(msgEl);
        range.collapse(false);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      } else {
        const text = (msgEl.textContent || '').replace(/\s+/g, ' ').trim().slice(0, MESSAGE_MAX);
        msgEl.textContent = text;
        baseMessage = text;
        currentMessage = text;
      }
    }

    editBtn?.addEventListener('mousedown', (event) => event.preventDefault()); // no robar el foco al texto
    editBtn?.addEventListener('click', () => setEditing(!editing));
    // Al salir del texto (clic fuera o tabulador) se guarda y se cierra la edición.
    msgEl?.addEventListener('blur', () => {
      if (editing) setEditing(false);
    });

    // ---- Traducir el mensaje con el traductor de Google ----------------------------
    // Se traduce DESDE EL NAVEGADOR contra translate.googleapis.com (el endpoint
    // admite CORS con la IP del usuario). Si el navegador no puede llegar, se usa
    // como respaldo el proxy del servidor (/api/share/translate).
    const translateSelect = document.getElementById('translateSelect') as HTMLSelectElement | null;

    async function translateViaServer(text: string, target: string): Promise<string> {
      const res = await fetch('/api/share/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, target }),
      });
      const out = (await res.json().catch(() => ({}))) as { ok?: boolean; text?: string };
      if (!res.ok || !out.ok || !out.text) throw new Error(out.error || 'translate_failed');
      return out.text;
    }

    translateSelect?.addEventListener('change', async () => {
      if (editing) setEditing(false);
      const target = translateSelect.value;
      if (!target) {
        if (msgEl) msgEl.textContent = baseMessage;
        currentMessage = baseMessage;
        return;
      }
      if (!baseMessage) return;
      translateSelect.disabled = true;
      showToast(data.ui.translating, false, 4000);
      try {
        let translated = '';
        try {
          translated = await googleTranslateText(baseMessage, target);
        } catch {
          translated = await translateViaServer(baseMessage, target);
        }
        if (!translated) throw new Error('translate_empty');
        if (msgEl) msgEl.textContent = translated;
        currentMessage = translated;
      } catch {
        translateSelect.value = '';
        showToast(data.ui.translateFailed, true);
      } finally {
        translateSelect.disabled = false;
      }
    });

    // ---- Enviar la tarjeta (a la cuenta o a otra dirección) ------------------------
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const sendBtn = document.getElementById('sendToMeBtn') as HTMLButtonElement | null;
    const sendOtherBtn = document.getElementById('sendOtherBtn') as HTMLButtonElement | null;
    const otherEmailInput = document.getElementById('otherEmail') as HTMLInputElement | null;

    async function sendCard(to: string | null, btn: HTMLButtonElement): Promise<void> {
      if (btn.disabled) return;
      const label = btn.querySelector<HTMLElement>('.share-btn-label');
      const original = label?.innerHTML ?? '';
      // Los dos botones se bloquean a la vez: sólo un envío en vuelo.
      if (sendBtn) sendBtn.disabled = true;
      if (sendOtherBtn) sendOtherBtn.disabled = true;
      if (label) label.textContent = data.ui.sending;
      try {
        const body: Record<string, unknown> = { productId: data.productId, lang: data.lang };
        // Lo que se ve en la vista previa (editado o traducido) es lo que llega al correo.
        if (currentMessage) body.message = currentMessage;
        if (to) body.to = to;
        const res = await fetch('/api/share/email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const out = (await res.json().catch(() => ({}))) as { ok?: boolean; to?: string };
        if (res.ok && out.ok) {
          showToast(data.ui.sent.replace('{email}', out.to || to || data.email));
          // Envío correcto: volvemos al panel privado (Mi Radar) con el aviso a la vista.
          window.setTimeout(() => window.location.assign('/mi-radar'), 1600);
        } else if (res.status === 401) {
          showToast(data.ui.errAuth, true);
          window.setTimeout(() => window.location.reload(), 2200);
        } else if (res.status === 429) {
          showToast(data.ui.errRate, true);
        } else if (res.status === 503) {
          showToast(data.ui.errSmtp, true);
        } else {
          showToast(data.ui.errGeneric, true);
        }
      } catch {
        showToast(data.ui.errGeneric, true);
      } finally {
        if (label) label.innerHTML = original;
        // Una pausa corta evita el doble clic accidental (el servidor además limita los envíos).
        window.setTimeout(() => {
          if (sendBtn) sendBtn.disabled = false;
          if (sendOtherBtn) sendOtherBtn.disabled = false;
        }, 1500);
      }
    }

    sendBtn?.addEventListener('click', () => {
      void sendCard(null, sendBtn);
    });

    sendOtherBtn?.addEventListener('click', () => {
      const to = (otherEmailInput?.value ?? '').trim().toLowerCase();
      if (!EMAIL_RE.test(to)) {
        showToast(data.ui.invalidEmail, true);
        otherEmailInput?.focus();
        return;
      }
      void sendCard(to, sendOtherBtn);
    });

    // Sin sesión: el modal de acceso, al terminar, normalmente lleva a la portada. Esta página
    // pide quedarse (data-auth-stay en <body>): el modal la recarga con el botón de envío y el
    // mismo ?lang=, así el usuario no pierde la tarjeta.
    document.body.setAttribute('data-auth-stay', '');
  </script>
</Layout>
