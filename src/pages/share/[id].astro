---
/**
 * ==============================================================================
 * TRADYLOR — PÁGINA DE COMPARTIR (PREVIEW HTML PARA EMAIL)
 * ==============================================================================
 *
 * Ruta dinámica SSR: /share/[id]?lang=xx
 *
 * Cuando el usuario pulsa "Email" en el panel de compartir, se abre esta página
 * que muestra una tarjeta HTML atractiva con imagen del producto, colores y el
 * mensaje de recomendación. El usuario puede:
 *  - Enviar directamente con su cliente de correo (mailto:)
 *  - Copiar el HTML formateado y pegarlo en Gmail/Outlook/Apple Mail
 *  - Copiar solo el texto
 *
 * El idioma se pasa como query param (?lang=ca) porque la página es SSR y no
 * puede leer localStorage en el servidor. En el cliente se corrige con
 * localStorage si difiere.
 * ==============================================================================
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { findCatalogProduct, productKey } from '../../lib/catalog';
import {
  buildShareText,
  buildShareUrl,
  getShareLangOptions,
  SHARE_LANG_CODES,
  type ShareLangCode,
} from '../../utils/share';

const product = findCatalogProduct(Astro.params.id);
if (!product) return Astro.redirect('/', 302);

const key = productKey(product);

// Idioma desde query param (lo pasa el panel de compartir al abrir la página).
// Se valida contra SHARE_LANG_CODES (lista fija) porque getShareLangOptions()
// depende de navigator, que no existe en el servidor SSR.
const langParam = (Astro.url.searchParams.get('lang') ?? '').trim() as ShareLangCode;
const lang: ShareLangCode = SHARE_LANG_CODES.includes(langParam) ? langParam : 'es';

const shortUrl = buildShareUrl(key, 'email');
const rawMessage = buildShareText(
  'email',
  { productId: key, title: product.title, category: product.category },
  shortUrl,
  lang,
);
// El enlace se oculta del cuerpo: ya hay botón CTA "Ver ficha completa"
const message = rawMessage.replace(shortUrl, '').replace(/\s+/g, ' ').trim();
const absoluteImage = /^https?:\/\//i.test(product.image)
  ? product.image
  : new URL(product.image, Astro.site ?? 'https://tradylor.com').href;

const cleanTitle = product.title
  .replace(/\s*[\-|:]\s*(Amazon(?:\.es)?|PcComponentes|El Corte Inglés|MediaMarkt|Fnac|AliExpress|Carrefour|Apple).*$/i, '')
  .trim();

// Opciones de idioma para el selector de la página
const langOptions = getShareLangOptions();

// Textos de UI según idioma
const UI: Record<string, { send: string; sendLabel: string; sendPlaceholder: string; sending: string; sentOk: string; sentErr: string; copyHtml: string; copyText: string; viewProduct: string; hint: string; footer: string; cta: string; htmlOk: string; textOk: string; invalidEmail: string }> = {
  es: { send: 'Enviar', sendLabel: 'Enviar por email a:', sendPlaceholder: 'destinatario@email.com', sending: 'Enviando…', sentOk: '¡Email enviado!', sentErr: 'No se pudo enviar. Inténtalo de nuevo.', copyHtml: 'Copiar HTML del email', copyText: 'Copiar solo texto', viewProduct: 'Ver ficha del producto', hint: 'Rellena el destinatario y pulsa Enviar, o copia el HTML para pegarlo en tu correo.', footer: 'Enviado desde', cta: 'Ver ficha completa en Tradylor →', htmlOk: 'HTML copiado. Pégalo en tu correo.', textOk: 'Texto copiado.', invalidEmail: 'Introduce un email válido.' },
  ca: { send: 'Enviar', sendLabel: 'Enviar per email a:', sendPlaceholder: 'destinatari@email.com', sending: "S'està enviant…", sentOk: 'Email enviat!', sentErr: "No s'ha pogut enviar. Prova-ho de nou.", copyHtml: "Copiar l'HTML del correu", copyText: 'Copiar només el text', viewProduct: 'Veure la fitxa del producte', hint: "Omple el destinatari i prem Enviar, o copia l'HTML per enganxar-lo al teu correu.", footer: 'Enviat des de', cta: 'Veure la fitxa completa a Tradylor →', htmlOk: "HTML copiat. Enganxa'l al teu correu.", textOk: 'Text copiat.', invalidEmail: 'Introdueix un email vàlid.' },
  eu: { send: 'Bidali', sendLabel: 'Bidali email honi:', sendPlaceholder: 'hartzailea@email.com', sending: 'Bidaltzen…', sentOk: 'Emaila bidali da!', sentErr: 'Ezin izan da bidali. Saiatu berriro.', copyHtml: 'Kopiatu posta HTMLa', copyText: 'Kopiatu testua bakarrik', viewProduct: 'Ikusi produktuaren fitxa', hint: 'Bete hartzailea eta sakatu Bidali, edo kopiatu HTMLa zure postara itsasteko.', footer: 'Bidali da', cta: 'Ikusi fitxa osoa Tradylor-en →', htmlOk: 'HTML kopiatua. Itsatsi zure postan.', textOk: 'Testua kopiatu da.', invalidEmail: 'Sartu baliozko email bat.' },
  gl: { send: 'Enviar', sendLabel: 'Enviar por email a:', sendPlaceholder: 'destinatario@email.com', sending: 'Enviando…', sentOk: 'Email enviado!', sentErr: 'Non se puido enviar. Inténtao de novo.', copyHtml: 'Copiar o HTML do correo', copyText: 'Copiar só o texto', viewProduct: 'Ver a ficha do produto', hint: 'Enche o destinatario e preme Enviar, ou copia o HTML para pegalo no teu correo.', footer: 'Enviado desde', cta: 'Ver a ficha completa en Tradylor →', htmlOk: 'HTML copiado. Pégalo no teu correo.', textOk: 'Texto copiado.', invalidEmail: 'Introduce un email válido.' },
  en: { send: 'Send', sendLabel: 'Send by email to:', sendPlaceholder: 'recipient@email.com', sending: 'Sending…', sentOk: 'Email sent!', sentErr: 'Could not send. Please try again.', copyHtml: 'Copy email HTML', copyText: 'Copy text only', viewProduct: 'View product sheet', hint: 'Fill in the recipient and press Send, or copy the HTML to paste into your email.', footer: 'Sent from', cta: 'View full sheet on Tradylor →', htmlOk: 'HTML copied. Paste it into your email.', textOk: 'Text copied.', invalidEmail: 'Enter a valid email.' },
  fr: { send: 'Envoyer', sendLabel: 'Envoyer par email à :', sendPlaceholder: 'destinataire@email.com', sending: 'Envoi…', sentOk: 'Email envoyé !', sentErr: "Impossible d'envoyer. Réessayez.", copyHtml: "Copier le HTML de l'email", copyText: 'Copier le texte seulement', viewProduct: 'Voir la fiche produit', hint: "Remplissez le destinataire et appuyez sur Envoyer, ou copiez le HTML pour le coller dans votre email.", footer: 'Envoyé depuis', cta: 'Voir la fiche complète sur Tradylor →', htmlOk: 'HTML copié. Collez-le dans votre email.', textOk: 'Texte copié.', invalidEmail: 'Entrez un email valide.' },
  de: { send: 'Senden', sendLabel: 'Per E-Mail senden an:', sendPlaceholder: 'empfaenger@email.com', sending: 'Wird gesendet…', sentOk: 'E-Mail gesendet!', sentErr: 'Konnte nicht gesendet werden. Bitte erneut versuchen.', copyHtml: 'E-Mail-HTML kopieren', copyText: 'Nur Text kopieren', viewProduct: 'Produktdatenblatt ansehen', hint: 'Empfänger einfügen und auf Senden klicken, oder das HTML für Ihre E-Mail kopieren.', footer: 'Gesendet von', cta: 'Vollständiges Datenblatt auf Tradylor ansehen →', htmlOk: 'HTML kopiert. Fügen Sie es in Ihre E-Mail ein.', textOk: 'Text kopiert.', invalidEmail: 'Geben Sie eine gültige E-Mail ein.' },
  pt: { send: 'Enviar', sendLabel: 'Enviar por email para:', sendPlaceholder: 'destinatario@email.com', sending: 'A enviar…', sentOk: 'Email enviado!', sentErr: 'Não foi possível enviar. Tente novamente.', copyHtml: 'Copiar HTML do email', copyText: 'Copiar apenas o texto', viewProduct: 'Ver a ficha do produto', hint: 'Preencha o destinatário e clique Enviar, ou copie o HTML para colar no seu email.', footer: 'Enviado desde', cta: 'Ver a ficha completa no Tradylor →', htmlOk: 'HTML copiado. Cole no seu email.', textOk: 'Texto copiado.', invalidEmail: 'Introduza um email válido.' },
  it: { send: 'Invia', sendLabel: 'Invia via email a:', sendPlaceholder: 'destinatario@email.com', sending: 'Invio in corso…', sentOk: 'Email inviata!', sentErr: "Impossibile inviare. Riprova.", copyHtml: "Copia l'HTML dell'email", copyText: 'Copia solo il testo', viewProduct: 'Vedi la scheda prodotto', hint: 'Compila il destinatario e premi Invia, o copia l\'HTML per incollarlo nella tua email.', footer: 'Inviato da', cta: 'Vedi la scheda completa su Tradylor →', htmlOk: 'HTML copiato. Incollalo nella tua email.', textOk: 'Testo copiato.', invalidEmail: 'Inserisci un email valido.' },
};
const ui = UI[lang] ?? UI.es;
---

<Layout
  title={`Compartir: ${cleanTitle} | Tradylor`}
  description="Vista previa del mensaje de recomendación para compartir por email."
  noindex={true}
>
  <div class="share-preview-page">
    <div class="share-preview-container">
      <header class="share-header">
        <div class="share-logo">
          <span class="logo-mark">T</span>
          <span class="logo-text">Tradylor</span>
        </div>
        <p class="share-hint">{ui.hint}</p>

        <!-- Selector de idioma -->
        <div class="lang-bar" role="group" aria-label="Idioma">
          {langOptions.map((opt) => (
            <button
              type="button"
              class={`lang-btn${opt.code === lang ? ' is-active' : ''}`}
              data-page-lang={opt.code}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </header>

      <!-- Tarjeta HTML del email -->
      <div class="email-card" id="emailCard">
        <div class="email-card-bar"></div>
        <div class="email-card-body">
          <p class="email-message" id="emailMessage">{message}</p>
          <div class="email-divider"></div>
          <div class="email-product">
            <div class="email-product-image-wrap">
              <img
                src={absoluteImage}
                alt={cleanTitle}
                class="email-product-image"
                width="280"
                height="280"
                loading="eager"
              />
            </div>
            <div class="email-product-info">
              <h2 class="email-product-title">{cleanTitle}</h2>
              {product.category && (
                <p class="email-product-category">{product.category}</p>
              )}
              <a href={shortUrl} class="email-cta" target="_blank" rel="noopener noreferrer" id="emailCta">
                {ui.cta}
              </a>
            </div>
          </div>
        </div>
        <div class="email-card-footer">
          <p>{ui.footer} <strong>Tradylor.com</strong> · Comparativa de precios y análisis</p>
        </div>
      </div>

      <!-- Formulario de envío + botones de acción -->
      <div class="send-form">
        <label class="send-label" for="sendTo">{ui.sendLabel}</label>
        <div class="send-row">
          <input
            type="email"
            id="sendTo"
            class="send-input"
            placeholder={ui.sendPlaceholder}
            autocomplete="email"
          />
          <button type="button" class="share-btn share-btn-send" id="sendEmailBtn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            {ui.send}
          </button>
        </div>
      </div>

      <div class="share-actions">
        <button type="button" class="share-btn share-btn-primary" id="copyHtmlBtn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="11" height="11" rx="2"/>
            <path d="M15 5.5A2.5 2.5 0 0 0 12.5 3H6a2.5 2.5 0 0 0-2.5 2.5V12A2.5 2.5 0 0 0 6 14.5"/>
          </svg>
          {ui.copyHtml}
        </button>
        <button type="button" class="share-btn share-btn-secondary" id="copyTextBtn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
            <polyline points="16 6 12 2 8 6"/>
            <line x1="12" y1="2" x2="12" y2="15"/>
          </svg>
          {ui.copyText}
        </button>
        <a href={`/producto/${key}`} class="share-btn share-btn-ghost" target="_blank" rel="noopener noreferrer">
          {ui.viewProduct}
        </a>
      </div>

      <div class="share-toast" id="shareToast"></div>
    </div>
  </div>

  <style>
    .share-preview-page {
      min-height: 100vh;
      background: linear-gradient(135deg, #0a0e17 0%, #111827 50%, #0a0e17 100%);
      padding: 2rem 1rem;
    }
    .share-preview-container { max-width: 640px; margin: 0 auto; }
    .share-header { text-align: center; margin-bottom: 2rem; }
    .share-logo { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: .75rem; }
    .logo-mark {
      display: inline-flex; align-items: center; justify-content: center;
      width: 36px; height: 36px; border-radius: 10px;
      background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
      color: #0d1422; font-weight: 800; font-size: 1.1rem; font-family: 'Outfit', sans-serif;
    }
    .logo-text { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.25rem; color: #f3f4f6; }
    .share-hint { font-size: .82rem; color: #9ca3af; max-width: 420px; margin: 0 auto .9rem; line-height: 1.5; }

    .lang-bar {
      display: inline-flex; gap: .3rem; padding: .28rem;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.09);
      border-radius: 999px; flex-wrap: wrap; justify-content: center;
    }
    .lang-btn {
      padding: .32rem .7rem; font-family: inherit; font-size: .72rem; font-weight: 700;
      color: #9ca3af; background: transparent; border: 1px solid transparent;
      border-radius: 999px; cursor: pointer; transition: .16s; white-space: nowrap;
    }
    .lang-btn:hover { color: #e5e7eb; background: rgba(255,255,255,.07); }
    .lang-btn.is-active {
      color: #0d1422; background: linear-gradient(135deg,#60a5fa 0%,#3b82f6 100%);
      border-color: rgba(96,165,250,.6); box-shadow: 0 3px 10px rgba(59,130,246,.35);
    }

    .email-card {
      background: #ffffff; border-radius: 16px; overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.06);
      margin-bottom: 1.5rem;
    }
    .email-card-bar { height: 6px; background: linear-gradient(90deg, #60a5fa 0%, #3b82f6 40%, #2563eb 100%); }
    .email-card-body { padding: 1.75rem 1.75rem 1.25rem; }
    .email-message { font-size: 1rem; line-height: 1.65; color: #1f2937; margin: 0 0 1.25rem; font-family: 'Inter', sans-serif; }
    .email-divider { height: 1px; background: linear-gradient(90deg, transparent, #e5e7eb 20%, #e5e7eb 80%, transparent); margin: 0 0 1.25rem; }
    .email-product { display: flex; gap: 1.25rem; align-items: flex-start; }
    .email-product-image-wrap {
      flex-shrink: 0; width: 140px; height: 140px; border-radius: 12px;
      background: #f8fafc; border: 1px solid #e5e7eb;
      display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .email-product-image { width: 100%; height: 100%; object-fit: contain; padding: .5rem; }
    .email-product-info { flex: 1; min-width: 0; }
    .email-product-title { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.05rem; color: #0d1422; margin: 0 0 .35rem; line-height: 1.3; }
    .email-product-category { font-size: .78rem; color: #6b7280; margin: 0 0 .85rem; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }
    .email-cta {
      display: inline-block; background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
      color: #fff; text-decoration: none; font-weight: 700; font-size: .85rem;
      padding: .6rem 1.1rem; border-radius: 8px; transition: .2s; font-family: 'Inter', sans-serif;
    }
    .email-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(59,130,246,.4); }
    .email-card-footer { background: #f8fafc; padding: .85rem 1.75rem; border-top: 1px solid #e5e7eb; }
    .email-card-footer p { margin: 0; font-size: .72rem; color: #9ca3af; text-align: center; }

    .share-actions { display: flex; flex-wrap: wrap; gap: .65rem; justify-content: center; }

    .send-form { margin-bottom: 1.25rem; }
    .send-label { display: block; font-size: .8rem; font-weight: 700; color: #d1d5db; margin-bottom: .4rem; text-align: center; }
    .send-row { display: flex; gap: .5rem; align-items: stretch; }
    .send-input {
      flex: 1; min-width: 0; padding: .7rem 1rem; border-radius: 10px;
      border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.06);
      color: #f3f4f6; font-family: 'Inter', sans-serif; font-size: .9rem; outline: none; transition: .18s;
    }
    .send-input::placeholder { color: #6b7280; }
    .send-input:focus { border-color: rgba(96,165,250,.6); background: rgba(255,255,255,.1); box-shadow: 0 0 0 3px rgba(59,130,246,.2); }
    .send-row .share-btn-send { flex-shrink: 0; }
    .share-btn {
      display: inline-flex; align-items: center; gap: .45rem;
      padding: .7rem 1.15rem; border-radius: 10px; font-weight: 700; font-size: .85rem;
      font-family: 'Inter', sans-serif; cursor: pointer; border: none; text-decoration: none; transition: .18s;
    }
    .share-btn-send {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
      color: #06281c; box-shadow: 0 4px 16px rgba(16,185,129,.35);
    }
    .share-btn-send:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(16,185,129,.5); }
    .share-btn-primary {
      background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
      color: #0d1422; box-shadow: 0 4px 16px rgba(59,130,246,.35);
    }
    .share-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(59,130,246,.5); }
    .share-btn-secondary { background: rgba(255,255,255,.08); color: #e5e7eb; border: 1px solid rgba(255,255,255,.12); }
    .share-btn-secondary:hover { background: rgba(255,255,255,.14); }
    .share-btn-ghost { background: transparent; color: #9ca3af; border: 1px solid rgba(255,255,255,.1); }
    .share-btn-ghost:hover { color: #e5e7eb; border-color: rgba(255,255,255,.2); }

    .share-toast {
      position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%) translateY(20px);
      background: rgba(13,20,34,.95); color: #f3f4f6; border: 1px solid rgba(255,255,255,.14);
      padding: .65rem 1.25rem; border-radius: 999px; font-size: .82rem; font-weight: 600;
      opacity: 0; pointer-events: none; transition: .25s; z-index: 999;
    }
    .share-toast.is-on { opacity: 1; transform: translateX(-50%) translateY(0); }

    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 520px) {
      .email-product { flex-direction: column; align-items: center; text-align: center; }
      .email-product-image-wrap { width: 180px; height: 180px; }
      .email-card-body { padding: 1.25rem; }
      .share-actions { flex-direction: column; }
      .share-btn { justify-content: center; }
    }
  </style>

  <script define:vars={{ message, shortUrl, cleanTitle, lang, productId: key, uiSend: ui }}>
    // ---- Persistencia de idioma en localStorage (corrige SSR) ----
    const STORAGE_KEY = 'tradylor_share_lang';

    function showToast(msg, isErr) {
      const toast = document.getElementById('shareToast');
      if (!toast) return;
      toast.textContent = msg;
      toast.style.borderColor = isErr ? 'rgba(248,113,113,.6)' : 'rgba(255,255,255,.14)';
      toast.style.color = isErr ? '#fca5a5' : '#f3f4f6';
      toast.classList.add('is-on');
      setTimeout(() => toast.classList.remove('is-on'), 2800);
    }

    async function copyToClipboard(text, okMsg) {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          showToast(okMsg);
          return;
        }
      } catch {}
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:-1000px;opacity:0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showToast(okMsg);
    }

    function buildEmailHtml(msgText, ctaLabel) {
      const card = document.getElementById('emailCard');
      if (!card) return '';
      const img = card.querySelector('.email-product-image');
      const imgUrl = img ? img.src : '';
      const imgAlt = img ? img.alt : '';
      const title = document.querySelector('.email-product-title')?.textContent || '';

      return '<div style="font-family:Inter,Arial,sans-serif;max-width:560px;margin:0 auto;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.1);border:1px solid #e5e7eb;">' +
        '<div style="height:6px;background:linear-gradient(90deg,#60a5fa,#3b82f6,#2563eb);"></div>' +
        '<div style="padding:28px 28px 20px;background:#ffffff;">' +
        '<p style="font-size:15px;line-height:1.65;color:#1f2937;margin:0 0 20px;">' + msgText + '</p>' +
        '<div style="height:1px;background:linear-gradient(90deg,transparent,#e5e7eb,#e5e7eb,transparent);margin:0 0 20px;"></div>' +
        '<div style="display:flex;gap:20px;align-items:flex-start;">' +
        '<div style="flex-shrink:0;width:140px;height:140px;border-radius:12px;background:#f8fafc;border:1px solid #e5e7eb;display:flex;align-items:center;justify-content:center;overflow:hidden;">' +
        '<img src="' + imgUrl + '" alt="' + imgAlt + '" width="130" height="130" style="width:100%;height:100%;object-fit:contain;padding:8px;" />' +
        '</div>' +
        '<div style="flex:1;min-width:0;">' +
        '<h2 style="font-size:16px;font-weight:700;color:#0d1422;margin:0 0 6px;line-height:1.3;">' + title + '</h2>' +
        '<a href="' + shortUrl + '" style="display:inline-block;background:linear-gradient(135deg,#60a5fa,#3b82f6);color:#ffffff;text-decoration:none;font-weight:700;font-size:13px;padding:10px 18px;border-radius:8px;">' + ctaLabel + '</a>' +
        '</div></div></div>' +
        '<div style="background:#f8fafc;padding:14px 28px;border-top:1px solid #e5e7eb;">' +
        '<p style="margin:0;font-size:11px;color:#9ca3af;text-align:center;">Enviado desde <strong>Tradylor.com</strong> · Comparativa de precios y análisis</p>' +
        '</div></div>';
    }

    // ---- Enviar por email via SMTP ----
    const sendBtn = document.getElementById('sendEmailBtn');
    const sendInput = document.getElementById('sendTo');
    sendBtn?.addEventListener('click', async () => {
      const to = (sendInput?.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(to)) {
        showToast(uiSend.invalidEmail, true);
        sendInput?.focus();
        return;
      }
      sendBtn.disabled = true;
      const originalHtml = sendBtn.innerHTML;
      sendBtn.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite"><circle cx="12" cy="12" r="10" stroke-dasharray="30 60"/></svg> ' + uiSend.sending;
      try {
        const res = await fetch('/api/share/email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, to, lang }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          showToast(uiSend.sentOk, false);
          if (sendInput) sendInput.value = '';
        } else {
          showToast(uiSend.sentErr + (data.error ? ' (' + data.error + ')' : ''), true);
        }
      } catch {
        showToast(uiSend.sentErr, true);
      } finally {
        sendBtn.disabled = false;
        sendBtn.innerHTML = originalHtml;
      }
    });
    sendInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') sendBtn?.click();
    });

    // ---- Copiar HTML / texto ----
    document.getElementById('copyHtmlBtn')?.addEventListener('click', () => {
      copyToClipboard(buildEmailHtml(message, uiSend.cta), uiSend.htmlOk);
    });
    document.getElementById('copyTextBtn')?.addEventListener('click', () => {
      copyToClipboard(message + '\n\n' + shortUrl, uiSend.textOk);
    });
  </script>
</Layout>
