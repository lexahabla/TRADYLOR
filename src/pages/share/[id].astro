---
/**
 * ==============================================================================
 * TRADYLOR — PÁGINA DE COMPARTIR (PREVIEW HTML PARA EMAIL)
 * ==============================================================================
 *
 * Ruta dinámica SSR: /share/[id]?lang=xx
 *
 * Cuando el usuario pulsa "Email" en el panel de compartir, se abre esta página
 * con la tarjeta HTML del correo (imagen del producto, mensaje y botón). Al
 * pulsar "Enviar" (cliente de correo, mailto:) o "Enviar con Gmail":
 *  1. La tarjeta se copia al portapapeles como contenido enriquecido (text/html).
 *  2. Se abre el correo con el asunto ya puesto.
 *  3. El usuario pega la tarjeta en el cuerpo (Ctrl+V) y elige el destinatario
 *     entre SUS contactos. Ni mailto: ni la URL de Gmail admiten HTML, por eso
 *     el cuerpo viaja por el portapapeles.
 *
 * La vista previa y lo que se copia salen del mismo HTML (utils/shareEmail.ts):
 * lo que se ve es exactamente lo que llega.
 *
 * El idioma se pasa como query param (?lang=ca) porque la página es SSR y no
 * puede leer localStorage en el servidor. El selector se completa en el cliente
 * con los idiomas cooficiales de la región (navegador + IP, /api/share/region).
 * ==============================================================================
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { findCatalogProduct, productKey } from '../../lib/catalog';
import { langsFromAcceptLanguage } from '../../lib/shareGeo';
import {
  buildShareText,
  buildShareUrl,
  getShareLangOptions,
  SHARE_LANG_CODES,
  type ShareLangCode,
} from '../../utils/share';
import { buildShareEmailHtml } from '../../utils/shareEmail';

const product = findCatalogProduct(Astro.params.id);
if (!product) return Astro.redirect('/', 302);

const key = productKey(product);

// Idioma desde query param (lo pasa el panel de compartir al abrir la página).
// Se valida contra SHARE_LANG_CODES (lista fija).
const langParam = (Astro.url.searchParams.get('lang') ?? '').trim().toLowerCase() as ShareLangCode;
const lang: ShareLangCode = SHARE_LANG_CODES.includes(langParam) ? langParam : 'es';

const shortUrl = buildShareUrl(key, 'email');
const rawMessage = buildShareText(
  'email',
  { productId: key, title: product.title, category: product.category },
  shortUrl,
  lang,
);
// El enlace se oculta del cuerpo: ya hay botón CTA "Ver ficha completa"
const message = rawMessage.replace(shortUrl, '').replace(/\s+/g, ' ').trim();
const absoluteImage = /^https?:\/\//i.test(product.image)
  ? product.image
  : new URL(product.image, Astro.site ?? 'https://tradylor.com').href;

const cleanTitle = product.title
  .replace(/\s*[\-|:]\s*(Amazon(?:\.es)?|PcComponentes|El Corte Inglés|MediaMarkt|Fnac|AliExpress|Carrefour|Apple).*$/i, '')
  .trim();

// Tarjeta del correo: se pinta tal cual en la vista previa y es lo que se copia.
const emailHtml = buildShareEmailHtml({
  message,
  title: cleanTitle,
  category: product.category,
  imageUrl: absoluteImage,
  ctaUrl: shortUrl,
  lang,
});

// Selector de idioma (SSR): el idioma activo + los cooficiales que declara la
// cabecera Accept-Language. El cliente lo completa con la región por IP.
const headerLangs = langsFromAcceptLanguage(Astro.request.headers.get('accept-language'));
const langOptions = getShareLangOptions([lang, ...headerLangs]);

interface ShareUiStrings {
  hint: string;
  send: string;
  sendGmail: string;
  copyText: string;
  note: string;
  copied: string;
  copyFailed: string;
  textOk: string;
  textFail: string;
}

// Textos de UI según idioma
const UI: Record<ShareLangCode, ShareUiStrings> = {
  es: {
    hint: 'Revisa la tarjeta tal y como la recibirá tu contacto y envíala desde tu propio correo.',
    send: 'Enviar',
    sendGmail: 'Enviar con Gmail',
    copyText: 'Copiar solo texto',
    note: 'Al pulsar, copiamos la tarjeta y abrimos tu correo: pégala en el cuerpo del mensaje (Ctrl+V / ⌘V) y elige el destinatario entre tus contactos.',
    copied: 'Tarjeta copiada. Pégala en el cuerpo del correo (Ctrl+V / ⌘V).',
    copyFailed: 'No se pudo copiar la tarjeta. Hemos puesto el mensaje en texto en el correo.',
    textOk: 'Texto copiado.',
    textFail: 'No se pudo copiar el texto.',
  },
  ca: {
    hint: 'Revisa la targeta tal com la rebrà el teu contacte i envia-la des del teu propi correu.',
    send: 'Enviar',
    sendGmail: 'Enviar amb Gmail',
    copyText: 'Copiar només el text',
    note: "En prémer, copiem la targeta i obrim el teu correu: enganxa-la al cos del missatge (Ctrl+V / ⌘V) i tria el destinatari entre els teus contactes.",
    copied: 'Targeta copiada. Enganxa-la al cos del correu (Ctrl+V / ⌘V).',
    copyFailed: "No s'ha pogut copiar la targeta. Hem posat el missatge en text al correu.",
    textOk: 'Text copiat.',
    textFail: "No s'ha pogut copiar el text.",
  },
  eu: {
    hint: 'Berrikusi txartela zure kontaktuak jasoko duen bezala eta bidali zure posta elektronikotik.',
    send: 'Bidali',
    sendGmail: 'Bidali Gmail-ekin',
    copyText: 'Kopiatu testua bakarrik',
    note: 'Sakatzean, txartela kopiatuko dugu eta zure posta irekiko dugu: itsatsi mezuaren gorputzean (Ctrl+V / ⌘V) eta aukeratu hartzailea zure kontaktuen artean.',
    copied: 'Txartela kopiatu da. Itsatsi posta-mezuaren gorputzean (Ctrl+V / ⌘V).',
    copyFailed: 'Ezin izan da txartela kopiatu. Mezua testu gisa jarri dugu postan.',
    textOk: 'Testua kopiatu da.',
    textFail: 'Ezin izan da testua kopiatu.',
  },
  gl: {
    hint: 'Revisa a tarxeta tal e como a recibirá o teu contacto e envíaa desde o teu propio correo.',
    send: 'Enviar',
    sendGmail: 'Enviar con Gmail',
    copyText: 'Copiar só o texto',
    note: 'Ao premer, copiamos a tarxeta e abrimos o teu correo: pégaa no corpo da mensaxe (Ctrl+V / ⌘V) e escolle o destinatario entre os teus contactos.',
    copied: 'Tarxeta copiada. Pégaa no corpo do correo (Ctrl+V / ⌘V).',
    copyFailed: 'Non se puido copiar a tarxeta. Puxemos a mensaxe en texto no correo.',
    textOk: 'Texto copiado.',
    textFail: 'Non se puido copiar o texto.',
  },
  en: {
    hint: 'Review the card exactly as your contact will receive it and send it from your own email.',
    send: 'Send',
    sendGmail: 'Send with Gmail',
    copyText: 'Copy text only',
    note: 'When you click, we copy the card and open your email: paste it into the message body (Ctrl+V / ⌘V) and pick the recipient from your contacts.',
    copied: 'Card copied. Paste it into the email body (Ctrl+V / ⌘V).',
    copyFailed: "Couldn't copy the card. We put the message in the email as plain text.",
    textOk: 'Text copied.',
    textFail: "Couldn't copy the text.",
  },
  fr: {
    hint: 'Vérifiez la carte telle que votre contact la recevra et envoyez-la depuis votre propre messagerie.',
    send: 'Envoyer',
    sendGmail: 'Envoyer avec Gmail',
    copyText: 'Copier le texte seulement',
    note: 'En cliquant, nous copions la carte et ouvrons votre messagerie : collez-la dans le corps du message (Ctrl+V / ⌘V) et choisissez le destinataire parmi vos contacts.',
    copied: "Carte copiée. Collez-la dans le corps de l'email (Ctrl+V / ⌘V).",
    copyFailed: "Impossible de copier la carte. Nous avons mis le message en texte dans l'email.",
    textOk: 'Texte copié.',
    textFail: 'Impossible de copier le texte.',
  },
  de: {
    hint: 'Prüfe die Karte so, wie dein Kontakt sie erhält, und sende sie aus deinem eigenen E-Mail-Postfach.',
    send: 'Senden',
    sendGmail: 'Mit Gmail senden',
    copyText: 'Nur Text kopieren',
    note: 'Beim Klicken kopieren wir die Karte und öffnen dein E-Mail-Programm: Füge sie in den Nachrichtentext ein (Strg+V / ⌘V) und wähle den Empfänger aus deinen Kontakten.',
    copied: 'Karte kopiert. Füge sie in den E-Mail-Text ein (Strg+V / ⌘V).',
    copyFailed: 'Die Karte konnte nicht kopiert werden. Wir haben die Nachricht als Text in die E-Mail eingefügt.',
    textOk: 'Text kopiert.',
    textFail: 'Der Text konnte nicht kopiert werden.',
  },
  pt: {
    hint: 'Revê o cartão tal como o teu contacto o vai receber e envia-o a partir do teu próprio email.',
    send: 'Enviar',
    sendGmail: 'Enviar com o Gmail',
    copyText: 'Copiar apenas o texto',
    note: 'Ao clicar, copiamos o cartão e abrimos o teu email: cola-o no corpo da mensagem (Ctrl+V / ⌘V) e escolhe o destinatário entre os teus contactos.',
    copied: 'Cartão copiado. Cola-o no corpo do email (Ctrl+V / ⌘V).',
    copyFailed: 'Não foi possível copiar o cartão. Pusemos a mensagem em texto no email.',
    textOk: 'Texto copiado.',
    textFail: 'Não foi possível copiar o texto.',
  },
  it: {
    hint: 'Controlla la scheda così come la riceverà il tuo contatto e inviala dalla tua email.',
    send: 'Invia',
    sendGmail: 'Invia con Gmail',
    copyText: 'Copia solo il testo',
    note: 'Cliccando, copiamo la scheda e apriamo la tua email: incollala nel corpo del messaggio (Ctrl+V / ⌘V) e scegli il destinatario tra i tuoi contatti.',
    copied: "Scheda copiata. Incollala nel corpo dell'email (Ctrl+V / ⌘V).",
    copyFailed: "Impossibile copiare la scheda. Abbiamo messo il messaggio come testo nell'email.",
    textOk: 'Testo copiato.',
    textFail: 'Impossibile copiare il testo.',
  },
};
const ui = UI[lang] ?? UI.es;

// Datos para el script del cliente (JSON inerte: no se ejecuta, sólo se lee).
const clientData = {
  lang,
  subject: cleanTitle,
  text: `${message}\n\n${shortUrl}`,
  html: emailHtml,
  ui: { copied: ui.copied, copyFailed: ui.copyFailed, textOk: ui.textOk, textFail: ui.textFail },
};
const clientJson = JSON.stringify(clientData).replace(/</g, '\\u003c');
---

<Layout
  title={`Compartir: ${cleanTitle} | Tradylor`}
  description="Vista previa del mensaje de recomendación para compartir por email."
  noindex={true}
>
  <div class="share-preview-page">
    <div class="share-preview-container">
      <header class="share-header">
        <div class="share-logo">
          <span class="logo-mark">T</span>
          <span class="logo-text">Tradylor</span>
        </div>
        <p class="share-hint">{ui.hint}</p>

        <!-- Selector de idioma (el cliente lo completa con los idiomas de la región) -->
        <div class="lang-bar" data-lang-bar role="group" aria-label="Idioma">
          {langOptions.map((opt) => (
            <button
              type="button"
              class={`lang-btn${opt.code === lang ? ' is-active' : ''}`}
              data-page-lang={opt.code}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </header>

      <!-- Tarjeta del correo: es exactamente el HTML que se copia al pulsar Enviar -->
      <div class="email-preview" id="emailCard" set:html={emailHtml} />

      <div class="share-actions">
        <!-- Abre el cliente de correo del usuario (mailto:) -->
        <button type="button" class="share-btn share-btn-mail" id="sendMailBtn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="5.5" width="18" height="13" rx="2.5"/>
            <path d="m4.5 8 7.5 5 7.5-5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{ui.send}</span>
        </button>
        <!-- Abre Gmail (redactar) con el asunto puesto -->
        <button type="button" class="share-btn share-btn-gmail" id="sendGmailBtn">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="#EA4335" d="M2 6.5v11A1.5 1.5 0 0 0 3.5 19H6V9.9l6 4.5 6-4.5V19h2.5a1.5 1.5 0 0 0 1.5-1.5v-11c0-1.7-1.9-2.6-3.2-1.6L12 9.6 5.2 4.9C3.9 3.9 2 4.8 2 6.5Z"/>
          </svg>
          <span>{ui.sendGmail}</span>
        </button>
        <button type="button" class="share-btn share-btn-secondary" id="copyTextBtn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"/>
            <path d="M15 5.5A2.5 2.5 0 0 0 12.5 3H6a2.5 2.5 0 0 0-2.5 2.5V12A2.5 2.5 0 0 0 6 14.5"/>
          </svg>
          <span>{ui.copyText}</span>
        </button>
      </div>

      <p class="share-note">{ui.note}</p>

      <div class="share-toast" id="shareToast" role="status" aria-live="polite"></div>
    </div>
  </div>

  <style>
    .share-preview-page {
      min-height: 100vh;
      background: linear-gradient(135deg, #0a0e17 0%, #111827 50%, #0a0e17 100%);
      padding: 2rem 1rem;
    }
    /* 600 px = ancho de la tarjeta del correo: vista previa, botones y notas alineados */
    .share-preview-container { max-width: 600px; margin: 0 auto; }
    .share-header { text-align: center; margin-bottom: 2rem; }
    .share-logo { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: .75rem; }
    .logo-mark {
      display: inline-flex; align-items: center; justify-content: center;
      width: 36px; height: 36px; border-radius: 10px;
      background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
      color: #0d1422; font-weight: 800; font-size: 1.1rem; font-family: 'Outfit', sans-serif;
    }
    .logo-text { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.25rem; color: #f3f4f6; }
    .share-hint { font-size: .82rem; color: #9ca3af; max-width: 420px; margin: 0 auto .9rem; line-height: 1.5; }

    /* Los botones de idioma se (re)generan en el cliente: de ahí :global() */
    .lang-bar {
      display: inline-flex; gap: .3rem; padding: .28rem;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.09);
      border-radius: 999px; flex-wrap: wrap; justify-content: center;
    }
    .lang-bar :global(.lang-btn) {
      padding: .32rem .7rem; font-family: inherit; font-size: .72rem; font-weight: 700;
      color: #9ca3af; background: transparent; border: 1px solid transparent;
      border-radius: 999px; cursor: pointer; transition: .16s; white-space: nowrap;
    }
    .lang-bar :global(.lang-btn:hover) { color: #e5e7eb; background: rgba(255,255,255,.07); }
    .lang-bar :global(.lang-btn.is-active) {
      color: #0d1422; background: linear-gradient(135deg,#60a5fa 0%,#3b82f6 100%);
      border-color: rgba(96,165,250,.6); box-shadow: 0 3px 10px rgba(59,130,246,.35);
    }

    /* Vista previa: el diseño de la tarjeta va inline en el propio HTML del correo */
    .email-preview {
      margin-bottom: 1.5rem; border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.06);
    }

    .share-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; }
    .share-actions .share-btn-secondary { grid-column: 1 / -1; }
    .share-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .5rem; width: 100%;
      padding: .8rem 1.25rem; border-radius: 10px; font-weight: 700; font-size: .9rem;
      font-family: 'Inter', sans-serif; cursor: pointer; border: none; text-decoration: none; transition: .18s;
    }
    .share-btn-mail {
      background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
      color: #ffffff; box-shadow: 0 4px 16px rgba(124,58,237,.35);
    }
    .share-btn-mail:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(124,58,237,.55); }
    .share-btn-gmail { background: #ffffff; color: #1f2937; box-shadow: 0 4px 16px rgba(0,0,0,.25); }
    .share-btn-gmail:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,.4); }
    .share-btn-secondary { background: rgba(255,255,255,.08); color: #e5e7eb; border: 1px solid rgba(255,255,255,.12); }
    .share-btn-secondary:hover { background: rgba(255,255,255,.14); }

    .share-note { margin: 1rem auto 0; max-width: 480px; text-align: center; font-size: .76rem; line-height: 1.55; color: #9ca3af; }

    .share-toast {
      position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%) translateY(20px);
      width: max-content; max-width: min(92vw, 520px); text-align: center; line-height: 1.45;
      background: rgba(13,20,34,.97); color: #f3f4f6; border: 1px solid rgba(255,255,255,.14);
      padding: .7rem 1.2rem; border-radius: 16px; font-size: .82rem; font-weight: 600;
      opacity: 0; pointer-events: none; transition: .25s; z-index: 999;
    }
    .share-toast.is-on { opacity: 1; transform: translateX(-50%) translateY(0); }
    .share-toast.is-error { border-color: rgba(248,113,113,.6); color: #fca5a5; }

    @media (max-width: 520px) {
      .share-actions { grid-template-columns: 1fr; }

      /* En móvil el bloque de producto de la vista previa se apila: imagen arriba y
         texto centrado debajo (ganchos tz-* de utils/shareEmail.ts). */
      .email-preview :global(.tz-prod),
      .email-preview :global(.tz-prod tbody),
      .email-preview :global(.tz-prod tr),
      .email-preview :global(.tz-prod td) { display: block !important; width: auto !important; }
      .email-preview :global(.tz-gap) { display: none !important; }
      .email-preview :global(.tz-img) { padding-bottom: 16px; }
      .email-preview :global(.tz-img > div) { margin: 0 auto; }
      .email-preview :global(.tz-txt) { text-align: center; }
    }
  </style>

  <script type="application/json" id="share-data" set:html={clientJson}></script>

  <script>
    import { copyText, getShareLangOptions, refreshRegionLangs, setShareLang } from '../../utils/share';
    import type { ShareLangCode } from '../../utils/share';

    interface ShareData {
      lang: ShareLangCode;
      subject: string;
      /** Mensaje + enlace en texto plano (alternativa si no se puede copiar la tarjeta). */
      text: string;
      /** HTML completo de la tarjeta (el mismo que la vista previa). */
      html: string;
      ui: { copied: string; copyFailed: string; textOk: string; textFail: string };
    }

    const data = JSON.parse(document.getElementById('share-data')?.textContent || '{}') as ShareData;

    // La página recuerda el idioma que se está viendo (el panel de compartir lo reutiliza).
    setShareLang(data.lang);

    // ---- Selector de idioma: idiomas cooficiales de la región + es + en ----
    const bar = document.querySelector<HTMLElement>('[data-lang-bar]');

    function renderLangBar(): void {
      if (!bar) return;
      bar.innerHTML = getShareLangOptions([data.lang])
        .map(
          (opt) =>
            `<button type="button" class="lang-btn${opt.code === data.lang ? ' is-active' : ''}" data-page-lang="${opt.code}">${opt.label}</button>`,
        )
        .join('');
    }

    // Cambiar de idioma = recargar con ?lang=xx (la tarjeta se genera en el servidor).
    bar?.addEventListener('click', (event) => {
      const btn = (event.target as Element | null)?.closest<HTMLElement>('[data-page-lang]');
      const code = btn?.dataset.pageLang as ShareLangCode | undefined;
      if (!code || code === data.lang) return;
      setShareLang(code);
      window.location.search = '?lang=' + encodeURIComponent(code);
    });

    renderLangBar();
    // Región del visitante (IP): añade catalán / euskera / gallego aunque el
    // navegador esté en castellano. El resultado se cachea varios días.
    void refreshRegionLangs().then((langs) => {
      if (langs.length) renderLangBar();
    });

    // ---- Toast ----
    let toastTimer: number | undefined;
    function showToast(message: string, isError = false, ms = 2800): void {
      const toast = document.getElementById('shareToast');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.toggle('is-error', isError);
      toast.classList.add('is-on');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), ms);
    }

    // ---- Copiar la tarjeta como contenido enriquecido ----
    async function copyCard(): Promise<boolean> {
      // 1) API moderna: text/html (la tarjeta) + text/plain (mensaje y enlace).
      try {
        if (navigator.clipboard?.write && typeof ClipboardItem !== 'undefined') {
          await navigator.clipboard.write([
            new ClipboardItem({
              'text/html': new Blob([data.html], { type: 'text/html' }),
              'text/plain': new Blob([data.text], { type: 'text/plain' }),
            }),
          ]);
          return true;
        }
      } catch {
        /* sin permiso o navegador sin soporte: se prueba la alternativa */
      }
      // 2) Alternativa: seleccionar la tarjeta ya pintada y copiar la selección.
      try {
        const card = document.getElementById('emailCard');
        const selection = window.getSelection();
        if (!card || !selection) return false;
        const range = document.createRange();
        range.selectNodeContents(card);
        selection.removeAllRanges();
        selection.addRange(range);
        const ok = document.execCommand('copy');
        selection.removeAllRanges();
        return ok;
      } catch {
        return false;
      }
    }

    // ---- Enviar: copiar la tarjeta + abrir el correo (mailto: o Gmail) ----
    // mailto: y la URL de Gmail sólo admiten texto plano. Si la tarjeta se copió,
    // el cuerpo se deja vacío (el usuario la pega); si no, va el texto plano.
    function mailtoUrl(withBody: boolean): string {
      const body = data.text.replace(/\n/g, '\r\n');
      return (
        'mailto:?subject=' + encodeURIComponent(data.subject) + (withBody ? '&body=' + encodeURIComponent(body) : '')
      );
    }

    function gmailUrl(withBody: boolean): string {
      return (
        'https://mail.google.com/mail/?view=cm&fs=1&tf=1&su=' +
        encodeURIComponent(data.subject) +
        (withBody ? '&body=' + encodeURIComponent(data.text) : '')
      );
    }

    let busy = false;
    async function sendVia(kind: 'mailto' | 'gmail'): Promise<void> {
      if (busy) return;
      busy = true;
      try {
        const copied = await copyCard();
        showToast(copied ? data.ui.copied : data.ui.copyFailed, !copied, 8000);
        if (kind === 'gmail') {
          const url = gmailUrl(!copied);
          const win = window.open(url, '_blank');
          if (win) {
            try {
              win.opener = null;
            } catch {
              /* ya navegó a otro origen */
            }
          } else {
            window.location.href = url; // ventana emergente bloqueada
          }
        } else {
          window.location.href = mailtoUrl(!copied);
        }
      } finally {
        busy = false;
      }
    }

    document.getElementById('sendMailBtn')?.addEventListener('click', () => void sendVia('mailto'));
    document.getElementById('sendGmailBtn')?.addEventListener('click', () => void sendVia('gmail'));

    document.getElementById('copyTextBtn')?.addEventListener('click', async () => {
      const ok = await copyText(data.text);
      showToast(ok ? data.ui.textOk : data.ui.textFail, !ok);
    });
  </script>
</Layout>
