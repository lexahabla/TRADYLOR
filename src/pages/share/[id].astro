---
/**
 * ==============================================================================
 * TRADYLOR — "A MI CORREO": TARJETA DEL PRODUCTO PARA ENVIARTE POR EMAIL
 * ==============================================================================
 *
 * Ruta dinámica SSR: /share/[id]?lang=xx
 *
 * Se llega desde la opción "A mi correo" del panel de compartir. Muestra la tarjeta del
 * producto (mensaje, título, imagen y botón "Ver la ficha del producto" que lleva a
 * https://tradylor.com/producto/<slug>), el selector de idioma y UN solo botón:
 * "Enviar a {tu correo}". Al pulsarlo, POST /api/share/email manda la tarjeta a la
 * dirección de la cuenta del usuario y desde su bandeja la reenvía a quien quiera.
 *
 * Sin sesión no se sabe a qué correo enviarla: se pide iniciar sesión (y la página se
 * recarga sola al terminar). El destinatario nunca sale de esta página: lo decide el
 * servidor a partir de la sesión.
 *
 * El idioma se pasa como query param (?lang=ca) porque la página es SSR y no puede leer
 * localStorage en el servidor. El selector se completa en el cliente con los idiomas
 * cooficiales de la región (navegador + IP, /api/share/region).
 * ==============================================================================
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { findCatalogProduct, productKey } from '../../lib/catalog';
import { getRadarSessionUser } from '../../lib/radarAuth';
import { langsFromAcceptLanguage } from '../../lib/shareGeo';
import {
  buildProductPageUrl,
  buildShareText,
  getShareLangOptions,
  SHARE_LANG_CODES,
  type ShareLangCode,
} from '../../utils/share';
import { buildShareEmailHtml, cleanShareTitle } from '../../utils/shareEmail';

const product = findCatalogProduct(Astro.params.id);
if (!product) return Astro.redirect('/', 302);

// La página depende de la sesión (muestra el correo del usuario): nunca se cachea.
Astro.response.headers.set('Cache-Control', 'no-store');
const user = getRadarSessionUser(Astro.request);

const key = productKey(product);

// Idioma desde query param (lo pasa el panel de compartir al abrir la página).
// Se valida contra SHARE_LANG_CODES (lista fija).
const langParam = (Astro.url.searchParams.get('lang') ?? '').trim().toLowerCase() as ShareLangCode;
const lang: ShareLangCode = SHARE_LANG_CODES.includes(langParam) ? langParam : 'es';

// Enlace a la ficha individual del producto en tradylor.com.
const productUrl = buildProductPageUrl(key);
const rawMessage = buildShareText(
  'email',
  { productId: key, title: product.title, category: product.category },
  productUrl,
  lang,
);
// El enlace va en el botón "Ver la ficha del producto", no repetido dentro del mensaje.
const message = rawMessage.replace(productUrl, '').replace(/\s+/g, ' ').trim();
const absoluteImage = /^https?:\/\//i.test(product.image)
  ? product.image
  : new URL(product.image, Astro.site ?? 'https://tradylor.com').href;

const cleanTitle = cleanShareTitle(product.title);

// Tarjeta del correo: se pinta tal cual en la vista previa y es la que recibe el usuario.
const emailHtml = buildShareEmailHtml({
  message,
  title: cleanTitle,
  category: product.category,
  imageUrl: absoluteImage,
  ctaUrl: productUrl,
  lang,
});

// Selector de idioma (SSR): el idioma activo + los cooficiales que declara la
// cabecera Accept-Language. El cliente lo completa con la región por IP.
const headerLangs = langsFromAcceptLanguage(Astro.request.headers.get('accept-language'));
const langOptions = getShareLangOptions([lang, ...headerLangs]);

interface ShareUiStrings {
  hint: string;
  sendTo: string;
  sending: string;
  /** {email} se sustituye por el correo de la cuenta. */
  sent: string;
  loginTitle: string;
  loginText: string;
  login: string;
  errAuth: string;
  errRate: string;
  errSmtp: string;
  errGeneric: string;
}

// Textos de UI según idioma
const UI: Record<ShareLangCode, ShareUiStrings> = {
  es: {
    hint: 'Esta es la tarjeta que te enviaremos a tu correo. Desde tu bandeja podrás reenviarla a quien quieras.',
    sendTo: 'Enviar a',
    sending: 'Enviando…',
    sent: 'Tarjeta enviada a {email}. Revisa tu bandeja de entrada (y la carpeta de spam).',
    loginTitle: 'Inicia sesión para recibirla en tu correo',
    loginText: 'Te la enviamos a la dirección de tu cuenta de Mi Radar y desde ahí podrás reenviarla a quien quieras.',
    login: 'Iniciar sesión',
    errAuth: 'Tu sesión ha caducado. Inicia sesión de nuevo.',
    errRate: 'Has enviado muchas tarjetas seguidas. Inténtalo de nuevo más tarde.',
    errSmtp: 'El envío por correo no está disponible ahora mismo. Inténtalo más tarde.',
    errGeneric: 'No se pudo enviar la tarjeta. Inténtalo de nuevo.',
  },
  ca: {
    hint: "Aquesta és la targeta que t'enviarem al teu correu. Des de la teva safata podràs reenviar-la a qui vulguis.",
    sendTo: 'Enviar a',
    sending: "S'està enviant…",
    sent: "Targeta enviada a {email}. Revisa la safata d'entrada (i la carpeta de correu brossa).",
    loginTitle: 'Inicia la sessió per rebre-la al teu correu',
    loginText: "Te l'enviem a l'adreça del teu compte de Mi Radar i des d'allà podràs reenviar-la a qui vulguis.",
    login: 'Iniciar sessió',
    errAuth: "La teva sessió ha caducat. Inicia la sessió de nou.",
    errRate: 'Has enviat moltes targetes seguides. Prova-ho de nou més tard.',
    errSmtp: "L'enviament per correu no està disponible ara mateix. Prova-ho més tard.",
    errGeneric: "No s'ha pogut enviar la targeta. Prova-ho de nou.",
  },
  eu: {
    hint: 'Hau da zure postara bidaliko dizugun txartela. Zure sarrera-ontzitik nahi duzunari birbidal diezaiokezu.',
    sendTo: 'Bidali hona:',
    sending: 'Bidaltzen…',
    sent: 'Txartela bidali da: {email}. Begiratu zure sarrera-ontzia (eta spam karpeta).',
    loginTitle: 'Hasi saioa zure postan jasotzeko',
    loginText: 'Zure Mi Radar kontuaren helbidera bidaliko dizugu eta handik nahi duzunari birbidal diezaiokezu.',
    login: 'Hasi saioa',
    errAuth: 'Zure saioa iraungi da. Hasi saioa berriro.',
    errRate: 'Txartel asko bidali dituzu segidan. Saiatu berriro geroago.',
    errSmtp: 'Posta bidezko bidalketa ez dago eskuragarri orain. Saiatu geroago.',
    errGeneric: 'Ezin izan da txartela bidali. Saiatu berriro.',
  },
  gl: {
    hint: 'Esta é a tarxeta que che enviaremos ao teu correo. Desde a túa caixa de entrada poderás reenviala a quen queiras.',
    sendTo: 'Enviar a',
    sending: 'Enviando…',
    sent: 'Tarxeta enviada a {email}. Revisa a caixa de entrada (e o cartafol de spam).',
    loginTitle: 'Inicia sesión para recibila no teu correo',
    loginText: 'Envíámola ao enderezo da túa conta de Mi Radar e desde aí poderás reenviala a quen queiras.',
    login: 'Iniciar sesión',
    errAuth: 'A túa sesión caducou. Inicia sesión de novo.',
    errRate: 'Enviaches moitas tarxetas seguidas. Inténtao de novo máis tarde.',
    errSmtp: 'O envío por correo non está dispoñible agora mesmo. Inténtao máis tarde.',
    errGeneric: 'Non se puido enviar a tarxeta. Inténtao de novo.',
  },
  en: {
    hint: "This is the card we'll send to your email. From your inbox you can forward it to anyone you like.",
    sendTo: 'Send to',
    sending: 'Sending…',
    sent: 'Card sent to {email}. Check your inbox (and your spam folder).',
    loginTitle: 'Sign in to receive it in your email',
    loginText: "We send it to the address of your Mi Radar account, and from there you can forward it to anyone you like.",
    login: 'Sign in',
    errAuth: 'Your session has expired. Please sign in again.',
    errRate: "You've sent many cards in a row. Please try again later.",
    errSmtp: 'Sending by email is not available right now. Please try again later.',
    errGeneric: "Couldn't send the card. Please try again.",
  },
  fr: {
    hint: "Voici la carte que nous enverrons à votre adresse e-mail. Depuis votre boîte de réception, vous pourrez la transférer à qui vous voulez.",
    sendTo: 'Envoyer à',
    sending: 'Envoi…',
    sent: 'Carte envoyée à {email}. Vérifiez votre boîte de réception (et le dossier spam).',
    loginTitle: 'Connectez-vous pour la recevoir par e-mail',
    loginText: "Nous l'envoyons à l'adresse de votre compte Mi Radar, et vous pourrez la transférer à qui vous voulez.",
    login: 'Se connecter',
    errAuth: 'Votre session a expiré. Reconnectez-vous.',
    errRate: 'Vous avez envoyé beaucoup de cartes à la suite. Réessayez plus tard.',
    errSmtp: "L'envoi par e-mail n'est pas disponible pour le moment. Réessayez plus tard.",
    errGeneric: "Impossible d'envoyer la carte. Réessayez.",
  },
  de: {
    hint: 'Das ist die Karte, die wir an deine E-Mail-Adresse senden. Aus deinem Posteingang kannst du sie an jeden weiterleiten.',
    sendTo: 'Senden an',
    sending: 'Wird gesendet…',
    sent: 'Karte an {email} gesendet. Sieh in deinem Posteingang (und im Spam-Ordner) nach.',
    loginTitle: 'Melde dich an, um sie per E-Mail zu erhalten',
    loginText: 'Wir senden sie an die Adresse deines Mi-Radar-Kontos, und von dort kannst du sie an jeden weiterleiten.',
    login: 'Anmelden',
    errAuth: 'Deine Sitzung ist abgelaufen. Bitte melde dich erneut an.',
    errRate: 'Du hast viele Karten hintereinander gesendet. Bitte versuche es später erneut.',
    errSmtp: 'Der E-Mail-Versand ist gerade nicht verfügbar. Bitte versuche es später erneut.',
    errGeneric: 'Die Karte konnte nicht gesendet werden. Bitte versuche es erneut.',
  },
  pt: {
    hint: 'Este é o cartão que vamos enviar para o teu email. A partir da tua caixa de entrada podes reencaminhá-lo a quem quiseres.',
    sendTo: 'Enviar para',
    sending: 'A enviar…',
    sent: 'Cartão enviado para {email}. Verifica a caixa de entrada (e a pasta de spam).',
    loginTitle: 'Inicia sessão para o receberes no teu email',
    loginText: 'Enviamo-lo para o endereço da tua conta Mi Radar e daí podes reencaminhá-lo a quem quiseres.',
    login: 'Iniciar sessão',
    errAuth: 'A tua sessão expirou. Inicia sessão de novo.',
    errRate: 'Enviaste muitos cartões seguidos. Tenta de novo mais tarde.',
    errSmtp: 'O envio por email não está disponível neste momento. Tenta mais tarde.',
    errGeneric: 'Não foi possível enviar o cartão. Tenta novamente.',
  },
  it: {
    hint: 'Questa è la scheda che invieremo alla tua email. Dalla tua casella potrai inoltrarla a chi vuoi.',
    sendTo: 'Invia a',
    sending: 'Invio in corso…',
    sent: 'Scheda inviata a {email}. Controlla la posta in arrivo (e la cartella spam).',
    loginTitle: 'Accedi per riceverla via email',
    loginText: "Te la inviamo all'indirizzo del tuo account Mi Radar e da lì potrai inoltrarla a chi vuoi.",
    login: 'Accedi',
    errAuth: 'La tua sessione è scaduta. Accedi di nuovo.',
    errRate: 'Hai inviato molte schede di seguito. Riprova più tardi.',
    errSmtp: "L'invio per email non è disponibile in questo momento. Riprova più tardi.",
    errGeneric: 'Impossibile inviare la scheda. Riprova.',
  },
};
const ui = UI[lang] ?? UI.es;

// Datos para el script del cliente (JSON inerte: no se ejecuta, sólo se lee).
const clientData = {
  lang,
  productId: key,
  email: user?.email ?? '',
  ui: {
    sendTo: ui.sendTo,
    sending: ui.sending,
    sent: ui.sent,
    errAuth: ui.errAuth,
    errRate: ui.errRate,
    errSmtp: ui.errSmtp,
    errGeneric: ui.errGeneric,
  },
};
const clientJson = JSON.stringify(clientData).replace(/</g, '\\u003c');
---

<Layout
  title={`A mi correo: ${cleanTitle} | Tradylor`}
  description="Recibe en tu correo la tarjeta de este producto para reenviarla a quien quieras."
  noindex={true}
>
  <div class="share-preview-page">
    <div class="share-preview-container">
      <header class="share-header">
        <div class="share-logo">
          <span class="logo-mark">T</span>
          <span class="logo-text">Tradylor</span>
        </div>
        <p class="share-hint">{ui.hint}</p>

        <!-- Selector de idioma (el cliente lo completa con los idiomas de la región) -->
        <div class="lang-bar" data-lang-bar role="group" aria-label="Idioma">
          {langOptions.map((opt) => (
            <button
              type="button"
              class={`lang-btn${opt.code === lang ? ' is-active' : ''}`}
              data-page-lang={opt.code}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </header>

      <!-- Tarjeta del correo: es exactamente la que llegará a tu bandeja -->
      <div class="email-preview" id="emailCard" set:html={emailHtml} />

      {user ? (
        <div class="share-actions">
          <!-- Único botón: envía la tarjeta al correo de la cuenta -->
          <button type="button" class="share-btn share-btn-mail" id="sendToMeBtn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5.5" width="18" height="13" rx="2.5"/>
              <path d="m4.5 8 7.5 5 7.5-5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="share-btn-label">{ui.sendTo} <strong class="share-email">{user.email}</strong></span>
          </button>
        </div>
      ) : (
        <section class="share-login" data-share-login>
          <p class="share-login-title">{ui.loginTitle}</p>
          <p class="share-login-text">{ui.loginText}</p>
          <button type="button" class="share-btn share-btn-mail" data-open-auth="login">{ui.login}</button>
        </section>
      )}

      <div class="share-toast" id="shareToast" role="status" aria-live="polite"></div>
    </div>
  </div>

  <style>
    .share-preview-page {
      min-height: 100vh;
      background: linear-gradient(135deg, #0a0e17 0%, #111827 50%, #0a0e17 100%);
      padding: 2rem 1rem;
    }
    /* 600 px = ancho de la tarjeta del correo: vista previa y botón alineados */
    .share-preview-container { max-width: 600px; margin: 0 auto; }
    .share-header { text-align: center; margin-bottom: 2rem; }
    .share-logo { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: .75rem; }
    .logo-mark {
      display: inline-flex; align-items: center; justify-content: center;
      width: 36px; height: 36px; border-radius: 10px;
      background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
      color: #0d1422; font-weight: 800; font-size: 1.1rem; font-family: 'Outfit', sans-serif;
    }
    .logo-text { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.25rem; color: #f3f4f6; }
    .share-hint { font-size: .82rem; color: #9ca3af; max-width: 440px; margin: 0 auto .9rem; line-height: 1.5; }

    /* Los botones de idioma se (re)generan en el cliente: de ahí :global() */
    .lang-bar {
      display: inline-flex; gap: .3rem; padding: .28rem;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.09);
      border-radius: 999px; flex-wrap: wrap; justify-content: center;
    }
    .lang-bar :global(.lang-btn) {
      padding: .32rem .7rem; font-family: inherit; font-size: .72rem; font-weight: 700;
      color: #9ca3af; background: transparent; border: 1px solid transparent;
      border-radius: 999px; cursor: pointer; transition: .16s; white-space: nowrap;
    }
    .lang-bar :global(.lang-btn:hover) { color: #e5e7eb; background: rgba(255,255,255,.07); }
    .lang-bar :global(.lang-btn.is-active) {
      color: #0d1422; background: linear-gradient(135deg,#60a5fa 0%,#3b82f6 100%);
      border-color: rgba(96,165,250,.6); box-shadow: 0 3px 10px rgba(59,130,246,.35);
    }

    /* Vista previa: el diseño de la tarjeta va inline en el propio HTML del correo */
    .email-preview {
      margin-bottom: 1.5rem; border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.06);
    }
    /* Botón "Ver la ficha del producto": manita + efecto al pasar el ratón (sólo en la
       vista previa; en el correo el cursor y el clic los gestiona el cliente de correo). */
    .email-preview :global(.tz-cta) { cursor: pointer; transition: filter .15s ease, transform .15s ease, box-shadow .15s ease; }
    .email-preview :global(.tz-cta:hover) { filter: brightness(1.08); transform: translateY(-1px); box-shadow: 0 6px 18px rgba(59,130,246,.45); }
    .email-preview :global(.tz-cta:active) { transform: translateY(0); box-shadow: none; }
    .email-preview :global(.tz-cta:focus-visible) { outline: 2px solid #1d4ed8; outline-offset: 2px; }

    .share-actions { display: flex; }
    .share-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .6rem; width: 100%;
      padding: .9rem 1.25rem; border-radius: 10px; font-weight: 700; font-size: .95rem; line-height: 1.35;
      font-family: 'Inter', sans-serif; cursor: pointer; border: none; text-decoration: none; transition: .18s;
    }
    .share-btn svg { flex-shrink: 0; }
    .share-btn:disabled { opacity: .7; cursor: progress; }
    .share-btn-mail {
      background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
      color: #ffffff; box-shadow: 0 4px 16px rgba(124,58,237,.35);
    }
    .share-btn-mail:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(124,58,237,.55); }
    .share-btn-mail:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 3px; }
    /* El correo puede ser largo: se parte en vez de desbordar el botón */
    .share-btn-label { min-width: 0; text-align: left; }
    .share-email { font-weight: 800; overflow-wrap: anywhere; }

    /* Sin sesión: no se sabe a qué correo enviarla */
    .share-login {
      padding: 1.25rem 1.4rem 1.4rem; text-align: center;
      background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: 14px;
    }
    .share-login-title { margin: 0 0 .35rem; font-size: 1rem; font-weight: 800; color: #f3f4f6; }
    .share-login-text { margin: 0 0 1rem; font-size: .82rem; line-height: 1.55; color: #9ca3af; }
    .share-login .share-btn { width: auto; min-width: 200px; }

    .share-toast {
      position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%) translateY(20px);
      width: max-content; max-width: min(92vw, 520px); text-align: center; line-height: 1.45;
      background: rgba(13,20,34,.97); color: #f3f4f6; border: 1px solid rgba(255,255,255,.14);
      padding: .7rem 1.2rem; border-radius: 16px; font-size: .82rem; font-weight: 600;
      opacity: 0; pointer-events: none; transition: .25s; z-index: 999;
    }
    .share-toast.is-on { opacity: 1; transform: translateX(-50%) translateY(0); }
    .share-toast.is-error { border-color: rgba(248,113,113,.6); color: #fca5a5; }

    @media (max-width: 520px) {
      .share-login .share-btn { width: 100%; }

      /* En móvil el bloque de producto de la vista previa se apila: imagen arriba y
         texto centrado debajo (ganchos tz-* de utils/shareEmail.ts). */
      .email-preview :global(.tz-prod),
      .email-preview :global(.tz-prod tbody),
      .email-preview :global(.tz-prod tr),
      .email-preview :global(.tz-prod td) { display: block !important; width: auto !important; }
      .email-preview :global(.tz-gap) { display: none !important; }
      .email-preview :global(.tz-img) { padding-bottom: 16px; }
      .email-preview :global(.tz-img > div) { margin: 0 auto; }
      .email-preview :global(.tz-txt) { text-align: center; }
    }
  </style>

  <script type="application/json" id="share-data" set:html={clientJson}></script>

  <script>
    import { getShareLangOptions, refreshRegionLangs, setShareLang } from '../../utils/share';
    import type { ShareLangCode } from '../../utils/share';

    interface ShareData {
      lang: ShareLangCode;
      productId: string;
      /** Correo de la cuenta (vacío si no hay sesión). */
      email: string;
      ui: { sendTo: string; sending: string; sent: string; errAuth: string; errRate: string; errSmtp: string; errGeneric: string };
    }

    const data = JSON.parse(document.getElementById('share-data')?.textContent || '{}') as ShareData;

    // La página recuerda el idioma que se está viendo (el panel de compartir lo reutiliza).
    setShareLang(data.lang);

    // ---- Selector de idioma: idiomas cooficiales de la región + es + en ----
    const bar = document.querySelector<HTMLElement>('[data-lang-bar]');

    function renderLangBar(): void {
      if (!bar) return;
      bar.innerHTML = getShareLangOptions([data.lang])
        .map(
          (opt) =>
            `<button type="button" class="lang-btn${opt.code === data.lang ? ' is-active' : ''}" data-page-lang="${opt.code}">${opt.label}</button>`,
        )
        .join('');
    }

    // Cambiar de idioma = recargar con ?lang=xx (la tarjeta se genera en el servidor).
    bar?.addEventListener('click', (event) => {
      const btn = (event.target as Element | null)?.closest<HTMLElement>('[data-page-lang]');
      const code = btn?.dataset.pageLang as ShareLangCode | undefined;
      if (!code || code === data.lang) return;
      setShareLang(code);
      window.location.search = '?lang=' + encodeURIComponent(code);
    });

    renderLangBar();
    // Región del visitante (IP): añade catalán / euskera / gallego aunque el
    // navegador esté en castellano. El resultado se cachea varios días.
    void refreshRegionLangs().then((langs) => {
      if (langs.length) renderLangBar();
    });

    // ---- Toast ----
    let toastTimer: number | undefined;
    function showToast(message: string, isError = false, ms = 6000): void {
      const toast = document.getElementById('shareToast');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.toggle('is-error', isError);
      toast.classList.add('is-on');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), ms);
    }

    // ---- Enviar la tarjeta al correo de la cuenta ----
    const sendBtn = document.getElementById('sendToMeBtn') as HTMLButtonElement | null;
    sendBtn?.addEventListener('click', async () => {
      if (sendBtn.disabled) return;
      const label = sendBtn.querySelector<HTMLElement>('.share-btn-label');
      const original = label?.innerHTML ?? '';
      sendBtn.disabled = true;
      if (label) label.textContent = data.ui.sending;
      try {
        const res = await fetch('/api/share/email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId: data.productId, lang: data.lang }),
        });
        const out = (await res.json().catch(() => ({}))) as { ok?: boolean };
        if (res.ok && out.ok) {
          showToast(data.ui.sent.replace('{email}', data.email));
        } else if (res.status === 401) {
          showToast(data.ui.errAuth, true);
          window.setTimeout(() => window.location.reload(), 2200);
        } else if (res.status === 429) {
          showToast(data.ui.errRate, true);
        } else if (res.status === 503) {
          showToast(data.ui.errSmtp, true);
        } else {
          showToast(data.ui.errGeneric, true);
        }
      } catch {
        showToast(data.ui.errGeneric, true);
      } finally {
        if (label) label.innerHTML = original;
        // Una pausa corta evita el doble clic accidental (el servidor además limita los envíos).
        window.setTimeout(() => {
          sendBtn.disabled = false;
        }, 1500);
      }
    });

    // Sin sesión: el modal de acceso, al terminar, normalmente lleva a la portada. Esta página
    // pide quedarse (data-auth-stay en <body>): el modal la recarga con el botón de envío y el
    // mismo ?lang=, así el usuario no pierde la tarjeta.
    document.body.setAttribute('data-auth-stay', '');
  </script>
</Layout>
