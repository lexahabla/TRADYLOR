---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryMenu from '../components/CategoryMenu.astro';
import HeroSearchRadar from '../components/HeroSearchRadar.astro';
import TrustMetrics from '../components/common/TrustMetrics.astro';
import { getCatalogProducts } from '../lib/catalog';
import { readSections } from '../lib/sections';
import { getCategoryById } from '../lib/categories';

export const prerender = false;

const allProducts = getCatalogProducts();

// Secciones creadas dinámicamente desde el panel (publicadas)
const publishedSections = (readSections() || [])
  .filter((s) => s.published)
  .sort((a, b) => a.order - b.order)
  .map((s) => ({
    ...s,
    products: s.productIds.map((id) => allProducts.find((p) => p.id === id)).filter(Boolean),
  }))
  .filter((s) => s.products.length > 0);

const categoryParam = (Astro.url.searchParams.get('category') ?? '').toLowerCase().trim();
const activeCategory = categoryParam ? getCategoryById(categoryParam) ?? null : null;

const categoryMatches = (productCategory: string, slug: string) =>
  getCategoryById(productCategory)?.slug === slug;

const visibleProducts = activeCategory
  ? allProducts.filter((p) => categoryMatches(String(p.category ?? ''), activeCategory.slug))
  : allProducts;

const pageHref = (page: number) =>
  `/?${activeCategory ? `category=${encodeURIComponent(activeCategory.slug)}&` : ''}page=${page}#catalogo`;

// ─── Recommendation Score: rating(60%) + reviews(30%) + discount(10%) ───────
const scoreOf = (p: typeof allProducts[0]) => {
  const ratingScore = (p.rating ?? 0) / 5;
  const reviewScore = Math.min(Math.log10((p.reviewsCount ?? 0) + 1) / 4, 1);
  const discountScore = p.originalPrice && p.originalPrice > p.price
    ? ((p.originalPrice - p.price) / p.originalPrice)
    : 0;
  return ratingScore * 0.6 + reviewScore * 0.3 + discountScore * 0.1;
};

const sorted = [...visibleProducts].sort((a, b) => scoreOf(b) - scoreOf(a));

// ─── Top ofertas: mayor descuento real (para el carrusel del hero) ──────────
const discountRatioOf = (p: typeof allProducts[0]) =>
  p.originalPrice && p.originalPrice > p.price
    ? (p.originalPrice - p.price) / p.originalPrice
    : 0;

const dealProducts = allProducts
  .filter((p) => discountRatioOf(p) > 0)
  .sort((a, b) => discountRatioOf(b) - discountRatioOf(a) || scoreOf(b) - scoreOf(a))
  .slice(0, 10);

// ─── Pagination for "Todos los Productos" ────────────────────────────────────
const PRODUCTS_PER_PAGE = 12;
const pageParam = Astro.url.searchParams.get('page');
const totalPages = Math.max(1, Math.ceil(sorted.length / PRODUCTS_PER_PAGE));
const requestedPage = parseInt(pageParam ?? '1', 10) || 1;
const currentPage = Math.min(Math.max(1, requestedPage), totalPages);
const paginatedProducts = sorted.slice(
  (currentPage - 1) * PRODUCTS_PER_PAGE,
  currentPage * PRODUCTS_PER_PAGE
);

const pageTitle = "Tradylor | Portal de Curación, Análisis y Ofertas Verificadas";
const pageDescription = "Descubre las mejores selecciones y comparativas de producto. Análisis honestos, pros y contras objetivos y enlaces de compra verificados con las mejores ofertas.";

const formatCurrency = (amount: number) =>
  new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 }).format(amount);

const totalSavings = allProducts.reduce(
  (acc, p) => (p.originalPrice && p.originalPrice > p.price ? acc + (p.originalPrice - p.price) : acc),
  0
);
const showSavingsMetric = totalSavings >= 5000;
const savingsDisplay = `+${new Intl.NumberFormat('es-ES', {
  style: 'currency',
  currency: 'EUR',
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
}).format(Math.round(totalSavings))}`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- ============================================================
       1. SECCIÓN CATÁLOGO COMPLETO: Todos los Productos (paginado)
       ============================================================ -->
  <section class="catalog-section" id="catalogo">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">Catálogo Completo</div>
        <h2 class="section-title">Todos los Productos Analizados</h2>
        <p class="section-desc">
          Explora nuestra selección completa ordenada por puntuación de recomendación. {sorted.length} productos verificados y en constante actualización.
        </p>
        {activeCategory && (
          <p class="filter-note">
            Filtrando por <strong>{activeCategory.name}</strong> · <a href="/">Ver todo el catálogo</a>
          </p>
        )}
      </div>

      <div class="products-grid">
        {sorted.length === 0 ? (
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">🔍</span>
            <p>No hay productos disponibles en «{activeCategory?.name}» todavía.</p>
            <a href="/">Ver todo el catálogo</a>
          </div>
        ) : paginatedProducts.map((item) => (
          <ProductCard product={item} />
        ))}
      </div>

      <!-- Pagination -->
      {totalPages > 1 && (
        <nav class="pagination" aria-label="Paginación de productos">
          {currentPage > 1 && (
            <a href={pageHref(currentPage - 1)} class="page-btn page-prev">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="15 18 9 12 15 6" />
              </svg>
              Anterior
            </a>
          )}

          <div class="page-numbers">
            {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
              <a
                href={pageHref(page)}
                class:list={['page-num', { active: page === currentPage }]}
                aria-label={`Página ${page}`}
                aria-current={page === currentPage ? 'page' : undefined}
              >
                {page}
              </a>
            ))}
          </div>

          {currentPage < totalPages && (
            <a href={pageHref(currentPage + 1)} class="page-btn page-next">
              Siguiente
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          )}
        </nav>
      )}
    </div>
  </section>

  <!-- ============================================================
       2. HERO SECTION: Propuesta de Valor Estratégica (bajo el catálogo)
       ============================================================ -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Curación de Productos & Análisis Independientes</span>
      </div>

      <h1 class="hero-title">
        Filtramos el ruido del mercado.<br />
        <span class="gradient-text">Solo recomendamos lo que vale la pena comprar.</span>
      </h1>

      <p class="hero-subtitle">
        En Tradylor desarmamos las campañas de marketing engañosas. Analizamos a fondo especificaciones, fiabilidad y relación calidad-precio para que ahorres tiempo, dinero y tomas decisiones de compra 100% acertadas.
      </p>
    </div>

    <!-- Panel de ofertas/asistente: a ancho completo de la página (fuera del container) -->
    <HeroSearchRadar deals={dealProducts} />

    <div class="container hero-container">
      <!-- Badges de Autoridad E-E-A-T -->
      <div class="hero-trust-metrics">
        <div class="metric-item">
          <span class="metric-number">+500h</span>
          <span class="metric-label">De análisis y pruebas de producto</span>
        </div>
        {showSavingsMetric && (
          <>
            <div class="metric-divider"></div>
            <div class="metric-item">
              <span class="metric-number">{savingsDisplay}</span>
              <span class="metric-label">Ahorrado a nuestros usuarios</span>
            </div>
          </>
        )}
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-number">24/7</span>
          <span class="metric-label">Monitoreo activo de bajadas de precio</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       4. METODOLOGÍA TEST & PROOF
       ============================================================ -->
  <section class="proof-section" id="test-proof">
    <div class="container">
      <div class="section-header center">
        <div class="section-tag">Metodología Test &amp; Proof</div>
        <h2 class="section-title">Análisis que puedes verificar</h2>
        <p class="section-desc max-700">
          Cada recomendación está respaldada por tres pilares de análisis riguroso. Sin tests reales, sin datos medibles o con costes ocultos: no se publica.
        </p>
      </div>

      <div class="proof-grid">
        <div class="proof-card">
          <div class="proof-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="proof-title">Pruebas de estrés en real</h3>
          <p class="proof-text">
            Tests de rendimiento sostenido, latencia y uso intensivo durante semanas. Validamos el comportamiento real, no especificaciones de laboratorio.
          </p>
          <div class="proof-data">
            <span class="proof-data-value">+{allProducts.reduce((acc, p) => acc + (p.investigation?.hoursInvestigated ?? 10), 0)}h</span>
            <span class="proof-data-label">De tests acumulados en catálogo</span>
          </div>
        </div>

        <div class="proof-card">
          <div class="proof-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="proof-title">Desglose de costes ocultos</h3>
          <p class="proof-text">
            Analizamos suscripciones obligatorias, consumibles, compatibilidad y TCO a 3 años. Si un producto tiene costes ocultos, lo destacamos.
          </p>
          <div class="proof-data">
            <span class="proof-data-value">0€</span>
            <span class="proof-data-label">Costes ocultos en productos recomendados</span>
          </div>
        </div>

        <div class="proof-card">
          <div class="proof-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="proof-title">Auditorías periódicas</h3>
          <p class="proof-text">
            Revisión trimestral de precios, actualizaciones de firmware, nuevas opiniones y alternativas emergentes. Lo que era bueno ayer, puede no serlo hoy.
          </p>
          <div class="proof-data">
            <span class="proof-data-value">{allProducts.length}</span>
            <span class="proof-data-label">Productos bajo vigilancia activa</span>
          </div>
        </div>
      </div>

      <div class="proof-cta">
        <a href="/metodologia" class="proof-btn">
          Descubre la metodología completa
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5. SECCIÓN E-E-A-T: Por Qué Confiar en Tradylor
       ============================================================ -->
  <section class="trust-section" id="metodologia">
    <div class="container">
      <div class="section-header center">
        <div class="section-tag">Nuestra Promesa Editorial</div>
        <h2 class="section-title">¿Por qué confiar en las recomendaciones de Tradylor?</h2>
        <p class="section-desc max-600">
          Internet está plagado de listas generadas automáticamente sin criterio. Tradylor nació para devolver la sensatez a las decisiones de compra en línea.
        </p>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="pillar-title">Curación Técnica Implacable</h3>
          <p class="pillar-text">
            No listamos catálogos enteros. Descartamos el 90% de los productos que evaluamos y solo publicamos los que superan nuestros estándares de durabilidad y satisfacción real.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="pillar-title">Cero Patrocinios Encubiertos</h3>
          <p class="pillar-text">
            Ninguna marca puede pagar por figurar en nuestras guías ni por alterar nuestros veredictos. Nuestra única lealtad es con el lector que busca comprar con seguridad.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="pillar-title">Monitoreo de Precios Reales</h3>
          <p class="pillar-text">
            Comparamos históricos de ofertas para avisarte cuando una rebaja es genuina y cuándo se trata de una oferta inflada artificialmente por los algoritmos de las tiendas.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="pillar-title">Transparencia Radical en Afiliación</h3>
          <p class="pillar-text">
            Explicamos con total claridad cómo se financia este portal. Cuando compras a través de nuestros botones oficiales, la tienda nos abona una comisión sin cobrarte un céntimo de más.
          </p>
        </div>
      </div>

      <div class="trust-metrics-wrap">
        <TrustMetrics />
      </div>
    </div>
  </section>

  <!-- ============================================================
       6. SECCIÓN GUÍA DE COMPRA RÁPIDA: CRO Boost
       ============================================================ -->
  <section class="guide-banner-section" id="comparativas">
    <div class="container">
      <div class="guide-banner-card">
        <div class="guide-text">
          <span class="banner-badge">Guía Express</span>
          <h3 class="banner-heading">¿No tienes claro cuál elegir?</h3>
          <p class="banner-sub">
            Aplica nuestra regla de oro: prioriza productos con garantía directa del fabricante, disponibilidad inmediata de repuestos y un mínimo de 4.5 estrellas con más de 500 opiniones contrastadas.
          </p>
        </div>
        <div class="guide-action">
          <a href="#catalogo" class="guide-btn">Ver disponibilidad y tramitar</a>
        </div>
      </div>
    </div>
  </section>

  <CategoryMenu activeSlug={activeCategory?.slug} />

  {publishedSections.map((section) => (
    <section class="products-section" data-dynamic-section={section.id}>
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{section.title}</h2>
          {section.description && <p class="section-desc">{section.description}</p>}
        </div>
        <div class="products-grid">
          {section.products.map((item) => <ProductCard product={item} />)}
        </div>
      </div>
    </section>
  ))}
</Layout>

<style>
  /* ============ DESIGN TOKENS & BASE ============ */
  :root {
    --gradient-primary: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
    --gradient-accent: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    --gradient-surface: linear-gradient(135deg, rgba(17, 24, 39, 0.8) 0%, rgba(30, 41, 59, 0.6) 100%);
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);
    --shadow-md: 0 8px 32px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.4);
    --shadow-glow-blue: 0 0 40px rgba(59, 130, 246, 0.2);
  }

  /* ============ HERO SECTION ============ */
  .hero-section {
    position: relative;
    padding: 0;
    background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
    overflow: hidden;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    animation: float 8s ease-in-out infinite;
  }

  .hero-section::after {
    content: '';
    position: absolute;
    bottom: -50%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    animation: float 10s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-30px); }
  }

  .hero-container {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #60a5fa;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    margin: 2rem 0;
    backdrop-filter: blur(8px);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: #3b82f6;
    border-radius: 50%;
    box-shadow: 0 0 12px #3b82f6;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7); }
    50% { box-shadow: 0 0 0 8px rgba(59, 130, 246, 0); }
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 950px;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, #ffffff 0%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gradient-text {
    background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 50%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 800px;
    margin-bottom: 3rem;
    line-height: 1.7;
    font-weight: 400;
  }

  /* ============ TRUST METRICS ============ */
  .hero-trust-metrics {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    background: var(--gradient-surface);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2rem 3rem;
    border-radius: 20px;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-md), var(--shadow-glow-blue);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .metric-number {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .metric-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }

  .metric-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, transparent 100%);
  }

  /* ============ PRODUCTS SECTION ============ */
  .products-section,
  .catalog-section {
    padding: 6rem 0;
  }

  .products-section {
    padding-top: 0;
  }

  .catalog-section {
    /* Es la primera sección de la página: respiración superior propia. */
    padding-top: 6rem;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-header.center {
    text-align: center;
    padding-top: 2rem;
  }

  .section-tag {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #3b82f6;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    display: inline-block;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .section-desc {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
    max-width: 700px;
    line-height: 1.7;
  }

  .section-header.center .section-desc {
    margin-left: auto;
    margin-right: auto;
  }

  .filter-note {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .filter-note strong {
    color: #60a5fa;
  }

  .filter-note a {
    color: #60a5fa;
    font-weight: 600;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    border-radius: 20px;
  }

  .empty-icon {
    font-size: 2rem;
  }

  .empty-state p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.05rem;
    margin: 0.75rem 0 1rem;
  }

  .empty-state a {
    color: #60a5fa;
