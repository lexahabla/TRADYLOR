---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import TrustMetrics from '../components/common/TrustMetrics.astro';
import TransparencyDashboard from '../components/TransparencyDashboard.astro';
import SmartMatcherWizard from '../components/SmartMatcherWizard.astro';
import { getCatalogProducts } from '../lib/catalog';
import { readSections } from '../lib/sections';
import { getCategoryById } from '../lib/categories';

export const prerender = false;

const allProducts = getCatalogProducts();

// Secciones creadas dinámicamente desde el panel (publicadas)
const publishedSections = (readSections() || [])
  .filter((s) => s.published)
  .sort((a, b) => a.order - b.order)
  .map((s) => ({
    ...s,
    position: s.position === 'above' ? 'above' : 'below',
    speed: s.speed || 'normal',
    products: s.productIds.map((id) => allProducts.find((p) => p.id === id)).filter(Boolean),
  }))
  .filter((s) => s.products.length > 0);

const aboveCatalogSections = publishedSections.filter((s) => s.position === 'above');
const belowCatalogSections = publishedSections.filter((s) => s.position !== 'above');

const categoryParam = (Astro.url.searchParams.get('category') ?? '').toLowerCase().trim();
const activeCategory = categoryParam ? getCategoryById(categoryParam) ?? null : null;

// Búsqueda del catalogo: ?q= (Enter o lupa en la barra fija #categoryBar).
const queryParam = (Astro.url.searchParams.get('q') ?? '').trim();
const queryTerm = queryParam.toLowerCase();

const categoryMatches = (productCategory: string, slug: string) =>
  getCategoryById(productCategory)?.slug === slug;

// Sin ?q= no hay filtro de texto: todo el catálogo es visible.
const matchesQuery = (p: typeof allProducts[number]) =>
  queryTerm.length === 0 ||
  [p.title, p.description, p.merchant, p.brand]
    .some((field) => String(field ?? '').toLowerCase().includes(queryTerm));

const visibleProducts = allProducts.filter((p) => {
  const byCategory = activeCategory
    ? categoryMatches(String(p.category ?? ''), activeCategory.slug)
    : true;
  return byCategory && matchesQuery(p);
});

const pageHref = (page: number) =>
  `/?${activeCategory ? `category=${encodeURIComponent(activeCategory.slug)}&` : ''}${queryTerm ? `q=${encodeURIComponent(queryParam)}&` : ''}page=${page}#catalogo`;

// ─── Recommendation Score: rating(60%) + reviews(30%) + discount(10%) ───────
const scoreOf = (p: typeof allProducts[0]) => {
  const ratingScore = (p.rating ?? 0) / 5;
  const reviewScore = Math.min(Math.log10((p.reviewsCount ?? 0) + 1) / 4, 1);
  const discountScore = p.originalPrice && p.originalPrice > p.price
    ? ((p.originalPrice - p.price) / p.originalPrice)
    : 0;
  return ratingScore * 0.6 + reviewScore * 0.3 + discountScore * 0.1;
};

const sorted = [...visibleProducts].sort((a, b) => scoreOf(b) - scoreOf(a));

// ─── Pagination for "Todos los Productos" ────────────────────────────────────
const PRODUCTS_PER_PAGE = 40;
const pageParam = Astro.url.searchParams.get('page');
const totalPages = Math.max(1, Math.ceil(sorted.length / PRODUCTS_PER_PAGE));
const requestedPage = parseInt(pageParam ?? '1', 10) || 1;
const currentPage = Math.min(Math.max(1, requestedPage), totalPages);
const paginatedProducts = sorted.slice(
  (currentPage - 1) * PRODUCTS_PER_PAGE,
  currentPage * PRODUCTS_PER_PAGE
);

// ─── Paginación compacta (estilo admin: 5 visibles + primera/última con …) ───
const buildPageRange = (current, total) => {
  const maxVisible = 5;
  let start = Math.max(1, current - Math.floor(maxVisible / 2));
  let end = Math.min(total, start + maxVisible - 1);
  if (end - start + 1 < maxVisible) {
    start = Math.max(1, end - maxVisible + 1);
  }
  const pages = [];
  if (start > 1) {
    pages.push(1);
    if (start > 2) pages.push('ellipsis');
  }
  for (let i = start; i <= end; i++) pages.push(i);
  if (end < total) {
    if (end < total - 1) pages.push('ellipsis');
    pages.push(total);
  }
  return pages;
};
const pageRange = buildPageRange(currentPage, totalPages);

const pageTitle = "Tradylor | Portal de Curación, Análisis y Ofertas Verificadas";
const pageDescription = "Descubre las mejores selecciones y comparativas de producto. Análisis honestos, pros y contras objetivos y enlaces de compra verificados con las mejores ofertas.";

const formatCurrency = (amount: number) =>
  new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 }).format(amount);

const totalSavings = allProducts.reduce(
  (acc, p) => (p.originalPrice && p.originalPrice > p.price ? acc + (p.originalPrice - p.price) : acc),
  0
);
const showSavingsMetric = totalSavings >= 5000;
const savingsDisplay = `+${new Intl.NumberFormat('es-ES', {
  style: 'currency',
  currency: 'EUR',
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
}).format(Math.round(totalSavings))}`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- ============================================================
       SECCIONES DINÁMICAS POR ENCIMA DEL CATÁLOGO (carrusel deslizable)
       ============================================================ -->
  {aboveCatalogSections.map((section) => (
    <section class="feed-section" data-dynamic-section={section.id} data-section-speed={section.speed || 'normal'} aria-label={section.title}>
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{section.title}</h2>
          {section.description && <p class="section-desc">{section.description}</p>}
        </div>
        <div class="feed-carousel">
          <button type="button" class="feed-carousel-btn feed-carousel-prev" data-carousel-prev aria-label="Anteriores">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
          </button>
          <div class="feed-carousel-track" data-carousel-track>
            {section.products.map((item) => <ProductCard product={item} layout="compact" />)}
          </div>
          <button type="button" class="feed-carousel-btn feed-carousel-next" data-carousel-next aria-label="Siguientes">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
          </button>
        </div>
      </div>
    </section>
  ))}

  <!-- ============================================================
       1. SECCIÓN CATÁLOGO COMPLETO: Todos los Productos (paginado)
       ============================================================ -->
  <section class="catalog-section" id="catalogo">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">Catálogo Completo</div>
        <h2 class="section-title">Todos los Productos Analizados</h2>
        <p class="section-desc">
          Explora nuestra selección completa ordenada por puntuación de recomendación. {sorted.length} productos verificados y en constante actualización.
        </p>
        {activeCategory && (
          <p class="filter-note">
            Filtrando por <strong>{activeCategory.name}</strong> · <a href="/">Ver todo el catálogo</a>
          </p>
        )}
        {queryTerm && (
          <p class="filter-note">
            Resultados para <strong>«{queryParam}»</strong> ({sorted.length}) ·{' '}
            <a href={activeCategory ? `/?category=${encodeURIComponent(activeCategory.slug)}#catalogo` : '/#catalogo'}>Quitar filtro</a>
          </p>
        )}
      </div>

      <div class="products-grid">
        {sorted.length === 0 ? (
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">🔍</span>
            <p>
              {queryParam
                ? <>No hay productos que coincidan con «{queryParam}»{activeCategory ? ` en «${activeCategory.name}»` : ''}.</>
                : activeCategory
                  ? <>No hay productos disponibles en «{activeCategory.name}» todavía.</>
                  : <>No hay productos disponibles todavía.</>}
            </p>
            <a href="/">Ver todo el catálogo</a>
          </div>
        ) : paginatedProducts.map((item) => (
          <ProductCard product={item} />
        ))}
      </div>

      <!-- Pagination -->
      {totalPages > 1 && (
        <nav class="pagination" aria-label="Paginación de productos">
          {currentPage > 1 && (
            <a href={pageHref(currentPage - 1)} class="page-btn page-prev">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="15 18 9 12 15 6" />
              </svg>
              Anterior
            </a>
          )}

          <div class="page-numbers">
            {pageRange.map((page) => (
              page === 'ellipsis' ? (
                <span class="page-ellipsis" aria-hidden="true">…</span>
              ) : (
                <a
                  href={pageHref(page)}
                  class:list={['page-num', { active: page === currentPage }]}
                  aria-label={`Página ${page}`}
                  aria-current={page === currentPage ? 'page' : undefined}
                >
                  {page}
                </a>
              )
            ))}
          </div>

          {currentPage < totalPages && (
            <a href={pageHref(currentPage + 1)} class="page-btn page-next">
              Siguiente
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          )}
        </nav>
      )}
    </div>
  </section>

  <!-- ============================================================
       2. HERO SECTION: Propuesta de Valor Estratégica (bajo el catálogo)
       ============================================================ -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Curación de Productos & Análisis Independientes</span>
      </div>

      <h1 class="hero-title">
        Filtramos el ruido del mercado.<br />
        <span class="gradient-text">Solo recomendamos lo que vale la pena comprar.</span>
      </h1>

      <p class="hero-subtitle">
        En Tradylor desarmamos las campañas de marketing engañosas. Analizamos a fondo especificaciones, fiabilidad y relación calidad-precio para que ahorres tiempo, dinero y tomas decisiones de compra 100% acertadas.
      </p>
    </div>

    <div class="container hero-container">
      <!-- Badges de Autoridad E-E-A-T -->
      <div class="hero-trust-metrics">
        <div class="metric-item">
          <span class="metric-number">+500h</span>
          <span class="metric-label">De análisis y pruebas de producto</span>
        </div>
        {showSavingsMetric && (
          <>
            <div class="metric-divider"></div>
            <div class="metric-item">
              <span class="metric-number">{savingsDisplay}</span>
              <span class="metric-label">Ahorrado a nuestros usuarios</span>
            </div>
          </>
        )}
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-number">24/7</span>
          <span class="metric-label">Monitoreo activo de bajadas de precio</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       4. METODOLOGÍA TEST & PROOF
       ============================================================ -->
  <section class="proof-section" id="test-proof">
    <div class="container">
      <div class="section-header center">
        <div class="section-tag">Metodología Test &amp; Proof</div>
        <h2 class="section-title">Análisis que puedes verificar</h2>
        <p class="section-desc max-700">
          Cada recomendación está respaldada por tres pilares de análisis riguroso. Sin tests reales, sin datos medibles o con costes ocultos: no se publica.
        </p>
      </div>

      <div class="proof-grid">
        <div class="proof-card">
          <div class="proof-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="proof-title">Pruebas de estrés en real</h3>
          <p class="proof-text">
            Tests de rendimiento sostenido, latencia y uso intensivo durante semanas. Validamos el comportamiento real, no especificaciones de laboratorio.
          </p>
          <div class="proof-data">
            <span class="proof-data-value">+{allProducts.reduce((acc, p) => acc + (p.investigation?.hoursInvestigated ?? 10), 0)}h</span>
            <span class="proof-data-label">De tests acumulados en catálogo</span>
          </div>
        </div>

        <div class="proof-card">
          <div class="proof-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="proof-title">Desglose de costes ocultos</h3>
          <p class="proof-text">
            Analizamos suscripciones obligatorias, consumibles, compatibilidad y TCO a 3 años. Si un producto tiene costes ocultos, lo destacamos.
          </p>
          <div class="proof-data">
            <span class="proof-data-value">0€</span>
            <span class="proof-data-label">Costes ocultos en productos recomendados</span>
          </div>
        </div>

        <div class="proof-card">
          <div class="proof-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="proof-title">Auditorías periódicas</h3>
          <p class="proof-text">
            Revisión trimestral de precios, actualizaciones de firmware, nuevas opiniones y alternativas emergentes. Lo que era bueno ayer, puede no serlo hoy.
          </p>
          <div class="proof-data">
            <span class="proof-data-value">{allProducts.length}</span>
            <span class="proof-data-label">Productos bajo vigilancia activa</span>
          </div>
        </div>
      </div>

      <div class="proof-cta">
        <a href="/metodologia" class="proof-btn">
          Descubre la metodología completa
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5. SECCIÓN E-E-A-T: Por Qué Confiar en Tradylor
       ============================================================ -->
  <section class="trust-section" id="metodologia">
    <div class="container">
      <div class="section-header center">
        <div class="section-tag">Nuestra Promesa Editorial</div>
        <h2 class="section-title">¿Por qué confiar en las recomendaciones de Tradylor?</h2>
        <p class="section-desc max-600">
          Internet está plagado de listas generadas automáticamente sin criterio. Tradylor nació para devolver la sensatez a las decisiones de compra en línea.
        </p>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="pillar-title">Curación Técnica Implacable</h3>
          <p class="pillar-text">
            No listamos catálogos enteros. Descartamos el 90% de los productos que evaluamos y solo publicamos los que superan nuestros estándares de durabilidad y satisfacción real.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="pillar-title">Cero Patrocinios Encubiertos</h3>
          <p class="pillar-text">
            Ninguna marca puede pagar por figurar en nuestras guías ni por alterar nuestros veredictos. Nuestra única lealtad es con el lector que busca comprar con seguridad.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="pillar-title">Monitoreo de Precios Reales</h3>
          <p class="pillar-text">
            Comparamos históricos de ofertas para avisarte cuando una rebaja es genuina y cuándo se trata de una oferta inflada artificialmente por los algoritmos de las tiendas.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="pillar-title">Transparencia Radical en Afiliación</h3>
          <p class="pillar-text">
            Explicamos con total claridad cómo se financia este portal. Cuando compras a través de nuestros botones oficiales, la tienda nos abona una comisión sin cobrarte un céntimo de más.
          </p>
        </div>
      </div>

      <div class="trust-metrics-wrap">
        <TrustMetrics />
      </div>
    </div>
  </section>

  <!-- ============================================================
       5b. DASHBOARD DE TRANSPARENCIA Y MÉTRICAS
       ============================================================ -->
  <TransparencyDashboard products={allProducts} />

  <!-- ============================================================
       5c. SMART MATCHER WIZARD
       ============================================================ -->
  <SmartMatcherWizard products={allProducts} />

  <!-- ============================================================
       6. SECCIÓN GUÍA DE COMPRA RÁPIDA: CRO Boost
       ============================================================ -->
  <section class="guide-banner-section" id="comparativas">
    <div class="container">
      <div class="guide-banner-card">
        <div class="guide-text">
          <span class="banner-badge">Guía Express</span>
          <h3 class="banner-heading">¿No tienes claro cuál elegir?</h3>
          <p class="banner-sub">
            Aplica nuestra regla de oro: prioriza productos con garantía directa del fabricante, disponibilidad inmediata de repuestos y un mínimo de 4.5 estrellas con más de 500 opiniones contrastadas.
          </p>
        </div>
        <div class="guide-action">
          <a href="#catalogo" class="guide-btn">Ver disponibilidad y tramitar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECCIONES DINÁMICAS POR DEBAJO DEL CATÁLOGO (carrusel deslizable)
       ============================================================ -->
  {belowCatalogSections.map((section) => (
    <section class="feed-section" data-dynamic-section={section.id} data-section-speed={section.speed || 'normal'} aria-label={section.title}>
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{section.title}</h2>
          {section.description && <p class="section-desc">{section.description}</p>}
        </div>
        <div class="feed-carousel">
          <button type="button" class="feed-carousel-btn feed-carousel-prev" data-carousel-prev aria-label="Anteriores">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
          </button>
          <div class="feed-carousel-track" data-carousel-track>
            {section.products.map((item) => <ProductCard product={item} layout="compact" />)}
          </div>
          <button type="button" class="feed-carousel-btn feed-carousel-next" data-carousel-next aria-label="Siguientes">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
          </button>
        </div>
      </div>
    </section>
  ))}
</Layout>

<script>
  const initFeedCarousels = (): void => {
    document.querySelectorAll<HTMLElement>('[data-carousel-track]').forEach((track) => {
      const root = track.closest('section') as HTMLElement | null;
      if (!root) return;
      // Evitar doble init si ya tiene listeners
      if (root.dataset.carouselInit === '1') return;
      // Solo inicializar secciones dinámicas
      if (!root.hasAttribute('data-dynamic-section')) return;
      root.dataset.carouselInit = '1';

      const carouselContainer = (track.closest('.feed-carousel') as HTMLElement | null) || track;
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');

      const step = (): number => {
        const card = track.querySelector<HTMLElement>('.product-card');
        if (!card) return Math.round(track.clientWidth * 0.8);
        const styles = window.getComputedStyle(track);
        const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
        return card.offsetWidth + gap;
      };

      const syncArrows = (): void => {
        const maxScroll = track.scrollWidth - track.clientWidth;
        const scrollable = maxScroll > 4;
        if (prevBtn) prevBtn.disabled = !scrollable || track.scrollLeft <= 4;
        if (nextBtn) nextBtn.disabled = !scrollable || track.scrollLeft >= maxScroll - 4;
      };

      let pauseAutoScroll = (): void => {};
      let resumeAutoScroll = (_delay?: number): void => {};

      prevBtn?.addEventListener('click', () => {
        pauseAutoScroll();
        track.scrollBy({ left: -step(), behavior: 'smooth' });
        resumeAutoScroll(1800);
      });

      nextBtn?.addEventListener('click', () => {
        pauseAutoScroll();
        track.scrollBy({ left: step(), behavior: 'smooth' });
        resumeAutoScroll(1800);
      });

      track.addEventListener('scroll', syncArrows, { passive: true });
      window.addEventListener('resize', syncArrows);
      syncArrows();

      // =========================================================================
      // AUTO-SCROLL DE CARRUSELES (Desktop & Responsive, velocidad configurable)
      // =========================================================================
      const speedAttr = (root.getAttribute('data-section-speed') || 'normal').toLowerCase();

      let pixelsPerSecond = 36; // 'normal' por defecto (~36 px/s)
      if (speedAttr === 'slow') pixelsPerSecond = 20; // 'slow': desplazamiento sutil y lento
      else if (speedAttr === 'fast') pixelsPerSecond = 65; // 'fast': desplazamiento ágil
      else if (speedAttr === 'none') pixelsPerSecond = 0; // 'none': desactivado (manual)
      else if (!isNaN(Number(speedAttr)) && Number(speedAttr) >= 0) {
        pixelsPerSecond = Number(speedAttr);
      }

      if (pixelsPerSecond > 0) {
        let isPaused = false;
        let isResetting = false;
        let resumeTimer: ReturnType<typeof setTimeout> | null = null;
        let isVisible = true;
        let rafId: number | null = null;
        let lastTime: number | null = null;
        let scrollPos = track.scrollLeft;

        pauseAutoScroll = () => {
          isPaused = true;
          scrollPos = track.scrollLeft;
          track.style.scrollSnapType = ''; // Permite snap nativo durante la interacción manual
          track.style.scrollBehavior = '';
          if (resumeTimer) {
            clearTimeout(resumeTimer);
            resumeTimer = null;
          }
        };

        resumeAutoScroll = (delay = 2000) => {
          if (resumeTimer) clearTimeout(resumeTimer);
          resumeTimer = setTimeout(() => {
            isPaused = false;
            lastTime = null;
            scrollPos = track.scrollLeft;
          }, delay);
        };

        // Si el usuario desplaza manualmente el carrusel (rueda, touch, arrastre), sincronizar scrollPos
        track.addEventListener('scroll', () => {
          if (isPaused) {
            scrollPos = track.scrollLeft;
          }
        }, { passive: true });

        const tick = (now: number) => {
          if (!lastTime) lastTime = now;
          const dt = Math.min((now - lastTime) / 1000, 0.1);
          lastTime = now;

          const maxScroll = track.scrollWidth - track.clientWidth;
          if (isVisible && !isPaused && !isResetting && maxScroll > 8) {
            track.style.scrollSnapType = 'none'; // Evita fricción del snap mientras se desplaza automáticamente
            track.style.scrollBehavior = 'auto'; // Evita colisiones con scroll-behavior global
            if (scrollPos >= maxScroll - 3 || track.scrollLeft >= maxScroll - 3) {
              // Fin del carrusel: pausar y volver suavemente al inicio
              isResetting = true;
              track.style.scrollSnapType = '';
              track.style.scrollBehavior = 'smooth';
              setTimeout(() => {
                track.scrollTo({ left: 0, behavior: 'smooth' });
                setTimeout(() => {
                  isResetting = false;
                  lastTime = null;
                  scrollPos = 0;
                }, 1000);
              }, 1200);
            } else {
              scrollPos += pixelsPerSecond * dt;
              track.scrollLeft = scrollPos;
            }
          }
          rafId = requestAnimationFrame(tick);
        };

        // =====================================================================
        // INTERACCIÓN MANUAL Y CONTROL DE PAUSA
        // El carrusel NO se pausa en hover (mouseenter/mouseleave).
        // La animación continúa ininterrumpidamente y solo se pausa/detiene si el usuario:
        // 1. Toca las flechas de navegación
        // 2. Hace clic
        // 3. Arrastra manualmente (mouse drag o touch swipe)
        // =====================================================================

        // Pausar en clic
        track.addEventListener('click', () => {
          pauseAutoScroll();
          resumeAutoScroll(2500);
        });

        // Arrastre táctil en móvil / tablets
        track.addEventListener('touchstart', pauseAutoScroll, { passive: true });
        track.addEventListener('touchend', () => resumeAutoScroll(2000), { passive: true });

        // Rueda del ratón
        track.addEventListener('wheel', () => {
          pauseAutoScroll();
          resumeAutoScroll(2000);
        }, { passive: true });

        // Arrastre manual con ratón en escritorio
        let isPointerDown = false;
        let startX = 0;
        let startScrollLeft = 0;
        let hasDragged = false;

        track.addEventListener('pointerdown', (e: PointerEvent) => {
          if (e.button !== 0) return;
          if ((e.target as HTMLElement)?.closest('button, [data-radar-toggle]')) return;
          isPointerDown = true;
          hasDragged = false;
          startX = e.pageX;
          startScrollLeft = track.scrollLeft;
          pauseAutoScroll();
        });

        window.addEventListener('pointermove', (e: PointerEvent) => {
          if (!isPointerDown) return;
          const diff = e.pageX - startX;
          if (Math.abs(diff) > 4) {
            hasDragged = true;
            track.classList.add('is-dragging-track');
            track.scrollLeft = startScrollLeft - diff;
            scrollPos = track.scrollLeft;
          }
        });

        const onPointerUp = () => {
          if (!isPointerDown) return;
          isPointerDown = false;
          track.classList.remove('is-dragging-track');
          if (hasDragged) {
            const blockClick = (ev: MouseEvent) => {
              ev.preventDefault();
              ev.stopPropagation();
            };
            track.addEventListener('click', blockClick, { capture: true, once: true });
            setTimeout(() => track.removeEventListener('click', blockClick, { capture: true }), 100);
          }
          resumeAutoScroll(2500);
        };

        window.addEventListener('pointerup', onPointerUp);
        window.addEventListener('pointercancel', onPointerUp);

        // Pausar si la pestaña pasa a segundo plano
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            pauseAutoScroll();
          } else {
            lastTime = null;
            scrollPos = track.scrollLeft;
            resumeAutoScroll(300);
          }
        });

        // Optimización: solo animar si el carrusel está dentro del viewport visible
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              isVisible = entry.isIntersecting;
              if (!isVisible) {
                lastTime = null;
              } else {
                scrollPos = track.scrollLeft;
              }
            });
          }, { threshold: 0.05 });
          observer.observe(carouselContainer);
        }

        rafId = requestAnimationFrame(tick);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeedCarousels);
  } else {
    initFeedCarousels();
  }
</script>

