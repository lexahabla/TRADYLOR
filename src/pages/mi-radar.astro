---
/**
 * ==============================================================================
 * TRADYLOR — MI RADAR (panel personal del usuario)
 * ==============================================================================
 * Página privada: requiere sesión (si no, redirige a tradylor.com). Secciones:
 *   1. Barra superior: perfil + estado de sincronización.
 *   2. Return Flow: tarjeta "¿Llegaste a comprar…?" si hay salida pendiente
 *      de más de 24h.
 *   3. Gestor de carpetas/listas con pestañas + sumatorio estimado (€).
 *   4. Grid de productos guardados (responsive).
 * Todo el render es client-side (radarStore + auth); el HTML sirve el shell.
 * ==============================================================================
 */

import Layout from '../layouts/Layout.astro';
import { getRadarSessionUser } from '../lib/radarAuth';
import { REMINDER_REASONS } from '../types/radar';

export const prerender = false;

// Página privada: sin sesión válida, redirección inmediata al inicio
// (tradylor.com en producción) en el propio servidor, sin pintar la página.
const sessionUser = getRadarSessionUser(Astro.request);
if (!sessionUser) {
  return Astro.redirect(new URL('/', Astro.request.url).href);
}
---

<Layout
  title="Mi Radar | Tradylor"
  description="Tu panel privado: productos guardados, proyectos de compra y recordatorios de salida, sincronizados con tu cuenta."
  noindex
>
  <div class="radar-page container">
    <!-- 1. Barra superior / estado -->
    <header class="radar-header">
      <div class="radar-header-text">
        <div class="radar-kicker-row">
          <a href="/" class="radar-kicker">Inicio</a>
          <span class="radar-kicker-sep" aria-hidden="true">/</span>
          <p class="radar-kicker">Tu panel privado</p>
        </div>
        <h1 class="radar-title">Mi Radar</h1>
        <p class="radar-subtitle">Guarda productos, organiza proyectos de compra y retoma lo pendiente desde cualquier dispositivo.</p>
      </div>
    </header>

    <!-- 2. Return Flow -->
    <section class="radar-return-flow" data-radar-return hidden>
      <h2 class="radar-section-title">¿Compraste algo recientemente?</h2>
      <div class="radar-exit-cards" data-radar-exit-cards></div>
    </section>

    <!-- 3. Carpetas / listas -->
    <section class="radar-projects">
      <div class="radar-projects-bar">
        <div class="radar-tabs" role="tablist" aria-label="Listas de Mi Radar" data-radar-tabs></div>
        <button type="button" class="radar-btn radar-btn-ghost radar-new-list-btn" data-radar-new-project>+ Nueva lista</button>
      </div>
      <p class="radar-dnd-hint" data-radar-dnd-hint hidden></p>
      <div class="radar-project-summary" data-radar-summary>
        <span data-radar-summary-count>0 productos</span>
        <strong data-radar-summary-total>0,00 €</strong>
      </div>
    </section>

    <!-- 4. Grid de productos -->
    <section class="radar-grid-section">
      <div class="radar-grid" data-radar-grid></div>
      <div class="radar-empty" data-radar-empty>
        <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
        <h3>Tu Radar está vacío</h3>
        <p>Explora el catálogo y pulsa el botón 🔖 de cualquier tarjeta para guardarlo aquí.</p>
        <a href="/#catalogo" class="radar-btn radar-btn-primary">Ver productos</a>
      </div>
    </section>
  </div>

  <!-- Modal para crear lista / editar nota -->
  <div class="radar-modal" data-radar-modal hidden>
    <div class="radar-modal-backdrop" data-radar-modal-close></div>
    <div class="radar-modal-panel" role="dialog" aria-modal="true" aria-labelledby="radarModalTitle">
      <h3 id="radarModalTitle" data-radar-modal-title>Nueva lista</h3>
      <form data-radar-modal-form>
        <label class="radar-modal-field">
          <span data-radar-modal-label>Nombre</span>
          <input type="text" name="value" required maxlength="60" autocomplete="off" />
        </label>
        <div class="radar-modal-actions">
          <button type="button" class="radar-btn radar-btn-ghost" data-radar-modal-close>Cancelar</button>
          <button type="submit" class="radar-btn radar-btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de aviso diferido (fecha + hora + motivo) -->
  <div class="radar-modal" data-reminder-modal hidden>
    <div class="radar-modal-backdrop" data-reminder-close></div>
    <div class="radar-modal-panel" role="dialog" aria-modal="true" aria-labelledby="reminderModalTitle">
      <h3 id="reminderModalTitle">⏰ Aviso de compra</h3>
      <p class="radar-modal-hint" data-reminder-product>—</p>
      <form data-reminder-form>
        <div class="radar-modal-row">
          <label class="radar-modal-field">
            <span>Fecha</span>
            <input type="date" name="date" required />
          </label>
          <label class="radar-modal-field">
            <span>Hora</span>
            <input type="time" name="time" required />
          </label>
        </div>
        <label class="radar-modal-field">
          <span>Motivo</span>
          <select name="reason" required>
            {REMINDER_REASONS.map((reason) => <option value={reason}>{reason}</option>)}
          </select>
        </label>
        <label class="radar-modal-field">
          <span>Nota (opcional)</span>
          <input type="text" name="note" maxlength="120" placeholder="Ej: espero a la Prime Day" autocomplete="off" />
        </label>
        <p class="radar-modal-error" data-reminder-error hidden></p>
        <div class="radar-modal-actions">
          <button type="button" class="radar-btn radar-btn-ghost" data-reminder-close>Cancelar</button>
          <button type="button" class="radar-btn radar-btn-danger" data-reminder-cancel hidden>Eliminar aviso</button>
          <button type="submit" class="radar-btn radar-btn-primary">Programar aviso</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de precio objetivo (alerta de bajada de precio + vuelta a stock) -->
  <div class="radar-modal" data-alert-modal hidden>
    <div class="radar-modal-backdrop" data-alert-close></div>
    <div class="radar-modal-panel" role="dialog" aria-modal="true" aria-labelledby="alertModalTitle">
      <h3 id="alertModalTitle">🎯 Precio objetivo</h3>
      <p class="radar-modal-hint" data-alert-product>—</p>
      <form data-alert-form>
        <label class="radar-modal-field">
          <span>Avisarme si baja de (€)</span>
          <input type="number" name="target" min="0.01" step="0.01" required inputmode="decimal" placeholder="Ej: 249,99" />
        </label>
        <label class="radar-modal-check">
          <input type="checkbox" name="stock" />
          <span>Avisarme también cuando vuelva a stock</span>
        </label>
        <p class="radar-modal-error" data-alert-error hidden></p>
        <div class="radar-modal-actions">
          <button type="button" class="radar-btn radar-btn-ghost" data-alert-close>Cancelar</button>
          <button type="button" class="radar-btn radar-btn-danger" data-alert-remove hidden>Quitar alerta</button>
          <button type="submit" class="radar-btn radar-btn-primary">Activar alerta</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Toast de confirmación (avisos / compartir) -->
  <div class="radar-toast" data-radar-toast role="status" aria-live="polite" hidden></div>
</Layout>

<style>
  /* ================================================================
     MI RADAR — shell + componentes propios (tema oscuro Tradylor).
     Tailwind se usa para layout básico en el markup; aquí va el resto.
     ================================================================ */
  .radar-page {
    padding: 2.5rem 1.25rem 5rem;
  }

  .radar-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .radar-kicker-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .radar-kicker {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #60a5fa;
  }

  .radar-kicker-sep {
    font-size: 0.74rem;
    font-weight: 800;
    color: #60a5fa;
    opacity: 0.5;
  }

  a.radar-kicker {
    text-decoration: none;
    transition: color 0.16s ease;
  }

  a.radar-kicker:hover {
    color: #93c5fd;
  }

  .radar-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    font-weight: 800;
    color: var(--color-text-main);
  }

  .radar-subtitle {
    max-width: 560px;
    margin: 0.55rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Return Flow */
  .radar-return-flow {
    margin-bottom: 2rem;
  }

  .radar-return-flow[hidden] {
    display: none;
  }

  .radar-section-title {
    margin: 0 0 0.9rem;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .radar-exit-cards {
    display: grid;
    gap: 0.8rem;
  }

  /* Nota: los bloques marcados con :global() maquetan HTML inyectado por JS
     (renderTabs/renderGrid/renderExits) y Astro no les añade data-astro-cid. */
  :global(.radar-exit-card) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.08) 0%, rgba(245, 158, 11, 0.04) 100%);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: var(--border-radius-md);
  }

  :global(.radar-exit-card p) {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-main);
  }

  :global(.radar-exit-card p strong) {
    color: #fbbf24;
  }

  :global(.radar-exit-actions) {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* Botones reutilizables */
  .radar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .radar-btn-primary {
    color: #07111f;
    background: linear-gradient(135deg, #60a5fa, #3b82f6);
    border: 0;
  }

  .radar-btn-primary:hover {
    filter: brightness(1.1);
  }

  .radar-btn-ghost {
    color: var(--color-text-main);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .radar-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Carpetas / pestañas */
  .radar-projects {
    margin-bottom: 1.25rem;
  }

  .radar-projects-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .radar-tabs {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding-bottom: 0.2rem;
    /* Sin barra de scroll visible: al arrastrar un producto sobre las listas
       la pestaña activa se escala y aparecía una scroll horizontal fea. */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .radar-tabs::-webkit-scrollbar {
    display: none;
  }

  :global(.radar-tab) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.95rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  :global(.radar-tab:hover) {
    color: var(--color-text-main);
    background: rgba(255, 255, 255, 0.08);
  }

  :global(.radar-tab.is-active) {
    color: #07111f;
    background: #60a5fa;
    border-color: #60a5fa;
  }

  :global(.radar-tab-count) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    font-size: 0.68rem;
    font-weight: 800;
    color: inherit;
    background: rgba(0, 0, 0, 0.18);
    border-radius: 999px;
  }

  :global(.radar-tab-delete) {
    display: inline-flex;
    margin-left: 0.15rem;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    opacity: 0.55;
  }

  :global(.radar-tab-delete:hover) {
    opacity: 1;
  }

  .radar-project-summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.1rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .radar-project-summary strong {
    font-size: 1.05rem;
    color: #60a5fa;
  }

  .radar-new-list-btn {
    flex-shrink: 0;
  }

  /* Grid de productos — denso: ~5 columnas en escritorio, 2 en móvil */
  .radar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  /* ================================================================
     TARJETA DEL RADAR — versión mini del ProductCard del catálogo:
     mismo lenguaje visual (degradado oscuro, borde translúcido, radio
     12px, imagen sobre fondo claro con object-contain, precio en
     degradado azul y CTA azul), en formato compacto para que quepan
     2 por fila en móvil.
     Nota: el HTML lo inyecta renderGrid() por innerHTML, así que todos
     estos selectores van en :global() (Astro no añade data-astro-cid).
     ================================================================ */
  :global(.radar-card) {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: linear-gradient(135deg, rgba(17, 24, 39, 0.7) 0%, rgba(30, 41, 59, 0.5) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1), border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  :global(.radar-card:hover) {
    transform: translateY(-4px);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 16px 40px rgba(59, 130, 246, 0.2);
  }

  /* Media: imagen cuadrada sobre fondo claro (como .image-wrapper) */
  :global(.radar-card-media) {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #f8fafc;
    padding: 4px;
    overflow: hidden;
  }

  :global(.radar-card-image-link) {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
  }

  :global(.radar-card-media img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.35rem;
    background: rgba(248, 250, 252, 0.5);
    border-radius: 8px;
    transition: transform 0.4s ease;
  }

  :global(.radar-card:hover .radar-card-media img) {
    transform: scale(1.03);
  }

  /* Badge de tienda (arriba-izquierda) */
  :global(.radar-card-store) {
    position: absolute;
    top: 0.4rem;
    left: 0.4rem;
    max-width: calc(100% - 2.6rem);
    padding: 0.16rem 0.45rem;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #07111f;
    background: #fbbf24;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }

  :global(.radar-card-store.is-aliexpress) {
    color: #fff;
    background: #ef4444;
  }

  /* Quitar: misma posición que la .discount-pill del catálogo */
  :global(.radar-card-remove) {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    font-size: 0.95rem;
    line-height: 1;
    color: #334155;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  :global(.radar-card-remove:hover) {
    color: #ffffff;
    background: #ef4444;
    border-color: #ef4444;
    transform: scale(1.06);
  }

  /* Indicador de nota personal (abajo-izquierda sobre la imagen) */
  :global(.radar-card-note-dot) {
    position: absolute;
    left: 0.4rem;
    bottom: 0.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 23px;
    height: 23px;
    padding: 0;
    color: #93c5fd;
    background: rgba(10, 14, 23, 0.78);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 7px;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  :global(.radar-card-note-dot:hover) {
    color: #ffffff;
    background: rgba(37, 99, 235, 0.9);
  }

  :global(.radar-card-note-dot.has-note) {
    color: #fbbf24;
    border-color: rgba(251, 191, 36, 0.5);
  }

  :global(.radar-card-body) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.5rem 0.55rem 0.6rem;
    flex: 1;
    min-width: 0;
  }

  :global(.radar-card-title) {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text-main);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.radar-card-title a) {
    color: inherit;
    text-decoration: none;
  }

  :global(.radar-card-title a:hover) {
    color: #60a5fa;
  }

  :global(.radar-card-price) {
    margin-top: auto;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.15;
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :global(.radar-card-buy) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    width: 100%;
    margin-top: 0.4rem;
    padding: 0.42rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    color: #ffffff;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(59, 130, 246, 0.35);
    transition: all 0.25s ease;
  }

  :global(.radar-card-buy:hover) {
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    transform: translateY(-1px);
    box-shadow: 0 10px 22px rgba(59, 130, 246, 0.45);
  }

  :global(.radar-card-buy svg) {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  :global(.radar-card-buy:hover svg) {
    transform: translate(2px, -2px);
  }

  /* Vacío */
  .radar-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    padding: 3.5rem 1.5rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .radar-empty[hidden] {
    display: none;
  }

  .radar-empty h3 {
    margin: 0.3rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-text-main);
  }

  .radar-empty p {
    max-width: 380px;
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
  }

  /* Modal interno */
  .radar-modal {
    position: fixed;
    inset: 0;
    z-index: 9400;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .radar-modal[hidden] {
    display: none;
  }

  .radar-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 8, 16, 0.72);
    backdrop-filter: blur(5px);
  }

  .radar-modal-panel {
    position: relative;
    width: min(400px, 100%);
    padding: 1.5rem;
    background: linear-gradient(160deg, #131b2c, #0d1422);
    border: 1px solid rgba(96, 165, 250, 0.22);
    border-radius: 18px;
  }

  .radar-modal-panel h3 {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--color-text-main);
  }

  .radar-modal-field {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .radar-modal-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-main);
    background: rgba(10, 14, 23, 0.8);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }

  .radar-modal-field input:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.14);
  }

  .radar-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .radar-modal-hint {
    margin: -0.4rem 0 1rem;
    font-size: 0.76rem;
    line-height: 1.45;
    color: #9ca3af;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .radar-modal-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .radar-modal-field select {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-main);
    background: rgba(10, 14, 23, 0.8);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }

  .radar-modal-field select:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.14);
  }

  .radar-modal-field input[type='date'],
  .radar-modal-field input[type='time'] {
    color-scheme: dark;
  }

  .radar-modal-error {
    margin: -0.35rem 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #fca5a5;
    line-height: 1.4;
  }

  .radar-btn-danger {
    padding: 0.55rem 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .radar-btn-danger:hover {
    background: rgba(239, 68, 68, 0.28);
    color: #fff;
  }

  /* Toast flotante (avisos / compartir) */
  .radar-toast {
    position: fixed;
    left: 50%;
    bottom: 1.6rem;
    transform: translateX(-50%) translateY(12px);
    z-index: 200;
    max-width: min(92vw, 420px);
    padding: 0.7rem 1.1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-align: center;
    color: #f3f4f6;
    background: #0d1422;
    border: 1px solid rgba(96, 165, 250, 0.4);
    border-radius: 999px;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.22s ease, transform 0.22s ease;
    pointer-events: none;
  }

  .radar-toast.is-on {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .radar-toast.is-error {
    border-color: rgba(248, 113, 113, 0.55);
    color: #fecaca;
  }

  /* Acciones de tarjeta: aviso + compartir */
  :global(.radar-card-actions) {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }

  :global(.radar-card-action) {
    flex: 1;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.36rem 0.4rem;
    font-family: inherit;
    font-size: 0.66rem;
    font-weight: 800;
    color: #9ca3af;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  :global(.radar-card-action span) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.radar-card-action svg) {
    flex-shrink: 0;
  }

  :global(.radar-card-action:hover) {
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.16);
    border-color: rgba(59, 130, 246, 0.45);
  }

  :global(.radar-card-action.is-on) {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.12);
    border-color: rgba(251, 191, 36, 0.45);
  }

  :global(.radar-card-action.is-on:hover) {
    color: #fcd34d;
    background: rgba(251, 191, 36, 0.2);
  }

  /* Alerta de precio objetivo (🎯): verde cuando está activa; sólido al dispararse. */
  :global(.radar-card-action.is-alert) {
    color: #34d399;
    background: rgba(52, 211, 153, 0.12);
    border-color: rgba(52, 211, 153, 0.45);
  }

  :global(.radar-card-alert-pill) {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    margin-top: 0.4rem;
    padding: 0.16rem 0.5rem;
    font-size: 0.68rem;
    font-weight: 800;
    color: #34d399;
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.35);
    border-radius: 999px;
  }

  :global(.radar-card-alert-pill.is-triggered) {
    color: #052e1b;
    background: #34d399;
    border-color: #34d399;
  }

  .radar-modal-check {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    user-select: none;
  }

  .radar-modal-check input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: #60a5fa;
    cursor: pointer;
  }

  /* ================================================================
     ARRASTRAR Y SOLTAR: productos sobre las listas para clasificarlos
     ================================================================ */
  .radar-dnd-hint {
    margin: 0 0 0.6rem;
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--color-text-dim);
  }

  .radar-dnd-hint[hidden] {
    display: none;
  }

  /* Las tarjetas se pueden coger (sólo si hay otra lista donde soltarlas) */
  :global(.radar-card) {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  :global(.radar-grid.can-drag .radar-card) {
    cursor: grab;
  }

  :global(.radar-card.is-dragging) {
    opacity: 0.35;
    transform: scale(0.97) !important;
    border-style: dashed;
    border-color: rgba(96, 165, 250, 0.6);
    box-shadow: none !important;
  }

  :global(body.radar-is-dragging),
  :global(body.radar-is-dragging *) {
    cursor: grabbing !important;
    -webkit-user-select: none !important;
    user-select: none !important;
  }

  /* Tarjetita que sigue al puntero */
  :global(.radar-drag-ghost) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: min(230px, 70vw);
    padding: 0.4rem 0.65rem 0.4rem 0.4rem;
    background: rgba(13, 20, 34, 0.96);
    border: 1px solid rgba(96, 165, 250, 0.7);
    border-radius: 12px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55), 0 0 0 3px rgba(59, 130, 246, 0.18);
    pointer-events: none;
    will-change: transform;
  }

  :global(.radar-drag-ghost img) {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    padding: 3px;
    object-fit: contain;
    background: #f8fafc;
    border-radius: 8px;
  }

  :global(.radar-drag-ghost span) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.3;
    color: #f3f4f6;
  }

  /* Listas como destino: se marcan al coger un producto y se iluminan al pasar por encima */
  .radar-tabs.is-drop-mode :global(.radar-tab) {
    border-style: dashed;
    border-color: rgba(96, 165, 250, 0.55);
  }

  :global(.radar-tab.is-drop-over) {
    color: #07111f;
    background: #93c5fd;
    border-color: #bfdbfe;
    transform: scale(1.06);
    box-shadow: 0 0 0 4px rgba(96, 165, 250, 0.28), 0 8px 22px rgba(59, 130, 246, 0.45);
  }

  :global(.radar-tab.is-drop-current) {
    opacity: 0.55;
  }

  :global(.radar-tab.is-dropped) {
    animation: radarDropFlash 0.9s ease;
  }

  @keyframes radarDropFlash {
    0% {
      box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.7);
    }
    40% {
      color: #04210f;
      background: #34d399;
      box-shadow: 0 0 0 8px rgba(52, 211, 153, 0.35);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(52, 211, 153, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.radar-tab.is-dropped) {
      animation: none;
    }
  }

  /* "Mover a…": alternativa sin arrastrar (teclado, lector de pantalla, móvil).
     Un <select> nativo transparente encima del icono: al pulsarlo se abre la lista. */
  :global(.radar-card-move) {
    position: absolute;
    right: 0.4rem;
    bottom: 0.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 23px;
    height: 23px;
    color: #93c5fd;
    background: rgba(10, 14, 23, 0.78);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 7px;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  :global(.radar-card-move:hover),
  :global(.radar-card-move:focus-within) {
    color: #ffffff;
    background: rgba(37, 99, 235, 0.9);
  }

  :global(.radar-card-move:focus-within) {
    outline: 2px solid #60a5fa;
    outline-offset: 2px;
  }

  :global(.radar-card-move select) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-size: 16px;
    color-scheme: dark;
    opacity: 0;
    cursor: pointer;
  }

  /* Responsive */
  @media (max-width: 720px) {
    .radar-header {
      flex-direction: column;
      align-items: flex-start;
    }

    :global(.radar-exit-card) {
      flex-direction: column;
      align-items: flex-start;
    }

    .radar-projects-bar {
      flex-direction: column;
      align-items: stretch;
    }

    .radar-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 0.65rem;
    }

    :global(.radar-card-title) {
      font-size: 0.75rem;
    }

    :global(.radar-card-price) {
      font-size: 0.9rem;
    }

    :global(.radar-card-buy) {
      padding: 0.4rem 0.45rem;
      font-size: 0.7rem;
    }
  }

  /* Pantallas muy estrechas: 2 columnas de ~140px sin desbordar */
  @media (max-width: 400px) {
    .radar-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 0.5rem;
    }

    .radar-page {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>

<script>
  import { getSession, onAuthChange } from '../utils/auth';
  import {
    cancelReminder,
    createProject,
    createReminder,
    deleteProject,
    getProjects,
    getRadarProducts,
    getScheduledReminder,
    loadRadar,
    moveProduct,
    onRadarChange,
    removeProduct,
    resolveExit,
    setProductAlert,
    setProductNote,
  } from '../utils/radarStore';
  import { openSharePanel } from '../utils/shareUi';
  import { RETURN_FLOW_MIN_AGE_MS } from '../types/radar';
  import type { ProjectFolder, SavedProduct } from '../types/radar';

  const $ = <T extends HTMLElement = HTMLElement>(selector: string): T | null =>
    document.querySelector<T>(selector);

  const els = {
    returnSection: $('[data-radar-return]'),
    exitCards: $('[data-radar-exit-cards]'),
    tabs: $('[data-radar-tabs]'),
    dndHint: $('[data-radar-dnd-hint]'),
    newProject: $('[data-radar-new-project]'),
    summaryCount: $('[data-radar-summary-count]'),
    summaryTotal: $('[data-radar-summary-total]'),
    grid: $('[data-radar-grid]'),
    empty: $('[data-radar-empty]'),
    modal: $('[data-radar-modal]'),
    modalTitle: $('[data-radar-modal-title]'),
    modalForm: $('[data-radar-modal-form]') as HTMLFormElement | null,
    reminderModal: $('[data-reminder-modal]'),
    reminderForm: $('[data-reminder-form]') as HTMLFormElement | null,
    reminderProduct: $('[data-reminder-product]'),
    reminderCancel: $('[data-reminder-cancel]'),
    reminderError: $('[data-reminder-error]'),
    alertModal: $('[data-alert-modal]'),
    alertForm: $('[data-alert-form]') as HTMLFormElement | null,
    alertProduct: $('[data-alert-product]'),
    alertRemove: $('[data-alert-remove]'),
    alertError: $('[data-alert-error]'),
    toast: $('[data-radar-toast]'),
  };

  const euro = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });

  let activeProjectId = getProjects()[0]?.id ?? 'general';
  /** Lista que acaba de recibir un producto (se ilumina un instante en verde). */
  let flashProjectId: string | null = null;

  const escapeHtml = (text: string): string =>
    text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  /* -------------------------------------------------------------- avisos */

  const remindWhen = new Intl.DateTimeFormat('es-ES', {
    day: '2-digit',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  });

  /** Botón 🔔 de la tarjeta: muestra la fecha si hay aviso activo. */
  function renderReminderBtn(product: SavedProduct): string {
    const reminder = getScheduledReminder(product.id);
    const has = Boolean(reminder);
    const label = has && reminder ? `Aviso ${remindWhen.format(new Date(reminder.remindAt))}` : 'Aviso';
    return `
      <button type="button" class="radar-card-action${has ? ' is-on' : ''}" data-reminder-open="${escapeHtml(product.id)}"
        title="${has ? 'Aviso programado. Pulsa para editar o eliminar.' : 'Avisarme cuando toque comprar'}"
        aria-label="${has ? 'Editar aviso de compra' : 'Crear aviso de compra'} para ${escapeHtml(product.title)}">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path></svg>
        <span>${escapeHtml(label)}</span>
      </button>`;
  }

  /** Botón 🎯 de la tarjeta: precio objetivo / estado de la alerta de bajada. */
  function renderAlertBtn(product: SavedProduct): string {
    const alert = product.priceAlert;
    const hasTarget = typeof product.targetPrice === 'number' && product.targetPrice > 0;
    const triggered = alert?.status === 'triggered';
    const label = triggered
      ? `¡Bajó! ${euro.format(product.targetPrice ?? 0)}`
      : hasTarget
        ? `Objetivo ${euro.format(product.targetPrice!)}`
        : 'Precio objetivo';
    const title = triggered
      ? 'El precio alcanzó tu objetivo. Pulsa para cambiarlo o quitar la alerta.'
      : hasTarget
        ? `Te avisamos si baja de ${euro.format(product.targetPrice!)}. Pulsa para editar.`
        : 'Avisarme cuando este producto baje de precio';
    return `
      <button type="button" class="radar-card-action${hasTarget ? ' is-on' : ''}${triggered ? ' is-alert' : ''}" data-alert-open="${escapeHtml(product.id)}"
        title="${escapeHtml(title)}"
        aria-label="${escapeHtml(title)}">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
        <span>${escapeHtml(label)}</span>
      </button>`;
  }

  /* --------------------------------------------------------------- toast */

  let toastTimer: ReturnType<typeof setTimeout> | null = null;
  function showToast(message: string, error = false): void {
    const toast = els.toast;
    if (!toast) return;
    toast.textContent = message;
    toast.classList.toggle('is-error', error);
    toast.hidden = false;
    toast.classList.add('is-on');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove('is-on');
      toast.hidden = true;
    }, 3200);
  }

  /* ------------------------------------------------------------- render */

  function renderTabs(projects: ProjectFolder[]): void {
    if (!els.tabs) return;
    if (!projects.some((p) => p.id === activeProjectId)) {
      activeProjectId = projects[0]?.id ?? 'general';
    }
    // Se repinta con cada cambio (también con la respuesta de la sincronización): que el
    // teclado no pierda el foco si estaba en una lista.
    const focusedTab = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>('[data-project-tab]');
    const focusedId = focusedTab && els.tabs.contains(focusedTab) ? focusedTab.dataset.projectTab : null;
    els.tabs.innerHTML = projects
      .map(
        (project) => `
        <button type="button" class="radar-tab${project.id === activeProjectId ? ' is-active' : ''}${project.id === flashProjectId ? ' is-dropped' : ''}" role="tab"
          aria-selected="${project.id === activeProjectId}" data-project-tab="${escapeHtml(project.id)}">
          ${escapeHtml(project.name)}
          <span class="radar-tab-count">${project.products.length}</span>
          ${project.id !== 'general' ? `<span class="radar-tab-delete" data-project-delete="${escapeHtml(project.id)}" title="Eliminar lista" aria-hidden="true">×</span>` : ''}
        </button>`,
      )
      .join('');
    if (focusedId) {
      Array.from(els.tabs.querySelectorAll<HTMLElement>('[data-project-tab]'))
        .find((tab) => tab.dataset.projectTab === focusedId)
        ?.focus({ preventScroll: true });
    }
  }

  function renderSummary(projects: ProjectFolder[]): void {
    const active = projects.find((p) => p.id === activeProjectId) ?? projects[0];
    const products = active?.products ?? [];
    const total = products.reduce((sum, p) => sum + (p.priceValue ?? 0), 0);
    if (els.summaryCount) els.summaryCount.textContent = `${products.length} producto${products.length === 1 ? '' : 's'}`;
    if (els.summaryTotal) els.summaryTotal.textContent = euro.format(total);
  }

  function renderGrid(projects: ProjectFolder[]): void {
    if (!els.grid || !els.empty) return;
    const active = projects.find((p) => p.id === activeProjectId) ?? projects[0];
    const products = active?.products ?? [];
    els.empty.hidden = products.length > 0;
    els.grid.hidden = products.length === 0;
    // Con otra lista a la vista, las tarjetas se pueden arrastrar y tienen el selector "Mover a…".
    const canMove = projects.length > 1;
    els.grid.classList.toggle('can-drag', canMove);
    const moveOptions = projects
      .map(
        (project) =>
          `<option value="${escapeHtml(project.id)}"${project.id === active?.id ? ' selected' : ''}>${escapeHtml(project.name)}</option>`,
      )
      .join('');
    els.grid.innerHTML = products
      .map(
        (product: SavedProduct) => `
        <article class="radar-card" data-product-id="${escapeHtml(product.id)}">
          <div class="radar-card-media">
            <a class="radar-card-image-link" draggable="false" href="/producto/${encodeURIComponent(product.id)}" title="Ver ficha de ${escapeHtml(product.title)}" aria-label="Ver ficha de ${escapeHtml(product.title)}">
              <img src="${escapeHtml(product.image)}" alt="${escapeHtml(product.title)}" loading="lazy" draggable="false" />
            </a>
            <span class="radar-card-store${product.store === 'aliexpress' ? ' is-aliexpress' : ''}">${escapeHtml(product.store)}</span>
            <button type="button" class="radar-card-remove" data-remove-id="${escapeHtml(product.id)}" aria-label="Quitar de Mi Radar" title="Quitar de Mi Radar">×</button>
            <button type="button" class="radar-card-note-dot${product.userNote ? ' has-note' : ''}" data-note-edit="${escapeHtml(product.id)}" aria-label="${product.userNote ? 'Editar nota' : 'Añadir nota'}" title="${product.userNote ? 'Editar nota' : 'Añadir nota'}">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            </button>
            ${
              canMove
                ? `<label class="radar-card-move" title="Mover a otra lista">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><path d="M12 11v5"></path><path d="m9.5 13.5 2.5-2.5 2.5 2.5"></path></svg>
              <select data-move-product="${escapeHtml(product.id)}" aria-label="Mover ${escapeHtml(product.title)} a otra lista">${moveOptions}</select>
            </label>`
                : ''
            }
          </div>
          <div class="radar-card-body">
            <h3 class="radar-card-title">
              <a href="/producto/${encodeURIComponent(product.id)}" draggable="false" title="Ver ficha de ${escapeHtml(product.title)}">${escapeHtml(product.title)}</a>
            </h3>
            ${
              product.priceAlert?.status === 'triggered'
                ? `<span class="radar-card-alert-pill is-triggered" title="El precio bajó hasta tu objetivo">📉 ¡Bajó!</span>`
                : typeof product.targetPrice === 'number' && product.targetPrice > 0
                  ? `<span class="radar-card-alert-pill" title="Alerta de precio activa">🎯 ${escapeHtml(euro.format(product.targetPrice))}</span>`
                  : ''
            }
            <span class="radar-card-price">${escapeHtml(product.price)}</span>
            <div class="radar-card-actions">
              ${renderReminderBtn(product)}
              ${renderAlertBtn(product)}
              <button type="button" class="radar-card-action" data-share-open="${escapeHtml(product.id)}" title="Compartir producto" aria-label="Compartir ${escapeHtml(product.title)}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"></line><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"></line></svg>
                <span>Compartir</span>
              </button>
            </div>
            <a class="radar-card-buy" draggable="false" href="${escapeHtml(product.buyUrl || '#')}" target="_blank" rel="nofollow sponsored noopener noreferrer">
              Retomar compra
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline></svg>
            </a>
          </div>
        </article>`,
      )
      .join('');
  }

  function renderExits(): void {
    if (!els.returnSection || !els.exitCards) return;
    const now = Date.now();
    const pending = loadRadar().pendingExits.filter(
      (exit) => exit.status === 'pending' && now - exit.timestamp >= RETURN_FLOW_MIN_AGE_MS,
    );
    els.returnSection.hidden = pending.length === 0;
    els.exitCards.innerHTML = pending
      .map(
        (exit) => `
        <div class="radar-exit-card" data-exit-id="${escapeHtml(exit.productId)}">
          <p>¿Llegaste a comprar <strong>${escapeHtml(exit.title || 'este producto')}</strong>?</p>
          <div class="radar-exit-actions">
            <button type="button" class="radar-btn radar-btn-primary" data-exit-resolve="purchased" data-exit-product="${escapeHtml(exit.productId)}">Sí, ya lo compré</button>
            <button type="button" class="radar-btn radar-btn-ghost" data-exit-resolve="dismissed" data-exit-product="${escapeHtml(exit.productId)}">Aún no</button>
          </div>
        </div>`,
      )
      .join('');
  }

  /** Pista bajo las listas: cómo clasificar (arrastrar con ratón o mantener pulsado en el móvil). */
  function renderDndHint(projects: ProjectFolder[]): void {
    if (!els.dndHint) return;
    const total = projects.reduce((sum, project) => sum + project.products.length, 0);
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    els.dndHint.hidden = !(projects.length > 1 && total > 0);
    els.dndHint.textContent = coarse
      ? 'Mantén pulsado un producto y arrástralo a una lista para clasificarlo, o usa el botón de carpeta de la foto.'
      : 'Arrastra un producto sobre una lista para clasificarlo, o usa el botón de carpeta de la foto.';
  }

  function renderAll(): void {
    const projects = getProjects();
    renderTabs(projects);
    renderSummary(projects);
    renderGrid(projects);
    renderDndHint(projects);
    renderExits();
  }

  /* -------------------------------------------------------------- modal */

  const openModal = () => {
    if (!els.modal || !els.modalTitle || !els.modalForm) return;
    els.modalTitle.textContent = 'Nueva lista';
    const label = els.modalForm.querySelector('[data-radar-modal-label]');
    if (label) label.textContent = 'Nombre de la lista';
    const input = els.modalForm.querySelector<HTMLInputElement>('input');
    if (input) {
      input.value = '';
      input.placeholder = 'Ej: Setup & Tech';
    }
    els.modal.hidden = false;
    input?.focus();
  };

  const closeModal = () => {
    if (els.modal) els.modal.hidden = true;
  };

  els.modalForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const input = els.modalForm.querySelector<HTMLInputElement>('input');
    const value = input?.value.trim() ?? '';
    if (value) {
      const project = createProject(value);
      activeProjectId = project.id;
    }
    closeModal();
    renderAll();
  });

  document.querySelectorAll<HTMLElement>('[data-radar-modal-close]').forEach((el) => {
    el.addEventListener('click', closeModal);
  });

  /* -------------------------------------------------------------- notas */

  const editNote = (productId: string): void => {
    if (!productId) return;
    const product = getRadarProducts().find((p) => p.id === productId);
    if (!product) return;
    const value = window.prompt('Nota personal', product.userNote ?? '');
    if (value === null) return;
    setProductNote(productId, value.trim());
    renderAll();
  };

  /* ------------------------------------------------------------- avisos */

  let reminderProductId: string | null = null;

  const closeReminderModal = (): void => {
    if (els.reminderModal) els.reminderModal.hidden = true;
    if (els.reminderError) els.reminderError.hidden = true;
    reminderProductId = null;
  };

  function setReminderError(message: string): void {
    if (!els.reminderError) return;
    els.reminderError.textContent = message;
    els.reminderError.hidden = false;
  }

  function openReminderModal(productId: string): void {
    const product = getRadarProducts().find((p) => p.id === productId);
    if (!product || !els.reminderModal || !els.reminderForm) return;

    reminderProductId = productId;
    const dateInput = els.reminderForm.querySelector<HTMLInputElement>('input[name="date"]');
    const timeInput = els.reminderForm.querySelector<HTMLInputElement>('input[name="time"]');
    const reasonInput = els.reminderForm.querySelector<HTMLSelectElement>('select[name="reason"]');
    const noteInput = els.reminderForm.querySelector<HTMLInputElement>('input[name="note"]');
    const now = new Date();
    const existing = getScheduledReminder(productId);

    if (els.reminderProduct) {
      els.reminderProduct.textContent = existing
        ? `Aviso activo · ${remindWhen.format(new Date(existing.remindAt))} · ${existing.reason}`
        : product.title;
    }
    if (els.reminderError) els.reminderError.hidden = true;

    if (existing) {
      const at = new Date(existing.remindAt);
      if (dateInput) dateInput.value = toDateValue(at);
      if (timeInput) timeInput.value = toTimeValue(at);
      if (reasonInput) reasonInput.value = existing.reason;
      if (noteInput) noteInput.value = existing.reasonNote ?? '';
      if (els.reminderCancel) els.reminderCancel.hidden = false;
    } else {
      // Por defecto: mañana a las 10:00.
      const def = new Date(now.getTime() + 24 * 60 * 60 * 1000);
      def.setHours(10, 0, 0, 0);
      if (dateInput) {
        dateInput.min = toDateValue(now);
        dateInput.value = toDateValue(def);
      }
      if (timeInput) timeInput.value = '10:00';
      if (reasonInput) reasonInput.value = reasonInput.options[0]?.value ?? '';
      if (noteInput) noteInput.value = '';
      if (els.reminderCancel) els.reminderCancel.hidden = true;
    }

    els.reminderModal.hidden = false;
    dateInput?.focus();
  }

  const toDateValue = (d: Date): string =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const toTimeValue = (d: Date): string =>
    `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;

  els.reminderForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!reminderProductId) return;
    const product = getRadarProducts().find((p) => p.id === reminderProductId);
    const date = els.reminderForm.querySelector<HTMLInputElement>('input[name="date"]')?.value ?? '';
    const time = els.reminderForm.querySelector<HTMLInputElement>('input[name="time"]')?.value ?? '';
    const reason = els.reminderForm.querySelector<HTMLSelectElement>('select[name="reason"]')?.value ?? '';
    const note = els.reminderForm.querySelector<HTMLInputElement>('input[name="note"]')?.value.trim() ?? '';

    if (!date || !time) {
      setReminderError('Elige fecha y hora.');
      return;
    }
    const remindAt = new Date(`${date}T${time}`).getTime();
    if (!Number.isFinite(remindAt)) {
      setReminderError('Fecha u hora no válidas.');
      return;
    }
    if (remindAt <= Date.now() + 60_000) {
      setReminderError('La fecha y hora deben estar al menos un minuto en el futuro.');
      return;
    }

    const result = await createReminder({
      productId: reminderProductId,
      title: product?.title ?? 'Producto de Mi Radar',
      remindAt,
      reason,
      reasonNote: note || undefined,
    });
    if (result.ok) {
      closeReminderModal();
      showToast('Aviso programado. Te escribiremos el día indicado.');
      renderAll();
    } else {
      setReminderError(result.message ?? 'No se pudo programar el aviso.');
    }
  });

  els.reminderCancel?.addEventListener('click', async () => {
    const reminder = reminderProductId ? getScheduledReminder(reminderProductId) : null;
    if (!reminder) {
      closeReminderModal();
      return;
    }
    const result = await cancelReminder(reminder.id);
    closeReminderModal();
    if (result.ok) {
      showToast('Aviso eliminado.');
      renderAll();
    } else {
      showToast(result.message ?? 'No se pudo eliminar el aviso.', true);
    }
  });

  document.querySelectorAll<HTMLElement>('[data-reminder-close]').forEach((el) => {
    el.addEventListener('click', closeReminderModal);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && els.reminderModal && !els.reminderModal.hidden) closeReminderModal();
    if (event.key === 'Escape' && els.alertModal && !els.alertModal.hidden) closeAlertModal();
  });

  /* ------------------------------------------------- alertas de precio objetivo */

  let alertProductId: string | null = null;

  const closeAlertModal = (): void => {
    if (els.alertModal) els.alertModal.hidden = true;
    if (els.alertError) els.alertError.hidden = true;
    alertProductId = null;
  };

  function setAlertError(message: string): void {
    if (!els.alertError) return;
    els.alertError.textContent = message;
    els.alertError.hidden = false;
  }

  function openAlertModal(productId: string): void {
    const product = getRadarProducts().find((p) => p.id === productId);
    if (!product || !els.alertModal || !els.alertForm) return;
    alertProductId = productId;
    const targetInput = els.alertForm.querySelector<HTMLInputElement>('input[name="target"]');
    const stockInput = els.alertForm.querySelector<HTMLInputElement>('input[name="stock"]');
    if (els.alertProduct) {
      const current = typeof product.priceValue === 'number' ? euro.format(product.priceValue) : product.price;
      els.alertProduct.textContent = `${product.title} · ahora ${current}`;
    }
    if (els.alertError) els.alertError.hidden = true;
    if (targetInput) targetInput.value = product.targetPrice ? String(product.targetPrice) : '';
    if (stockInput) stockInput.checked = product.notifyStock === true;
    if (els.alertRemove) els.alertRemove.hidden = product.priceAlert?.status !== 'triggered' && !(product.targetPrice && product.targetPrice > 0);
    els.alertModal.hidden = false;
    targetInput?.focus();
  }

  els.alertForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!alertProductId) return;
    const targetRaw = els.alertForm?.querySelector<HTMLInputElement>('input[name="target"]')?.value ?? '';
    const stock = els.alertForm?.querySelector<HTMLInputElement>('input[name="stock"]')?.checked ?? false;
    const targetPrice = Number(String(targetRaw).replace(',', '.'));
    if (!Number.isFinite(targetPrice) || targetPrice <= 0) {
      setAlertError('Escribe un precio objetivo válido en euros.');
      return;
    }
    const result = await setProductAlert({
      productId: alertProductId,
      targetPrice,
      notifyPriceDrop: true,
      notifyStock: stock,
    });
    if (result.ok) {
      closeAlertModal();
      showToast(`Alerta activa: te avisamos si baja de ${euro.format(targetPrice)}.`);
      renderAll();
    } else {
      setAlertError(result.message ?? 'No se pudo activar la alerta.');
    }
  });

  els.alertRemove?.addEventListener('click', async () => {
    if (!alertProductId) return;
    // Quitar la alerta: sin objetivo el worker deja de vigilar este producto.
    const result = await setProductAlert({ productId: alertProductId, clear: true });
    closeAlertModal();
    if (result.ok) {
      showToast('Alerta de precio eliminada.');
      renderAll();
    } else {
      showToast(result.message ?? 'No se pudo quitar la alerta.', true);
    }
  });

  document.querySelectorAll<HTMLElement>('[data-alert-close]').forEach((el) => {
    el.addEventListener('click', closeAlertModal);
  });

  /* ------------------------------------------------------------ eventos */

  els.tabs?.addEventListener('click', (event) => {
    const target = event.target as Element;
    const deleteEl = target.closest<HTMLElement>('[data-project-delete]');
    if (deleteEl) {
      const id = deleteEl.dataset.projectDelete ?? '';
      if (id && window.confirm('¿Eliminar esta lista? Los productos volverán a General.')) {
        deleteProject(id);
        renderAll();
      }
      return;
    }
    const tab = target.closest<HTMLElement>('[data-project-tab]');
    if (tab) {
      activeProjectId = tab.dataset.projectTab ?? 'general';
      renderAll();
    }
  });

  els.newProject?.addEventListener('click', () => openModal());

  els.grid?.addEventListener('click', (event) => {
    const target = event.target as Element;

    const noteBtn = target.closest<HTMLElement>('[data-note-edit]');
    if (noteBtn) {
      editNote(noteBtn.dataset.noteEdit ?? '');
      return;
    }

    const reminderBtn = target.closest<HTMLElement>('[data-reminder-open]');
    if (reminderBtn?.dataset.reminderOpen) {
      openReminderModal(reminderBtn.dataset.reminderOpen);
      return;
    }

    const alertBtn = target.closest<HTMLElement>('[data-alert-open]');
    if (alertBtn?.dataset.alertOpen) {
      openAlertModal(alertBtn.dataset.alertOpen);
      return;
    }

    const shareBtn = target.closest<HTMLElement>('[data-share-open]');
    if (shareBtn?.dataset.shareOpen) {
      const product = getRadarProducts().find((p) => p.id === shareBtn.dataset.shareOpen);
      if (product) openSharePanel({ productId: product.id, title: product.title });
      return;
    }

    const removeBtn = target.closest<HTMLElement>('[data-remove-id]');
    if (removeBtn) {
      removeProduct(removeBtn.dataset.removeId ?? '');
      renderAll();
    }
  });

  /* --------------------------------------- arrastrar y soltar sobre las listas */

  const DRAG_START_PX = 6; // ratón: píxeles que hay que mover antes de coger la tarjeta
  const LONG_PRESS_MS = 350; // táctil y lápiz: pulsación larga para cogerla (así el scroll sigue funcionando)
  const LONG_PRESS_SLOP_PX = 10; // táctil: lo que puede moverse el dedo mientras se espera
  const EDGE_SCROLL_PX = 70; // cerca del borde de la pantalla la página se desplaza sola
  const PAGE_SCROLL_PX_PER_SEC = 1080; // velocidad máxima del auto-scroll (pegado al borde)
  const BAR_SCROLL_PX_PER_SEC = 600; // y la de la barra de listas

  interface DragState {
    productId: string;
    title: string;
    image: string;
    pointerId: number;
    pointerType: string;
    startX: number;
    startY: number;
    x: number;
    y: number;
    active: boolean;
    card: HTMLElement;
    ghost: HTMLElement | null;
    overProject: string | null;
    timer: number | null;
    raf: number;
    /** Instante del último fotograma del auto-scroll (la velocidad no depende de los fps). */
    lastTick: number;
  }

  let drag: DragState | null = null;
  /** Tras arrastrar, el clic que dispara el navegador al soltar se ignora. */
  let suppressClickUntil = 0;

  const shortTitle = (title: string): string => (title.length > 38 ? `${title.slice(0, 37)}…` : title);

  /** Lista en la que está ahora el producto. */
  const currentProjectOf = (productId: string): string | null =>
    getProjects().find((project) => project.products.some((p) => p.id === productId))?.id ?? null;

  /** Marca las listas: la que hay bajo el puntero se ilumina y la actual del producto se atenúa. */
  function markTabs(): void {
    if (!els.tabs || !drag) return;
    const current = currentProjectOf(drag.productId);
    const active = drag.active;
    const over = drag.overProject;
    els.tabs.querySelectorAll<HTMLElement>('[data-project-tab]').forEach((tab) => {
      const id = tab.dataset.projectTab ?? '';
      tab.classList.toggle('is-drop-over', active && id === over && id !== current);
      tab.classList.toggle('is-drop-current', active && id === current);
    });
  }

  function updateDrag(): void {
    if (!drag || !drag.active) return;
    if (drag.ghost) {
      // La tarjeta fantasma sigue al puntero sin salirse de la pantalla.
      const x = Math.min(drag.x + 14, window.innerWidth - drag.ghost.offsetWidth - 8);
      drag.ghost.style.transform = `translate3d(${Math.max(8, Math.round(x))}px, ${Math.round(drag.y + 14)}px, 0)`;
    }
    const under = document.elementFromPoint(drag.x, drag.y);
    drag.overProject = under?.closest<HTMLElement>('[data-project-tab]')?.dataset.projectTab ?? null;
    markTabs();
  }

  /**
   * Auto-scroll: cerca del borde de la pantalla, o de los extremos de la barra de listas.
   * La distancia recorrida depende del tiempo transcurrido, no del número de fotogramas:
   * en un móvil lento (pocos fps) la velocidad es la misma.
   */
  function autoScroll(now: number): void {
    if (!drag || !drag.active) return;
    const dt = Math.min(64, drag.lastTick ? now - drag.lastTick : 16);
    drag.lastTick = now;
    // 0 en el límite de la zona y 1 pegado al borde.
    const nearTop = Math.max(0, Math.min(1, (EDGE_SCROLL_PX - drag.y) / EDGE_SCROLL_PX));
    const nearBottom = Math.max(0, Math.min(1, (drag.y - (window.innerHeight - EDGE_SCROLL_PX)) / EDGE_SCROLL_PX));
    const dy = Math.round((nearBottom - nearTop) * PAGE_SCROLL_PX_PER_SEC * (dt / 1000));
    let moved = false;
    if (dy !== 0) {
      const before = window.scrollY;
      // La web usa scroll-behavior: smooth; con "instant" cada paso es inmediato (si no, cada
      // llamada reiniciaría la animación y la página apenas avanzaría).
      window.scrollBy({ top: dy, behavior: 'instant' });
      moved = window.scrollY !== before;
    }
    const bar = els.tabs;
    if (bar) {
      const rect = bar.getBoundingClientRect();
      if (drag.y >= rect.top - 12 && drag.y <= rect.bottom + 12) {
        const step = Math.max(1, Math.round(BAR_SCROLL_PX_PER_SEC * (dt / 1000)));
        const before = bar.scrollLeft;
        if (drag.x < rect.left + 44) bar.scrollLeft -= step;
        else if (drag.x > rect.right - 44) bar.scrollLeft += step;
        moved = moved || bar.scrollLeft !== before;
      }
    }
    if (moved) updateDrag();
    drag.raf = requestAnimationFrame(autoScroll);
  }

  function beginDrag(): void {
    if (!drag || drag.active) return;
    if (drag.timer !== null) {
      window.clearTimeout(drag.timer);
      drag.timer = null;
    }
    drag.active = true;
    const ghost = document.createElement('div');
    ghost.className = 'radar-drag-ghost';
    ghost.setAttribute('aria-hidden', 'true');
    const image = document.createElement('img');
    image.src = drag.image;
    image.alt = '';
    image.draggable = false;
    const label = document.createElement('span');
    label.textContent = drag.title;
    ghost.append(image, label);
    document.body.append(ghost);
    drag.ghost = ghost;
    drag.card.classList.add('is-dragging');
    document.body.classList.add('radar-is-dragging');
    els.tabs?.classList.add('is-drop-mode');
    window.getSelection()?.removeAllRanges();
    // Vibración al coger la tarjeta (sólo si el navegador ya permite vibrar: exige una interacción previa).
    if (drag.pointerType !== 'mouse' && navigator.userActivation?.hasBeenActive) navigator.vibrate?.(12);
    drag.raf = requestAnimationFrame(autoScroll);
    updateDrag();
  }

  /**
   * Con la tarjeta cogida en táctil, el dedo no debe desplazar la página. Este escuchador no pasivo
   * sólo existe mientras hay una tarjeta pulsada: dejarlo siempre puesto frenaría el scroll de toda la página.
   */
  function blockTouchScroll(event: TouchEvent): void {
    if (drag?.active && event.cancelable) event.preventDefault();
  }

  /** Limpia todo el estado del arrastre (se haya soltado, cancelado o interrumpido). */
  function endDrag(): void {
    if (!drag) return;
    const state = drag;
    document.removeEventListener('pointermove', onPointerMove);
    document.removeEventListener('pointerup', onPointerUp);
    document.removeEventListener('pointercancel', onPointerCancel);
    document.removeEventListener('touchmove', blockTouchScroll);
    if (state.timer !== null) window.clearTimeout(state.timer);
    cancelAnimationFrame(state.raf);
    state.ghost?.remove();
    state.card.classList.remove('is-dragging');
    document.body.classList.remove('radar-is-dragging');
    els.tabs?.classList.remove('is-drop-mode');
    els.tabs?.querySelectorAll('.is-drop-over, .is-drop-current').forEach((tab) => {
      tab.classList.remove('is-drop-over', 'is-drop-current');
    });
    drag = null;
  }

  /** Mueve el producto a la lista (soltado o selector). Devuelve true si se movió. */
  function dropOn(productId: string, title: string, projectId: string): boolean {
    const target = getProjects().find((project) => project.id === projectId);
    const from = currentProjectOf(productId);
    if (!target || !from) return false;
    if (from === target.id) {
      showToast(`«${shortTitle(title)}» ya está en ${target.name}.`);
      return false;
    }
    flashProjectId = target.id;
    if (!moveProduct(productId, target.id)) {
      flashProjectId = null;
      return false;
    }
    showToast(`«${shortTitle(title)}» → ${target.name}`);
    window.setTimeout(() => {
      if (flashProjectId === target.id) {
        flashProjectId = null;
        renderTabs(getProjects());
      }
    }, 1000);
    return true;
  }

  function onPointerMove(event: PointerEvent): void {
    if (!drag || event.pointerId !== drag.pointerId) return;
    drag.x = event.clientX;
    drag.y = event.clientY;
    if (!drag.active) {
      const moved = Math.hypot(drag.x - drag.startX, drag.y - drag.startY);
      if (drag.pointerType === 'mouse') {
        if (event.buttons === 0) {
          endDrag(); // el botón se soltó fuera de la ventana
          return;
        }
        if (moved >= DRAG_START_PX) beginDrag();
      } else if (moved > LONG_PRESS_SLOP_PX) {
        endDrag(); // el dedo se mueve antes de tiempo: es un desplazamiento, no un arrastre
      }
      return;
    }
    if (drag.pointerType === 'mouse' && event.buttons === 0) {
      endDrag();
      return;
    }
    event.preventDefault();
    updateDrag();
  }

  function onPointerUp(event: PointerEvent): void {
    if (!drag || event.pointerId !== drag.pointerId) return;
    const state = drag;
    let target: string | null = null;
    if (state.active) {
      suppressClickUntil = performance.now() + 400;
      state.x = event.clientX;
      state.y = event.clientY;
      updateDrag(); // se decide con el punto exacto del soltado
      target = state.overProject;
    }
    endDrag();
    if (target) dropOn(state.productId, state.title, target);
  }

  function onPointerCancel(event: PointerEvent): void {
    if (!drag || event.pointerId !== drag.pointerId) return;
    endDrag();
  }

  els.grid?.addEventListener('pointerdown', (event) => {
    if (drag || !event.isPrimary) return;
    if (event.pointerType === 'mouse' && event.button !== 0) return;
    const target = event.target as Element;
    // Los botones, el selector y el enlace de compra son para hacer clic, no para arrastrar.
    if (target.closest('button, select, option, input, textarea, label, a.radar-card-buy')) return;
    const card = target.closest<HTMLElement>('.radar-card[data-product-id]');
    if (!card) return;
    if (getProjects().length < 2) return; // sin otra lista no hay dónde soltarla
    const productId = card.dataset.productId ?? '';
    const product = getRadarProducts().find((p) => p.id === productId);
    if (!product) return;
    drag = {
      productId,
      title: product.title,
      image: product.image,
      pointerId: event.pointerId,
      pointerType: event.pointerType,
      startX: event.clientX,
      startY: event.clientY,
      x: event.clientX,
      y: event.clientY,
      active: false,
      card,
      ghost: null,
      overProject: null,
      timer: null,
      raf: 0,
      lastTick: 0,
    };
    document.addEventListener('pointermove', onPointerMove, { passive: false });
    document.addEventListener('pointerup', onPointerUp);
    document.addEventListener('pointercancel', onPointerCancel);
    if (event.pointerType !== 'mouse') {
      document.addEventListener('touchmove', blockTouchScroll, { passive: false });
      drag.timer = window.setTimeout(() => {
        if (drag && !drag.active) beginDrag();
      }, LONG_PRESS_MS);
    }
  });

  // Que el navegador no arranque su propio arrastre de imágenes/enlaces (cancelaría el nuestro).
  els.grid?.addEventListener('dragstart', (event) => event.preventDefault());
  // La pulsación larga abriría el menú contextual (guardar imagen…) en lugar de arrastrar.
  document.addEventListener('contextmenu', (event) => {
    if (drag && (drag.active || drag.timer !== null)) event.preventDefault();
  });
  document.addEventListener('selectstart', (event) => {
    if (drag?.active) event.preventDefault();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drag) endDrag();
  });
  window.addEventListener('blur', () => {
    if (drag) endDrag();
  });
  document.addEventListener(
    'click',
    (event) => {
      if (performance.now() < suppressClickUntil) {
        event.preventDefault();
        event.stopPropagation();
      }
    },
    true,
  );

  // "Mover a…": la misma acción sin arrastrar (teclado, lectores de pantalla, móvil).
  els.grid?.addEventListener('change', (event) => {
    const select = (event.target as Element | null)?.closest<HTMLSelectElement>('select[data-move-product]');
    if (!select) return;
    const productId = select.dataset.moveProduct ?? '';
    const title = getRadarProducts().find((p) => p.id === productId)?.title ?? '';
    if (dropOn(productId, title, select.value)) {
      // La tarjeta desaparece de esta lista: el foco pasa a la lista activa para no perderlo.
      els.tabs?.querySelector<HTMLElement>('.radar-tab.is-active')?.focus();
    } else {
      renderAll();
    }
  });

  els.exitCards?.addEventListener('click', (event) => {
    const target = event.target as Element;
    const btn = target.closest<HTMLElement>('[data-exit-resolve]');
    if (!btn) return;
    const status = btn.dataset.exitResolve as 'purchased' | 'dismissed';
    const productId = btn.dataset.exitProduct ?? '';
    if (productId) resolveExit(productId, status);
    renderExits();
  });

  /* ------------------------------------------------------------- sesión */

  function updateStatus(user: { email: string; name?: string } | null): void {
    // Página privada: sin sesión siempre se vuelve a tradylor.com.
    if (!user) {
      window.location.replace('https://tradylor.com');
    }
  }

  onRadarChange(renderAll);
  onAuthChange((user) => updateStatus(user));

  renderAll();
  void getSession(true).then((session) => {
    updateStatus(session.authenticated ? session.user : null);
    renderAll();
  });
</script>
