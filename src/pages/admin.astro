<script is:inline define:vars={{ associateTag: getAmazonAssociateTag() }}>
  window.TRADYLOR_ASSOCIATE_TAG = associateTag;
</script>
<script is:inline>
  // Inicialización de estado y elementos DOM
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs
    const inputScrapeUrl = document.getElementById('inputScrapeUrl');
    const btnScrape = document.getElementById('btnScrape');
    const btnSpinner = btnScrape ? btnScrape.querySelector('.btn-spinner') : null;
    const btnText = btnScrape ? btnScrape.querySelector('.btn-text') : null;

    const scrapeStatusAlert = document.getElementById('scrapeStatusAlert');
    const statusAlertIcon = document.getElementById('statusAlertIcon');
    const statusAlertTitle = document.getElementById('statusAlertTitle');
    const statusAlertText = document.getElementById('statusAlertText');

    const productForm = document.getElementById('productForm');
    const prodId = document.getElementById('prodId');
    const prodTitle = document.getElementById('prodTitle');
    const prodPrice = document.getElementById('prodPrice');
    const prodOriginalPrice = document.getElementById('prodOriginalPrice');
    const prodCategory = document.getElementById('prodCategory');
    const prodMerchant = document.getElementById('prodMerchant');
    const prodAffiliateUrl = document.getElementById('prodAffiliateUrl');
    const prodBuyNowUrl = document.getElementById('prodBuyNowUrl');

    // Autodetección de ASIN: al pegar el enlace de afiliado o la URL del producto
    // se genera el enlace de Compra Directa (Buy Now) si el campo está vacío.
    const AMAZON_ASIN_IN_PATH_RE = /\/(?:dp|gp\/product|gp\/aw\/d|product)\/([A-Za-z0-9]{10})(?:[/?#]|$)/;
    const ASIN_QUERY_RE = /[?&]asin=([A-Za-z0-9]{10})(?:[&#]|$)/;
    function extractAsinFromUrl(url) {
      const raw = String(url || '').trim();
      if (!raw) return '';
      const pathAndQuery = (() => {
        try {
          const u = new URL(raw);
          return u.pathname + u.search;
        } catch {
          return raw;
        }
      })();
      const match = AMAZON_ASIN_IN_PATH_RE.exec(pathAndQuery) || ASIN_QUERY_RE.exec(pathAndQuery);
      return match ? match[1].toUpperCase() : '';
    }
    function buildAmazonCartUrl(asin) {
      const clean = String(asin || '').trim().toUpperCase();
      if (!/^[A-Z0-9]{10}$/.test(clean)) return '';
      const tag = window.TRADYLOR_ASSOCIATE_TAG || 'tradylor-21';
      const params = new URLSearchParams({ 'ASIN.1': clean, 'Quantity.1': '1', AssociateTag: tag });
      return `https://www.amazon.es/gp/aws/cart/add.html?${params.toString()}`;
    }
    function autoFillBuyNow(url) {
      const asin = extractAsinFromUrl(url);
      if (!asin || !prodBuyNowUrl) return;
      // Compra directa generada: cesta de Amazon con el tag → tramitación del pedido.
      if (!prodBuyNowUrl.value.trim()) {
        prodBuyNowUrl.value = buildAmazonCartUrl(asin);
      }
    }
    // Sincronización bidireccional entre "URL del Producto" y "Enlace de Afiliado Final".
    function syncUrlFields(source, target) {
      const value = String(source.value || '').trim();
      if (value && target && !String(target.value || '').trim()) target.value = value;
    }
    if (prodAffiliateUrl) {
      prodAffiliateUrl.addEventListener('input', () => {
        syncUrlFields(prodAffiliateUrl, inputScrapeUrl);
        autoFillBuyNow(prodAffiliateUrl.value);
      });
    }
    if (inputScrapeUrl) {
      inputScrapeUrl.addEventListener('input', () => {
        syncUrlFields(inputScrapeUrl, prodAffiliateUrl);
        autoFillBuyNow(prodAffiliateUrl.value);
      });
    }
    const prodImage = document.getElementById('prodImage');
    const prodBadge = document.getElementById('prodBadge');
    const prodDescription = document.getElementById('prodDescription');
    const prodVerdict = document.getElementById('prodVerdict');
    const prodTechSheet = document.getElementById('prodTechSheet');
    const prodPros = document.getElementById('prodPros');
    const prodCons = document.getElementById('prodCons');
    const btnResetForm = document.getElementById('btnResetForm');
    const btnSaveProduct = document.getElementById('btnSaveProduct');
    const btnAiEnrich = document.getElementById('btnAiEnrich');

    // Extras del último scrape (specs, marca, valoración, reseñas) para el enriquecimiento local.
    let scrapeExtras = { brand: '', rating: null, reviewsCount: null, specs: null };
    // Galería de imágenes del último scrape (la primera es la principal).
    let scrapedGallery = [];
    const galleryThumbs = document.getElementById('galleryThumbs');
    const galleryFileInput = document.getElementById('galleryFileInput');
    const galleryUrlInput = document.getElementById('galleryUrlInput');
    const btnAddImageUrl = document.getElementById('btnAddImageUrl');

    // Preview
    const previewImg = document.getElementById('previewImg');
    const previewEmptyImage = document.getElementById('previewEmptyImage');
    const previewPrev = document.getElementById('previewPrev');
    const previewNext = document.getElementById('previewNext');
    const previewCounter = document.getElementById('previewCounter');
    let previewGallery = [];
    let previewIndex = 0;
    const previewCategory = document.getElementById('previewCategory');
    const previewBadge = document.getElementById('previewBadge');
    const previewMerchant = document.getElementById('previewMerchant');
    const previewTitle = document.getElementById('previewTitle');
    const previewDesc = document.getElementById('previewDesc');
    const previewPrice = document.getElementById('previewPrice');
    const previewOriginalPrice = document.getElementById('previewOriginalPrice');
    const previewDiscount = document.getElementById('previewDiscount');
    const previewProsList = document.getElementById('previewProsList');
    const previewBulletsWrap = document.getElementById('previewBulletsWrap');
    const previewAffiliateBtn = document.getElementById('previewAffiliateBtn');
    const previewBtnMerchant = document.getElementById('previewBtnMerchant');

    // Listado de productos
    const productsTableBody = document.getElementById('productsTableBody');
    const inputFilterList = document.getElementById('inputFilterList');

    // Helper para mostrar feedback de alerta
    function showAlert(type, title, message) {
      if (!scrapeStatusAlert) return;
      scrapeStatusAlert.hidden = false;
      scrapeStatusAlert.className = `status-alert alert-${type}`;
      
      if (type === 'success') {
        statusAlertIcon.textContent = '✅';
      } else if (type === 'warning') {
        statusAlertIcon.textContent = '⚠️';
      } else if (type === 'loading') {
        statusAlertIcon.textContent = '⏳';
      } else {
        statusAlertIcon.textContent = '❌';
      }

      statusAlertTitle.textContent = title;
      statusAlertText.textContent = message;
    }

    function hideAlert() {
      if (scrapeStatusAlert) scrapeStatusAlert.hidden = true;
    }

    function setProductField(field, value) {
      if (!field || value === undefined || value === null) return;
      field.value = String(value);
      field.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // Rellena un campo SOLO si está vacío: el scraper nunca pisa lo escrito a mano.
    function fillIfEmpty(field, value) {
      if (!field || value === undefined || value === null || value === '') return;
      if (String(field.value || '').trim() !== '') return;
      setProductField(field, value);
    }

    // ── Vídeos en la galería (helper + modal centrado) ──────────────────────
    function isVideoUrl(url) {
      const u = String(url || '').trim().toLowerCase();
      if (!u) return false;
      if (/\.(mp4|webm|mov|m4v|ogv)(\?|#|$)/.test(u)) return true;
      return /(youtube\.com|youtu\.be|vimeo\.com|dailymotion\.com)/.test(u);
    }

    function videoEmbedUrl(url, autoplay) {
      const u = String(url || '').trim();
      const yt = u.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/i);
      if (yt) return `https://www.youtube.com/embed/${yt[1]}${autoplay ? '?autoplay=1&mute=1' : ''}`;
      const vimeo = u.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
      if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}${autoplay ? '?autoplay=1&mute=1' : ''}`;
      const dailymotion = u.match(/dailymotion\.com\/(?:video|embed\/video)\/([\w]+)/i);
      if (dailymotion) return `https://www.dailymotion.com/embed/video/${dailymotion[1]}${autoplay ? '?autoplay=1' : ''}`;
      return null;
    }

    // Miniatura (fotograma) del vídeo: YouTube/Vimeo/Dailymotion dan URL de
    // imagen; los archivos directos (mp4/webm) se previsualizan con <video>.
    function videoThumbUrl(url) {
      const u = String(url || '').trim();
      const yt = u.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/i);
      if (yt) return `https://i.ytimg.com/vi/${yt[1]}/hqdefault.jpg`;
      const vimeo = u.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
      if (vimeo) return `https://vumbnail.com/${vimeo[1]}.jpg`;
      const dailymotion = u.match(/dailymotion\.com\/(?:video|embed\/video)\/([\w]+)/i);
      if (dailymotion) return `https://www.dailymotion.com/thumbnail/video/${dailymotion[1]}`;
      return null;
    }

    const videoModal = document.getElementById('videoModal');
    const videoModalBody = document.getElementById('videoModalBody');

    function openVideoModal(url) {
      if (!videoModal || !videoModalBody || !url) return;
      const embed = videoEmbedUrl(url, true);
      if (embed) {
        const iframe = document.createElement('iframe');
        iframe.src = embed;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        videoModalBody.appendChild(iframe);
      } else {
        const video = document.createElement('video');
        video.src = url;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        videoModalBody.appendChild(video);
      }
      videoModal.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeVideoModal() {
      if (!videoModal) return;
      videoModal.hidden = true;
      if (videoModalBody) videoModalBody.innerHTML = '';
      document.body.style.overflow = '';
    }

    if (videoModal) {
      videoModal.addEventListener('click', (e) => {
        if (e.target && e.target.closest && e.target.closest('[data-video-modal-close]')) closeVideoModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !videoModal.hidden) closeVideoModal();
      });
    }

    // Renderiza la galería de imágenes/vídeos como miniaturas seleccionables.
    // La imagen principal (prodImage) se marca con un borde destacado;
    // los vídeos se reproducen en el modal centrado.
    function renderGallery() {
      if (!galleryThumbs) return;
      galleryThumbs.innerHTML = '';
      const current = (prodImage.value || '').trim();
      if (!scrapedGallery.length) {
        galleryThumbs.innerHTML = '<span class="gallery-empty">Sin galería. Analiza un enlace o añade imágenes/vídeos.</span>';
        return;
      }
      scrapedGallery.forEach((url) => {
        const isVideo = isVideoUrl(url);
        const wrap = document.createElement('div');
        wrap.className = 'gallery-item' + (!isVideo && url === current ? ' is-main' : '');

        const thumb = document.createElement('button');
        thumb.type = 'button';
        thumb.className = 'gallery-thumb';

        if (isVideo) {
          thumb.title = 'Reproducir vídeo';
          const still = videoThumbUrl(url);
          if (still) {
            // Plataforma (YouTube/Vimeo/DM): se muestra su miniatura oficial.
            const img = document.createElement('img');
            img.src = still;
            img.className = 'video-still';
            img.alt = 'Miniatura del vídeo';
            img.loading = 'lazy';
            thumb.appendChild(img);
          } else {
            // Archivo directo (mp4/webm): primer fotograma del propio vídeo.
            const vid = document.createElement('video');
            vid.src = url;
            vid.muted = true;
            vid.preload = 'metadata';
            vid.playsInline = true;
            thumb.appendChild(vid);
          }
          const badge = document.createElement('span');
          badge.className = 'gallery-play-badge';
          badge.textContent = '▶';
          wrap.appendChild(badge);
          thumb.addEventListener('click', () => openVideoModal(url));
        } else {
          thumb.title = 'Fijar como imagen principal';
          const img = document.createElement('img');
          img.src = url;
          img.alt = 'Imagen del producto';
          img.loading = 'lazy';
          thumb.appendChild(img);
          thumb.addEventListener('click', () => {
            setProductField(prodImage, url);
            previewIndex = scrapedGallery.indexOf(url);
            if (previewIndex < 0) previewIndex = 0;
            renderGallery();
            updatePreview();
          });
        }

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'gallery-remove';
        removeBtn.title = 'Quitar de la galería';
        removeBtn.textContent = '×';
        removeBtn.addEventListener('click', () => {
          scrapedGallery = scrapedGallery.filter((u) => u !== url);
          if ((prodImage.value || '').trim() === url) {
            const firstImage = scrapedGallery.find((u) => !isVideoUrl(u)) || '';
            setProductField(prodImage, firstImage);
          }
          renderGallery();
          updatePreview();
        });

        wrap.appendChild(thumb);
        wrap.appendChild(removeBtn);
        galleryThumbs.appendChild(wrap);
      });
    }

    // Añade imágenes/vídeos a la galería por URL (separadas por comas/espacios).
    // Acepta URLs de vídeo (YouTube, Vimeo, Dailymotion, mp4/webm) e imágenes.
    function addImagesByUrl() {
      const raw = (galleryUrlInput?.value || '').trim();
      if (!raw) return;
      const parts = raw.split(/[\s,]+/).map((s) => s.trim()).filter(Boolean);
      let addedImages = 0;
      let addedVideos = 0;
      for (let part of parts) {
        // Ruta local válida para la galería (p. ej. /images/products/x.jpg).
        if (part.startsWith('/') && !part.startsWith('//')) {
          if (!scrapedGallery.includes(part)) {
            scrapedGallery.push(part);
            addedImages++;
          }
          continue;
        }
        // Normaliza: acepta también URLs pegadas sin protocolo (youtu.be/..., youtube.com/...).
        if (part.startsWith('//')) part = `https:${part}`;
        else if (!/^https?:\/\//i.test(part)) part = `https://${part}`;
        if (!scrapedGallery.includes(part)) {
          scrapedGallery.push(part);
          if (isVideoUrl(part)) addedVideos++;
          else addedImages++;
        }
      }
      if (galleryUrlInput) galleryUrlInput.value = '';
      if (!addedImages && !addedVideos && parts.length) {
        showAlert('warning', 'URL no válida', 'Introduce una imagen o vídeo (p. ej. https://youtube.com/watch?v=...).');
        return;
      }
      if (addedImages && !(prodImage.value || '').trim()) {
        const firstImage = scrapedGallery.find((u) => !isVideoUrl(u));
        if (firstImage) setProductField(prodImage, firstImage);
      }
      renderGallery();
      updatePreview();
      const bits = [];
      if (addedImages) bits.push(`${addedImages} imagen(es)`);
      if (addedVideos) bits.push(`${addedVideos} vídeo(s)`);
      if (bits.length) showAlert('success', 'Añadido a la galería', bits.join(' y '));
    }

    // Sube archivos de imagen/vídeo al servidor y los añade a la galería.
    async function uploadGalleryFiles(fileList) {
      const files = Array.from(fileList || []).filter(
        (f) => f.type.startsWith('image/') || f.type.startsWith('video/')
      );
      if (!files.length) return;
      if (btnAddImageUrl) btnAddImageUrl.disabled = true;
      showAlert('loading', 'Subiendo archivos...', `${files.length} imagen(es)/vídeo(s) al servidor.`);
      try {
        const fd = new FormData();
        files.forEach((f) => fd.append('images', f));
        const response = await fetch('/api/admin/upload-image', { method: 'POST', body: fd });
        const result = await response.json();
        if (result.success && Array.isArray(result.urls)) {
          for (const url of result.urls) {
            if (!scrapedGallery.includes(url)) scrapedGallery.push(url);
          }
          if (!(prodImage.value || '').trim()) {
            const firstImage = result.urls.find((u) => !isVideoUrl(u));
            if (firstImage) setProductField(prodImage, firstImage);
          }
          renderGallery();
          updatePreview();
          showAlert('success', 'Archivos subidos', `${result.urls.length} archivo(s) añadido(s) a la galería.`);
        } else {
          showAlert('error', 'No se pudieron subir', result.message || 'Error al subir los archivos.');
        }
      } catch (err) {
        console.error(err);
        showAlert('error', 'Error de red', 'No se pudo contactar con /api/admin/upload-image.');
      } finally {
        if (btnAddImageUrl) btnAddImageUrl.disabled = false;
        if (galleryFileInput) galleryFileInput.value = '';
      }
    }

    if (btnAddImageUrl) btnAddImageUrl.addEventListener('click', addImagesByUrl);
    if (galleryUrlInput) galleryUrlInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); addImagesByUrl(); } });
    if (galleryFileInput) galleryFileInput.addEventListener('change', (e) => uploadGalleryFiles(e.target.files));

    // Actualiza la vista previa interactiva en tiempo real
    // Dibuja la imagen/vídeo actual del carrusel y controla flechas/contador.
    // Los vídeos se muestran con su miniatura (fotograma) y botón play encima.
    const previewVideoOverlay = document.getElementById('previewVideoOverlay');
    let previewVideoThumb = null;

    function clearPreviewVideoThumb() {
      if (previewVideoThumb && previewVideoThumb.parentNode) {
        previewVideoThumb.parentNode.removeChild(previewVideoThumb);
      }
      previewVideoThumb = null;
    }

    function renderPreviewImage() {
      if (!previewImg) return;
      const total = previewGallery.length;
      const hasMedia = total > 0;
      clearPreviewVideoThumb();
      previewImg.hidden = !hasMedia;
      if (previewEmptyImage) previewEmptyImage.hidden = hasMedia;

      if (hasMedia) {
        if (previewIndex >= total) previewIndex = 0;
        if (previewIndex < 0) previewIndex = total - 1;
        const current = previewGallery[previewIndex];
        if (isVideoUrl(current)) {
          const still = videoThumbUrl(current);
          if (still) {
            // Plataforma: se ve la miniatura oficial + overlay play.
            previewImg.hidden = false;
            previewImg.src = still;
          } else {
            // Archivo directo: <video> con el primer fotograma + overlay play.
            previewImg.hidden = true;
            const vid = document.createElement('video');
            vid.className = 'preview-video-thumb';
            vid.src = current;
            vid.muted = true;
            vid.preload = 'metadata';
            vid.playsInline = true;
            vid.setAttribute('aria-hidden', 'true');
            const wrapper = previewImg.parentElement;
            if (wrapper) wrapper.insertBefore(vid, previewImg);
            previewVideoThumb = vid;
          }
          if (previewVideoOverlay) previewVideoOverlay.hidden = false;
        } else {
          if (previewVideoOverlay) previewVideoOverlay.hidden = true;
          previewImg.src = current;
        }
      } else if (previewVideoOverlay) {
        previewVideoOverlay.hidden = true;
      }

      const showNav = total > 1;
      if (previewPrev) previewPrev.hidden = !showNav;
      if (previewNext) previewNext.hidden = !showNav;
      if (previewCounter) {
        previewCounter.hidden = !showNav;
        if (showNav) previewCounter.textContent = `${previewIndex + 1} / ${total}`;
      }
    }

    // Flechas del carrusel: navegar por la galería de la vista previa.
    if (previewPrev) previewPrev.addEventListener('click', () => { previewIndex--; renderPreviewImage(); });
    if (previewNext) previewNext.addEventListener('click', () => { previewIndex++; renderPreviewImage(); });
    // Overlay de vídeo de la vista previa: abre el modal centrado.
    if (previewVideoOverlay) {
      previewVideoOverlay.addEventListener('click', () => {
        const current = previewGallery[previewIndex];
        if (current && isVideoUrl(current)) openVideoModal(current);
      });
    }

    function updatePreview() {
      const title = prodTitle.value.trim();
      const price = parseFloat(prodPrice.value) || 0;
      const originalPrice = parseFloat(prodOriginalPrice.value) || 0;
      const category = prodCategory.value.trim();
      const merchant = prodMerchant.value;
      const image = prodImage.value.trim();
      const badge = prodBadge.value.trim();
      const desc = prodDescription.value.trim();
      const url = prodAffiliateUrl.value.trim() || '#';

      if (previewTitle) previewTitle.textContent = title;
      if (previewDesc) previewDesc.textContent = desc;
      if (previewPrice) previewPrice.textContent = `${price.toFixed(2)} €`;
      if (previewCategory) previewCategory.textContent = category;
      if (previewMerchant) previewMerchant.textContent = merchant;
      if (previewBtnMerchant) previewBtnMerchant.textContent = merchant;

      // Carrusel de la vista previa: usa la galería (scrapedGallery) o la imagen principal.
      previewGallery = Array.isArray(scrapedGallery) && scrapedGallery.length
        ? scrapedGallery.slice()
        : (image ? [image] : []);
      if (!previewGallery.length && image) previewGallery = [image];
      if (previewIndex >= previewGallery.length) previewIndex = 0;
      renderPreviewImage();

      if (previewAffiliateBtn) {
        previewAffiliateBtn.href = url;
        previewAffiliateBtn.hidden = !prodAffiliateUrl.value.trim();
      }
      if (previewCategory) previewCategory.hidden = !category;
      if (previewMerchant) previewMerchant.hidden = !merchant;
      if (previewDesc) previewDesc.hidden = !desc;
      if (previewPrice) previewPrice.parentElement.parentElement.hidden = price <= 0;

      if (previewBadge) {
        if (badge) {
          previewBadge.textContent = badge;
          previewBadge.hidden = false;
        } else {
          previewBadge.hidden = true;
        }
      }

      if (previewOriginalPrice && previewDiscount) {
        if (originalPrice > price && price > 0) {
          previewOriginalPrice.textContent = `${originalPrice.toFixed(2)} €`;
          previewOriginalPrice.hidden = false;
          const discountPct = Math.round(((originalPrice - price) / originalPrice) * 100);
          previewDiscount.textContent = `-${discountPct}%`;
          previewDiscount.hidden = false;
        } else {
          previewOriginalPrice.hidden = true;
          previewDiscount.hidden = true;
        }
      }

      if (previewProsList) {
        const pros = prodPros.value
          .split('\n')
          .map((s) => s.trim())
          .filter(Boolean);
        previewProsList.innerHTML = '';
        if (pros.length > 0) {
          if (previewBulletsWrap) previewBulletsWrap.hidden = false;
          pros.slice(0, 3).forEach((pro) => {
            const li = document.createElement('li');
            li.textContent = pro;
            previewProsList.appendChild(li);
          });
        } else {
          if (previewBulletsWrap) previewBulletsWrap.hidden = true;
        }
      }
    }

    // Escuchadores para actualización en vivo del preview
    [
      prodTitle,
      prodPrice,
      prodOriginalPrice,
      prodCategory,
      prodMerchant,
      prodAffiliateUrl,
      prodImage,
      prodBadge,
      prodDescription,
      prodPros,
    ].forEach((el) => {
      if (el) el.addEventListener('input', updatePreview);
    });

    // =========================================================================
    // 1. ANALIZAR URL (Scraping Híbrido con Endpoint API)
    // =========================================================================
    if (btnScrape && inputScrapeUrl) {
      btnScrape.addEventListener('click', async () => {
        const urlToScrape = inputScrapeUrl.value.trim();
        if (!urlToScrape) {
          showAlert('warning', 'URL requerida', 'Por favor, pega el enlace del producto antes de analizar.');
          inputScrapeUrl.focus();
          return;
        }

        // Estado visual de carga
        btnScrape.disabled = true;
        if (btnSpinner) btnSpinner.hidden = false;
        if (btnText) btnText.textContent = 'Extrayendo...';
        showAlert('loading', 'Analizando página externa...', 'Haciendo fetch con User-Agent legítimo y extrayendo OpenGraph/Schemas.');

        try {
          const response = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'scrape', url: urlToScrape }),
          });

          const result = await response.json();

          if (!result.success) {
            showAlert('error', 'Error en análisis', result.message || 'No se pudo procesar la solicitud.');
            return;
          }

          const data = result.data || {};

          // Rellenar campos del formulario SOLO si están vacíos (nunca pisa lo manual).
          fillIfEmpty(prodTitle, data.title || data.name || '');
          fillIfEmpty(prodImage, data.image || '');
          fillIfEmpty(prodDescription, data.description || '');
          fillIfEmpty(prodPrice, data.price ?? '');
          fillIfEmpty(prodOriginalPrice, data.originalPrice ?? '');
          fillIfEmpty(prodCategory, data.category || 'Tecnología');
          fillIfEmpty(prodMerchant, data.merchant || 'Amazon');
          fillIfEmpty(prodBadge, data.badge || '');
          fillIfEmpty(prodVerdict, data.verdict || '');
          fillIfEmpty(prodPros, Array.isArray(data.pros) ? data.pros.join('\n') : '');
          fillIfEmpty(prodCons, Array.isArray(data.cons) ? data.cons.join('\n') : '');
          fillIfEmpty(prodAffiliateUrl, data.affiliateUrl || urlToScrape);

          // Guardar extras del scrape (specs, marca, valoración, reseñas) para
          // que el enriquecimiento local use datos reales.
          scrapeExtras = {
            brand: data.brand || '',
            rating: data.rating ?? null,
            reviewsCount: data.reviewsCount ?? null,
            specs: data.specs && typeof data.specs === 'object' ? data.specs : null,
          };

          // Galería de imágenes: la principal encabeza, luego el resto de vistas.
          scrapedGallery = Array.isArray(data.gallery) && data.gallery.length
            ? data.gallery
            : (data.image ? [data.image] : []);
          renderGallery();

          updatePreview();

          if (result.scraped) {
            showAlert(
              'success',
              'Metadatos extraídos con éxito',
              'Título, imagen, comercio y precio detectados. La IA completa la ficha automáticamente...'
            );
            // Auto-enriquecer con IA: descripción, veredicto, pros/cons e imagen.
            if (typeof runAiEnrich === 'function') {
              window.setTimeout(() => {
                runAiEnrich({ auto: true }).catch(() => {});
              }, 400);
            }
          } else {
            showAlert(
              'warning',
              'Extracción bloqueada por el comercio (403/Anti-bot)',
              result.message || 'La tienda protegió el acceso automático. Por favor, rellena los campos restantes manualmente.'
            );
          }
        } catch (err) {
          console.error(err);
          showAlert(
            'warning',
            'Fallo de conexión',
            'No se pudo comunicar con el endpoint. Puedes rellenar los datos de forma manual.'
          );
        } finally {
          btnScrape.disabled = false;
          if (btnSpinner) btnSpinner.hidden = true;
          if (btnText) btnText.textContent = 'Analizar Enlace';
        }
      });

      // Permitir pulsar Enter en el input de URL para disparar el análisis
      inputScrapeUrl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          btnScrape.click();
        }
      });
    }

    // =========================================================================
    // 2. GUARDAR PRODUCTO (POST al Endpoint)
    // =========================================================================
    if (productForm) {
      productForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        // La imagen principal debe viajar siempre dentro de la galería.
        // Si no hay imagen principal, se toma la primera imagen de la galería
        // (nunca un vídeo); así se puede crear un producto sólo con vídeo.
        let mainImage = prodImage.value.trim();
        if (!mainImage) {
          const firstGalleryImage = scrapedGallery.find((u) => !isVideoUrl(u));
          if (firstGalleryImage) {
            mainImage = firstGalleryImage;
            setProductField(prodImage, firstGalleryImage);
          }
        }
        const galleryToSend = scrapedGallery.slice();
        if (mainImage && !galleryToSend.includes(mainImage)) galleryToSend.unshift(mainImage);

        const productPayload = {
          id: prodId.value.trim() || undefined,
          title: prodTitle.value.trim(),
          price: parseFloat(prodPrice.value) || 0,
          originalPrice: prodOriginalPrice.value ? parseFloat(prodOriginalPrice.value) : undefined,
          category: prodCategory.value.trim() || 'Tecnología',
          merchant: prodMerchant.value || 'Amazon',
          affiliateUrl: prodAffiliateUrl.value.trim(),
          buyNowUrl: prodBuyNowUrl.value.trim() || undefined,
          image: mainImage,
          gallery: galleryToSend.length ? galleryToSend : undefined,
          badge: prodBadge.value.trim() || undefined,
          description: prodDescription.value.trim(),
          verdict: prodVerdict.value.trim() || undefined,
          techSheet: prodTechSheet.value.trim() || undefined,
          pros: prodPros.value
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
          cons: prodCons.value
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
        };

        if (btnSaveProduct) {
          btnSaveProduct.disabled = true;
          btnSaveProduct.classList.add('loading');
        }

        showAlert('loading', 'Guardando producto...', 'Escribiendo en src/data/products.json...');

        try {
          const response = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save', product: productPayload }),
          });

          const result = await response.json();

          if (result.success) {
            // Recargar lista de productos inmediatamente
            await reloadProductsTable();
            document.getElementById('catalogProducts')?.scrollIntoView({ behavior: 'smooth', block: 'start' });

            // Dejar el formulario preparado para un producto nuevo.
            prodId.value = '';
            prodTitle.value = '';
            prodPrice.value = '';
            prodOriginalPrice.value = '';
            prodCategory.value = '';
            prodMerchant.value = '';
            prodAffiliateUrl.value = '';
            prodBuyNowUrl.value = '';
            prodImage.value = '';
            prodBadge.value = '';
            prodDescription.value = '';
            prodVerdict.value = '';
            prodTechSheet.value = '';
            prodPros.value = '';
            prodCons.value = '';
            if (inputScrapeUrl) inputScrapeUrl.value = '';
            scrapedGallery = [];
            scrapeExtras = { brand: '', rating: null, reviewsCount: null, specs: null };
            renderGallery();
            updatePreview();
            showAlert('success', '¡Producto guardado!', result.message || 'El producto ha sido añadido al catálogo.');
          } else {
            showAlert('error', 'Error al guardar', result.message || 'No se pudo guardar el producto.');
          }
        } catch (err) {
          console.error(err);
          showAlert('error', 'Error de red', 'No se pudo enviar la solicitud al servidor.');
        } finally {
          if (btnSaveProduct) {
            btnSaveProduct.disabled = false;
            btnSaveProduct.classList.remove('loading');
          }
        }
      });
    }

    // =========================================================================
    // 2b. ENRIQUECIMIENTO CON IA (texto + imagen) — POST /api/admin/add-product
    //     1) Ficha técnica, pros/contras y veredicto neutral (OpenAI / Claude)
    //     2) Imagen de producto generada con el prompt comercial (OpenAI / Flux)
    //     Rellena el formulario en modo vista previa: quien decide guarda.
    // =========================================================================
    // Enriquecer con IA (usado por el botón y de forma automática tras analizar un enlace).
    const runAiEnrich = async ({ auto = false } = {}) => {
      const title = (prodTitle.value || '').trim();
      if (!title) {
        if (!auto) {
          showAlert('error', 'Falta el título', 'Escribe el título del producto antes de pedir el enriquecimiento con IA.');
          prodTitle.focus();
        }
        return;
      }

      btnAiEnrich.disabled = true;
      btnAiEnrich.classList.add('loading');
      showAlert(
        'loading',
        'Trabajando con IA...',
        auto
          ? 'Sintetizando título, precios y ficha técnica, pros/contras y veredicto...'
          : 'Paso 1: título, ficha y precios con descuento realista · Paso 2: imagen de producto mejorada.'
      );

      try {
        const response = await fetch('/api/admin/add-product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: (prodId.value || '').trim() || undefined,
            title,
            description: (prodDescription.value || '').trim(),
            category: (prodCategory.value || '').trim() || undefined,
            price: parseFloat(prodPrice.value) || undefined,
            originalPrice: prodOriginalPrice.value ? parseFloat(prodOriginalPrice.value) : undefined,
            image: (prodImage.value || '').trim() || undefined,
            affiliateUrl: (prodAffiliateUrl.value || '').trim() || undefined,
            merchant: prodMerchant.value || undefined,
            url: inputScrapeUrl && inputScrapeUrl.value ? inputScrapeUrl.value.trim() || undefined : undefined,
            brand: scrapeExtras.brand || undefined,
            rating: scrapeExtras.rating ?? undefined,
            reviewsCount: scrapeExtras.reviewsCount ?? undefined,
            specs: scrapeExtras.specs || undefined,
            pros: prodPros.value.split('\n').map((s) => s.trim()).filter(Boolean),
            cons: prodCons.value.split('\n').map((s) => s.trim()).filter(Boolean),
            techSheet: (prodTechSheet.value || '').trim() || undefined,
            // En auto solo texto (rápido): la imagen real del scraping se conserva.
            options: { text: true, image: !auto, save: false },
          }),
        });

        let result;
        try {
          result = await response.json();
        } catch {
          // Respuesta no-JSON (p. ej. 504 de proxy en HTML por timeout).
          if (response.ok) {
            showAlert('success', 'Contenido generado con IA', 'Revisa los campos y pulsa «Guardar producto» para publicarlo.');
          } else {
            showAlert(
              'error',
              `El servidor devolvió ${response.status}`,
              response.status === 504 || response.status === 524
                ? 'La llamada a la IA tardó demasiado y un proxy la cortó. Pulsa «Generar con IA» para reintentar solo el texto.'
                : 'Respuesta inesperada del servidor. Revisa los logs o reintenta.'
            );
          }
          return;
        }

        if (result.success) {
          const enriched = result.product || {};
          const flags = result.enrichment || { text: 'skipped', image: 'skipped', warnings: [] };

          if (flags.text === 'ok' || flags.text === 'local') {
            // Título sintetizado: corto, solo la definición del producto.
            if (enriched.title) prodTitle.value = enriched.title;
            if (enriched.description) prodDescription.value = enriched.description;
            if (enriched.verdict) prodVerdict.value = enriched.verdict;
            if (enriched.techSheet) prodTechSheet.value = enriched.techSheet;
            if (Array.isArray(enriched.pros) && enriched.pros.length) prodPros.value = enriched.pros.join('\n');
            if (Array.isArray(enriched.cons) && enriched.cons.length) prodCons.value = enriched.cons.join('\n');
            if (enriched.category && !(prodCategory.value || '').trim()) prodCategory.value = enriched.category;
            // Precios: oferta + original tachado con descuento realista (15–35 %).
            if (Number(enriched.price) > 0) prodPrice.value = String(enriched.price);
            if (Number(enriched.originalPrice) > Number(enriched.price)) {
              prodOriginalPrice.value = String(enriched.originalPrice);
            }
          }
          if (flags.image === 'ok' && enriched.image) {
            // La imagen generada con IA lleva fondo de estudio opaco (#F8F9FA),
            // igual que la ficha y las cards: siempre encaja en el carrusel.
            if (!scrapedGallery.includes(enriched.image)) scrapedGallery.unshift(enriched.image);
            const currentMain = (prodImage.value || '').trim();
            const mainIsLocal = /^\/images\//.test(currentMain);
            // Se hace principal si no había imagen o si la actual es externa
            // (fondo desconocido); la original se conserva en la galería.
            if (!currentMain || !mainIsLocal) setProductField(prodImage, enriched.image);
            renderGallery();
          }

          updatePreview();

          const via = flags.text === 'ok' ? 'IA' : 'local (sin IA)';
          const summary = auto
            ? `Título + ficha + precios generados ${via} · Imagen: conservada (${flags.image === 'ok' ? 'IA añadida a la galería' : 'scraping'})`
            : `Título + ficha + precios: ${via} · Imagen: ${flags.image === 'ok' ? 'generada con fondo de estudio (IA)' : flags.image}`;
          const warnings =
            Array.isArray(flags.warnings) && flags.warnings.length
              ? ` Avisos: ${flags.warnings.join(' | ')}`
              : '';
          showAlert(
            'success',
            'Ficha de producto generada',
            `${summary}. Revisa los campos y pulsa «Guardar producto» para publicarlo.${warnings}`
          );
        } else {
          showAlert('error', 'No se pudo generar la ficha', result.message || 'Revisa la configuración del servidor.');
        }
      } catch (err) {
        console.error(err);
        showAlert(
          'error',
          'No se pudo contactar con el servidor',
          'Fallo al llamar a /api/admin/add-product. Revisa tu conexión o reintenta.'
        );
      } finally {
        btnAiEnrich.disabled = false;
        btnAiEnrich.classList.remove('loading');
      }
    };

    if (btnAiEnrich) {
      btnAiEnrich.addEventListener('click', () => runAiEnrich());
    }

    // =========================================================================
    // 2c. SINTETIZAR TÍTULO AL PEGAR
    //     Al pegar un título largo (Amazon, AliExpress...) se reduce a la
    //     definición del producto para que quepa en las product-cards.
    //     Con IA si hay claves; si no, con la heurística local del servidor.
    // =========================================================================
    let titleSynthTimer = null;
    let titleSynthSeq = 0;
    async function synthesizeTitleField() {
      const snapshot = (prodTitle.value || '').trim();
      if (!snapshot || snapshot.length <= 40) return;
      const seq = ++titleSynthSeq;
      try {
        const response = await fetch('/api/admin/synthesize-title', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: snapshot,
            description: (prodDescription.value || '').trim() || undefined,
            brand: scrapeExtras.brand || undefined,
            category: (prodCategory.value || '').trim() || undefined,
          }),
        });
        const result = await response.json();
        if (seq !== titleSynthSeq) return;
        const shortTitle = String(result?.title || '').trim();
        // Solo aplica si el usuario no siguió escribiendo mientras tanto.
        if (shortTitle && shortTitle !== snapshot && (prodTitle.value || '').trim() === snapshot) {
          setProductField(prodTitle, shortTitle);
          updatePreview();
        }
      } catch (err) {
        console.warn('No se pudo sintetizar el título:', err);
      }
    }
    if (prodTitle) {
      prodTitle.addEventListener('paste', () => {
        window.clearTimeout(titleSynthTimer);
        titleSynthTimer = window.setTimeout(synthesizeTitleField, 500);
      });
    }

    // =========================================================================
    // 3. LIMPIAR FORMULARIO
    // =========================================================================
    if (btnResetForm) {
      btnResetForm.addEventListener('click', () => {
        prodId.value = '';
        prodTitle.value = '';
        prodPrice.value = '';
        prodOriginalPrice.value = '';
        prodCategory.value = '';
        prodMerchant.value = '';
        prodAffiliateUrl.value = '';
        prodBuyNowUrl.value = '';
        prodImage.value = '';
        prodBadge.value = '';
        prodDescription.value = '';
        prodVerdict.value = '';
        prodTechSheet.value = '';
        prodPros.value = '';
        prodCons.value = '';
        if (inputScrapeUrl) inputScrapeUrl.value = '';
        scrapedGallery = [];
        scrapeExtras = { brand: '', rating: null, reviewsCount: null, specs: null };
        renderGallery();
        hideAlert();
        updatePreview();
      });
    }

    // =========================================================================
    // 4. ELIMINAR Y EDITAR PRODUCTOS DE LA TABLA
    // =========================================================================
    async function reloadProductsTable() {
      try {
        const res = await fetch('/api/products/add');
        const data = await res.json();
        if (data.success && Array.isArray(data.products)) {
          renderTableRows(data.products);
        }
      } catch (err) {
        console.error('Error al recargar productos:', err);
      }
    }

    function renderTableRows(products) {
      if (!productsTableBody) return;

      if (products.length === 0) {
        productsTableBody.innerHTML = `
          <tr class="empty-row">
            <td colspan="6">No hay productos registrados en el catálogo aún.</td>
          </tr>
        `;
        return;
      }

      productsTableBody.innerHTML = products
        .map(
          (p) => `
          <tr data-product-id="${p.id}" class="product-row">
            <td class="col-thumb">
              <img src="${p.image}" alt="${p.title}" class="thumb-img" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=800&auto=format&fit=crop'" />
            </td>
            <td class="col-details">
              <a href="/producto/${p.slug || p.id}" class="row-title" target="_blank" rel="noopener" title="Ver ficha pública del producto">${p.title}</a>
              <div class="row-meta">
                <span class="pill-category">${p.category}</span>
                ${p.badge ? `<span class="pill-badge">${p.badge}</span>` : ''}
              </div>
            </td>
            <td class="col-merchant">
              <span class="merchant-badge">${p.merchant}</span>
            </td>
            <td class="col-price">
              <span class="price-val">${Number(p.price).toFixed(2)} €</span>
              ${p.originalPrice ? `<span class="price-old">${Number(p.originalPrice).toFixed(2)} €</span>` : ''}
            </td>
            <td class="col-link">
              <a href="${p.affiliateUrl}" target="_blank" rel="nofollow noopener noreferrer" class="test-link">
                Probar Enlace
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </td>
            <td class="col-actions text-right">
              <button type="button" class="btn-icon-action btn-edit-row" data-id="${p.id}" title="Cargar en formulario">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
              </button>
              <button type="button" class="btn-icon-action btn-delete-row" data-id="${p.id}" title="Eliminar producto">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </td>
          </tr>
        `
        )
        .join('');

      attachRowActions();
    }

    function attachRowActions() {
      // 1. Borrar producto
      document.querySelectorAll('.btn-delete-row').forEach((btn) => {
        btn.onclick = async () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;

          const confirmed = confirm(`¿Estás seguro de que deseas eliminar este producto del catálogo?`);
          if (!confirmed) return;

          showAlert('loading', 'Eliminando producto...', `Eliminando ID: ${id}`);

          try {
            const res = await fetch('/api/products/add', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', id }),
            });
            const data = await res.json();

            if (data.success) {
              showAlert('success', 'Producto Eliminado', 'El producto ha sido retirado de products.json.');
              await reloadProductsTable();
            } else {
              showAlert('error', 'Error al eliminar', data.message || 'No se pudo eliminar el producto.');
            }
          } catch (err) {
            showAlert('error', 'Error de red', 'Fallo al comunicar con el servidor.');
          }
        };
      });

      // 2. Editar producto (cargar en formulario)
      document.querySelectorAll('.btn-edit-row').forEach((btn) => {
        btn.onclick = async () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;

          try {
            const res = await fetch('/api/products/add');
            const data = await res.json();
            const product = (data.products || []).find((p) => p.id === id);

            if (product) {
              prodId.value = product.id || '';
              prodTitle.value = product.title || '';
              prodPrice.value = product.price !== undefined ? product.price : '';
              prodOriginalPrice.value = product.originalPrice !== undefined ? product.originalPrice : '';
              prodCategory.value = product.category || '';
              prodMerchant.value = product.merchant || 'Amazon';
              prodAffiliateUrl.value = product.affiliateUrl || '';
              prodBuyNowUrl.value = product.buyNowUrl || '';
              prodImage.value = product.image || '';
              const badgeValue = product.badge || '';
              if (badgeValue && prodBadge && !Array.from(prodBadge.options).some((o) => o.value === badgeValue)) {
                const customOpt = document.createElement('option');
                customOpt.value = badgeValue;
                customOpt.textContent = badgeValue;
                prodBadge.appendChild(customOpt);
              }
              prodBadge.value = badgeValue;
              prodDescription.value = product.description || '';
              prodVerdict.value = product.verdict || '';
              prodTechSheet.value = product.techSheet || '';
              prodPros.value = Array.isArray(product.pros) ? product.pros.join('\n') : '';
              prodCons.value = Array.isArray(product.cons) ? product.cons.join('\n') : '';

              // Restaurar la galería guardada del producto (evita perderla al volver a guardar).
              scrapedGallery = Array.isArray(product.gallery) && product.gallery.length
                ? product.gallery.slice()
                : (product.image ? [product.image] : []);
              renderGallery();

              if (inputScrapeUrl) inputScrapeUrl.value = product.affiliateUrl || '';

              updatePreview();
              showAlert('success', 'Producto Cargado en Formulario', `Editando "${product.title}". Modifica los campos y pulsa Guardar.`);
              window.scrollTo({ top: productForm.offsetTop - 80, behavior: 'smooth' });
            }
          } catch (err) {
            console.error(err);
          }
        };
      });
    }

    // Filtro buscador en la tabla
    if (inputFilterList) {
      inputFilterList.addEventListener('input', () => {
        const query = inputFilterList.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#productsTableBody tr.product-row');
        rows.forEach((row) => {
          const text = row.textContent ? row.textContent.toLowerCase() : '';
          row.style.display = text.includes(query) ? '' : 'none';
        });
      });
    }

    // Inicializar listeners en los rows SSR iniciales
    attachRowActions();

    // =========================================================================
    // 5. MÓDULO DE AFILIADOS Y MULTI-CATÁLOGO
    // =========================================================================
    const networkList = document.getElementById('networkList');
    const networksCard = document.getElementById('networksCard');
    const removedNetworks = document.getElementById('removedNetworks');
    const unifiedQuery = document.getElementById('unifiedQuery');
    const btnUnifiedSearch = document.getElementById('btnUnifiedSearch');
    const btnFullCatalog = document.getElementById('btnFullCatalog');
    const unifiedResults = document.getElementById('unifiedResults');
    const networkStatusRow = document.getElementById('networkStatusRow');
    const searchStatus = document.getElementById('searchStatus');
    const searchStatusTitle = document.getElementById('searchStatusTitle');
    const searchStatusText = document.getElementById('searchStatusText');
    const filterCategory = document.getElementById('filterCategory');
    const importCategory = document.getElementById('importCategory');
    const resultsToolbar = document.getElementById('resultsToolbar');
    const resultsCount = document.getElementById('resultsCount');
    const btnImportAll = document.getElementById('btnImportAll');
    const btnImportAllLabel = document.getElementById('btnImportAllLabel');
    const bulkProgress = document.getElementById('bulkProgress');
    const bulkProgressFill = document.getElementById('bulkProgressFill');
    let networksCache = [];
    let currentResults = [];
    let isBulkImporting = false;

    function showSearchStatus(type, title, message) {
      if (!searchStatus) return;
      searchStatus.hidden = false;
      searchStatus.className = `status-alert alert-${type}`;
      if (searchStatusTitle) searchStatusTitle.textContent = title;
      if (searchStatusText) searchStatusText.textContent = message;
    }

    async function postNetworks(payload) {
      const res = await fetch('/api/admin/networks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      return res.json();
    }

    function statusLabel(status) {
      return status === 'connected' ? 'Conectada' : status === 'error' ? 'Error' : 'Pendiente';
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function newFieldRowHtml(label = '', secret = true, required = true) {
      return `
        <div class="new-field-row">
          <input class="nf-label" type="text" maxlength="60" placeholder="Etiqueta (ej: API Token)" value="${escapeHtml(label)}" />
          <label class="nf-check"><input type="checkbox" class="nf-secret" ${secret ? 'checked' : ''} /> Secreto</label>
          <label class="nf-check"><input type="checkbox" class="nf-required" ${required ? 'checked' : ''} /> Obligatorio</label>
          <button type="button" class="nf-remove" data-remove-field title="Quitar campo">✕</button>
        </div>`;
    }

    function newNetworkPanelHtml() {
      return `
        <details class="network-item network-new" data-network-new>
          <summary>
            <span class="network-add-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
            <span class="network-main network-add-main">
              <span class="network-name">Añadir afiliado nuevo</span>
              <span class="network-region">Función aparte: crea una red propia con sus campos de credenciales</span>
            </span>
            <span class="network-add-chip">Crear</span>
          </summary>
          <div class="network-body">
            <form class="network-new-form">
              <label class="cred-field">
                <span>Nombre *</span>
                <input type="text" name="name" maxlength="80" required placeholder="Ej: Programa de afiliados de MiTienda" />
              </label>
              <label class="cred-field">
                <span>Región</span>
                <input type="text" name="region" maxlength="60" placeholder="Global / UE" />
              </label>
              <label class="cred-field">
                <span>Descripción</span>
                <input type="text" name="description" maxlength="300" placeholder="Qué ofrece esta red" />
              </label>
              <label class="cred-field">
                <span>URL de documentación</span>
                <input type="text" name="docUrl" maxlength="300" placeholder="https://..." />
              </label>
              <div class="cred-field">
                <span>Color identificativo</span>
                <input type="color" name="color" value="#38bdf8" class="nf-color" />
              </div>
              <div class="new-fields">
                <span class="new-fields-title">Campos de credenciales *</span>
                <div class="new-field-rows">${newFieldRowHtml()}</div>
                <button type="button" class="btn-secondary btn-sm" data-add-field>+ Añadir campo</button>
              </div>
              <div class="network-actions">
                <button type="submit" class="btn-primary btn-sm">Crear afiliado</button>
              </div>
              <p class="network-feedback" data-new-feedback></p>
            </form>
          </div>
        </details>`;
    }

    function renderNetworks(networks) {
      networksCache = networks;
      if (!networkList) return;
      networkList.innerHTML = networks.map((network) => `
        <details class="network-item" data-network-id="${escapeHtml(network.id)}">
          <summary>
            <span class="network-color" style="background:${escapeHtml(network.color)}"></span>
            <span class="network-main">
              <span class="network-name">${escapeHtml(network.name)}</span>
              <span class="network-region">${escapeHtml(network.region)}</span>
            </span>
            <span class="integration-status ${network.status === 'connected' ? 'is-configured' : ''} ${network.status === 'error' ? 'is-error' : ''}">${statusLabel(network.status)}</span>
          </summary>
          <div class="network-body">
            <p class="network-desc">${escapeHtml(network.description)}</p>
            <form class="network-cred-form" data-network-id="${escapeHtml(network.id)}">
              <!-- Honeypot invisible: evita que el gestor de contraseñas del
                   navegador rellene este formulario con el usuario del panel -->
              <input type="text" name="__hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
              ${network.fields.map((field) => `
                <label class="cred-field">
                  <span>${escapeHtml(field.label)}${field.required ? ' *' : ''}</span>
                  <span class="cred-input-wrap">
                    <input
                      type="${field.secret ? 'password' : 'text'}"
                      name="${escapeHtml(field.key)}"
                      placeholder="${escapeHtml(field.hasValue ? '•••••••• (guardado)' : (field.placeholder || 'Sin configurar'))}"
                      autocomplete="${field.secret ? 'new-password' : 'off'}"
                      data-1p-ignore="true"
                      data-lpignore="true"
                      data-form-type="other"
                    />
                    <button type="button" class="cred-eye ${field.secret ? '' : 'is-shown'}" data-cred-eye title="Mostrar u ocultar el valor" aria-label="Mostrar u ocultar el valor">
                      <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                      <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                  </span>
                </label>
              `).join('')}
              <div class="network-actions">
                <span class="network-actions-main">
                  <button type="submit" class="btn-primary btn-sm">Guardar y validar</button>
                  <button type="button" class="btn-secondary btn-sm" data-network-validate="${escapeHtml(network.id)}">Validar</button>
                  <button type="button" class="btn-secondary btn-sm" data-network-reveal="${escapeHtml(network.id)}" title="Muestra u oculta los valores guardados de esta red">Ver</button>
                </span>
                <button type="button" class="btn-danger-ghost btn-sm" data-network-delete="${escapeHtml(network.id)}">Desconectar</button>
                <button type="button" class="btn-danger-ghost btn-sm network-remove" data-network-remove="${escapeHtml(network.id)}" title="Eliminar este afiliado de la lista">Eliminar</button>
                ${network.docUrl ? `<a class="network-doc" href="${escapeHtml(network.docUrl)}" target="_blank" rel="noopener noreferrer">Documentación</a>` : ''}
              </div>
              <p class="network-feedback" data-network-feedback="${escapeHtml(network.id)}">${escapeHtml(network.statusDetail || '')}</p>
            </form>
          </div>
        </details>
      `).join('') + newNetworkPanelHtml();
    }

    /** Redibuja la lista activa y el aviso de redes predefinidas eliminadas. */
    function applyNetworks(data) {
      if (Array.isArray(data.networks)) renderNetworks(data.networks);
      renderRemoved(Array.isArray(data.removed) ? data.removed : []);
    }

    function renderRemoved(removed) {
      if (!removedNetworks) return;
      if (!removed.length) {
        removedNetworks.hidden = true;
        removedNetworks.innerHTML = '';
        return;
      }
      removedNetworks.hidden = false;
      removedNetworks.innerHTML = `
        <span>${removed.length} red${removed.length === 1 ? '' : 'es'} predefinida${removed.length === 1 ? '' : 's'} eliminada${removed.length === 1 ? '' : 's'}: ${removed.map((network) => escapeHtml(network.name)).join(', ')}.</span>
        <button type="button" class="btn-secondary btn-sm" data-restore-networks>Restaurar</button>`;
    }

    async function loadNetworks() {
      try {
        const res = await fetch('/api/admin/data');
        const data = await res.json();
        if (data.success && Array.isArray(data.networks)) applyNetworks(data);
      } catch {
        if (networkList) networkList.innerHTML = '<div class="empty-dashboard">No se pudieron cargar las redes.</div>';
      }
    }

    networksCard?.addEventListener('submit', async (event) => {
      const newForm = event.target.closest('.network-new-form');
      if (newForm) {
        event.preventDefault();
        const feedback = newForm.querySelector('[data-new-feedback]');
        const rows = [...newForm.querySelectorAll('.new-field-row')];
        const fields = rows
          .map((row) => ({
            label: row.querySelector('.nf-label')?.value.trim() || '',
            secret: Boolean(row.querySelector('.nf-secret')?.checked),
            required: Boolean(row.querySelector('.nf-required')?.checked),
          }))
          .filter((field) => field.label);
        if (!fields.length) {
          if (feedback) feedback.textContent = 'Añade al menos un campo de credencial con etiqueta.';
          return;
        }
        const values = Object.fromEntries(new FormData(newForm).entries());
        const submitBtn = newForm.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        const data = await postNetworks({ action: 'create', ...values, fields });
        if (submitBtn) submitBtn.disabled = false;
        if (data.success) {
          applyNetworks(data);
          const created = networkList.querySelector(`details[data-network-id="${data.network.id}"]`);
          if (created) created.open = true;
        } else if (feedback) {
          feedback.textContent = data.message || 'No se pudo crear el afiliado.';
        }
        return;
      }

      const form = event.target.closest('.network-cred-form');
      if (!form) return;
      event.preventDefault();
      const networkId = form.dataset.networkId;
      const values = Object.fromEntries(new FormData(form).entries());
      const data = await postNetworks({ action: 'save', networkId, values });
      if (data.success) {
        applyNetworks(data);
        const item = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (item) item.open = true;
        // Guardar valida en segundo plano: así la red queda "Conectada" sin
        // pasos extra y la sincronización del catálogo no necesita revalidar.
        await validateNetwork(networkId);
        // Tras validar (que vuelve a re-dibujar la lista) se repone en los
        // inputs exactamente lo que se escribió, para que el Tracking ID u
        // otros valores guardados se vean sin tener que pulsar «Ver».
        const savedForm = networkList.querySelector(`.network-cred-form[data-network-id="${networkId}"]`);
        if (savedForm) {
          savedForm.dataset.revealed = '1';
          for (const input of savedForm.querySelectorAll('input[name]')) {
            const written = values[input.name];
            if (written) input.value = written;
          }
        }
        const savedItem = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (savedItem) savedItem.open = true;
      } else {
        const feedback = networkList.querySelector(`[data-network-feedback="${networkId}"]`);
        if (feedback) feedback.textContent = data.message || 'No se pudieron guardar las credenciales.';
        const item = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (item) item.open = true;
      }
    });

    /** Valida una red desde el panel: estado + efectos según la red conectada. */
    async function validateNetwork(networkId) {
      const feedback = networkList?.querySelector(`[data-network-feedback="${networkId}"]`);
      if (feedback) feedback.textContent = 'Validando conexión...';
      const data = await postNetworks({ action: 'validate', networkId });
      applyNetworks(data);
      const item = networkList?.querySelector(`details[data-network-id="${networkId}"]`);
      if (item) item.open = true;
      const newFeedback = networkList?.querySelector(`[data-network-feedback="${networkId}"]`);
      if (newFeedback) newFeedback.textContent = data.message || '';

      // Al conectar una red, cargamos su catálogo para poder revisarlo e
      // importarlo en bloque. AliExpress refresca la caché de la tabla 3
      // (POST manual/automático de conexión); el resto usa el buscador unificado.
      const validated = (data.networks || []).find((n) => n.id === networkId);
      if (validated && validated.status === 'connected') {
        if (networkId === 'aliexpress') {
          await syncAliCatalogUI();
        } else {
          showSearchStatus('success', 'Red conectada', `Cargando el catálogo de ${validated.name}...`);
          runUnifiedSearch({ catalog: true });
        }
      }
      return data;
    }

    /** Muestra/oculta los valores reales guardados de una red en su formulario. */
    async function toggleRevealCredentials(networkId, button) {
      const form = networkList?.querySelector(`.network-cred-form[data-network-id="${networkId}"]`);
      if (!form) return;
      const revealed = form.dataset.revealed === '1';
      if (revealed) {
        for (const input of form.querySelectorAll('input[name]')) {
          input.value = '';
          const field = (networksCache || []).find((n) => n.id === networkId)?.fields?.find((f) => f.key === input.name);
          input.type = field?.secret ? 'password' : 'text';
          input.parentElement?.querySelector('[data-cred-eye]')?.classList.toggle('is-shown', !field?.secret);
        }
        form.dataset.revealed = '0';
        if (button) button.textContent = 'Ver';
        return;
      }
      if (button) {
        button.disabled = true;
        button.textContent = '...';
      }
      try {
        const data = await postNetworks({ action: 'reveal', networkId });
        if (!data.success) {
          const feedback = networkList.querySelector(`[data-network-feedback="${networkId}"]`);
          if (feedback) feedback.textContent = data.message || 'No hay credenciales guardadas para mostrar.';
          return;
        }
        for (const input of form.querySelectorAll('input[name]')) {
          const value = data.values?.[input.name];
          if (value != null) {
            input.value = value;
            input.type = 'text';
            input.parentElement?.querySelector('[data-cred-eye]')?.classList.add('is-shown');
          }
        }
        form.dataset.revealed = '1';
        if (button) button.textContent = 'Ocultar';
      } finally {
        if (button) button.disabled = false;
      }
    }

    networksCard?.addEventListener('click', async (event) => {
      const addFieldBtn = event.target.closest('[data-add-field]');
      if (addFieldBtn) {
        const rows = addFieldBtn.closest('.new-field-rows');
        if (rows) rows.insertAdjacentHTML('beforeend', newFieldRowHtml('', true, true));
        return;
      }

      const removeFieldBtn = event.target.closest('[data-remove-field]');
      if (removeFieldBtn) {
        const rows = networkList.querySelectorAll('.new-field-row');
        const row = removeFieldBtn.closest('.new-field-row');
        if (row && rows.length > 1) row.remove();
        else if (row) row.querySelector('.nf-label')?.focus();
        return;
      }

      // Ojo de cada campo: alterna password ↔ text en ese input
      const eyeBtn = event.target.closest('[data-cred-eye]');
      if (eyeBtn) {
        const input = eyeBtn.parentElement?.querySelector('input');
        if (input) {
          const show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          eyeBtn.classList.toggle('is-shown', show);
        }
        return;
      }

      const validateBtn = event.target.closest('[data-network-validate]');
      const revealBtn = event.target.closest('[data-network-reveal]');
      const deleteBtn = event.target.closest('[data-network-delete]');
      const removeBtn = event.target.closest('[data-network-remove]');

      if (validateBtn) {
        validateBtn.disabled = true;
        try {
          await validateNetwork(validateBtn.dataset.networkValidate);
        } finally {
          validateBtn.disabled = false;
        }
        return;
      }

      if (revealBtn) {
        await toggleRevealCredentials(revealBtn.dataset.networkReveal, revealBtn);
        return;
      }

      if (deleteBtn) {
        const networkId = deleteBtn.dataset.networkDelete;
        if (!window.confirm('¿Desconectar esta red? Se eliminarán sus credenciales almacenadas.')) return;
        const data = await postNetworks({ action: 'delete', networkId });
        if (data.success) applyNetworks(data);
      }

      if (removeBtn) {
        const networkId = removeBtn.dataset.networkRemove;
        const network = (networksCache || []).find((n) => n.id === networkId);
        const label = network ? ` "${network.name}"` : '';
        if (!window.confirm(`¿Eliminar el afiliado${label}? Se borrarán también sus credenciales de la lista.`)) return;
        const data = await postNetworks({ action: 'remove', networkId });
        if (data.success) applyNetworks(data);
        else showSearchStatus('error', 'No se pudo eliminar', data.message || 'Error desconocido.');
      }
    });

    removedNetworks?.addEventListener('click', async (event) => {
      if (!event.target.closest('[data-restore-networks]')) return;
      const data = await postNetworks({ action: 'restore' });
      if (data.success) applyNetworks(data);
    });

    function renderNetworkStatuses(byNetwork) {
      if (!networkStatusRow) return;
      networkStatusRow.innerHTML = byNetwork.map((entry) =>
        `<span class="network-chip ${entry.ok ? 'is-ok' : 'is-fail'}" title="${entry.message || `${entry.products.length} resultados`}">${entry.network}: ${entry.ok ? entry.products.length : 'error'}</span>`
      ).join('');
    }

    /** Categoría elegida en la barra de importación ('' = automática por keywords). */
    function getImportCategory() {
      return importCategory ? String(importCategory.value || '').trim() : '';
    }

    function updateResultsToolbar(total) {
      if (!resultsToolbar || !resultsCount) return;
      resultsToolbar.hidden = total <= 0;
      resultsCount.textContent = `${total} producto${total === 1 ? '' : 's'} en pantalla`;
      if (btnImportAll) btnImportAll.disabled = total <= 0 || isBulkImporting;
    }

    const money = (value, currency = 'EUR') => (value == null || value === '' ? '—' : `${Number(value).toFixed(2)} ${currency === 'EUR' ? '€' : currency}`);

    function productDetailRows(product) {
      const rows = [
        ['Red', product.network],
        ['ID externo', product.externalId],
        ['Categoría', product.category],
        ['Descripción', product.description],
        ['Precio', money(product.price, product.currency)],
        ['Precio original', product.originalPrice != null ? money(product.originalPrice, product.currency) : null],
        ['Moneda', product.currency],
        ['Comisión (%)', product.commissionRate != null ? `${product.commissionRate}%` : null],
        ['Comisión estimada', product.commissionAmount != null ? money(product.commissionAmount, product.currency) : null],
        ['Valoración', product.rating != null ? `${product.rating} / 5` : null],
        ['Reseñas', product.reviewsCount],
        ['Ventas / alcance', product.popularity],
        ['Stock', product.inStock ? 'En stock' : 'Sin stock'],
        ['Envío', product.shippingInfo],
        ['Origen de datos', product.estimated ? 'Estimado (API no cableada)' : 'API oficial'],
        ['URL del producto', product.productUrl],
      ];
      for (const [label, value] of Object.entries(product.extra || {})) {
        if (value != null && value !== '') rows.push([label, value]);
      }
      return rows
        .filter(([, value]) => value != null && value !== '')
        .map(([label, value]) => {
          const raw = String(value);
          // Galería completa de imágenes de AliExpress como miniaturas.
          if (label === 'Imágenes' && raw.includes(' | ')) {
            const urls = raw.split(' | ').filter((u) => /^https?:\/\//i.test(u));
            const cells = urls.map((u) => `<a href="${escapeHtml(u)}" target="_blank" rel="noopener noreferrer"><img src="${escapeHtml(u)}" alt="" loading="lazy" style="width:56px;height:56px;object-fit:cover;border-radius:6px;border:1px solid var(--color-border);" /></a>`).join('');
            return `<div class="aff-detail-item"><dt>${escapeHtml(label)} (${urls.length})</dt><dd style="display:flex;flex-wrap:wrap;gap:6px;">${cells}</dd></div>`;
          }
          const cell = /^https?:\/\//i.test(raw)
            ? `<a href="${escapeHtml(raw)}" target="_blank" rel="noopener noreferrer">${escapeHtml(raw)}</a>`
            : escapeHtml(raw);
          return `<div class="aff-detail-item"><dt>${escapeHtml(label)}</dt><dd>${cell}</dd></div>`;
        })
        .join('');
    }

    function renderResults(products) {
      if (!unifiedResults) return;
      currentResults = products;
      updateResultsToolbar(products.length);
      if (!products.length) {
        unifiedResults.innerHTML = '<div class="empty-dashboard">Sin resultados con estos filtros. Prueba a ampliar el rango de precio, quitar el filtro de stock o pulsa "Ver catálogo completo".</div>';
        return;
      }
      unifiedResults.innerHTML = `
        <div class="aff-table-wrap">
          <table class="aff-table">
            <thead>
              <tr>
                <th>Foto</th>
                <th>Producto</th>
                <th class="aff-num">Precio</th>
                <th class="aff-num">Comisión</th>
                <th class="aff-num">% venta</th>
                <th class="aff-num">Alcance</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              ${products.map((product, index) => `
                <tr class="aff-row" data-aff-row="${index}" tabindex="0" aria-expanded="false">
                  <td><span class="aff-thumb">${product.image ? `<img src="${escapeHtml(product.image)}" alt="" loading="lazy" />` : ''}</span></td>
                  <td class="aff-name">
                    <strong>${escapeHtml(product.title)}</strong>
                    <span>${escapeHtml(product.network)}${product.category ? ` · ${escapeHtml(product.category)}` : ''}${product.estimated ? ' · estimado' : ''}</span>
                  </td>
                  <td class="aff-num">${money(product.price, product.currency)}</td>
                  <td class="aff-num">${product.commissionAmount != null ? money(product.commissionAmount, product.currency) : '—'}<small>${product.commissionRate != null ? `${product.commissionRate}%` : ''}</small></td>
                  <td class="aff-num">${product.rating != null ? product.rating : '—'}</td>
                  <td class="aff-num">${product.popularity != null ? product.popularity : '—'}</td>
                  <td class="aff-actions">
                    <button type="button" class="btn-success btn-sm unified-import" data-index="${index}">Añadir</button>
                    <button type="button" class="aff-caret" data-aff-toggle="${index}" aria-label="Ver todos los datos">▸</button>
                  </td>
                </tr>
                <tr class="aff-detail" data-aff-detail="${index}" hidden>
                  <td colspan="7"><dl class="aff-detail-grid">${productDetailRows(product)}</dl></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>`;
    }

    function toggleAffiliateRow(index) {
      const row = unifiedResults?.querySelector(`[data-aff-row="${index}"]`);
      const detail = unifiedResults?.querySelector(`[data-aff-detail="${index}"]`);
      if (!row || !detail) return;
      const open = detail.hidden;
      detail.hidden = !open;
      row.classList.toggle('is-open', open);
      row.setAttribute('aria-expanded', String(open));
    }

    /** Construye el payload de guardado compartido por importación simple y masiva. */
    function buildImportPayload(product) {
      const assignedCategory = getImportCategory();
      const affiliateLink =
        (product.extra && (product.extra['Enlace de afiliado'] || product.extra['Enlace de afiliado '] )) ||
        product.promotionUrl ||
        product.productUrl;
      const gallery =
        Array.isArray(product.gallery) && product.gallery.length
          ? product.gallery.slice(0, 10)
          : product.image
            ? [product.image]
            : [];
      return {
        action: 'save',
        product: {
          title: product.title,
          description: product.description,
          price: product.price,
          originalPrice: product.originalPrice,
          image: product.image,
          gallery,
          category: assignedCategory,
          merchant: product.network,
          affiliateUrl: affiliateLink,
          rating: product.rating,
          reviewsCount: product.reviewsCount,
          badge: product.network,
          pros: [`Comisión estimada: ${product.commissionRate ?? 0}% en ${product.network}`],
          cons: [],
        },
      };
    }

    async function importSingleProduct(product, btn) {
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Importando...';
      }
      try {
        const res = await fetch('/api/products/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildImportPayload(product)),
        });
        const data = await res.json();
        if (data.success) {
          if (btn) {
            btn.textContent = 'Importado ✓';
            btn.classList.add('is-done');
          }
          return { ok: true, message: data.message, product: data.product };
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Importar a Tradylor';
        }
        return { ok: false, message: data.message || 'No se pudo guardar el producto.' };
      } catch {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Importar a Tradylor';
        }
        return { ok: false, message: 'Fallo de red al importar.' };
      }
      }

    async function stageImportedProduct(product) {
      const basic = buildImportPayload(product).product;
      showAlert('loading', 'Adaptando con IA...', `"${String(product.title).slice(0, 70)}" se pasa por el filtro de IA para titular, ficha, pros/contras y precios.`);

      let enriched = null;
      let warnings = [];
      try {
        const res = await fetch('/api/admin/add-product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: basic.id,
            title: basic.title,
            description: product.description,
            category: basic.category,
            price: basic.price,
            originalPrice: basic.originalPrice,
            image: basic.image,
            gallery: basic.gallery,
            affiliateUrl: basic.affiliateUrl,
            merchant: product.network,
            url: product.productUrl,
            brand: product.network === 'aliexpress' ? 'AliExpress' : product.network,
            rating: product.rating,
            reviewsCount: product.reviewsCount,
            specs: basic.specs,
            pros: basic.pros,
            cons: basic.cons,
            techSheet: basic.techSheet,
            badge: basic.badge,
            options: { text: true, image: false, save: false },
          }),
        });
        const data = await res.json();
        if (data && data.success && data.product) {
          enriched = data.product;
          warnings = Array.isArray(data.enrichment?.warnings) ? data.enrichment.warnings : [];
        }
      } catch (err) {
        console.warn('[stageImportedProduct] IA no disponible:', err);
      }
      if (!enriched) enriched = basic;

      document.querySelectorAll('[data-admin-view]').forEach((section) => {
        section.classList.toggle('is-visible', section.dataset.adminView === 'products');
      });

      if (prodId) prodId.value = enriched.id || basic.id || '';
      if (prodTitle) prodTitle.value = enriched.title || basic.title || '';
      if (prodPrice) prodPrice.value = enriched.price != null ? String(enriched.price) : (basic.price != null ? String(basic.price) : '');
      if (prodOriginalPrice) prodOriginalPrice.value = enriched.originalPrice != null ? String(enriched.originalPrice) : (basic.originalPrice != null ? String(basic.originalPrice) : '');
      if (prodCategory) prodCategory.value = enriched.category || basic.category || '';
      if (prodMerchant) {
        const merchant = enriched.merchant || basic.merchant || product.network || 'AliExpress';
        const matchingOpt = Array.from(prodMerchant.options || []).find((o) => o.value.toLowerCase() === String(merchant).toLowerCase());
        if (matchingOpt) prodMerchant.value = matchingOpt.value;
        else if (prodMerchant.options && prodMerchant.options.length) prodMerchant.value = prodMerchant.options[0].value;
      }
      if (prodAffiliateUrl) prodAffiliateUrl.value = enriched.affiliateUrl || basic.affiliateUrl || product.productUrl || '';
      if (prodBuyNowUrl) prodBuyNowUrl.value = enriched.buyNowUrl || basic.buyNowUrl || '';
      if (prodImage) prodImage.value = enriched.image || basic.image || '';
      if (prodBadge) prodBadge.value = enriched.badge || basic.badge || '';
      if (prodDescription) prodDescription.value = enriched.description || basic.description || '';
      if (prodVerdict) prodVerdict.value = enriched.verdict || basic.verdict || '';
      if (prodTechSheet) prodTechSheet.value = enriched.techSheet || basic.techSheet || '';
      if (prodPros) prodPros.value = Array.isArray(enriched.pros) ? enriched.pros.join('\n') : '';
      if (prodCons) prodCons.value = Array.isArray(enriched.cons) ? enriched.cons.join('\n') : '';

      scrapedGallery = Array.isArray(enriched.gallery) && enriched.gallery.length
        ? enriched.gallery.slice(0, 10)
        : (basic.gallery && basic.gallery.length
            ? basic.gallery.slice(0, 10)
            : (product.image ? [product.image] : []));
      try { if (typeof renderGallery === 'function') renderGallery(); } catch (e) {}
      scrapeExtras = {
        brand: basic.merchant || 'AliExpress',
        rating: (enriched.rating ?? product.rating ?? null),
        reviewsCount: (enriched.reviewsCount ?? product.reviewsCount ?? null),
        specs: (enriched.specs || basic.specs || null),
      };
      try { if (typeof updatePreview === 'function') updatePreview(); } catch (e) {}

      const via = warnings.length ? ` Avisos: ${warnings.join(' | ')}` : '';
      showAlert('success', 'Producto adaptado', `"${String(enriched.title || basic.title).slice(0, 70)}" viene de ${product.network}. Refina los campos y pulsa "Guardar producto" para publicarlo.${via}`);
      try {
        const card = document.querySelector('.form-card') || document.querySelector('[data-admin-view="products"]');
        card?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (e) {}
    }

    /**
     * Búsqueda unificada.
     * @param {{catalog?: boolean}} options catalog=true → recorre el catálogo
     * completo (sin texto de búsqueda, hasta 100 referencias por red).
     */
    async function runUnifiedSearch(options = {}) {
      const catalogMode = Boolean(options.catalog);
      if (!btnUnifiedSearch || !unifiedQuery) return;
      const spinner = btnUnifiedSearch.querySelector('.btn-spinner');
      const text = btnUnifiedSearch.querySelector('.btn-text');
      const catalogSpinner = btnFullCatalog ? btnFullCatalog.querySelector('.btn-spinner') : null;
      btnUnifiedSearch.disabled = true;
      if (btnFullCatalog) btnFullCatalog.disabled = true;
      if (spinner && !catalogMode) spinner.hidden = false;
      if (text && !catalogMode) text.textContent = 'Buscando...';
      if (catalogSpinner) catalogSpinner.hidden = false;
      showSearchStatus(
        'loading',
        catalogMode ? 'Cargando catálogo completo...' : 'Consultando redes...',
        catalogMode
          ? 'Descargando el catálogo de todas las redes conectadas.'
          : 'Búsqueda paralela en curso en los catálogos conectados.',
      );

      try {
        const res = await fetch('/api/admin/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: catalogMode ? '' : unifiedQuery.value.trim(),
            category: filterCategory && filterCategory.value ? filterCategory.value : undefined,
            minPrice: document.getElementById('filterMinPrice')?.value || undefined,
            maxPrice: document.getElementById('filterMaxPrice')?.value || undefined,
            minCommission: document.getElementById('filterMinCommission')?.value || undefined,
            sortBy: document.getElementById('filterSort')?.value,
            inStockOnly: Boolean(document.getElementById('filterInStock')?.checked),
            networks: options.networks,
            limit: catalogMode ? 100 : 24,
          }),
        });
        const data = await res.json();
        if (data.success) {
          renderResults(data.results || []);
          renderNetworkStatuses(data.byNetwork || []);
          showSearchStatus(
            'success',
            catalogMode ? 'Catálogo cargado' : 'Búsqueda completada',
            `${data.total} resultados en ${(data.byNetwork || []).filter((n) => n.ok).length} redes.`,
          );
        } else {
          showSearchStatus('error', 'Error en la búsqueda', data.message || 'No se pudo completar la consulta.');
        }
      } catch {
        showSearchStatus('error', 'Error de red', 'Fallo al comunicar con el servidor.');
      } finally {
        btnUnifiedSearch.disabled = false;
        if (btnFullCatalog) btnFullCatalog.disabled = false;
        if (spinner) spinner.hidden = true;
        if (text) text.textContent = 'Buscar';
        if (catalogSpinner) catalogSpinner.hidden = true;
      }
    }

    btnUnifiedSearch?.addEventListener('click', () => runUnifiedSearch());
    btnFullCatalog?.addEventListener('click', () => runUnifiedSearch({ catalog: true }));
    unifiedQuery?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') runUnifiedSearch();
    });

    // Importación rápida al catálogo (el cloaking /out/[id] ya está activo en frontend)
    unifiedResults?.addEventListener('click', async (event) => {
      const toggle = event.target.closest('[data-aff-toggle]');
      if (toggle) {
        event.stopPropagation();
        toggleAffiliateRow(toggle.dataset.affToggle);
        return;
      }
      if (event.target.closest('a, button')) return;
      const row = event.target.closest('[data-aff-row]');
      if (row) toggleAffiliateRow(row.dataset.affRow);

      const btn = event.target.closest('.unified-import');
      if (!btn || isBulkImporting) return;
      const index = Number(btn.dataset.index);
      const product = currentResults[index];
      if (!product) return;

      btn.disabled = true;
      btn.textContent = 'Adaptando...';
      await stageImportedProduct(product);
      btn.textContent = 'En Tradylor ✓';
      btn.classList.add('is-done');
    });

    // Importación masiva de todos los resultados en pantalla
    btnImportAll?.addEventListener('click', async () => {
      if (isBulkImporting || !currentResults.length) return;
      const total = currentResults.length;
      const assigned = getImportCategory();
      const confirmed = window.confirm(
        `¿Importar ${total} producto${total === 1 ? '' : 's'} al catálogo?` +
          (assigned ? `\n\nCategoría asignada: ${assigned}` : '\n\nCategoría: automática (por palabras clave).'),
      );
      if (!confirmed) return;

      isBulkImporting = true;
      btnImportAll.disabled = true;
      if (btnImportAllLabel) btnImportAllLabel.textContent = 'Importando...';
      if (bulkProgress) bulkProgress.hidden = false;

      let imported = 0;
      let failed = 0;

      for (let i = 0; i < total; i += 1) {
        const product = currentResults[i];
        const btn = unifiedResults?.querySelector(`.unified-import[data-index="${i}"]`);
        const result = await importSingleProduct(product, btn);
        if (result.ok) imported += 1;
        else failed += 1;

        if (bulkProgressFill) bulkProgressFill.style.width = `${Math.round(((i + 1) / total) * 100)}%`;
        showSearchStatus(
          'loading',
          `Importando ${i + 1} de ${total}...`,
          `Completados: ${imported} · Fallidos: ${failed}`,
        );
        // Pequeña pausa para no saturar la escritura en products.json
        await new Promise((resolve) => setTimeout(resolve, 60));
      }

      isBulkImporting = false;
      if (btnImportAllLabel) btnImportAllLabel.textContent = 'Importar todos';
      if (bulkProgress) bulkProgress.hidden = true;
      if (bulkProgressFill) bulkProgressFill.style.width = '0%';
      updateResultsToolbar(currentResults.length);

      showSearchStatus(
        failed === 0 ? 'success' : 'warning',
        'Importación masiva finalizada',
        `${imported} producto${imported === 1 ? '' : 's'} añadido${failed ? ` · ${failed} fallidos` : ''} al catálogo de Tradylor.`,
      );
      await reloadProductsTable();
    });

    if (networkList) loadNetworks();

    // =========================================================================
    // 5b. CATÁLOGO ALIEXPRESS EN CACHÉ (/api/admin/aliexpress/catalog)
    //    - GET: sólo lee el JSON del volumen. NUNCA consulta la TOP API en
    //      cada carga del panel (evita rate limits y pantallas lentas).
    //    - POST: botón «Sincronizar» (y al validar la conexión) → consulta la
    //      API keyword a keyword y reescribe la caché.
    //    - Si la caché supera las 6 horas se muestra un aviso, sin auto-sync.
    // =========================================================================
    const aliCatalogHost = document.getElementById('aliCatalogHost');
    const aliCatalogMeta = document.getElementById('aliCatalogMeta');
    const aliCatalogStatus = document.getElementById('aliCatalogStatus');
    const aliCatalogStatusIcon = document.getElementById('aliCatalogStatusIcon');
    const aliCatalogStatusTitle = document.getElementById('aliCatalogStatusTitle');
    const aliCatalogStatusText = document.getElementById('aliCatalogStatusText');
    const btnAliSync = document.getElementById('btnAliSync');
    const btnAliMore = document.getElementById('btnAliMore');
    const aliFilters = document.getElementById('aliFilters');
    const aliSelectionBar = document.getElementById('aliSelectionBar');
    const aliSelCount = document.getElementById('aliSelCount');
    const btnAliSelAllFiltered = document.getElementById('aliSelAllFiltered');
    const btnAliSelClear = document.getElementById('aliSelClear');
    const btnAliSelImport = document.getElementById('aliSelImport');

    const ALI_PAGE_SIZE = 50;
    const ALI_COLS = 14;
    let aliProducts = [];
    let aliVisible = [];
    let aliPage = 1;
    let aliSyncing = false;
    let aliImportingSelection = false;
    const aliSelected = new Set();

    const aliFilterInputs = {
      q: document.getElementById('aliFQ'),
      cat: document.getElementById('aliFCat'),
      shop: document.getElementById('aliFShop'),
      sort: document.getElementById('aliFSort'),
    };
    const aliSortDirBtn = document.getElementById('aliFSortDir');
    const aliRangeFields = document.getElementById('aliRangeFields');
    /** Dirección del orden: 'desc' (mayor→menor) o 'asc' (menor→mayor). */
    let aliSortDir = 'desc';

    /**
     * Definiciones de las barras de rango: el min/max de cada una se calcula
     * con los datos REALES del catálogo cargado (aliBuildRangeFilters).
     */
    const ALI_RANGE_DEFS = [
      { key: 'price', label: 'Precio (€)', step: 1, get: (p) => aliNum(p.price), fmt: (v) => `${Math.round(v)} €` },
      { key: 'disc', label: 'Descuento (%)', step: 1, get: (p) => aliDiscountPct(p), fmt: (v) => `${Math.round(v)}%` },
      { key: 'commPct', label: 'Comisión (%)', step: 0.5, get: (p) => aliNum(p.commissionRate), fmt: (v) => `${v}%` },
      { key: 'commEur', label: 'Comisión (€)', step: 0.1, get: (p) => aliNum(p.commissionAmount), fmt: (v) => `${v.toFixed(2)} €` },
      { key: 'sales', label: 'Ventas', step: 1, stepFor: (min, max) => Math.max(1, Math.ceil(max / 100)), get: (p) => aliNum(p.popularity), fmt: (v) => (v >= 1000 ? `${(v / 1000).toFixed(v >= 10000 ? 0 : 1)}k` : String(Math.round(v))) },
      { key: 'visits', label: 'Visitas', step: 1, stepFor: (min, max) => Math.max(1, Math.ceil(max / 100)), get: (p) => aliVisits(p), fmt: (v) => (v >= 1000 ? `${(v / 1000).toFixed(v >= 10000 ? 0 : 1)}k` : String(Math.round(v))) },
      { key: 'rating', label: 'Valoración', step: 0.1, get: (p) => aliNum(p.rating), fmt: (v) => `${v}★` },
      { key: 'ship', label: 'Envío (días)', step: 1, get: (p) => aliNum(aliExtra(p, 'Días de envío')), fmt: (v) => `${Math.round(v)} d` },
    ];
    /** Estado de cada rango: { dataMin, dataMax, lo, hi, step, fmt } (null si no hay datos). */
    let aliRanges = {};

    function showAliStatus(type, title, message) {
      if (!aliCatalogStatus) return;
      aliCatalogStatus.hidden = false;
      aliCatalogStatus.className = `status-alert alert-${type}`;
      if (aliCatalogStatusIcon) {
        aliCatalogStatusIcon.textContent = type === 'success' ? '✅' : type === 'error' ? '❌' : type === 'warning' ? '⚠️' : 'ℹ️';
      }
      if (aliCatalogStatusTitle) aliCatalogStatusTitle.textContent = title;
      if (aliCatalogStatusText) aliCatalogStatusText.textContent = message;
    }

    function aliRelTime(iso) {
      const then = new Date(iso).getTime();
      if (!Number.isFinite(then)) return 'sin fecha';
      const mins = Math.max(0, Math.round((Date.now() - then) / 60000));
      if (mins < 1) return 'ahora mismo';
      if (mins < 60) return `hace ${mins} min`;
      const hours = Math.round(mins / 60);
      if (hours < 24) return `hace ${hours} h`;
      return `hace ${Math.round(hours / 24)} d`;
    }

    function aliExtra(product, key) {
      const value = (product.extra || {})[key];
      return value == null || value === '' ? null : value;
    }

    function aliDiscount(product) {
      const raw = aliExtra(product, 'Descuento');
      if (raw) return `${String(raw).replace('%', '')}%`;
      const price = Number(product.price);
      const original = Number(product.originalPrice);
      if (price > 0 && original > price) return `${Math.round(((original - price) / original) * 100)}%`;
      return null;
    }

    function aliNum(value) {
      if (value == null || value === '') return null;
      const n = Number(String(value).replace(/[^\d.,-]/g, '').replace(',', '.'));
      return Number.isFinite(n) ? n : null;
    }

    function aliDiscountPct(product) {
      const raw = aliExtra(product, 'Descuento');
      if (raw != null) return aliNum(raw);
      const price = Number(product.price);
      const original = Number(product.originalPrice);
      if (price > 0 && original > price) return ((original - price) / original) * 100;
      return null;
    }

    /** Visitas: campo nativo si existe o extras «Visitas»/«Visitantes»/«Visits». */
    function aliVisits(product) {
      return (
        aliNum(product.visits) ??
        aliNum(aliExtra(product, 'Visitas')) ??
        aliNum(aliExtra(product, 'Visitantes')) ??
        aliNum(aliExtra(product, 'Visits'))
      );
    }

    /**
     * Construye las barras de rango a partir de los datos reales del catálogo:
     * cada slider cubre del mínimo al máximo encontrado y sólo se filtra cuando
     * el usuario lo mueve (tocado). Los campos sin datos numéricos se omiten.
     */
    function aliBuildRangeFilters() {
      aliRanges = {};
      if (!aliRangeFields) return;
      const blocks = [];
      for (const def of ALI_RANGE_DEFS) {
        const values = aliProducts.map(def.get).filter((v) => v != null && Number.isFinite(v));
        if (!values.length) continue;
        const dataMin = Math.min(...values);
        const dataMax = Math.max(...values);
        if (dataMax <= dataMin) continue;
        const step = def.stepFor ? def.stepFor(dataMin, dataMax) : def.step;
        aliRanges[def.key] = { dataMin, dataMax, lo: dataMin, hi: dataMax, step, fmt: def.fmt, get: def.get, touched: false };
        blocks.push(`
          <div class="ali-range" data-range-field="${def.key}">
            <div class="ali-range-head">
              <label>${escapeHtml(def.label)}</label>
              <span class="ali-range-values" data-range-values>${escapeHtml(def.fmt(dataMin))} – ${escapeHtml(def.fmt(dataMax))}</span>
            </div>
            <div class="ali-range-track">
              <div class="ali-range-rail"></div>
              <div class="ali-range-fill" data-range-fill></div>
              <input type="range" data-range="${def.key}" data-range-side="min" min="${dataMin}" max="${dataMax}" step="${step}" value="${dataMin}" aria-label="${escapeHtml(def.label)} mínimo" />
              <input type="range" data-range="${def.key}" data-range-side="max" min="${dataMin}" max="${dataMax}" step="${step}" value="${dataMax}" aria-label="${escapeHtml(def.label)} máximo" />
            </div>
          </div>`);
      }
      aliRangeFields.innerHTML = blocks.join('');
      for (const key of Object.keys(aliRanges)) aliRangeSyncUi(key);
    }

    /** Redibuja los valores y la barra de relleno de un rango. */
    function aliRangeSyncUi(key) {
      const state = aliRanges[key];
      const field = aliRangeFields?.querySelector(`[data-range-field="${key}"]`);
      if (!state || !field) return;
      const valuesEl = field.querySelector('[data-range-values]');
      if (valuesEl) valuesEl.textContent = `${state.fmt(state.lo)} – ${state.fmt(state.hi)}`;
      const fill = field.querySelector('[data-range-fill]');
      if (fill) {
        const span = state.dataMax - state.dataMin || 1;
        const left = ((state.lo - state.dataMin) / span) * 100;
        const right = ((state.hi - state.dataMin) / span) * 100;
        fill.style.left = `${left}%`;
        fill.style.width = `${Math.max(0, right - left)}%`;
      }
      const minInput = field.querySelector('[data-range-side="min"]');
      const maxInput = field.querySelector('[data-range-side="max"]');
      if (minInput) minInput.value = state.lo;
      if (maxInput) maxInput.value = state.hi;
    }

    /** Aplica los filtros activos y ordena el catálogo completo. */
    function aliFilterApply() {
      const q = (aliFilterInputs.q?.value || '').trim().toLowerCase();
      const cat = aliFilterInputs.cat?.value || '';
      const shop = aliFilterInputs.shop?.value || '';
      const sortKey = aliFilterInputs.sort?.value || 'ventas';
      const dir = aliSortDir === 'asc' ? 1 : -1;

      const filtered = aliProducts.filter((product) => {
        if (cat && (product.category || '') !== cat) return false;
        if (shop && (aliExtra(product, 'Tienda') || '') !== shop) return false;
        for (const state of Object.values(aliRanges)) {
          if (!state.touched) continue;
          const value = state.get(product);
          if (value == null || value < state.lo || value > state.hi) return false;
        }
        if (q) {
          const haystack = `${product.title} ${product.category || ''} ${aliExtra(product, 'Tienda') || ''}`.toLowerCase();
          if (!haystack.includes(q)) return false;
        }
        return true;
      });

      const sorters = {
        ventas: (p) => aliNum(p.popularity),
        visitas: (p) => aliVisits(p),
        comision_eur: (p) => aliNum(p.commissionAmount),
        comision_pct: (p) => aliNum(p.commissionRate),
        valoracion: (p) => aliNum(p.rating),
        descuento: (p) => aliDiscountPct(p),
        precio: (p) => aliNum(p.price),
      };
      return filtered.sort((a, b) => {
        if (sortKey === 'nombre') return dir * String(a.title).localeCompare(String(b.title), 'es');
        const get = sorters[sortKey] || sorters.ventas;
        const av = get(a);
        const bv = get(b);
        if (av == null && bv == null) return 0;
        if (av == null) return 1;
        if (bv == null) return -1;
        return dir * (av - bv);
      });
    }

    /** Rellena los selects de categoría/tienda con los datos del catálogo. */
    function aliPopulateFilterOptions() {
      const fill = (select, values, anyLabel) => {
        if (!select) return;
        const current = select.value;
        select.innerHTML = `<option value="">${anyLabel}</option>` + values.map((v) => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');
        if (values.includes(current)) select.value = current;
      };
      fill(aliFilterInputs.cat, [...new Set(aliProducts.map((p) => p.category).filter(Boolean))].sort(), 'Todas');
      fill(aliFilterInputs.shop, [...new Set(aliProducts.map((p) => aliExtra(p, 'Tienda')).filter(Boolean))].sort(), 'Todas');
    }

    function aliUpdateSelectionUI(pageIds) {
      if (aliSelectionBar) aliSelectionBar.hidden = aliSelected.size === 0;
      if (aliSelCount) aliSelCount.textContent = `${aliSelected.size} seleccionado${aliSelected.size === 1 ? '' : 's'}`;
      const master = aliCatalogHost?.querySelector('[data-ac-checkall]');
      if (master && pageIds) {
        const checked = pageIds.filter((id) => aliSelected.has(id)).length;
        master.checked = checked > 0 && checked === pageIds.length;
        master.indeterminate = checked > 0 && checked < pageIds.length;
      }
    }

    function aliPagerHtml(page, pages, total, start, shown) {
      if (total === 0) return '';
      const info = `<span class="ac-page-info">Mostrando ${start + 1}–${start + shown} de ${total}</span>`;
      if (pages <= 1) return `<div class="ac-pager">${info}</div>`;
      const btn = (label, target, opts = {}) =>
        `<button type="button" class="ac-page-btn${opts.current ? ' is-current' : ''}" data-ac-page="${target}"${opts.disabled ? ' disabled' : ''}>${label}</button>`;
      const wanted = [...new Set([1, pages, page - 1, page, page + 1])]
        .filter((n) => n >= 1 && n <= pages)
        .sort((a, b) => a - b);
      const nums = [];
      wanted.forEach((n, index) => {
        if (index > 0 && n - wanted[index - 1] > 1) nums.push('<span class="ac-page-gap">…</span>');
        nums.push(btn(String(n), n, { current: n === page }));
      });
      return `<div class="ac-pager">${info}<div class="ac-page-nav">${btn('‹', page - 1, { disabled: page <= 1 })}${nums.join('')}${btn('›', page + 1, { disabled: page >= pages })}</div></div>`;
    }

    function renderAliCatalog() {
      if (!aliCatalogHost) return;
      if (aliFilters) aliFilters.hidden = aliProducts.length === 0;
      if (!aliProducts.length) {
        aliVisible = [];
        aliCatalogHost.innerHTML = '<div class="empty-dashboard">Sin productos en la caché. Pulsa «Sincronizar» para descargar el catálogo de AliExpress por primera vez.</div>';
        aliUpdateSelectionUI([]);
        return;
      }
      const filtered = aliFilterApply();
      const pages = Math.max(1, Math.ceil(filtered.length / ALI_PAGE_SIZE));
      if (aliPage > pages) aliPage = pages;
      const start = (aliPage - 1) * ALI_PAGE_SIZE;
      const slice = filtered.slice(start, start + ALI_PAGE_SIZE);
      aliVisible = slice;
      const pageIds = slice.map((product) => product.externalId);
      aliCatalogHost.innerHTML = `
        <div class="aff-table-wrap">
          <table class="aff-table">
            <thead>
              <tr>
                <th class="ac-th-check"><input type="checkbox" data-ac-checkall aria-label="Seleccionar la página actual" /></th>
                <th>Foto</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th class="aff-num">Precio</th>
                <th class="aff-num">Precio orig.</th>
                <th class="aff-num">Dto.</th>
                <th class="aff-num">Comisión %</th>
                <th class="aff-num">Comisión €</th>
                <th class="aff-num">Ventas</th>
                <th class="aff-num">Valoración</th>
                <th>Tienda</th>
                <th>Envío</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              ${slice
                .map((product, offset) => {
                  const index = offset;
                  const discount = aliDiscount(product);
                  const shop = aliExtra(product, 'Tienda');
                  const shippingDays = aliExtra(product, 'Días de envío');
                  const checked = aliSelected.has(product.externalId) ? ' checked' : '';
                  return `
                <tr class="aff-row" data-ac-row="${index}" tabindex="0" aria-expanded="false">
                  <td class="ac-td-check"><input type="checkbox" data-ac-check="${index}" aria-label="Seleccionar producto" ${checked} /></td>
                  <td><span class="aff-thumb">${product.image ? `<img src="${escapeHtml(product.image)}" alt="" loading="lazy" />` : ''}</span></td>
                  <td class="aff-name">
                    <strong>${escapeHtml(product.title)}</strong>
                    <span>${escapeHtml(product.network)}${product.category ? ` · ${escapeHtml(product.category)}` : ''}</span>
                  </td>
                  <td>${escapeHtml(product.category || '—')}</td>
                  <td class="aff-num">${money(product.price, product.currency)}</td>
                  <td class="aff-num">${product.originalPrice != null ? money(product.originalPrice, product.currency) : '—'}</td>
                  <td class="aff-num ac-discount">${discount ? escapeHtml(discount) : '—'}</td>
                  <td class="aff-num">${product.commissionRate != null ? `${product.commissionRate}%` : '—'}</td>
                  <td class="aff-num">${product.commissionAmount != null ? money(product.commissionAmount, product.currency) : '—'}</td>
                  <td class="aff-num">${product.popularity != null ? product.popularity : '—'}</td>
                  <td class="aff-num">${product.rating != null ? `${product.rating} / 5` : '—'}</td>
                  <td>${shop ? escapeHtml(shop) : '—'}</td>
                  <td>${shippingDays != null ? `${escapeHtml(shippingDays)} d` : product.shippingInfo ? escapeHtml(product.shippingInfo) : '—'}</td>
                  <td class="aff-actions">
                    <button type="button" class="btn-success btn-sm unified-import ali-import" data-ac-import="${index}">Añadir</button>
                    <button type="button" class="aff-caret" data-ac-toggle="${index}" aria-label="Ver todos los datos">▸</button>
                  </td>
                </tr>
                <tr class="aff-detail" data-ac-detail="${index}" hidden>
                  <td colspan="${ALI_COLS}"><dl class="aff-detail-grid">${productDetailRows(product)}</dl></td>
                </tr>`;
                })
                .join('')}
            </tbody>
          </table>
        </div>
        ${aliPagerHtml(aliPage, pages, filtered.length, start, slice.length)}`;
      aliUpdateSelectionUI(pageIds);
    }

    function setAliMeta(state) {
      if (!aliCatalogMeta) return;
      if (!state || !state.count) {
        aliCatalogMeta.textContent = 'Sin sincronizar';
        return;
      }
      aliCatalogMeta.textContent = `${state.count} productos · ${aliRelTime(state.syncedAt)}${state.stale ? ' · obsoleto' : ''}`;
    }

    /** GET de la caché: sólo lectura de disco en el servidor. */
    async function loadAliCatalog() {
      try {
        const res = await fetch('/api/admin/aliexpress/catalog', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const data = await res.json();
        if (!res.ok || !data.success) {
          if (aliCatalogHost) aliCatalogHost.innerHTML = '<div class="empty-dashboard">No se pudo leer la caché del catálogo.</div>';
          return data;
        }
        aliProducts = Array.isArray(data.products) ? data.products : [];
        aliPage = 1;
        aliPopulateFilterOptions();
        aliBuildRangeFilters();
        setAliMeta(data);
        renderAliCatalog();
        if (!data.connected) showAliStatus('warning', 'AliExpress sin conectar', 'Guarda sus credenciales en «1. Redes conectadas» y pulsa «Validar» para poder sincronizar.');
        else if (!data.count) showAliStatus('warning', 'Caché vacía', 'Todavía no hay productos guardados. Pulsa «Sincronizar» para descargar el catálogo.');
        else if (data.stale) showAliStatus('warning', 'Caché obsoleta', `El catálogo guardado tiene más de 6 horas (${aliRelTime(data.syncedAt)}). Pulsa «Sincronizar» para refrescarlo.`);
        else showAliStatus('success', 'Caché al día', `${data.count} productos guardados, sincronizados ${aliRelTime(data.syncedAt)}.`);
        return data;
      } catch {
        if (aliCatalogHost) aliCatalogHost.innerHTML = '<div class="empty-dashboard">Fallo de red al leer la caché del catálogo.</div>';
        return null;
      }
    }

    /** POST de sincronización: valida si hace falta, consulta la TOP API y reescribe el JSON. */
    async function syncAliCatalogUI() {
      if (aliSyncing) return null;
      aliSyncing = true;
      const spinner = btnAliSync ? btnAliSync.querySelector('.btn-spinner') : null;
      const text = btnAliSync ? btnAliSync.querySelector('.btn-text') : null;
      if (btnAliSync) btnAliSync.disabled = true;
      if (spinner) spinner.hidden = false;
      if (text) text.textContent = 'Sincronizando...';
      try {
        // Auto-validación: si AliExpress no figura conectada, valida primero.
        // (El guard aliSyncing evita el bucle validate → sync → validate.)
        const aliNet = (networksCache || []).find((n) => n.id === 'aliexpress');
        if (aliNet && aliNet.status !== 'connected') {
          showAliStatus('loading', 'Validando credenciales', 'Comprobando la conexión con AliExpress antes de sincronizar...');
          const check = await validateNetwork('aliexpress');
          const now = (check?.networks || []).find((n) => n.id === 'aliexpress');
          if (!now || now.status !== 'connected') {
            showAliStatus('error', 'AliExpress sin conectar', check?.message || 'Guarda y valida sus credenciales en «1. Redes conectadas».');
            return null;
          }
        }
        showAliStatus('loading', 'Sincronizando con AliExpress', 'Consulta por palabras clave en curso (puede tardar unos segundos)...');
        const res = await fetch('/api/admin/aliexpress/catalog', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const data = await res.json();
        aliProducts = Array.isArray(data.products) ? data.products : [];
        aliPage = 1;
        aliPopulateFilterOptions();
        aliBuildRangeFilters();
        setAliMeta(data);
        renderAliCatalog();
        if (data.ok) showAliStatus('success', 'Catálogo sincronizado', `${data.count} productos guardados en el servidor.`);
        else showAliStatus('error', 'No se pudo sincronizar', data.message || 'AliExpress no respondió.');
        return data;
      } catch {
        showAliStatus('error', 'Fallo de red', 'No se pudo contactar con el servidor para sincronizar.');
        return null;
      } finally {
        aliSyncing = false;
        if (btnAliSync) btnAliSync.disabled = false;
        if (spinner) spinner.hidden = true;
        if (text) text.textContent = 'Sincronizar';
      }
    }

    btnAliSync?.addEventListener('click', () => syncAliCatalogUI());

    /** «Cargar más»: pide al servidor las páginas 2-3 de cada keyword y
     *  amplía la caché (POST { append: true }); los rangos se recalculan. */
    btnAliMore?.addEventListener('click', async () => {
      if (aliSyncing) return;
      aliSyncing = true;
      if (btnAliMore) btnAliMore.disabled = true;
      if (btnAliSync) btnAliSync.disabled = true;
      showAliStatus('loading', 'Ampliando catálogo', 'Descargando más páginas de AliExpress (puede tardar)...');
      try {
        const res = await fetch('/api/admin/aliexpress/catalog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ append: true }),
        });
        const data = await res.json();
        aliProducts = Array.isArray(data.products) ? data.products : [];
        aliPage = 1;
        aliPopulateFilterOptions();
        aliBuildRangeFilters();
        setAliMeta(data);
        renderAliCatalog();
        if (data.ok) showAliStatus('success', 'Catálogo ampliado', data.message || `${data.count} productos en total.`);
        else showAliStatus('error', 'No se pudo ampliar', data.message || 'AliExpress no respondió.');
      } catch {
        showAliStatus('error', 'Fallo de red', 'No se pudo contactar con el servidor para ampliar el catálogo.');
      } finally {
        aliSyncing = false;
        if (btnAliMore) btnAliMore.disabled = false;
        if (btnAliSync) btnAliSync.disabled = false;
      }
    });

    // Interacción de la tabla 3: paginación, selección, desplegable,
    // importación y fila
    aliCatalogHost?.addEventListener('click', async (event) => {
      const pageBtn = event.target.closest('[data-ac-page]');
      if (pageBtn) {
        const target = Number(pageBtn.dataset.acPage);
        if (Number.isFinite(target) && target >= 1) {
          aliPage = target;
          renderAliCatalog();
        }
        return;
      }

      const checkAll = event.target.closest('[data-ac-checkall]');
      if (checkAll) {
        const pageIds = aliVisible.map((product) => product.externalId);
        if (checkAll.checked) pageIds.forEach((id) => aliSelected.add(id));
        else pageIds.forEach((id) => aliSelected.delete(id));
        aliUpdateSelectionUI(pageIds);
        for (const box of aliCatalogHost.querySelectorAll('[data-ac-check]')) box.checked = checkAll.checked;
        return;
      }

      const rowCheck = event.target.closest('[data-ac-check]');
      if (rowCheck) {
        const product = aliVisible[Number(rowCheck.dataset.acCheck)];
        if (product) {
          if (rowCheck.checked) aliSelected.add(product.externalId);
          else aliSelected.delete(product.externalId);
        }
        const pageIds = aliVisible.map((p) => p.externalId);
        const master = aliCatalogHost.querySelector('[data-ac-checkall]');
        if (master) {
          const checked = pageIds.filter((id) => aliSelected.has(id)).length;
          master.checked = checked > 0 && checked === pageIds.length;
          master.indeterminate = checked > 0 && checked < pageIds.length;
        }
        aliUpdateSelectionUI();
        return;
      }

      const toggle = event.target.closest('[data-ac-toggle]');
      if (toggle) {
        const index = Number(toggle.dataset.acToggle);
        const row = aliCatalogHost.querySelector(`[data-ac-row="${index}"]`);
        const detail = aliCatalogHost.querySelector(`[data-ac-detail="${index}"]`);
        if (row && detail) {
          const open = detail.hidden;
          detail.hidden = !open;
          row.classList.toggle('is-open', open);
          row.setAttribute('aria-expanded', String(open));
        }
        return;
      }

      const importBtn = event.target.closest('[data-ac-import]');
      if (importBtn) {
        const product = aliVisible[Number(importBtn.dataset.acImport)];
        if (!product) return;
        importBtn.disabled = true;
        importBtn.textContent = 'Adaptando...';
        await stageImportedProduct(product);
        importBtn.textContent = 'En Tradylor ✓';
        importBtn.classList.add('is-done');
        return;
      }

      const row = event.target.closest('[data-ac-row]');
      if (row && !event.target.closest('a, button, input')) {
        const index = Number(row.dataset.acRow);
        const detail = aliCatalogHost.querySelector(`[data-ac-detail="${index}"]`);
        if (detail) {
          const open = detail.hidden;
          detail.hidden = !open;
          row.classList.toggle('is-open', open);
          row.setAttribute('aria-expanded', String(open));
        }
      }
    });

    // Filtros de la tabla 3: cualquier cambio reordena/refiltra y reinicia la página
    function onAliFilterChange() {
      aliPage = 1;
      renderAliCatalog();
    }
    aliFilters?.addEventListener('input', onAliFilterChange);

    // Barras de rango duales: al mover un extremo se recalcula el estado
    // (los listeners burbujean: primero se aclampa aquí y luego se refiltra)
    aliRangeFields?.addEventListener('input', (event) => {
      const input = event.target.closest('input[type="range"][data-range]');
      if (!input) return;
      const key = input.dataset.range;
      const state = aliRanges[key];
      if (!state) return;
      const value = Number(input.value);
      if (input.dataset.rangeSide === 'min') state.lo = Math.min(value, state.hi);
      else state.hi = Math.max(value, state.lo);
      state.touched = state.lo > state.dataMin || state.hi < state.dataMax;
      aliRangeSyncUi(key);
    });

    // Botón de orden: alterna mayor→menor (↓) y menor→mayor (↑)
    function aliUpdateSortDirUi() {
      if (!aliSortDirBtn) return;
      aliSortDirBtn.textContent = aliSortDir === 'desc' ? '↓' : '↑';
      aliSortDirBtn.title = aliSortDir === 'desc'
        ? 'Orden actual: mayor a menor. Pulsa para invertir.'
        : 'Orden actual: menor a mayor. Pulsa para invertir.';
    }
    aliSortDirBtn?.addEventListener('click', () => {
      aliSortDir = aliSortDir === 'desc' ? 'asc' : 'desc';
      aliUpdateSortDirUi();
      onAliFilterChange();
    });
    aliUpdateSortDirUi();

    document.getElementById('aliFReset')?.addEventListener('click', () => {
      if (aliFilterInputs.q) aliFilterInputs.q.value = '';
      if (aliFilterInputs.cat) aliFilterInputs.cat.value = '';
      if (aliFilterInputs.shop) aliFilterInputs.shop.value = '';
      if (aliFilterInputs.sort) aliFilterInputs.sort.value = 'ventas';
      aliSortDir = 'desc';
      aliUpdateSortDirUi();
      for (const [key, state] of Object.entries(aliRanges)) {
        state.lo = state.dataMin;
        state.hi = state.dataMax;
        state.touched = false;
        aliRangeSyncUi(key);
      }
      onAliFilterChange();
    });

    // Selección masiva: todos los filtrados, limpiar e importar en bloque
    btnAliSelAllFiltered?.addEventListener('click', () => {
      for (const product of aliFilterApply()) aliSelected.add(product.externalId);
      renderAliCatalog();
    });
    btnAliSelClear?.addEventListener('click', () => {
      aliSelected.clear();
      renderAliCatalog();
    });
    btnAliSelImport?.addEventListener('click', async () => {
      if (aliImportingSelection) return;
      const products = aliFilterApply().filter((product) => aliSelected.has(product.externalId));
      if (!products.length) return;
      aliImportingSelection = true;
      if (btnAliSelImport) btnAliSelImport.disabled = true;
      let ok = 0;
      let failed = 0;
      for (let i = 0; i < products.length; i++) {
        const product = products[i];
        showAliStatus('loading', 'Importando selección', `${i + 1}/${products.length}: ${String(product.title).slice(0, 70)}...`);
        const result = await importSingleProduct(product, null);
        if (result.ok) ok++;
        else failed++;
      }
      aliImportingSelection = false;
      if (btnAliSelImport) btnAliSelImport.disabled = false;
      showAliStatus(
        failed ? 'warning' : 'success',
        'Importación de selección finalizada',
        `${ok} producto${ok === 1 ? '' : 's'} añadido${failed ? ` · ${failed} con error` : ''} al catálogo de Tradylor.`,
      );
    });

    // Primera carga: sólo lectura de la caché (sin llamadas a la API)
    loadAliCatalog();

    // =========================================================================
    // 6. GESTIÓN DE CATEGORÍAS (CRUD + relleno de selectores del panel)
    //    - Rellena el datalist del formulario de productos.
    //    - Rellena el filtro y el selector "Categoría al importar" de Afiliados.
    //    - Alta / edición / borrado contra /api/categories.
    // =========================================================================
    const categoryForm = document.getElementById('categoryForm');
    const categoryListView = document.getElementById('categoryListView');
    const catEditingSlug = document.getElementById('catEditingSlug');
    const catName = document.getElementById('catName');
    const catIcon = document.getElementById('catIcon');
    const catKeywords = document.getElementById('catKeywords');
    const btnSaveCategory = document.getElementById('btnSaveCategory');
    const btnSaveCategoryLabel = document.getElementById('btnSaveCategoryLabel');
    const btnCancelCategory = document.getElementById('btnCancelCategory');
    const categoryFormTitle = document.getElementById('categoryFormTitle');
    const categoryStatus = document.getElementById('categoryStatus');
    const categoryStatusIcon = document.getElementById('categoryStatusIcon');
    const categoryStatusTitle = document.getElementById('categoryStatusTitle');
    const categoryStatusText = document.getElementById('categoryStatusText');
    const categoryListDatalist = document.getElementById('categoryList');
    let categoriesCache = [];

    function showCategoryStatus(type, title, message) {
      if (!categoryStatus) return;
      categoryStatus.hidden = false;
      categoryStatus.className = `status-alert alert-${type}`;
      if (categoryStatusIcon) {
        categoryStatusIcon.textContent = type === 'success' ? '✅' : type === 'error' ? '❌' : type === 'warning' ? '⚠️' : 'ℹ️';
      }
      if (categoryStatusTitle) categoryStatusTitle.textContent = title;
      if (categoryStatusText) categoryStatusText.textContent = message;
    }

    /** Vuelca las categorías en datalist + selects de Afiliados. */
    function syncCategorySelects(categories) {
      if (categoryListDatalist) {
        categoryListDatalist.innerHTML = categories
          .map((category) => `<option value="${escapeHtml(category.name)}"></option>`)
          .join('');
      }

      const optionsHtml = categories
        .map((category) => `<option value="${escapeHtml(category.name)}">${escapeHtml(category.icon || '')} ${escapeHtml(category.name)}</option>`)
        .join('');

      [filterCategory, importCategory].forEach((select) => {
        if (!select) return;
        const current = select.value;
        const placeholder = select === filterCategory
          ? '<option value="">Todas las categorías</option>'
          : '<option value="">Automática (por palabras clave)</option>';
        select.innerHTML = placeholder + optionsHtml;
        // Conserva la selección previa si la categoría sigue existiendo
        if (current && categories.some((c) => c.name === current)) select.value = current;
      });
    }

    function renderCategoryList(categories) {
      if (!categoryListView) return;
      if (!categories.length) {
        categoryListView.innerHTML = '<div class="empty-dashboard">Aún no hay categorías creadas.</div>';
        return;
      }

      categoryListView.innerHTML = categories
        .map((category) => {
          const keywords = Array.isArray(category.keywords) ? category.keywords : [];
          return `
          <article class="category-card" data-category-slug="${escapeHtml(category.slug)}">
            <div class="category-card-top">
              <span class="category-icon">${escapeHtml(category.icon || '📦')}</span>
              <div class="category-card-main">
                <h3 class="category-name">${escapeHtml(category.name)}</h3>
                <span class="category-slug">/${escapeHtml(category.slug)}</span>
              </div>
              <span class="category-count" title="Productos clasificados en esta categoría">
                ${Number(category.productCount ?? 0)} prod.
              </span>
            </div>
            <div class="category-keywords">
              ${
                keywords.length
                  ? keywords.slice(0, 3).map((keyword) => `<span>${escapeHtml(keyword)}</span>`).join('')
                  : '<span class="is-empty">sin palabras clave</span>'
              }
              ${keywords.length > 3 ? `<span class="is-more">+${keywords.length - 3}</span>` : ''}
            </div>
            <div class="category-card-actions">
              <button type="button" class="btn-secondary btn-sm category-edit" data-slug="${escapeHtml(category.slug)}">Editar</button>
              <button type="button" class="btn-danger-ghost btn-sm category-delete" data-slug="${escapeHtml(category.slug)}" data-name="${escapeHtml(category.name)}">Eliminar</button>
            </div>
          </article>`;
        })
        .join('');
    }

    async function loadCategories() {
      try {
        const res = await fetch('/api/categories', { cache: 'no-store' });
        const data = await res.json();
        if (data.success && Array.isArray(data.categories)) {
          categoriesCache = data.categories;
          syncCategorySelects(categoriesCache);
          renderCategoryList(categoriesCache);
        } else if (categoryListView) {
          categoryListView.innerHTML = '<div class="empty-dashboard">No se pudieron cargar las categorías.</div>';
        }
      } catch {
        if (categoryListView) {
          categoryListView.innerHTML = '<div class="empty-dashboard">No se pudieron cargar las categorías.</div>';
        }
      }
    }

    function resetCategoryForm() {
      if (catEditingSlug) catEditingSlug.value = '';
      if (catName) catName.value = '';
      if (catIcon) catIcon.value = '';
      if (catKeywords) catKeywords.value = '';
      if (btnSaveCategoryLabel) btnSaveCategoryLabel.textContent = 'Crear categoría';
      if (categoryFormTitle) categoryFormTitle.textContent = '1. Crear nueva categoría';
      if (btnCancelCategory) btnCancelCategory.hidden = true;
    }

    categoryForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = catName ? catName.value.trim() : '';
      if (!name) {
        showCategoryStatus('warning', 'Nombre requerido', 'Escribe un nombre para la categoría.');
        return;
      }

      const editingSlug = catEditingSlug ? catEditingSlug.value.trim() : '';
      const payload = {
        name,
        icon: catIcon ? catIcon.value.trim() : '',
        keywords: catKeywords
          ? catKeywords.value.split(',').map((k) => k.trim()).filter(Boolean)
          : [],
      };

      if (btnSaveCategory) btnSaveCategory.disabled = true;
      showCategoryStatus('loading', editingSlug ? 'Actualizando...' : 'Creando...', 'Escribiendo en src/data/categories.json...');

      try {
        const isEdit = Boolean(editingSlug);
        const res = await fetch(isEdit ? `/api/categories/${encodeURIComponent(editingSlug)}` : '/api/categories', {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (data.success) {
          showCategoryStatus('success', isEdit ? 'Categoría actualizada' : 'Categoría creada', data.message);
          resetCategoryForm();
          await loadCategories();
        } else {
          showCategoryStatus('error', isEdit ? 'Error al actualizar' : 'Error al crear', data.message || 'No se pudo guardar la categoría.');
        }
      } catch {
        showCategoryStatus('error', 'Error de red', 'No se pudo enviar la solicitud al servidor.');
      } finally {
        if (btnSaveCategory) btnSaveCategory.disabled = false;
      }
    });

    btnCancelCategory?.addEventListener('click', () => {
      resetCategoryForm();
      if (categoryStatus) categoryStatus.hidden = true;
    });

    categoryListView?.addEventListener('click', async (event) => {
      const editBtn = event.target.closest('.category-edit');
      const deleteBtn = event.target.closest('.category-delete');

      if (editBtn) {
        const slug = editBtn.dataset.slug;
        const category = categoriesCache.find((c) => c.slug === slug);
        if (!category) return;
        if (catEditingSlug) catEditingSlug.value = category.slug;
        if (catName) catName.value = category.name;
        if (catIcon) catIcon.value = category.icon || '';
        if (catKeywords) catKeywords.value = (category.keywords || []).join(', ');
        if (btnSaveCategoryLabel) btnSaveCategoryLabel.textContent = 'Guardar cambios';
        if (categoryFormTitle) categoryFormTitle.textContent = `1. Editando "${category.name}"`;
        if (btnCancelCategory) btnCancelCategory.hidden = false;
        showCategoryStatus('loading', 'Modo edición', 'Ajusta los campos y pulsa "Guardar cambios".');
        categoryForm?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        catName?.focus();
      }

      if (deleteBtn) {
        const slug = deleteBtn.dataset.slug;
        const name = deleteBtn.dataset.name;
        if (!slug) return;
        const confirmed = window.confirm(`¿Eliminar la categoría "${name}"? Los productos existentes conservan su texto de categoría.`);
        if (!confirmed) return;

        deleteBtn.disabled = true;
        try {
          const res = await fetch(`/api/categories/${encodeURIComponent(slug)}`, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            showCategoryStatus('success', 'Categoría eliminada', data.message);
            if (catEditingSlug && catEditingSlug.value === slug) resetCategoryForm();
            await loadCategories();
          } else {
            showCategoryStatus('error', 'Error al eliminar', data.message || 'No se pudo eliminar la categoría.');
            deleteBtn.disabled = false;
          }
        } catch {
          showCategoryStatus('error', 'Error de red', 'No se pudo enviar la solicitud al servidor.');
          deleteBtn.disabled = false;
        }
      }
    });

    loadCategories();
  });
</script>

<style>
  .admin-dashboard-view { flex-direction: column; gap: 1.5rem; }
  .view-heading { padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .view-heading .admin-title { margin: .75rem 0 .5rem; }
  .view-heading-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: .6rem; margin-top: .9rem; }
  .data-example-pill { padding: .35rem .85rem; color: #fbbf24; background: rgba(245, 158, 11, .1); border: 1px solid rgba(245, 158, 11, .3); border-radius: 9999px; font-size: .68rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .guide-link { display: inline-flex; align-items: center; gap: .4rem; padding: .55rem 1rem; color: #06121f; background: #38bdf8; border-radius: 9999px; font-size: .78rem; font-weight: 800; text-decoration: none; transition: background .2s ease; }
  .guide-link:hover { background: #7dd3fc; }
  .dashboard-toolbar { display: flex; gap: .75rem; flex-wrap: wrap; }
  .dashboard-toolbar input { flex: 1; min-width: 220px; }
  .dashboard-toolbar select { width: 190px; }
  .integration-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
  .integration-card { padding: 1.25rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); box-shadow: var(--shadow-card); }
  .integration-card-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .85rem; }
  .integration-card h3 { color: var(--color-text-main); font-family: var(--font-heading); font-size: 1rem; }
  .integration-card p { min-height: 2.8rem; margin: .5rem 0 1rem; color: var(--color-text-muted); font-size: .8rem; line-height: 1.5; }
  .integration-status { padding: .2rem .5rem; color: #fbbf24; background: rgba(245, 158, 11, .1); border: 1px solid rgba(245, 158, 11, .25); border-radius: 999px; font-size: .68rem; font-weight: 800; text-transform: uppercase; }
  .integration-status.is-configured { color: #6ee7b7; background: rgba(16, 185, 129, .1); border-color: rgba(16, 185, 129, .25); }
  .integration-code { color: var(--color-text-dim); font-size: .68rem; }
  .integration-fields { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: 1rem; }
  .integration-fields span, .filter-chip-row span, .category-manager-pill { padding: .25rem .45rem; color: var(--color-text-dim); background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: 4px; font-size: .66rem; }
  .category-manager-pill { display: inline-flex; align-items: center; gap: .35rem; }
  .category-manager-pill button { padding: 0; color: var(--color-text-dim); background: transparent; border: 0; cursor: pointer; font: inherit; font-size: .9rem; line-height: 1; }
  .category-manager-pill button:hover { color: #f87171; }
  .integration-action { width: 100%; padding: .65rem; color: var(--color-text-dim); background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); cursor: not-allowed; font: inherit; font-size: .78rem; font-weight: 700; }
  .affiliate-import-card, .category-manager { margin-top: .25rem; }
  .filter-chip-row, .category-list-view { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .filter-chip-row span { color: #93c5fd; border-color: rgba(96, 165, 250, .25); }
  .category-form { display: flex; gap: .75rem; }
  .category-form input { flex: 1; }
  :global(.loading-panel), :global(.empty-dashboard) { padding: 2rem; color: var(--color-text-muted); background: rgba(255, 255, 255, .025); border: 1px dashed var(--color-border); border-radius: var(--border-radius-md); text-align: center; }

  /* ============ MÓDULO AFILIADOS Y MULTI-CATÁLOGO ============ */
  /* Una sola columna: el gestor de redes ocupa todo el ancho */
  .affiliates-layout { display: flex; flex-direction: column; gap: 1.5rem; }

  /* Lista de redes en FILA (wrap): cada una como tarjeta compacta; al abrirse
     el cuerpo se despliega ENCIMA (popover ~280px responsive) sin empujar la
     fila ni ocupar todo el ancho. */
  .network-list { display: flex; flex-wrap: wrap; gap: .55rem; align-items: flex-start; }
  :global(.network-item) { position: relative; flex: 1 1 200px; max-width: 280px; border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); background: rgba(255, 255, 255, .02); overflow: hidden; }
  :global(.network-item[open]) { z-index: 30; overflow: visible; }
  :global(.network-item[open] .network-body) { position: absolute; top: calc(100% + 6px); left: 0; width: max(100%, 340px); max-width: min(96vw, 560px); max-height: min(68vh, 560px); overflow-y: auto; padding: .9rem 1rem 1rem; background: #0e1626; border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); box-shadow: 0 18px 44px rgba(0, 0, 0, .5); z-index: 40; }
  :global(.network-item summary) { display: flex; align-items: center; gap: .55rem; padding: .6rem .7rem; cursor: pointer; list-style: none; user-select: none; }
  :global(.network-item summary::-webkit-details-marker) { display: none; }
  :global(.network-item summary:hover) { background: rgba(255, 255, 255, .04); }
  :global(.network-color) { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; box-shadow: 0 0 8px currentColor; }
  :global(.network-main) { display: flex; flex-direction: column; gap: .1rem; min-width: 0; flex: 1; }
  :global(.network-name) { color: var(--color-text-main); font-size: .78rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.network-region) { color: var(--color-text-dim); font-size: .66rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.network-body) { padding: 0 1rem 1rem; border-top: 1px solid var(--color-border); }
  :global(.network-desc) { color: var(--color-text-muted); font-size: .78rem; line-height: 1.5; margin: .85rem 0; }
  :global(.network-cred-form) { display: flex; flex-direction: column; gap: .65rem; }
  :global(.cred-field) { display: grid; gap: .3rem; color: var(--color-text-muted); font-size: .72rem; font-weight: 700; }
  :global(.cred-input-wrap) { position: relative; display: block; }
  :global(.cred-input-wrap input) { padding-right: 2.2rem !important; }
  :global(.cred-eye) { position: absolute; top: 50%; right: .45rem; transform: translateY(-50%); display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; padding: 0; color: var(--color-text-dim); background: transparent; border: 0; border-radius: 6px; cursor: pointer; }
  :global(.cred-eye:hover) { color: var(--color-text-dim); background: rgba(56, 189, 248, .12); }
  :global(.cred-eye svg) { width: 15px; height: 15px; pointer-events: none; }
  :global(.cred-eye .eye-open) { display: none; }
  :global(.cred-eye.is-shown .eye-open) { display: block; }
  :global(.cred-eye.is-shown .eye-closed) { display: none; }
  :global(.cred-field input) { width: 100%; box-sizing: border-box; padding: .55rem .75rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; font-size: .8rem; outline: none; }
  :global(.cred-field input:focus) { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, .12); }
  :global(.network-actions) { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-top: .35rem; }
  :global(.network-actions-main) { display: inline-flex; align-items: center; gap: .5rem; flex-wrap: nowrap; }
  :global(.network-doc) { margin-left: auto; color: #60a5fa; font-size: .72rem; text-decoration: none; }
  :global(.network-doc:hover) { text-decoration: underline; }
  :global(.network-feedback) { margin: .5rem 0 0; color: var(--color-text-muted); font-size: .74rem; line-height: 1.4; }
  :global(.integration-status.is-error) { color: #fca5a5; background: rgba(239, 68, 68, .1); border-color: rgba(239, 68, 68, .3); }

  /* Alta de afiliado: tarjeta final de la fila, MÁS ANCHA para que se lea el
     subtítulo; al abrirla su cuerpo también se despliega de ese mismo ancho */
  :global(.network-new) { border: 2px dashed rgba(56, 189, 248, .6); border-radius: var(--border-radius-sm); background: linear-gradient(180deg, rgba(56, 189, 248, .12), rgba(56, 189, 248, .04)); box-shadow: 0 8px 24px rgba(56, 189, 248, .1); flex: 1 1 300px; max-width: 400px; }
  :global(.network-new summary) { justify-content: center; gap: .55rem; padding: .7rem .6rem; border-radius: var(--border-radius-sm); display: flex; align-items: center; cursor: pointer; list-style: none; user-select: none; }
  :global(.network-new summary::-webkit-details-marker) { display: none; }
  :global(.network-new summary:hover) { background: rgba(56, 189, 248, .16); }
  :global(.network-add-icon) { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex-shrink: 0; color: #06121f; background: #38bdf8; border-radius: 50%; box-shadow: 0 0 14px rgba(56, 189, 248, .55); }
  :global(.network-add-icon svg) { width: 14px; height: 14px; }
  :global(.network-add-main) { align-items: center; text-align: center; display: flex; flex-direction: column; gap: .1rem; min-width: 0; flex: 1; }
  :global(.network-new .network-name) { color: #7dd3fc; font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  :global(.network-new .network-region) { color: var(--color-text-dim); font-size: .66rem; }
  :global(.network-add-chip) { display: none; }
  :global(.network-new[open] summary) { border-bottom: 2px dashed rgba(56, 189, 248, .35); border-radius: var(--border-radius-sm) var(--border-radius-sm) 0 0; }
  :global(.network-new .network-body) { padding-top: 1rem; background: rgba(4, 10, 18, .45); border-top: none; border-radius: 0 0 var(--border-radius-sm) var(--border-radius-sm); }
  :global(.new-fields) { display: flex; flex-direction: column; gap: .55rem; }
  :global(.new-fields-title) { color: var(--color-text-muted); font-size: .72rem; font-weight: 700; }
  :global(.new-field-rows) { display: flex; flex-direction: column; gap: .5rem; }
  :global(.new-field-row) { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  :global(.new-field-row .nf-label) { flex: 1; min-width: 150px; box-sizing: border-box; padding: .5rem .7rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; font-size: .78rem; outline: none; }
  :global(.new-field-row .nf-label:focus) { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, .12); }
  :global(.nf-check) { display: inline-flex; align-items: center; gap: .3rem; color: var(--color-text-muted); font-size: .7rem; font-weight: 600; cursor: pointer; }
  :global(.nf-check input) { accent-color: #38bdf8; }
  :global(.nf-remove) { padding: .2rem .45rem; color: #fca5a5; background: transparent; border: 1px solid rgba(239, 68, 68, .35); border-radius: 4px; cursor: pointer; font: inherit; font-size: .72rem; line-height: 1.2; }
  :global(.nf-remove:hover) { background: rgba(239, 68, 68, .12); }
  :global(.nf-color) { width: 64px; height: 32px; padding: 2px; background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); cursor: pointer; }
  :global(.network-remove) { color: #fca5a5; }
  .removed-networks { display: flex; align-items: center; gap: .65rem; flex-wrap: wrap; margin-top: .75rem; padding: .6rem .8rem; color: var(--color-text-muted); background: rgba(239, 68, 68, .06); border: 1px dashed rgba(239, 68, 68, .35); border-radius: var(--border-radius-sm); font-size: .74rem; }
  .removed-networks[hidden] { display: none; }

  .search-controls { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.25rem; }
  .search-input-group { display: flex; gap: .6rem; }
  .search-input-group input { flex: 1; min-width: 0; padding: .75rem 1rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; font-size: .88rem; outline: none; }
  .search-input-group input:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, .12); }
  .search-input-group .btn-secondary { align-self: stretch; padding: .75rem 1rem; white-space: nowrap; }
  .search-filters { display: flex; align-items: flex-end; gap: .75rem; flex-wrap: wrap; }
  .filter-field { display: grid; gap: .3rem; flex: 1; min-width: 110px; }
  .filter-field label { color: var(--color-text-dim); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .filter-field input, .filter-field select { width: 100%; box-sizing: border-box; padding: .55rem .7rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; font-size: .8rem; outline: none; }
  .filter-field input:focus, .filter-field select:focus { border-color: #38bdf8; }
  /* Opciones de CUALQUIER desplegable: texto negro sobre fondo claro (el
     popup del select se pinta en blanco y con texto blanco era ilegible;
     :global porque las opciones de aliFCat/aliFShop se inyectan por JS) */
  :global(select option) { background: #ffffff; color: #111827; }
  .filter-check { display: inline-flex; align-items: center; gap: .45rem; color: var(--color-text-muted); font-size: .8rem; font-weight: 600; padding-bottom: .55rem; cursor: pointer; }

  .network-status-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; }
  :global(.network-chip) { padding: .25rem .6rem; border-radius: 999px; font-size: .68rem; font-weight: 700; border: 1px solid var(--color-border); color: var(--color-text-muted); background: rgba(255, 255, 255, .03); }
  :global(.network-chip.is-ok) { color: #6ee7b7; border-color: rgba(16, 185, 129, .3); background: rgba(16, 185, 129, .08); }
  :global(.network-chip.is-fail) { color: #fca5a5; border-color: rgba(239, 68, 68, .3); background: rgba(239, 68, 68, .08); }

  .unified-results { display: flex; flex-direction: column; gap: .75rem; }
  /* Tabla comprimida (14 columnas): sin scroll horizontal ni vertical; la
     paginación (50/página) evita tablones kilométricos. */
  :global(.aff-table-wrap) { border: 1px solid var(--color-border); border-radius: 12px; overflow: visible; }
  :global(.aff-table) { width: 100%; border-collapse: separate; border-spacing: 0; font-size: .7rem; background: rgba(255, 255, 255, .02); table-layout: auto; }
  :global(.aff-table th) { position: sticky; top: 0; z-index: 1; padding: .45rem .45rem; text-align: left; font-size: .58rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--color-text-muted); background: #121826; border-bottom: 1px solid var(--color-border); white-space: nowrap; }
  :global(.aff-table td) { padding: .4rem .45rem; color: var(--color-text-main); border-bottom: 1px solid rgba(255, 255, 255, .05); vertical-align: middle; }
  :global(.aff-num) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  :global(.aff-num small) { display: block; color: #6ee7b7; font-size: .62rem; }
  :global(.aff-row) { cursor: pointer; }
  :global(.aff-row:hover) { background: rgba(96, 165, 250, .06); }
  :global(.aff-row.is-open) { background: rgba(96, 165, 250, .1); }
  :global(.aff-thumb) { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; padding: 2px; background: #fff; border-radius: 6px; }
  :global(.aff-thumb img) { max-width: 100%; max-height: 100%; object-fit: contain; }
  :global(.aff-name) { max-width: 200px; min-width: 120px; }
  :global(.aff-name strong) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-weight: 650; font-size: .7rem; line-height: 1.3; }
  :global(.aff-name span) { display: block; margin-top: .1rem; color: var(--color-text-dim); font-size: .6rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.aff-actions) { display: flex; align-items: center; justify-content: flex-end; gap: .3rem; white-space: nowrap; }
  :global(.aff-actions .btn-sm) { padding: .25rem .5rem; font-size: .64rem; }
  :global(.aff-caret) { width: 24px; height: 24px; color: #93c5fd; background: rgba(96, 165, 250, .1); border: 1px solid rgba(96, 165, 250, .25); border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-body); font-size: .7rem; font-weight: 700; transition: all .2s ease; }
  :global(.aff-row.is-open .aff-caret) { transform: rotate(90deg); }
  :global(.aff-detail td) { background: rgba(4, 10, 18, .55); }
  :global(.aff-detail-grid) { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: .5rem .8rem; margin: 0; }
  :global(.aff-detail-item dt) { color: var(--color-text-dim); font-size: .6rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  :global(.aff-detail-item dd) { margin: .1rem 0 0; color: var(--color-text-main); font-size: .7rem; word-break: break-word; }
  :global(.aff-detail-item a) { color: #93c5fd; }
  /* Checkboxes de selección masiva de la tabla AliExpress */
  :global(.ac-th-check), :global(.ac-td-check) { width: 28px; padding-left: .5rem !important; padding-right: .2rem !important; }
  :global(.ac-th-check input), :global(.ac-td-check input) { accent-color: #38bdf8; cursor: pointer; width: 14px; height: 14px; margin: 0; }
  /* Barra de filtros de la tabla AliExpress */
  .ali-filters { display: flex; flex-direction: column; gap: .55rem; margin-bottom: .6rem; padding: .55rem .65rem; background: rgba(255, 255, 255, .02); border: 1px solid var(--color-border); border-radius: 10px; }
  .ali-filters[hidden] { display: none; }
  .ali-filters-row { display: flex; align-items: flex-end; gap: .5rem; flex-wrap: wrap; }
  .ali-filters .filter-field { min-width: 90px; flex: 0 1 auto; }
  .ali-filters .filter-field.ali-f-search { flex: 1 1 180px; min-width: 150px; }
  .ali-filters .btn-secondary { flex-shrink: 0; padding: .5rem .8rem; font-size: .72rem; }
  .ali-sort-group { display: flex; gap: .3rem; }
  .ali-sort-group select { flex: 1; min-width: 130px; }
  .ali-sort-dir { min-width: 34px; font-size: .9rem; font-weight: 800; line-height: 1; }
  /* Barras de rango duales (precio, dto, comisiones, ventas, rating, envío) */
  .ali-range-fields { display: flex; flex-wrap: wrap; gap: .45rem .9rem; padding-top: .35rem; border-top: 1px dashed rgba(255, 255, 255, .07); }
  .ali-range-fields:empty { display: none; }
  .ali-range { flex: 1 1 170px; min-width: 150px; max-width: 260px; display: grid; gap: .15rem; }
  .ali-range-head { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; }
  .ali-range-head label { color: var(--color-text-dim); font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .ali-range-values { color: #7dd3fc; font-size: .68rem; font-weight: 700; white-space: nowrap; }
  .ali-range-track { position: relative; height: 24px; }
  .ali-range-rail, .ali-range-fill { position: absolute; top: 50%; height: 4px; transform: translateY(-50%); border-radius: 999px; pointer-events: none; }
  .ali-range-rail { left: 0; right: 0; background: rgba(255, 255, 255, .12); }
  .ali-range-fill { background: linear-gradient(90deg, #38bdf8, #22d3ee); }
  .ali-range-track input[type="range"] { position: absolute; inset: 0; width: 100%; height: 24px; margin: 0; background: none; pointer-events: none; -webkit-appearance: none; appearance: none; outline: none; }
  .ali-range-track input[type="range"]::-webkit-slider-runnable-track { background: transparent; height: 4px; }
  .ali-range-track input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; pointer-events: auto; width: 14px; height: 14px; margin-top: -5px; border: 2px solid #0b1220; border-radius: 50%; background: #38bdf8; cursor: grab; box-shadow: 0 0 6px rgba(56, 189, 248, .5); }
  .ali-range-track input[type="range"]::-moz-range-track { background: transparent; height: 4px; }
  .ali-range-track input[type="range"]::-moz-range-thumb { pointer-events: auto; width: 14px; height: 14px; border: 2px solid #0b1220; border-radius: 50%; background: #38bdf8; cursor: grab; box-shadow: 0 0 6px rgba(56, 189, 248, .5); }
  /* Barra de selección masiva */
  .ali-selection { display: flex; align-items: center; gap: .55rem; flex-wrap: wrap; margin-bottom: .6rem; padding: .5rem .7rem; color: #7dd3fc; background: rgba(56, 189, 248, .08); border: 1px solid rgba(56, 189, 248, .3); border-radius: 10px; font-size: .74rem; font-weight: 700; }
  .ali-selection[hidden] { display: none; }
  .ali-selection .btn-sm { padding: .28rem .6rem; font-size: .68rem; }
  :global(.unified-card) { display: flex; align-items: center; gap: 1rem; padding: .85rem 1rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); }
  :global(.unified-thumb) { width: 64px; height: 64px; border-radius: 8px; background: #fff; padding: 4px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  :global(.unified-thumb img) { max-width: 100%; max-height: 100%; object-fit: contain; }
  :global(.unified-body) { flex: 1; min-width: 0; }
  :global(.unified-top) { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; margin-bottom: .3rem; }
  :global(.network-mini-tag) { padding: .12rem .45rem; border-radius: 4px; background: rgba(59, 130, 246, .12); border: 1px solid rgba(59, 130, 246, .3); color: #93c5fd; font-size: .64rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  :global(.estimated-tag) { padding: .12rem .45rem; border-radius: 4px; background: rgba(245, 158, 11, .1); border: 1px solid rgba(245, 158, 11, .3); color: #fbbf24; font-size: .64rem; font-weight: 800; text-transform: uppercase; }
  :global(.stock-tag) { padding: .12rem .45rem; border-radius: 4px; background: rgba(16, 185, 129, .1); border: 1px solid rgba(16, 185, 129, .3); color: #6ee7b7; font-size: .64rem; font-weight: 800; }
  :global(.stock-tag.is-out) { background: rgba(239, 68, 68, .1); border-color: rgba(239, 68, 68, .3); color: #fca5a5; }
  :global(.unified-title) { margin: 0 0 .35rem; color: var(--color-text-main); font-size: .85rem; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  :global(.unified-metrics) { display: flex; align-items: baseline; gap: .9rem; flex-wrap: wrap; font-size: .75rem; color: var(--color-text-muted); }
  :global(.unified-price) { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 800; color: #fff; }
  :global(.unified-commission) { color: #6ee7b7; font-weight: 600; }
  :global(.unified-rating) { color: #fbbf24; font-weight: 600; }
  :global(.unified-import) { flex-shrink: 0; white-space: nowrap; }
  :global(.unified-import.is-done) { background: rgba(16, 185, 129, .2); border-color: rgba(16, 185, 129, .4); pointer-events: none; }
  :global(.btn-danger-ghost) { display: inline-flex; align-items: center; gap: .35rem; padding: .5rem .8rem; color: #fca5a5; background: transparent; border: 1px solid rgba(239, 68, 68, .3); border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-size: .76rem; font-weight: 700; transition: all .2s ease; }
  :global(.btn-danger-ghost:hover) { background: rgba(239, 68, 68, .12); }

  /* ============ BARRA DE RESULTADOS: IMPORTACIÓN MASIVA + CATEGORÍA ============ */
  .results-toolbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1rem; padding: .9rem 1rem; margin-bottom: 1rem; background: rgba(59, 130, 246, .07); border: 1px solid rgba(96, 165, 250, .25); border-radius: var(--border-radius-md); }
  .results-toolbar-info { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .results-toolbar-info strong { color: var(--color-text-main); font-family: var(--font-heading); font-size: .95rem; }
  .results-toolbar-info span { color: var(--color-text-dim); font-size: .74rem; line-height: 1.4; }
  .results-toolbar-actions { display: flex; align-items: flex-end; gap: .75rem; flex-wrap: wrap; }
  .import-category-field { display: grid; gap: .3rem; }
  .import-category-field span { color: var(--color-text-dim); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .import-category-field select { min-width: 210px; padding: .55rem .7rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; font-size: .8rem; outline: none; }
  .import-category-field select:focus { border-color: #38bdf8; }
  .bulk-progress { grid-column: 1 / -1; height: 6px; background: rgba(255, 255, 255, .06); border-radius: 999px; overflow: hidden; }
  .bulk-progress-fill { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #3b82f6, #10b981); border-radius: 999px; transition: width .25s ease; }

  /* ============ GESTIÓN DE CATEGORÍAS ============ */
  .category-list-view { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; margin-top: .25rem; }
  :global(.category-card) { display: flex; flex-direction: column; gap: .75rem; padding: 1rem 1.1rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); transition: border-color .2s ease, transform .2s ease; min-width: 0; overflow: hidden; }
  :global(.category-card span) { max-width: 100%; }
  :global(.category-card:hover) { border-color: rgba(96, 165, 250, .4); transform: translateY(-2px); }
  :global(.category-card-top) { display: flex; align-items: center; gap: .7rem; }
  :global(.category-icon) { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; flex-shrink: 0; background: rgba(59, 130, 246, .12); border: 1px solid rgba(96, 165, 250, .25); border-radius: 10px; font-size: 1.15rem; }
  :global(.category-card-main) { display: flex; flex-direction: column; gap: .1rem; min-width: 0; flex: 1; }
  :global(.category-name) { margin: 0; color: var(--color-text-main); font-family: var(--font-heading); font-size: .92rem; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.category-slug) { color: var(--color-text-dim); font-size: .68rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.category-count) { flex-shrink: 0; padding: .2rem .5rem; color: #93c5fd; background: rgba(59, 130, 246, .1); border: 1px solid rgba(96, 165, 250, .25); border-radius: 999px; font-size: .66rem; font-weight: 800; white-space: nowrap; }
  :global(.category-keywords) { display: flex; flex-wrap: wrap; gap: .35rem; min-width: 0; max-width: 100%; overflow: hidden; }
  :global(.category-keywords span) { padding: .2rem .5rem; color: var(--color-text-dim); background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: 4px; font-size: .66rem; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; box-sizing: border-box; }
  :global(.category-keywords span.is-empty) { opacity: .7; font-style: italic; }
  :global(.category-keywords span.is-more) { color: #93c5fd; border-color: rgba(96, 165, 250, .25); }
  :global(.category-card-actions) { display: flex; gap: .5rem; margin-top: auto; padding-top: .35rem; border-top: 1px solid rgba(255, 255, 255, .05); }
  :global(.category-card-actions button) { flex: 1; }

  /* Etiqueta de categoría propia en las tarjetas de resultados de Afiliados */
  :global(.network-mini-tag.is-category) { color: #6ee7b7; background: rgba(16, 185, 129, .1); border-color: rgba(16, 185, 129, .3); }

  @media (max-width: 760px) {
    .results-toolbar { grid-template-columns: 1fr; }
    .results-toolbar-actions { width: 100%; }
    .import-category-field { flex: 1; }
    .import-category-field select { width: 100%; min-width: 0; }
  }

  /* ============ 3. CATÁLOGO ALIEXPRESS (CACHÉ EN VOLÚMEN) ============ */
  .ali-catalog-head-actions { display: flex; align-items: center; justify-content: flex-end; gap: .75rem; margin-left: auto; flex-wrap: wrap; }
  .ali-catalog-meta { color: var(--color-text-dim); font-size: .72rem; white-space: nowrap; }
  .ali-catalog-meta:empty { display: none; }
  :global(.ac-discount) { color: #6ee7b7; font-weight: 700; }
  :global(.ali-import) { flex-shrink: 0; }
  :global(.ac-pager) { display: flex; align-items: center; justify-content: space-between; gap: .8rem; flex-wrap: wrap; padding: .7rem .1rem 0; font-size: .76rem; color: var(--color-text-muted); }
  :global(.ac-page-info) { color: var(--color-text-dim); font-size: .74rem; }
  :global(.ac-page-nav) { display: flex; gap: .3rem; flex-wrap: wrap; }
  :global(.ac-page-btn) { appearance: none; min-width: 2rem; height: 2rem; padding: 0 .6rem; background: #0b1220; border: 1px solid rgba(148, 163, 184, .32); border-radius: 8px; color: #e5e7eb; font: inherit; font-size: .76rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  :global(.ac-page-btn:hover:not(:disabled)) { border-color: #60a5fa; }
  :global(.ac-page-btn:disabled) { opacity: .4; cursor: not-allowed; }
  :global(.ac-page-btn.is-current) { background: rgba(96, 165, 250, .2); border-color: #60a5fa; color: #bfdbfe; }
  :global(.ac-page-gap) { align-self: center; padding: 0 .2rem; }

  .text-right { text-align: right; }

  /* Visibilidad de secciones: el display base lo marca .is-visible únicamente, así las secciones ocultas nunca aparecen (el scoping de Astro sube la especificidad de las clases base con atributos) */
  .admin-grid-section,
  .admin-dashboard-view,
  .products-list-card { display: none; }
  .admin-grid-section.is-visible { display: grid; }
  .admin-dashboard-view.is-visible { display: flex; }
  .products-list-card.is-visible { display: flex; }

  @media (max-width: 900px) {
    .category-form { flex-direction: column; }
  }

  .admin-login-page { min-height: calc(100vh - 9rem); max-width: var(--max-width); margin: 0 auto; padding: 4rem 1.25rem 5rem; display: grid; grid-template-columns: minmax(0, 500px) minmax(240px, 1fr); align-items: center; gap: clamp(3rem, 10vw, 9rem); }
  .admin-login-panel { padding: clamp(2rem, 5vw, 3.5rem); background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); box-shadow: 0 24px 70px rgba(0, 0, 0, .24); }
  .admin-login-mark { display: inline-flex; align-items: center; gap: .6rem; color: #60a5fa; font-size: .72rem; font-weight: 800; letter-spacing: .12em; }
  .admin-login-kicker { margin: 3.5rem 0 .75rem; color: var(--color-text-dim); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .admin-login-title { color: var(--color-text-main); font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.05; margin: 0; }
  .admin-login-description { max-width: 390px; margin: 1.25rem 0 2.25rem; color: var(--color-text-muted); line-height: 1.65; }
  .admin-login-form { display: grid; gap: 1.15rem; }
  .login-field { display: grid; gap: .5rem; color: var(--color-text-main); font-size: .8rem; font-weight: 700; }
  .login-field input { width: 100%; box-sizing: border-box; padding: .9rem 1rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; outline: none; }
  .login-field input:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, .14); }
  .admin-login-submit { display: inline-flex; align-items: center; justify-content: center; gap: .7rem; width: 100%; margin-top: .65rem; padding: .95rem 1.25rem; color: #07111f; background: #38bdf8; border: 0; border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-weight: 800; }
  .admin-login-submit:hover { background: #7dd3fc; }
  .admin-login-error { margin: 0 0 1.25rem; padding: .8rem 1rem; color: #fecaca; background: rgba(239, 68, 68, .1); border: 1px solid rgba(239, 68, 68, .3); border-radius: var(--border-radius-sm); font-size: .85rem; }
  .admin-login-footer { display: flex; align-items: center; gap: .5rem; margin: 2rem 0 0; color: var(--color-text-dim); font-size: .75rem; }
  .admin-login-aside { display: flex; flex-direction: column; gap: 1.5rem; color: var(--color-text-main); }
  .aside-index { color: var(--color-text-dim); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .admin-login-aside strong { font-family: var(--font-heading); font-size: clamp(3rem, 7vw, 6.5rem); line-height: .92; letter-spacing: -.04em; }
  .aside-line { width: min(100%, 280px); height: 1px; background: linear-gradient(90deg, #38bdf8, transparent); }
  @media (max-width: 760px) { .admin-login-page { min-height: auto; padding-top: 2rem; grid-template-columns: 1fr; gap: 2.5rem; } .admin-login-aside { display: none; } }

  /* ==========================================================================
     ADMIN PANEL - ESTILOS PREMIUM (SISTEMA DE DISEÑO TRADYLOR)
     ========================================================================== */
  .admin-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* 1. Header del Admin */
  .admin-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .admin-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #60a5fa;
    width: fit-content;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .admin-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: var(--color-text-main);
    line-height: 1.2;
    margin-top: 0.5rem;
  }

  .admin-subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.5rem;
  }

  /* 2. Grid Principal (Formulario + Preview)
     Sin display base: la visibilidad la controlan las reglas .is-visible (más arriba) */
  .form-basic-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 1.25rem;
    align-items: start;
  }
  .form-basic-col { display: contents; }
  .form-preview-col { position: sticky; top: 1.5rem; }
  @media (max-width: 980px) {
    .form-basic-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 1024px) {
    .admin-grid-section {
      grid-template-columns: 1fr;
    }
  }

  .admin-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-card);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .header-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-cyan {
    background: rgba(6, 182, 212, 0.15);
    color: #22d3ee;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .card-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  /* Caja de Scraping */
  .scrape-box {
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .scrape-input-group {
    display: flex;
    gap: 0.5rem;
    position: relative;
    margin-top: 0.5rem;
  }

  .input-icon-wrapper {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-dim);
    pointer-events: none;
  }

  .scrape-input-group input {
    flex: 1;
    padding-left: 2.75rem;
  }

  /* Inputs Generales */
  input[type="text"],
  input[type="url"],
  input[type="number"],
  input[type="search"],
  select,
  textarea {
    width: 100%;
    background: #0d121f;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.75rem 1rem;
    color: var(--color-text-main);
    font-family: var(--font-body);
    font-size: 0.9rem;
    transition: all 0.2s ease;
    outline: none;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
  }

  /* Botones: base scoped para los estáticos (HTML del template) + base global
     para los botones inyectados por JS (networkList, resultados, categorías…). */
  button {
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 600;
    border: none;
    border-radius: var(--border-radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  :global(.btn-primary),
  :global(.btn-secondary),
  :global(.btn-success) {
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 600;
    border: none;
    border-radius: var(--border-radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  :global(.btn-primary) {
    background: var(--color-primary);
    color: #fff;
    padding: 0.75rem 1.25rem;
    white-space: nowrap;
  }

  :global(.btn-primary):hover:not(:disabled) {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  :global(.btn-primary):disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global(.btn-success) {
    background: #10b981;
    color: #064e3b;
    font-weight: 700;
    padding: 0.85rem 1.75rem;
    color: #ffffff;
  }

  :global(.btn-success):hover {
    background: #059669;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  :global(.btn-secondary) {
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.85rem 1.5rem;
  }

  :global(.btn-secondary):hover {
    color: var(--color-text-main);
    background: #242f45;
  }

  /* Variante pequeña: va después de los anteriores para que su padding gane */
  :global(.btn-sm) { padding: .5rem .8rem; font-size: .76rem; }

  /* CTA de enriquecimiento con IA (texto + imagen) */
  .btn-ai {
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    color: #ffffff;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
  }

  .btn-ai:hover {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(139, 92, 246, 0.35);
  }

  .btn-ai:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .btn-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Alertas de Estado */
  .status-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: var(--border-radius-sm);
    margin-top: 1rem;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .alert-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .alert-content strong {
    display: block;
    margin-bottom: 0.15rem;
  }

  .alert-success {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #a7f3d0;
  }

  .alert-warning {
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #fde68a;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #fca5a5;
  }

  .alert-loading {
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #bfdbfe;
  }

  /* Formulario */
  .product-edit-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: flex;
    gap: 1rem;
  }

  .form-row.two-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 640px) {
    .form-row.two-cols {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .full-width {
    width: 100%;
  }

  .field-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .required {
    color: #f87171;
  }

  .label-hint {
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--color-text-dim);
  }

  .gallery-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.3rem;
  }

  :global(.gallery-item) {
    position: relative;
    width: 72px;
    height: 72px;
  }

  :global(.gallery-item.is-main .gallery-thumb) {
    border-color: var(--color-accent, #f59e0b);
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.3);
  }

  :global(.gallery-thumb) {
    width: 72px;
    height: 72px;
    padding: 0;
    border: 2px solid var(--color-border, #333);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    background: linear-gradient(160deg, #f8fafc, #eef2f7);
    transition: border-color 0.15s, transform 0.15s;
  }

  :global(.gallery-thumb:hover) {
    transform: translateY(-2px);
    border-color: var(--color-accent, #f59e0b);
  }

  :global(.gallery-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 5px;
    display: block;
  }

  /* Miniatura de vídeo de plataforma (16:9): llenar el cuadrado sin letterbox. */
  :global(.gallery-thumb img.video-still) {
    object-fit: cover;
    padding: 0;
    background: #0f1626;
  }

  :global(.gallery-thumb video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #0f1626;
  }

  :global(.gallery-play-badge) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: #fff;
    font-size: 1.35rem;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7);
  }

  :global(.gallery-play-badge::before) {
    content: '';
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.65);
    border: 1.5px solid rgba(255, 255, 255, 0.85);
  }

  :global(.gallery-play-badge) {
    z-index: 1;
  }

  :global(.gallery-remove) {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 20px;
    height: 20px;
    border: none;
    border-radius: 50%;
    background: #ef4444;
    color: #fff;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  :global(.gallery-remove:hover) {
    background: #dc2626;
  }

  .gallery-add-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .gallery-url-add {
    display: flex;
    gap: 0.5rem;
  }

  .gallery-url-add input {
    flex: 1;
  }

  .gallery-empty {
    font-size: 0.78rem;
    color: var(--color-text-dim);
    font-style: italic;
  }

  .form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  /* 3. Live Preview Card */
  .preview-container {
    position: sticky;
    top: 2rem;
  }

  .preview-product-card {
    background: #0f1626;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
  }

  /* Los toggles de la vista previa (imagen, placeholder, flechas, contador)
     usan el atributo [hidden]; el display de los autoestilos debe respetarlo. */
  [hidden] {
    display: none !important;
  }

  .preview-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    box-sizing: border-box;
    /* Mismo fondo que la imagen de la ficha real y la ProductCard (#f8fafc) */
    background: #f8fafc;
    overflow: hidden;
    /* Sin display:flex: el <img> se coloca en absoluto y se centra solo. */
  }

  /* Imagen a absoluto dentro del wrapper: llena el contenedor (responsive)
     y object-fit:contain la centra y muestra COMPLETA sin recortes. */
  .preview-image-wrapper img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 6%;
    display: block;
    object-fit: contain;
    object-position: center;
    border-radius: 0.75rem;
    transition: transform 0.3s ease;
  }

  .preview-empty-image {
    position: absolute;
