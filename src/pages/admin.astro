---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
import type { Product } from './api/products/add';
import { areValidCredentials, clearAdminSession, createAdminSession, isAdminAuthenticated } from '../lib/adminAuth';
import { getAnalyticsSummary } from '../lib/adminDashboard';
import { getScoredCatalog } from '../lib/opportunity';

const isAuthenticated = isAdminAuthenticated(Astro.request);
let loginError = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = String(formData.get('action') ?? 'login');

  if (action === 'logout' && isAuthenticated) {
    return new Response(null, {
      status: 303,
      headers: { Location: '/admin', 'Set-Cookie': clearAdminSession() },
    });
  }

  if (!isAuthenticated && areValidCredentials(String(formData.get('username') ?? '').trim(), String(formData.get('password') ?? ''))) {
    return new Response(null, {
      status: 303,
      headers: { Location: '/admin', 'Set-Cookie': createAdminSession() },
    });
  }

  if (!isAuthenticated) loginError = 'El usuario o la contraseña no son correctos.';
}

// Leer productos almacenados para renderizar inicialmente en el servidor (SSR)
const DATA_FILE_PATH = path.join(process.cwd(), 'src', 'data', 'products.json');
let initialProducts: Product[] = [];

try {
  if (fs.existsSync(DATA_FILE_PATH)) {
    const raw = fs.readFileSync(DATA_FILE_PATH, 'utf-8');
    initialProducts = JSON.parse(raw);
  }
} catch (error) {
  console.error('Error cargando products.json en admin:', error);
}

const pageTitle = "Panel de Administración | Tradylor";
const pageDescription = "Gestión, scraping de metadatos y alta de productos con enlaces de afiliación en Tradylor.";
const allowedSections = ['products', 'affiliates', 'categories', 'analytics', 'marketing'];
const requestedSection = Astro.url.searchParams.get('section') || 'products';
const initialSection = allowedSections.includes(requestedSection) ? requestedSection : 'products';

// Datos SSR para la sección Tráfico y ventas (métricas + motor de curación)
const analyticsSummary = getAnalyticsSummary();
const scoredCatalog = getScoredCatalog();
---

<Layout title={pageTitle} description={pageDescription}>
  {isAuthenticated ? (
  <div class="admin-wrapper">
    <!-- 1. HEADER DEL PANEL -->
    <header class="admin-header">
      <div class="admin-header-main">
        <div class="admin-tag-pill">
          <span class="status-indicator"></span>
          <span>Motor de Curación & Scraping Híbrido (SSR Activo)</span>
        </div>
        <h1 class="admin-title">Panel de Administración de Productos</h1>
        <p class="admin-subtitle">
          Pega el enlace de cualquier comercio para autocompletar metadatos OpenGraph (título, imagen, precio). Edita y afina la ficha antes de guardarla de forma persistente.
        </p>
      </div>
    </header>

    <nav class="admin-section-nav" aria-label="Secciones del backend">
      <button type="button" class="admin-nav-toggle" id="adminNavToggle" aria-expanded="false" aria-controls="adminNavLinks" aria-label="Abrir menú de secciones">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span>Secciones</span>
      </button>
      <div class="admin-nav-links" id="adminNavLinks">
        <a class:list={['admin-nav-item', { 'is-active': initialSection === 'products' }]} href="/admin?section=products" data-admin-tab="products">Añadir productos</a>
        <a class:list={['admin-nav-item', { 'is-active': initialSection === 'affiliates' }]} href="/admin?section=affiliates" data-admin-tab="affiliates">Afiliados</a>
        <a class:list={['admin-nav-item', { 'is-active': initialSection === 'categories' }]} href="/admin?section=categories" data-admin-tab="categories">Categorías</a>
        <a class:list={['admin-nav-item', { 'is-active': initialSection === 'analytics' }]} href="/admin?section=analytics" data-admin-tab="analytics">Tráfico y ventas</a>
        <a class:list={['admin-nav-item', { 'is-active': initialSection === 'marketing' }]} href="/admin?section=marketing" data-admin-tab="marketing">Marketing</a>
      </div>
      <form method="post" class="admin-logout-form">
        <input type="hidden" name="action" value="logout" />
        <button type="submit" class="admin-logout-button" title="Cerrar sesión" aria-label="Cerrar sesión">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span class="logout-label">Cerrar sesión</span>
        </button>
      </form>
    </nav>

    <!-- 2. SECCIÓN PRINCIPAL: FORMULARIO + LIVE PREVIEW -->
    <section data-admin-view="products" class:list={['admin-grid-section', 'hidden-section', { 'is-visible': initialSection === 'products' }]}>
      <!-- Columna 1: Formulario de Scraping y Edición -->
      <div class="admin-card form-card">
        <div class="card-header">
          <div class="header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div>
            <h2 class="card-title">1. Extracción & Alta de Producto</h2>
            <p class="card-desc">Introduce la URL del producto para extraer metadatos automáticamente o rellenar de forma manual.</p>
          </div>
        </div>

        <!-- Barra de Scraping Rápido -->
        <div class="scrape-box">
          <label for="inputScrapeUrl" class="field-label">
            <span>URL del Producto (Amazon, PcComponentes, etc.)</span>
            <span class="label-hint">Detección automática de OpenGraph</span>
          </label>
          <div class="scrape-input-group">
            <div class="input-icon-wrapper">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </div>
            <input
              type="url"
              id="inputScrapeUrl"
              placeholder="Pega aquí la URL del producto"
              autocomplete="off"
            />
            <button type="button" id="btnScrape" class="btn-primary">
              <span class="btn-text">Analizar Enlace</span>
              <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <div class="btn-spinner" hidden></div>
            </button>
          </div>

          <!-- Mensaje de Feedback de Estado -->
          <div id="scrapeStatusAlert" class="status-alert" hidden>
            <div class="alert-icon" id="statusAlertIcon">ℹ️</div>
            <div class="alert-content">
              <strong id="statusAlertTitle">Estado</strong>
              <p id="statusAlertText">Mensaje...</p>
            </div>
          </div>
        </div>

        <!-- Formulario Editable del Producto -->
        <form id="productForm" class="product-edit-form">
          <input type="hidden" id="prodId" value="" />

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodTitle" class="field-label">Título del Producto <span class="required">*</span></label>
              <input type="text" id="prodTitle" required />
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodPrice" class="field-label">Precio Oferta (€) <span class="required">*</span></label>
              <input type="number" step="0.01" min="0" id="prodPrice" required />
            </div>
            <div class="form-group">
              <label for="prodOriginalPrice" class="field-label">Precio Original (€) <span class="label-hint">(Tachado opcional)</span></label>
              <input type="number" step="0.01" min="0" id="prodOriginalPrice" />
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodCategory" class="field-label">Categoría <span class="required">*</span></label>
              <input
                type="text"
                id="prodCategory"
                list="categoryList"
                required
              />
              <datalist id="categoryList">
                <option value="Informática & Laptops" />
                <option value="Audio & Sonido" />
                <option value="Lectura Digital" />
                <option value="Hogar Inteligente" />
                <option value="Fotografía & Vídeo" />
                <option value="Gaming & Accesorios" />
              </datalist>
            </div>

            <div class="form-group">
              <label for="prodMerchant" class="field-label">Comercio / Tienda <span class="required">*</span></label>
              <select id="prodMerchant" required>
                <option value="" selected disabled>Selecciona un comercio</option>
                <option value="Amazon">Amazon</option>
                <option value="PcComponentes">PcComponentes</option>
                <option value="El Corte Inglés">El Corte Inglés</option>
                <option value="MediaMarkt">MediaMarkt</option>
                <option value="AliExpress">AliExpress</option>
                <option value="Fnac">Fnac</option>
                <option value="Otro">Otro Comercio</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodAffiliateUrl" class="field-label">Enlace de Afiliado Final <span class="required">*</span></label>
              <input type="url" id="prodAffiliateUrl" required />
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodImage" class="field-label">URL de la Imagen <span class="required">*</span></label>
              <input type="url" id="prodImage" required />
            </div>

            <div class="form-group">
              <label for="prodBadge" class="field-label">Etiqueta Destacada (Badge)</label>
              <input type="text" id="prodBadge" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodDescription" class="field-label">Descripción Técnica Concisa</label>
              <textarea id="prodDescription" rows="3"></textarea>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodVerdict" class="field-label">Veredicto Editorial de Tradylor</label>
              <textarea id="prodVerdict" rows="2"></textarea>
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodPros" class="field-label">Puntos Fuertes (Pros) <span class="label-hint">(Uno por línea)</span></label>
              <textarea id="prodPros" rows="3"></textarea>
            </div>
            <div class="form-group">
              <label for="prodCons" class="field-label">Puntos a Considerar (Contras) <span class="label-hint">(Uno por línea)</span></label>
              <textarea id="prodCons" rows="3"></textarea>
            </div>
          </div>

          <!-- Botones de Acción -->
          <div class="form-actions">
            <button type="submit" id="btnSaveProduct" class="btn-success">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
              </svg>
              <span>Guardar producto</span>
            </button>
            <button type="button" id="btnResetForm" class="btn-secondary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
              <span>Limpiar Campos</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Columna 2: Previsualización en Vivo de la Tarjeta Tradylor -->
      <div class="admin-card preview-card">
        <div class="card-header">
          <div class="header-icon icon-cyan">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <div>
            <h2 class="card-title">2. Vista Previa en Tiempo Real</h2>
            <p class="card-desc">Así verá el usuario la ficha en el portal tras guardar los cambios.</p>
          </div>
        </div>

        <div class="preview-container">
          <article class="preview-product-card" id="cardPreview">
            <div class="preview-image-wrapper">
              <img id="previewImg" alt="" loading="lazy" hidden />
              <div id="previewEmptyImage" class="preview-empty-image">
                <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <path d="m21 15-5-5L5 21"></path>
                </svg>
                <span>La imagen aparecerá al analizar el enlace</span>
              </div>
              <div class="preview-badge-row">
                <span id="previewCategory" class="cat-pill"></span>
                <span id="previewBadge" class="badge-pill" hidden></span>
              </div>
            </div>

            <div class="preview-content">
              <div class="preview-merchant-row">
                <span id="previewMerchant" class="merchant-tag"></span>
                <span class="rating-stars" hidden>★★★★★ <span class="rating-num">4.8</span></span>
              </div>

              <h3 id="previewTitle" class="preview-title"></h3>

              <p id="previewDesc" class="preview-desc"></p>

              <div class="preview-pricing">
                <div class="price-wrap">
                  <span id="previewPrice" class="price-current"></span>
                  <span id="previewOriginalPrice" class="price-original" hidden></span>
                </div>
                <span id="previewDiscount" class="discount-pill" hidden></span>
              </div>

              <div class="preview-bullets" id="previewBulletsWrap">
                <div class="bullet-col pros-col">
                  <strong>Puntos Fuertes:</strong>
                  <ul id="previewProsList">
                  </ul>
                </div>
              </div>

              <a
                id="previewAffiliateBtn"
                href="#"
                hidden
                target="_blank"
                rel="nofollow noopener sponsored"
                class="preview-buy-btn"
              >
                <span>Ver producto en</span>
                <strong id="previewBtnMerchant">Amazon</strong>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 3. LISTADO RÁPIDO DE PRODUCTOS EXISTENTES -->
    <section id="catalogProducts" data-admin-view="products" class:list={['admin-card', 'products-list-card', 'hidden-section', { 'is-visible': initialSection === 'products' }]}>
      <div class="list-header-row">
        <div>
          <h2 class="card-title">3. Catálogo de Productos Registrados</h2>
          <p class="card-desc">Consulta los productos activos en <code>src/data/products.json</code>, pruébalos o elimínalos.</p>
        </div>
        <div class="list-search-wrapper">
          <input type="search" id="inputFilterList" placeholder="Filtrar por título o comercio..." />
        </div>
      </div>

      <div class="products-table-responsive">
        <table class="products-table" id="productsTable">
          <thead>
            <tr>
              <th>Imagen</th>
              <th>Producto & Categoría</th>
              <th>Comercio</th>
              <th>Precio</th>
              <th>Enlace Afiliado</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="productsTableBody">
            {initialProducts.length === 0 ? (
              <tr class="empty-row">
                <td colspan="6">No hay productos registrados en el catálogo aún.</td>
              </tr>
            ) : (
              initialProducts.map((p) => (
                <tr data-product-id={p.id} class="product-row">
                  <td class="col-thumb">
                    <img src={p.image} alt={p.title} class="thumb-img" loading="lazy" />
                  </td>
                  <td class="col-details">
                    <div class="row-title">{p.title}</div>
                    <div class="row-meta">
                      <span class="pill-category">{p.category}</span>
                      {p.badge && <span class="pill-badge">{p.badge}</span>}
                    </div>
                  </td>
                  <td class="col-merchant">
                    <span class="merchant-badge">{p.merchant}</span>
                  </td>
                  <td class="col-price">
                    <span class="price-val">{p.price.toFixed(2)} €</span>
                    {p.originalPrice && <span class="price-old">{p.originalPrice.toFixed(2)} €</span>}
                  </td>
                  <td class="col-link">
                    <a
                      href={p.affiliateUrl}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="test-link"
                      title="Probar enlace de afiliado"
                    >
                      Probar Enlace
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  </td>
                  <td class="col-actions text-right">
                    <button
                      type="button"
                      class="btn-icon-action btn-edit-row"
                      data-id={p.id}
                      title="Cargar y editar en formulario"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="btn-icon-action btn-delete-row"
                      data-id={p.id}
                      title="Eliminar producto"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>

    <section data-admin-view="affiliates" class:list={['admin-dashboard-view', 'hidden-section', { 'is-visible': initialSection === 'affiliates' }]}>
      <div class="view-heading">
        <span class="admin-tag-pill">Integraciones de monetización</span>
        <h2 class="admin-title">Afiliados y Multi-Catálogo</h2>
        <p class="admin-subtitle">Conecta redes de afiliación con sus credenciales, valida la conexión y busca productos en paralelo en todos los catálogos. Importa los mejores resultados a Tradylor con un clic: el enmascaramiento /out/[id] se aplica automáticamente.</p>
      </div>

      <div class="affiliates-layout">
        <!-- Columna 1: Gestor de credenciales multi-red -->
        <div class="admin-card">
          <div class="card-header">
            <div class="header-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <div>
              <h2 class="card-title">1. Redes conectadas</h2>
              <p class="card-desc">Guarda las credenciales de cada red y valida la conexión. Los valores secretos nunca se devuelven al navegador.</p>
            </div>
          </div>
          <div id="networkList" class="network-list">
            <div class="loading-panel">Cargando redes...</div>
          </div>
        </div>

        <!-- Columna 2: Buscador global unificado -->
        <div class="admin-card">
          <div class="card-header">
            <div class="header-icon icon-cyan">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <div>
              <h2 class="card-title">2. Buscador global multi-red</h2>
              <p class="card-desc">Consulta en paralelo los catálogos de las redes conectadas y ordena por conversión.</p>
            </div>
          </div>

          <div class="search-controls">
            <div class="search-input-group">
              <input type="search" id="unifiedQuery" placeholder="Buscar en todos los catálogos conectados (ej: auriculares, robot aspirador...)" />
              <button type="button" id="btnUnifiedSearch" class="btn-primary">
                <span class="btn-text">Buscar</span>
                <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <div class="btn-spinner" hidden></div>
              </button>
            </div>

            <div class="search-filters">
              <div class="filter-field">
                <label for="filterMinPrice">Precio mín. (€)</label>
                <input type="number" id="filterMinPrice" min="0" step="1" placeholder="0" />
              </div>
              <div class="filter-field">
                <label for="filterMaxPrice">Precio máx. (€)</label>
                <input type="number" id="filterMaxPrice" min="0" step="1" placeholder="Sin tope" />
              </div>
              <div class="filter-field">
                <label for="filterMinCommission">Comisión mín. (%)</label>
                <input type="number" id="filterMinCommission" min="0" max="100" step="0.5" placeholder="0" />
              </div>
              <div class="filter-field">
                <label for="filterSort">Ordenar por</label>
                <select id="filterSort">
                  <option value="commission" selected>Mayor comisión</option>
                  <option value="popularity">Popularidad</option>
                  <option value="rating">Mejor valoración</option>
                  <option value="price_asc">Precio: menor a mayor</option>
                  <option value="price_desc">Precio: mayor a menor</option>
                </select>
              </div>
              <label class="filter-check">
                <input type="checkbox" id="filterInStock" />
                <span>Solo con stock</span>
              </label>
            </div>
          </div>

          <div id="searchStatus" class="status-alert" hidden>
            <div class="alert-icon">ℹ️</div>
            <div class="alert-content">
              <strong id="searchStatusTitle">Estado</strong>
              <p id="searchStatusText">Mensaje...</p>
            </div>
          </div>

          <div id="networkStatusRow" class="network-status-row"></div>

          <div id="unifiedResults" class="unified-results">
            <div class="empty-dashboard">Conecta al menos una red y lanza una búsqueda para comparar productos entre catálogos.</div>
          </div>
        </div>
      </div>
    </section>

    <section data-admin-view="categories" class:list={['admin-dashboard-view', 'hidden-section', { 'is-visible': initialSection === 'categories' }]}>
      <div class="view-heading"><span class="admin-tag-pill">Organización del catálogo</span><h2 class="admin-title">Categorías</h2><p class="admin-subtitle">Crea y mantiene las categorías disponibles para clasificar productos importados y añadidos manualmente.</p></div>
    </section>

    <section data-admin-view="analytics" class:list={['admin-dashboard-view', 'hidden-section', { 'is-visible': initialSection === 'analytics' }]}>
      <div class="view-heading">
        <span class="admin-tag-pill">Actividad de la tienda</span>
        <h2 class="admin-title">Tráfico y ventas</h2>
        <p class="admin-subtitle">Métricas propias de navegación e interés, y el motor de curación que cruza los catálogos importados para detectar los productos con mayor potencial de conversión.</p>
      </div>

      <!-- 1. Métricas de tráfico (SSR) -->
      <div class="admin-card">
        <div class="card-header">
          <div class="header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="20" x2="12" y2="10"></line>
              <line x1="18" y1="20" x2="18" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="16"></line>
            </svg>
          </div>
          <div>
            <h2 class="card-title">1. Actividad registrada</h2>
            <p class="card-desc">Eventos capturados por el tracker propio (page views, clics, carrito y salidas a tiendas).</p>
          </div>
        </div>
        <div class="dashboard-metric-grid">
          <div class="dashboard-metric"><span>Visitas</span><strong>{analyticsSummary.pageViews}</strong><small>eventos page_view</small></div>
          <div class="dashboard-metric"><span>Clics en producto</span><strong>{analyticsSummary.productClicks}</strong><small>eventos product_click</small></div>
          <div class="dashboard-metric"><span>Añadidos al carrito</span><strong>{analyticsSummary.cartAdds}</strong><small>eventos cart_add</small></div>
          <div class="dashboard-metric"><span>Salidas a comercio</span><strong>{analyticsSummary.outboundClicks}</strong><small>eventos outbound_click</small></div>
        </div>
        <div class="funnel-row">
          {(() => {
            const clickRate = analyticsSummary.pageViews > 0 ? Math.round((analyticsSummary.productClicks / analyticsSummary.pageViews) * 100) : 0;
            const cartRate = analyticsSummary.productClicks > 0 ? Math.round((analyticsSummary.cartAdds / analyticsSummary.productClicks) * 100) : 0;
            const outRate = analyticsSummary.cartAdds > 0 ? Math.round((analyticsSummary.outboundClicks / analyticsSummary.cartAdds) * 100) : 0;
            return (
              <>
                <div class="funnel-step"><span class="funnel-label">Visita → Clic en ficha</span><div class="funnel-bar"><div class="funnel-fill" style={`width:${Math.max(clickRate, 2)}%`}></div></div><span class="funnel-value">{clickRate}%</span></div>
                <div class="funnel-step"><span class="funnel-label">Clic → Añadir al carrito</span><div class="funnel-bar"><div class="funnel-fill" style={`width:${Math.max(cartRate, 2)}%`}></div></div><span class="funnel-value">{cartRate}%</span></div>
                <div class="funnel-step"><span class="funnel-label">Carrito → Salida a tienda</span><div class="funnel-bar"><div class="funnel-fill" style={`width:${Math.max(outRate, 2)}%`}></div></div><span class="funnel-value">{outRate}%</span></div>
              </>
            );
          })()}
        </div>
      </div>

      <!-- 2. Motor de curación: Índice de Oportunidad -->
      <div class="admin-card">
        <div class="card-header">
          <div class="header-icon icon-cyan">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div>
            <h2 class="card-title">2. Curación por Índice de Oportunidad</h2>
            <p class="card-desc">Cruce automático del catálogo: comisión estimada (40%), margen de precio (25%), popularidad (25%) y calidad editorial (10%).</p>
          </div>
        </div>

        <div class="curation-table-wrap">
          <table class="curation-table">
            <thead>
              <tr>
                <th>Índice</th>
                <th>Producto</th>
                <th>Red</th>
                <th>Precio</th>
                <th>Comisión est.</th>
                <th>Dto.</th>
                <th>Valoración</th>
                <th>Desglose</th>
                <th class="text-right">Acción</th>
              </tr>
            </thead>
            <tbody>
              {scoredCatalog.length === 0 ? (
                <tr class="empty-row"><td colspan="9">No hay productos en el catálogo todavía. Añade o importa productos para activar la curación.</td></tr>
              ) : (
                scoredCatalog.map(({ product, score, tier, breakdown, signals }) => (
                  <tr class="curation-row">
                    <td>
                      <div class="opp-score" title={`Índice de Oportunidad: ${score}/100`}>
                        <svg viewBox="0 0 36 36" class="opp-ring" aria-hidden="true">
                          <circle cx="18" cy="18" r="15.5" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="3.5"></circle>
                          <circle cx="18" cy="18" r="15.5" fill="none" stroke={tier === 'top' ? '#10b981' : tier === 'alta' ? '#38bdf8' : tier === 'media' ? '#f59e0b' : '#6b7280'} stroke-width="3.5" stroke-dasharray={`${(score / 100) * 97.4} 97.4`} stroke-linecap="round" transform="rotate(-90 18 18)"></circle>
                        </svg>
                        <span class="opp-number">{score}</span>
                      </div>
                    </td>
                    <td class="curation-product">
                      <img src={product.image} alt="" class="curation-thumb" loading="lazy" />
                      <div>
                        <div class="curation-name">{product.title}</div>
                        <span class={`opp-tier tier-${tier}`}>{tier === 'top' ? 'Top' : tier === 'alta' ? 'Alta' : tier === 'media' ? 'Media' : 'Baja'}</span>
                      </div>
                    </td>
                    <td><span class="merchant-badge">{product.merchant}</span></td>
                    <td class="curation-price">{product.price.toFixed(2)} €</td>
                    <td class="curation-commission">{signals.commissionAmount.toFixed(2)} €<small>{signals.commissionRate}%</small></td>
                    <td>{signals.discountPercent != null ? <span class="cell-discount">-{signals.discountPercent}%</span> : <span class="cell-empty">—</span>}</td>
                    <td>{signals.rating != null ? <span class="curation-rating">★ {signals.rating.toFixed(1)}</span> : <span class="cell-empty">—</span>}</td>
                    <td>
                      <div class="opp-breakdown">
                        <span title="Comisión estimada (máx 40)">C {breakdown.commission}</span>
                        <span title="Margen de precio (máx 25)">M {breakdown.priceMargin}</span>
                        <span title="Popularidad (máx 25)">P {breakdown.popularity}</span>
                        <span title="Calidad editorial (máx 10)">E {breakdown.editorial}</span>
                      </div>
                    </td>
                    <td class="text-right">
                      <button
                        type="button"
                        class="btn-feature-row"
                        data-id={product.id}
                        data-title={product.title}
                        title="Cargar en el editor para destacarla en la web"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        Destacar
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
        <p class="curation-note">El enlace de compra siempre queda enmascarado mediante <code>/out/[id]</code>. «Destacar» carga la ficha en el editor de Añadir productos para asignarle badge o ajustarla antes de publicar.</p>
      </div>
    </section>

    <section data-admin-view="marketing" class:list={['admin-dashboard-view', 'hidden-section', { 'is-visible': initialSection === 'marketing' }]}>
      <div class="view-heading"><span class="admin-tag-pill">Crecimiento y distribución</span><h2 class="admin-title">Marketing</h2><p class="admin-subtitle">Prepara conexiones con analítica, redes sociales, email y automatizaciones. Las credenciales se leen desde el entorno del servidor.</p></div>
    </section>
  </div>
  ) : (
    <main class="admin-login-page">
      <section class="admin-login-panel" aria-labelledby="admin-login-title">
        <div class="admin-login-mark"><span class="status-indicator"></span><span>TRADYLOR / ADMIN</span></div>
        <p class="admin-login-kicker">Área privada de gestión</p>
        <h1 id="admin-login-title" class="admin-login-title">Accede a tu panel</h1>
        <p class="admin-login-description">Gestiona el catálogo, analiza enlaces y publica recomendaciones desde el centro de curación de Tradylor.</p>
        {loginError && <p class="admin-login-error" role="alert">{loginError}</p>}
        <form method="post" class="admin-login-form">
          <label class="login-field"><span>Usuario</span><input name="username" type="text" autocomplete="username" required autofocus /></label>
          <label class="login-field"><span>Contraseña</span><input name="password" type="password" autocomplete="current-password" required /></label>
          <button type="submit" class="admin-login-submit">Entrar al panel <span aria-hidden="true">-&gt;</span></button>
        </form>
        <p class="admin-login-footer"><span class="status-indicator"></span> Conexión privada protegida</p>
      </section>
      <aside class="admin-login-aside" aria-hidden="true"><span class="aside-index">01 / 03</span><strong>Curación<br />sin ruido.</strong><span class="aside-line"></span></aside>
    </main>
  )}
</Layout>

<!-- Client-side Script para interacción dinámica del panel -->
<script is:inline>
  // Inicialización de estado y elementos DOM
  document.addEventListener('DOMContentLoaded', () => {
    // Menú responsive del backend: despliega las secciones en pantallas estrechas
    const navToggle = document.getElementById('adminNavToggle');
    const navLinks = document.getElementById('adminNavLinks');
    navToggle?.addEventListener('click', () => {
      const isOpen = navLinks?.classList.toggle('is-open');
      navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
    navLinks?.addEventListener('click', (event) => {
      if (event.target.closest('.admin-nav-item')) {
        navLinks.classList.remove('is-open');
        navToggle?.setAttribute('aria-expanded', 'false');
      }
    });

    // Inputs
    const inputScrapeUrl = document.getElementById('inputScrapeUrl');
    const btnScrape = document.getElementById('btnScrape');
    const btnSpinner = btnScrape ? btnScrape.querySelector('.btn-spinner') : null;
    const btnText = btnScrape ? btnScrape.querySelector('.btn-text') : null;

    const scrapeStatusAlert = document.getElementById('scrapeStatusAlert');
    const statusAlertIcon = document.getElementById('statusAlertIcon');
    const statusAlertTitle = document.getElementById('statusAlertTitle');
    const statusAlertText = document.getElementById('statusAlertText');

    const productForm = document.getElementById('productForm');
    const prodId = document.getElementById('prodId');
    const prodTitle = document.getElementById('prodTitle');
    const prodPrice = document.getElementById('prodPrice');
    const prodOriginalPrice = document.getElementById('prodOriginalPrice');
    const prodCategory = document.getElementById('prodCategory');
    const prodMerchant = document.getElementById('prodMerchant');
    const prodAffiliateUrl = document.getElementById('prodAffiliateUrl');
    const prodImage = document.getElementById('prodImage');
    const prodBadge = document.getElementById('prodBadge');
    const prodDescription = document.getElementById('prodDescription');
    const prodVerdict = document.getElementById('prodVerdict');
    const prodPros = document.getElementById('prodPros');
    const prodCons = document.getElementById('prodCons');
    const btnResetForm = document.getElementById('btnResetForm');
    const btnSaveProduct = document.getElementById('btnSaveProduct');

    // Preview
    const previewImg = document.getElementById('previewImg');
    const previewEmptyImage = document.getElementById('previewEmptyImage');
    const previewCategory = document.getElementById('previewCategory');
    const previewBadge = document.getElementById('previewBadge');
    const previewMerchant = document.getElementById('previewMerchant');
    const previewTitle = document.getElementById('previewTitle');
    const previewDesc = document.getElementById('previewDesc');
    const previewPrice = document.getElementById('previewPrice');
    const previewOriginalPrice = document.getElementById('previewOriginalPrice');
    const previewDiscount = document.getElementById('previewDiscount');
    const previewProsList = document.getElementById('previewProsList');
    const previewBulletsWrap = document.getElementById('previewBulletsWrap');
    const previewAffiliateBtn = document.getElementById('previewAffiliateBtn');
    const previewBtnMerchant = document.getElementById('previewBtnMerchant');

    // Listado de productos
    const productsTableBody = document.getElementById('productsTableBody');
    const inputFilterList = document.getElementById('inputFilterList');

    // Helper para mostrar feedback de alerta
    function showAlert(type, title, message) {
      if (!scrapeStatusAlert) return;
      scrapeStatusAlert.hidden = false;
      scrapeStatusAlert.className = `status-alert alert-${type}`;
      
      if (type === 'success') {
        statusAlertIcon.textContent = '✅';
      } else if (type === 'warning') {
        statusAlertIcon.textContent = '⚠️';
      } else if (type === 'loading') {
        statusAlertIcon.textContent = '⏳';
      } else {
        statusAlertIcon.textContent = '❌';
      }

      statusAlertTitle.textContent = title;
      statusAlertText.textContent = message;
    }

    function hideAlert() {
      if (scrapeStatusAlert) scrapeStatusAlert.hidden = true;
    }

    function setProductField(field, value) {
      if (!field || value === undefined || value === null) return;
      field.value = String(value);
      field.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // Actualiza la vista previa interactiva en tiempo real
    function updatePreview() {
      const title = prodTitle.value.trim();
      const price = parseFloat(prodPrice.value) || 0;
      const originalPrice = parseFloat(prodOriginalPrice.value) || 0;
      const category = prodCategory.value.trim();
      const merchant = prodMerchant.value;
      const image = prodImage.value.trim();
      const badge = prodBadge.value.trim();
      const desc = prodDescription.value.trim();
      const url = prodAffiliateUrl.value.trim() || '#';

      if (previewTitle) previewTitle.textContent = title;
      if (previewDesc) previewDesc.textContent = desc;
      if (previewPrice) previewPrice.textContent = `${price.toFixed(2)} €`;
      if (previewCategory) previewCategory.textContent = category;
      if (previewMerchant) previewMerchant.textContent = merchant;
      if (previewBtnMerchant) previewBtnMerchant.textContent = merchant;
      if (previewImg && previewEmptyImage) {
        previewImg.hidden = !image;
        previewEmptyImage.hidden = Boolean(image);
        if (image) previewImg.src = image;
      }
      if (previewAffiliateBtn) {
        previewAffiliateBtn.href = url;
        previewAffiliateBtn.hidden = !prodAffiliateUrl.value.trim();
      }
      if (previewCategory) previewCategory.hidden = !category;
      if (previewMerchant) previewMerchant.hidden = !merchant;
      if (previewDesc) previewDesc.hidden = !desc;
      if (previewPrice) previewPrice.parentElement.parentElement.hidden = price <= 0;

      if (previewBadge) {
        if (badge) {
          previewBadge.textContent = badge;
          previewBadge.hidden = false;
        } else {
          previewBadge.hidden = true;
        }
      }

      if (previewOriginalPrice && previewDiscount) {
        if (originalPrice > price && price > 0) {
          previewOriginalPrice.textContent = `${originalPrice.toFixed(2)} €`;
          previewOriginalPrice.hidden = false;
          const discountPct = Math.round(((originalPrice - price) / originalPrice) * 100);
          previewDiscount.textContent = `-${discountPct}%`;
          previewDiscount.hidden = false;
        } else {
          previewOriginalPrice.hidden = true;
          previewDiscount.hidden = true;
        }
      }

      if (previewProsList) {
        const pros = prodPros.value
          .split('\n')
          .map((s) => s.trim())
          .filter(Boolean);
        previewProsList.innerHTML = '';
        if (pros.length > 0) {
          if (previewBulletsWrap) previewBulletsWrap.hidden = false;
          pros.slice(0, 3).forEach((pro) => {
            const li = document.createElement('li');
            li.textContent = pro;
            previewProsList.appendChild(li);
          });
        } else {
          if (previewBulletsWrap) previewBulletsWrap.hidden = true;
        }
      }
    }

    // Escuchadores para actualización en vivo del preview
    [
      prodTitle,
      prodPrice,
      prodOriginalPrice,
      prodCategory,
      prodMerchant,
      prodAffiliateUrl,
      prodImage,
      prodBadge,
      prodDescription,
      prodPros,
    ].forEach((el) => {
      if (el) el.addEventListener('input', updatePreview);
    });

    // =========================================================================
    // 1. ANALIZAR URL (Scraping Híbrido con Endpoint API)
    // =========================================================================
    if (btnScrape && inputScrapeUrl) {
      btnScrape.addEventListener('click', async () => {
        const urlToScrape = inputScrapeUrl.value.trim();
        if (!urlToScrape) {
          showAlert('warning', 'URL requerida', 'Por favor, pega el enlace del producto antes de analizar.');
          inputScrapeUrl.focus();
          return;
        }

        // Estado visual de carga
        btnScrape.disabled = true;
        if (btnSpinner) btnSpinner.hidden = false;
        if (btnText) btnText.textContent = 'Extrayendo...';
        showAlert('loading', 'Analizando página externa...', 'Haciendo fetch con User-Agent legítimo y extrayendo OpenGraph/Schemas.');

        try {
          const response = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'scrape', url: urlToScrape }),
          });

          const result = await response.json();

          if (!result.success) {
            showAlert('error', 'Error en análisis', result.message || 'No se pudo procesar la solicitud.');
            return;
          }

          const data = result.data || {};

          // Rellenar campos del formulario
          setProductField(prodTitle, data.title || data.name || '');
          setProductField(prodImage, data.image || '');
          setProductField(prodDescription, data.description || '');
          setProductField(prodPrice, data.price ?? '');
          setProductField(prodOriginalPrice, data.originalPrice ?? '');
          setProductField(prodCategory, data.category || 'Tecnología');
          setProductField(prodMerchant, data.merchant || 'Amazon');
          setProductField(prodBadge, data.badge || '');
          setProductField(prodVerdict, data.verdict || '');
          setProductField(prodPros, Array.isArray(data.pros) ? data.pros.join('\n') : '');
          setProductField(prodCons, Array.isArray(data.cons) ? data.cons.join('\n') : '');
          setProductField(prodAffiliateUrl, data.affiliateUrl || urlToScrape);

          updatePreview();

          if (result.scraped) {
            showAlert(
              'success',
              'Metadatos extraídos con éxito',
              'Título, imagen, comercio y precio fueron detectados. Revisa y pulsa "Guardar producto".'
            );
          } else {
            showAlert(
              'warning',
              'Extracción bloqueada por el comercio (403/Anti-bot)',
              result.message || 'La tienda protegió el acceso automático. Por favor, rellena los campos restantes manualmente.'
            );
          }
        } catch (err) {
          console.error(err);
          showAlert(
            'warning',
            'Fallo de conexión',
            'No se pudo comunicar con el endpoint. Puedes rellenar los datos de forma manual.'
          );
        } finally {
          btnScrape.disabled = false;
          if (btnSpinner) btnSpinner.hidden = true;
          if (btnText) btnText.textContent = 'Analizar Enlace';
        }
      });

      // Permitir pulsar Enter en el input de URL para disparar el análisis
      inputScrapeUrl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          btnScrape.click();
        }
      });

      // Permitir pegar el enlace directamente en el campo final del producto.
      if (prodAffiliateUrl) {
        const analyzeAffiliateUrl = () => {
          const affiliateUrl = prodAffiliateUrl.value.trim();
          if (!affiliateUrl || affiliateUrl === inputScrapeUrl.value.trim()) return;
          inputScrapeUrl.value = affiliateUrl;
          btnScrape.click();
        };

        prodAffiliateUrl.addEventListener('paste', () => window.setTimeout(analyzeAffiliateUrl, 0));
        prodAffiliateUrl.addEventListener('change', analyzeAffiliateUrl);
      }
    }

    // =========================================================================
    // 2. GUARDAR PRODUCTO (POST al Endpoint)
    // =========================================================================
    if (productForm) {
      productForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const productPayload = {
          id: prodId.value.trim() || undefined,
          title: prodTitle.value.trim(),
          price: parseFloat(prodPrice.value) || 0,
          originalPrice: prodOriginalPrice.value ? parseFloat(prodOriginalPrice.value) : undefined,
          category: prodCategory.value.trim() || 'Tecnología',
          merchant: prodMerchant.value || 'Amazon',
          affiliateUrl: prodAffiliateUrl.value.trim(),
          image: prodImage.value.trim(),
          badge: prodBadge.value.trim() || undefined,
          description: prodDescription.value.trim(),
          verdict: prodVerdict.value.trim() || undefined,
          pros: prodPros.value
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
          cons: prodCons.value
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
        };

        if (btnSaveProduct) {
          btnSaveProduct.disabled = true;
          btnSaveProduct.classList.add('loading');
        }

        showAlert('loading', 'Guardando producto...', 'Escribiendo en src/data/products.json...');

        try {
          const response = await fetch('/api/products/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save', product: productPayload }),
          });

          const result = await response.json();

          if (result.success) {
            // Recargar lista de productos inmediatamente
            await reloadProductsTable();
            document.getElementById('catalogProducts')?.scrollIntoView({ behavior: 'smooth', block: 'start' });

            // Dejar el formulario preparado para un producto nuevo.
            prodId.value = '';
            prodTitle.value = '';
            prodPrice.value = '';
            prodOriginalPrice.value = '';
            prodCategory.value = '';
            prodMerchant.value = '';
            prodAffiliateUrl.value = '';
            prodImage.value = '';
            prodBadge.value = '';
            prodDescription.value = '';
            prodVerdict.value = '';
            prodPros.value = '';
            prodCons.value = '';
            if (inputScrapeUrl) inputScrapeUrl.value = '';
            updatePreview();
            showAlert('success', '¡Producto guardado!', result.message || 'El producto ha sido añadido al catálogo.');
          } else {
            showAlert('error', 'Error al guardar', result.message || 'No se pudo guardar el producto.');
          }
        } catch (err) {
          console.error(err);
          showAlert('error', 'Error de red', 'No se pudo enviar la solicitud al servidor.');
        } finally {
          if (btnSaveProduct) {
            btnSaveProduct.disabled = false;
            btnSaveProduct.classList.remove('loading');
          }
        }
      });
    }

    // =========================================================================
    // 3. LIMPIAR FORMULARIO
    // =========================================================================
    if (btnResetForm) {
      btnResetForm.addEventListener('click', () => {
        prodId.value = '';
        prodTitle.value = '';
        prodPrice.value = '';
        prodOriginalPrice.value = '';
        prodCategory.value = '';
        prodMerchant.value = '';
        prodAffiliateUrl.value = '';
        prodImage.value = '';
        prodBadge.value = '';
        prodDescription.value = '';
        prodVerdict.value = '';
        prodPros.value = '';
        prodCons.value = '';
        if (inputScrapeUrl) inputScrapeUrl.value = '';
        hideAlert();
        updatePreview();
      });
    }

    // =========================================================================
    // 4. ELIMINAR Y EDITAR PRODUCTOS DE LA TABLA
    // =========================================================================
    async function reloadProductsTable() {
      try {
        const res = await fetch('/api/products/add');
        const data = await res.json();
        if (data.success && Array.isArray(data.products)) {
          renderTableRows(data.products);
        }
      } catch (err) {
        console.error('Error al recargar productos:', err);
      }
    }

    function renderTableRows(products) {
      if (!productsTableBody) return;

      if (products.length === 0) {
        productsTableBody.innerHTML = `
          <tr class="empty-row">
            <td colspan="6">No hay productos registrados en el catálogo aún.</td>
          </tr>
        `;
        return;
      }

      productsTableBody.innerHTML = products
        .map(
          (p) => `
          <tr data-product-id="${p.id}" class="product-row">
            <td class="col-thumb">
              <img src="${p.image}" alt="${p.title}" class="thumb-img" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=800&auto=format&fit=crop'" />
            </td>
            <td class="col-details">
              <div class="row-title">${p.title}</div>
              <div class="row-meta">
                <span class="pill-category">${p.category}</span>
                ${p.badge ? `<span class="pill-badge">${p.badge}</span>` : ''}
              </div>
            </td>
            <td class="col-merchant">
              <span class="merchant-badge">${p.merchant}</span>
            </td>
            <td class="col-price">
              <span class="price-val">${Number(p.price).toFixed(2)} €</span>
              ${p.originalPrice ? `<span class="price-old">${Number(p.originalPrice).toFixed(2)} €</span>` : ''}
            </td>
            <td class="col-link">
              <a href="${p.affiliateUrl}" target="_blank" rel="nofollow noopener noreferrer" class="test-link">
                Probar Enlace
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </td>
            <td class="col-actions text-right">
              <button type="button" class="btn-icon-action btn-edit-row" data-id="${p.id}" title="Cargar en formulario">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
              </button>
              <button type="button" class="btn-icon-action btn-delete-row" data-id="${p.id}" title="Eliminar producto">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </td>
          </tr>
        `
        )
        .join('');

      attachRowActions();
    }

    function attachRowActions() {
      // 1. Borrar producto
      document.querySelectorAll('.btn-delete-row').forEach((btn) => {
        btn.onclick = async () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;

          const confirmed = confirm(`¿Estás seguro de que deseas eliminar este producto del catálogo?`);
          if (!confirmed) return;

          showAlert('loading', 'Eliminando producto...', `Eliminando ID: ${id}`);

          try {
            const res = await fetch('/api/products/add', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', id }),
            });
            const data = await res.json();

            if (data.success) {
              showAlert('success', 'Producto Eliminado', 'El producto ha sido retirado de products.json.');
              await reloadProductsTable();
            } else {
              showAlert('error', 'Error al eliminar', data.message || 'No se pudo eliminar el producto.');
            }
          } catch (err) {
            showAlert('error', 'Error de red', 'Fallo al comunicar con el servidor.');
          }
        };
      });

      // 2. Editar producto (cargar en formulario)
      document.querySelectorAll('.btn-edit-row').forEach((btn) => {
        btn.onclick = async () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;

          try {
            const res = await fetch('/api/products/add');
            const data = await res.json();
            const product = (data.products || []).find((p) => p.id === id);

            if (product) {
              prodId.value = product.id || '';
              prodTitle.value = product.title || '';
              prodPrice.value = product.price !== undefined ? product.price : '';
              prodOriginalPrice.value = product.originalPrice !== undefined ? product.originalPrice : '';
              prodCategory.value = product.category || '';
              prodMerchant.value = product.merchant || 'Amazon';
              prodAffiliateUrl.value = product.affiliateUrl || '';
              prodImage.value = product.image || '';
              prodBadge.value = product.badge || '';
              prodDescription.value = product.description || '';
              prodVerdict.value = product.verdict || '';
              prodPros.value = Array.isArray(product.pros) ? product.pros.join('\n') : '';
              prodCons.value = Array.isArray(product.cons) ? product.cons.join('\n') : '';

              if (inputScrapeUrl) inputScrapeUrl.value = product.affiliateUrl || '';

              updatePreview();
              showAlert('success', 'Producto Cargado en Formulario', `Editando "${product.title}". Modifica los campos y pulsa Guardar.`);
              window.scrollTo({ top: productForm.offsetTop - 80, behavior: 'smooth' });
            }
          } catch (err) {
            console.error(err);
          }
        };
      });
    }

    // Filtro buscador en la tabla
    if (inputFilterList) {
      inputFilterList.addEventListener('input', () => {
        const query = inputFilterList.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#productsTableBody tr.product-row');
        rows.forEach((row) => {
          const text = row.textContent ? row.textContent.toLowerCase() : '';
          row.style.display = text.includes(query) ? '' : 'none';
        });
      });
    }

    // Inicializar listeners en los rows SSR iniciales
    attachRowActions();

    // =========================================================================
    // 5. MÓDULO DE AFILIADOS Y MULTI-CATÁLOGO
    // =========================================================================
    const networkList = document.getElementById('networkList');
    const unifiedQuery = document.getElementById('unifiedQuery');
    const btnUnifiedSearch = document.getElementById('btnUnifiedSearch');
    const unifiedResults = document.getElementById('unifiedResults');
    const networkStatusRow = document.getElementById('networkStatusRow');
    const searchStatus = document.getElementById('searchStatus');
    const searchStatusTitle = document.getElementById('searchStatusTitle');
    const searchStatusText = document.getElementById('searchStatusText');
    let networksCache = [];

    function showSearchStatus(type, title, message) {
      if (!searchStatus) return;
      searchStatus.hidden = false;
      searchStatus.className = `status-alert alert-${type}`;
      if (searchStatusTitle) searchStatusTitle.textContent = title;
      if (searchStatusText) searchStatusText.textContent = message;
    }

    async function postNetworks(payload) {
      const res = await fetch('/api/admin/networks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      return res.json();
    }

    function statusLabel(status) {
      return status === 'connected' ? 'Conectada' : status === 'error' ? 'Error' : 'Pendiente';
    }

    function renderNetworks(networks) {
      networksCache = networks;
      if (!networkList) return;
      networkList.innerHTML = networks.map((network) => `
        <details class="network-item" data-network-id="${network.id}">
          <summary>
            <span class="network-color" style="background:${network.color}"></span>
            <span class="network-main">
              <span class="network-name">${network.name}</span>
              <span class="network-region">${network.region}</span>
            </span>
            <span class="integration-status ${network.status === 'connected' ? 'is-configured' : ''} ${network.status === 'error' ? 'is-error' : ''}">${statusLabel(network.status)}</span>
          </summary>
          <div class="network-body">
            <p class="network-desc">${network.description}</p>
            <form class="network-cred-form" data-network-id="${network.id}">
              ${network.fields.map((field) => `
                <label class="cred-field">
                  <span>${field.label}${field.required ? ' *' : ''}</span>
                  <input
                    type="${field.secret ? 'password' : 'text'}"
                    name="${field.key}"
                    placeholder="${field.hasValue ? '•••••••• (guardado)' : (field.placeholder || 'Sin configurar')}"
                    autocomplete="off"
                  />
                </label>
              `).join('')}
              <div class="network-actions">
                <button type="submit" class="btn-primary btn-sm">Guardar</button>
                <button type="button" class="btn-secondary btn-sm" data-network-validate="${network.id}">Validar</button>
                <button type="button" class="btn-danger-ghost btn-sm" data-network-delete="${network.id}">Desconectar</button>
                <a class="network-doc" href="${network.docUrl}" target="_blank" rel="noopener noreferrer">Documentación</a>
              </div>
              <p class="network-feedback" data-network-feedback="${network.id}">${network.statusDetail || ''}</p>
            </form>
          </div>
        </details>
      `).join('');
    }

    async function loadNetworks() {
      try {
        const res = await fetch('/api/admin/data');
        const data = await res.json();
        if (data.success && Array.isArray(data.networks)) renderNetworks(data.networks);
      } catch {
        if (networkList) networkList.innerHTML = '<div class="empty-dashboard">No se pudieron cargar las redes.</div>';
      }
    }

    networkList?.addEventListener('submit', async (event) => {
      const form = event.target.closest('.network-cred-form');
      if (!form) return;
      event.preventDefault();
      const networkId = form.dataset.networkId;
      const values = Object.fromEntries(new FormData(form).entries());
      const data = await postNetworks({ action: 'save', networkId, values });
      if (data.success) {
        renderNetworks(data.networks);
        const item = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (item) item.open = true;
        const feedback = networkList.querySelector(`[data-network-feedback="${networkId}"]`);
        if (feedback) feedback.textContent = 'Credenciales guardadas. Pulsa "Validar" para comprobar la conexión.';
      }
    });

    networkList?.addEventListener('click', async (event) => {
      const validateBtn = event.target.closest('[data-network-validate]');
      const deleteBtn = event.target.closest('[data-network-delete]');

      if (validateBtn) {
        const networkId = validateBtn.dataset.networkValidate;
        const feedback = networkList.querySelector(`[data-network-feedback="${networkId}"]`);
        validateBtn.disabled = true;
        if (feedback) feedback.textContent = 'Validando conexión...';
        const data = await postNetworks({ action: 'validate', networkId });
        validateBtn.disabled = false;
        if (data.networks) renderNetworks(data.networks);
        const item = networkList.querySelector(`details[data-network-id="${networkId}"]`);
        if (item) item.open = true;
        const newFeedback = networkList.querySelector(`[data-network-feedback="${networkId}"]`);
        if (newFeedback) newFeedback.textContent = data.message || '';
      }

      if (deleteBtn) {
        const networkId = deleteBtn.dataset.networkDelete;
        if (!window.confirm('¿Desconectar esta red? Se eliminarán sus credenciales almacenadas.')) return;
        const data = await postNetworks({ action: 'delete', networkId });
        if (data.success) renderNetworks(data.networks);
      }
    });

    function renderNetworkStatuses(byNetwork) {
      if (!networkStatusRow) return;
      networkStatusRow.innerHTML = byNetwork.map((entry) =>
        `<span class="network-chip ${entry.ok ? 'is-ok' : 'is-fail'}" title="${entry.message || `${entry.products.length} resultados`}">${entry.network}: ${entry.ok ? entry.products.length : 'error'}</span>`
      ).join('');
    }

    function renderResults(products) {
      if (!unifiedResults) return;
      if (!products.length) {
        unifiedResults.innerHTML = '<div class="empty-dashboard">Sin resultados con estos filtros. Prueba a ampliar el rango de precio o quitar el filtro de stock.</div>';
        return;
      }
      unifiedResults.innerHTML = products.map((product) => `
        <article class="unified-card">
          <div class="unified-thumb">
            <img src="${product.image}" alt="" loading="lazy" />
          </div>
          <div class="unified-body">
            <div class="unified-top">
              <span class="network-mini-tag">${product.network}</span>
              ${product.estimated ? '<span class="estimated-tag">Estimado</span>' : ''}
              ${product.inStock ? '<span class="stock-tag">En stock</span>' : '<span class="stock-tag is-out">Sin stock</span>'}
            </div>
            <h4 class="unified-title">${product.title}</h4>
            <div class="unified-metrics">
              <span class="unified-price">${product.price.toFixed(2)} €</span>
              <span class="unified-commission">Comisión: ${product.commissionRate != null ? product.commissionRate + '%' : '—'}${product.commissionAmount != null ? ` (${product.commissionAmount.toFixed(2)} €)` : ''}</span>
              ${product.rating != null ? `<span class="unified-rating">★ ${product.rating}</span>` : ''}
            </div>
          </div>
          <button type="button" class="btn-success btn-sm unified-import" data-product='${JSON.stringify(product).replace(/'/g, '&#39;')}'>
            Importar a Tradylor
          </button>
        </article>
      `).join('');
    }

    async function runUnifiedSearch() {
      if (!btnUnifiedSearch || !unifiedQuery) return;
      const spinner = btnUnifiedSearch.querySelector('.btn-spinner');
      const text = btnUnifiedSearch.querySelector('.btn-text');
      btnUnifiedSearch.disabled = true;
      if (spinner) spinner.hidden = false;
      if (text) text.textContent = 'Buscando...';
      showSearchStatus('loading', 'Consultando redes...', 'Búsqueda paralela en curso en los catálogos conectados.');

      try {
        const res = await fetch('/api/admin/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: unifiedQuery.value.trim(),
            minPrice: document.getElementById('filterMinPrice')?.value || undefined,
            maxPrice: document.getElementById('filterMaxPrice')?.value || undefined,
            minCommission: document.getElementById('filterMinCommission')?.value || undefined,
            sortBy: document.getElementById('filterSort')?.value,
            inStockOnly: Boolean(document.getElementById('filterInStock')?.checked),
            limit: 24,
          }),
        });
        const data = await res.json();
        if (data.success) {
          renderResults(data.results || []);
          renderNetworkStatuses(data.byNetwork || []);
          showSearchStatus('success', 'Búsqueda completada', `${data.total} resultados en ${(data.byNetwork || []).filter((n) => n.ok).length} redes.`);
        } else {
          showSearchStatus('error', 'Error en la búsqueda', data.message || 'No se pudo completar la consulta.');
        }
      } catch {
        showSearchStatus('error', 'Error de red', 'Fallo al comunicar con el servidor.');
      } finally {
        btnUnifiedSearch.disabled = false;
        if (spinner) spinner.hidden = true;
        if (text) text.textContent = 'Buscar';
      }
    }

    btnUnifiedSearch?.addEventListener('click', runUnifiedSearch);
    unifiedQuery?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') runUnifiedSearch();
    });

    // Importación rápida al catálogo (el cloaking /out/[id] ya está activo en frontend)
    unifiedResults?.addEventListener('click', async (event) => {
      const btn = event.target.closest('.unified-import');
      if (!btn) return;
      const product = JSON.parse(btn.dataset.product);
      btn.disabled = true;
      btn.textContent = 'Importando...';
      try {
        const res = await fetch('/api/products/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save',
            product: {
              title: product.title,
              description: product.description,
              price: product.price,
              originalPrice: product.originalPrice,
              image: product.image,
              category: product.category,
              merchant: product.network,
              affiliateUrl: product.productUrl,
              rating: product.rating,
              reviewsCount: product.reviewsCount,
              badge: product.network,
              pros: [`Comisión estimada: ${product.commissionRate ?? 0}% en ${product.network}`],
              cons: [],
            },
          }),
        });
        const data = await res.json();
        if (data.success) {
          btn.textContent = 'Importado ✓';
          btn.classList.add('is-done');
          showSearchStatus('success', 'Producto importado', `"${data.product.title}" ya está en el catálogo con enlace enmascarado.`);
        } else {
          btn.disabled = false;
          btn.textContent = 'Importar a Tradylor';
          showSearchStatus('error', 'Error al importar', data.message || 'No se pudo guardar el producto.');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Importar a Tradylor';
        showSearchStatus('error', 'Error de red', 'Fallo al comunicar con el servidor.');
      }
    });

    if (networkList) loadNetworks();

    // =========================================================================
    // 6. TRÁFICO Y VENTAS: botón "Destacar" del motor de curación
    //    Carga la ficha en el editor de Añadir productos para asignar badge
    //    y publicar el producto destacado con un solo clic.
    // =========================================================================
    document.querySelectorAll('.btn-feature-row').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!id) return;
        try {
          const res = await fetch('/api/products/add');
          const data = await res.json();
          const product = (data.products || []).find((p) => p.id === id);
          if (product) {
            prodId.value = product.id || '';
            prodTitle.value = product.title || '';
            prodPrice.value = product.price !== undefined ? product.price : '';
            prodOriginalPrice.value = product.originalPrice !== undefined ? product.originalPrice : '';
            prodCategory.value = product.category || '';
            prodMerchant.value = product.merchant || '';
            prodAffiliateUrl.value = product.affiliateUrl || '';
            prodImage.value = product.image || '';
            prodBadge.value = product.badge || 'Elección del Editor';
            prodDescription.value = product.description || '';
            prodVerdict.value = product.verdict || '';
            prodPros.value = Array.isArray(product.pros) ? product.pros.join('\n') : '';
            prodCons.value = Array.isArray(product.cons) ? product.cons.join('\n') : '';
            window.location.href = '/admin?section=products';
            sessionStorage.setItem('tradylor-curate-load', JSON.stringify(product));
          }
        } catch (err) {
          console.error('Error al cargar producto para destacar:', err);
        }
      });
    });

    // Al entrar en Añadir productos, si venimos de "Destacar", precargar la ficha
    const curatePayload = sessionStorage.getItem('tradylor-curate-load');
    if (curatePayload && productForm && window.location.search.includes('section=products')) {
      try {
        const product = JSON.parse(curatePayload);
        prodId.value = product.id || '';
        prodTitle.value = product.title || '';
        prodPrice.value = product.price !== undefined ? product.price : '';
        prodOriginalPrice.value = product.originalPrice !== undefined ? product.originalPrice : '';
        prodCategory.value = product.category || '';
        prodMerchant.value = product.merchant || '';
        prodAffiliateUrl.value = product.affiliateUrl || '';
        prodImage.value = product.image || '';
        prodBadge.value = product.badge || 'Elección del Editor';
        prodDescription.value = product.description || '';
        prodVerdict.value = product.verdict || '';
        prodPros.value = Array.isArray(product.pros) ? product.pros.join('\n') : '';
        prodCons.value = Array.isArray(product.cons) ? product.cons.join('\n') : '';
        updatePreview();
        showAlert('success', 'Ficha precargada para destacar', 'Revisa el badge y pulsa "Guardar producto" para publicar el destacado.');
      } catch {}
      sessionStorage.removeItem('tradylor-curate-load');
    }
  });
</script>

<style>
  .admin-section-nav { position: relative; display: flex; align-items: center; gap: .5rem; padding: .65rem; background: rgba(17, 24, 39, .65); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); }
  .admin-nav-links { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; flex: 1; min-width: 0; }
  .admin-nav-toggle { display: none; align-items: center; gap: .45rem; padding: .6rem .8rem; color: var(--color-text-muted); background: transparent; border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-size: .82rem; font-weight: 700; }
  .admin-nav-toggle:hover { color: var(--color-text-main); border-color: rgba(96, 165, 250, .3); }
  .admin-nav-item { display: inline-flex; padding: .7rem .9rem; color: var(--color-text-muted); background: transparent; border: 1px solid transparent; border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-size: .82rem; font-weight: 700; text-decoration: none; }
  .admin-nav-item:hover, .admin-nav-item.is-active { color: var(--color-text-main); background: rgba(59, 130, 246, .13); border-color: rgba(96, 165, 250, .3); }

  /* Logout dentro del nav: más pequeño, siempre visible y alineado a la derecha */
  .admin-logout-form { margin: 0 0 0 auto; flex-shrink: 0; }
  .admin-logout-button { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; padding: .55rem .7rem; color: #fca5a5; background: rgba(239, 68, 68, .08); border: 1px solid rgba(239, 68, 68, .25); border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-size: .75rem; font-weight: 700; transition: all .2s ease; }
  .admin-logout-button:hover { color: #fecaca; background: rgba(239, 68, 68, .18); border-color: rgba(239, 68, 68, .45); }
  .admin-logout-button svg { flex-shrink: 0; }
  .admin-dashboard-view { flex-direction: column; gap: 1.5rem; }
  .view-heading { padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .view-heading .admin-title { margin: .75rem 0 .5rem; }
  .dashboard-toolbar { display: flex; gap: .75rem; flex-wrap: wrap; }
  .dashboard-toolbar input { flex: 1; min-width: 220px; }
  .dashboard-toolbar select { width: 190px; }
  .integration-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
  .integration-card { padding: 1.25rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); box-shadow: var(--shadow-card); }
  .integration-card-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .85rem; }
  .integration-card h3 { color: var(--color-text-main); font-family: var(--font-heading); font-size: 1rem; }
  .integration-card p { min-height: 2.8rem; margin: .5rem 0 1rem; color: var(--color-text-muted); font-size: .8rem; line-height: 1.5; }
  .integration-status { padding: .2rem .5rem; color: #fbbf24; background: rgba(245, 158, 11, .1); border: 1px solid rgba(245, 158, 11, .25); border-radius: 999px; font-size: .68rem; font-weight: 800; text-transform: uppercase; }
  .integration-status.is-configured { color: #6ee7b7; background: rgba(16, 185, 129, .1); border-color: rgba(16, 185, 129, .25); }
  .integration-code { color: var(--color-text-dim); font-size: .68rem; }
  .integration-fields { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: 1rem; }
  .integration-fields span, .filter-chip-row span, .category-manager-pill { padding: .25rem .45rem; color: var(--color-text-dim); background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: 4px; font-size: .66rem; }
  .category-manager-pill { display: inline-flex; align-items: center; gap: .35rem; }
  .category-manager-pill button { padding: 0; color: var(--color-text-dim); background: transparent; border: 0; cursor: pointer; font: inherit; font-size: .9rem; line-height: 1; }
  .category-manager-pill button:hover { color: #f87171; }
  .integration-action { width: 100%; padding: .65rem; color: var(--color-text-dim); background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); cursor: not-allowed; font: inherit; font-size: .78rem; font-weight: 700; }
  .affiliate-import-card, .category-manager, .analytics-note { margin-top: .25rem; }
  .filter-chip-row, .category-list-view { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .filter-chip-row span { color: #93c5fd; border-color: rgba(96, 165, 250, .25); }
  .category-form { display: flex; gap: .75rem; }
  .category-form input { flex: 1; }
  .dashboard-metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .dashboard-metric { padding: 1.25rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); }
  .dashboard-metric span, .dashboard-metric small { display: block; color: var(--color-text-muted); font-size: .78rem; }
  .dashboard-metric strong { display: block; margin: .3rem 0; color: var(--color-text-main); font-family: var(--font-heading); font-size: 2rem; }
  .loading-panel, .empty-dashboard { padding: 2rem; color: var(--color-text-muted); background: rgba(255, 255, 255, .025); border: 1px dashed var(--color-border); border-radius: var(--border-radius-md); text-align: center; }

  /* ============ MÓDULO AFILIADOS Y MULTI-CATÁLOGO ============ */
  .affiliates-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 2rem; align-items: start; }
  @media (max-width: 1100px) { .affiliates-layout { grid-template-columns: 1fr; } }

  .network-list { display: flex; flex-direction: column; gap: .65rem; }
  .network-item { border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); background: rgba(255, 255, 255, .02); overflow: hidden; }
  .network-item summary { display: flex; align-items: center; gap: .75rem; padding: .8rem 1rem; cursor: pointer; list-style: none; user-select: none; }
  .network-item summary::-webkit-details-marker { display: none; }
  .network-item summary:hover { background: rgba(255, 255, 255, .04); }
  .network-color { width: 12px; height: 12px; border-radius: 4px; flex-shrink: 0; box-shadow: 0 0 8px currentColor; }
  .network-main { display: flex; flex-direction: column; gap: .1rem; min-width: 0; flex: 1; }
  .network-name { color: var(--color-text-main); font-size: .85rem; font-weight: 700; }
  .network-region { color: var(--color-text-dim); font-size: .7rem; }
  .network-body { padding: 0 1rem 1rem; border-top: 1px solid var(--color-border); }
  .network-desc { color: var(--color-text-muted); font-size: .78rem; line-height: 1.5; margin: .85rem 0; }
  .network-cred-form { display: flex; flex-direction: column; gap: .65rem; }
  .cred-field { display: grid; gap: .3rem; color: var(--color-text-muted); font-size: .72rem; font-weight: 700; }
  .cred-field input { width: 100%; box-sizing: border-box; padding: .55rem .75rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; font-size: .8rem; outline: none; }
  .cred-field input:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, .12); }
  .network-actions { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-top: .35rem; }
  .network-doc { margin-left: auto; color: #60a5fa; font-size: .72rem; text-decoration: none; }
  .network-doc:hover { text-decoration: underline; }
  .network-feedback { margin: .5rem 0 0; color: var(--color-text-muted); font-size: .74rem; line-height: 1.4; }
  .integration-status.is-error { color: #fca5a5; background: rgba(239, 68, 68, .1); border-color: rgba(239, 68, 68, .3); }

  .search-controls { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.25rem; }
  .search-input-group { display: flex; gap: .6rem; }
  .search-input-group input { flex: 1; min-width: 0; padding: .75rem 1rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; font-size: .88rem; outline: none; }
  .search-input-group input:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, .12); }
  .search-filters { display: flex; align-items: flex-end; gap: .75rem; flex-wrap: wrap; }
  .filter-field { display: grid; gap: .3rem; flex: 1; min-width: 110px; }
  .filter-field label { color: var(--color-text-dim); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .filter-field input, .filter-field select { width: 100%; box-sizing: border-box; padding: .55rem .7rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; font-size: .8rem; outline: none; }
  .filter-field input:focus, .filter-field select:focus { border-color: #38bdf8; }
  .filter-check { display: inline-flex; align-items: center; gap: .45rem; color: var(--color-text-muted); font-size: .8rem; font-weight: 600; padding-bottom: .55rem; cursor: pointer; }

  .network-status-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; }
  .network-chip { padding: .25rem .6rem; border-radius: 999px; font-size: .68rem; font-weight: 700; border: 1px solid var(--color-border); color: var(--color-text-muted); background: rgba(255, 255, 255, .03); }
  .network-chip.is-ok { color: #6ee7b7; border-color: rgba(16, 185, 129, .3); background: rgba(16, 185, 129, .08); }
  .network-chip.is-fail { color: #fca5a5; border-color: rgba(239, 68, 68, .3); background: rgba(239, 68, 68, .08); }

  .unified-results { display: flex; flex-direction: column; gap: .75rem; max-height: 640px; overflow-y: auto; }
  .unified-card { display: flex; align-items: center; gap: 1rem; padding: .85rem 1rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); }
  .unified-thumb { width: 64px; height: 64px; border-radius: 8px; background: #fff; padding: 4px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .unified-thumb img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .unified-body { flex: 1; min-width: 0; }
  .unified-top { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; margin-bottom: .3rem; }
  .network-mini-tag { padding: .12rem .45rem; border-radius: 4px; background: rgba(59, 130, 246, .12); border: 1px solid rgba(59, 130, 246, .3); color: #93c5fd; font-size: .64rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  .estimated-tag { padding: .12rem .45rem; border-radius: 4px; background: rgba(245, 158, 11, .1); border: 1px solid rgba(245, 158, 11, .3); color: #fbbf24; font-size: .64rem; font-weight: 800; text-transform: uppercase; }
  .stock-tag { padding: .12rem .45rem; border-radius: 4px; background: rgba(16, 185, 129, .1); border: 1px solid rgba(16, 185, 129, .3); color: #6ee7b7; font-size: .64rem; font-weight: 800; }
  .stock-tag.is-out { background: rgba(239, 68, 68, .1); border-color: rgba(239, 68, 68, .3); color: #fca5a5; }
  .unified-title { margin: 0 0 .35rem; color: var(--color-text-main); font-size: .85rem; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .unified-metrics { display: flex; align-items: baseline; gap: .9rem; flex-wrap: wrap; font-size: .75rem; color: var(--color-text-muted); }
  .unified-price { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 800; color: #fff; }
  .unified-commission { color: #6ee7b7; font-weight: 600; }
  .unified-rating { color: #fbbf24; font-weight: 600; }
  .unified-import { flex-shrink: 0; white-space: nowrap; }
  .unified-import.is-done { background: rgba(16, 185, 129, .2); border-color: rgba(16, 185, 129, .4); pointer-events: none; }
  .btn-sm { padding: .5rem .8rem; font-size: .76rem; }
  .btn-danger-ghost { display: inline-flex; align-items: center; gap: .35rem; padding: .5rem .8rem; color: #fca5a5; background: transparent; border: 1px solid rgba(239, 68, 68, .3); border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-size: .76rem; font-weight: 700; transition: all .2s ease; }
  .btn-danger-ghost:hover { background: rgba(239, 68, 68, .12); }

  /* ============ TRÁFICO Y VENTAS: EMBUDO + CURACIÓN ============ */
  .funnel-row { display: flex; flex-direction: column; gap: .85rem; margin-top: 1.5rem; }
  .funnel-step { display: grid; grid-template-columns: 200px 1fr 52px; align-items: center; gap: 1rem; }
  .funnel-label { color: var(--color-text-muted); font-size: .78rem; font-weight: 600; }
  .funnel-bar { height: 10px; background: rgba(255, 255, 255, .05); border-radius: 999px; overflow: hidden; }
  .funnel-fill { height: 100%; background: linear-gradient(90deg, #3b82f6, #10b981); border-radius: 999px; transition: width .6s ease; }
  .funnel-value { color: var(--color-text-main); font-family: var(--font-heading); font-weight: 800; font-size: .9rem; text-align: right; }

  .curation-table-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--border-radius-md); }
  .curation-table { width: 100%; border-collapse: collapse; min-width: 980px; }
  .curation-table thead th { padding: .8rem .75rem; color: var(--color-text-dim); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; text-align: center; border-bottom: 1px solid var(--color-border); background: rgba(255, 255, 255, .02); white-space: nowrap; }
  .curation-table thead th:nth-child(2) { text-align: left; }
  .curation-table tbody td { padding: .75rem; border-bottom: 1px solid rgba(255, 255, 255, .04); font-size: .8rem; color: var(--color-text-muted); vertical-align: middle; text-align: center; }
  .curation-table tbody td > span, .curation-table tbody td > div.opp-score, .curation-table tbody td > div.opp-breakdown { display: inline-flex; justify-content: center; margin-left: auto; margin-right: auto; }
  .curation-table tbody td.curation-product { text-align: left; }
  .curation-row:hover { background: rgba(59, 130, 246, .04); }

  .opp-score { position: relative; width: 46px; height: 46px; }
  .opp-ring { width: 46px; height: 46px; }
  .opp-number { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--color-text-main); font-family: var(--font-heading); font-size: .8rem; font-weight: 800; }

  .curation-product { display: flex; align-items: center; gap: .7rem; min-width: 240px; }
  .curation-thumb { width: 44px; height: 44px; border-radius: 8px; background: #fff; padding: 3px; object-fit: contain; flex-shrink: 0; }
  .curation-name { color: var(--color-text-main); font-size: .8rem; font-weight: 600; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 300px; }
  .opp-tier { display: inline-block; margin-top: .25rem; padding: .12rem .45rem; border-radius: 4px; font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
  .tier-top { color: #6ee7b7; background: rgba(16, 185, 129, .12); border: 1px solid rgba(16, 185, 129, .3); }
  .tier-alta { color: #7dd3fc; background: rgba(56, 189, 248, .12); border: 1px solid rgba(56, 189, 248, .3); }
  .tier-media { color: #fcd34d; background: rgba(245, 158, 11, .12); border: 1px solid rgba(245, 158, 11, .3); }
  .tier-baja { color: #9ca3af; background: rgba(107, 114, 128, .12); border: 1px solid rgba(107, 114, 128, .3); }

  .curation-price { color: #fff; font-weight: 700; white-space: nowrap; }
  .curation-commission { color: #6ee7b7; font-weight: 700; white-space: nowrap; }
  .curation-commission small { display: block; color: var(--color-text-dim); font-weight: 500; }
  .curation-rating { color: #fbbf24; font-weight: 700; white-space: nowrap; }

  .opp-breakdown { display: flex; gap: .3rem; flex-wrap: wrap; }
  .opp-breakdown span { padding: .14rem .4rem; background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: 4px; font-size: .64rem; color: var(--color-text-dim); cursor: help; }

  .curation-note { margin-top: 1rem; color: var(--color-text-dim); font-size: .76rem; line-height: 1.5; }
  .curation-note code { color: #7dd3fc; background: rgba(56, 189, 248, .1); padding: .1rem .35rem; border-radius: 4px; }
  .text-right { text-align: right; }

  /* Botón Destacar de la tabla de curación: ghost compacto integrado en la fila */
  .btn-feature-row { display: inline-flex; align-items: center; gap: .3rem; padding: .3rem .55rem; color: #93c5fd; background: transparent; border: 1px solid rgba(96, 165, 250, .25); border-radius: 6px; cursor: pointer; font: inherit; font-size: .66rem; font-weight: 700; letter-spacing: .02em; transition: all .2s ease; white-space: nowrap; }
  .btn-feature-row svg { flex-shrink: 0; transition: transform .2s ease; }
  .btn-feature-row:hover { color: #dbeafe; background: rgba(59, 130, 246, .12); border-color: rgba(96, 165, 250, .5); }
  .btn-feature-row:hover svg { transform: scale(1.15); fill: currentColor; }

  /* Visibilidad de secciones: el display base lo marca .is-visible únicamente, así las secciones ocultas nunca aparecen (el scoping de Astro sube la especificidad de las clases base con atributos) */
  .admin-grid-section,
  .admin-dashboard-view,
  .products-list-card { display: none; }
  .admin-grid-section.is-visible { display: grid; }
  .admin-dashboard-view.is-visible { display: flex; }
  .products-list-card.is-visible { display: flex; }

  @media (max-width: 900px) {
    .admin-nav-toggle { display: inline-flex; }
    .admin-nav-links { display: none; position: absolute; top: calc(100% + .5rem); left: 0; right: 0; flex-direction: column; align-items: stretch; padding: .65rem; background: rgba(13, 19, 33, .97); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); box-shadow: 0 18px 40px rgba(0, 0, 0, .45); z-index: 60; }
    .admin-nav-links.is-open { display: flex; }
    .admin-nav-item { white-space: normal; width: 100%; }
    /* En el menú responsive el logout se queda solo en icono, fijo en la barra a la derecha */
    .admin-logout-button { padding: .55rem; }
    .admin-logout-button .logout-label { display: none; }
    .category-form { flex-direction: column; }
    .dashboard-metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .admin-login-page { min-height: calc(100vh - 9rem); max-width: var(--max-width); margin: 0 auto; padding: 4rem 1.25rem 5rem; display: grid; grid-template-columns: minmax(0, 500px) minmax(240px, 1fr); align-items: center; gap: clamp(3rem, 10vw, 9rem); }
  .admin-login-panel { padding: clamp(2rem, 5vw, 3.5rem); background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); box-shadow: 0 24px 70px rgba(0, 0, 0, .24); }
  .admin-login-mark { display: inline-flex; align-items: center; gap: .6rem; color: #60a5fa; font-size: .72rem; font-weight: 800; letter-spacing: .12em; }
  .admin-login-kicker { margin: 3.5rem 0 .75rem; color: var(--color-text-dim); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .admin-login-title { color: var(--color-text-main); font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.05; margin: 0; }
  .admin-login-description { max-width: 390px; margin: 1.25rem 0 2.25rem; color: var(--color-text-muted); line-height: 1.65; }
  .admin-login-form { display: grid; gap: 1.15rem; }
  .login-field { display: grid; gap: .5rem; color: var(--color-text-main); font-size: .8rem; font-weight: 700; }
  .login-field input { width: 100%; box-sizing: border-box; padding: .9rem 1rem; color: var(--color-text-main); background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font: inherit; outline: none; }
  .login-field input:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, .14); }
  .admin-login-submit { display: inline-flex; align-items: center; justify-content: center; gap: .7rem; width: 100%; margin-top: .65rem; padding: .95rem 1.25rem; color: #07111f; background: #38bdf8; border: 0; border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-weight: 800; }
  .admin-login-submit:hover { background: #7dd3fc; }
  .admin-login-error { margin: 0 0 1.25rem; padding: .8rem 1rem; color: #fecaca; background: rgba(239, 68, 68, .1); border: 1px solid rgba(239, 68, 68, .3); border-radius: var(--border-radius-sm); font-size: .85rem; }
  .admin-login-footer { display: flex; align-items: center; gap: .5rem; margin: 2rem 0 0; color: var(--color-text-dim); font-size: .75rem; }
  .admin-login-aside { display: flex; flex-direction: column; gap: 1.5rem; color: var(--color-text-main); }
  .aside-index { color: var(--color-text-dim); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .admin-login-aside strong { font-family: var(--font-heading); font-size: clamp(3rem, 7vw, 6.5rem); line-height: .92; letter-spacing: -.04em; }
  .aside-line { width: min(100%, 280px); height: 1px; background: linear-gradient(90deg, #38bdf8, transparent); }
  @media (max-width: 760px) { .admin-login-page { min-height: auto; padding-top: 2rem; grid-template-columns: 1fr; gap: 2.5rem; } .admin-login-aside { display: none; } }

  /* ==========================================================================
     ADMIN PANEL - ESTILOS PREMIUM (SISTEMA DE DISEÑO TRADYLOR)
     ========================================================================== */
  .admin-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* 1. Header del Admin */
  .admin-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .admin-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #60a5fa;
    width: fit-content;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .admin-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: var(--color-text-main);
    line-height: 1.2;
    margin-top: 0.5rem;
  }

  .admin-subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.5rem;
  }

  /* 2. Grid Principal (Formulario + Preview)
     Sin display base: la visibilidad la controlan las reglas .is-visible (más arriba) */
  .admin-grid-section {
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .admin-grid-section {
      grid-template-columns: 1fr;
    }
  }

  .admin-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-card);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .header-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-cyan {
    background: rgba(6, 182, 212, 0.15);
    color: #22d3ee;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .card-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  /* Caja de Scraping */
  .scrape-box {
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .scrape-input-group {
    display: flex;
    gap: 0.5rem;
    position: relative;
    margin-top: 0.5rem;
  }

  .input-icon-wrapper {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-dim);
    pointer-events: none;
  }

  .scrape-input-group input {
    flex: 1;
    padding-left: 2.75rem;
  }

  /* Inputs Generales */
  input[type="text"],
  input[type="url"],
  input[type="number"],
  input[type="search"],
  select,
  textarea {
    width: 100%;
    background: #0d121f;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.75rem 1rem;
