---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import AdminNav from '../components/AdminNav.astro';
import AdminUserMenu from '../components/AdminUserMenu.astro';
import TrafficSalesDashboard from '../components/admin/TrafficSalesDashboard.astro';
import fs from 'node:fs';
import { dataFile } from '../lib/paths';
import type { Product } from './api/products/add';
import { authenticateUser, clearAdminSession, createAdminSession, getSessionUser } from '../lib/adminAuth';
import { getAmazonAssociateTag } from '../utils/amazon';

const sessionUser = getSessionUser(Astro.request);
const isAuthenticated = sessionUser !== null;
let loginError = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = String(formData.get('action') ?? 'login');

  if (action === 'logout' && isAuthenticated) {
    return new Response(null, {
      status: 303,
      headers: { Location: '/admin', 'Set-Cookie': clearAdminSession() },
    });
  }

  const login = !isAuthenticated
    ? authenticateUser(String(formData.get('username') ?? '').trim(), String(formData.get('password') ?? ''))
    : null;

  if (login) {
    // Los usuarios sin rol admin sólo acceden a su perfil
    return new Response(null, {
      status: 303,
      headers: { Location: login.role === 'admin' ? '/admin' : '/admin/perfil', 'Set-Cookie': createAdminSession(login) },
    });
  }

  if (!isAuthenticated) loginError = 'El usuario o la contraseña no son correctos.';
}

// Un usuario sin rol admin no puede ver el catálogo: va a su perfil
if (sessionUser && sessionUser.role !== 'admin') {
  return new Response(null, { status: 303, headers: { Location: '/admin/perfil' } });
}

// El panel nunca se cachea: un deploy nuevo tiene que verse a la primera.
Astro.response.headers.set('Cache-Control', 'no-store');

// Leer productos almacenados para renderizar inicialmente en el servidor (SSR)
const DATA_FILE_PATH = dataFile('products.json');
let initialProducts: Product[] = [];

try {
  if (fs.existsSync(DATA_FILE_PATH)) {
    const raw = fs.readFileSync(DATA_FILE_PATH, 'utf-8');
    initialProducts = JSON.parse(raw);
  }
} catch (error) {
  console.error('Error cargando products.json en admin:', error);
}

const pageTitle = "Panel de Administración | Tradylor";
const pageDescription = "Gestión, scraping de metadatos y alta de productos con enlaces de afiliación en Tradylor.";

// El módulo "Tráfico y ventas" se muestra como una sección más del panel
const requestedSection = Astro.url.searchParams.get('section') || 'products';

const allowedSections = ['products', 'affiliates', 'categories', 'analytics', 'marketing'];
const initialSection = allowedSections.includes(requestedSection) ? requestedSection : 'products';
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="header-end">
    {isAuthenticated && sessionUser && <AdminUserMenu user={sessionUser} active={initialSection} />}
  </Fragment>
  {isAuthenticated && sessionUser ? (
  <div class="admin-wrapper">
    <!-- 1. HEADER DEL PANEL -->
    <header class="admin-header">
      <div class="admin-header-main">
        <div class="admin-tag-pill">Panel de control</div>
        <h1 class="admin-title">Panel de Administración de Productos</h1>
        <p class="admin-subtitle">
          Pega el enlace de cualquier comercio para autocompletar metadatos OpenGraph (título, imagen, precio). Edita y afina la ficha antes de guardarla de forma persistente.
        </p>
      </div>
    </header>

    <AdminNav context="catalogo" active={initialSection} user={sessionUser} />

    <!-- 2. SECCIÓN PRINCIPAL: FORMULARIO + LIVE PREVIEW -->
    <section data-admin-view="products" class:list={['admin-grid-section', 'hidden-section', { 'is-visible': initialSection === 'products' }]}>
      <!-- Columna 1: Formulario de Scraping y Edición -->
      <div class="admin-card form-card">
        <div class="card-header">
          <div class="header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div>
            <h2 class="card-title">1. Extracción & Alta de Producto</h2>
            <p class="card-desc">Introduce la URL del producto para extraer metadatos automáticamente o rellenar de forma manual.</p>
          </div>
        </div>

        <!-- Barra de Scraping Rápido -->
        <div class="scrape-box">
          <label for="inputScrapeUrl" class="field-label">
            <span>URL del Producto (Amazon, PcComponentes, etc.)</span>
            <span class="label-hint">Detección automática de OpenGraph</span>
          </label>
          <div class="scrape-input-group">
            <div class="input-icon-wrapper">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </div>
            <input
              type="url"
              id="inputScrapeUrl"
              placeholder="Pega aquí la URL del producto"
              autocomplete="off"
            />
            <button type="button" id="btnScrape" class="btn-primary">
              <span class="btn-text">Analizar Enlace</span>
              <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <div class="btn-spinner" hidden></div>
            </button>
          </div>

          <!-- Mensaje de Feedback de Estado -->
          <div id="scrapeStatusAlert" class="status-alert" hidden>
            <div class="alert-icon" id="statusAlertIcon">ℹ️</div>
            <div class="alert-content">
              <strong id="statusAlertTitle">Estado</strong>
              <p id="statusAlertText">Mensaje...</p>
            </div>
          </div>
        </div>

        <!-- Formulario Editable del Producto -->
        <form id="productForm" class="product-edit-form">
          <input type="hidden" id="prodId" value="" />

          <!-- Zona de datos básicos + vista previa en 2 columnas -->
          <div class="form-basic-grid">
            <div class="form-basic-col">

<div class="form-row">
            <div class="form-group full-width">
              <label for="prodTitle" class="field-label">Título del Producto <span class="required">*</span></label>
              <input type="text" id="prodTitle" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodAffiliateUrl" class="field-label">Enlace de Afiliado Final <span class="required">*</span></label>
              <input type="url" id="prodAffiliateUrl" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodBuyNowUrl" class="field-label">
                <span>Enlace de Compra Directa (Buy Now)</span>
                <span class="label-hint">Opcional: URL de pago inmediato (p. ej. checkout de Amazon). Tiene prioridad sobre el enlace de afiliado en «Comprar ya».</span>
              </label>
              <input type="url" id="prodBuyNowUrl" placeholder="https://www.amazon.es/checkout/... o https://www.amazon.es/dp/ASIN" />
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodImage" class="field-label">
                <span>Imagen del Producto</span>
                <span class="label-hint">URL o ruta local (opcional si la galería ya tiene imagen; la IA puede generarla)</span>
              </label>
              <input type="text" id="prodImage" placeholder="https://... o /images/products/..." />
            </div>

            <div class="form-group">
              <label for="prodBadge" class="field-label">Etiqueta Destacada (Badge)</label>
              <select id="prodBadge">
                <option value="">(ninguna)</option>
                <optgroup label="Atractivo de precio / Oferta">
                  <option value="Oferta -20%">Oferta -20%</option>
                  <option value="Chollo">Chollo</option>
                  <option value="Mínimo Histórico">Mínimo Histórico</option>
                </optgroup>
                <optgroup label="Prueba social / Popularidad">
                  <option value="Más Vendido">Más Vendido</option>
                  <option value="Recomendado">Recomendado</option>
                  <option value="Top Elección">Top Elección</option>
                </optgroup>
                <optgroup label="Novedad o Disponibilidad">
                  <option value="Nuevo">Nuevo</option>
                  <option value="Edición Limitada">Edición Limitada</option>
                  <option value="Últimas Unidades">Últimas Unidades</option>
                </optgroup>
                <optgroup label="Criterios técnicos o de valor">
                  <option value="Mejor Calidad/Precio">Mejor Calidad/Precio</option>
                  <option value="Calidad Premium">Calidad Premium</option>
                  <option value="Sostenible">Sostenible</option>
                </optgroup>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label class="field-label">
                <span>Galería de Imágenes y Vídeos</span>
                <span class="label-hint">Pulsa una miniatura para fijarla como principal · Los vídeos se reproducen en la ficha</span>
              </label>
              <div id="galleryThumbs" class="gallery-thumbs"></div>
              <div class="gallery-add-row">
                <input type="file" id="galleryFileInput" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm" multiple />
                <div class="gallery-url-add">
                  <input type="text" id="galleryUrlInput" placeholder="Añade una imagen O un vídeo por URL (YouTube, Vimeo, mp4...)" />
                  <button type="button" id="btnAddImageUrl" class="btn-secondary">Añadir URL</button>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodDescription" class="field-label">Descripción Técnica Concisa</label>
              <textarea id="prodDescription" rows="3"></textarea>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodVerdict" class="field-label">Veredicto Editorial de Tradylor</label>
              <textarea id="prodVerdict" rows="2"></textarea>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group full-width">
              <label for="prodTechSheet" class="field-label">
                <span>Ficha Técnica</span>
                <span class="label-hint">Se muestra en la página del producto (botón «Ver ficha técnica») · La IA puede generarlo</span>
              </label>
              <textarea
                id="prodTechSheet"
                rows="5"
                placeholder="Datos técnicos objetivos: materiales, medidas, peso, conectividad, compatibilidades, garantía, contenido de la caja..."
              ></textarea>
            </div>
          </div>

          <div class="form-row two-cols">
            <div class="form-group">
              <label for="prodPros" class="field-label">Puntos Fuertes (Pros) <span class="label-hint">(Uno por línea)</span></label>
              <textarea id="prodPros" rows="3"></textarea>
            </div>
            <div class="form-group">
              <label for="prodCons" class="field-label">Puntos a Considerar (Contras) <span class="label-hint">(Uno por línea)</span></label>
              <textarea id="prodCons" rows="3"></textarea>
            </div>
          </div>

          <!-- Botones de Acción -->
          <div class="form-actions">
            <button type="button" id="btnAiEnrich" class="btn-ai">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z" />
                <path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z" />
              </svg>
              <span>Enriquecer con IA (título + ficha + imagen)</span>
            </button>
            <button type="submit" id="btnSaveProduct" class="btn-success">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
              </svg>
              <span>Guardar producto</span>
            </button>
            <button type="button" id="btnResetForm" class="btn-secondary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
              <span>Limpiar Campos</span>
            </button>
          </div>
        </form>
      </div>
    </section>>

    <!-- 3. LISTADO RÁPIDO DE PRODUCTOS EXISTENTES -->
    <section id="catalogProducts" data-admin-view="products" class:list={['admin-card', 'products-list-card', 'hidden-section', { 'is-visible': initialSection === 'products' }]}>
      <div class="list-header-row">
        <div>
          <h2 class="card-title">3. Catálogo de Productos Registrados</h2>
          <p class="card-desc">Consulta los productos activos en <code>src/data/products.json</code>, pruébalos o elimínalos.</p>
        </div>
        <div class="list-search-wrapper">
          <input type="search" id="inputFilterList" placeholder="Filtrar por título o comercio..." />
        </div>
      </div>

      <div class="products-table-responsive">
        <table class="products-table" id="productsTable">
          <thead>
            <tr>
              <th>Imagen</th>
              <th>Producto & Categoría</th>
              <th>Comercio</th>
              <th>Precio</th>
              <th>Enlace Afiliado</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="productsTableBody">
            {initialProducts.length === 0 ? (
              <tr class="empty-row">
                <td colspan="6">No hay productos registrados en el catálogo aún.</td>
              </tr>
            ) : (
              initialProducts.map((p) => (
                <tr data-product-id={p.id} class="product-row">
                  <td class="col-thumb">
                    <img src={p.image} alt={p.title} class="thumb-img" loading="lazy" />
                  </td>
                  <td class="col-details">
                    <a href={`/producto/${p.slug ?? p.id}`} class="row-title" target="_blank" rel="noopener" title="Ver ficha pública del producto">{p.title}</a>
                    <div class="row-meta">
                      <span class="pill-category">{p.category}</span>
                      {p.badge && <span class="pill-badge">{p.badge}</span>}
                    </div>
                  </td>
                  <td class="col-merchant">
                    <span class="merchant-badge">{p.merchant}</span>
                  </td>
                  <td class="col-price">
                    <span class="price-val">{p.price.toFixed(2)} €</span>
                    {p.originalPrice && <span class="price-old">{p.originalPrice.toFixed(2)} €</span>}
                  </td>
                  <td class="col-link">
                    <a
                      href={p.affiliateUrl}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="test-link"
                      title="Probar enlace de afiliado"
                    >
                      Probar Enlace
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  </td>
                  <td class="col-actions text-right">
                    <button
                      type="button"
                      class="btn-icon-action btn-edit-row"
                      data-id={p.id}
                      title="Cargar y editar en formulario"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="btn-icon-action btn-delete-row"
                      data-id={p.id}
                      title="Eliminar producto"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>

    <section data-admin-view="affiliates" class:list={['admin-dashboard-view', 'hidden-section', { 'is-visible': initialSection === 'affiliates' }]}>
      <div class="view-heading">
        <span class="admin-tag-pill">Integraciones de monetización</span>
        <h2 class="admin-title">Afiliados y Multi-Catálogo</h2>
        <p class="admin-subtitle">Conecta redes de afiliación con sus credenciales y valida la conexión. El catálogo de AliExpress se sincroniza contra la API y se filtra con barras de rango calculadas sobre los datos reales (precio, descuento, comisión, ventas, valoración y envío).</p>
      </div>

      <div class="affiliates-layout">
        <!-- Columna 1: Gestor de credenciales multi-red -->
        <div id="networksCard">
          <div class="card-header">
            <div class="header-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <div>
              <h2 class="card-title">1. Redes conectadas</h2>
              <p class="card-desc">Guarda las credenciales de cada red y valida la conexión. Los valores secretos nunca se devuelven al navegador.</p>
            </div>
          </div>
          <div id="networkList" class="network-list">
            <div class="loading-panel">Cargando redes...</div>
          </div>
          <div id="removedNetworks" class="removed-networks"></div>
        </div>

      </div>

      <!-- 3. Catálogo AliExpress desde la caché del volumen (sin llamadas API en cada carga) -->
      <div id="aliCatalogCard">
        <div class="card-header">
          <div class="header-icon icon-cyan">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3v18h18"></path>
              <path d="M7 14l4-4 4 4 5-6"></path>
            </svg>
          </div>
          <div>
              <h2 class="card-title">2. Catálogo AliExpress (caché)</h2>
            <p class="card-desc">Tabla amplia del último catálogo sincronizado, guardado en el servidor. Usa «Sincronizar» para refrescarlo contra la API; se avisa si la caché supera las 6 horas.</p>
          </div>
          <div class="ali-catalog-head-actions">
            <span id="aliCatalogMeta" class="ali-catalog-meta">Cargando…</span>
            <button type="button" id="btnAliSync" class="btn-primary btn-sm">
              <span class="btn-text">Sincronizar</span>
              <div class="btn-spinner" hidden></div>
            </button>
          </div>
        </div>

        <div id="aliCatalogStatus" class="status-alert" hidden>
          <div class="alert-icon" id="aliCatalogStatusIcon">ℹ️</div>
          <div class="alert-content">
            <strong id="aliCatalogStatusTitle">Estado</strong>
            <p id="aliCatalogStatusText">Mensaje...</p>
          </div>
        </div>

        <!-- Filtros y ordenación del catálogo (aplican antes de paginar) -->
        <div id="aliFilters" class="ali-filters" hidden>
          <div class="ali-filters-row">
            <div class="filter-field ali-f-search">
              <label for="aliFQ">Buscar</label>
              <input type="search" id="aliFQ" placeholder="Título, tienda o categoría..." />
            </div>
            <div class="filter-field">
              <label for="aliFCat">Categoría</label>
              <select id="aliFCat"><option value="">Todas</option></select>
            </div>
            <div class="filter-field">
              <label for="aliFShop">Tienda</label>
              <select id="aliFShop"><option value="">Todas</option></select>
            </div>
            <div class="filter-field ali-sort-field">
              <label for="aliFSort">Ordenar por</label>
              <div class="ali-sort-group">
                <select id="aliFSort">
                  <option value="ventas" selected>Más ventas</option>
                  <option value="visitas">Visitas</option>
                  <option value="comision_eur">Mayor comisión €</option>
                  <option value="comision_pct">Mayor comisión %</option>
                  <option value="valoracion">Mejor valoración</option>
                  <option value="descuento">Mayor descuento</option>
                  <option value="precio">Precio</option>
                  <option value="nombre">Nombre</option>
                </select>
                <button type="button" id="aliFSortDir" class="btn-secondary btn-sm ali-sort-dir" title="Invertir el orden (mayor a menor / menor a mayor)">↓</button>
              </div>
            </div>
            <button type="button" id="aliFReset" class="btn-secondary btn-sm ali-f-reset">Limpiar filtros</button>
            <button type="button" id="btnAliMore" class="btn-secondary btn-sm" title="Descarga más páginas del catálogo de AliExpress sin borrar los productos ya guardados">+ Cargar más productos</button>
          </div>
          <!-- Barras de rango duales generadas con los datos reales del catálogo -->
          <div id="aliRangeFields" class="ali-range-fields"></div>
        </div>

        <!-- Selección masiva: la casilla de la cabecera marca la página actual;
             estos botones seleccionan todo lo filtrado o limpian. -->
        <div id="aliSelectionBar" class="ali-selection" hidden>
          <span id="aliSelCount" class="ali-sel-count">0 seleccionados</span>
          <button type="button" id="aliSelAllFiltered" class="btn-secondary btn-sm">Seleccionar todos los filtrados</button>
          <button type="button" id="aliSelClear" class="btn-secondary btn-sm">Limpiar selección</button>
          <button type="button" id="aliSelImport" class="btn-success btn-sm">Importar seleccionados</button>
        </div>

        <div id="aliCatalogHost">
          <div class="loading-panel">Cargando catálogo de AliExpress...</div>
        </div>
      </div>
    </section>

    <section data-admin-view="categories" class:list={['admin-dashboard-view', 'hidden-section', { 'is-visible': initialSection === 'categories' }]}>
      <div class="view-heading">
        <span class="admin-tag-pill">Organización del catálogo</span>
        <h2 class="admin-title">Categorías</h2>
        <p class="admin-subtitle">Crea y mantiene las categorías disponibles para clasificar productos importados y añadidos manualmente. Se aplican al instante en el formulario de productos y en el importador de Afiliados.</p>
      </div>

      <!-- 1. Formulario de alta / edición de categorías -->
      <div class="admin-card">
        <div class="card-header">
          <div class="header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </div>
          <div>
            <h2 class="card-title" id="categoryFormTitle">1. Crear nueva categoría</h2>
            <p class="card-desc">El nombre define la etiqueta visible. Las palabras clave permiten autoasociar productos importados por su título y descripción.</p>
