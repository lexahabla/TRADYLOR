---
/**
 * HeroSearchRadar — panel híbrido gamificado del hero (bajo el catálogo).
 *
 * 2 pestañas:
 *   1. 🔥 Ofertas → carrusel horizontal de UNA sola fila con las mejores
 *                   ofertas del catálogo (ProductCard renderizadas en servidor
 *                   con layout "compact": la disposición de móvil, para que el
 *                   carrusel ocupe mucho menos alto en escritorio).
 *   2. 🎯 Asistente → quiz de perfilador (MethodologyQuiz compacto); sólo
 *                   para usuarios registrados (sin sesión el click abre el
 *                   modal de registro). Al completarlo se guarda el sync
 *                   inmediato (/api/user-profile/sync) o el modal de registro
 *                   contextual ('quiz-complete'), con respuestas en LocalStorage.
 *
 * La sección ocupa el ancho completo de la página (se sitúa fuera del
 * .container del hero en index.astro).
 */
import MethodologyQuiz from './metodologia/MethodologyQuiz.astro';
import ProductCard from './ProductCard.astro';
import type { Product } from '../data/products';

interface Props {
  /** Top de ofertas (mayor descuento real) para el carrusel de Ofertas. */
  deals?: Product[];
}

const { deals = [] } = Astro.props;
---

<section class="hsr" data-hsr aria-label="Panel de ofertas y asistente de Tradylor">
  <div class="hsr-tabs" role="tablist" aria-label="Modos del panel">
    <button type="button" class="hsr-tab is-active" role="tab" aria-selected="true" data-hsr-tab="ofertas">
      <span class="hsr-tab-icon" aria-hidden="true">🔥</span> Ofertas
    </button>
    <button type="button" class="hsr-tab" role="tab" aria-selected="false" data-hsr-tab="perfil">
      <span class="hsr-tab-icon" aria-hidden="true">🎯</span> Asistente
    </button>
  </div>

  <!-- ── Pestaña 1: carrusel horizontal de ofertas (una fila) ──────────── -->
  <div class="hsr-panel" role="tabpanel" data-hsr-panel="ofertas">
    <p class="hsr-lead">Descuentos verificados sobre el PVP de nuestro catálogo analizado. Desliza para verlos todos.</p>
    {deals.length > 0 ? (
      <div class="hsr-deals" data-hsr-deals>
        <button type="button" class="hsr-carousel-btn hsr-carousel-prev" data-hsr-prev aria-label="Ofertas anteriores">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <div class="hsr-deals-track" data-hsr-track>
          {deals.map((product) => <ProductCard product={product} layout="compact" />)}
        </div>
        <button type="button" class="hsr-carousel-btn hsr-carousel-next" data-hsr-next aria-label="Siguientes ofertas">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </div>
    ) : (
      <p class="hsr-status">No hay ofertas activas ahora mismo. Vuelve pronto 🍀</p>
    )}
  </div>

  <!-- ── Pestaña 2: perfilador (quiz) ──────────────────────────────────── -->
  <div class="hsr-panel" role="tabpanel" data-hsr-panel="perfil" hidden>
    <p class="hsr-lead">Responde 3 preguntas y te recomendamos el producto que encaja contigo.</p>
    <MethodologyQuiz compact />
  </div>
</section>

<script>
  import { getSession } from '../utils/auth';

  const QUIZ_ANSWERS_KEY = 'tradylor-quiz-answers';
  const SEARCH_TERMS_KEY = 'tradylor-search-terms';

  const initHsr = (): void => {
    const root = document.querySelector<HTMLElement>('[data-hsr]');
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hsr-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-hsr-panel]'));

    const activateTab = (name: string): void => {
      tabs.forEach((tab) => {
        const active = tab.dataset.hsrTab === name;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.hsrPanel !== name;
      });
      if (name === 'ofertas') syncArrows();
    };

    const openAuthRegister = (context?: string): void => {
      const w = window as unknown as {
        TradylorAuth?: { open?: (view?: string, context?: string) => void };
      };
      w.TradylorAuth?.open?.('register', context);
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const name = tab.dataset.hsrTab ?? 'ofertas';
        // Gate: "Asistente" siempre redirige al registro si no hay sesión.
        // getSession en vivo (sin fiarse del caché del Layout): sin usuario
        // se abre el modal de registro contextual y no se muestra el quiz.
        if (name === 'perfil') {
          tab.classList.add('is-loading');
          void getSession(true)
            .then((session) => {
              if (session.user) {
                activateTab(name);
                return;
              }
              openAuthRegister('quiz-complete');
            })
            .catch(() => {
              openAuthRegister('quiz-complete');
            })
            .finally(() => {
              tab.classList.remove('is-loading');
            });
          return;
        }
        activateTab(name);
      });
    });

    // ── Carrusel de ofertas: una sola fila, scroll-snap horizontal ───────
    const track = root.querySelector<HTMLElement>('[data-hsr-track]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-hsr-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-hsr-next]');

    const step = (): number => {
      if (!track) return 320;
      const card = track.querySelector<HTMLElement>('.product-card');
      if (!card) return Math.round(track.clientWidth * 0.8);
      const styles = window.getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
      return card.offsetWidth + gap;
    };

    function syncArrows(): void {
      if (!track || !prevBtn || !nextBtn) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      const scrollable = maxScroll > 4;
      prevBtn.disabled = !scrollable || track.scrollLeft <= 4;
      nextBtn.disabled = !scrollable || track.scrollLeft >= maxScroll - 4;
    }

    prevBtn?.addEventListener('click', () => {
      track?.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    nextBtn?.addEventListener('click', () => {
      track?.scrollBy({ left: step(), behavior: 'smooth' });
    });
    track?.addEventListener('scroll', syncArrows, { passive: true });
    window.addEventListener('resize', syncArrows);
    syncArrows();

    // ── Quiz del asistente: guardar respuestas + modal contextual ────────
    document.addEventListener('quiz:complete', (event) => {
      const detail = (event as CustomEvent<{ answers?: Record<string, string>; buyerProfile?: string }>).detail ?? {};
      try {
        localStorage.setItem(
          QUIZ_ANSWERS_KEY,
          JSON.stringify({ ...detail.answers, buyerProfile: detail.buyerProfile, updatedAt: Date.now() }),
        );
      } catch { /* sin LocalStorage: el quiz sigue mostrando su resultado. */ }
      const w = window as unknown as {
        TradylorAuth?: { open?: (view?: string, context?: string) => void };
        getCachedSession?: unknown;
      };
      // Soft gate: si no hay sesión, pedimos registro con el contexto 'quiz-complete'.
      // getSession en vivo para no depender del caché inicial del Layout.
      void fetch('/api/radar/auth/session', { credentials: 'same-origin' })
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => {
          if (data?.user) {
            // Con sesión: el quiz es el dato más valioso del perfil → sync inmediato
            // (el throttle de 24h del Layout no debe frenar este envío).
            const terms: string[] = (() => {
              try {
                const raw = localStorage.getItem(SEARCH_TERMS_KEY);
                const list: string[] = raw ? JSON.parse(raw) : [];
                return Array.isArray(list) ? list : [];
              } catch { return []; }
            })();
            void fetch('/api/user-profile/sync', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({
                lastSearchTerms: terms,
                quizAnswers: { perfil: detail.answers?.perfil, objetivo: detail.answers?.objetivo, presupuesto: detail.answers?.presupuesto },
                buyerProfile: detail.buyerProfile,
                budgetRange: detail.answers?.presupuesto,
              }),
            }).catch(() => { /* el sync del quiz es best-effort. */ });
            return;
          }
          w.TradylorAuth?.open?.('register', 'quiz-complete');
        })
        .catch(() => {
          // Sin red o sesión dudosa: mejor preguntar que perder el lead.
          w.TradylorAuth?.open?.('register', 'quiz-complete');
        });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHsr);
  } else {
    initHsr();
  }
</script>

<style>
  /* Ocupa el ancho completo de la página (el componente se monta fuera del
     .container del hero). */
  .hsr {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: 1.6rem 0 0;
    padding: 1rem clamp(1rem, 3.5vw, 2.75rem) 1.25rem;
    background: rgba(15, 23, 42, 0.72);
    border-top: 1px solid rgba(148, 163, 184, 0.18);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    text-align: left;
  }

  .hsr-tabs {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    padding: 0.25rem;
    background: rgba(2, 6, 23, 0.6);
    border-radius: 12px;
    max-width: 520px;
  }

  .hsr-tab {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.5rem 0.6rem;
    font-family: var(--font-body, inherit);
    font-size: 0.82rem;
    font-weight: 700;
    color: #94a3b8;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hsr-tab:hover {
    color: #e2e8f0;
  }

  .hsr-tab.is-active {
    color: #ffffff;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.9), rgba(37, 99, 235, 0.9));
    border-color: rgba(96, 165, 250, 0.45);
    box-shadow: 0 6px 18px rgba(59, 130, 246, 0.35);
  }

  .hsr-tab.is-loading {
    opacity: 0.65;
    cursor: progress;
    pointer-events: none;
  }

  .hsr-tab-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  .hsr-panel[hidden] {
    display: none;
  }

  /* El quiz no debe estirarse a todo el ancho de la página. */
  .hsr-panel[data-hsr-panel='perfil'] {
    max-width: 760px;
    margin: 0 auto;
  }

  .hsr-lead {
    margin: 0 0 0.7rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: #94a3b8;
  }

  .hsr-status {
    margin: 0.55rem 0 0;
    font-size: 0.76rem;
    font-weight: 600;
    color: #93c5fd;
  }

  /* ── Carrusel horizontal de una fila ──────────────────────────────────── */
  .hsr-deals {
    position: relative;
  }

  .hsr-deals-track {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* Margen superior para que el hover (translateY -8px) no lo recorte
       el contenedor con scroll; el inferior deja sitio a la sombra. */
    padding: 0.6rem 0 0.9rem;
    margin-top: -0.6rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(96, 165, 250, 0.45) transparent;
  }

  .hsr-deals-track::-webkit-scrollbar {
    height: 8px;
  }

  .hsr-deals-track::-webkit-scrollbar-track {
    background: rgba(2, 6, 23, 0.5);
    border-radius: 999px;
  }

  .hsr-deals-track::-webkit-scrollbar-thumb {
    background: rgba(96, 165, 250, 0.45);
    border-radius: 999px;
  }

  .hsr-deals-track::-webkit-scrollbar-thumb:hover {
    background: rgba(96, 165, 250, 0.7);
  }

  :global(.hsr-deals-track > .product-card) {
    flex: 0 0 auto;
    width: min(360px, calc(100vw - 3rem));
    scroll-snap-align: start;
  }

  .hsr-carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 6;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    color: #93c5fd;
    background: rgba(2, 6, 23, 0.92);
    border: 1px solid rgba(96, 165, 250, 0.4);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
    transition: all 0.2s ease;
  }

  .hsr-carousel-btn:hover:not(:disabled) {
    color: #ffffff;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.95), rgba(37, 99, 235, 0.95));
    border-color: rgba(96, 165, 250, 0.7);
  }

  .hsr-carousel-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .hsr-carousel-prev {
    left: -0.5rem;
  }

  .hsr-carousel-next {
    right: -0.5rem;
  }

  @media (max-width: 560px) {
    .hsr {
      padding: 0.75rem 0.9rem 1rem;
    }

    .hsr-tab {
      font-size: 0.74rem;
      padding: 0.45rem 0.35rem;
    }

    .hsr-tab-icon {
      display: none;
    }

    .hsr-carousel-btn {
      width: 32px;
      height: 32px;
    }

    .hsr-carousel-prev {
      left: -0.25rem;
    }

    .hsr-carousel-next {
      right: -0.25rem;
    }
  }
</style>
