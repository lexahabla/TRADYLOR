    display: inline-flex;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 0.25rem;
    gap: 0.25rem;
  }

  .view-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
