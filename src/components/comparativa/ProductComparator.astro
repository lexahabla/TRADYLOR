  .audit-tag--cost { color: #34d399; border-color: rgba(16, 185, 129, 0.35); background: rgba(16, 185, 129, 0.08); }
  .audit-tag--verified { color: #93c5fd; border-color: rgba(59, 130, 246, 0.35); background: rgba(59, 130, 246, 0.08); }

  .cmp-card-views {
    flex: 1;
    margin-bottom: 1rem;
  }

  .cmp-view-label {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #60a5fa;
    margin-bottom: 0.55rem;
  }

  .cmp-specs {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cmp-spec-row {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8rem;
    padding: 0.32rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .cmp-spec-row:last-child {
    border-bottom: none;
  }

  .cmp-spec-row dt {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
    flex-shrink: 0;
  }

  .cmp-spec-row dd {
    color: #e5e7eb;
    font-weight: 600;
    text-align: right;
    margin: 0;
  }

  .cmp-zero { color: #34d399; }
  .cmp-verified { color: #93c5fd; }

  .cmp-list {
    margin: 0 0 0.7rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cmp-list li {
    position: relative;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.45;
    padding-left: 1.1rem;
  }

  .cmp-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .cmp-list--pros li::before { background: #10b981; }

  .cmp-list--cons li::before { background: #f97316; }

  .cmp-verdict {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    font-style: italic;
    line-height: 1.5;
    border-left: 2px solid rgba(59, 130, 246, 0.5);
    padding-left: 0.65rem;
    margin: 0;
  }

  .cmp-card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.6rem 1rem;
    background: rgba(59, 130, 246, 0.14);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 10px;
    color: #93c5fd;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .cmp-card-cta:hover {
    background: #2563eb;
    color: #ffffff;
    border-color: transparent;
  }

  @media (max-width: 640px) {
    .comparator-head {
      flex-direction: column;
      align-items: stretch;
    }

    .comparator-controls {
      flex-direction: column;
      align-items: stretch;
    }

    .view-toggle {
      width: 100%;
    }

    .view-toggle-btn {
      flex: 1;
      justify-content: center;
    }

    .smart-match-select {
      width: 100%;
    }
  }
</style>

<script>
  type ViewMode = 'technical' | 'usage';

  const root = document.querySelector<HTMLElement>('[data-comparator]');
  if (!root) return;

  const viewBtns = root.querySelectorAll<HTMLButtonElement>('[data-view-btn]');
  const views = root.querySelectorAll<HTMLElement>('[data-view]');
  const smartMatch = root.querySelector<HTMLSelectElement>('[data-smart-match]');
  const cards = root.querySelectorAll<HTMLElement>('.cmp-card');

  const setView = (view: ViewMode) => {
    viewBtns.forEach((btn) => {
      btn.setAttribute('aria-selected', String(btn.dataset.viewBtn === view));
    });
    views.forEach((el) => {
      el.hidden = el.dataset.view !== view;
    });
  };

  viewBtns.forEach((btn) => {
    btn.addEventListener('click', () => setView(btn.dataset.viewBtn as ViewMode));
  });

  const applySmartMatch = (profile: string) => {
    const grid = root.querySelector<HTMLElement>('[data-comparator-grid]');
    if (!grid) return;

    const allCards = Array.from(cards);

    if (!profile) {
      allCards.forEach((card) => {
        card.classList.remove('is-match', 'is-dimmed');
        card.querySelector<HTMLElement>('[data-match-badge]')!.hidden = true;
      });
      return;
    }

    const matchedProfile = profile as 'principiante' | 'intermedio' | 'avanzado';
    const scoredCards = allCards
      .map((card) => {
        const specEntries = card.querySelectorAll('.cmp-spec-row').length;
        const prosItems = card.querySelectorAll('.cmp-list--pros li').length;
        const ratingText = card.querySelector('.cmp-card-price')?.textContent ?? '';
        const hasRating = ratingText.length > 0;
        const priceMatch = ratingText.match(/[\d.,]+/);
        const price = priceMatch ? parseFloat(priceMatch[0].replace(/\./g, '').replace(',', '.')) : 0;

        let score = 0;
        if (matchedProfile === 'principiante') {
          score = Math.min(prosItems / 3, 1) * 0.5 + Math.min(specEntries / 5, 1) * 0.3 + (hasRating ? 0.2 : 0);
        } else if (matchedProfile === 'intermedio') {
          score = Math.min(specEntries / 5, 1) * 0.4 + Math.min(prosItems / 3, 1) * 0.4 + (hasRating ? 0.2 : 0);
        } else {
          score = Math.min(specEntries / 5, 1) * 0.6 + (price > 0 ? 0.2 : 0) + (hasRating ? 0.2 : 0);
        }
        return { card, score };
      })
      .sort((a, b) => b.score - a.score);

    const topCard = scoredCards[0]?.card;
    scoredCards.forEach(({ card }) => {
      const isTop = card === topCard;
      card.classList.toggle('is-match', isTop);
      card.classList.toggle('is-dimmed', !isTop);
      const badge = card.querySelector<HTMLElement>('[data-match-badge]');
      if (badge) badge.hidden = !isTop;
    });
  };

  smartMatch?.addEventListener('change', () => applySmartMatch(smartMatch.value));
</script>
