---
import type { Product } from '../../data/products';

export interface Props {
  products: Product[];
  categoryName?: string;
}

const { products, categoryName } = Astro.props;

type ViewMode = 'technical' | 'usage';
type Profile = 'principiante' | 'intermedio' | 'avanzado';

interface ScoredProduct {
  product: Product;
  score: number;
  matchedProfile: Profile;
}

const scoreProduct = (p: Product, profile: Profile): number => {
  const rating = (p.rating ?? 0) / 5;
  const reviews = Math.min(Math.log10((p.reviewsCount ?? 0) + 1) / 4, 1);
  const value = p.originalPrice && p.originalPrice > p.price
    ? Math.min((p.originalPrice - p.price) / p.originalPrice, 1)
    : 0;

  if (profile === 'principiante') {
    return rating * 0.5 + reviews * 0.3 + value * 0.2;
  }
  if (profile === 'intermedio') {
    return rating * 0.4 + reviews * 0.3 + value * 0.3;
  }
  return rating * 0.6 + reviews * 0.25 + value * 0.15;
};

const scored: ScoredProduct[] = products.map((p) => {
  const profiles: Profile[] = ['principiante', 'intermedio', 'avanzado'];
  let best: Profile = 'principiante';
  let bestScore = 0;
  for (const profile of profiles) {
    const s = scoreProduct(p, profile);
    if (s > bestScore) {
      bestScore = s;
      best = profile;
    }
  }
  return { product: p, score: bestScore, matchedProfile: best };
});

const sortedForProfile = (profile: Profile): ScoredProduct[] =>
  [...scored]
    .sort((a, b) => scoreProduct(b.product, profile) - scoreProduct(a.product, profile));

const formatCurrency = (amount: number) =>
  new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 }).format(amount);
---

<section class="comparator" data-comparator>
  <div class="comparator-head">
    <div class="comparator-title-group">
      <span class="comparator-kicker">Motor de Comparativa</span>
      <h2 class="comparator-title">
        {categoryName ? `Comparativa: ${categoryName}` : 'Comparativa inteligente'}
      </h2>
      <p class="comparator-sub">
        Analiza las especificaciones técnicas reales o la experiencia de uso. Usa Smart Match para destacar la mejor opción según tu perfil.
      </p>
    </div>

    <div class="comparator-controls">
      <div class="view-toggle" role="tablist" aria-label="Selector de vista">
        <button
          type="button"
          role="tab"
          aria-selected="true"
          class="view-toggle-btn"
          data-view-btn="technical"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><line x1="9" y1="4" x2="9" y2="20"/><line x1="15" y1="4" x2="15" y2="20"/><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/></svg>
          Vista Técnica
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="view-toggle-btn"
          data-view-btn="usage"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Vista de Uso
        </button>
      </div>

      <div class="smart-match">
        <label for="smartMatchProfile" class="smart-match-label">Smart Match</label>
        <select id="smartMatchProfile" class="smart-match-select" data-smart-match>
          <option value="">Todos los perfiles</option>
          <option value="principiante">Principiante</option>
          <option value="intermedio">Intermedio</option>
          <option value="avanzado">Avanzado</option>
        </select>
      </div>
    </div>
  </div>

  <div class="comparator-body">
    <div class="comparator-legend">
      <span class="legend-tag legend-tag--latency">
        <span class="legend-dot"></span> Pruebas de latencia
      </span>
      <span class="legend-tag legend-tag--cost">
        <span class="legend-dot"></span> Costes Ocultos 0€
      </span>
      <span class="legend-tag legend-tag--verified">
        <span class="legend-dot"></span> Enlace Oficial Verificado
      </span>
    </div>

    <div class="comparator-grid" data-comparator-grid>
      {scored.map(({ product, matchedProfile }, idx) => (
        <article
          class="cmp-card"
          data-profile={matchedProfile}
          data-score={idx}
          data-product={product.id}
        >
          <div class="cmp-card-top">
            <span class="cmp-card-brand">{product.brand ?? product.category}</span>
            <span class="cmp-card-match" data-match-badge hidden>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              Smart Match
            </span>
          </div>

          <h3 class="cmp-card-title">{product.title}</h3>
          <p class="cmp-card-price">
            {formatCurrency(product.price)}
            {product.originalPrice && product.originalPrice > product.price && (
              <span class="cmp-card-original">{formatCurrency(product.originalPrice)}</span>
            )}
          </p>

          <div class="cmp-card-audits">
            <span class="audit-tag audit-tag--latency">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Pruebas de latencia
            </span>
            <span class="audit-tag audit-tag--cost">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              Costes Ocultos 0€
            </span>
            <span class="audit-tag audit-tag--verified">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              Enlace Oficial Verificado
            </span>
          </div>

          <div class="cmp-card-views">
            <div class="cmp-view cmp-view--technical" data-view="technical">
              <span class="cmp-view-label">Vista Técnica</span>
              <dl class="cmp-specs">
                {Object.entries(product.specs ?? {}).slice(0, 5).map(([key, value]) => (
                  <div class="cmp-spec-row">
                    <dt>{key}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
                {Object.keys(product.specs ?? {}).length === 0 && (
                  <div class="cmp-spec-row">
                    <dt>Valoración</dt>
                    <dd>{product.rating ?? 'N/A'} / 5</dd>
                  </div>
                )}
                <div class="cmp-spec-row">
                  <dt>Comisiones ocultas</dt>
                  <dd class="cmp-zero">0€ verificado</dd>
                </div>
                <div class="cmp-spec-row">
                  <dt>Enlace</dt>
                  <dd class="cmp-verified">Oficial · Verificado</dd>
                </div>
              </dl>
            </div>

            <div class="cmp-view cmp-view--usage" data-view="usage" hidden>
              <span class="cmp-view-label">Vista de Uso</span>
              <ul class="cmp-list cmp-list--pros">
                {(product.pros ?? []).slice(0, 3).map((pro) => (
                  <li>{pro}</li>
                ))}
                {(product.pros ?? []).length === 0 && <li>Valoración media: {product.rating ?? 'N/A'} / 5</li>}
              </ul>
              <ul class="cmp-list cmp-list--cons">
                {(product.cons ?? []).slice(0, 2).map((con) => (
                  <li>{con}</li>
                ))}
                {(product.cons ?? []).length === 0 && <li>Sin detectar desventajas relevantes</li>}
              </ul>
              <p class="cmp-verdict">{product.verdict ?? product.description}</p>
            </div>
          </div>

          <a
            href={`/producto/${product.slug ?? product.id}`}
            class="cmp-card-cta"
            target="_blank"
            rel="nofollow noopener sponsored"
          >
            Ver análisis completo
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .comparator {
    padding: 2rem 0 3rem;
  }

  .comparator-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .comparator-kicker {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
