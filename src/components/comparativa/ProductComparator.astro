    border-color: rgba(16, 185, 129, 0.55);
    box-shadow: 0 0 0 1px rgba(16, 185, 129, 0.25), 0 14px 36px rgba(16, 185, 129, 0.12);
  }

  .cmp-card.is-dimmed {
