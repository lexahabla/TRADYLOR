---
/**
 * ==============================================================================
 * TRADYLOR — AUTH MODAL (Mi Radar)
 * ==============================================================================
 * Modal de autenticación dual: pestañas "Iniciar sesión" / "Crear cuenta",
 * recuperación de contraseña y botón "Continuar con Google" (activo sólo si
 * el server tiene GOOGLE_CLIENT_ID/SECRET; si no, avisa "próximamente").
 *
 * Se monta una sola vez en Layout.astro (páginas públicas). La lógica vive en
 * el <script> bundled que importa src/utils/auth.ts. Se abre con:
 *   window.TradylorAuth.open()  (o clase .is-open en #authModal)
 * ==============================================================================
 */
---

<div id="authModal" class="auth-modal" role="dialog" aria-modal="true" aria-label="Autenticación" hidden>
  <div class="auth-modal-backdrop" data-auth-close></div>
  <div class="auth-modal-panel">
    <button type="button" class="auth-modal-close" data-auth-close aria-label="Cerrar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>


    <div class="auth-tabs" role="tablist" aria-label="Autenticación">
      <button type="button" class="auth-tab is-active" role="tab" aria-selected="true" data-auth-tab="login">Iniciar sesión</button>
      <button type="button" class="auth-tab" role="tab" aria-selected="false" data-auth-tab="register">Crear cuenta</button>
    </div>

    <!-- Copy contextual: sólo se muestra cuando el origen define un trigger
         (Añadir a Mi Radar, Comprar Ya o fin del Quiz). -->
    <div class="auth-context" data-auth-context hidden>
      <h2 class="auth-context-title" data-auth-headline></h2>
      <p class="auth-context-body" data-auth-body></p>
      <button type="button" class="auth-continue-link" data-auth-continue hidden>Continuar sin registrarme</button>
    </div>

    <p class="auth-error" data-auth-error role="alert" hidden></p>

    <!-- Login -->
    <form class="auth-form" data-auth-form="login" novalidate>
      <label class="auth-field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="auth-field">
        <span>Contraseña</span>
        <input type="password" name="password" autocomplete="current-password" required minlength="8" />
      </label>
      <div class="auth-remember" role="radiogroup" aria-label="Persistencia de sesión">
        <label class="auth-radio">
          <input type="radio" name="remember" value="yes" checked />
          <span>Mantener mi sesión abierta</span>
        </label>
        <label class="auth-radio">
          <input type="radio" name="remember" value="no" />
          <span>No mantener mi sesión</span>
        </label>
      </div>
      <button type="submit" class="auth-submit">Entrar</button>
      <button type="button" class="auth-link-btn" data-auth-view="magic">Entrar con enlace mágico (sin contraseña)</button>
      <button type="button" class="auth-link-btn" data-auth-view="forgot">¿Olvidaste tu contraseña?</button>
    </form>

    <!-- Registro -->
    <form class="auth-form" data-auth-form="register" novalidate hidden>
      <label class="auth-field">
        <span>Nombre (opcional)</span>
        <input type="text" name="name" autocomplete="name" />
      </label>
      <label class="auth-field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="auth-field">
        <span>Contraseña (mín. 8 caracteres)</span>
        <input type="password" name="password" autocomplete="new-password" required minlength="8" />
      </label>
      <button type="submit" class="auth-submit">Crear cuenta gratis</button>
    </form>

    <!-- Recuperación -->
    <form class="auth-form" data-auth-form="forgot" novalidate hidden>
      <p class="auth-form-hint">Escribe tu email y te enviaremos un enlace para elegir una contraseña nueva.</p>
      <label class="auth-field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <button type="submit" class="auth-submit">Enviar enlace</button>
      <button type="button" class="auth-link-btn" data-auth-view="login">Volver a iniciar sesión</button>
    </form>

    <!-- Login sin contraseña (magic link) -->
    <form class="auth-form" data-auth-form="magic" novalidate hidden>
      <p class="auth-form-hint">Escribe tu email y te enviaremos un enlace de un solo uso para entrar en Mi Radar, sin contraseña.</p>
      <label class="auth-field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <button type="submit" class="auth-submit">Enviar enlace mágico</button>
      <button type="button" class="auth-link-btn" data-auth-view="login">Volver a iniciar sesión</button>
    </form>

    <!-- Reset (token en URL ?reset=…) -->
    <form class="auth-form" data-auth-form="reset" novalidate hidden>
      <p class="auth-form-hint">Elige una contraseña nueva para tu cuenta.</p>
      <label class="auth-field">
        <span>Nueva contraseña (mín. 8 caracteres)</span>
        <input type="password" name="password" autocomplete="new-password" required minlength="8" />
      </label>
      <button type="submit" class="auth-submit">Guardar contraseña</button>
    </form>

    <!-- Verificación pendiente (tras registrarse con email no gmail) -->
    <div class="auth-form" data-auth-form="verify" novalidate hidden>
      <div class="auth-info-box">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="3"></rect>
          <path d="m2 7 10 7L22 7"></path>
        </svg>
        <h3>Revisa tu correo para activar tu cuenta</h3>
        <p>
          Te hemos enviado un email de bienvenida con un <strong>botón de activación</strong>.
          También explica en qué consiste Mi Radar: guardar productos, organizar listas de
          compra y retomar salidas desde cualquier dispositivo.
        </p>
        <p>Si no lo ves, revisa también la carpeta de <strong>correo no deseado</strong>.</p>
      </div>
      <button type="button" class="auth-submit" data-auth-view="login">Ir a iniciar sesión</button>
      <button type="button" class="auth-link-btn" data-auth-resend>Reenviar email de activación</button>
    </div>

    <!-- Cuenta aún no activada (login bloqueado) -->
    <div class="auth-form" data-auth-form="locked" novalidate hidden>
      <div class="auth-info-box">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 3 2.5 20h19L12 3z" stroke-linejoin="round"></path>
          <line x1="12" y1="10" x2="12" y2="14"></line>
          <circle cx="12" cy="17" r="0.6" fill="currentColor"></circle>
        </svg>
        <h3>Tu cuenta aún no está activada</h3>
        <p>
          Revisa bien el correo de bienvenida, <strong>incluso la bandeja de correo
          no deseados</strong>, y pulsa el botón de activación para poder entrar.
        </p>
      </div>
      <button type="button" class="auth-submit" data-auth-view="login">Volver a iniciar sesión</button>
      <button type="button" class="auth-link-btn" data-auth-resend>Reenviar email de activación</button>
    </div>

    <!-- Cuenta activada (tras el enlace del email) -->
    <div class="auth-form" data-auth-form="activated" novalidate hidden>
      <div class="auth-info-box">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m8 12.5 2.5 2.5L16 9.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <h3>¡Cuenta activada!</h3>
        <p>Tu email ya está verificado. Ahora puedes iniciar sesión y acceder a Mi Radar.</p>
      </div>
      <button type="button" class="auth-submit" data-auth-view="login">Iniciar sesión</button>
    </div>

    <div class="auth-separator" data-auth-google-wrap><span>o</span></div>

    <button type="button" class="auth-google-btn" data-auth-google>
      <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.06l3.66 2.84C6.71 7.29 9.14 5.38 12 5.38z"/>
      </svg>
      <span data-auth-google-label>Continuar con Google</span>
    </button>
    <p class="auth-google-hint" data-auth-google-hint hidden>Próximamente: configura GOOGLE_CLIENT_ID en el servidor para activarlo.</p>

    <p class="auth-privacy">
      🔒 0% Spam. Solo notificaciones cuando de verdad baje el precio.
      <a href="#aviso-legal">Más información</a>
    </p>
  </div>
</div>

<style>
  :global(body.auth-modal-is-open) {
    overflow: hidden;
  }

  .auth-modal {
    position: fixed;
    inset: 0;
    z-index: 9500;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .auth-modal[hidden] {
    display: none;
  }

  .auth-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 8, 16, 0.72);
    backdrop-filter: blur(6px);
  }

  .auth-modal-panel {
    position: relative;
    width: min(420px, 100%);
    max-height: calc(100vh - 2.5rem);
    overflow-y: auto;
    padding: 1.75rem 1.6rem 1.6rem;
    background: linear-gradient(160deg, #131b2c 0%, #0d1422 100%);
    border: 1px solid rgba(96, 165, 250, 0.22);
    border-radius: 20px;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.55);
  }

  .auth-modal-close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    cursor: pointer;
  }

  .auth-modal-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  .auth-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.3rem;
    padding: 0.28rem;
    margin-top: 35px;
    margin-bottom: 1.1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
  }

  .auth-tab {
    padding: 0.55rem 0.5rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-muted);
    background: transparent;
    border: 0;
    border-radius: 9px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .auth-tab.is-active {
    color: #07111f;
    background: #60a5fa;
  }

  .auth-error {
    margin: 0 0 0.9rem;
    padding: 0.65rem 0.85rem;
    font-size: 0.8rem;
    color: #fecaca;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 10px;
  }

  .auth-context {
    display: grid;
    gap: 0.4rem;
    margin: 0 0 1rem;
    padding: 0.9rem 1rem;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(96, 165, 250, 0.22);
    border-radius: 12px;
  }

  .auth-context[hidden] {
    display: none;
  }

  .auth-context-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .auth-context-body {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .auth-continue-link {
    justify-self: start;
    margin-top: 0.35rem;
    padding: 0;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    color: #93c5fd;
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: underline;
  }

  .auth-continue-link[hidden] {
    display: none;
  }

  .auth-privacy {
    margin: 1rem 0 0;
    font-size: 0.72rem;
    line-height: 1.5;
    text-align: center;
    color: var(--color-text-dim);
  }

  .auth-privacy a {
    color: #60a5fa;
    text-decoration: none;
  }

  .auth-privacy a:hover {
    text-decoration: underline;
  }

  .auth-form {
    display: grid;
    gap: 0.9rem;
  }

  .auth-form[hidden] {
    display: none;
  }

  .auth-form-hint {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .auth-info-box {
    display: grid;
    gap: 0.55rem;
    justify-items: center;
    padding: 1rem 0.4rem 0.2rem;
    text-align: center;
    color: #fbbf24;
  }

  .auth-info-box h3 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .auth-info-box p {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .auth-info-box strong {
    color: #e5e7eb;
  }

  .auth-field {
    display: grid;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .auth-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.78rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-main);
    background: rgba(10, 14, 23, 0.8);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .auth-field input:focus {
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.14);
  }

  .auth-remember {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .auth-radio {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    cursor: pointer;
    user-select: none;
  }

  .auth-radio input {
    width: 16px;
    height: 16px;
    margin: 0;
    flex-shrink: 0;
    accent-color: #60a5fa;
    cursor: pointer;
  }

  .auth-radio input:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
  }

  .auth-radio:hover {
    color: var(--color-text-main);
  }

  .auth-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.85rem 1rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 800;
    color: #07111f;
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    border: 0;
    border-radius: 11px;
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .auth-submit:hover {
    filter: brightness(1.1);
  }

  .auth-submit:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  .auth-link-btn {
    justify-self: center;
    padding: 0.2rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    color: #60a5fa;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .auth-link-btn:hover {
    text-decoration: underline;
  }

  .auth-separator {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 1.1rem 0;
    color: var(--color-text-dim);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .auth-separator::before,
  .auth-separator::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
  }

  .auth-separator[hidden] {
    display: none;
  }

  .auth-google-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.8rem 1rem;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-text-main);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 11px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .auth-google-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .auth-google-hint {
    margin: 0.6rem 0 0;
    font-size: 0.72rem;
    text-align: center;
    color: var(--color-text-dim);
  }

  .auth-google-hint[hidden] {
    display: none;
  }

  @media (max-width: 480px) {
    .auth-modal-panel {
      padding: 1.4rem 1.15rem 1.25rem;
    }
  }
</style>

<script>
  import {
    getSession,
    login,
    register,
    requestPasswordReset,
    resetPassword,
    loginWithGoogle,
    verifyAccount,
    resendVerification,
    requestMagicLink,
    verifyMagicLink,
  } from '../utils/auth';

  const modal = document.getElementById('authModal');
  if (modal) {
    const errorEl = modal.querySelector<HTMLElement>('[data-auth-error]');
    const forms = {
      login: modal.querySelector<HTMLFormElement>('[data-auth-form="login"]'),
      register: modal.querySelector<HTMLFormElement>('[data-auth-form="register"]'),
      forgot: modal.querySelector<HTMLFormElement>('[data-auth-form="forgot"]'),
      magic: modal.querySelector<HTMLFormElement>('[data-auth-form="magic"]'),
      reset: modal.querySelector<HTMLFormElement>('[data-auth-form="reset"]'),
      verify: modal.querySelector<HTMLElement>('[data-auth-form="verify"]'),
      locked: modal.querySelector<HTMLElement>('[data-auth-form="locked"]'),
      activated: modal.querySelector<HTMLElement>('[data-auth-form="activated"]'),
    } as const;
    type View = keyof typeof forms;

    // Copy contextual por origen de apertura (Growth: misma UI, mensaje específico).
    const AUTH_CONTEXTS = {
      'radar-add': {
        headline: '📡 Activa tu Radar Tradylor',
        body: 'Crea tu cuenta gratis en 1 clic para guardar este producto en tu Radar y recibir una notificación cuando baje de precio o entre en stock.',
        view: 'register',
      },
      'buy-now': {
        headline: '🛒 Comprueba la mejor oferta disponible',
        body: 'Inicia sesión para activar el seguimiento de garantía de Tradylor y comprobar disponibilidad en tiempo real.',
        view: 'login',
      },
      'quiz-complete': {
        headline: '🎯 Guarda tu Perfil de Comprador',
        body: 'Regístrate para guardar tus recomendaciones personalizadas y tus categorías favoritas.',
        view: 'register',
      },
    } as const;
    type ContextKey = keyof typeof AUTH_CONTEXTS;

    const tabs = modal.querySelectorAll<HTMLButtonElement>('[data-auth-tab]');
    const googleBtn = modal.querySelector<HTMLButtonElement>('[data-auth-google]');
    const googleWrap = modal.querySelector<HTMLElement>('[data-auth-google-wrap]');
    const googleHint = modal.querySelector<HTMLElement>('[data-auth-google-hint]');
    const contextBox = modal.querySelector<HTMLElement>('[data-auth-context]');
    const contextHeadline = modal.querySelector<HTMLElement>('[data-auth-headline]');
    const contextBody = modal.querySelector<HTMLElement>('[data-auth-body]');
    const continueBtn = modal.querySelector<HTMLButtonElement>('[data-auth-continue]');

    let lastFocus: HTMLElement | null = null;
    let currentView: View = 'login';
    let pendingEmail = '';
    let pendingContinueHref = '';

    const showError = (message: string) => {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = !message;
    };

    const showContext = (context?: string) => {
      const copy = context && context in AUTH_CONTEXTS ? AUTH_CONTEXTS[context as ContextKey] : null;
      if (!copy || !contextBox) {
        contextBox?.setAttribute('hidden', '');
        return;
      }
      if (contextHeadline) contextHeadline.textContent = copy.headline;
      if (contextBody) contextBody.textContent = copy.body;
      contextBox.removeAttribute('hidden');
      if (continueBtn) continueBtn.hidden = !pendingContinueHref;
    };

    const showView = (view: View) => {
      currentView = view;
      for (const [key, form] of Object.entries(forms)) {
        if (form) {
          form.hidden = key !== view;
          // verify / locked / activated son <div>, no formularios: sólo un <form> tiene reset().
          if (form instanceof HTMLFormElement) form.reset();
        }
      }
      tabs.forEach((tab) => {
        const active = (view === 'login' && tab.dataset.authTab === 'login')
          || (view === 'register' && tab.dataset.authTab === 'register');
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      showError('');
    };

    const open = (view: View = 'login', context?: string, href?: string) => {
      lastFocus = document.activeElement as HTMLElement | null;
      pendingContinueHref = href ?? '';
      modal.hidden = false;
      document.body.classList.add('auth-modal-is-open');
      for (const form of Object.values(forms)) {
        if (form instanceof HTMLFormElement) form.reset();
      }
      // Con contexto, la vista por defecto es la del trigger (p. ej. registro
      // al guardar en el radar; login al comprar).
      const copy = context && context in AUTH_CONTEXTS ? AUTH_CONTEXTS[context as ContextKey] : null;
      const targetView: View = copy ? (copy.view as View) : view;
      showContext(context);
      showView(targetView in forms ? targetView : view);
      const firstInput = forms[targetView in forms ? targetView : view]?.querySelector<HTMLInputElement>('input');
      firstInput?.focus();
    };

    const close = () => {
      modal.hidden = true;
      document.body.classList.remove('auth-modal-is-open');
      lastFocus?.focus?.();
    };

    // API pública para abrir el modal desde cualquier página/botón.
    (window as unknown as Record<string, unknown>).TradylorAuth = { open, close };

    // Delegación global: cualquier [data-open-auth] (cabecera, banner, etc.)
    // abre el modal en la vista indicada (login | register | forgot | reset | magic).
    // [data-open-auth-context] añade el copy específico del trigger.
    document.addEventListener('click', (event) => {
      const t = event.target;
      if (!(t instanceof Element)) return;
      const trigger = t.closest<HTMLElement>('[data-open-auth]');
      if (!trigger) return;
      event.preventDefault();
      const view = (trigger.dataset.openAuth ?? 'login') as View;
      const context = trigger.dataset.openAuthContext;
      open(view in forms ? view : 'login', context);
    });

    modal.querySelectorAll('[data-auth-close]').forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) close();
    });

    // "Continuar sin registrarme" (sólo con contexto y href pendiente, p. ej. Comprar Ya).
    continueBtn?.addEventListener('click', () => {
      if (pendingContinueHref) window.location.href = pendingContinueHref;
      else close();
    });

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => showView(tab.dataset.authTab as View));
    });
    modal.querySelectorAll<HTMLElement>('[data-auth-view]').forEach((el) => {
      el.addEventListener('click', () => showView(el.dataset.authView as View));
    });

    // Abre el modal automáticamente si la URL trae ?reset=<token>.
    const resetToken = new URLSearchParams(window.location.search).get('reset');
    if (resetToken) open('reset');

    // Enlace del email de bienvenida: ?verify=<token> → activa la cuenta y
    // muestra el modal de "cuenta activada" con el botón de iniciar sesión.
    const verifyToken = new URLSearchParams(window.location.search).get('verify');
    if (verifyToken) {
      void verifyAccount(verifyToken).then((result) => {
        if (result.success) {
          window.history.replaceState(null, '', window.location.pathname);
          open('activated');
        } else {
          open('locked');
        }
      });
    }

    // Enlace mágico del email: ?magic=<token> → canjea el token por sesión.
    const magicToken = new URLSearchParams(window.location.search).get('magic');
    if (magicToken) {
      void verifyMagicLink(magicToken).then((result) => {
        if (result.success) {
          window.history.replaceState(null, '', window.location.pathname);
          window.location.reload();
        } else {
          showError(result.message ?? 'El enlace no es válido o ha caducado.');
          open('magic');
        }
      });
    }

    const setBusy = (busy: boolean) => {
      modal.querySelectorAll<HTMLButtonElement>('.auth-submit').forEach((btn) => {
        btn.disabled = busy;
      });
    };

    // Tras iniciar sesión / crear la cuenta se va a la portada, salvo en las páginas que dependen
    // de la sesión y marcan <body data-auth-stay> (p. ej. /share/<id>): ahí se recarga la misma
    // página (con su ?lang=…) para que siga donde estaba el usuario.
    const afterAuth = () => {
      close();
      if (document.body.hasAttribute('data-auth-stay')) window.location.reload();
      else window.location.href = '/';
    };

    forms.login?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(forms.login!);
      setBusy(true);
      const result = await login(
        String(data.get('email') ?? ''),
        String(data.get('password') ?? ''),
        String(data.get('remember') ?? 'yes') === 'yes',
      );
      setBusy(false);
      if (result.success) {
        afterAuth();
      } else if (result.code === 'verify_required') {
        pendingEmail = String(data.get('email') ?? '');
        showView('locked');
      } else {
        showError(result.message ?? 'Error al iniciar sesión.');
      }
    });

    // Login sin contraseña: pide el enlace mágico y lo muestra en dev si no hay SMTP.
    forms.magic?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(forms.magic!);
      setBusy(true);
      const result = await requestMagicLink(String(data.get('email') ?? ''));
      setBusy(false);
      if (result.success) {
        showError('');
        let message = result.message || 'Revisa tu email: te hemos enviado un enlace para entrar.';
        if (result.devMagicUrl) {
          message += ` (dev: ${result.devMagicUrl})`;
        }
        const hint = forms.magic?.querySelector('.auth-form-hint');
        if (hint) {
          hint.textContent = message;
          hint.style.color = '#6ee7b7';
        }
      } else {
        showError(result.message ?? 'No se pudo enviar el enlace.');
      }
    });

    forms.register?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(forms.register!);
      setBusy(true);
      const result = await register(
        String(data.get('email') ?? ''),
        String(data.get('password') ?? ''),
        String(data.get('name') ?? ''),
      );
      setBusy(false);
      if (result.success) {
        if (result.verificationPending) {
          pendingEmail = String(data.get('email') ?? '');
          showView('verify');
        } else {
          afterAuth();
        }
      } else {
        showError(result.message ?? 'No se pudo crear la cuenta.');
      }
    });

    // Reenvío del email de activación (vistas "verify" y "locked").
    modal.querySelectorAll<HTMLButtonElement>('[data-auth-resend]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!pendingEmail) return;
        btn.disabled = true;
        const result = await resendVerification(pendingEmail);
        btn.disabled = false;
        const box = forms[currentView]?.querySelector('.auth-info-box');
        if (box) {
          const note = document.createElement('p');
          note.style.color = '#6ee7b7';
          note.textContent = result.devVerifyUrl
            ? `Email reenviado (dev: ${result.devVerifyUrl})`
            : (result.message ?? 'Email reenviado. Revisa tu carpeta de entrada.');
          box.appendChild(note);
        }
      });
    });

    forms.forgot?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(forms.forgot!);
      setBusy(true);
      const result = await requestPasswordReset(String(data.get('email') ?? ''));
      setBusy(false);
      if (result.success) {
        let message = result.message || 'Revisa tu email.';
        if (result.devResetUrl) {
          message += ` (dev: ${result.devResetUrl})`;
        }
        showError('');
        const hint = forms.forgot?.querySelector('.auth-form-hint');
        if (hint) {
          hint.textContent = message;
          hint.style.color = '#6ee7b7';
        }
      } else {
        showError(result.message ?? 'No se pudo procesar la solicitud.');
      }
    });

    forms.reset?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(forms.reset!);
      setBusy(true);
      const result = await resetPassword(resetToken ?? '', String(data.get('password') ?? ''));
      setBusy(false);
      if (result.success) {
        close();
        window.location.href = '/';
      } else {
        showError(result.message ?? 'El enlace no es válido o ha caducado.');
      }
    });

    googleBtn?.addEventListener('click', async () => {
      showError('');
      try {
        await loginWithGoogle();
      } catch (error) {
        showError(error instanceof Error ? error.message : 'Google no disponible.');
      }
    });

    // Activa o desactiva el botón de Google según el server.
    void getSession().then((session) => {
      const enabled = Boolean(session.googleEnabled);
      if (googleBtn) googleBtn.hidden = !enabled;
      if (googleWrap) googleWrap.hidden = !enabled;
      if (googleHint) googleHint.hidden = enabled;
    });
  }
</script>
