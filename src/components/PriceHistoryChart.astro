---
/**
 * TRADYLOR — Gráfico de histórico de precio (ficha de producto).
 * SVG 100% propio (sin librerías), igual que el resto de gráficos del proyecto.
 * Con menos de 3 lecturas no dibuja curva: muestra el precio verificado hoy.
 */
export interface Props {
  points: { date: string; price: number }[];
  currentPrice: number;
}

const { points, currentPrice } = Astro.props;

const valid = (Array.isArray(points) ? points : []).filter(
  (p) => p && typeof p.date === 'string' && Number.isFinite(p.price) && p.price > 0,
);

const hasChart = valid.length >= 3;

const currency = new Intl.NumberFormat('es-ES', {
  style: 'currency',
  currency: 'EUR',
  minimumFractionDigits: 2,
});
const shortDate = new Intl.DateTimeFormat('es-ES', { day: '2-digit', month: 'short' });

const prices = valid.map((p) => p.price);
const min = hasChart ? Math.min(...prices) : currentPrice;
const max = hasChart ? Math.max(...prices) : currentPrice;
const first = hasChart ? valid[0] : null;
const last = hasChart ? valid[valid.length - 1] : null;
const deltaPct =
  hasChart && first && first.price > 0 ? ((last!.price - first.price) / first.price) * 100 : 0;

const parseDate = (iso: string): Date => new Date(`${iso}T00:00:00`);

// --- Geometría del SVG -------------------------------------------------------
const W = 640;
const H = 190;
const PAD_X = 10;
const PAD_Y = 18;
const n = valid.length;
const range = max - min || 1;
const xAt = (i: number): number => (n <= 1 ? W / 2 : PAD_X + (i * (W - PAD_X * 2)) / (n - 1));
const yAt = (price: number): number => PAD_Y + (1 - (price - min) / range) * (H - PAD_Y * 2);

const linePath = valid
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${xAt(i).toFixed(1)},${yAt(p.price).toFixed(1)}`)
  .join(' ');
const areaPath = hasChart
  ? `${linePath} L${xAt(n - 1).toFixed(1)},${H - PAD_Y} L${xAt(0).toFixed(1)},${H - PAD_Y} Z`
  : '';
const minIndex = prices.indexOf(min);
const maxIndex = prices.indexOf(max);
---

{hasChart ? (
  <section class="phc" aria-label="Histórico de precio">
    <header class="phc-head">
      <div>
        <p class="phc-kicker">Seguimiento de precio</p>
        <h2 class="phc-title">Histórico de precio</h2>
      </div>
      <span class={`phc-delta${deltaPct < 0 ? ' is-down' : deltaPct > 0 ? ' is-up' : ''}`}>
        {deltaPct > 0 ? '+' : ''}
        {deltaPct.toFixed(1)}% desde el {first ? shortDate.format(parseDate(first.date)) : ''}
      </span>
    </header>

    <div class="phc-stats">
      <div class="phc-stat">
        <span class="phc-stat-label">Hoy</span>
        <strong class="phc-stat-value">{currency.format(currentPrice)}</strong>
      </div>
      <div class="phc-stat">
        <span class="phc-stat-label">Mínimo</span>
        <strong class="phc-stat-value is-low">{currency.format(min)}</strong>
      </div>
      <div class="phc-stat">
        <span class="phc-stat-label">Máximo</span>
        <strong class="phc-stat-value is-high">{currency.format(max)}</strong>
      </div>
      <div class="phc-stat">
        <span class="phc-stat-label">Lecturas</span>
        <strong class="phc-stat-value">{n} días</strong>
      </div>
    </div>

    <div class="phc-chart">
      <svg viewBox={`0 0 ${W} ${H}`} role="img"
        aria-label={`Evolución del precio: de ${currency.format(min)} a ${currency.format(max)} en ${n} lecturas`}
        preserveAspectRatio="none">
        <defs>
          <linearGradient id="phcFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.34" />
            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.02" />
          </linearGradient>
        </defs>
        <path d={areaPath} fill="url(#phcFill)" />
        <path d={linePath} fill="none" stroke="#60a5fa" stroke-width="2.5" stroke-linejoin="round"
          stroke-linecap="round" vector-effect="non-scaling-stroke" />
        {valid.map((p, i) => (
          <circle cx={xAt(i)} cy={yAt(p.price)} r={n > 60 ? 0 : 3} fill="#0d1422" stroke="#60a5fa"
            stroke-width="2">
            <title>{`${shortDate.format(parseDate(p.date))}: ${currency.format(p.price)}`}</title>
          </circle>
        ))}
        <circle cx={xAt(maxIndex)} cy={yAt(max)} r="4.5" fill="#fbbf24" />
        <circle cx={xAt(minIndex)} cy={yAt(min)} r="4.5" fill="#34d399" />
      </svg>
      <div class="phc-axis">
        <span>{first ? shortDate.format(parseDate(first.date)) : ''}</span>
        <span>{last ? shortDate.format(parseDate(last.date)) : ''}</span>
      </div>
    </div>

    <p class="phc-footnote">
      Lectura diaria automática del precio publicado. Última actualización:
      {last ? shortDate.format(parseDate(last.date)) : 'hoy'} · el precio final lo confirma la tienda.
    </p>
  </section>
) : (
  <section class="phc phc-pending" aria-label="Histórico de precio">
    <p class="phc-kicker">Seguimiento de precio</p>
    <p class="phc-pending-text">
      Precio verificado hoy: <strong>{currency.format(currentPrice)}</strong>.
      Estamos registrando el histórico; en cuanto haya 3 lecturas verás aquí la gráfica de evolución.
    </p>
  </section>
)}

<style>
  .phc {
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(96, 165, 250, 0.18);
    border-radius: 16px;
    padding: 1.25rem 1.35rem;
  }

  .phc-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .phc-kicker {
    margin: 0 0 0.25rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #60a5fa;
  }

  .phc-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-text-main);
  }

  .phc-delta {
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    color: #9ca3af;
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(148, 163, 184, 0.3);
    white-space: nowrap;
  }

  .phc-delta.is-down {
    color: #6ee7b7;
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.4);
  }

  .phc-delta.is-up {
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.4);
  }

  .phc-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .phc-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0.7rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    min-width: 0;
  }

  .phc-stat-label {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
  }

  .phc-stat-value {
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--color-text-main);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .phc-stat-value.is-low {
    color: #34d399;
  }

  .phc-stat-value.is-high {
    color: #fbbf24;
  }

  .phc-chart {
    width: 100%;
  }

  .phc-chart svg {
    display: block;
    width: 100%;
    height: 170px;
    background: rgba(2, 6, 23, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
  }

  .phc-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.35rem;
    font-size: 0.7rem;
    color: #94a3b8;
  }

  .phc-footnote {
    margin: 0.85rem 0 0;
    font-size: 0.72rem;
    line-height: 1.5;
    color: #94a3b8;
  }

  .phc-pending {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .phc-pending-text {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: #9ca3af;
  }

  .phc-pending-text strong {
    color: var(--color-text-main);
  }

  @media (max-width: 640px) {
    .phc {
      padding: 1.1rem;
    }

    .phc-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
