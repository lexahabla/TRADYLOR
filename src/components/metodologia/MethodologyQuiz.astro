---

<div class:list={['quiz', { 'quiz--compact': compact }]} data-quiz>
  <div class="quiz-progress" data-quiz-progress>
    {steps.map((step, i) => (
      <div class="quiz-step-indicator" data-step-indicator={i}>
        <span class="quiz-step-number">{i + 1}</span>
        <span class="quiz-step-name">{step.title.split(' ').slice(0, 2).join(' ')}</span>
      </div>
    ))}
  </div>

  <div class="quiz-body">
    {steps.map((step, i) => (
      <div
        class="quiz-step"
        data-quiz-step={i}
        hidden={i !== 0}
      >
        <h3 class="quiz-step-title">{step.title}</h3>
        <p class="quiz-step-subtitle">{step.subtitle}</p>
        <div class="quiz-options">
          {step.options.map((opt) => (
            <button
              type="button"
              class="quiz-option"
              data-quiz-option={step.id}
              data-value={opt.value}
            >
              <span class="quiz-option-label">{opt.label}</span>
              <span class="quiz-option-desc">{opt.desc}</span>
            </button>
          ))}
        </div>
      </div>
    ))}

    <div class="quiz-result" data-quiz-result hidden>
      <div class="quiz-result-badge" data-result-badge></div>
      <h3 class="quiz-result-title" data-result-title></h3>
      <p class="quiz-result-desc" data-result-desc></p>
      <div class="quiz-result-products" data-result-products></div>
      <button type="button" class="quiz-restart" data-quiz-restart>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        Empezar de nuevo
      </button>
    </div>
  </div>
</div>

<style>
  .quiz {
    background: linear-gradient(160deg, rgba(59, 130, 246, 0.06) 0%, rgba(17, 24, 39, 0.8) 100%);
    border: 1px solid rgba(59, 130, 246, 0.18);
    border-radius: 20px;
    padding: 2rem;
  }

  .quiz--compact {
    padding: 1.5rem;
  }

  .quiz-progress {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .quiz-step-indicator {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .quiz-step-indicator.is-active {
    border-color: rgba(59, 130, 246, 0.5);
    background: rgba(59, 130, 246, 0.1);
  }

  .quiz-step-indicator.is-done {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.08);
  }

  .quiz-step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.72rem;
    font-weight: 800;
    flex-shrink: 0;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .quiz-step-indicator.is-active .quiz-step-number {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: #ffffff;
  }

  .quiz-step-indicator.is-done .quiz-step-number {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #ffffff;
  }

  .quiz-step-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .quiz-step-indicator.is-active .quiz-step-name {
    color: #93c5fd;
  }

  .quiz-step-indicator.is-done .quiz-step-name {
    color: #6ee7b7;
  }

  .quiz-step-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.35rem;
  }

  .quiz-step-subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.95rem;
    margin: 0 0 1.5rem;
  }

  .quiz-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .quiz-option {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }

  .quiz-option:hover {
    border-color: rgba(59, 130, 246, 0.5);
    background: rgba(59, 130, 246, 0.08);
    transform: translateY(-2px);
  }

  .quiz-option-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
  }

  .quiz-option-desc {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.4;
  }

  .quiz-result {
    text-align: center;
    padding: 1rem 0;
  }

  .quiz-result-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #052e22;
    background: linear-gradient(135deg, #34d399, #10b981);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .quiz-result-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.75rem;
  }

  .quiz-result-desc {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 560px;
    margin: 0 auto 1.5rem;
  }

  .quiz-result-products {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .quiz-result-product {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 999px;
    color: #93c5fd;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .quiz-result-product:hover {
    background: #2563eb;
    color: #ffffff;
  }

  .quiz-restart {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.2rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.7);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .quiz-restart:hover {
    border-color: rgba(59, 130, 246, 0.5);
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .quiz {
      padding: 1.25rem;
    }

    .quiz-progress {
      flex-direction: column;
      gap: 0.4rem;
    }

    .quiz-options {
      grid-template-columns: 1fr;
    }

    .quiz-step-title {
      font-size: 1.15rem;
    }

    .quiz-result-title {
      font-size: 1.3rem;
    }
  }
</style>

