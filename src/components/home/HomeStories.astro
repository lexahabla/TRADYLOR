---
/**
 * Portada editable (etapa 6): historias publicadas (círculos + visor 9:16 de la maqueta v3).
 * Sólo recibe historias ya filtradas por `buildPublicHome()` (publicadas, sin errores, imágenes verificadas, destinos públicos).
 * Visor = <dialog> nativo (foco atrapado, Esc, retorno del foco), toques izquierda/derecha, teclado ← →, barras de progreso, pausa al
 * mantener pulsado y con la pestaña oculta; con «reducir movimiento» no avanza solo. Sin redes sociales ni analítica.
 */
import type { PublicStory } from '../../lib/homeLayout/public';

interface Props {
  stories: PublicStory[];
}
const { stories } = Astro.props as Props;
// Los datos viajan escapados en un bloque JSON (sin HTML interpretable).
const json = JSON.stringify(stories).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---

{stories.length > 0 && (
  <section class="hs-root" aria-label="Historias" data-home-stories>
    <div class="container">
      <ul class="hs-circles">
        {stories.map((s, i) => (
          <li>
            <button type="button" class="hs-circle" data-story-open={i} aria-label={`Ver historia: ${s.name}`}>
              <span class="hs-ring"><img src={s.cover} alt="" width="64" height="64" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></span>
              <span class="hs-name">{s.name}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <dialog class="hs-viewer" aria-label="Visor de historias" data-story-viewer>
      <div class="hs-phone" data-story-phone>
        <div class="hs-bars" data-story-bars aria-hidden="true"></div>
        <div class="hs-head">
          <img class="hs-avatar" data-story-avatar alt="" width="32" height="32" referrerpolicy="no-referrer" />
          <strong class="hs-hname" data-story-name></strong>
          <button type="button" class="hs-close" data-story-close aria-label="Cerrar historias">✕</button>
        </div>
        <img class="hs-bg" data-story-image alt="" referrerpolicy="no-referrer" />
        <button type="button" class="hs-tap hs-prev" data-story-prev aria-label="Pantalla anterior"></button>
        <button type="button" class="hs-tap hs-next" data-story-next aria-label="Pantalla siguiente"></button>
        <div class="hs-cap">
          <h3 class="hs-title" data-story-title></h3>
          <p class="hs-text" data-story-text></p>
          <a class="hs-btn" data-story-link href="#"></a>
        </div>
        <p class="hs-live" data-story-live role="status" aria-live="polite"></p>
      </div>
    </dialog>
    <script type="application/json" id="home-stories-data" set:html={json}></script>
  </section>
)}

<style is:global>
  .hs-root { padding: 1.25rem 0 0; }
  .hs-circles { list-style: none; margin: 0; padding: 0.25rem 0 0.5rem; display: flex; gap: 1rem; overflow-x: auto; scrollbar-width: thin; }
  .hs-circle { display: grid; justify-items: center; gap: 0.35rem; width: 76px; min-height: 44px; background: transparent; border: 0; padding: 0; cursor: pointer; color: #e2e8f0; font: inherit; }
  .hs-ring { display: block; width: 68px; height: 68px; border-radius: 50%; padding: 3px; background: conic-gradient(#f59e0b, #ec4899, #8b5cf6, #3b82f6, #f59e0b); }
  .hs-ring img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid #0b1220; background: #111827; display: block; }
  .hs-name { font-size: 0.75rem; max-width: 76px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hs-circle:focus-visible, .hs-close:focus-visible, .hs-btn:focus-visible, .hs-tap:focus-visible { outline: 3px solid #fbbf24; outline-offset: 2px; }
  .hs-viewer { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100dvh; width: 100%; height: 100%; margin: 0; overflow: hidden; }
  .hs-viewer:not([open]) { display: none; }
  .hs-viewer[open] { display: grid; place-items: center; }
  .hs-viewer::backdrop { background: rgba(2, 6, 23, 0.9); }
  .hs-phone { position: relative; width: min(420px, 100vw); height: min(100dvh, calc(min(420px, 100vw) * 16 / 9)); max-height: 100dvh; aspect-ratio: 9 / 16; border-radius: 20px; overflow: hidden; background: #0b1220; color: #fff; border: 1px solid #334155; }
  .hs-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hs-bars { position: absolute; top: 8px; left: 10px; right: 10px; display: flex; gap: 4px; z-index: 4; }
  .hs-bars i { flex: 1; height: 3px; border-radius: 2px; background: rgba(255, 255, 255, 0.35); overflow: hidden; }
  .hs-bars i b { display: block; height: 100%; width: 0; background: #fff; }
  .hs-bars i.is-done b { width: 100%; }
  .hs-head { position: absolute; top: 18px; left: 10px; right: 10px; z-index: 5; display: flex; align-items: center; gap: 0.6rem; text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8); }
  .hs-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; }
  .hs-hname { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.9rem; }
  .hs-close { width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(2, 6, 23, 0.55); color: #fff; font-size: 1.1rem; cursor: pointer; }
  .hs-tap { position: absolute; top: 70px; bottom: 150px; width: 38%; background: transparent; border: 0; z-index: 3; cursor: pointer; }
  .hs-prev { left: 0; } .hs-next { right: 0; }
  .hs-cap { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; padding: 3rem 1.1rem 1.4rem; background: linear-gradient(transparent, rgba(0, 0, 0, 0.86)); display: grid; gap: 0.5rem; }
  .hs-title { margin: 0; font-family: var(--font-heading); font-size: 1.3rem; }
  .hs-text { margin: 0; font-size: 0.95rem; opacity: 0.95; }
  .hs-text:empty, .hs-title:empty { display: none; }
  .hs-btn { justify-self: start; display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.25rem; border-radius: 999px; background: #fff; color: #0b1220; font-weight: 800; text-decoration: none; }
  .hs-btn[hidden] { display: none; }
  .hs-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 640px) { .hs-phone { width: 100vw; height: 100dvh; max-height: none; border-radius: 0; border: 0; aspect-ratio: auto; } .hs-circle { width: 68px; } }
</style>

<script>
  type Screen = { image: string; title: string; text?: string; buttonLabel?: string; href?: string; duration: number };
  type Story = { id: string; name: string; cover: string; screens: Screen[] };

  const root = document.querySelector<HTMLElement>('[data-home-stories]');
  const dataEl = document.getElementById('home-stories-data');
  if (root && dataEl) {
    let stories: Story[] = [];
    try {
      stories = JSON.parse(dataEl.textContent || '[]');
    } catch {
      stories = [];
    }
    const dlg = root.querySelector<HTMLDialogElement>('[data-story-viewer]');
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const bars = $('[data-story-bars]');
    const img = $<HTMLImageElement>('[data-story-image]');
    const avatar = $<HTMLImageElement>('[data-story-avatar]');
    const nameEl = $('[data-story-name]');
    const titleEl = $('[data-story-title]');
    const textEl = $('[data-story-text]');
    const link = $<HTMLAnchorElement>('[data-story-link]');
    const live = $('[data-story-live]');
    const phone = $('[data-story-phone]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let si = 0;
    let pi = 0;
    let timer: number | null = null;
    let started = 0;
    let remaining = 0;
    let held = false;

    const stop = () => {
      if (timer !== null) window.clearTimeout(timer);
      timer = null;
    };
    const fill = (ms: number) => {
      const cur = bars?.children[pi]?.querySelector<HTMLElement>('b');
      if (!cur) return;
      cur.style.transition = 'none';
      cur.style.width = '0';
      void cur.offsetWidth;
      if (!reduce) {
        cur.style.transition = `width ${ms}ms linear`;
        cur.style.width = '100%';
      }
    };
    const schedule = (ms: number) => {
      stop();
      if (reduce) return; // «reducir movimiento»: sólo avance manual
      started = Date.now();
      remaining = ms;
      timer = window.setTimeout(() => next(), ms);
    };
    const render = () => {
      const s = stories[si];
      const sc = s?.screens[pi];
      if (!s || !sc || !img) return;
      if (bars) {
        bars.replaceChildren();
        s.screens.forEach((_, i) => {
          const el = document.createElement('i');
          el.className = i < pi ? 'is-done' : '';
          el.appendChild(document.createElement('b'));
          bars.appendChild(el);
        });
      }
      img.src = sc.image;
      img.onerror = () => {
        img.removeAttribute('src');
      };
      if (avatar) avatar.src = s.cover;
      if (nameEl) nameEl.textContent = s.name;
      if (titleEl) titleEl.textContent = sc.title || '';
      if (textEl) textEl.textContent = sc.text || '';
      if (link) {
        if (sc.href && sc.buttonLabel) {
          link.hidden = false;
          link.href = sc.href;
          link.textContent = sc.buttonLabel;
        } else {
          link.hidden = true;
          link.removeAttribute('href');
        }
      }
      if (live) live.textContent = `${s.name}: pantalla ${pi + 1} de ${s.screens.length}${sc.title ? `. ${sc.title}` : ''}`;
      fill(sc.duration * 1000);
      schedule(sc.duration * 1000);
    };
    const close = () => {
      stop();
      if (dlg?.open) dlg.close();
    };
    function next() {
      const s = stories[si];
      if (pi < s.screens.length - 1) {
        pi++;
        render();
      } else if (si < stories.length - 1) {
        si++;
        pi = 0;
        render();
      } else close();
    }
    const prev = () => {
      if (pi > 0) pi--;
      else if (si > 0) {
        si--;
        pi = stories[si].screens.length - 1;
      }
      render();
    };
    const hold = (on: boolean) => {
      if (on === held || reduce) return;
      held = on;
      const cur = bars?.children[pi]?.querySelector<HTMLElement>('b');
      if (on) {
        remaining = Math.max(200, remaining - (Date.now() - started));
        stop();
        if (cur) {
          const w = cur.getBoundingClientRect().width / (cur.parentElement?.getBoundingClientRect().width || 1);
          cur.style.transition = 'none';
          cur.style.width = `${Math.round(w * 100)}%`;
        }
      } else {
        if (cur) {
          cur.style.transition = `width ${remaining}ms linear`;
          cur.style.width = '100%';
        }
        schedule(remaining);
      }
    };

    root.querySelectorAll<HTMLElement>('[data-story-open]').forEach((b) =>
      b.addEventListener('click', () => {
        si = Number(b.getAttribute('data-story-open')) || 0;
        pi = 0;
        if (dlg && !dlg.open) dlg.showModal();
        render();
      }),
    );
    $('[data-story-close]')?.addEventListener('click', close);
    $('[data-story-next]')?.addEventListener('click', next);
    $('[data-story-prev]')?.addEventListener('click', prev);
    dlg?.addEventListener('close', stop);
    dlg?.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
    dlg?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        next();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prev();
      }
    });
    phone?.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('a,button')) return;
      hold(true);
    });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach((t) => phone?.addEventListener(t, () => hold(false)));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) hold(true);
      else if (dlg?.open) hold(false);
    });
  }
</script>
