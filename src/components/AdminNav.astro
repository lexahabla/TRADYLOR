---
import type { PublicUser } from '../lib/userStore';

interface Props {
  context: 'catalogo' | 'usuario';
  active: string;
  user: PublicUser;
}

const { context, active, user } = Astro.props;

const catalogItems = [
  { id: 'products', label: 'Añadir productos' },
  { id: 'affiliates', label: 'Afiliados' },
  { id: 'categories', label: 'Categorías' },
  { id: 'analytics', label: 'Tráfico y ventas' },
  { id: 'marketing', label: 'Marketing' },
];

const userItems = [
  { id: 'perfil', label: 'Mi perfil', href: '/admin/perfil' },
  ...(user.role === 'admin' ? [{ id: 'usuarios', label: 'Crear usuarios', href: '/admin/usuarios' }] : []),
];

const items = context === 'catalogo' ? catalogItems : userItems;
const roleLabel = user.master ? 'Master' : user.role === 'admin' ? 'Admin' : 'Usuario';
const avatarUrl = user.avatar ? `/api/admin/users/${user.id}/avatar?v=${encodeURIComponent(user.updatedAt)}` : null;
const initial = (user.name || user.username).trim().charAt(0).toUpperCase();
---

<nav class="admin-section-nav" aria-label="Navegación del backend">
  {context === 'usuario' && (
    <a class="admin-back-btn" href="/admin" title="Volver al panel">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Salir
    </a>
  )}

  <button type="button" class="admin-nav-toggle" id="adminNavToggle" aria-expanded="false" aria-controls="adminNavLinks" aria-label="Abrir menú de secciones">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    <span>Secciones</span>
  </button>

  <div class="admin-nav-links" id="adminNavLinks">
    {items.map((item) => (
      <a
        class:list={['admin-nav-item', { 'is-active': active === item.id }]}
        href={'href' in item ? item.href : `/admin?section=${item.id}`}
        data-admin-tab={item.id}
      >{item.label}</a>
    ))}
  </div>

  <div class="user-menu" id="userMenu">
    <button type="button" class="user-menu-btn" id="userMenuBtn" aria-haspopup="menu" aria-expanded="false" title={user.name || user.username} aria-label="Menú de usuario">
      {avatarUrl ? (
        <img class="user-avatar" src={avatarUrl} alt="" />
      ) : (
        <span class="user-avatar user-avatar-initial" aria-hidden="true">{initial}</span>
      )}
      <svg class="user-menu-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>

    <div class="user-menu-dropdown" id="userMenuDropdown" role="menu">
      <div class="user-menu-header">
        <strong class="user-menu-name">{user.name || user.username}</strong>
        <span class:list={['user-menu-role', `is-${user.master ? 'master' : user.role}`]}>{roleLabel}</span>
      </div>
      <a class="user-menu-link" href="/admin/perfil" role="menuitem">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        Perfil
      </a>
      {user.role === 'admin' && (
        <a class:list={['user-menu-link', { 'is-active': active === 'usuarios' }]} href="/admin/usuarios" role="menuitem">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
          Crear usuarios
        </a>
      )}
      <form method="post" action="/admin" class="user-menu-logout-form">
        <input type="hidden" name="action" value="logout" />
        <button type="submit" class="user-menu-link user-menu-logout" role="menuitem">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          Cerrar sesión
        </button>
      </form>
    </div>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Menú responsive: despliega las secciones en pantallas estrechas
    const navToggle = document.getElementById('adminNavToggle');
    const navLinks = document.getElementById('adminNavLinks');
    navToggle?.addEventListener('click', () => {
      const isOpen = navLinks?.classList.toggle('is-open');
      navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
    navLinks?.addEventListener('click', (event) => {
      if (event.target.closest('.admin-nav-item')) {
        navLinks.classList.remove('is-open');
        navToggle?.setAttribute('aria-expanded', 'false');
      }
    });

    // Desplegable del usuario (foto de perfil)
    const menu = document.getElementById('userMenu');
    const menuBtn = document.getElementById('userMenuBtn');
    const menuDropdown = document.getElementById('userMenuDropdown');
    const closeMenu = () => {
      menuDropdown?.classList.remove('is-open');
      menuBtn?.setAttribute('aria-expanded', 'false');
    };
    menuBtn?.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = menuDropdown?.classList.toggle('is-open');
      menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
    document.addEventListener('click', (event) => {
      if (menu && !menu.contains(event.target)) closeMenu();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
  });
</script>

<style>
  .admin-section-nav { position: relative; display: flex; align-items: center; gap: .5rem; padding: .65rem; background: rgba(17, 24, 39, .65); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); }

  /* Botón "Salir" (vuelve al panel) en las páginas de perfil y usuarios */
  .admin-back-btn { display: inline-flex; align-items: center; gap: .45rem; padding: .7rem .9rem; flex-shrink: 0; color: var(--color-text-muted); background: rgba(255, 255, 255, .03); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font-size: .82rem; font-weight: 700; text-decoration: none; transition: all .2s ease; }
  .admin-back-btn:hover { color: var(--color-text-main); background: rgba(59, 130, 246, .13); border-color: rgba(96, 165, 250, .3); }

  .admin-nav-links { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; flex: 1; min-width: 0; }
  .admin-nav-toggle { display: none; align-items: center; gap: .45rem; padding: .6rem .8rem; color: var(--color-text-muted); background: transparent; border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-size: .82rem; font-weight: 700; }
  .admin-nav-toggle:hover { color: var(--color-text-main); border-color: rgba(96, 165, 250, .3); }
  .admin-nav-item { display: inline-flex; padding: .7rem .9rem; color: var(--color-text-muted); background: transparent; border: 1px solid transparent; border-radius: var(--border-radius-sm); cursor: pointer; font: inherit; font-size: .82rem; font-weight: 700; text-decoration: none; }
  .admin-nav-item:hover, .admin-nav-item.is-active { color: var(--color-text-main); background: rgba(59, 130, 246, .13); border-color: rgba(96, 165, 250, .3); }

  /* Menú de usuario a la derecha: foto redonda + desplegable (perfil / crear usuarios / salir) */
  .user-menu { position: relative; margin-left: auto; flex-shrink: 0; }
  .user-menu-btn { display: inline-flex; align-items: center; gap: .35rem; padding: .3rem; background: rgba(255, 255, 255, .04); border: 1px solid var(--color-border); border-radius: 999px; cursor: pointer; transition: border-color .2s ease, background .2s ease; }
  .user-menu-btn:hover, .user-menu-btn[aria-expanded='true'] { background: rgba(59, 130, 246, .12); border-color: rgba(96, 165, 250, .4); }
  .user-avatar { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; object-fit: cover; background: linear-gradient(135deg, #3b82f6, #60a5fa); color: #fff; font-size: .85rem; font-weight: 800; }
  .user-menu-chevron { color: var(--color-text-muted); margin-right: .3rem; transition: transform .2s ease; }
  .user-menu-btn[aria-expanded='true'] .user-menu-chevron { transform: rotate(180deg); }

  .user-menu-dropdown { display: none; position: absolute; top: calc(100% + .55rem); right: 0; min-width: 240px; padding: .4rem; background: rgba(13, 19, 33, .97); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); box-shadow: 0 18px 40px rgba(0, 0, 0, .45); z-index: 70; }
  .user-menu-dropdown.is-open { display: block; }
  .user-menu-header { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .6rem .65rem .65rem; border-bottom: 1px solid var(--color-border); margin-bottom: .35rem; }
  .user-menu-name { color: var(--color-text-main); font-size: .84rem; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .user-menu-role { flex-shrink: 0; padding: .18rem .5rem; border-radius: 999px; font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--color-text-dim); background: rgba(255, 255, 255, .05); border: 1px solid var(--color-border); }
  .user-menu-role.is-admin { color: #93c5fd; background: rgba(59, 130, 246, .12); border-color: rgba(96, 165, 250, .3); }
  .user-menu-role.is-master { color: #fbbf24; background: rgba(245, 158, 11, .1); border-color: rgba(245, 158, 11, .3); }
  .user-menu-link { display: flex; align-items: center; gap: .6rem; width: 100%; padding: .6rem .65rem; color: var(--color-text-muted); background: transparent; border: 0; border-radius: var(--border-radius-sm); font: inherit; font-size: .8rem; font-weight: 700; text-align: left; text-decoration: none; cursor: pointer; }
  .user-menu-link:hover, .user-menu-link.is-active { color: var(--color-text-main); background: rgba(59, 130, 246, .13); }
  .user-menu-logout-form { margin-top: .35rem; padding-top: .35rem; border-top: 1px solid var(--color-border); }
  .user-menu-logout { color: #fca5a5; }
  .user-menu-logout:hover { color: #fecaca; background: rgba(239, 68, 68, .13); }

  @media (max-width: 900px) {
    .admin-nav-toggle { display: inline-flex; }
    .admin-nav-links { display: none; position: absolute; top: calc(100% + .5rem); left: 0; right: 0; flex-direction: column; align-items: stretch; padding: .65rem; background: rgba(13, 19, 33, .97); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); box-shadow: 0 18px 40px rgba(0, 0, 0, .45); z-index: 60; }
    .admin-nav-links.is-open { display: flex; }
    .admin-nav-item { white-space: normal; width: 100%; }
    .admin-back-btn { padding: .6rem .75rem; }
  }
</style>
