---
import type { Product } from '../data/products';

export interface Props {
  product: Product;
}

const { product } = Astro.props;

const compactText = (text: string, maxLength: number) => {
  const normalized = text.replace(/\s+/g, ' ').trim();
  return normalized.length > maxLength ? `${normalized.slice(0, maxLength).trimEnd()}…` : normalized;
};

const cleanMarketplaceSuffix = (text: string) => text.replace(/\s*[\-|:]\s*(Amazon(?:\.es)?|PcComponentes|El Corte Inglés|MediaMarkt|Fnac|AliExpress|Carrefour|Apple).*$/i, '').trim();
const catalogDescription = compactText(cleanMarketplaceSuffix(product.description), 118);
const catalogTitle = compactText(cleanMarketplaceSuffix(product.title), 68);
const catalogPros = product.pros.slice(0, 1).map((pro) => compactText(pro, 82));
const catalogCons = product.cons.slice(0, 1).map((con) => compactText(con, 72));

// Cálculo de porcentaje de descuento si existe precio original
const discountPercent = product.originalPrice
  ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
  : null;

// Formateo de precio en formato moneda EUR
const formatCurrency = (amount: number) => {
  return new Intl.NumberFormat('es-ES', {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: 2,
  }).format(amount);
};
---

<article class="product-card" id={`product-${product.id}`}>
  <!-- Contenedor Visual del Producto -->
  <div class="image-wrapper">
    <img
      src={product.image}
      alt={`Fotografía y análisis técnico de ${product.title}`}
      loading="lazy"
      class="product-image"
      width="400"
      height="260"
    />
    {discountPercent !== null && discountPercent > 0 && (
      <span class="discount-pill" aria-label={`Descuento del ${discountPercent}%`}>
        -{discountPercent}%
      </span>
    )}
  </div>

  <!-- Contenido Editorial & Especificaciones -->
  <div class="card-content">
    <div class="category-meta">
      <span class="category-label">{product.category}</span>
      {product.rating && (
        <div class="rating-box" aria-label={`Puntuación: ${product.rating} sobre 5`}>
          <svg class="star-icon" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span class="rating-value">{product.rating.toFixed(1)}</span>
          {product.reviewsCount && <span class="reviews-count">({product.reviewsCount})</span>}
        </div>
      )}
    </div>

    <h3 class="product-title">
      <!-- Enlace a la página de detalle propia de Tradylor (no al afiliado directamente) -->
      <a
        href={`/producto/${product.id}`}
        title={`Análisis completo de ${product.title}`}
      >
        {catalogTitle}
      </a>
    </h3>

    <p class="product-summary">{catalogDescription}</p>

    <!-- Bloque de Pros y Contras estructurado para alta conversión -->
    <div class="analysis-box">
      <div class="pros-list">
        <h4 class="analysis-title pros-title">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Puntos Fuertes
        </h4>
        <ul>
          {catalogPros.map((pro) => (
            <li>
              <span class="bullet pro-bullet">✓</span>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="cons-list">
        <h4 class="analysis-title cons-title">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          A Mejorar
        </h4>
        <ul>
          {catalogCons.map((con) => (
            <li>
              <span class="bullet con-bullet">✕</span>
              <span>{con}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

  </div>

  <!-- Pie de la Tarjeta: Precio, CTA y Transparencia -->
  <div class="card-footer">
    <div class="price-container">
      <span class="price-label">Precio verificado:</span>
      <div class="price-numbers">
        <span class="main-price">{formatCurrency(product.price)}</span>
        {product.originalPrice && (
          <span class="original-price">{formatCurrency(product.originalPrice)}</span>
        )}
      </div>
    </div>

    <button
      type="button"
      class="affiliate-cta-btn add-to-cart-btn"
      id={`cta-btn-${product.id}`}
      aria-label={`Añadir ${product.title} al carrito`}
      data-product={JSON.stringify({ id: product.id, title: product.title, price: product.price, image: product.image })}
    >
      <span>Añadir al carrito</span>
      <svg class="external-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
        <path d="M3 6h18"></path>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
    </button>

    <!-- Microcopia de confianza -->
    <div class="trust-guarantee">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>Compra segura en el sitio de destino</span>
    </div>
  </div>
</article>

<style>
  /* ============ PRODUCT CARD - PREMIUM DESIGN ============ */
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: linear-gradient(135deg, rgba(17, 24, 39, 0.7) 0%, rgba(30, 41, 59, 0.5) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: all 0.35s cubic-bezier(0.23, 1, 0.320, 1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .product-card:hover {
    transform: translateY(-8px);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 24px 64px rgba(59, 130, 246, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* ============ IMAGE SECTION ============ */
  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(135deg, #0a0e17 0%, #111827 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 16px;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.320, 1);
  }

  .product-card:hover .product-image {
    transform: scale(1.08);
  }

  .discount-pill {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 800;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(239, 68, 68, 0.4);
    animation: slideDown 0.4s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ============ CONTENT SECTION ============ */
  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
    gap: 1rem;
  }

  .category-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .category-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: #60a5fa;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 0.8rem;
    background: rgba(96, 165, 250, 0.1);
    border-radius: 8px;
    border: 1px solid rgba(96, 165, 250, 0.2);
  }

  .rating-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #fbbf24;
  }

  .star-icon {
    width: 16px;
    height: 16px;
    filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.5));
  }

  .rating-value {
    font-weight: 700;
    color: #fbbf24;
  }

  .reviews-count {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
  }

  .product-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    line-height: 1.3;
    min-height: 2.6em;
    margin: 0;
  }

  .product-title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .product-title a:hover {
    color: #60a5fa;
  }

  .product-summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
    margin: 0;
  }

  /* ============ ANALYSIS BOX (PROS/CONS) ============ */
  .analysis-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: rgba(10, 14, 23, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1rem;
    backdrop-filter: blur(8px);
  }

  .analysis-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .pros-title {
    color: #10b981;
  }

  .cons-title {
    color: #f87171;
  }

  .analysis-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .analysis-box li {
    font-size: 0.8rem;
    line-height: 1.4;
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .bullet {
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pro-bullet {
    color: #10b981;
  }

  .con-bullet {
    color: #f87171;
  }

  /* ============ FOOTER SECTION ============ */
  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(10, 14, 23, 0.3);
  }

  .price-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .price-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .price-numbers {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .main-price {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .original-price {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: line-through;
  }

  /* ============ CTA BUTTON ============ */
  .affiliate-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.875rem 1.5rem;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.320, 1);
    box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
    position: relative;
    overflow: hidden;
  }

  .affiliate-cta-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s ease;
  }

  .affiliate-cta-btn:hover::before {
    left: 100%;
  }

  .affiliate-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(59, 130, 246, 0.5);
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
  }

  .affiliate-cta-btn:active {
    transform: translateY(0);
  }

  .external-icon {
    transition: transform 0.3s ease;
  }

  .affiliate-cta-btn:hover .external-icon {
    transform: translate(3px, -3px);
  }

  /* ============ TRUST GUARANTEE ============ */
  .trust-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .trust-guarantee svg {
    color: rgba(16, 185, 129, 0.6);
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 640px) {
    .product-card {
      border-radius: 16px;
    }

    .image-wrapper {
      aspect-ratio: 16 / 9;
      padding: 1rem;
    }

    .product-title {
      font-size: 1rem;
    }

    .card-content,
    .card-footer {
      padding: 1rem;
    }

    .main-price {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .product-card {
      border-radius: 12px;
    }

    .category-meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .price-numbers {
      flex-direction: column;
      gap: 0.25rem;
    }

    .affiliate-cta-btn {
      padding: 0.75rem 1rem;
      font-size: 0.9rem;
    }
  }
</style>
