---
import type { Product } from '../data/products';
import { getAffiliateUrl, NETWORK_LABELS, type AffiliateNetwork } from '../utils/affiliate';
import TestProofBadge from './TestProofBadge.astro';
import {
  extractAsinFromUrl,
  getAmazonAddToCartUrl,
  isValidAsin,
  sanitizeAsin,
} from '../utils/amazon';

/**
 * Tres modos de uso:
 *  1. Catálogo interno: <ProductCard product={product} />
 *     (flujo Tradylor: tarjeta → ficha → pantalla puente → /api/redirect).
 *  2. Modo híbrido Amazon: <ProductCard amazonInput={urlOrAsin} title=… price=… image=… />
 *     `amazonInput` admite una URL de Amazon o un ASIN directo de 10 caracteres;
 *     el CTA se construye con getAmazonAddToCartUrl() (cesta con la tag de afiliado).
 *  3. Salida directa al afiliado: props planas (title, asin|customUrl, network…).
 *     El CTA es un <a class="exit-cta"> target="_blank" rel="nofollow sponsored…"
 *     que sale directo al enlace de la red (tracking delegado en Layout.astro).
 *
 * Diseño híbrido adaptativo (todas las tarjetas):
 *   <768px  → disposición horizontal estilo lista de Amazon móvil: imagen fija
 *             (158×158) a la izquierda; título, precio, badges y botones a la derecha.
 *   ≥768px  → disposición vertical clásica para los grids de varias columnas.
 */
export interface Props {
  /** Compat: objeto producto del catálogo interno. */
  product?: Product;
  /** Modo directo: título del producto (se muestra con line-clamp-2). */
  title?: string;
  /** Modo directo: ASIN de Amazon (alternativa a customUrl). */
  asin?: string;
  /** Modo híbrido: URL de Amazon o ASIN directo de 10 caracteres. */
  amazonInput?: string;
  /** Modo directo: enlace base de la red (para aliexpress/awin/impact/ebay). */
  customUrl?: string;
  /** Modo directo: red de afiliación (por defecto 'amazon'). */
  network?: AffiliateNetwork;
  /** Modo directo: precio ya formateado (p. ej. "29,99 €"). */
  price?: string;
  /** Modo directo: URL de la imagen. */
  image?: string;
  /** Modo directo: etiqueta destacada (p. ej. "Más vendido", "Oferta"). */
  badge?: string;
  /** Puntuación opcional del modo plano (p. ej. 4.8). */
  rating?: number | string;
  /**
   * 'compact' fuerza la disposición horizontal de móvil (<768px, estilo lista
   * Amazon) sin depender del ancho del viewport: usado por el carrusel de
   * ofertas del hero para que cada tarjeta ocupe mucho menos alto en escritorio.
   */
  layout?: 'grid' | 'compact';
}

const {
  product,
  title,
  asin,
  customUrl,
  network = 'amazon',
  price,
  image,
  badge,
  amazonInput,
  rating,
  layout = 'grid',
} = Astro.props;

// Modo híbrido: amazonInput (URL de Amazon o ASIN) habilita la salida directa.
const amazonPayload = (amazonInput ?? '').trim();
const hybridMode = Boolean(amazonPayload);
// Modo salida directa: sin objeto product y con algo que enlazar.
const directMode = !product && (hybridMode || Boolean((customUrl || asin || '').trim()));

// Modo híbrido: se normaliza a ASIN (si es URL se extrae del path /dp/…) y se
// pide la cesta de Amazon con la tag de afiliado. Si no hay ASIN válido se
// respeta la URL tal cual (best effort con tag vía getAffiliateUrl).
const extractedAsin = hybridMode
  ? (extractAsinFromUrl(amazonPayload) || (isValidAsin(amazonPayload) ? sanitizeAsin(amazonPayload) : ''))
  : '';
const exitHref = hybridMode
  ? (getAmazonAddToCartUrl(extractedAsin || amazonPayload) || getAffiliateUrl('amazon', amazonPayload))
  : directMode
    ? getAffiliateUrl(network, (customUrl || asin || '').trim())
    : '';
const directTitle = (title || '').trim();
const networkLabel = NETWORK_LABELS[network] ?? network;
const ctaLabel = hybridMode ? 'Comprar' : `Comprar en ${networkLabel}`;

// Rating del modo plano (number | string); sólo se pinta si se proporciona.
const flatRating =
  rating !== undefined && rating !== null && String(rating).trim() !== ''
    ? String(rating)
    : '';

const compactText = (text: string, maxLength: number) => {
  const normalized = text.replace(/\s+/g, ' ').trim();
  return normalized.length > maxLength ? `${normalized.slice(0, maxLength).trimEnd()}…` : normalized;
};

const cleanMarketplaceSuffix = (text: string) => text.replace(/\s*[\-|:]\s*(Amazon(?:\.es)?|PcComponentes|El Corte Inglés|MediaMarkt|Fnac|AliExpress|Carrefour|Apple).*$/i, '').trim();
const catalogDescription = product ? compactText(cleanMarketplaceSuffix(product.description), 118) : '';

// Build structured title: "{productType} {brand} {model}" or fallback to raw title
const productTypeLabel: Record<string, string> = {
  Laptop: 'Laptop',
  Tablet: 'Tablet',
  Smartphone: 'Smartphone',
  Smartwatch: 'Smartwatch',
  Auriculares: 'Auriculares inalámbricos',
  Monitor: 'Monitor',
  Electrodoméstico: 'Electrodoméstico',
  Otros: '',
};
const buildTitle = () => {
  if (!product) return directTitle;
  if (product.productType && product.brand && product.model) {
    const typeLabel = productTypeLabel[product.productType] ?? product.productType;
    return `${typeLabel} ${product.brand} ${product.model}`;
  }
  return cleanMarketplaceSuffix(product.title);
};
const catalogTitle = compactText(buildTitle(), 68);

// Cálculo de porcentaje de descuento si existe precio original (modo catálogo)
const discountPercent = product?.originalPrice
  ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
  : null;

// Enlace de compra directa del catálogo (cesta de Amazon con tag si la generó
// el admin; si no, construida desde el ASIN). Se conserva como destino de compra
// de "Mi Radar"; la tarjeta ya no muestra salida directa (el nombre del
// comerciante se indica en la ficha /producto/[slug]).
const catalogDirectExitHref = product
  ? (product.buyNowUrl?.trim() || getAmazonAddToCartUrl(product.asin || ''))
  : '';

// Barra de satisfacción: proporción calculada con 4 factores reales del
// producto (sólo se ponderan los factores con datos disponibles):
//   1) pros/contras de la ficha, 2) valoraciones (estrellas y nº de opiniones),
//   3) relación calidad-precio (descuento real sobre el PVP) y
//   4) volumen de ventas/opiniones (escala logarítmica).
// Si el producto no tiene ningún dato, se usa conversionHooks como respaldo.
const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

const prosCount = Array.isArray(product?.pros) ? product.pros.length : 0;
const consCount = Array.isArray(product?.cons) ? product.cons.length : 0;

const factors: { weight: number; score: number }[] = [];

// 1) Pros vs contras
if (prosCount + consCount > 0) {
  factors.push({ weight: 0.4, score: prosCount / (prosCount + consCount) });
}

// 2) Valoraciones: estrellas (70%) + volumen de opiniones (30%)
const ratingValue = Number(product?.rating) || 0;
const reviewsValue = Number(product?.reviewsCount) || 0;
if (ratingValue > 0 || reviewsValue > 0) {
  const starsScore = ratingValue > 0 ? clamp01(ratingValue / 5) : 0.75;
  const reviewScore = reviewsValue > 0 ? clamp01(Math.log10(reviewsValue + 1) / 4) : 0.5;
  factors.push({ weight: 0.25, score: starsScore * 0.7 + reviewScore * 0.3 });
}

// 3) Relación calidad-precio: descuento real sobre el precio original.
// Sin descuento conocido se asume un valor neutro (0.6).
const productPrice = Number(product?.price) || 0;
const productOriginalPrice = Number(product?.originalPrice) || 0;
if (productPrice > 0) {
  const discountRatio =
    productOriginalPrice > productPrice
      ? clamp01((productOriginalPrice - productPrice) / productOriginalPrice)
      : 0;
  factors.push({ weight: 0.2, score: 0.6 + discountRatio * 0.4 });
}

// 4) Ventas / popularidad: nº de opiniones como proxy de volumen (escala log).
if (reviewsValue > 0) {
  factors.push({ weight: 0.15, score: clamp01(Math.log10(reviewsValue + 1) / 4) });
}

const totalWeight = factors.reduce((acc, f) => acc + f.weight, 0);
const satisfaction = product?.conversionHooks?.satisfactionScore;
const positivePercent =
  totalWeight > 0
    ? Math.round(
        (factors.reduce((acc, f) => acc + f.weight * f.score, 0) / totalWeight) * 100,
      )
    : Math.round(satisfaction?.positivePercentage ?? 85);
const negativePercent = 100 - positivePercent;

// Formateo de precio en formato moneda EUR
const formatCurrency = (amount: number) => {
  return new Intl.NumberFormat('es-ES', {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: 2,
  }).format(amount);
};

// --- Mi Radar: payload del botón "Guardar" (ambos modos) -------------------
const radarStore: 'amazon' | 'aliexpress' = product
  ? (/ali/i.test(product.merchant ?? '') ? 'aliexpress' : 'amazon')
  : (network === 'aliexpress' ? 'aliexpress' : 'amazon');
const radarId = product
  ? String(product.slug ?? product.id)
  : String(extractedAsin || asin || directTitle).trim();
// Precio numérico del modo plano ("29,99 €" → 29.99) para el sumatorio.
const parseEuro = (text: string): number | undefined => {
  const match = text.replace(/\s/g, '').match(/(\d+[.,]\d{2}|\d+)/);
  return match ? Number(match[1].replace(',', '.')) : undefined;
};
const radarPayload = {
  id: radarId,
  title: product ? product.title : directTitle,
  price: product ? formatCurrency(product.price) : (price ?? ''),
  priceValue: product ? product.price : (price ? parseEuro(price) : undefined),
  image: product ? product.image : (image ?? ''),
  buyUrl: product
    ? (catalogDirectExitHref || `/checkout/${product.slug ?? product.id}`)
    : exitHref,
  store: radarStore,
};
---

{directMode ? (
  <!-- Modo híbrido / salida directa: CTA .exit-cta hacia la red de afiliación -->
  <article class="aff-product-card">
    <div class="aff-image-wrapper">
      <img
        src={image}
        alt={directTitle}
        loading="lazy"
        width="400"
        height="400"
      />
      {badge && <span class="aff-badge">{badge}</span>}
    </div>
    <div class="aff-body">
      <h3 class="aff-title">{catalogTitle}</h3>
      {flatRating && (
        <div class="aff-rating" aria-label={`Puntuación: ${flatRating} sobre 5`}>
          <span class="aff-star" aria-hidden="true">★</span>
          <span class="aff-rating-value">{flatRating}</span>
        </div>
      )}
      {price && <div class="aff-price">{price}</div>}
      <div class="aff-actions">
      <a
        href={exitHref}
        class="aff-cta-btn exit-cta"
        target="_blank"
        rel="nofollow sponsored noopener noreferrer"
        data-network={network}
        data-asin={extractedAsin || asin || undefined}
        data-title={directTitle}
      >
        {ctaLabel}
        <svg class="external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <polyline points="15 3 21 3 21 9" />
          <line x1="10" y1="14" x2="21" y2="3" />
        </svg>
      </a>
      <button
        type="button"
        class="radar-save-btn"
        data-radar-toggle
        data-radar-id={radarPayload.id}
        data-radar-title={radarPayload.title}
        data-radar-price={radarPayload.price}
        data-radar-price-value={radarPayload.priceValue ?? undefined}
        data-radar-image={radarPayload.image}
        data-radar-url={radarPayload.buyUrl}
        data-radar-store={radarPayload.store}
        aria-pressed="false"
        aria-label={`Guardar ${directTitle} en Mi Radar`}
        title="Guardar en Mi Radar"
      >
        <svg class="radar-anim-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" opacity="0.45"></circle>
          <circle cx="12" cy="12" r="5" opacity="0.7"></circle>
          <line class="radar-sweep" x1="12" y1="12" x2="12" y2="4"></line>
          <circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"></circle>
        </svg>
      </button>
      </div>
    </div>
  </article>
) : (
<article class="product-card" id={`product-${product?.id}`} data-layout={layout}>
  <!-- Enlace de tarjeta completa: al pasar el cursor toda la tarjeta lleva a
       la ficha. Los elementos con enlace propio (título, categoría, imagen,
       "Comprar ya" y "Mi Radar") quedan por encima (z-index). -->
  <a
    class="card-link-overlay"
    href={`/producto/${product.slug ?? product.id}`}
    aria-label={`Ver ficha de ${product.title}`}
    tabindex="-1"
  ></a>
  <!-- Contenedor Visual del Producto
       Tailwind: contenedor cuadrado con fondo neutro (#F8F9FA) y la imagen
       contenida (object-contain) para que las fotos generadas con IA no se
       deformen ni se recorten en los bordes. -->
  <!-- Columna de imagen: sólo la imagen principal (única con enlace a ficha). -->
  <div class="image-col">
  <div class="image-wrapper">
    <a
      href={`/producto/${product.slug ?? product.id}`}
      class="image-link"
      aria-label={`Ver ficha de ${product.title}`}
      title={`Ver ficha de ${product.title}`}
      target="_blank"
      rel="noopener"
    >
      <img
        src={product.image}
        alt={`Fotografía y análisis técnico de ${product.title}`}
        loading="lazy"
        class="product-image"
        width="400"
        height="400"
      />
    </a>
    {discountPercent !== null && discountPercent > 0 && (
      <span class="discount-pill" aria-label={`Descuento del ${discountPercent}%`}>
        -{discountPercent}%
      </span>
    )}
  </div>
  </div>

  <!-- Columna de información: a la derecha en móvil (fila horizontal) y
       debajo de la imagen en escritorio (columna vertical). -->
  <div class="card-main">
  <!-- Contenido Editorial & Especificaciones -->
  <div class="card-content">
    <a class="category-label" href={`/?category=${encodeURIComponent(String(product.category ?? '').toLowerCase().trim())}`}>{product.category}</a>

    {product.rating && (
      <div class="rating-box" aria-label={`Puntuación: ${product.rating} sobre 5`}>
        <svg class="star-icon" viewBox="0 0 20 20" fill="currentColor">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span class="rating-value">{product.rating.toFixed(1)}</span>
        {product.reviewsCount && <span class="reviews-count">({product.reviewsCount})</span>}
      </div>
    )}

    <h3 class="product-title">
      <a
        href={`/producto/${product.slug ?? product.id}`}
        title={`Análisis completo de ${product.title}`}
        target="_blank"
        rel="noopener"
      >
        {catalogTitle}
      </a>
    </h3>

    <p class="product-summary">{catalogDescription}</p>

    <!-- Satisfaction Bar -->
    <div class="satisfaction-bar">
      <div class="satisfaction-header">
        <span class="satisfaction-label sat-positive">{positivePercent}%</span>
        <span class="satisfaction-label sat-negative">{negativePercent}%</span>
      </div>
      <div class="satisfaction-track">
        <div class="satisfaction-fill" style={`width: ${positivePercent}%`} />
      </div>
      <p class="satisfaction-note">Proporción calculada con pros y contras, valoraciones, precio (relación calidad-precio) y ventas.</p>
    </div>
  </div>

  <!-- Pie de la Tarjeta: Precio -->
  <div class="card-footer">
    <div class="price-container">
      <span class="price-label">Precio verificado:</span>
      <div class="price-numbers">
        <span class="main-price">{formatCurrency(product.price)}</span>
        {product.originalPrice && (
          <span class="original-price">{formatCurrency(product.originalPrice)}</span>
        )}
      </div>
    </div>
  </div>
  </div>

  <!-- Acciones de compra a ancho completo de la tarjeta (fila propia en móvil). -->
  <div class="buy-actions">
    <a
      href={`/checkout/${product.slug ?? product.id}`}
      class="affiliate-cta-btn buy-now-btn"
      id={`cta-btn-${product.id}`}
      aria-label={`Comprar ya ${product.title}`}
    >
      <span>Comprar ya</span>
      <svg class="external-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
    <button
      type="button"
      class="radar-save-btn"
      data-radar-toggle
      data-radar-id={radarPayload.id}
      data-radar-title={radarPayload.title}
      data-radar-price={radarPayload.price}
      data-radar-price-value={radarPayload.priceValue ?? undefined}
      data-radar-image={radarPayload.image}
      data-radar-url={radarPayload.buyUrl}
      data-radar-store={radarPayload.store}
      aria-pressed="false"
      aria-label={`Guardar ${product.title} en Mi Radar`}
      title="Guardar en Mi Radar"
    >
      <svg class="radar-anim-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" opacity="0.45"></circle>
        <circle cx="12" cy="12" r="5" opacity="0.7"></circle>
        <line class="radar-sweep" x1="12" y1="12" x2="12" y2="4"></line>
        <circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"></circle>
      </svg>
    </button>
  </div>

  <!-- Microcopia de confianza: a ancho completo de la tarjeta (fuera de la
       columna de imagen, en la fila inferior en móvil). -->
  <div class="trust-guarantee">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    <span>Pago y envío gestionados por el distribuidor oficial</span>
  </div>
  <TestProofBadge product={product} />
</article>
)}

<style>
  /* ============ PRODUCT CARD - PREMIUM DESIGN ============
     Híbrido adaptativo: fila horizontal en móvil (<768px, estilo lista
     Amazon) y columna vertical en escritorio (≥768px, grids). */
  .product-card {
    position: relative;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
    height: 100%;
    background: linear-gradient(135deg, rgba(17, 24, 39, 0.7) 0%, rgba(30, 41, 59, 0.5) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: all 0.35s cubic-bezier(0.23, 1, 0.320, 1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .product-card:hover {
    transform: translateY(-8px);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 24px 64px rgba(59, 130, 246, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* ============ IMAGE SECTION ============
     Móvil: columna izquierda fija (158px) con la única imagen del producto.
     Escritorio (≥768px): imagen a ancho completo. */
  .image-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 158px;
    flex: 0 0 158px;
    min-width: 0;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    height: 158px;
    flex: 0 0 auto;
    overflow: hidden;
    background: #f8fafc;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border-radius: 12px;
  }

  .image-link {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    cursor: pointer;
  }

  .product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 0.5rem;
    background: rgba(248, 250, 252, 0.5);
    border-radius: 0.5rem;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.320, 1);
  }

  .image-link:hover .product-image {
    transform: scale(1.03);
  }

  .discount-pill {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(239, 68, 68, 0.4);
    animation: slideDown 0.4s ease-out;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============ CONTENT SECTION ============ */
  /* Columna derecha en móvil (junto a la imagen); en escritorio ocupa el
     ancho completo bajo la imagen ( ≥768px ). */
  .card-main {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    min-width: 0;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0.85rem 0.9rem 0.4rem;
    gap: 0.45rem;
  }

  .category-label {
    display: block;
    width: 100%;
    font-size: 0.7rem;
    font-weight: 700;
    color: #60a5fa;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.6rem;
    background: rgba(96, 165, 250, 0.1);
    border-radius: 6px;
    border: 1px solid rgba(96, 165, 250, 0.2);
    text-align: center;
    text-decoration: none;
  }

  a.category-label:hover {
    background: rgba(96, 165, 250, 0.2);
    border-color: rgba(96, 165, 250, 0.45);
  }

  .rating-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: #fbbf24;
  }

  .star-icon {
    width: 15px;
    height: 15px;
    filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.5));
  }

  .rating-value {
    font-weight: 700;
    color: #fbbf24;
  }

  .reviews-count {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.72rem;
  }

  .product-title {
    display: -webkit-box;
