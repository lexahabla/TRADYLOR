  }

  /* Subcategorías anidadas bajo su categoría raíz */
  .cat-subs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-left: 0.85rem;
    padding-left: 0.55rem;
    border-left: 2px solid hsl(var(--h, 215) 80% 60% / 0.45);
  }

  .cat-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    border-radius: 9px;
    font-family: var(--font-body, inherit);
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.62);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-decoration: none;
    transition:
