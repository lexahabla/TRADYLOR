  }

  .cm-drop-item:hover {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.18) 0%, rgba(37, 99, 235, 0.12) 100%);
    border-color: rgba(96, 165, 250, 0.4);
    transform: translateX(2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .cm-drop-item:focus-visible {
    outline: none;
    border-color: rgba(96, 165, 250, 0.6);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
  }

  .cm-drop-item img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: contain;
    object-position: center;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .cm-drop-item:hover img {
    transform: scale(1.03);
  }

  .cm-drop-body {
    min-width: 0;
    flex: 1;
  }

  .cm-drop-title {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #f1f5f9;
    transition: color 0.18s ease;
  }

  .cm-drop-item:hover .cm-drop-title {
    color: #60a5fa;
  }

  .cm-drop-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
    font-size: 0.7rem;
    line-height: 1.3;
  }

  .cm-drop-price {
    font-family: var(--font-heading, inherit);
    font-weight: 800;
    color: #60a5fa;
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cm-drop-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .cm-drop-merchant {
    color: #94a3b8;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 8rem;
  }

  .cm-drop-discount {
    padding: 0.15rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 800;
    color: #34d399;
    background: rgba(16, 185, 129, 0.16);
    border: 1px solid rgba(52, 211, 153, 0.35);
    border-radius: 999px;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);
  }

  /* ── Responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 960px) {
    .nav-search {
      flex: 1 1 auto;
      max-width: none;
    }

    .cm-btn-label {
      max-width: 7rem;
    }
  }

  @media (max-width: 640px) {
    .category-frame {
      padding: 0.45rem 0.75rem;
      gap: 0.45rem;
    }

    .nav-search {
      height: 38px;
    }

    .cm-btn-label {
      max-width: 5.5rem;
    }

    .ns-submit {
      width: 30px;
      height: 30px;
      margin-right: 3px;
    }

    .cm-search-drop {
      width: auto;
      left: 0;
      right: 0;
    }

    .category-panel {
      top: calc(100% + 0.5rem);
      width: min(30rem, calc(100vw - 1.2rem));
      max-height: min(70vh, 32rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.75rem;
      border-radius: 16px;
    }

    .cat-panel-grid {
      grid-template-columns: 1fr;
      max-height: none;
      overflow-y: visible;
      padding-right: 0;
    }

    .cat-card {
      padding: 0.65rem 0.7rem;
    }

    .cat-card-name {
      font-size: 0.88rem;
    }
  }

  @media (max-width: 380px) {
    .category-menu-btn {
      padding: 0 0.5rem 0 0.6rem;
    }

    .cm-btn-label {
      display: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('categoryBar');

  if (bar) {
    const menuBtn = bar.querySelector<HTMLButtonElement>('[data-cm-menu-btn]');
    const menuPanel = bar.querySelector<HTMLElement>('[data-cm-panel]');

    /* ── Desplegable de categorías ───────────────────────────────────── */

    const setMenuOpen = (open: boolean) => {
      if (!menuPanel || !menuBtn) return;
      menuPanel.hidden = !open;
      menuBtn.setAttribute('aria-expanded', String(open));
    };

    const closePanel = () => setMenuOpen(false);

    menuBtn?.addEventListener('click', () => {
      setMenuOpen(Boolean(menuPanel?.hidden));
    });

    document.addEventListener('click', (event) => {
      if (!menuPanel || menuPanel.hidden) return;
      const target = event.target as Element | null;
      if (!target || typeof target.closest !== 'function') return;
      // Un enlace del panel navega y cierra; fuera del desplegable también cierra.
      if (target.closest('.category-panel a')) {
        closePanel();
        return;
      }
      if (!target.closest('.category-menu')) closePanel();
    });

    /* ── Observer: oculta la barra mientras el 1er section (hero) está visible,
         la muestra al entrar en #catalogo ─────────────────────────────────── */

    const catalogo = document.getElementById('catalogo');
    const firstSection = document.querySelector('section');

    if (catalogo && 'IntersectionObserver' in window) {
      let firstSectionVisible = false;
      const visible = new Set<Element>();

      const updateVisibility = () => {
        const show = visible.size > 0 && !firstSectionVisible;
        if (show) bar.classList.remove('category-bar--oculta');
        else bar.classList.add('category-bar--oculta');
      };

      const catalogoObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target as Element);
          else visible.delete(entry.target as Element);
        }
        updateVisibility();
      }, { threshold: 0.1 });
      catalogoObserver.observe(catalogo);

      if (firstSection) {
        const firstObserver = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            firstSectionVisible = entry.isIntersecting;
          }
          updateVisibility();
        }, { threshold: 0.1 });
        firstObserver.observe(firstSection);
      }
    }

  }
</script>
