    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(59, 130, 246, 0.08),
      0 0 24px rgba(59, 130, 246, 0.12);
    backdrop-filter: blur(16px);
