    text-overflow: ellipsis;
  }

  .cat-card-meta {
    font-family: var(--font-body, inherit);
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-card-arrow {
    flex-shrink: 0;
    opacity: 0.35;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

