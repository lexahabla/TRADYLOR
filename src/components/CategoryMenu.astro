    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .cat-panel-all {
    font-family: var(--font-body, inherit);
    font-size: 0.74rem;
    font-weight: 700;
    color: #93c5fd;
    text-decoration: none;
