---
import { getCategories } from '../lib/categories';
import type { Category } from '../lib/categories';

export interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
const categories = getCategories();

// Raíces + subcategorías agrupadas (el panel las muestra anidadas).
const roots = categories.filter((cat) => !cat.parentId);
const subsByParent = new Map<string, Category[]>();
for (const cat of categories) {
  if (!cat.parentId) continue;
  const list = subsByParent.get(cat.parentId) ?? [];
  list.push(cat);
  subsByParent.set(cat.parentId, list);
}

const activeCategory = activeSlug ? categories.find((cat) => cat.slug === activeSlug) : undefined;
const activeParentId = activeCategory?.parentId ?? null;
const isRootActive = (cat: Category) => activeSlug === cat.slug || activeParentId === cat.id;
// Tono de color distinto por categoría para los iconos del panel.
const hueOf = (index: number) => (index * 43) % 360;
---

<nav id="categoryBar" class="category-bar" aria-label="Categorías y accesos rápidos">
  <div class="category-frame" id="categoryFrame">
    <!-- Desplegable de categorías (con subcategorías anidadas) -->
    <div class="category-menu" data-cm-menu>
      <button
        type="button"
        class:list={['category-menu-btn', { 'has-active': Boolean(activeCategory) }]}
        data-cm-menu-btn
        aria-label="Explorar categorías"
        aria-expanded="false"
        aria-controls="categoryPanel"
      >
        {activeCategory ? (
          <span class="cm-btn-icon" aria-hidden="true">{activeCategory.icon}</span>
        ) : (
          <svg class="cm-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
          </svg>
        )}
        <span class="cm-btn-label">{activeCategory ? activeCategory.name : 'Categorías'}</span>
        <svg class="cm-btn-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <div class="category-panel" id="categoryPanel" data-cm-panel hidden>
        <div class="cat-panel-head">
          <span class="cat-panel-title">Explora por categoría</span>
          <a class:list={['cat-panel-all', { 'is-active': !activeSlug }]} href="/#catalogo">Ver todo</a>
        </div>

        <div class="cat-panel-grid">
          <a
            class:list={['cat-card', 'is-todos', { 'is-active': !activeSlug }]}
            href="/#catalogo"
            aria-current={!activeSlug ? 'true' : undefined}
          >
            <span class="cat-card-icon" aria-hidden="true">🛍️</span>
            <span class="cat-card-text">
              <span class="cat-card-name">Todos</span>
              <span class="cat-card-meta">Catálogo completo</span>
            </span>
          </a>

          {roots.map((cat, index) => {
            const subs = subsByParent.get(cat.id) ?? [];
            return (
              <div class="cat-group">
                <a
                  class:list={['cat-card', { 'is-active': isRootActive(cat) }]}
                  href={`/?category=${encodeURIComponent(cat.slug)}#catalogo`}
                  aria-current={activeSlug === cat.slug ? 'true' : undefined}
                  style={`--h: ${hueOf(index)}`}
                >
                  <span class="cat-card-icon" aria-hidden="true">{cat.icon}</span>
                  <span class="cat-card-text">
                    <span class="cat-card-name">{cat.name}</span>
                    <span class="cat-card-meta">
                      {subs.length > 0 ? `${subs.length} subcategoría${subs.length > 1 ? 's' : ''}` : 'Ver productos'}
                    </span>
                  </span>
                  <svg class="cat-card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>

                {subs.length > 0 && (
                  <div class="cat-subs">
                    {subs.map((sub) => (
                      <a
                        class:list={['cat-sub', { 'is-active': activeSlug === sub.slug }]}
                        href={`/?category=${encodeURIComponent(sub.slug)}#catalogo`}
                        aria-current={activeSlug === sub.slug ? 'true' : undefined}
                        style={`--h: ${hueOf(index)}`}
                      >
                        <span class="cat-sub-icon" aria-hidden="true">{sub.icon}</span>
                        <span>{sub.name}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Elementos principales: Buscar, Mi perfil y Mi Radar -->
    <div class="category-actions">
      <!-- Buscador en cascada (sugerencias en vivo vía /api/search) -->
      <form class="category-search" data-cm-search role="search" autocomplete="off">
        <svg class="cm-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" class="cm-search-input" data-cm-search-input placeholder="Buscar…" aria-label="Buscar productos" />
        <div class="cm-search-drop" data-cm-search-drop hidden></div>
      </form>

      <a class="category-pill" data-cm-perfil href="/metodologia" title="Tu perfil de comprador" aria-label="Mi perfil">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span class="category-pill-label">Mi perfil</span>
      </a>
      <a class="category-pill" href="/mi-radar" title="Abrir Mi Radar" aria-label="Mi Radar">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" opacity="0.45"></circle>
          <circle cx="12" cy="12" r="5" opacity="0.7"></circle>
          <line x1="12" y1="12" x2="12" y2="4"></line>
        </svg>
        <span class="category-pill-label">Mi Radar</span>
        <span class="cm-radar-count" data-cm-radar-count hidden>0</span>
      </a>
    </div>
  </div>
</nav>

<style>
  .category-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 110;
    background: rgba(12, 16, 26, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
    transition:
      transform 0.4s cubic-bezier(0.23, 1, 0.32, 1),
      opacity 0.3s ease;
  }

  .category-bar.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .category-frame {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
  }

  /* ── Desplegable de categorías ─────────────────────────────────────── */
  .category-menu {
    position: relative;
    flex-shrink: 0;
  }

  .category-menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body, inherit);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .category-menu-btn:hover,
  .category-menu-btn[aria-expanded='true'],
  .category-menu-btn.has-active {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: rgba(96, 165, 250, 0.6);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
  }

  .cm-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .cm-btn-label {
    max-width: 11rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cm-btn-caret {
    opacity: 0.75;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .category-menu-btn[aria-expanded='true'] .cm-btn-caret {
    transform: rotate(180deg);
  }

  .category-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    z-index: 20;
    width: min(38rem, calc(100vw - 3rem));
    padding: 0.8rem;
    background: rgba(12, 16, 26, 0.99);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .category-panel[hidden] {
    display: none;
  }

  .category-panel:not([hidden]) {
    animation: cm-panel-in 0.18s ease;
  }

  @keyframes cm-panel-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .cat-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.1rem 0.25rem 0.6rem;
    margin-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .cat-panel-title {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .cat-panel-all {
    font-family: var(--font-body, inherit);
    font-size: 0.74rem;
    font-weight: 700;
    color: #93c5fd;
    text-decoration: none;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }

  .cat-panel-all:hover {
    background: rgba(59, 130, 246, 0.18);
    color: #ffffff;
  }

  .cat-panel-all.is-active {
    background: rgba(59, 130, 246, 0.25);
    border-color: rgba(96, 165, 250, 0.45);
    color: #ffffff;
  }

  .cat-panel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    max-height: min(66vh, 30rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.2rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
  }

  .cat-panel-grid::-webkit-scrollbar {
    width: 6px;
  }

  .cat-panel-grid::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.22);
    border-radius: 999px;
  }

  .cat-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cat-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.6rem;
    border-radius: 14px;
    text-decoration: none;
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .cat-card:hover {
    transform: translateY(-2px);
    background: rgba(59, 130, 246, 0.14);
    border-color: rgba(96, 165, 250, 0.45);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .cat-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border-radius: 12px;
    font-size: 1.2rem;
    line-height: 1;
    background: linear-gradient(
      135deg,
      hsl(var(--h, 215) 80% 60% / 0.28),
      hsl(var(--h, 215) 80% 55% / 0.08)
    );
    border: 1px solid hsl(var(--h, 215) 80% 60% / 0.32);
  }

  .cat-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
    flex: 1;
  }

  .cat-card-name {
    font-family: var(--font-body, inherit);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-card-meta {
    font-family: var(--font-body, inherit);
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-card-arrow {
    flex-shrink: 0;
    opacity: 0.35;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .cat-card:hover .cat-card-arrow {
    opacity: 0.95;
    transform: translateX(2px);
  }

  .cat-card.is-active {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: rgba(147, 197, 253, 0.6);
    color: #ffffff;
    box-shadow: 0 8px 22px rgba(37, 99, 235, 0.45);
  }

  .cat-card.is-active .cat-card-meta {
    color: rgba(255, 255, 255, 0.78);
  }

  .cat-card.is-active .cat-card-icon {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .cat-card.is-active .cat-card-arrow {
    opacity: 0.9;
  }

  /* Subcategorías anidadas bajo su categoría raíz */
  .cat-subs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-left: 0.85rem;
    padding-left: 0.55rem;
    border-left: 2px solid hsl(var(--h, 215) 80% 60% / 0.45);
  }

  .cat-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    border-radius: 9px;
    font-family: var(--font-body, inherit);
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.62);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-decoration: none;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .cat-sub:hover {
    background: rgba(59, 130, 246, 0.22);
    border-color: rgba(96, 165, 250, 0.45);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .cat-sub.is-active {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-color: rgba(147, 197, 253, 0.6);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
  }

  .cat-sub-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  /* ── Elementos principales ─────────────────────────────────────────── */
  .category-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: 0 1 auto;
    min-width: 0;
    margin-left: auto;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    font-family: var(--font-body, inherit);
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .category-pill:hover {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: rgba(96, 165, 250, 0.6);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
  }

  .cm-radar-count {
    min-width: 1.15rem;
    padding: 0.02rem 0.32rem;
    font-size: 0.68rem;
    font-weight: 800;
    text-align: center;
    color: #ffffff;
    background: linear-gradient(135deg, #f59e0b, #ea580c);
    border-radius: 999px;
    line-height: 1.35;
  }

  .cm-radar-count[hidden] {
    display: none;
  }

  /* ── Buscador en cascada ───────────────────────────────────────────── */
  .category-search {
    position: relative;
    flex: 0 1 13.5rem;
    min-width: 7.5rem;
  }

  .cm-search-icon {
    position: absolute;
    left: 0.65rem;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.45);
    pointer-events: none;
  }

  .cm-search-input {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 1.9rem;
    font-family: var(--font-body, inherit);
    font-size: 0.8rem;
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .cm-search-input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .cm-search-input:focus {
    background: rgba(2, 6, 23, 0.9);
    border-color: rgba(96, 165, 250, 0.55);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.22);
  }

  .cm-search-drop {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: auto;
    z-index: 5;
    width: min(21rem, calc(100vw - 1.5rem));
    background: rgba(12, 16, 26, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(59, 130, 246, 0.08),
      0 0 24px rgba(59, 130, 246, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    overflow: hidden;
    padding: 0.35rem;
    transform-origin: top center;
    animation: cm-drop-in 0.16s ease;
  }

  @keyframes cm-drop-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .cm-search-drop[hidden] {
    display: none;
  }

  .cm-drop-status {
    margin: 0;
    padding: 0.6rem 0.65rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
  }

  .cm-drop-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.55rem;
    border-radius: 10px;
    border: 1px solid transparent;
    text-decoration: none;
    color: #e5e7eb;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .cm-drop-item:hover {
    background: rgba(59, 130, 246, 0.14);
    border-color: rgba(96, 165, 250, 0.28);
  }

  .cm-drop-item img {
    width: 42px;
    height: 42px;
    border-radius: 9px;
    object-fit: cover;
    background: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  .cm-drop-body {
    min-width: 0;
    flex: 1;
  }

  .cm-drop-title {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease;
  }

  .cm-drop-item:hover .cm-drop-title {
    color: #60a5fa;
  }

  .cm-drop-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.12rem;
    font-size: 0.7rem;
    line-height: 1.3;
  }

  .cm-drop-price {
    font-family: var(--font-heading, inherit);
    font-weight: 800;
    color: #60a5fa;
  }

  .cm-drop-sep {
    color: rgba(255, 255, 255, 0.25);
  }

  .cm-drop-merchant {
    color: #94a3b8;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cm-drop-discount {
    padding: 0.12rem 0.5rem;
    font-size: 0.66rem;
    font-weight: 800;
    color: #34d399;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(52, 211, 153, 0.3);
    border-radius: 999px;
    flex-shrink: 0;
  }

  /* Etiquetas de los accesos: se ocultan cuando la barra queda muy justa */
  @media (max-width: 700px) {
    .category-pill-label {
      display: none;
    }

    .category-pill {
      padding: 0.5rem 0.7rem;
    }

    .category-search {
      flex: 0 1 11rem;
    }
  }

  @media (max-width: 640px) {
    .category-bar {
      background: transparent;
      border-bottom: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      padding: 0.55rem 0.6rem 0 0.6rem;
      pointer-events: none;
    }

    .category-bar.is-visible {
      pointer-events: none;
    }

    .category-frame {
      max-width: none;
      margin: 0;
      padding: 0;
      gap: 0.4rem;
      flex-wrap: wrap;
    }

    .category-menu {
      pointer-events: auto;
      flex-shrink: 0;
    }

    .category-menu-btn {
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      background: rgba(12, 16, 26, 0.92);
    }

    .category-menu-btn[aria-expanded='true'] {
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    }

    .cm-btn-label {
      max-width: 7.5rem;
    }

    .category-actions {
      pointer-events: auto;
      flex: 1 1 12rem;
      min-width: 0;
      margin-left: 0;
      justify-content: flex-end;
    }

    .category-search {
      flex: 1 1 7rem;
      min-width: 5.5rem;
    }

    .cm-search-drop {
      width: auto;
      right: 0;
    }

    .category-panel {
      top: calc(100% + 0.5rem);
      left: 0;
      width: min(30rem, calc(100vw - 1.2rem));
      max-height: min(70vh, 32rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.75rem;
      border-radius: 16px;
    }

    .cat-panel-grid {
      grid-template-columns: 1fr;
      max-height: none;
      overflow-y: visible;
      padding-right: 0;
    }

    .cat-card {
      padding: 0.65rem 0.7rem;
    }

    .cat-card-name {
      font-size: 0.88rem;
    }
  }

  @media (max-width: 380px) {
    .category-menu-btn {
      padding: 0.5rem 0.7rem;
    }

    .cm-btn-label {
      display: none;
    }

    .category-actions {
      flex: 1 1 9rem;
    }
  }
</style>

<script>
  const bar = document.getElementById('categoryBar');

  if (bar) {
    const frame = document.getElementById('categoryFrame');
    const menuBtn = bar.querySelector<HTMLButtonElement>('[data-cm-menu-btn]');
    const menuPanel = bar.querySelector<HTMLElement>('[data-cm-panel]');

    const headerEl = document.querySelector('.site-header');
    const mainNavEl = document.getElementById('mainNav');
    const navToggleEl = document.querySelector('.nav-toggle-btn');

    const mq = window.matchMedia('(max-width: 640px)');

    let isVisible = false;

    const applyOffset = () => {
      const offset = isVisible && !mq.matches ? bar.offsetHeight : 0;
      document.documentElement.style.setProperty('--category-bar-offset', `${offset}px`);
    };

    const applyLayout = () => {
      applyOffset();
      headerEl?.classList.toggle('is-hidden', isVisible && mq.matches);
      if (isVisible && mq.matches && mainNavEl?.classList.contains('is-open')) {
        mainNavEl.classList.remove('is-open');
        navToggleEl?.setAttribute('aria-expanded', 'false');
      }
    };

    const setMenuOpen = (open: boolean) => {
      if (!menuPanel || !menuBtn) return;
      menuPanel.hidden = !open;
      menuBtn.setAttribute('aria-expanded', String(open));
    };

    const closePanel = () => setMenuOpen(false);

    const targets = Array.from(document.querySelectorAll<HTMLElement>('.section-header'));

    if (targets.length > 0 && 'IntersectionObserver' in window) {
      const visible = new Set<Element>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target);
            else visible.delete(entry.target);
          }
          const show = visible.size > 0;
          isVisible = show;
          bar.classList.toggle('is-visible', show);
          if (!show) closePanel();
          applyLayout();
        },
        { rootMargin: '-72px 0px 0px 0px' }
      );
      targets.forEach((target) => observer.observe(target));
    }

    window.addEventListener('resize', applyLayout);

    if ('ResizeObserver' in window) {
      new ResizeObserver(() => {
        if (isVisible) applyOffset();
      }).observe(bar);
    }

    /* ── Desplegable de categorías ───────────────────────────────────── */

    menuBtn?.addEventListener('click', () => {
      setMenuOpen(Boolean(menuPanel?.hidden));
    });

    document.addEventListener('click', (event) => {
      if (!menuPanel || menuPanel.hidden) return;
      const target = event.target as Element | null;
      if (!target || typeof target.closest !== 'function') return;
      // Un enlace del panel navega y cierra; fuera del desplegable también cierra.
      if (target.closest('.category-panel a')) {
        closePanel();
        return;
      }
      if (!target.closest('.category-menu')) closePanel();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closePanel();
        closeDrop();
      }
    });

    /* ── Buscador en cascada + pills de perfil y Mi Radar ──────────────── */

    const searchForm = bar.querySelector<HTMLFormElement>('[data-cm-search]');
    const searchInput = bar.querySelector<HTMLInputElement>('[data-cm-search-input]');
    const searchDrop = bar.querySelector<HTMLElement>('[data-cm-search-drop]');
    const perfilLink = bar.querySelector<HTMLAnchorElement>('[data-cm-perfil]');
    const radarCount = bar.querySelector<HTMLElement>('[data-cm-radar-count]');

    const escapeHtml = (value: string): string =>
      value.replace(/[&<>"']/g, (ch) => {
        switch (ch) {
          case '&': return '&amp;';
          case '<': return '&lt;';
          case '>': return '&gt;';
          case '"': return '&quot;';
          default: return '&#39;';
        }
      });

    const closeDrop = () => {
      if (searchDrop) searchDrop.hidden = true;
    };

    let dropTimer: number | undefined;
    let lastQuery = '';

    const renderDropStatus = (message: string) => {
      if (!searchDrop) return;
      searchDrop.innerHTML = `<p class="cm-drop-status">${escapeHtml(message)}</p>`;
      searchDrop.hidden = false;
    };

    const runCascade = async (raw: string) => {
      const q = raw.trim();
      if (q.length < 2) {
        closeDrop();
        return;
      }
      if (q === lastQuery && searchDrop && !searchDrop.hidden) return;
      lastQuery = q;
      renderDropStatus('Buscando…');
      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(q)}&limit=5`);
        const data = await res.json();
        if (!data?.success) throw new Error('search failed');
        const hits: {
          slug: string; title: string; price: string; image: string;
          discountPct: number | null; url: string; merchant?: string;
        }[] = data.products ?? [];
        if (!searchDrop) return;
        if (hits.length === 0) {
          renderDropStatus(`Sin resultados para «${q}»`);
          return;
        }
        searchDrop.innerHTML = hits
          .map(
            (hit) => `
              <a class="cm-drop-item" href="${escapeHtml(hit.url)}">
                <img src="${escapeHtml(hit.image)}" alt="" loading="lazy" width="42" height="42" />
                <span class="cm-drop-body">
                  <span class="cm-drop-title">${escapeHtml(hit.title)}</span>
                  <span class="cm-drop-meta">
                    <span class="cm-drop-price">${escapeHtml(hit.price)}</span>
                    ${hit.merchant ? `<span class="cm-drop-sep" aria-hidden="true">·</span><span class="cm-drop-merchant">${escapeHtml(hit.merchant)}</span>` : ''}
                  </span>
                </span>
                ${hit.discountPct ? `<span class="cm-drop-discount">-${hit.discountPct}%</span>` : ''}
              </a>`,
          )
          .join('');
        searchDrop.hidden = false;
      } catch {
        renderDropStatus('El buscador no está disponible ahora mismo.');
      }
    };

    searchInput?.addEventListener('input', () => {
      window.clearTimeout(dropTimer);
      const value = searchInput.value;
      dropTimer = window.setTimeout(() => void runCascade(value), 280);
    });

    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const first = searchDrop?.querySelector<HTMLAnchorElement>('.cm-drop-item');
      if (first) {
        window.location.href = first.href;
        return;
      }
      void runCascade(searchInput?.value ?? '');
    });

    // Cerrar la cascada al pulsar fuera o al cambiar de pestaña.
    document.addEventListener('click', (event) => {
      if (!searchDrop || searchDrop.hidden) return;
      const target = event.target as Element | null;
      if (!target || typeof target.closest !== 'function') return;
      if (!target.closest('.category-search')) closeDrop();
    });
    document.addEventListener('visibilitychange', closeDrop);

    // Contador de Mi Radar: se actualiza con los cambios del store (LocalStorage
    // y sync con la nube comparten onRadarChange).
    const updateRadarCount = (products?: number) => {
      if (!radarCount) return;
      if (typeof products === 'number') {
        radarCount.textContent = String(products);
        radarCount.hidden = products === 0;
        return;
      }
      void import('../utils/radarStore')
        .then(({ getRadarProducts }) => {
          const count = getRadarProducts().length;
          radarCount.textContent = String(count);
          radarCount.hidden = count === 0;
        })
        .catch(() => { radarCount.hidden = true; });
    };

    // Badge de perfil: con sesión → /perfil (cuenta Mi Radar); sin sesión →
    // el perfilador de la metodología.
    const updatePerfilBadge = (hasSession?: boolean) => {
      if (!perfilLink) return;
      if (typeof hasSession === 'boolean') {
        perfilLink.href = hasSession ? '/perfil' : '/metodologia';
        return;
      }
      void import('../utils/auth')
        .then(async ({ getSession }) => {
          const session = await getSession();
          perfilLink.href = session?.user ? '/perfil' : '/metodologia';
        })
        .catch(() => { perfilLink.href = '/metodologia'; });
    };

    updateRadarCount();
    updatePerfilBadge();

    void import('../utils/radarStore')
      .then(({ onRadarChange, getRadarProducts }) => {
        onRadarChange(() => updateRadarCount(getRadarProducts().length));
      })
      .catch(() => {
        // Sin bundling del store (no debería pasar): refrescar en cambios destorage.
        window.addEventListener('storage', (event) => {
          if (event.key === 'tradylor-radar-v1') updateRadarCount();
        });
      });

    void import('../utils/auth')
      .then(({ onAuthChange, getCachedSession }) => {
        onAuthChange((user) => updatePerfilBadge(Boolean(user)));
        // Si initAuth ya resolvió, reflejar el estado actual.
        updatePerfilBadge(Boolean(getCachedSession()?.user));
      })
      .catch(() => { /* badge queda con el valor inicial. */ });

    applyLayout();

    mq.addEventListener('change', () => {
      closePanel();
      applyLayout();
    });
  }
</script>
