---
import { getCategories } from '../lib/categories';
import type { Category } from '../lib/categories';

export interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
const categories = getCategories();

// La barra se monta en el Layout de todas las páginas públicas: si la página
// no pasa el prop, la categoría activa se deduce de ?category= en la URL.
const slugParam = (Astro.url.searchParams.get('category') ?? '').toLowerCase().trim();
const activeSlugResolved = activeSlug ?? (slugParam || undefined);

// Raíces + subcategorías agrupadas (el panel las muestra anidadas).
const roots = categories.filter((cat) => !cat.parentId);
const subsByParent = new Map<string, Category[]>();
for (const cat of categories) {
  if (!cat.parentId) continue;
  const list = subsByParent.get(cat.parentId) ?? [];
  list.push(cat);
  subsByParent.set(cat.parentId, list);
}

const activeCategory = activeSlugResolved ? categories.find((cat) => cat.slug === activeSlugResolved) : undefined;
const activeParentId = activeCategory?.parentId ?? null;
const isRootActive = (cat: Category) => activeSlugResolved === cat.slug || activeParentId === cat.id;
// Tono de color distinto por categoría para los iconos del panel.
const hueOf = (index: number) => (index * 43) % 360;
---

<nav id="categoryBar" class="category-bar" aria-label="Categorías, búsqueda y navegación">
  <div class="category-frame" id="categoryFrame">
    <!-- Buscador unificado (estilo Amazon #nav-search, adaptado a Tradylor):
         [Categorías ▾] | [input] [x] [lupa] en una sola pastilla. -->
    <form class="nav-search" data-cm-search role="search" autocomplete="off">
      <div class="category-menu" data-cm-menu>
        <button
          type="button"
          class:list={['category-menu-btn', { 'has-active': Boolean(activeCategory) }]}
          data-cm-menu-btn
          aria-label="Explorar categorías"
          aria-expanded="false"
          aria-controls="categoryPanel"
        >
          {activeCategory ? (
            <span class="cm-btn-icon" aria-hidden="true">{activeCategory.icon}</span>
          ) : (
            <svg class="cm-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
          )}
          <span class="cm-btn-label">{activeCategory ? activeCategory.name : 'Categorías'}</span>
          <svg class="cm-btn-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="category-panel" id="categoryPanel" data-cm-panel hidden>
          <div class="cat-panel-head">
            <span class="cat-panel-title">Explora por categoría</span>
            <a class:list={['cat-panel-all', { 'is-active': !activeSlugResolved }]} href="/#catalogo">Ver todo</a>
          </div>

          <div class="cat-panel-grid">
            <a
              class:list={['cat-card', 'is-todos', { 'is-active': !activeSlugResolved }]}
              href="/#catalogo"
              aria-current={!activeSlugResolved ? 'true' : undefined}
            >
              <span class="cat-card-icon" aria-hidden="true">🛍️</span>
              <span class="cat-card-text">
                <span class="cat-card-name">Todos</span>
                <span class="cat-card-meta">Catálogo completo</span>
              </span>
            </a>

            {roots.map((cat, index) => {
              const subs = subsByParent.get(cat.id) ?? [];
              return (
                <div class="cat-group">
                  <a
                    class:list={['cat-card', { 'is-active': isRootActive(cat) }]}
                    href={`/?category=${encodeURIComponent(cat.slug)}#catalogo`}
                    aria-current={activeSlugResolved === cat.slug ? 'true' : undefined}
                    style={`--h: ${hueOf(index)}`}
                  >
                    <span class="cat-card-icon" aria-hidden="true">{cat.icon}</span>
                    <span class="cat-card-text">
                      <span class="cat-card-name">{cat.name}</span>
                      <span class="cat-card-meta">
                        {subs.length > 0 ? `${subs.length} subcategoría${subs.length > 1 ? 's' : ''}` : 'Ver productos'}
                      </span>
                    </span>
                    <svg class="cat-card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </a>

                  {subs.length > 0 && (
                    <div class="cat-subs">
                      {subs.map((sub) => (
                        <a
                          class:list={['cat-sub', { 'is-active': activeSlugResolved === sub.slug }]}
                          href={`/?category=${encodeURIComponent(sub.slug)}#catalogo`}
                          aria-current={activeSlugResolved === sub.slug ? 'true' : undefined}
                          style={`--h: ${hueOf(index)}`}
                        >
                          <span class="cat-sub-icon" aria-hidden="true">{sub.icon}</span>
                          <span>{sub.name}</span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <span class="ns-sep" aria-hidden="true"></span>

      <input type="search" class="ns-input cm-search-input" data-cm-search-input placeholder="Buscar productos…" aria-label="Buscar productos" />

      <button type="button" class="ns-clear" data-cm-clear aria-label="Borrar la búsqueda" hidden>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <button type="submit" class="ns-submit" aria-label="Buscar">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Sugerencias en vivo (vía /api/search) -->
      <div class="cm-search-drop" data-cm-search-drop hidden></div>
    </form>

    <!-- Hamburguesa del menú principal (móvil) -->
    <button type="button" class="nav-toggle-btn" aria-label="Abrir menú" aria-controls="mainNav" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>

    <!-- Navegación principal: vive dentro de la barra fija -->
    <nav id="mainNav" class="main-nav" aria-label="Navegación Principal">
      <ul class="nav-list">
        <li><a href="/#destacados" class="nav-link">Top Selecciones</a></li>
        <li><a href="/#metodologia" class="nav-link">Metodología</a></li>
        <li><a href="/#comparativas" class="nav-link">Comparativas</a></li>
        <li><a href="#aviso-legal" class="nav-link">Aviso de Afiliación</a></li>
      </ul>
    </nav>
  </div>
</nav>

<style is:global>
  /* ── Barra fija: queda pegada justo debajo del header (sticky, en flujo) ── */
  .category-bar {
    position: sticky;
    top: calc(var(--header-h, 72px));
    left: 0;
    right: 0;
    z-index: 90;
    background: #000000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }

  .category-frame {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
  }

  /* ── Buscador unificado (estilo Amazon, colores Tradylor) ─────────────── */
  .nav-search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 22rem;
    max-width: 40rem;
    min-width: 0;
    height: 40px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .nav-search:focus-within {
    background: rgba(2, 6, 23, 0.85);
    border-color: rgba(96, 165, 250, 0.55);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.22);
  }

  /* Selector de categorías (primer segmento de la pastilla) */
  .category-menu {
    position: relative;
    flex-shrink: 0;
    height: 100%;
  }

  .category-menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 100%;
    padding: 0 0.7rem 0 0.85rem;
    background: transparent;
    border: none;
    border-radius: 10px 0 0 10px;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body, inherit);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .category-menu-btn:hover,
  .category-menu-btn[aria-expanded='true'],
  .category-menu-btn.has-active {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
  }

  .cm-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .cm-btn-label {
    max-width: 11rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cm-btn-caret {
    opacity: 0.75;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .category-menu-btn[aria-expanded='true'] .cm-btn-caret {
    transform: rotate(180deg);
  }

  .ns-sep {
    width: 1px;
    height: 60%;
    background: rgba(255, 255, 255, 0.14);
    flex-shrink: 0;
  }

  .ns-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0 0.5rem;
    font-family: var(--font-body, inherit);
    font-size: 0.85rem;
    color: #f3f4f6;
    color-scheme: dark;
    background: transparent;
    border: none;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .ns-input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  /* Oculta la X nativa de <input type="search">: usamos la nuestra */
  .ns-input::-webkit-search-cancel-button,
  .ns-input::-webkit-search-decoration {
    display: none;
    -webkit-appearance: none;
  }

  .ns-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    padding: 0;
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .ns-clear:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .ns-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 4px;
    padding: 0;
    color: #ffffff;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .ns-submit:hover {
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.55);
    transform: translateY(-1px);
  }

  .ns-submit:active {
    transform: scale(0.96);
  }

  /* ── Desplegable de categorías ─────────────────────────────────────── */
  .category-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    z-index: 20;
    width: min(38rem, calc(100vw - 3rem));
    padding: 0.8rem;
    background: rgba(12, 16, 26, 0.99);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .category-panel[hidden] {
    display: none;
  }

  .category-panel:not([hidden]) {
    animation: cm-panel-in 0.18s ease;
  }

  @keyframes cm-panel-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .cat-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.1rem 0.25rem 0.6rem;
    margin-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .cat-panel-title {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .cat-panel-all {
    font-family: var(--font-body, inherit);
    font-size: 0.74rem;
    font-weight: 700;
    color: #93c5fd;
    text-decoration: none;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }

  .cat-panel-all:hover {
    background: rgba(59, 130, 246, 0.18);
    color: #ffffff;
  }

  .cat-panel-all.is-active {
    background: rgba(59, 130, 246, 0.25);
    border-color: rgba(96, 165, 250, 0.45);
    color: #ffffff;
  }

  .cat-panel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    max-height: min(66vh, 30rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.2rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
  }

  .cat-panel-grid::-webkit-scrollbar {
    width: 6px;
  }

  .cat-panel-grid::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.22);
    border-radius: 999px;
  }

  .cat-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cat-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.6rem;
    border-radius: 14px;
    text-decoration: none;
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .cat-card:hover {
    transform: translateY(-2px);
    background: rgba(59, 130, 246, 0.14);
    border-color: rgba(96, 165, 250, 0.45);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .cat-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border-radius: 12px;
    font-size: 1.2rem;
    line-height: 1;
    background: linear-gradient(
      135deg,
      hsl(var(--h, 215) 80% 60% / 0.28),
      hsl(var(--h, 215) 80% 55% / 0.08)
    );
    border: 1px solid hsl(var(--h, 215) 80% 60% / 0.32);
  }

  .cat-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
    flex: 1;
  }

  .cat-card-name {
    font-family: var(--font-body, inherit);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-card-meta {
    font-family: var(--font-body, inherit);
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-card-arrow {
    flex-shrink: 0;
    opacity: 0.35;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .cat-card:hover .cat-card-arrow {
    opacity: 0.95;
    transform: translateX(2px);
  }

  .cat-card.is-active {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: rgba(147, 197, 253, 0.6);
    color: #ffffff;
    box-shadow: 0 8px 22px rgba(37, 99, 235, 0.45);
  }

  .cat-card.is-active .cat-card-meta {
    color: rgba(255, 255, 255, 0.78);
  }

  .cat-card.is-active .cat-card-icon {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .cat-card.is-active .cat-card-arrow {
    opacity: 0.9;
  }

  /* Subcategorías anidadas bajo su categoría raíz */
  .cat-subs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-left: 0.85rem;
    padding-left: 0.55rem;
    border-left: 2px solid hsl(var(--h, 215) 80% 60% / 0.45);
  }

  .cat-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    border-radius: 9px;
    font-family: var(--font-body, inherit);
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.62);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-decoration: none;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .cat-sub:hover {
    background: rgba(59, 130, 246, 0.22);
    border-color: rgba(96, 165, 250, 0.45);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .cat-sub.is-active {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-color: rgba(147, 197, 253, 0.6);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
  }

  .cat-sub-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  /* ── Sugerencias del buscador (cascada) ──────────────────────────────── */
  .cm-search-drop {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 5;
    width: min(24rem, calc(100vw - 1.5rem));
    background: rgba(12, 16, 26, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(59, 130, 246, 0.08),
      0 0 24px rgba(59, 130, 246, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    overflow: hidden;
    padding: 0.35rem;
    transform-origin: top center;
    animation: cm-drop-in 0.16s ease;
  }

  @keyframes cm-drop-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .cm-search-drop[hidden] {
    display: none;
  }

  .cm-drop-status {
    margin: 0;
    padding: 0.6rem 0.65rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
  }

  .cm-drop-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.6rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    text-decoration: none;
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.03);
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.15s ease, box-shadow 0.18s ease;
  }

  .cm-drop-item:hover {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.18) 0%, rgba(37, 99, 235, 0.12) 100%);
    border-color: rgba(96, 165, 250, 0.4);
    transform: translateX(2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .cm-drop-item:focus-visible {
    outline: none;
    border-color: rgba(96, 165, 250, 0.6);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
  }

  .cm-drop-item img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: contain;
    object-position: center;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .cm-drop-item:hover img {
    transform: scale(1.03);
  }

  .cm-drop-body {
    min-width: 0;
    flex: 1;
  }

  .cm-drop-title {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #f1f5f9;
    transition: color 0.18s ease;
  }

  .cm-drop-item:hover .cm-drop-title {
    color: #60a5fa;
  }

  .cm-drop-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
    font-size: 0.7rem;
    line-height: 1.3;
  }

  .cm-drop-price {
    font-family: var(--font-heading, inherit);
    font-weight: 800;
    color: #60a5fa;
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cm-drop-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .cm-drop-merchant {
    color: #94a3b8;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 8rem;
  }

  .cm-drop-discount {
    padding: 0.15rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 800;
    color: #34d399;
    background: rgba(16, 185, 129, 0.16);
    border: 1px solid rgba(52, 211, 153, 0.35);
    border-radius: 999px;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);
  }

  /* ── Responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 960px) {
    .nav-search {
      flex: 1 1 auto;
      max-width: none;
    }

    .cm-btn-label {
      max-width: 7rem;
    }
  }

  @media (max-width: 640px) {
    .category-frame {
      padding: 0.45rem 0.75rem;
      gap: 0.45rem;
    }

    .nav-search {
      height: 38px;
    }

    .cm-btn-label {
      max-width: 5.5rem;
    }

    .ns-submit {
      width: 30px;
      height: 30px;
      margin-right: 3px;
    }

    .cm-search-drop {
      width: auto;
      left: 0;
      right: 0;
    }

    .category-panel {
      top: calc(100% + 0.5rem);
      width: min(30rem, calc(100vw - 1.2rem));
      max-height: min(70vh, 32rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.75rem;
      border-radius: 16px;
    }

    .cat-panel-grid {
      grid-template-columns: 1fr;
      max-height: none;
      overflow-y: visible;
      padding-right: 0;
    }

    .cat-card {
      padding: 0.65rem 0.7rem;
    }

    .cat-card-name {
      font-size: 0.88rem;
    }
  }

  @media (max-width: 380px) {
    .category-menu-btn {
      padding: 0 0.5rem 0 0.6rem;
    }

    .cm-btn-label {
      display: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('categoryBar');

  if (bar) {
    const menuBtn = bar.querySelector<HTMLButtonElement>('[data-cm-menu-btn]');
    const menuPanel = bar.querySelector<HTMLElement>('[data-cm-panel]');

    /* ── Desplegable de categorías ───────────────────────────────────── */

    const setMenuOpen = (open: boolean) => {
      if (!menuPanel || !menuBtn) return;
      menuPanel.hidden = !open;
      menuBtn.setAttribute('aria-expanded', String(open));
    };

    const closePanel = () => setMenuOpen(false);

    menuBtn?.addEventListener('click', () => {
      setMenuOpen(Boolean(menuPanel?.hidden));
    });

    document.addEventListener('click', (event) => {
      if (!menuPanel || menuPanel.hidden) return;
      const target = event.target as Element | null;
      if (!target || typeof target.closest !== 'function') return;
      // Un enlace del panel navega y cierra; fuera del desplegable también cierra.
      if (target.closest('.category-panel a')) {
        closePanel();
        return;
      }
      if (!target.closest('.category-menu')) closePanel();
    });

    /* ── Buscador unificado: cascada + envío al catálogo ──────────────── */

    const searchForm = bar.querySelector<HTMLFormElement>('[data-cm-search]');
    const searchInput = bar.querySelector<HTMLInputElement>('[data-cm-search-input]');
    const searchDrop = bar.querySelector<HTMLElement>('[data-cm-search-drop]');
    const clearBtn = bar.querySelector<HTMLButtonElement>('[data-cm-clear]');

    const escapeHtml = (value: string): string =>
      value.replace(/[&<>"']/g, (ch) => {
        switch (ch) {
          case '&': return '&amp;';
          case '<': return '&lt;';
          case '>': return '&gt;';
          case '"': return '&quot;';
          default: return '&#39;';
        }
      });

    const closeDrop = () => {
      if (searchDrop) searchDrop.hidden = true;
    };

    // La X sólo aparece cuando hay texto escrito.
    const syncClearBtn = () => {
      if (clearBtn) clearBtn.hidden = (searchInput?.value ?? '').length === 0;
    };

    // URL del catálogo conservando la categoría activa; ?q= vacío = ver todo.
    const catalogUrl = (query: string) => {
      const category = new URLSearchParams(window.location.search).get('category');
      const term = query.trim();
      const params = new URLSearchParams();
      if (category) params.set('category', category);
      if (term) params.set('q', term);
      const qs = params.toString();
      return `/${qs ? `?${qs}` : ''}#catalogo`;
    };

    // Enter o botón de la lupa: el catálogo filtra por el término (SSR).
    const goToCatalog = (query: string) => {
      closeDrop();
      window.location.href = catalogUrl(query);
    };

    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      goToCatalog(searchInput?.value ?? '');
    });

    // X: borra lo escrito y quita el filtro del catálogo si estaba aplicado.
    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      syncClearBtn();
      const hasQuery = new URLSearchParams(window.location.search).has('q');
      if (hasQuery) {
        window.location.href = catalogUrl('');
      } else {
        closeDrop();
        searchInput?.focus();
      }
    });

    let dropTimer: number | undefined;
    let lastQuery = '';

    const renderDropStatus = (message: string) => {
      if (!searchDrop) return;
      searchDrop.innerHTML = `<p class="cm-drop-status">${escapeHtml(message)}</p>`;
      searchDrop.hidden = false;
    };

    const runCascade = async (raw: string) => {
      const q = raw.trim();
      if (q.length < 2) {
        closeDrop();
        return;
      }
      if (q === lastQuery && searchDrop && !searchDrop.hidden) return;
      lastQuery = q;
      renderDropStatus('Buscando…');
      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(q)}&limit=5`);
        const data = await res.json();
        if (!data?.success) throw new Error('search failed');
        const hits: {
          slug: string; title: string; price: string; image: string;
          discountPct: number | null; url: string; merchant?: string;
        }[] = data.products ?? [];
        if (!searchDrop) return;
        if (hits.length === 0) {
          renderDropStatus(`Sin resultados para «${q}»`);
          return;
        }
        searchDrop.innerHTML = hits
          .map(
            (hit) => `
              <a class="cm-drop-item" href="${escapeHtml(hit.url)}">
                <img src="${escapeHtml(hit.image)}" alt="" loading="lazy" width="42" height="42" />
                <span class="cm-drop-body">
                  <span class="cm-drop-title">${escapeHtml(hit.title)}</span>
                  <span class="cm-drop-meta">
                    <span class="cm-drop-price">${escapeHtml(hit.price)}</span>
                    ${hit.merchant ? `<span class="cm-drop-sep" aria-hidden="true">·</span><span class="cm-drop-merchant">${escapeHtml(hit.merchant)}</span>` : ''}
                  </span>
                </span>
                ${hit.discountPct ? `<span class="cm-drop-discount">-${hit.discountPct}%</span>` : ''}
              </a>`,
          )
          .join('');
        searchDrop.hidden = false;
      } catch {
        renderDropStatus('El buscador no está disponible ahora mismo.');
      }
    };

    searchInput?.addEventListener('input', () => {
      syncClearBtn();
      window.clearTimeout(dropTimer);
      const value = searchInput.value;
      dropTimer = window.setTimeout(() => void runCascade(value), 280);
    });

    // Cerrar la cascada al pulsar fuera.
    document.addEventListener('click', (event) => {
      if (!searchDrop || searchDrop.hidden) return;
      const target = event.target as Element | null;
      if (!target || typeof target.closest !== 'function') return;
      if (!target.closest('.nav-search')) closeDrop();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closePanel();
        closeDrop();
      }
    });

    // Hidrata el buscador con ?q= (al volver al catálogo o recargar).
    const initialQuery = new URLSearchParams(window.location.search).get('q') ?? '';
    if (searchInput && initialQuery) searchInput.value = initialQuery;
    syncClearBtn();
  }
</script>
