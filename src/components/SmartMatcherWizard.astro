  }

  .smw-product-card:hover {
    border-color: rgba(59, 130, 246, 0.5);
    transform: translateY(-3px);
  }

  .smw-product-card-img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    background: #1a1a2e;
  }

  .smw-product-card-body {
    padding: 0.85rem;
  }

  .smw-product-card-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.35;
  }

  .smw-product-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .smw-product-card-price {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1rem;
    font-weight: 800;
    color: #60a5fa;
  }

  .smw-product-card-score {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.5rem;
    background: rgba(16, 185, 129, 0.12);
    border-radius: 6px;
    color: #34d399;
    font-weight: 700;
  }

  .smw-restart {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.2rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.7);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .smw-restart:hover {
    border-color: rgba(59, 130, 246, 0.5);
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .smw-wizard {
      padding: 1.25rem;
    }

    .smw-progress {
      flex-direction: column;
      gap: 0.4rem;
    }

    .smw-options {
      grid-template-columns: 1fr;
    }

    .smw-step-title {
      font-size: 1.15rem;
    }

    .smw-result-title {
      font-size: 1.3rem;
    }
