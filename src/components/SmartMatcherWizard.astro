---
/**
 * ==============================================================================
 * TRADYLOR — PERFILADOR DE COMPRA (SmartMatcherWizard)
 * ==============================================================================
 * Asistente de 3 preguntas (uso, presupuesto, prioridad) que NO recomienda
 * productos: su único resultado es el PERFIL DE COMPPRADOR. Ese perfil se
 * guarda con nombre (Mi Radar / nube) y pasa a:
 *   - aparecer en el selector de perfil del mainNav (elegir uno activo),
 *   - alimentar el badge "Encaja con tu perfil" de las tarjetas.
 * Guardarlo requiere sesión (gate de registro en el paso de resultado).
 * ==============================================================================
 */
---

<section class="smw-section" data-smart-matcher>
  <div class="smw-wizard" data-wizard>
    <div class="smw-progress" data-wizard-progress>
      <div class="smw-step-indicator is-active" data-step-indicator="0">
        <span class="smw-step-number">1</span>
        <span class="smw-step-name">Uso</span>
      </div>
      <div class="smw-step-indicator" data-step-indicator="1">
        <span class="smw-step-number">2</span>
        <span class="smw-step-name">Presupuesto</span>
      </div>
      <div class="smw-step-indicator" data-step-indicator="2">
        <span class="smw-step-number">3</span>
        <span class="smw-step-name">Prioridad</span>
      </div>
    </div>

    <div class="smw-body">
      <div class="smw-step" data-wizard-step="0">
        <h3 class="smw-step-title">¿Cuál es tu objetivo principal?</h3>
        <p class="smw-step-subtitle">Selecciona el uso que le vas a dar</p>
        <div class="smw-options">
          <button type="button" class="smw-option" data-wizard-option="usage" data-value="productividad">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></span>
            <span class="smw-option-label">Productividad</span>
            <span class="smw-option-desc">Trabajo, estudio o multitarea</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="usage" data-value="entretenimiento">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
            <span class="smw-option-label">Entretenimiento</span>
            <span class="smw-option-desc">Streaming, gaming, audio</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="usage" data-value="creatividad">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg></span>
            <span class="smw-option-label">Creatividad</span>
            <span class="smw-option-desc">Diseño, edición, creación</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="usage" data-value="hogar">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span>
            <span class="smw-option-label">Hogar Inteligente</span>
            <span class="smw-option-desc">Automatización y domótica</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="usage" data-value="movilidad">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h-2v-6l2-5h9l4 5h3v6h-2"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/><path d="M12 8V4H8"/></svg></span>
            <span class="smw-option-label">Movilidad</span>
            <span class="smw-option-desc">Portátiles, wearables, transporte</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="usage" data-value="fitness">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5l11 11"/><path d="M21 21l-1-1"/><path d="M3 3l1 1"/><path d="M18 22l4-4"/><path d="M2 6l4-4"/><path d="M3 10l7-7"/><path d="M14 21l7-7"/></svg></span>
            <span class="smw-option-label">Fitness y Salud</span>
            <span class="smw-option-desc">Wearables, salud, bienestar</span>
          </button>
        </div>
      </div>

      <div class="smw-step" data-wizard-step="1" hidden>
        <h3 class="smw-step-title">¿Cuál es tu presupuesto?</h3>
        <p class="smw-step-subtitle">Elige el rango que más se acerca</p>
        <div class="smw-options">
          <button type="button" class="smw-option" data-wizard-option="budget" data-value="low">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
            <span class="smw-option-label">Hasta 100€</span>
            <span class="smw-option-desc">Calidad esencial, gran valor</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="budget" data-value="mid">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
            <span class="smw-option-label">100€ – 400€</span>
            <span class="smw-option-desc">Equilibrio perfecto calidad-precio</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="budget" data-value="high">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
            <span class="smw-option-label">400€ – 1000€</span>
            <span class="smw-option-desc">Prestaciones profesionales</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="budget" data-value="premium">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
            <span class="smw-option-label">Más de 1000€</span>
            <span class="smw-option-desc">Sin límites, lo mejor del mercado</span>
          </button>
        </div>
      </div>

      <div class="smw-step" data-wizard-step="2" hidden>
        <h3 class="smw-step-title">¿Qué priorizas más?</h3>
        <p class="smw-step-subtitle">Tu decisión final nos da la clave</p>
        <div class="smw-options">
          <button type="button" class="smw-option" data-wizard-option="priority" data-value="price">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></span>
            <span class="smw-option-label">Precio</span>
            <span class="smw-option-desc">Maximizar el ahorro y la oferta</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="priority" data-value="quality">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>
            <span class="smw-option-label">Calidad / Durabilidad</span>
            <span class="smw-option-desc">Lo mejor aunque cueste más</span>
          </button>
          <button type="button" class="smw-option" data-wizard-option="priority" data-value="balance">
            <span class="smw-option-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M5 8l7-5 7 5"/><path d="M5 16l7 5 7-5"/></svg></span>
            <span class="smw-option-label">Equilibrio</span>
            <span class="smw-option-desc">Relación calidad-precio óptima</span>
          </button>
        </div>
      </div>

      <div class="smw-result" data-wizard-result hidden>
        <div class="smw-result-badge" data-result-badge></div>
        <h3 class="smw-result-title" data-result-title></h3>
        <p class="smw-result-desc" data-result-desc></p>

        <div class="smw-result-locked" data-result-locked hidden>
          <p class="smw-locked-text">🔒 Regístrate gratis para guardar este perfil de comprador y que te acompañe en toda la web.</p>
          <button type="button" class="smw-unlock-btn" data-result-unlock>Crear cuenta gratis</button>
        </div>

        <div class="smw-save-profile" data-save-profile hidden>
          <span class="smw-save-name" data-save-profile-name></span>
          <button type="button" class="smw-save-btn" data-save-profile-btn>💾 Guardar mi perfil</button>
        </div>
        <p class="smw-save-note" data-save-profile-note aria-live="polite"></p>

        <button type="button" class="smw-restart" data-wizard-restart>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          Empezar de nuevo
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .smw-section {
    padding: 0;
  }

  .smw-wizard {
    background: linear-gradient(160deg, rgba(59, 130, 246, 0.05) 0%, rgba(17, 24, 39, 0.8) 100%);
    border: 1px solid rgba(59, 130, 246, 0.18);
    border-radius: 20px;
    padding: 2rem;
  }

  .smw-progress {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .smw-step-indicator {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .smw-step-indicator.is-active {
    border-color: rgba(59, 130, 246, 0.5);
    background: rgba(59, 130, 246, 0.1);
  }

  .smw-step-indicator.is-done {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.08);
  }

  .smw-step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .smw-step-indicator.is-active .smw-step-number {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: #ffffff;
  }

  .smw-step-indicator.is-done .smw-step-number {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #ffffff;
  }

  .smw-step-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .smw-step-indicator.is-active .smw-step-name {
    color: #93c5fd;
  }

  .smw-step-indicator.is-done .smw-step-name {
    color: #6ee7b7;
  }

  .smw-step-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.35rem;
    text-align: center;
  }

  .smw-step-subtitle {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.92rem;
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .smw-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .smw-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.1rem 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    cursor: pointer;
    text-align: center;
    font-family: inherit;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }

  .smw-option:hover {
    border-color: rgba(59, 130, 246, 0.5);
    background: rgba(59, 130, 246, 0.08);
    transform: translateY(-3px);
  }

  .smw-option-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(59, 130, 246, 0.12);
    color: #60a5fa;
    margin-bottom: 0.25rem;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .smw-option:hover .smw-option-icon {
    background: rgba(59, 130, 246, 0.22);
    transform: scale(1.08);
  }

  .smw-option-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
  }

  .smw-option-desc {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.35;
  }

  .smw-result {
    text-align: center;
    padding: 1rem 0;
  }

  .smw-result-locked {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    background: rgba(245, 158, 11, 0.07);
    border: 1px solid rgba(245, 158, 11, 0.28);
    border-radius: 16px;
  }

  .smw-result-locked[hidden] {
    display: none;
  }

  .smw-locked-text {
    margin: 0;
    font-size: 0.9rem;
    color: #fbbf24;
    max-width: 440px;
  }

  .smw-unlock-btn {
    padding: 0.65rem 1.4rem;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #1a1205;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 800;
    border: 0;
    border-radius: 10px;
    cursor: pointer;
  }

  .smw-save-profile {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 480px;
    margin: 0 auto 0.6rem;
  }

  .smw-save-profile[hidden] {
    display: none;
  }

  .smw-save-name {
    flex: 1;
    font-size: 0.85rem;
    color: #e5e7eb;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .smw-save-btn {
    flex-shrink: 0;
    padding: 0.65rem 1rem;
    background: rgba(16, 185, 129, 0.16);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 10px;
    cursor: pointer;
    white-space: nowrap;
  }

  .smw-save-btn:hover {
    background: rgba(16, 185, 129, 0.26);
  }

  .smw-save-note {
    min-height: 1em;
    margin: 0 0 1rem;
    font-size: 0.78rem;
    color: #6ee7b7;
  }

  .smw-result-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #052e22;
    background: linear-gradient(135deg, #34d399, #10b981);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .smw-result-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.75rem;
  }

  .smw-result-desc {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto 1.5rem;
  }

  .smw-restart {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.2rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.7);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .smw-restart:hover {
    border-color: rgba(59, 130, 246, 0.5);
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .smw-wizard {
      padding: 1.25rem;
    }

    .smw-progress {
      flex-direction: column;
      gap: 0.4rem;
    }

    .smw-options {
      grid-template-columns: 1fr;
    }

    .smw-step-title {
      font-size: 1.15rem;
    }

    .smw-result-title {
      font-size: 1.3rem;
    }
  }
</style>

<script>
  import { getSession } from '../utils/auth';
  import { saveBuyerProfile, getBuyerProfiles } from '../utils/radarStore';
  import { BUYER_PROFILE_BUDGET_LABELS, BUYER_PROFILE_PRIORITY_LABELS, BUYER_PROFILE_USAGE_LABELS, buyerProfileDisplayName } from '../types/radar';

  const PENDING_QUIZ_KEY = 'tradylor-pending-quiz';

  function stashPendingQuizAnswers(answers: Record<string, string>): void {
    try {
      sessionStorage.setItem(PENDING_QUIZ_KEY, JSON.stringify(answers));
    } catch {
      /* sin sessionStorage (modo privado): el usuario repetirá el quiz tras registrarse */
    }
  }

  function readPendingQuizAnswers(): Record<string, string> | null {
    try {
      const raw = sessionStorage.getItem(PENDING_QUIZ_KEY);
      return raw ? (JSON.parse(raw) as Record<string, string>) : null;
    } catch {
      return null;
    }
  }

  function clearPendingQuizAnswers(): void {
    try {
      sessionStorage.removeItem(PENDING_QUIZ_KEY);
    } catch {
      /* no-op */
    }
  }

  (() => {
  const initWizard = () => {
    const root = document.querySelector<HTMLElement>('[data-smart-matcher]');
    if (!root) return;

    const wizard = root.querySelector<HTMLElement>('[data-wizard]');
    if (!wizard) return;

    const stepEls = wizard.querySelectorAll<HTMLElement>('[data-wizard-step]');
    const indicators = wizard.querySelectorAll<HTMLElement>('[data-step-indicator]');
    const resultEl = wizard.querySelector<HTMLElement>('[data-wizard-result]');
    const badgeEl = wizard.querySelector<HTMLElement>('[data-result-badge]');
    const titleEl = wizard.querySelector<HTMLElement>('[data-result-title]');
    const descEl = wizard.querySelector<HTMLElement>('[data-result-desc]');
    const restartBtn = wizard.querySelector<HTMLButtonElement>('[data-wizard-restart]');
    const resultLockedEl = wizard.querySelector<HTMLElement>('[data-result-locked]');
    const resultUnlockBtn = wizard.querySelector<HTMLButtonElement>('[data-result-unlock]');
    const saveProfileWrap = wizard.querySelector<HTMLElement>('[data-save-profile]');
    const saveProfileName = wizard.querySelector<HTMLElement>('[data-save-profile-name]');
    const saveProfileBtn = wizard.querySelector<HTMLButtonElement>('[data-save-profile-btn]');
    const saveProfileNote = wizard.querySelector<HTMLElement>('[data-save-profile-note]');

    let currentStep = 0;
    const answers: Record<string, string> = {};

    const showStep = (index: number) => {
      stepEls.forEach((el, i) => {
        el.hidden = i !== index;
      });
      indicators.forEach((el, i) => {
        el.classList.toggle('is-active', i === index);
        el.classList.toggle('is-done', i < index);
      });
      currentStep = index;
    };

    /**
     * El resultado del Perfilador es SOLO el perfil (resumen delas3 respuestas):
     * no se recomienda ningún producto aquí. El perfil guardado luego alimenta
     * el selector del mainNav y el badge "Encaja con tu perfil".
     */
    const showResult = async () => {
      stashPendingQuizAnswers(answers);

      stepEls.forEach((el) => { el.hidden = true; });
      indicators.forEach((el) => {
        el.classList.remove('is-active');
        el.classList.add('is-done');
      });

      const session = await getSession().catch(() => ({ authenticated: false, user: null, googleEnabled: false }));
      const isLogged = Boolean(session.user);

      if (badgeEl && titleEl && descEl) {
        const usageLabel = BUYER_PROFILE_USAGE_LABELS[answers.usage || 'productividad'] ?? 'Productividad';
        const budgetLabel = BUYER_PROFILE_BUDGET_LABELS[answers.budget || 'mid'] ?? 'Moderado';
        const priorityLabel = BUYER_PROFILE_PRIORITY_LABELS[answers.priority || 'balance'] ?? 'Equilibrio';

        badgeEl.textContent = 'Tu perfil de comprador';
        titleEl.textContent = `${usageLabel} · ${budgetLabel} · ${priorityLabel}`;
        descEl.textContent = 'Este es el perfil que guardaremos con el nombre generado a partir de tus respuestas. Lo usamos para el marcado visual en el catálogo y para que puedas cambiar de perfil desde la barra superior cuando quieras.';
        if (saveProfileName) {
          saveProfileName.textContent = buyerProfileDisplayName({
            usage: answers.usage || 'productividad',
            budget: answers.budget || 'mid',
            priority: answers.priority || 'balance',
          });
        }
      }

      // Gate de registro: guardar el perfil (y que te acompañe en la web) requiere sesión.
      if (resultLockedEl) resultLockedEl.hidden = isLogged;
      if (saveProfileWrap) saveProfileWrap.hidden = !isLogged;
      if (saveProfileNote) saveProfileNote.textContent = '';

      if (resultEl) resultEl.hidden = false;
    };

    resultUnlockBtn?.addEventListener('click', () => {
      const w = window as unknown as Record<string, { open?: (view?: string, context?: string) => void } | undefined>;
      w.TradylorAuth?.open?.('register', 'buyer-profile');
    });

    saveProfileBtn?.addEventListener('click', () => {
      saveBuyerProfile({
        usage: answers.usage || 'productividad',
        budget: answers.budget || 'mid',
        priority: answers.priority || 'balance',
      });
      if (saveProfileNote) {
        const total = getBuyerProfiles().length;
        saveProfileNote.textContent = `✓ Perfil guardado${total > 1 ? ` (llevas ${total})` : ''}. Ya aparece en el selector de perfil de la barra superior y se marca en el catálogo.`;
      }
    });

    wizard.querySelectorAll<HTMLButtonElement>('[data-wizard-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const field = btn.dataset.wizardOption;
        const value = btn.dataset.value;
        if (!field || !value) return;

        answers[field] = value;

        const siblings = wizard.querySelectorAll<HTMLButtonElement>(`[data-wizard-option="${field}"]`);
        siblings.forEach((s) => s.classList.remove('is-selected'));
        btn.classList.add('is-selected');

        if (currentStep < 2) {
          showStep(currentStep + 1);
        } else {
          showResult();
        }
      });
    });

    restartBtn?.addEventListener('click', () => {
      Object.keys(answers).forEach((key) => { delete answers[key]; });
      wizard.querySelectorAll('.smw-option.is-selected').forEach((el) => el.classList.remove('is-selected'));
      if (resultEl) resultEl.hidden = true;
      showStep(0);
    });

    showStep(0);

    // Si el usuario completó el quiz sin sesión, se guarda en sessionStorage
    // (stashPendingQuizAnswers) para poder desbloquear el resultado nada más
    // iniciar sesión (el modal de registro redirige a esta misma página).
    void (async () => {
      const pending = readPendingQuizAnswers();
      if (!pending) return;
      const session = await getSession().catch(() => ({ authenticated: false, user: null, googleEnabled: false }));
      if (!session.user) return;
      Object.assign(answers, pending);
      indicators.forEach((el) => el.classList.add('is-done'));
      clearPendingQuizAnswers();
      void showResult();
    })();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWizard);
  } else {
    initWizard();
  }
  })();
</script>
