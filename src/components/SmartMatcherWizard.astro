</style>

<script>
  (() => {
  interface SmartProduct {
    id: string;
    title: string;
    price: number;
    originalPrice?: number;
    image: string;
    category: string;
    rating?: number;
    reviewsCount?: number;
    conversionScore: number;
    pros: string[];
    cons: string[];
    slug?: string;
  }

  const initWizard = () => {
    const root = document.querySelector<HTMLElement>('[data-smart-matcher]');
    if (!root) return;

    const wizard = root.querySelector<HTMLElement>('[data-wizard]');
    if (!wizard) return;

    const products: SmartProduct[] = window.__smartMatcherProducts || [];
    const stepEls = wizard.querySelectorAll<HTMLElement>('[data-wizard-step]');
    const indicators = wizard.querySelectorAll<HTMLElement>('[data-step-indicator]');
    const resultEl = wizard.querySelector<HTMLElement>('[data-wizard-result]');
    const badgeEl = wizard.querySelector<HTMLElement>('[data-result-badge]');
    const titleEl = wizard.querySelector<HTMLElement>('[data-result-title]');
    const descEl = wizard.querySelector<HTMLElement>('[data-result-desc]');
    const productsEl = wizard.querySelector<HTMLElement>('[data-result-products]');
    const restartBtn = wizard.querySelector<HTMLButtonElement>('[data-wizard-restart]');

    let currentStep = 0;
    const answers: Record<string, string> = {};

    const budgetRanges: Record<string, [number, number]> = {
      low: [0, 100],
      mid: [100, 400],
      high: [400, 1000],
      premium: [1000, Infinity],
    };

    const showStep = (index: number) => {
      stepEls.forEach((el, i) => {
        el.hidden = i !== index;
      });
      indicators.forEach((el, i) => {
        el.classList.toggle('is-active', i === index);
        el.classList.toggle('is-done', i < index);
      });
      currentStep = index;
    };

    const getRecommendations = (): SmartProduct[] => {
      const budget = answers.budget || 'mid';
      const [min, max] = budgetRanges[budget] || [0, Infinity];
      const priority = answers.priority || 'balance';

      let filtered = products.filter((p) => p.price >= min && p.price <= max);

      if (filtered.length === 0) {
        filtered = products.slice();
      }

      const sorted = filtered.sort((a, b) => {
        const scoreA = a.conversionScore;
        const scoreB = b.conversionScore;

        if (priority === 'price') {
          return a.price - b.price || scoreB - scoreA;
        }
        if (priority === 'quality') {
          return scoreB - scoreA || a.price - b.price;
        }
        return scoreB - scoreA;
      });

      return sorted.slice(0, 3);
    };

    const showResult = () => {
      const recs = getRecommendations();

      stepEls.forEach((el) => { el.hidden = true; });
      indicators.forEach((el) => {
        el.classList.remove('is-active');
        el.classList.add('is-done');
      });

      if (recs.length > 0 && badgeEl && titleEl && descEl && productsEl) {
        const priorityLabel = answers.priority === 'price' ? 'Precio' : answers.priority === 'quality' ? 'Calidad' : 'Equilibrio';
        const budgetLabel = answers.budget === 'low' ? 'económico' : answers.budget === 'mid' ? 'moderado' : answers.budget === 'high' ? 'alto' : 'premium';
        const usageLabel = answers.usage === 'productividad' ? 'productividad' : answers.usage === 'entretenimiento' ? 'entretenimiento' : answers.usage === 'creatividad' ? 'creatividad' : answers.usage === 'hogar' ? 'hogar' : answers.usage === 'movilidad' ? 'movilidad' : 'fitness';

        badgeEl.textContent = `Smart Match: ${usageLabel} · ${budgetLabel} · ${priorityLabel}`;
        titleEl.textContent = `Te recomendamos ${recs.length} op${recs.length === 1 ? 'ón' : 'ciones'} verificada${recs.length === 1 ? '' : 's'}`;
        descEl.textContent = 'Estos productos han pasado nuestro filtro de auditoría y destacan por su puntuación de conversión y calidad verificada.';
        productsEl.innerHTML = recs.map((p) => `
          <a class="smw-product-card" href="/producto/${p.slug ?? p.id}" target="_blank" rel="noopener">
            <img class="smw-product-card-img" src="${p.image}" alt="${p.title}" loading="lazy" />
            <div class="smw-product-card-body">
              <div class="smw-product-card-title">${p.title}</div>
              <div class="smw-product-card-meta">
                <span class="smw-product-card-price">${new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 }).format(p.price)}</span>
                <span class="smw-product-card-score">${p.conversionScore}/100</span>
              </div>
            </div>
          </a>
        `).join('');
      }

      if (resultEl) resultEl.hidden = false;
    };

    wizard.querySelectorAll<HTMLButtonElement>('[data-wizard-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const field = btn.dataset.wizardOption;
        const value = btn.dataset.value;
        if (!field || !value) return;

        answers[field] = value;

        const siblings = wizard.querySelectorAll<HTMLButtonElement>(`[data-wizard-option="${field}"]`);
        siblings.forEach((s) => s.classList.remove('is-selected'));
        btn.classList.add('is-selected');

        if (currentStep < 2) {
          showStep(currentStep + 1);
        } else {
          showResult();
        }
      });
    });

    restartBtn?.addEventListener('click', () => {
      Object.keys(answers).forEach((key) => { delete answers[key]; });
      wizard.querySelectorAll('.smw-option.is-selected').forEach((el) => el.classList.remove('is-selected'));
      if (resultEl) resultEl.hidden = true;
      showStep(0);
    });

    showStep(0);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWizard);
  } else {
    initWizard();
  }
  })();
</script>
