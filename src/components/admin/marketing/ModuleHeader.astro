---
/**
 * Cabecera estándar de los módulos de /admin/marketing/*.
 * Kicker + título + descripción + badge de origen de datos.
 */
interface Props {
  kicker: string;
  title: string;
  description: string;
  badge?: string;
}

const { kicker, title, description, badge = 'Datos de ejemplo' } = Astro.props;
---

<header class="mb-6 border-b border-white/10 pb-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-blue-400">{kicker}</p>
      <h1 class="mt-1 text-2xl font-extrabold leading-tight text-white">{title}</h1>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-white/55">{description}</p>
    </div>
    <span
      class="shrink-0 rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-amber-200"
    >
      {badge}
    </span>
  </div>
</header>
