---
/**
 * Tarjeta estándar de los módulos placeholder de /admin/marketing/*:
 * qué mostrará el módulo + botón para probar su endpoint mock (GET).
 */
interface Props {
  endpoint: string;
  spec: string[];
  title?: string;
}

const { endpoint, spec, title = 'Qué mostrará este módulo' } = Astro.props;
---

<div class="grid gap-4 lg:grid-cols-2">
  <section class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
    <h2 class="mb-3 text-sm font-extrabold uppercase tracking-wider text-white/70">{title}</h2>
    <ul class="flex flex-col gap-2">
      {
        spec.map((line) => (
          <li class="flex gap-2 text-[13px] leading-relaxed text-white/60">
            <span class="text-blue-400">▸</span>
            <span>{line}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section data-mock-card class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-wide text-emerald-200">
          Mock
        </span>
        <code class="text-xs text-white/60" data-endpoint>{endpoint}</code>
      </div>
      <button
        type="button"
        data-probe
        class="rounded-xl border border-white/15 bg-white/[0.05] px-3.5 py-1.5 text-xs font-extrabold text-white transition hover:border-blue-400/50 hover:bg-blue-500/15 disabled:opacity-50"
      >
        Probar endpoint
      </button>
    </div>
    <p class="mb-3 text-xs leading-relaxed text-white/45">
      Sesión admin requerida (401 sin cookie · 403 sin rol). Al conectar la BD se sustituirá este JSON por datos reales
      sin cambiar el contrato.
    </p>
    <pre
      data-result
      class="max-h-72 overflow-auto whitespace-pre-wrap break-all rounded-xl border border-white/10 bg-black/40 p-3 text-[11px] leading-relaxed text-emerald-200/80">Pulsa «Probar endpoint» para ver la respuesta.</pre>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-mock-card]').forEach((card) => {
    const endpoint = card.querySelector<HTMLElement>('[data-endpoint]')?.textContent?.trim();
    const button = card.querySelector<HTMLButtonElement>('[data-probe]');
    const result = card.querySelector<HTMLElement>('[data-result]');
    if (!endpoint || !button || !result) return;
    button.addEventListener('click', async () => {
      button.disabled = true;
      result.textContent = 'Consultando…';
      try {
        const response = await fetch(endpoint, { headers: { Accept: 'application/json' } });
        const text = await response.text();
        let pretty = text;
        try {
          pretty = JSON.stringify(JSON.parse(text), null, 2);
        } catch {
          /* respuesta no JSON (p. ej. 401 HTML): se muestra tal cual */
        }
        result.textContent = `HTTP ${response.status}\n\n${pretty}`;
      } catch (error) {
        result.textContent = `Error: ${error instanceof Error ? error.message : 'fallo de red'}`;
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
