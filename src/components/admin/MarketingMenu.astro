---
/**
 * Submenú de secciones de Marketing (va pegado debajo de admin-section-nav).
 * Se usa en /admin/marketing y en cada opción del módulo.
 * Aspecto de submenú: barra ligera y centrada (el tab principal usa pills
 * sólidas; aquí el activo es un tintado suave).
 */
interface Props {
  active?: 'usuarios' | 'market-map' | 'calendario' | 'market-action' | 'tendencias';
}

const { active } = Astro.props;

const OPTIONS = [
  { id: 'usuarios', href: '/admin/marketing/usuarios', label: 'Usuarios' },
  { id: 'market-map', href: '/admin/marketing/market-map', label: 'Market Map' },
  { id: 'calendario', href: '/admin/marketing/calendario', label: 'Calendario' },
  { id: 'market-action', href: '/admin/marketing/market-action', label: 'Market Action' },
  { id: 'tendencias', href: '/admin/marketing/tendencias', label: 'Tendencias' },
] as const;
---

<nav class="marketing-submenu" aria-label="Submenú de Marketing">
  {
    OPTIONS.map((option) => (
      <a
        class:list={['marketing-submenu-item', { 'is-active': active === option.id }]}
        href={option.href}
        aria-current={active === option.id ? 'page' : undefined}
      >
        {option.label}
      </a>
    ))
  }
</nav>

<style>
  .marketing-submenu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    /* El wrapper usa gap: 2rem entre bloques: lo subimos para pegarlo al nav. */
    margin-top: -1.6rem;
  }

  .marketing-submenu-item {
    padding: 0.32rem 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 9999px;
    transition: color 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }

  .marketing-submenu-item:hover {
    color: var(--color-text-main);
    background: rgba(255, 255, 255, 0.05);
  }

  .marketing-submenu-item.is-active {
    color: #93c5fd;
    background: rgba(96, 165, 250, 0.12);
    border-color: rgba(96, 165, 250, 0.35);
  }
</style>
