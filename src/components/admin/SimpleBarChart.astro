---
/**
 * TRADYLOR — Gráfico de barras horizontales (Módulo Tráfico y Ventas)
 * Barras proporcionales al valor máximo de la serie. Sirve para fuentes de
 * tráfico, productos más visitados o cualquier ranking simplificado.
 */
export interface BarraItem {
  etiqueta: string;
  /** Valor absoluto; la anchura de la barra es valor / máximo de la serie. */
  valor: number;
  /** Texto mostrado a la derecha (si no se indica se muestra el valor). */
  texto?: string;
  /** Color hex de la barra. */
  color?: string;
}

export interface Props {
  titulo: string;
  subtitulo?: string;
  items: BarraItem[];
  ayuda?: string;
}

const { titulo, subtitulo, items, ayuda } = Astro.props;

const maximo = items.length > 0 ? Math.max(...items.map((item) => item.valor)) : 0;
const fmt = new Intl.NumberFormat('es-ES');
---

<div class="flex min-w-0 flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-5">
  <div class="group/help flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="text-sm font-extrabold uppercase tracking-wider text-white">{titulo}</h3>
      {subtitulo && <p class="mt-1 text-xs leading-relaxed text-slate-400">{subtitulo}</p>}
    </div>
    {ayuda && (
      <span class="relative flex h-5 w-5 shrink-0 cursor-help items-center justify-center rounded-full border border-white/15 bg-white/5 text-[11px] font-bold text-slate-400 transition hover:border-sky-400 hover:text-sky-300" tabindex="0" aria-label={`Ayuda: ${titulo}`}>
        ?
        <span class="pointer-events-none absolute right-0 top-full z-30 mt-2 w-60 rounded-lg border border-sky-500/30 bg-slate-950 px-3 py-2 text-left text-xs font-normal normal-case leading-relaxed tracking-normal text-slate-300 opacity-0 shadow-xl transition group-hover/help:opacity-100 group-focus-within/help:opacity-100" role="tooltip">
          {ayuda}
        </span>
      </span>
    )}
  </div>

  <ul class="mt-5 flex flex-col gap-3.5">
    {items.map((item) => {
      const pct = maximo > 0 ? Math.max(Math.round((item.valor / maximo) * 100), 4) : 0;
      return (
        <li class="flex flex-col gap-1">
          <div class="flex items-baseline justify-between gap-3">
            <span class="truncate text-xs font-semibold text-slate-300">{item.etiqueta}</span>
            <span class="shrink-0 text-xs font-extrabold text-white">{item.texto ?? fmt.format(item.valor)}</span>
          </div>
          <div class="h-2.5 overflow-hidden rounded-full bg-white/[0.06]">
            <div class="h-full rounded-full transition-[width] duration-700" style={`width:${pct}%; background:${item.color ?? '#38bdf8'}`}></div>
          </div>
        </li>
      );
    })}
  </ul>
</div>
