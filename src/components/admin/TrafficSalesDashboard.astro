---
/**
 * TRADYLOR — Cuerpo del dashboard "Tráfico y Ventas"
 * Se muestra dentro de /admin (sección analytics) y también en la ruta propia
 * /admin/trafico-ventas/. Datos reales del tracker propio (analytics.ts +
 * analyticsMonths.ts) + histórico mensual consultable + exportación XLSX +
 * reinicio de medición. Tooltips del glosario src/data/metricasGlosario.ts.
 */
import MetricCard from './MetricCard.astro';
import SimpleBarChart from './SimpleBarChart.astro';
import ProductMetricsTable from './ProductMetricsTable.astro';
import PeriodPicker, { type SeleccionPeriodo } from './PeriodPicker.astro';
import IpExclusionManager from './IpExclusionManager.astro';
import {
  formatValor,
  type FormatoValor,
  type ProductoMetrico,
} from '../../data/mockAnalytics';
import { getMetrica } from '../../data/metricasGlosario';
import { getIgnoredIps } from '../../lib/analytics';
import {
  getFechasConDatos,
  getMesesAnalitica,
  getPeriodoDashboard,
  getPeriodoRango,
} from '../../lib/analyticsMonths';
import { getPeriodoOptimo } from '../../lib/analyticsOptimo';
import { getAllRadarUsers } from '../../lib/radarAuth';

const fmtNum = new Intl.NumberFormat('es-ES');

const params = Astro.url.searchParams;
const esOptimo = params.get('optimo') === '1';

/** Query base que deben conservar el calendario y el conmutador. */
function queryBase(incluirOptimo: boolean): string {
  const q = new URLSearchParams();
  if (params.has('section')) q.set('section', params.get('section')!);
  if (incluirOptimo && esOptimo) q.set('optimo', '1');
  const s = q.toString();
  return s ? `?${s}` : '';
}

const MESES_CORTOS = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

interface ResolucionPeriodo {
  periodo: ReturnType<typeof getPeriodoDashboard>;
  seleccion: SeleccionPeriodo;
  etiquetaPeriodo: string;
}

/** Resuelve los query params del calendario a un periodo + etiqueta. */
function resolverPeriodo(): ResolucionPeriodo {
  const dia = params.get('dia');
  const mes = params.get('mes');
  const anio = params.get('anio');
  const diasRaw = params.get('dias');

  const construir = (desde: string, hasta: string, seleccion: SeleccionPeriodo, etiqueta: string): ResolucionPeriodo => ({
    periodo: esOptimo ? getPeriodoOptimo(desde, hasta) : getPeriodoRango(desde, hasta),
    seleccion,
    etiquetaPeriodo: etiqueta,
  });

  if (dia && /^\d{4}-\d{2}-\d{2}$/.test(dia)) {
    const [y, m, d] = dia.split('-');
    return construir(dia, dia,
      { tipo: 'dia', valor: dia, etiqueta: `${Number(d)} ${MESES_CORTOS[Number(m) - 1]} ${y}` },
      `el día ${Number(d)} de ${MESES_CORTOS[Number(m) - 1]} de ${y}`);
  }
  if (mes && /^\d{4}-\d{2}$/.test(mes)) {
    const [y, m] = mes.split('-');
    const ultimo = new Date(Number(y), Number(m), 0).getDate();
    return construir(`${mes}-01`, `${mes}-${ultimo}`,
      { tipo: 'mes', valor: mes, etiqueta: `${MESES_CORTOS[Number(m) - 1]} ${y}` },
      `de ${MESES_CORTOS[Number(m) - 1]} de ${y}`);
  }
  if (anio && /^\d{4}$/.test(anio)) {
    return construir(`${anio}-01-01`, `${anio}-12-31`,
      { tipo: 'anio', valor: anio, etiqueta: `Año ${anio}` },
      `del año ${anio}`);
  }

  const n = [7, 30, 90, 365].includes(Number(diasRaw)) ? Number(diasRaw) : 30;
  if (esOptimo) {
    const hoy = new Date();
    const hasta = hoy.toISOString().slice(0, 10);
    const desde = new Date(hoy.getTime() - (n - 1) * 86_400_000).toISOString().slice(0, 10);
    return construir(desde, hasta,
      { tipo: 'dias', valor: String(n), etiqueta: n === 365 ? 'Último año' : `Últimos ${n} días` },
      `de los últimos ${n} días`);
  }
  return {
    periodo: getPeriodoDashboard(n),
    seleccion: { tipo: 'dias', valor: String(n), etiqueta: n === 365 ? 'Último año' : `Últimos ${n} días` },
    etiquetaPeriodo: `de los últimos ${n} días`,
  };
}

const { periodo, seleccion, etiquetaPeriodo } = resolverPeriodo();
const fechas = getFechasConDatos();
const resumen = getMesesAnalitica();
const ignoredIps = getIgnoredIps();

/** URL del conmutador: añade o quita `optimo=1` conservando el periodo. */
function urlConmutador(): string {
  const q = new URLSearchParams();
  for (const k of ['dia', 'mes', 'anio', 'dias']) {
    if (params.has(k)) q.set(k, params.get(k)!);
  }
  if (params.has('section')) q.set('section', params.get('section')!);
  if (!esOptimo) q.set('optimo', '1');
  return `?${q.toString()}`;
}

const variacion = (actual: number, anterior: number): number => {
  if (!anterior) return actual > 0 ? 100 : 0;
  return ((actual - anterior) / anterior) * 100;
};

interface FichaMetrica {
  etiqueta: string;
  valor: number;
  formato: FormatoValor;
  variacion: number;
  favorable: boolean;
  glosarioId: string;
  /** Línea secundaria opcional (contexto adicional bajo la tarjeta). */
  nota?: string;
}

const m = periodo.actual;
const a = periodo.anterior;
const registradosRadar = getAllRadarUsers().length;
const fichas: FichaMetrica[] = [
  { etiqueta: 'Sesiones', valor: m.sesiones, formato: 'numero', variacion: variacion(m.sesiones, a.sesiones), favorable: true, glosarioId: 'sesiones' },
  {
    etiqueta: 'Usuarios únicos',
    valor: m.usuariosUnicos,
    formato: 'numero',
    variacion: variacion(m.usuariosUnicos, a.usuariosUnicos),
    favorable: true,
    glosarioId: 'usuarios-unicos',
    // Esto NO son cuentas: es cualquier navegador/dispositivo distinto que haya
    // pasado por la web. Se aclara aquí porque es la confusión más habitual
    // ("¿por qué hay miles de 'usuarios' si sólo hay 3-4 personas registradas?").
    nota: esOptimo ? undefined : `De los que ${fmtNum.format(registradosRadar)} tienen cuenta registrada en Mi Radar.`,
  },
  { etiqueta: 'Páginas / sesión', valor: m.paginasPorSesion, formato: 'decimal', variacion: variacion(m.paginasPorSesion, a.paginasPorSesion), favorable: true, glosarioId: 'paginas-por-sesion' },
  { etiqueta: 'Permanencia media', valor: m.permanenciaMediaSeg, formato: 'duracion', variacion: variacion(m.permanenciaMediaSeg, a.permanenciaMediaSeg), favorable: true, glosarioId: 'permanencia' },
  { etiqueta: 'Tasa de rebote', valor: m.rebotePct, formato: 'percent', variacion: variacion(m.rebotePct, a.rebotePct), favorable: m.rebotePct <= a.rebotePct, glosarioId: 'tasa-rebote' },
  { etiqueta: 'Visitas', valor: m.visitas, formato: 'numero', variacion: variacion(m.visitas, a.visitas), favorable: true, glosarioId: 'visualizaciones-producto' },
  { etiqueta: 'Salidas a tienda', valor: m.salidas, formato: 'numero', variacion: variacion(m.salidas, a.salidas), favorable: true, glosarioId: 'friccion-venta' },
  { etiqueta: 'Tasa de conversión', valor: m.conversionPct, formato: 'percent', variacion: variacion(m.conversionPct, a.conversionPct), favorable: true, glosarioId: 'tasa-conversion' },
  { etiqueta: 'Valor medio del pedido', valor: m.aov, formato: 'moneda', variacion: variacion(m.aov, a.aov), favorable: true, glosarioId: 'aov' },
];

const COLORES_FUENTE: Record<string, string> = {
  organico: '#38bdf8',
  directo: '#34d399',
  social: '#a78bfa',
  referido: '#fbbf24',
  email: '#fb7185',
  otros: '#94a3b8',
};
const barrasFuentes = periodo.fuentes.map((fuente) => ({
  etiqueta: fuente.etiqueta,
  valor: fuente.porcentaje,
  texto: `${fuente.porcentaje.toFixed(1).replace('.', ',')}% · ${fmtNum.format(fuente.sesiones)} ses.`,
  color: COLORES_FUENTE[fuente.id] ?? COLORES_FUENTE.otros,
}));

const evolucion = periodo.evolucion;
const barrasTop = periodo.topProductos.slice(0, 5).map((producto, index) => ({
  etiqueta: producto.titulo,
  valor: producto.visitas,
  texto: fmtNum.format(producto.visitas),
  color: index < 3 ? '#38bdf8' : '#475569',
}));

// Dominios reales detrás de las 5 fuentes agregadas (p.ej. "google.com" en vez
// de sólo "Orgánico"), para auditar de dónde viene el tráfico de verdad.
const barrasReferrers = (periodo.topReferrers ?? []).map((referrer, index) => ({
  etiqueta: referrer.host,
  valor: referrer.sesiones,
  texto: `${fmtNum.format(referrer.sesiones)} ses. · ${referrer.porcentaje.toFixed(1).replace('.', ',')}%`,
  color: index < 3 ? '#38bdf8' : '#475569',
}));

const maxVisitas = evolucion.length ? Math.max(...evolucion.map((punto) => punto.visitas)) : 0;
const totalVisitas = evolucion.reduce((suma, punto) => suma + punto.visitas, 0);
const maxDia = evolucion.length
  ? evolucion.reduce((mejor, punto) => (punto.visitas > mejor.visitas ? punto : mejor), evolucion[0])
  : { etiqueta: '—', visitas: 0 };

/** Métricas seleccionables en el gráfico "Evolución diaria" (ver script al final del fichero). */
const METRICAS_EVOLUCION = [
  { id: 'visitas', label: 'Visitas', percent: false, desde: '#0284c7', hasta: '#7dd3fc' },
  { id: 'sesiones', label: 'Sesiones', percent: false, desde: '#7c3aed', hasta: '#c4b5fd' },
  { id: 'salidas', label: 'Salidas', percent: false, desde: '#d97706', hasta: '#fcd34d' },
  { id: 'compras', label: 'Compras', percent: false, desde: '#059669', hasta: '#6ee7b7' },
  { id: 'conversionpct', label: 'Conversión %', percent: true, desde: '#e11d48', hasta: '#fda4af' },
] as const;

const productosTabla: ProductoMetrico[] = (periodo.productosCompletos ?? periodo.topProductos).map((producto) => {
  const estado: ProductoMetrico['estado'] =
    producto.tasa >= 4 ? 'alta' : producto.tasa >= 2.5 ? 'estable' : 'friccion';
  return {
    id: producto.productId,
    titulo: producto.titulo,
    red: 'Tracker propio',
    visitas: producto.visitas,
    conversiones: producto.salidas,
    tasaConversion: producto.tasa,
    estado,
    nota: `${fmtNum.format(producto.salidas)} salidas · ${fmtNum.format(producto.compras)} compras`,
  };
});

const sinDatos = m.visitas === 0 && m.sesiones === 0;
const enCurso = resumen.meses[0]?.month ?? '';
---

<div class="flex flex-col gap-9">
  <!-- 1. Resumen global -->
  <section class="flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-base font-extrabold uppercase tracking-wider text-white">
          {esOptimo ? 'Métrica óptima (ficticia)' : 'Resumen global'}
        </h2>
        <p class="mt-1 text-xs text-slate-400">
          {esOptimo
            ? `Estimación de tráfico óptimo ${etiquetaPeriodo} para un portal de afiliación de éxito. Datos ficticios de referencia.`
            : `Indicadores reales ${etiquetaPeriodo} frente al periodo anterior.`}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a
          href={urlConmutador()}
          class:list={[
            'flex items-center gap-1.5 rounded-full border px-4 py-1.5 text-[11px] font-extrabold uppercase tracking-wider transition',
            esOptimo
              ? 'border-emerald-500/40 bg-emerald-500/15 text-emerald-300 hover:bg-emerald-500/25'
              : 'border-violet-500/30 bg-violet-500/10 text-violet-300 hover:bg-violet-500/20',
          ]}
        >
          {esOptimo ? (
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          ) : (
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2v20M2 12h20"></path>
              <circle cx="12" cy="12" r="9"></circle>
            </svg>
          )}
          <span>{esOptimo ? 'Ver datos reales' : 'Métrica óptima'}</span>
          <span class="relative flex h-4 w-4 items-center justify-center rounded-full border border-white/20 bg-white/5 text-[9px] font-bold" tabindex="0" aria-label="Ayuda: métrica óptima">
            ?
            <span class="pointer-events-none absolute right-0 top-full z-30 mt-2 w-64 rounded-lg border border-violet-500/30 bg-slate-950 px-3 py-2 text-left text-xs font-normal normal-case leading-relaxed tracking-normal text-slate-300 opacity-0 shadow-xl transition" role="tooltip">
              {esOptimo
                ? 'Estás viendo datos ficticios de referencia (tráfico óptimo). Pulsa para volver a los datos reales.'
                : 'Muestra un escenario óptimo ficticio con tráfico coherente para un portal de afiliación de éxito. Pulsa el calendario para ver cualquier día, mes o año.'}
            </span>
          </span>
        </a>
        <PeriodPicker seleccion={seleccion} fechas={fechas} basePath={Astro.url.pathname} queryExtra={queryBase(true)} />
      </div>
    </div>

    {esOptimo && (
      <div class="rounded-2xl border border-violet-500/30 bg-violet-500/10 px-4 py-3 text-xs leading-relaxed text-violet-200">
        <strong class="font-extrabold">Métrica óptima:</strong> estos números son una simulación ficticia pero coherente
        del tráfico que tendría un portal de afiliación rentable (estacionalidad semanal, crecimiento suave y reparto de
        fuentes realista). Sirven como meta de referencia; no son datos reales.
      </div>
    )}

    {!esOptimo && sinDatos && (
      <div class="rounded-2xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-xs leading-relaxed text-amber-200">
        Aún no hay visitas reales registradas. Las métricas empezarán a rellenarse
        automáticamente con las visitas a fichas de producto, clics de salida a
        tienda y compras. Pulsa «Métrica óptima» para ver un escenario de referencia.
      </div>
    )}

    {!esOptimo && <IpExclusionManager />}

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {fichas.map((ficha) => (
        <MetricCard
          etiqueta={ficha.etiqueta}
          valor={formatValor(ficha.valor, ficha.formato)}
          variacion={ficha.variacion}
          favorable={ficha.favorable}
          ayuda={getMetrica(ficha.glosarioId)?.definicionCorta}
          periodo={seleccion.etiqueta}
          nota={ficha.nota}
        />
      ))}
    </div>
  </section>

  <!-- 2. Evolución diaria (ancho completo: más tamaño y un selector de métrica
       para ver visitas, sesiones, salidas, compras o conversión en el mismo
       gráfico, todo con datos reales del tracker propio). -->
  <section class="flex flex-col gap-4">
    <div class="flex min-w-0 flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-5 lg:p-6" data-evolucion-chart>
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-base font-extrabold uppercase tracking-wider text-white">Evolución diaria</h3>
          <p class="mt-1 text-xs leading-relaxed text-slate-400">
            {evolucion.length === 1 ? 'Último día' : `Últimos ${evolucion.length} días`} del periodo ·{' '}
            <span data-eje-total>{fmtNum.format(totalVisitas)}</span> <span data-eje-total-label>visitas</span>
          </p>
        </div>
        <span class="rounded-full border border-emerald-500/30 bg-emerald-500/15 px-2.5 py-1 text-[11px] font-extrabold text-emerald-300" data-eje-mejor>
          Mejor día: {maxDia.etiqueta} ({fmtNum.format(maxDia.visitas)})
        </span>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2" role="tablist" aria-label="Métrica del gráfico de evolución">
        {METRICAS_EVOLUCION.map((metrica, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-eje-tab={metrica.id}
            data-label={metrica.label}
            data-percent={metrica.percent ? '1' : ''}
            class:list={[
              'rounded-full border px-3.5 py-1.5 text-[11px] font-extrabold uppercase tracking-wider transition',
              index === 0
                ? 'border-sky-400 bg-sky-500 text-slate-950'
                : 'border-white/10 bg-white/5 text-slate-300 hover:border-sky-500/40 hover:text-white',
            ]}
          >
            {metrica.label}
          </button>
        ))}
      </div>

      {evolucion.length === 0 ? (
        <p class="mt-10 flex h-64 items-center justify-center text-xs text-slate-500">Sin datos en el periodo seleccionado.</p>
      ) : (
        <div class="mt-6 flex h-64 items-stretch gap-1.5 lg:h-72" data-eje-bars>
          {evolucion.map((punto) => {
            const pct = maxVisitas > 0 ? Math.max(Math.round((punto.visitas / maxVisitas) * 100), 8) : 0;
            return (
              <div
                class="group/bar flex min-w-0 flex-1 flex-col items-center gap-1.5"
                data-bar
                data-etiqueta={punto.etiqueta}
                data-m-visitas={punto.visitas}
                data-m-sesiones={punto.sesiones}
                data-m-salidas={punto.salidas}
                data-m-compras={punto.compras}
                data-m-conversionpct={punto.conversionPct}
                title={`${punto.etiqueta}: ${fmtNum.format(punto.visitas)} visitas`}
              >
                <span class="text-[10px] font-bold text-slate-400 opacity-0 transition group-hover/bar:opacity-100" data-bar-value>
                  {fmtNum.format(punto.visitas)}
                </span>
                {/* Track con altura definida (flex-1 bajo items-stretch): el relleno
                    de abajo (height:%) se apoyaba antes directamente en este flex-col
                    de altura automática, que SIEMPRE resuelve los porcentajes a 0 px
                    (por eso no se veía ninguna barra aunque hubiera datos). */}
                <div class="relative w-full flex-1">
                  <div
                    class="absolute inset-x-0 bottom-0 rounded-t-md transition-[height]"
                    style={`height:${pct}%; background:linear-gradient(to top, #0284c7, #7dd3fc)`}
                    data-bar-fill
                  ></div>
                </div>
                <span class="text-[9px] text-slate-500">{punto.etiqueta}</span>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- 3. Fuentes de tráfico + productos más visitados (mismo formato de ranking) -->
  <section class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <SimpleBarChart
      titulo="Fuentes de tráfico"
      subtitulo="Reparto de sesiones por origen (referrer) durante el periodo."
      items={barrasFuentes}
      ayuda={getMetrica('fuentes-trafico')?.definicionCorta}
    />

    <SimpleBarChart
      titulo="Productos más visitados"
      subtitulo="Visualizaciones de ficha por producto (top 5)."
      items={barrasTop}
      ayuda={getMetrica('visualizaciones-producto')?.definicionCorta}
    />

    <div class="lg:col-span-2">
      <SimpleBarChart
        titulo="Procedencias reales"
        subtitulo="Dominios de referencia detrás de las 5 fuentes agregadas (quién enlaza de verdad)."
        items={barrasReferrers}
        ayuda="Antes de agrupar en Orgánico/Social/Referido, estos son los dominios (document.referrer) tal cual los envía el navegador: útil para detectar bots, redes nuevas o referidos inesperados."
      />
    </div>
  </section>

  <!-- 4. Recomendaciones de IA -->
  <section class="flex flex-col gap-4">
    <div class="flex min-w-0 flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-5">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-white">Recomendaciones de IA</h3>
          <p class="mt-1 text-xs leading-relaxed text-slate-400">Acciones priorizadas (versión orientativa; se conectarán al analizador real).</p>
        </div>
        <span class="rounded-full border border-violet-500/30 bg-violet-500/15 px-2.5 py-1 text-[11px] font-extrabold text-violet-300">IA</span>
      </div>

      <p class="mt-6 text-xs leading-relaxed text-slate-500">
        Este bloque se rellenará con recomendaciones generadas a partir de los datos
        reales del periodo (productos con fricción, categorías en crecimiento...).
        De momento muestra ejemplos de referencia.
      </p>
    </div>
  </section>

  <!-- 4. Tabla por producto (catálogo completo, con buscador por nombre dentro
       del propio componente: no se limita al Top 10 como el ranking de arriba) -->
  <section class="flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 class="text-base font-extrabold uppercase tracking-wider text-white">Rendimiento por producto</h2>
        <p class="mt-1 text-xs text-slate-400">
          Visitas, salidas a tienda y estado de fricción de cada ficha del catálogo. Busca por nombre para encontrar cualquier producto, tenga o no visitas en este periodo.
        </p>
      </div>
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">{productosTabla.length} productos</span>
    </div>
    {productosTabla.length === 0 ? (
      <p class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-8 text-center text-xs text-slate-500">
        Todavía no hay productos en el catálogo.
      </p>
    ) : (
      <ProductMetricsTable productos={productosTabla} />
    )}
  </section>

  <!-- 5. Histórico mensual + exportación + reset -->
  <section class="flex flex-col gap-4" data-historico>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-base font-extrabold uppercase tracking-wider text-white">Histórico mensual</h2>
        <p class="mt-1 text-xs text-slate-400">
          Meses cerrados y mes en curso ({enCurso ? `actual: ${resumen.meses[0]?.label ?? ''}` : 'sin datos'}). Selecciona meses para exportarlos a Excel.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-export-seleccion
          class="rounded-full border border-sky-400/40 bg-sky-500/20 px-4 py-1.5 text-[11px] font-extrabold uppercase tracking-wider text-sky-300 transition hover:bg-sky-500/30 disabled:cursor-not-allowed disabled:opacity-40"
          disabled
        >
          Exportar selección (.xlsx)
        </button>
        <button
          type="button"
          data-export-todo
          class="rounded-full border border-white/15 bg-white/[0.05] px-4 py-1.5 text-[11px] font-extrabold uppercase tracking-wider text-slate-300 transition hover:border-sky-400/30 hover:text-sky-300 disabled:opacity-40"
          disabled={resumen.meses.length === 0}
        >
          Exportar todo (.xlsx)
        </button>
        <button
          type="button"
          data-reset
          class="rounded-full border border-rose-500/30 bg-rose-500/10 px-4 py-1.5 text-[11px] font-extrabold uppercase tracking-wider text-rose-300 transition hover:bg-rose-500/20"
        >
          Reiniciar a cero
        </button>
      </div>
    </div>

    {resumen.meses.length === 0 ? (
      <p class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-8 text-center text-xs text-slate-500">
        No hay meses registrados todavía.
      </p>
    ) : (
      <div class="overflow-x-auto rounded-2xl border border-white/10 bg-white/[0.03]">
        <table class="min-w-[760px] border-collapse text-left" style="width: 100%">
          <thead>
            <tr class="border-b border-white/10 bg-white/[0.02] text-[11px] uppercase tracking-wider text-slate-400">
              <th class="w-10 px-4 py-3 font-bold"></th>
              <th class="px-4 py-3 font-bold">Mes</th>
              <th class="px-4 py-3 [text-align:right] font-bold">Sesiones</th>
              <th class="px-4 py-3 [text-align:right] font-bold">Visitas</th>
              <th class="px-4 py-3 [text-align:right] font-bold">Salidas</th>
              <th class="px-4 py-3 [text-align:right] font-bold">Compras</th>
              <th class="px-4 py-3 [text-align:right] font-bold">Conversión</th>
              <th class="px-4 py-3 [text-align:right] font-bold">AOV</th>
            </tr>
          </thead>
          <tbody>
            {resumen.meses.map((mes) => (
              <tr class="border-b border-white/5 transition last:border-b-0 hover:bg-sky-500/5">
                <td class="px-4 py-3">
                  <input
                    type="checkbox"
                    data-mes-check
                    value={mes.month}
                    class="h-4 w-4 cursor-pointer rounded border-white/20 bg-white/5 accent-sky-500"
                    aria-label={`Seleccionar ${mes.label}`}
                  />
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm font-bold text-white">{mes.label}</span>
                  {mes.month === enCurso && (
                    <span class="ml-2 rounded-full border border-emerald-500/30 bg-emerald-500/15 px-2 py-0.5 text-[10px] font-extrabold uppercase text-emerald-300">En curso</span>
                  )}
                </td>
                <td class="px-4 py-3 [text-align:right] text-sm font-bold text-white">{fmtNum.format(mes.metrics.sesiones)}</td>
                <td class="px-4 py-3 [text-align:right] text-sm font-semibold text-slate-300">{fmtNum.format(mes.metrics.visitas)}</td>
                <td class="px-4 py-3 [text-align:right] text-sm font-semibold text-slate-300">{fmtNum.format(mes.metrics.salidas)}</td>
                <td class="px-4 py-3 [text-align:right] text-sm font-semibold text-slate-300">{fmtNum.format(mes.metrics.compras)}</td>
                <td class="px-4 py-3 [text-align:right] text-sm font-bold text-emerald-300">{mes.metrics.conversionPct.toFixed(1).replace('.', ',')}%</td>
                <td class="px-4 py-3 [text-align:right] text-sm font-semibold text-slate-300">{mes.metrics.aov.toFixed(2).replace('.', ',')} €</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <p class="text-[11px] leading-relaxed text-slate-500">
      El Excel incluye una hoja «Resumen», una hoja por año y una hoja por mes con
      KPIs, fuentes, evolución diaria y top de productos (tablas con barras de datos).
      {ignoredIps.length > 0 && (
        <> Las visitas desde {ignoredIps.join(', ')} no se contabilizan.</>
      )}
    </p>
  </section>

  <p class="border-t border-white/10 pt-6 text-[11px] leading-relaxed text-slate-500">
    Datos del tracker propio de Tradylor (visitas de fichas, duración, salidas y compras).
    Consulta la <a href="/upayp1b4/trafico-ventas/guia" class="font-bold text-sky-400 hover:underline">Guía y Glosario de Métricas</a> para entender cada indicador.
  </p>
</div>

<script>
  // Exportación y reinicio del histórico mensual (sin framework, vanilla).
  const contenedor = document.querySelector('[data-historico]');
  if (contenedor) {
    const checks = Array.from(contenedor.querySelectorAll<HTMLInputElement>('[data-mes-check]'));
    const btnSeleccion = contenedor.querySelector<HTMLButtonElement>('[data-export-seleccion]');
    const btnTodo = contenedor.querySelector<HTMLButtonElement>('[data-export-todo]');
    const btnReset = contenedor.querySelector<HTMLButtonElement>('[data-reset]');

    const sincronizar = () => {
      if (btnSeleccion) btnSeleccion.disabled = !checks.some((check) => check.checked);
    };
    checks.forEach((check) => check.addEventListener('change', sincronizar));
    sincronizar();

    btnSeleccion?.addEventListener('click', () => {
      const meses = checks.filter((check) => check.checked).map((check) => check.value);
      if (!meses.length) return;
      window.location.href = `/api/admin/analytics/export?months=${encodeURIComponent(meses.join(','))}`;
    });

    btnTodo?.addEventListener('click', () => {
      window.location.href = '/api/admin/analytics/export';
    });

    btnReset?.addEventListener('click', async () => {
      const confirmado = window.confirm(
        '¿Reiniciar la medición a cero? Se borrarán todos los eventos y el histórico mensual. Esta acción no se puede deshacer.',
      );
      if (!confirmado) return;
      btnReset.disabled = true;
      try {
        const respuesta = await fetch('/api/admin/analytics/reset', { method: 'POST' });
        if (!respuesta.ok) throw new Error('No se pudo reiniciar');
        window.location.reload();
      } catch {
        window.alert('No se pudo reiniciar la medición. Inténtalo de nuevo.');
        btnReset.disabled = false;
      }
    });
  }
</script>

<script>
  // Selector de métrica del gráfico "Evolución diaria": cambia qué dato mueve
  // las barras (visitas/sesiones/salidas/compras/conversión) sin recargar,
  // leyendo los valores ya embebidos como data-* en cada barra.
  const fmt = new Intl.NumberFormat('es-ES');
  const root = document.querySelector<HTMLElement>('[data-evolucion-chart]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-eje-tab]'));
    const bars = Array.from(root.querySelectorAll<HTMLElement>('[data-bar]'));
    const totalEl = root.querySelector('[data-eje-total]');
    const totalLabelEl = root.querySelector('[data-eje-total-label]');
    const mejorEl = root.querySelector('[data-eje-mejor]');

    const COLORES: Record<string, [string, string]> = {
      visitas: ['#0284c7', '#7dd3fc'],
      sesiones: ['#7c3aed', '#c4b5fd'],
      salidas: ['#d97706', '#fcd34d'],
      compras: ['#059669', '#6ee7b7'],
      conversionpct: ['#e11d48', '#fda4af'],
    };
    const ACTIVO = 'rounded-full border px-3.5 py-1.5 text-[11px] font-extrabold uppercase tracking-wider transition border-sky-400 bg-sky-500 text-slate-950';
    const INACTIVO = 'rounded-full border px-3.5 py-1.5 text-[11px] font-extrabold uppercase tracking-wider transition border-white/10 bg-white/5 text-slate-300 hover:border-sky-500/40 hover:text-white';

    const datasetKey = (id: string) => `m${id.charAt(0).toUpperCase()}${id.slice(1)}`;

    function aplicar(metricaId: string) {
      const tab = tabs.find((t) => t.dataset.ejeTab === metricaId);
      const label = tab?.dataset.label || metricaId;
      const esPercent = tab?.dataset.percent === '1';
      const [desde, hasta] = COLORES[metricaId] ?? COLORES.visitas;
      const key = datasetKey(metricaId);

      const valores = bars.map((bar) => Number(bar.dataset[key] ?? 0));
      const max = valores.length ? Math.max(...valores) : 0;
      let mejorIndex = 0;

      bars.forEach((bar, index) => {
        const valor = valores[index];
        if (valor > valores[mejorIndex]) mejorIndex = index;
        const pct = max > 0 ? Math.max(Math.round((valor / max) * 100), valor > 0 ? 4 : 0) : 0;
        const fill = bar.querySelector<HTMLElement>('[data-bar-fill]');
        const value = bar.querySelector<HTMLElement>('[data-bar-value]');
        const texto = esPercent ? `${valor.toFixed(1).replace('.', ',')}%` : fmt.format(valor);
        if (fill) {
          fill.style.height = `${pct}%`;
          fill.style.background = `linear-gradient(to top, ${desde}, ${hasta})`;
        }
        if (value) value.textContent = texto;
        bar.title = `${bar.dataset.etiqueta}: ${texto} ${label.toLowerCase()}`;
      });

      if (totalEl) {
        if (esPercent) {
          // Media ponderada (salidas÷visitas), no el promedio simple de cada día.
          const totalVisitas = bars.reduce((s, bar) => s + Number(bar.dataset.mVisitas ?? 0), 0);
          const totalSalidas = bars.reduce((s, bar) => s + Number(bar.dataset.mSalidas ?? 0), 0);
          const conversionGlobal = totalVisitas ? (totalSalidas / totalVisitas) * 100 : 0;
          totalEl.textContent = `${conversionGlobal.toFixed(1).replace('.', ',')}%`;
        } else {
          totalEl.textContent = fmt.format(valores.reduce((s, v) => s + v, 0));
        }
      }
      if (totalLabelEl) totalLabelEl.textContent = esPercent ? 'conversión media' : label.toLowerCase();
      if (mejorEl && bars[mejorIndex]) {
        const texto = esPercent
          ? `${valores[mejorIndex].toFixed(1).replace('.', ',')}%`
          : fmt.format(valores[mejorIndex]);
        mejorEl.textContent = `Mejor día: ${bars[mejorIndex].dataset.etiqueta} (${texto})`;
      }

      tabs.forEach((t) => {
        const activo = t.dataset.ejeTab === metricaId;
        t.setAttribute('aria-selected', String(activo));
        t.className = activo ? ACTIVO : INACTIVO;
      });
    }

    tabs.forEach((tab) => tab.addEventListener('click', () => aplicar(tab.dataset.ejeTab || 'visitas')));
  }
</script>
