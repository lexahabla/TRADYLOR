---
/**
 * TRADYLOR — Shell compartido del módulo de Marketing
 * Cabecera + navegación del backend + submenú de Marketing + hueco de contenido.
 * La autenticación la hace cada página (para poder redirigir antes de renderizar).
 */
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../AdminNav.astro';
import AdminSectionHeader from './AdminSectionHeader.astro';
import AdminUserMenu from '../AdminUserMenu.astro';
import MarketingMenu from './MarketingMenu.astro';
import type { PublicUser } from '../../lib/userStore';

interface Props {
  user: PublicUser;
  /** Etiqueta del submenú activo (coincide con MarketingMenu). */
  seccion: 'usuarios' | 'market-map' | 'calendario' | 'market-action' | 'tendencias';
  /** Etiqueta mostrada en la migaja de breadcrumbs. */
  breadcrumb: string;
  /** H1 de la página. */
  titulo: string;
  /** Texto del <title> del documento. */
  documentTitle: string;
  descripcion: string;
  /** Subtítulo bajo el H1. */
  sub: string;
}

const { user, seccion, breadcrumb, titulo, documentTitle, descripcion, sub } = Astro.props;
// En la portada del módulo la migaja termina en «Marketing»; en una subsección
// añade su nombre. Antes salía «Panel / Marketing / Marketing».
const esPortada = breadcrumb === 'Marketing';
const crumbs = esPortada
  ? [{ label: 'Panel de administración', href: '/upayp1b4' }, { label: 'Marketing' }]
  : [
      { label: 'Panel de administración', href: '/upayp1b4' },
      { label: 'Marketing', href: '/upayp1b4/marketing' },
      { label: breadcrumb },
    ];
---

<Layout title={documentTitle} description={descripcion}>
  <Fragment slot="header-end">
    <AdminUserMenu user={user} active="marketing" />
  </Fragment>
  <div class="admin-module-wrapper">
    <AdminSectionHeader crumbs={crumbs} headingLevel={1} title={titulo} subtitle={sub} />

    <AdminNav context="catalogo" active="marketing" user={user} />

    <MarketingMenu active={seccion} />

    <slot />
  </div>

  <!-- Botón flotante: volver al menú de secciones del backend -->
  <button type="button" id="adminBackToTop" class="admin-back-to-top" title="Volver al menú de secciones" aria-label="Volver al menú de secciones">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
    <span>Secciones</span>
  </button>

  <script is:inline>
    const adminBackToTop = document.getElementById('adminBackToTop');
    if (adminBackToTop) {
      adminBackToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</Layout>

<style is:global>
  .admin-module-wrapper { display: flex; flex-direction: column; gap: 30px; max-width: var(--max-width); margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
  /* Botón flotante: volver al menú de secciones (alineado a la izquierda) */
  .admin-back-to-top {
    position: fixed;
    left: 1.1rem;
    bottom: 1.1rem;
    z-index: 70;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .65rem .95rem;
    color: #04121f;
    background: linear-gradient(135deg, #38bdf8, #22d3ee);
    border: 0;
    border-radius: 999px;
    box-shadow: 0 10px 26px rgba(56, 189, 248, .35);
    cursor: pointer;
    font: inherit;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .02em;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .admin-back-to-top:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(56, 189, 248, .5); }
  .admin-back-to-top svg { display: block; }
</style>
